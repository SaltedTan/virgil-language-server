#
# Local pre-commit hook. Checks the staged index content of .v3 files, and
# type-checks the working tree under clients/vscode when a staged file is there.
# Install with `make install-hooks`. Skip once with `git commit --no-verify`,
# or disable with `git config --unset core.hooksPath`.

set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

staged=()
while IFS= read -r -d '' path; do
    staged+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ ${#staged[@]} -eq 0 ]; then
    exit 0
fi

tmpdir=
trap '[ -n "$tmpdir" ] && [ -d "$tmpdir" ] && rm -rf -- "$tmpdir"' EXIT

raw_v3_files=()
v3_files=()
vscode_touched=0

for path in "${staged[@]}"; do
    case "$path" in
        *.v3) raw_v3_files+=("$path") ;;
    esac
    case "$path" in
        clients/vscode/*) vscode_touched=1 ;;
    esac
done

if [ ${#raw_v3_files[@]} -gt 0 ]; then
    excluded=()
    while IFS= read -r line; do
        [ -n "$line" ] && excluded+=("$line")
    done < <(make -s --no-print-directory print-format-exclude)

    is_excluded() {
        local path=$1 prefix
        if [ ${#excluded[@]} -eq 0 ]; then
            return 1
        fi
        for prefix in "${excluded[@]}"; do
            case "$path" in
                "$prefix"*) return 0 ;;
            esac
        done
        return 1
    }

    for path in "${raw_v3_files[@]}"; do
        if ! is_excluded "$path"; then
            v3_files+=("$path")
        fi
    done
fi

if [ ${#v3_files[@]} -gt 0 ]; then
    if [ ! -f vendor/virgil/aeneas/DEPS ]; then
        echo "error: Virgil sources not found at vendor/virgil" >&2
        echo "       run: git submodule update --init --recursive" >&2
        exit 1
    fi
    make -s build/virgil-lsp
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/virgil-lsp-pre-commit.XXXXXX")
    args=()
    for path in "${v3_files[@]}"; do
        dir=$(dirname -- "$path")
        mkdir -p -- "$tmpdir/$dir"
        git show ":$path" > "$tmpdir/$path"
        case "$path" in
            -*) args+=("./$path") ;;
            *) args+=("$path") ;;
        esac
    done
    server="$root/build/virgil-lsp"
    if ! (cd "$tmpdir" && "$server" format --check "${args[@]}"); then
        {
            echo "pre-commit: unformatted staged .v3 files."
            echo "Run build/virgil-lsp format --write <file> and stage the result."
        } >&2
        exit 1
    fi
fi

if [ "$vscode_touched" -eq 1 ]; then
    if [ -d "$root/clients/vscode/node_modules" ]; then
        ( cd "$root/clients/vscode" && npm run check )
    else
        echo "pre-commit: skipping VS Code type-check (clients/vscode/node_modules not installed; run npm ci in clients/vscode)" >&2
    fi
fi

exit 0
