class ProjectSource(path: string, member: bool) {
	// The canonical document URI of {path}, or null if it has none. Expansion
	// looks up the file's overlay with it, and freshness checks compare it
	// with captured URIs (LspAnalysisCapture.matchesSources), so neither
	// converts the path again. Formed with the source, it cannot go stale.
	def uri = DocumentUri.normalize(ProjectFiles.uri(path));
}
class ProjectExpansionResult(sources: Array<ProjectSource>, diagnostics: Array<ProjectConfigDiagnostic>) { }

component ProjectLimits {
	def MAX_FILES = 1024;
	def MAX_BYTES = 4 * 1024 * 1024;
	def MAX_VISITS = 10000;
	def MAX_PATH_BYTES = 4 * 1024 * 1024;
	def MAX_DEPTH = 64;
}
// Expansion reads directory records and metadata only, never source contents.
// It keys no map by path: its sets are OrderedStringSets, whose work does not
// depend on how the paths hash. The sets of one pattern's walk hold paths
// relative to its base, which are shorter to compare.
class ProjectExpansion(store: DocumentStore, maxFiles: int, maxBytes: int) {
	private def sources = Vector<ProjectSource>.new();
	private def seen = OrderedStringSet.new();
	private def errors = Vector<ProjectConfigDiagnostic>.new();
	private var visits: int;
	private var pathBytes: int;
	private var bytes = 32L;
	private var current: ProjectPattern;
	private var exclusions: Array<ProjectPattern>;
	private var visited: OrderedStringSet;
	private var matches: OrderedStringSet;
	private var found: Vector<string>;

	def expand(base: string, root: string, p: ProjectDefinition) -> ProjectExpansionResult {
		add(base, p.sources, p.exclude, true);
		add(base, p.dependencies, p.exclude, false);
		if (p.virgilDependencies.length > 0 && root == null) {
			current = p.virgilDependencies[0];
			error(ProjectConfigCode.MISSING_VIRGIL_ROOT, "virgilDependencies requires a Virgil root (initializationOptions.virgilRoot)");
		} else add(root, p.virgilDependencies, [], false);
		return ProjectExpansionResult.new(if(errors.length == 0, sources.extract(), []), errors.extract());
	}
	private def error(code: ProjectConfigCode, text: string) {
		if (errors.length == 0) errors.put(ProjectConfigDiagnostic.new(code, current.begin, current.end, text));
	}
	private def add(base: string, patterns: Array<ProjectPattern>, exclude: Array<ProjectPattern>, member: bool) {
		exclusions = exclude;
		for (pattern in patterns) {
			if (errors.length > 0) return;
			current = pattern;
			visited = OrderedStringSet.new(); matches = OrderedStringSet.new(); found = Vector<string>.new();
			walk(base, "", Strings.split(pattern.text, "/", -1), 0, 0);
			if (errors.length > 0) return;
			var paths = found.extract();
			paths = Arrays.sort(paths, 0, paths.length, ProjectFiles.before);
			for (path in paths) {
				if (!seen.add(path)) continue;
				if (sources.length >= maxFiles) { error(ProjectConfigCode.EXPANSION_LIMIT, "project selects too many source files"); return; }
				var fd = ProjectFiles.open(path, false);
				if (fd < 0) { error(ProjectConfigCode.SOURCE_IO, "selected source is no longer a readable regular file"); return; }
				var meta = HostOs.fileMetadata(fd);
				HostOs.close(fd);
				if (meta.0 != ProjectFiles.REGULAR || meta.1 < 0) { error(ProjectConfigCode.SOURCE_IO, "selected source is no longer a readable regular file"); return; }
				var source = ProjectSource.new(path, member);
				var overlay = if(store != null, store.canonicalOverlay(source.uri));
				var size = if(overlay != null, long.view(overlay.text.length), meta.1);
				var overhead = long.view(path.length) + 16;
				if (size > long.view(maxBytes) - bytes - overhead) { error(ProjectConfigCode.SOURCE_BUDGET, "project exceeds the aggregate analysis source budget"); return; }
				bytes += size + overhead;
				sources.put(source);
			}
		}
	}
	private def excluded(relative: string) -> bool {
		for (e in exclusions) { if(ProjectGlob.matches(e.text, relative)) return true; }
		return false;
	}
	private def walk(base: string, relative: string, parts: Array<string>, at: int, depth: int) {
		if (errors.length > 0) return;
		if (++visits > ProjectLimits.MAX_VISITS || depth > ProjectLimits.MAX_DEPTH) { error(ProjectConfigCode.EXPANSION_LIMIT, "project directory traversal limit exceeded"); return; }
		var path = if(relative.length == 0, base, ProjectFiles.join(base, relative));
		var key = Strings.format2("%d:%s", at, relative);
		if (!visited.add(key)) return;
		// The budget counts the key with the whole path.
		pathBytes += key.length - relative.length + path.length;
		if (pathBytes > ProjectLimits.MAX_PATH_BYTES) { error(ProjectConfigCode.EXPANSION_LIMIT, "project traversal path budget exceeded"); return; }
		if (at == parts.length) {
			var meta = ProjectFiles.metadata(path);
			if (ProjectFiles.metadataError(meta.0)) { error(ProjectConfigCode.SOURCE_IO, Strings.format1("cannot inspect readable project source: %s", path)); return; }
			if (meta.0 != ProjectFiles.REGULAR) return;
			if (!seen.has(path) && matches.add(relative)) {
				if (found.length + sources.length >= maxFiles) { error(ProjectConfigCode.EXPANSION_LIMIT, "project selects too many source files"); return; }
				found.put(path);
			}
			return;
		}
		var part = parts[at], recursive = Strings.equal(part, "**");
		if (recursive) walk(base, relative, parts, at + 1, depth);
		if (errors.length > 0) return;
		var entries = ProjectFiles.list(path, ProjectLimits.MAX_VISITS - visits);
		visits += entries.examined;
		if (entries.overflow) { error(ProjectConfigCode.EXPANSION_LIMIT, "project directory traversal limit exceeded"); return; }
		if (entries.names == null) { error(ProjectConfigCode.SOURCE_IO, "cannot enumerate project directory"); return; }
		for (i < entries.names.length) {
			var entry = entries.names[i];
			if (!ProjectGlob.segment(if(recursive, "*", part), entry)) continue;
			var rel = if(relative.length == 0, entry, ProjectFiles.join(relative, entry));
			if (excluded(rel)) continue;
			var child = ProjectFiles.join(base, rel), kind = entries.types[i];
			if (recursive || at + 1 < parts.length) {
				if (kind == 0) {
					var meta = ProjectFiles.metadata(child);
					if (ProjectFiles.metadataError(meta.0)) { error(ProjectConfigCode.SOURCE_IO, "cannot inspect project directory"); return; }
					if (meta.0 != ProjectFiles.DIRECTORY) continue;
				} else if (kind != 4) continue;
			} else if (kind != 0 && kind != 8) continue;
			walk(base, rel, parts, if(recursive, at, at + 1), depth + 1);
		}
	}
}
