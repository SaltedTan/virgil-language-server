// Lightweight mutable token: snapshots retain no config/source text. Replacing
// or deleting a configuration permanently invalidates all its old snapshots.
class ProjectRevision(uri: string, number: int) { var current = true; }
class ProjectContext(config: ProjectRevision, definition: ProjectDefinition) {
	var parseableTexts: OrderedStringMap<ParseableText>;
	// Converted inlay link targets, without retaining an older snapshot.
	var hintTargets = OrderedStringMap<LspHintTargetFingerprint>.new();
	var sources: Array<ProjectSource> = [];
	var snapshot: AnalysisSnapshot;
	// Snapshot admission evicted {snapshot} to make room, and no automatic
	// analysis of this context has started since. A request that needs the
	// snapshot may then analyze the context again, once (see
	// LspSemanticDiagnostics.whenAnalyzed). A context never analyzed, or
	// whose analysis failed after the eviction, has neither.
	var evicted: bool;
	var lastUsed: long;
	def contains(path: string, memberOnly: bool) -> bool {
		for (s in sources) { if(Strings.equal(path, s.path) && (!memberOnly || s.member)) return true; }
		return false;
	}
}
class WorkspaceConfig(path: string) {
	var text: Array<byte>;
	var revision: ProjectRevision;
	var contexts: Array<ProjectContext> = [];
	var diagnostics: Array<ProjectConfigDiagnostic> = [];
	var published: string;
	var unreadable: bool;
	var reportedInvalid: bool;
	var capacityRejected: bool;
	var rejectedAvailable: int;
}
class DocumentProjects(configPath: string, contexts: Array<ProjectContext>, active: ProjectContext) {
	// The language options for parsing the document on its own: its active
	// project's, or none in single-file mode.
	def compilerArgs() -> Array<string> {
		return if(active != null, active.definition.compilerArgs, []);
	}
}

class WorkspaceProjects(store: DocumentStore) {
	def parseableText = ParseableTextCache.new();
	def FILE = ".virgil-lsp.json";
	def MAX_CONFIGS = 128;
	def MAX_PROJECTS = 128;
	def MAX_RETAINED_BYTES = 4 * 1024 * 1024;
	def MAX_SOURCE_REFERENCES = 8192;
	def MAX_SNAPSHOT_BYTES = 32 * 1024 * 1024;
	// The work, in ProjectGlobMatcher steps, that one request may spend to find
	// whether another program owns its files (otherProgram). Tests lower it.
	def MAX_OWNERSHIP_STEPS = 8000000;
	def var folders: Array<string> = [];
	// The bytes that retained snapshots and an incoming analysis's reservation
	// may take together (admitSnapshot). Tests lower it.
	var snapshotBudget = MAX_SNAPSHOT_BYTES;
	// Fixed for the session: initialize() sets it, and clients restart the
	// server to change it. Were it to change, otherProgram() could miss a
	// dependency that a context's list still holds from the old root.
	var virgilRoot: string;
	var ownershipSteps = MAX_OWNERSHIP_STEPS;
	var warn: string -> void;
	var info: string -> void;
	var onConfig: WorkspaceConfig -> void;
	var renameSnapshot: AnalysisSnapshot;
	private var discovered: bool;
	// The charges of the last admission that was refused (refusal): the
	// snapshots that it counted, those of them that it could not free, and
	// the reservation.
	private var refusedRetained: long;
	private var refusedProtected: long;
	private var refusedIncoming: long;
	private var configs = Vector<WorkspaceConfig>.new();
	private var nextUse: long;
	private var nextRevision: int;
	private var scanEntries: int;
	private var scanWarned: bool;
	private var singleFileWarned: bool;

	// Called with initialize's params once they are known to be an object. Any
	// member may be missing, and a missing one reads as the default JsonValue,
	// String(null). Folder order does not influence context selection.
	// Nonlocal URIs are not disk roots.
	def initialize(params: HashMap<string, JsonValue>) {
		var roots = Vector<string>.new();
		if (JsonValue.JArray.?(params["workspaceFolders"])) {
			for (v in JsonValue.JArray.!(params["workspaceFolders"]).v) {
				if (JsonValue.JObject.?(v)) addFolder(roots, JsonValue.JObject.!(v).v["uri"]);
			}
		} else addFolder(roots, params["rootUri"]);
		folders = roots.extract();
		folders = Arrays.sort(folders, 0, folders.length, ProjectFiles.before);
		// Absent and JSON null mean no client root. Every other supplied value
		// is an override, even if invalid: never hide a bad setting by using a
		// different library. The editor configs omit an unset root.
		var supplied = false;
		if (JsonValue.JObject.?(params["initializationOptions"])) {
			var options = JsonValue.JObject.!(params["initializationOptions"]).v;
			if (options.has("virgilRoot") && options["virgilRoot"] != JsonValue.Null) {
				supplied = true;
				if (JsonValue.String.?(options["virgilRoot"])) {
					var path = JsonValue.String.!(options["virgilRoot"]).v;
					if (path != null && path.length > 0 && path[0] == '/') virgilRoot = DocumentUri.filePath(ProjectFiles.uri(path));
				}
			}
		}
		if (supplied) {
			if (info != null) info(if(virgilRoot != null, Strings.format1("Virgil root: %s (client)", virgilRoot),
				"Virgil root: none (invalid client root; bundle fallback disabled)"));
		} else {
			var bundle = ExecutableFiles.adjacent("virgil");
			var reason = "cannot resolve the executable path";
			if (bundle != null) {
				var revision = ProjectFiles.load(ProjectFiles.join(bundle, "REVISION"), 41);
				reason = "bundle REVISION is missing or unreadable";
				if (revision != null) {
					if (revision.length > 0 && revision[revision.length - 1] == '\n') revision = Arrays.range(revision, 0, revision.length - 1);
					reason = "bundle REVISION does not match the server";
					if (Strings.equal(revision, BuildInfo.VIRGIL_REVISION)) {
						reason = "bundle lib directory is missing or unreadable";
						var fd = ProjectFiles.open(ProjectFiles.join(bundle, "lib"), true);
						if (fd >= 0) { HostOs.close(fd); virgilRoot = bundle; }
					}
				}
			}
			if (info != null) {
				if (virgilRoot != null) info(Strings.format2("Virgil root: %s (bundle, revision %s)", virgilRoot, BuildInfo.VIRGIL_REVISION));
				else info(Strings.format1("Virgil root: none (%s)", reason));
			}
		}
		// Discovery waits until after the initialize response, on first use.
	}
	private def addFolder(roots: Vector<string>, v: JsonValue) {
		if (!JsonValue.String.?(v)) return;
		var path = DocumentUri.filePath(JsonValue.String.!(v).v);
		if (path == null) return;
		for (i < roots.length) { if(Strings.equal(roots[i], path)) return; }
		roots.put(path);
	}
	private def discoveryLimit() {
		if (!scanWarned && warn != null) warn("workspace project discovery limit exceeded; open documents still discover their nearest project file");
		scanWarned = true;
	}
	private def discover(dir: string, depth: int) {
		if (scanEntries >= ProjectLimits.MAX_VISITS || depth > ProjectLimits.MAX_DEPTH || configs.length >= MAX_CONFIGS) { discoveryLimit(); return; }
		var listing = ProjectFiles.list(dir, ProjectLimits.MAX_VISITS - scanEntries);
		scanEntries += listing.examined;
		if (listing.overflow) { discoveryLimit(); return; }
		if (listing.names == null) {
			if (warn != null) warn(Strings.format1("cannot enumerate workspace project discovery directory: %s", dir));
			return;
		}
		for (i < listing.names.length) {
			var name = listing.names[i], path = ProjectFiles.join(dir, name);
			if (Strings.equal(name, FILE)) load(path);
			else if (name.length > 0 && name[0] != '.') {
				var kind = listing.types[i];
				if (kind == 4) discover(path, depth + 1);
				else if (kind == 0) {
					var meta = ProjectFiles.metadata(path);
					if (ProjectFiles.metadataError(meta.0)) {
						if (warn != null) warn(Strings.format1("cannot inspect workspace project discovery entry: %s", path));
					} else if (meta.0 == ProjectFiles.DIRECTORY) discover(path, depth + 1);
				}
			}
		}
	}
	// A containing workspace folder bounds ancestor search. With no containing
	// folder, walk to the filesystem root (matching the editor's root marker).
	def nearest(path: string) -> string {
		var dir = ProjectFiles.parent(path), boundary = "/";
		for (root in folders) {
			if ((Strings.equal(root, dir) || Strings.startsWith(dir, ProjectFiles.join(root, ""))) && root.length > boundary.length) boundary = root;
		}
		while (true) {
			var config = ProjectFiles.join(dir, FILE);
			if (store.overlay(ProjectFiles.uri(config)) != null || ProjectFiles.configMarker(config)) return config;
			if (Strings.equal(dir, boundary) || Strings.equal(dir, "/")) break;
			dir = ProjectFiles.parent(dir);
		}
		return null;
	}
	def refresh() {
		refreshConfigs(false);
	}
	// Refreshes every configuration and expands its sources again, for files
	// created or deleted on disk.
	def reexpand() {
		refreshConfigs(true);
	}
	// The sources that {ctx}'s patterns select on disk now, expanded as {update}
	// does, without changing {ctx}; or null if the expansion fails or {ctx} is
	// no longer loaded. Unlike ctx.sources, it shows a file created or deleted
	// without a file event.
	def expandNow(ctx: ProjectContext) -> Array<ProjectSource> {
		for (i < configs.length) {
			var c = configs[i];
			for (x in c.contexts) {
				if (x != ctx) continue;
				var expanded = ProjectExpansion.new(store, ProjectLimits.MAX_FILES, ProjectLimits.MAX_BYTES)
					.expand(ProjectFiles.parent(c.path), virgilRoot, ctx.definition);
				return if(expanded.diagnostics.length == 0, expanded.sources);
			}
		}
		return null;
	}
	// The first of {paths} that the patterns of a loaded context other than
	// {ctx} select, as their expansion would if a regular file were there, with
	// the first such context in loadedContexts() order; or (null, null). Every
	// source a context retains was selected by its patterns, with the fixed
	// Virgil root, so the patterns also find every file it lists, though it
	// need not list every file they select: expanding it again replaces the
	// list, and a failed expansion clears it. Matching reads nothing on disk,
	// retains nothing, and cannot fail, but it spends {matcher}'s budget, and
	// once that is exhausted the result is (null, null) and says nothing:
	// check matcher.exhausted() first. All its work is charged, including
	// finding the contexts, their bases, and the first owner, and none hashes
	// a path into a map, where paths chosen to collide would make each
	// insertion and lookup cost more.
	def otherProgram(ctx: ProjectContext, paths: Array<string>, matcher: ProjectGlobMatcher) -> (string, ProjectContext) {
		if (matcher.exhausted()) return (null, null);
		// Each other context with its configuration's directory, the base of
		// its patterns. A base is a directory prefix of a path when the path's
		// prefix with as many separators hashes the same and, checked only
		// then, is equal. So testing every base costs about one step, not the
		// shared bytes again.
		var others = Vector<ProjectContext>.new(), bases = Vector<string>.new();
		var depths = Vector<int>.new(), hashes = Vector<int>.new();
		for (i < configs.length) {
			var c = configs[i], base: string, depth = 0, hash = 0;
			if (!matcher.charge(1)) return (null, null);
			for (x in c.contexts) {
				if (!matcher.charge(1)) return (null, null);
				if (x == ctx || !x.config.current) continue;
				if (base == null) {
					base = ProjectFiles.join(ProjectFiles.parent(c.path), "");
					if (!matcher.charge(c.path.length + 3 * base.length)) return (null, null);
					depth = directories(base, null);
					hash = directoryHash(base);
				}
				others.put(x); bases.put(base); depths.put(depth); hashes.put(hash);
			}
		}
		// A path below a base splits into the base's segments and the relative
		// path's. A context's patterns are split when a path is first below its
		// base or the Virgil root.
		var library = if(virgilRoot != null, ProjectFiles.join(virgilRoot, ""));
		if (library != null && !matcher.charge(virgilRoot.length + 2 * library.length)) return (null, null);
		var libraryDepth = if(library != null, directories(library, null));
		var split = Array<ProjectGlobPatterns>.new(others.length), prefixes: Array<int> = [];
		for (path in paths) {
			var segments = matcher.split(path);
			if (segments == null || !matcher.charge(path.length)) return (null, null);
			if (prefixes.length < segments.length) prefixes = Array<int>.new(segments.length);
			directories(path, prefixes);
			var inLibrary = library != null && matcher.startsWith(path, library);
			if (matcher.exhausted()) return (null, null);
			var owner: ProjectContext, below = false;
			for (i < others.length) {
				if (!matcher.charge(1)) return (null, null);
				var c = others[i], p = c.definition;
				// The contexts of one configuration are adjacent and share its
				// base, which is compared once.
				if (i == 0 || bases[i] != bases[i - 1]) {
					below = depths[i] < segments.length && prefixes[depths[i]] == hashes[i]
						&& matcher.startsWith(path, bases[i]);
					if (matcher.exhausted()) return (null, null);
				}
				var selectsLibrary = inLibrary && p.virgilDependencies.length > 0;
				if (!below && !selectsLibrary) continue;
				if (split[i] == null) split[i] = matcher.patterns(p);
				if (split[i] == null) return (null, null);
				var s = split[i], selected = false;
				if (below) {
					var relative = segments[depths[i] ...];
					selected = matcher.selects(s.sources, s.exclude, relative);
					if (matcher.exhausted()) return (null, null);
					if (!selected) selected = matcher.selects(s.dependencies, s.exclude, relative);
					if (matcher.exhausted()) return (null, null);
				}
				if (!selected && selectsLibrary) selected = matcher.selects(s.virgilDependencies, [], segments[libraryDepth ...]);
				if (matcher.exhausted()) return (null, null);
				if (selected && (owner == null || ownerBefore(c, owner, matcher))) owner = c;
				if (matcher.exhausted()) return (null, null);
			}
			if (owner != null) return (path, owner);
		}
		return (null, null);
	}
	// Whether {a} comes before {b} in loadedContexts() order, as contextBefore
	// says, spending a step per byte compared.
	private def ownerBefore(a: ProjectContext, b: ProjectContext, matcher: ProjectGlobMatcher) -> bool {
		var x = a.config.uri, y = b.config.uri, i = 0;
		while (i < x.length && i < y.length && x[i] == y[i]) i++;
		matcher.charge(i + 1);
		if (i < x.length && i < y.length) return x[i] < y[i];
		if (x.length != y.length) return x.length < y.length;
		return a.definition.begin < b.definition.begin;
	}
	// The number of separators in {path}. If {hashes} is not null, it receives
	// at index d the hash of {path} up to and including separator d.
	private def directories(path: string, hashes: Array<int>) -> int {
		var n = 0, h = 0;
		for (c in path) {
			h = h * 31 + c;
			if (c != '/') continue;
			n++;
			if (hashes != null) hashes[n] = h;
		}
		return n;
	}
	// The hash of {directory}, ending in '/', as directories() computes it.
	private def directoryHash(directory: string) -> int {
		var h = 0;
		for (c in directory) h = h * 31 + c;
		return h;
	}
	// Loads the configuration at {path}, reported created or changed on disk,
	// if it isn't loaded and discovery would find it: inside a workspace folder,
	// within the depth bound, and in no hidden directory.
	def watched(path: string) {
		for (i < configs.length) { if(Strings.equal(configs[i].path, path)) return; }
		var root = folderOf(path);
		if (root == null) return;
		var depth = 0;
		for (dir = ProjectFiles.parent(path); !Strings.equal(dir, root); dir = ProjectFiles.parent(dir)) {
			var slash = dir.length - 1;
			while (slash > 0 && dir[slash] != '/') slash--;
			if (slash + 1 >= dir.length || dir[slash + 1] == '.' || ++depth > ProjectLimits.MAX_DEPTH) return;
		}
		load(path);
	}
	// The current contexts with a source at {path} or below it.
	def affected(path: string) -> Array<ProjectContext> {
		var result = Vector<ProjectContext>.new(), below = ProjectFiles.join(path, "");
		for (i < configs.length) {
			for (ctx in configs[i].contexts) {
				if (!ctx.config.current) continue;
				for (s in ctx.sources) {
					if (Strings.equal(s.path, path) || Strings.startsWith(s.path, below)) { result.put(ctx); break; }
				}
			}
		}
		return result.extract();
	}
	// Applies a workspace-folder change, given as folder URIs; nonlocal URIs are
	// ignored, as in initialize. Removals apply first. Configurations that only
	// removed folders contained are forgotten. If discovery has already run,
	// added folders are discovered now, each with a fresh scan budget.
	def changeFolders(added: Array<string>, removed: Array<string>) {
		var gone = Vector<string>.new(), roots = Vector<string>.new();
		for (uri in removed) addFolder(gone, JsonValue.String(uri));
		var dropped = gone.extract();
		for (root in folders) {
			var keep = true;
			for (d in dropped) keep = keep && !Strings.equal(d, root);
			if (keep) roots.put(root);
		}
		var kept = roots.length, fresh = Vector<string>.new();
		for (uri in added) addFolder(roots, JsonValue.String(uri));
		for (i = kept; i < roots.length; i++) fresh.put(roots[i]);
		folders = roots.extract();
		folders = Arrays.sort(folders, 0, folders.length, ProjectFiles.before);
		if (dropped.length > 0) {
			var live = Vector<WorkspaceConfig>.new();
			for (i < configs.length) {
				var c = configs[i];
				if (within(dropped, c.path) && !within(folders, c.path)) forget(c);
				else live.put(c);
			}
			configs = live;
		}
		if (!discovered) return;
		for (i < fresh.length) {
			scanEntries = 0;
			discover(fresh[i], 0);
		}
	}
	// The deepest workspace folder containing {path}, or null.
	private def folderOf(path: string) -> string {
		var result: string;
		for (root in folders) {
			if (Strings.startsWith(path, ProjectFiles.join(root, "")) && (result == null || root.length > result.length)) result = root;
		}
		return result;
	}
	private def within(roots: Array<string>, path: string) -> bool {
		for (root in roots) { if(Strings.startsWith(path, ProjectFiles.join(root, ""))) return true; }
		return false;
	}
	// Retires {c}'s projects and clears its published diagnostics.
	private def forget(c: WorkspaceConfig) {
		for (ctx in c.contexts) parseableText.removeContext(ctx);
		if (c.revision != null) c.revision.current = false;
		c.revision = ProjectRevision.new(ProjectFiles.uri(c.path), ++nextRevision);
		c.revision.current = false;
		c.text = null; c.contexts = []; c.diagnostics = [];
		publish(c);
	}
	private def refreshConfigs(preflight: bool) {
		pruneDeleted();
		if (preflight) {
			for (i < configs.length) { for(ctx in configs[i].contexts) ctx.sources = []; }
		}
		if (!discovered) {
			discovered = true;
			for (root in folders) discover(root, 0);
		}
		for (i < configs.length) update(configs[i], preflight);
		for (i < configs.length) { if(configs[i].capacityRejected) update(configs[i], false); }
	}
	def load(path: string) -> WorkspaceConfig {
		pruneDeleted();
		for (i < configs.length) {
			if (Strings.equal(configs[i].path, path)) { update(configs[i], false); return configs[i]; }
		}
		if (configs.length >= MAX_CONFIGS) { discoveryLimit(); return null; }
		var config = WorkspaceConfig.new(path);
		configs.put(config);
		update(config, false);
		return config;
	}
	private def pruneDeleted() {
		var live = Vector<WorkspaceConfig>.new();
		for (i < configs.length) {
			var c = configs[i];
			if (store.overlay(ProjectFiles.uri(c.path)) == null) {
				var fd = ProjectFiles.open(c.path, false);
				if (fd >= 0) HostOs.close(fd);
				if (fd == -2 || fd == -20) {
					update(c, false);
					c.revision.current = false;
					continue;
				}
			}
			live.put(c);
		}
		configs = live;
	}
	// Admits an automatic or demand analysis, whose result replaces {active}'s
	// snapshot and which requests for that snapshot wait for, within
	// snapshotBudget beside the supervisor's {latest} snapshot and a
	// reservation of {incomingBytes}. When room is needed, {active}'s own
	// snapshot is the first candidate to free and isn't marked evicted; see admit.
	def admitSnapshot(active: ProjectContext, latest: AnalysisSnapshot, incomingBytes: long) -> bool {
		return admit(active, latest, incomingBytes, true);
	}
	// Admits an analysis that keeps {active}'s snapshot, if any, until it
	// completes: a completion's or a rename's check, whose result doesn't
	// replace it, or an explicit analysis request, which requests don't wait
	// for, so that freeing the snapshot would leave them without one.
	def admitKeeping(active: ProjectContext, latest: AnalysisSnapshot, incomingBytes: long) -> bool {
		return admit(active, latest, incomingBytes, false);
	}
	// Why the last refused admission was refused, with its charges.
	def refusal() -> string {
		return StringBuilder.new()
			.put3("retained snapshots take %d bytes, of which %d bytes can't be freed, and a reservation of %d bytes",
				refusedRetained, refusedProtected, refusedIncoming)
			.put1(" doesn't fit beside them within the budget of %d bytes", snapshotBudget)
			.toString();
	}
	// Counts {latest}, a rename's pinned original, and every context's
	// snapshot once each. If they and the reservation exceed the budget, the
	// snapshots that may be freed are, in order: {active}'s own if {replaces},
	// then other contexts' least recently used first, but never {latest} or
	// the pinned original, which freeing would not release. If freeing them
	// all would not make room, admission is refused and frees nothing;
	// otherwise it frees them in that order until the reservation fits, and
	// marks each other context it evicts.
	private def admit(active: ProjectContext, latest: AnalysisSnapshot, incomingBytes: long, replaces: bool) -> bool {
		if (active != null) active.lastUsed = ++nextUse;
		var original = renameSnapshot;
		var retained = if(latest != null, latest.retainedBytes, 0L), freeable = 0L;
		if (original != null && original != latest) retained += original.retainedBytes;
		for (i < configs.length) {
			for (ctx in configs[i].contexts) {
				if (ctx.snapshot == null || ctx.snapshot == latest || ctx.snapshot == original) continue;
				retained += ctx.snapshot.retainedBytes;
				if (ctx != active || replaces) freeable += ctx.snapshot.retainedBytes;
			}
		}
		var limit = long.view(snapshotBudget) - incomingBytes;
		if (BenchProbe.enabled) {
			BenchProbe.server(0, "admit_replaces", if(replaces, 1, 0));
			BenchProbe.server(0, "admit_incoming_bytes", incomingBytes);
			BenchProbe.server(0, "admit_retained_bytes", retained);
			BenchProbe.server(0, "admit_latest_bytes", if(latest != null, latest.retainedBytes));
			BenchProbe.server(0, "admit_pinned_bytes", if(original != null && original != latest, original.retainedBytes));
			BenchProbe.server(0, "admit_protected_bytes", retained - freeable);
		}
		if (retained <= limit) {
			if (BenchProbe.enabled) BenchProbe.server(0, "admit_outcome", 1);
			return true;
		}
		if (retained - freeable > limit) {
			if (BenchProbe.enabled) BenchProbe.server(0, "admit_outcome", 0);
			refusedRetained = retained;
			refusedProtected = retained - freeable;
			refusedIncoming = incomingBytes;
			return false;
		}
		var own = if(active != null && replaces, active.snapshot);
		if (own != null && own != latest && own != original) {
			retained -= own.retainedBytes;
			active.snapshot = null;
			if (BenchProbe.enabled) BenchProbe.server(0, "admit_own_freed_bytes", own.retainedBytes);
		}
		while (retained > limit) {
			var victim: ProjectContext;
			for (i < configs.length) {
				for (ctx in configs[i].contexts) {
					if (ctx == active || ctx.snapshot == null || ctx.snapshot == latest || ctx.snapshot == original) continue;
					if (victim == null || ctx.lastUsed < victim.lastUsed) victim = ctx;
				}
			}
			retained -= victim.snapshot.retainedBytes;
			if (BenchProbe.enabled) BenchProbe.server(0, "admit_evicted_bytes", victim.snapshot.retainedBytes);
			victim.snapshot = null;
			victim.evicted = true;
		}
		if (BenchProbe.enabled) {
			BenchProbe.server(0, "admit_outcome", 2);
			BenchProbe.server(0, "admit_after_bytes", retained);
		}
		return true;
	}
	private def update(c: WorkspaceConfig, preflight: bool) {
		var uri = ProjectFiles.uri(c.path), overlay = store.overlay(uri);
		var text = if(overlay != null, overlay.text, ProjectFiles.load(c.path, ProjectConfigParser.MAX_BYTES));
		var retained = 0, projectCount = 0;
		for (i < configs.length) {
			var other = configs[i];
			if (other == c) continue;
			if (other.text != null) retained += other.text.length;
			projectCount += other.contexts.length;
		}
		if (text != null && text.length > MAX_RETAINED_BYTES - retained) text = null;
		var same = c.text == text || (c.text != null && text != null && Strings.equal(c.text, text));
		var unreadable = false;
		if (text == null) {
			var fd = ProjectFiles.open(c.path, false);
			unreadable = fd != -2 && fd != -20;
			if (fd >= 0) HostOs.close(fd);
		}
		var available = MAX_PROJECTS - projectCount;
		var changed = c.revision == null || !same || c.unreadable != unreadable || (c.capacityRejected && c.rejectedAvailable != available);
		if (changed) {
			for (ctx in c.contexts) parseableText.removeContext(ctx);
			if (c.revision != null) c.revision.current = false;
			c.revision = ProjectRevision.new(uri, ++nextRevision);
			c.text = text; c.unreadable = unreadable; c.contexts = []; c.diagnostics = []; c.capacityRejected = false;
			if (text == null) {
				if (unreadable) c.diagnostics = [ProjectConfigDiagnostic.new(ProjectConfigCode.SOURCE_IO, 0, 0, "cannot read project file within the configuration size/capacity limits")];
			} else {
				var parsed = ProjectConfigParser.parse(text);
				c.diagnostics = parsed.diagnostics;
				if (parsed.config != null) {
					var defs = parsed.config.projects;
					if (defs.length > available) {
						c.capacityRejected = true; c.rejectedAvailable = available;
						c.diagnostics = [ProjectConfigDiagnostic.new(ProjectConfigCode.EXPANSION_LIMIT, 0, 0, "too many projects in workspace")];
					} else {
						c.contexts = Array<ProjectContext>.new(defs.length);
						for (i < defs.length) c.contexts[i] = ProjectContext.new(c.revision, defs[i]);
					}
				}
			}
		}
		if (c.contexts.length == 0) { publish(c); return; }
		if (!changed && !preflight) return;
		var diagnostics = Vector<ProjectConfigDiagnostic>.new(), references = 0, pathBytes = 0;
		for (i < configs.length) {
			if (configs[i] == c) continue;
			for (ctx in configs[i].contexts) {
				references += ctx.sources.length;
				for (source in ctx.sources) pathBytes += source.path.length;
			}
		}
		for (ctx in c.contexts) {
			var expanded = ProjectExpansion.new(store, ProjectLimits.MAX_FILES, ProjectLimits.MAX_BYTES)
				.expand(ProjectFiles.parent(c.path), virgilRoot, ctx.definition);
			ctx.sources = expanded.sources;
			references += ctx.sources.length;
			for (source in ctx.sources) pathBytes += source.path.length;
			if (references > MAX_SOURCE_REFERENCES || pathBytes > MAX_RETAINED_BYTES) {
				diagnostics.put(ProjectConfigDiagnostic.new(ProjectConfigCode.EXPANSION_LIMIT, ctx.definition.begin, ctx.definition.end, "workspace source-list capacity exceeded"));
				break;
			}
			for (d in expanded.diagnostics) { if(diagnostics.length < ProjectConfigParser.MAX_DIAGNOSTICS) diagnostics.put(d); }
		}
		c.diagnostics = diagnostics.extract();
		// One invalid project invalidates the whole file, not just that program.
		if (c.diagnostics.length > 0) { for(ctx in c.contexts) ctx.sources = []; }
		for (ctx in c.contexts) parseableText.retainSources(ctx);
		publish(c);
	}
	private def publish(c: WorkspaceConfig) {
		var b = StringBuilder.new().putd(c.revision.number);
		for (d in c.diagnostics) b.put3("|%s:%d:%s", d.code.code, d.begin, d.message);
		var signature = b.extract();
		if (c.published != null && Strings.equal(c.published, signature)) return;
		c.published = signature;
		if (onConfig != null) onConfig(c);
	}
	def forDocument(uri: string) -> DocumentProjects {
		return projectsFor(uri, false);
	}
	// Every current context, in configuration URI order and then declaration
	// order. Neither discovery nor load order affects it, so a shared file's
	// analyses are visited in the same order in every session.
	def loadedContexts() -> Array<ProjectContext> {
		var result = Vector<ProjectContext>.new();
		for (i < configs.length) {
			for (ctx in configs[i].contexts) { if(ctx.config.current) result.put(ctx); }
		}
		return AnalysisTables.sort(result.extract(), contextBefore);
	}
	def forAnalysis(uri: string) -> DocumentProjects {
		return projectsFor(uri, true);
	}
	private def projectsFor(uri: string, preflight: bool) -> DocumentProjects {
		var path = DocumentUri.filePath(uri), nearestPath: string;
		if (path != null) nearestPath = nearest(path);
		refreshConfigs(preflight);
		var governing = if(nearestPath != null, load(nearestPath));
		var selection = select(path, nearestPath, governing);
		var active = selection.1;
		if (active != null) active.lastUsed = ++nextUse;
		if (active == null && !singleFileWarned) {
			singleFileWarned = true;
			if (warn != null) warn("Without a project file selecting this document, semantic features are limited; using single-file mode.");
		}
		return DocumentProjects.new(nearestPath, selection.0, active);
	}
	def owners(paths: Array<string>) -> Array<ProjectContext> {
		var result = Array<ProjectContext>.new(paths.length);
		var nearestByDir = OrderedStringMap<string>.new();
		var governingByPath = OrderedStringMap<WorkspaceConfig>.new();
		for (i < paths.length) {
			var dir = ProjectFiles.parent(paths[i]);
			if (!nearestByDir.has(dir)) nearestByDir[dir] = nearest(paths[i]);
			var nearestPath = nearestByDir[dir], governing: WorkspaceConfig;
			if (nearestPath != null) {
				if (!governingByPath.has(nearestPath)) governingByPath[nearestPath] = load(nearestPath);
				governing = governingByPath[nearestPath];
			}
			result[i] = select(paths[i], nearestPath, governing).1;
		}
		return result;
	}
	// Contexts containing {path} in deterministic order, and the active one.
	private def select(path: string, nearestPath: string, governing: WorkspaceConfig) -> (Array<ProjectContext>, ProjectContext) {
		var disabled = nearestPath != null && (governing == null || governing.diagnostics.length > 0 || governing.contexts.length == 0);
		var contexts = Vector<ProjectContext>.new(), active: ProjectContext;
		if (path != null && !disabled) {
			for (i < configs.length) {
				var c = configs[i];
				for (ctx in c.contexts) { if(ctx.contains(path, false)) contexts.put(ctx); }
			}
		}
		var result = contexts.extract();
		result = Arrays.sort(result, 0, result.length, contextBefore);
		// Prefer membership in the nearest config, then any membership, then a
		// dependency context. Ties: canonical config URI, then declaration order.
		for (ctx in result) {
			if (active == null || rank(ctx, path, nearestPath) < rank(active, path, nearestPath)) active = ctx;
		}
		return (result, active);
	}
	private def rank(ctx: ProjectContext, path: string, nearestPath: string) -> int {
		if (!ctx.contains(path, true)) return 2;
		return if(nearestPath != null && Strings.equal(ctx.config.uri, ProjectFiles.uri(nearestPath)), 0, 1);
	}
	private def contextBefore(a: ProjectContext, b: ProjectContext) -> bool {
		if (!Strings.equal(a.config.uri, b.config.uri)) return ProjectFiles.before(a.config.uri, b.config.uri);
		return a.definition.begin < b.definition.begin;
	}
}
