// A directory's entry names in byte order, and at the same index each entry's
// d_type: 4 for a directory, 8 for a regular file, 0 if unknown.
class ProjectDirectory(names: Array<string>, types: Array<byte>, examined: int, overflow: bool) { }

// No realpath: lexical document identity and no symlink traversal. Descriptors
// anchor each path component, so renaming/replacing it cannot redirect a walk.
component ProjectFiles {
	def REGULAR = 0x8000;
	def DIRECTORY = 0x4000;
	def join(dir: string, name: string) -> string {
		return Strings.format2(if(Strings.equal(dir, "/"), "%s%s", "%s/%s"), dir, name);
	}
	def parent(path: string) -> string {
		var i = path.length - 1;
		while (i > 0 && path[i] != '/') i--;
		return if(i == 0, "/", Arrays.range(path, 0, i));
	}
	def uri(path: string) -> string {
		var b = StringBuilder.new().puts("file://");
		for (ch in path) {
			if (ch == '/' || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
				(ch >= '0' && ch <= '9') || ch == '-' || ch == '_' || ch == '.' || ch == '~') b.putc(ch);
			else b.putc('%').putc(Chars.hexMap_u[ch >> 4]).putc(Chars.hexMap_u[ch & 15]);
		}
		return b.extract();
	}
	def open(path: string, directory: bool) -> int {
		if (path == null || path.length == 0) return -1;
		var fd = HostOs.openDirectoryRoot(path[0] == '/');
		var parts = Strings.split(path, "/", -1);
		for (i < parts.length) {
			var part = parts[i];
			if (part.length == 0 || Strings.equal(part, ".")) continue;
			if (fd < 0) return fd;
			if (Strings.equal(part, "..")) { HostOs.close(fd); return -1; }
			var next = HostOs.openChild(fd, part, directory || i < parts.length - 1);
			HostOs.close(fd);
			fd = next;
		}
		return fd;
	}
	// An unreadable or symlinked config marker must not silently fall through
	// to an ancestor's project. load() will report why it cannot be used.
	def configMarker(path: string) -> bool {
		var fd = open(path, false);
		if (fd < 0) return fd != -2 && fd != -20; // ENOENT, ENOTDIR on both hosts
		var info = HostOs.fileMetadata(fd);
		HostOs.close(fd);
		return info.0 == REGULAR || info.0 < 0;
	}
	def metadataError(kind: int) -> bool {
		return kind < 0 && kind != -2 && kind != -20 && kind != HostOs.ELOOP;
	}
	def metadata(path: string) -> (int, long) {
		if (path == null || path.length == 0) return (-1, -1L);
		var slash = path.length - 1;
		while (slash >= 0 && path[slash] != '/') slash--;
		var dir = if(slash < 0, ".", if(slash == 0, "/", Arrays.range(path, 0, slash)));
		var name = if(slash + 1 == path.length, ".", Arrays.range(path, slash + 1, path.length));
		if (Strings.equal(name, "..")) return (-1, -1L);
		var fd = open(dir, true);
		if (fd < 0) return (fd, -1L);
		var result = HostOs.childMetadata(fd, name);
		HostOs.close(fd);
		return result;
	}
	def load(path: string, budget: int) -> Array<byte> {
		var fd = open(path, false);
		if (fd < 0) return null;
		var info = HostOs.fileMetadata(fd);
		var regular = info.0 == REGULAR && info.1 >= 0 && info.1 <= budget;
		var text = if(regular, readExpected(fd, int.view(info.1), budget));
		HostOs.close(fd);
		return text;
	}
	// Reads {fd} to its end, expecting the {expected} bytes that fstat
	// reported: into an array of that length, so a file whose length holds
	// costs one read, one end-of-file read, and no copy. A file that shrank
	// since fstat yields the bytes that remain. One that grew is never cut
	// short: the read continues in chunks, and the whole is still subject to
	// {budget}, as before this sized read (#413). Exceeding it fails, as at
	// fstat. Reads past {expected} are rare, so they favor simplicity.
	def readExpected(fd: int, expected: int, budget: int) -> Array<byte> {
		var buf = Array<byte>.new(expected), at = 0;
		while (at < expected) {
			var n = HostOs.read(fd, buf[at ..+ (expected - at)]);
			if (n == HostOs.EINTR) continue;
			if (n < 0) return null;
			if (n == 0) return Arrays.range(buf, 0, at);
			at += n;
		}
		// One byte detects growth; once it is found, read in 4,096-byte chunks.
		var chunk = Array<byte>.new(1), b: StringBuilder;
		while (true) {
			var n = HostOs.read(fd, chunk);
			if (n == HostOs.EINTR) continue;
			if (n == 0) return if(b == null, buf, b.extract());
			if (n < 0 || n > budget - if(b == null, expected, b.length)) return null;
			if (b == null) b = StringBuilder.new().putr(buf);
			b.putr(chunk[0 ..+ n]);
			if (chunk.length == 1) chunk = Array<byte>.new(4096);
		}
		return null;
	}
	def list(path: string, maxEntries: int) -> ProjectDirectory {
		var fd = open(path, true);
		if (fd < 0) return ProjectDirectory.new(null, null, 0, false);
		var entries = Vector<(string, byte)>.new();
		var buf = Array<byte>.new(8192), ok = false;
		var examined = 0, overflow = false;
		while (true) {
			var n = HostOs.readDirectory(fd, buf);
			if (n == HostOs.EINTR) continue;
			if (n == 0) { ok = true; break; }
			if (n < 0) break;
			var at = 0;
			while (at < n) {
				var r = at + HostOs.directoryRecordOffset, start = at + HostOs.directoryNameOffset;
				if (start >= n) break;
				var len = int.view(buf[r]) | (int.view(buf[r + 1]) << 8);
				if (len <= HostOs.directoryNameOffset || len > n - at) break;
				var end = start;
				while (end < at + len && buf[end] != 0) end++;
				if (end == at + len) break;
				var name = Arrays.range(buf, start, end);
				if (!Strings.equal(name, ".") && !Strings.equal(name, "..")) {
					if (++examined > maxEntries) { overflow = true; break; }
					entries.put((name, buf[at + HostOs.directoryTypeOffset]));
				}
				at += len;
			}
			if (at != n) break;
		}
		HostOs.close(fd);
		if (!ok) return ProjectDirectory.new(null, null, examined, overflow);
		// Each type is sorted with its name rather than looked up by it, since
		// a map keyed by names can be made to collide (see OrderedStringSet).
		var sorted = entries.extract();
		sorted = Arrays.sort(sorted, 0, sorted.length, entryBefore);
		var names = Array<string>.new(sorted.length), types = Array<byte>.new(sorted.length);
		for (i < sorted.length) { names[i] = sorted[i].0; types[i] = sorted[i].1; }
		return ProjectDirectory.new(names, types, examined, false);
	}
	private def entryBefore(a: (string, byte), b: (string, byte)) -> bool {
		return before(a.0, b.0);
	}
	def before(a: string, b: string) -> bool {
		for (i = 0; i < a.length && i < b.length; i++) {
			if (a[i] != b[i]) return a[i] < b[i];
		}
		return a.length < b.length;
	}
}
