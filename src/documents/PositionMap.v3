// The LSP 3.17 position encodings: the unit that {LspPosition.character}
// counts. UTF-16 is the default that every client supports. {lspName} is the
// name used in the `positionEncoding` capabilities.
enum PositionEncoding(lspName: string) {
	UTF16("utf-16"),
	UTF8("utf-8"),
	UTF32("utf-32")
}

// A zero-based LSP position. {character} counts units of the negotiated
// {PositionEncoding} from the start of the line.
class LspPosition(line: int, character: int) {
	def equals(that: LspPosition) -> bool {
		return that != null && line == that.line && character == that.character;
	}
	def render(buf: StringBuilder) -> StringBuilder {
		return buf.put2("%d:%d", line, character);
	}
}

// A zero-based LSP range. {end} is exclusive.
class LspRange(start: LspPosition, end: LspPosition) { }

// Translates between the three coordinate systems for one immutable document
// text: UTF-8 byte offsets, compiler line/column pairs, and LSP positions in
// one {PositionEncoding}. It does no I/O and is independent of the compiler;
// compiler coordinates are plain ints.
//
// Byte offsets run from 0 to {text.length} inclusive. Every conversion
// accepts any int and clamps it into range, so no input traps.
//
// Compiler coordinates follow Aeneas (vendor/virgil/aeneas/src/vst/ParserState.v3,
// {ParserState.column}, and the same tab rule in Parser.v3 {skipToNextToken}):
// - Lines are one-based and end only at '\n'. A '\r' is an ordinary byte, so
//   a lone '\r' does not start a compiler line, and the '\r' of "\r\n" takes
//   a column at the end of its line.
// - Columns are one-based and count bytes, so each byte of a non-ASCII
//   character takes a column. A tab moves column c to 1 + ((c + 8) / 8) * 8.
//   That is the next tab stop of width 8 (9, 17, 25, ...), except that a tab
//   at a column that is a multiple of 8 skips a stop: from column 8 it moves
//   to 17, not 9.
// Aeneas departs from this rule in a few places, and positions it reports
// after them on the same line are shifted: inside a block comment it counts a
// tab as one column, and after a line comment that ends the file it does not
// advance at all.
//
// LSP positions follow LSP 3.17:
// - Lines are zero-based and end at "\n", "\r\n", or "\r". The terminator is
//   not part of the line, so a position never falls inside it.
// - {character} counts code units of the encoding. The text is decoded as
//   UTF-8, with each invalid sequence read as one U+FFFD, as the WHATWG
//   decoder does: a byte that cannot start a sequence, or the longest valid
//   prefix of a truncated sequence, is one U+FFFD. U+FFFD is 1 UTF-16 unit,
//   1 UTF-32 unit, and 3 UTF-8 units.
// - A character past the end of its line means the end of the line. A line
//   past the last line means the end of the document. Negative values mean 0.
// - A position inside a character (in the middle of a surrogate pair, or of a
//   multi-byte UTF-8 sequence) means the start of that character.
// - A byte offset inside a character, or between the '\r' and '\n' of "\r\n",
//   maps to the position before that character or terminator.
class PositionMap {
	def text: Array<byte>;
	def encoding: PositionEncoding;
	// LSP line {i} holds the bytes from {lspStarts[i]} up to {lspEnds[i]},
	// excluding its terminator.
	private def lspStarts = Vector<int>.new();
	private def lspEnds = Vector<int>.new();
	// Compiler line {i + 1} starts at byte {compilerStarts[i]}.
	private def compilerStarts = Vector<int>.new();

	new(text, encoding) {
		var max = if(text == null, 0, text.length);
		lspStarts.put(0);
		compilerStarts.put(0);
		var i = 0;
		while (i < max) {
			var b = text[i];
			if (b == '\n') {
				lspEnds.put(i);
				lspStarts.put(i + 1);
				compilerStarts.put(i + 1);
			} else if (b == '\r') {
				lspEnds.put(i);
				if (i + 1 < max && text[i + 1] == '\n') {
					i++;
					compilerStarts.put(i + 1);
				}
				lspStarts.put(i + 1);
			}
			i++;
		}
		lspEnds.put(max);
	}

	// The number of LSP lines. A document that ends with a line terminator
	// has an empty last line.
	def lineCount() -> int {
		return lspStarts.length;
	}
	// The number of compiler lines.
	def compilerLineCount() -> int {
		return compilerStarts.length;
	}
	// The length of the text in bytes.
	def length() -> int {
		return if(text == null, 0, text.length);
	}

	// Converts byte {offset} to an LSP position.
	def offsetToPosition(offset: int) -> LspPosition {
		offset = clampOffset(offset);
		var line = findLine(lspStarts, offset);
		var i = lspStarts[line], end = lspEnds[line], character = 0;
		if (offset > end) offset = end;
		while (i < offset) {
			var len = sequenceLength(i);
			if (i + len > offset) break;
			character += units(i, len);
			i += len;
		}
		return LspPosition.new(line, character);
	}
	// Converts the LSP position {line}:{character} to a byte offset.
	def positionToOffset(line: int, character: int) -> int {
		if (line < 0) return 0;
		if (line >= lspStarts.length) return length();
		var i = lspStarts[line], end = lspEnds[line], count = 0;
		while (i < end) {
			var len = sequenceLength(i);
			var next = count + units(i, len);
			if (next > character) break;
			count = next;
			i += len;
		}
		return i;
	}
	// Converts byte {offset} to a compiler (line, column) pair.
	def offsetToCompiler(offset: int) -> (int, int) {
		offset = clampOffset(offset);
		var line = findLine(compilerStarts, offset);
		var column = 1;
		for (i = compilerStarts[line]; i < offset; i++) column = nextColumn(column, text[i]);
		return (line + 1, column);
	}
	// Converts the compiler position {line}:{column} to a byte offset. A
	// column inside a tab's expansion means the tab. A column past the end of
	// the line means the end of the line, before its '\n'. A line before the
	// first means the start of the document, and a line past the last means
	// the end of the document.
	def compilerToOffset(line: int, column: int) -> int {
		if (line < 1) return 0;
		if (line > compilerStarts.length) return length();
		var i = compilerStarts[line - 1];
		var end = if(line < compilerStarts.length, compilerStarts[line] - 1, length());
		var c = 1;
		while (i < end) {
			var next = nextColumn(c, text[i]);
			if (next > column) break;
			c = next;
			i++;
		}
		return i;
	}
	// Converts the compiler position {line}:{column} to an LSP position.
	def compilerToPosition(line: int, column: int) -> LspPosition {
		return offsetToPosition(compilerToOffset(line, column));
	}
	// Converts the LSP position {line}:{character} to a compiler (line,
	// column) pair.
	def positionToCompiler(line: int, character: int) -> (int, int) {
		return offsetToCompiler(positionToOffset(line, character));
	}
	// Converts a compiler range to an LSP range. Each end is converted
	// separately, and the conversion preserves order, so an empty range stays
	// empty.
	def compilerRangeToLsp(beginLine: int, beginColumn: int, endLine: int, endColumn: int) -> LspRange {
		return LspRange.new(compilerToPosition(beginLine, beginColumn), compilerToPosition(endLine, endColumn));
	}

	private def clampOffset(offset: int) -> int {
		if (offset < 0) return 0;
		var max = length();
		return if(offset > max, max, offset);
	}
	// Returns the index of the last line in {starts} that starts at or
	// before {offset}.
	private def findLine(starts: Vector<int>, offset: int) -> int {
		var lo = 0, hi = starts.length - 1;
		while (lo < hi) {
			var mid = lo + (hi - lo + 1) / 2;
			if (starts[mid] <= offset) lo = mid;
			else hi = mid - 1;
		}
		return lo;
	}
	// The compiler column after byte {b} at column {c}.
	private def nextColumn(c: int, b: byte) -> int {
		return if(b == '\t', 1 + ((c + 8) / 8) * 8, c + 1);
	}
	// The number of encoding units for the {len}-byte sequence at {i}.
	private def units(i: int, len: int) -> int {
		match (encoding) {
			UTF16 => return if(len == 4, 2, 1);
			UTF8 => return if(len == expectedLength(text[i]), len, 3);
			UTF32 => return 1;
		}
	}
	// The length of the UTF-8 sequence that byte {b} starts, or 0 if it
	// cannot start one. A sequence found by {sequenceLength} is a complete
	// character, rather than a U+FFFD, exactly when it has this length.
	private def expectedLength(b: byte) -> int {
		if (b < 0x80) return 1;
		if (b < 0xC2) return 0;
		if (b < 0xE0) return 2;
		if (b < 0xF0) return 3;
		if (b < 0xF5) return 4;
		return 0;
	}
	// The length of the character that starts at byte {i}: a complete UTF-8
	// sequence, or the bytes read as one U+FFFD.
	private def sequenceLength(i: int) -> int {
		var b = text[i];
		var need = expectedLength(b);
		if (need <= 1) return 1;
		// The second byte has a narrower range after some lead bytes, which
		// rules out overlong forms, surrogates, and values above U+10FFFF.
		var lo: byte = 0x80, hi: byte = 0xBF;
		match (b) {
			0xE0 => lo = 0xA0;
			0xED => hi = 0x9F;
			0xF0 => lo = 0x90;
			0xF4 => hi = 0x8F;
			_ => ;
		}
		var len = 1, max = text.length;
		while (len < need) {
			if (i + len >= max) break;
			var c = text[i + len];
			if (c < lo || c > hi) break;
			len++;
			lo = 0x80;
			hi = 0xBF;
		}
		return len;
	}
}
