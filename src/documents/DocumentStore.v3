// Aggregate retained-overlay budget, independent of the per-message limit.
// Charge metadata too, so empty documents cannot bypass the bound.
component DocumentLimits {
	def MAX_BYTES = 1024 * 1024;
	def RECORD_BYTES = 256;
	def EXCEEDED = "aggregate open-document capacity exceeded; close documents or reduce text and retry";
	// Files whose disk changes are tracked one by one; see DocumentStore.diskChanged.
	def MAX_DISK_STAMPS = 8192;
}

// An accepted version of an open document. Treat text bytes as read-only.
// Updates replace the record, so a retained record keeps its original version.
class DocumentOverlay(uri: string, languageId: string, version: int, text: Array<byte>,
		token: DocumentVersionIdentity) {
	// A lightweight identity for this accepted record. Retaining it does not
	// retain text, and close/reopen cannot revive an old version stamp. A
	// version-only update keeps the previous record's identity, since its text
	// is unchanged.
	def identity = if(token == null, DocumentVersionIdentity.new(), token);
}
class DocumentVersionIdentity { }

// Versioned overlays with no direct file I/O. The injected reader receives a
// decoded local absolute path and returns bytes, or null if unavailable.
// Mutation methods return null on success, or a reason for ignoring the event.
class DocumentStore {
	private var reader: string -> Array<byte>;
	private var boundedReader: (string, int) -> Array<byte>;

	private var capacity: int;
	private var used: long;

	// Supply MAX_BYTES in production; smaller budgets exercise boundaries in tests.
	new(reader, capacity) { }
	// The stdio entry point supplies its disk reader; tests supply a fake.
	def withReader(reader: string -> Array<byte>) -> this {
		this.reader = reader;
	}
	def withBoundedReader(reader: (string, int) -> Array<byte>) -> this {
		boundedReader = reader;
	}
	// Development whole-program inputs have an aggregate wire-size budget.
	// Production supplies a reader that enforces it before allocating a file.
	def readBounded(uri: string, maxBytes: int) -> Array<byte> {
		var doc = overlay(uri);
		if (doc != null) return if(doc.text.length <= maxBytes, doc.text);
		var path = DocumentUri.filePath(uri);
		if (path == null) return null;
		return if(boundedReader != null, boundedReader(path, maxBytes));
	}
	// Keyed by canonical URI in ordered maps, which take O(log n) whatever
	// the URIs; see OrderedStringMap.
	private def overlays = OrderedStringMap<DocumentOverlay>.new();
	// Disk stamps of files the client reported changed on disk. Files never
	// reported share {diskEpoch}, which every stamp loses when the map is full.
	private var diskStamps = OrderedStringMap<DocumentVersionIdentity>.new();
	private var diskEpoch = DocumentVersionIdentity.new();

	// Visit only documents the client has open, without copying their text.
	def eachOpen(visit: (string, DocumentOverlay) -> void) { overlays.apply(visit); }
	def overlay(uri: string) -> DocumentOverlay {
		return canonicalOverlay(DocumentUri.normalize(uri));
	}
	// overlay() of a URI that DocumentUri.normalize returned, or of null,
	// without normalizing it again.
	def canonicalOverlay(key: string) -> DocumentOverlay {
		return if(key != null, overlays[key]);
	}
	// An open overlay always wins, including an empty document. Non-file URIs
	// have no disk fallback; closed files are read afresh, not cached.
	def read(uri: string) -> Array<byte> {
		var doc = overlay(uri);
		if (doc != null) return doc.text;
		var path = DocumentUri.filePath(uri);
		return if(path != null && reader != null, reader(path));
	}
	def open(uri: string, languageId: string, version: int, text: Array<byte>) -> string {
		var key = DocumentUri.normalize(uri);
		if (key == null) return "invalid or nonlocal file URI";
		if (text == null || languageId == null) return "missing document text or languageId";
		// Duplicate opens are ignored, even with a newer version. A client must
		// close first to begin a new version sequence.
		if (overlays[key] != null) return "document is already open";
		var charge = cost(key, languageId, text);
		if (charge > long.view(capacity) - used) return DocumentLimits.EXCEEDED;
		overlays[key] = DocumentOverlay.new(key, languageId, version, text, null);
		used += charge;
		return null;
	}
	def change(uri: string, version: int, text: Array<byte>) -> string {
		var doc = overlay(uri);
		if (doc == null) return "document is not open";
		if (version <= doc.version) return "document version is not newer";
		if (text == null) return "missing document text";
		var remaining = used - cost(doc.uri, doc.languageId, doc.text);
		var charge = cost(doc.uri, doc.languageId, text);
		if (charge > long.view(capacity) - remaining) return DocumentLimits.EXCEEDED;
		overlays[doc.uri] = DocumentOverlay.new(doc.uri, doc.languageId, version, text, null);
		used = remaining + charge;
		return null;
	}
	// A didChange with no content changes: the text stays byte-for-byte the
	// same, and only the version moves. The new record keeps the old identity,
	// so analyses, diagnostics, and cached results of the same text stay
	// current. The charge is unchanged, since the text, URI, and language ID
	// are the ones the old record already held.
	def changeVersion(uri: string, version: int) -> string {
		var doc = overlay(uri);
		if (doc == null) return "document is not open";
		if (version <= doc.version) return "document version is not newer";
		overlays[doc.uri] = DocumentOverlay.new(doc.uri, doc.languageId, version, doc.text, doc.identity);
		return null;
	}
	private def cost(uri: string, languageId: string, text: Array<byte>) -> long {
		return long.view(DocumentLimits.RECORD_BYTES) + long.view(uri.length) +
			long.view(languageId.length) + long.view(text.length);
	}
	// The current stamp of {uri}'s file on disk. Analyses record it for disk
	// inputs; a later {diskChanged} for the file replaces it.
	def diskStamp(uri: string) -> DocumentVersionIdentity {
		var key = DocumentUri.normalize(uri);
		var stamp = if(key != null, diskStamps[key]);
		return if(stamp != null, stamp, diskEpoch);
	}
	// Records that {uri}'s file changed, appeared, or disappeared on disk.
	// Beyond MAX_DISK_STAMPS files, every disk stamp is replaced instead.
	def diskChanged(uri: string) {
		var key = DocumentUri.normalize(uri);
		if (key == null || DocumentUri.filePath(key) == null) return;
		if (diskStamps.length >= DocumentLimits.MAX_DISK_STAMPS && !diskStamps.has(key)) {
			diskStamps = OrderedStringMap<DocumentVersionIdentity>.new();
			diskEpoch = DocumentVersionIdentity.new();
			return;
		}
		diskStamps[key] = DocumentVersionIdentity.new();
	}
	def save(uri: string) -> string {
		if (overlay(uri) == null) return "document is not open";
		return null;
	}
	def close(uri: string) -> string {
		var doc = overlay(uri);
		if (doc == null) return "document is not open";
		overlays.remove(doc.uri);
		used -= cost(doc.uri, doc.languageId, doc.text);
		return null;
	}
}
