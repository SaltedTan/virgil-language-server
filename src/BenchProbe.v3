// Compile-time instrumentation, unreachable in ordinary builds. Keep all
// state here so product objects gain no fields. Formatting uses a static
// buffer and allocates nothing: the default worker is near its GC cliff.
component BenchProbe {
	def enabled = false;
	private def buffer = Array<byte>.new(160);
	private var end: int;
	var roundtripStart: int;
	var workerStart: int;
	var serverGcStart: int;
	var serverAllocatedStart: long;
	// Parse work of the last whole-program analysis; see BenchParseWork.
	private var parseWork: BenchParseWork;

	def now() -> int { return if(enabled, System.ticksUs()); }
	def gcCount() -> int { return if(enabled, GcStats.gc_count); }
	def allocated() -> long {
		return if(enabled, GcStats.allocated_bytes + Semispace.fromSpaceAllocated());
	}
	def heap() -> long { return if(enabled, Semispace.fromSpaceUsed()); }
	def server(id: int, name: string, value: long) {
		if (enabled) sample("server", id, name, value);
	}
	def worker(id: int, name: string, value: long) {
		if (enabled) sample("worker", id, name, value);
	}
	// Before a program's parse, with language options {options} (see
	// AeneasAdapter). Its own time is reported apart from the parse.
	def classifyParse(paths: Array<string>, inputs: Array<Array<byte>>, options: u64) {
		if (!enabled) return;
		var start = now();
		if (parseWork == null) parseWork = BenchParseWork.new();
		parseWork.classify(paths, inputs, options);
		parseWork.classifyUs = now() - start;
	}
	// File {i} of the program took {us} to parse.
	def parsedFile(i: int, bytes: int, us: int) {
		if (enabled && parseWork != null) parseWork.parsed(i, bytes, us);
	}
	// Reports the last program's parse work as analysis {id}'s.
	def reportParse(id: int) {
		if (!enabled || parseWork == null) return;
		var w = parseWork;
		worker(id, "parse_classify_us", w.classifyUs);
		worker(id, "parse_unchanged_files", w.sameFiles);
		worker(id, "parse_unchanged_bytes", w.sameBytes);
		worker(id, "parse_unchanged_us", w.sameUs);
		worker(id, "parse_changed_files", w.changedFiles);
		worker(id, "parse_changed_bytes", w.changedBytes);
		worker(id, "parse_changed_us", w.changedUs);
		worker(id, "parse_unvisited_files", w.unvisited());
	}
	private def sample(process: string, id: int, name: string, value: long) {
		end = 0;
		text("BENCH "); text(process); text(" "); number(long.view(id));
		text(" "); text(name); text(" "); number(value); text("\n");
		// Only stderr. Neither protocol stdout nor the worker RESULT pipe.
		System.fileWriteK(Log.STDERR, buffer, 0, end);
	}
	private def text(s: string) {
		for (b in s) buffer[end++] = b;
	}
	private def number(value: long) {
		var n = value;
		if (n < 0) { buffer[end++] = '-'; n = -n; }
		var divisor = 1L;
		while (divisor <= n / 10) divisor *= 10;
		while (divisor > 0) {
			buffer[end++] = byte.view(n / divisor) + '0';
			n %= divisor;
			divisor /= 10;
		}
	}
}

// Classifies each file of a whole-program parse by whether the previous
// program's parse in this process parsed the same path and bytes with the
// same language options, and sums each class's files, bytes, and parse
// times. Only files that the previous parse reached count: one it skipped at
// the error limit was never parsed, so its next parse is a changed file's.
// Only hashes of the inputs are kept. Separate from BenchProbe so that unit
// tests can run it in an ordinary build.
class BenchParseWork {
	private var paths: Array<u64>;
	private var texts: Array<u64>;
	private var options: u64;
	private var reached: Array<bool>;	// which files have been parsed
	private var same: Array<bool>;
	private var visited: int;
	var classifyUs: long;
	var sameFiles: long;
	var sameBytes: long;
	var sameUs: long;
	var changedFiles: long;
	var changedBytes: long;
	var changedUs: long;

	def classify(newPaths: Array<string>, inputs: Array<Array<byte>>, newOptions: u64) {
		var count = newPaths.length;
		var hashes = Array<u64>.new(count), hashed = Array<u64>.new(count);
		same = Array<bool>.new(count);
		for (i < count) {
			var path = newPaths[i], input = inputs[i];
			hashes[i] = AnalysisTables.hashBytes(path, if(path != null, path.length), 0);
			hashed[i] = AnalysisTables.hashBytes(input, input.length, u64.view(input.length));
			if (paths == null || newOptions != options) continue;
			// Same index first; a membership change shifts the rest.
			var j = if(i < paths.length && reached[i] && paths[i] == hashes[i], i, -1);
			for (k = 0; j < 0 && k < paths.length; k++) {
				if (reached[k] && paths[k] == hashes[i]) j = k;
			}
			same[i] = j >= 0 && texts[j] == hashed[i];
		}
		paths = hashes;
		texts = hashed;
		options = newOptions;
		reached = Array<bool>.new(count);
		visited = 0;
		sameFiles = sameBytes = sameUs = changedFiles = changedBytes = changedUs = 0;
	}
	// File {i} of the classified program took {us} to parse.
	def parsed(i: int, bytes: int, us: int) {
		if (same == null || i >= same.length) return;
		reached[i] = true;
		visited++;
		if (same[i]) {
			sameFiles++;
			sameBytes += bytes;
			sameUs += us;
		} else {
			changedFiles++;
			changedBytes += bytes;
			changedUs += us;
		}
	}
	// Files of the classified program that its parse didn't reach.
	def unvisited() -> int {
		return if(same != null, same.length - visited);
	}
}
