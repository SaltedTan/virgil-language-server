// The keywords of the pinned Aeneas parser (Keywords in
// vendor/virgil/aeneas/src/vst/Parser.v3), each with the LspCursorSyntax
// positions where the parser accepts it: {always}, and {gated} when the
// language option of the AnalysisKeywordForms flag {form} is on. A keyword
// is offered only if Aeneas's own list has it (AeneasAdapter.keywords), and
// a test requires the two lists to be equal.
enum LspKeyword(always: int, gated: int, form: int) {
	BREAK(LspCursorSyntax.STATEMENT, 0, 0),
	CASE(LspCursorSyntax.CASE_DECL, 0, 0),
	CLASS(LspCursorSyntax.TOP_LEVEL | LspCursorSyntax.AFTER_PRIVATE, 0, 0),
	COMPONENT(LspCursorSyntax.TOP_LEVEL | LspCursorSyntax.AFTER_PRIVATE | LspCursorSyntax.AFTER_THREAD
		| LspCursorSyntax.AFTER_IMPORT, 0, 0),
	CONTINUE(LspCursorSyntax.STATEMENT, 0, 0),
	DEF(LspCursorSyntax.TOP_LEVEL | LspCursorSyntax.MEMBER_DECL | LspCursorSyntax.CASE_DECL
		| LspCursorSyntax.STATEMENT | LspCursorSyntax.AFTER_PRIVATE_MEMBER | LspCursorSyntax.AFTER_EXPORT, 0, 0),
	DESCRIBES(0, LspCursorSyntax.CLASS_HEADER, AnalysisKeywordForms.DESCRIPTORS),
	DESCRIPTOR(0, LspCursorSyntax.CLASS_HEADER, AnalysisKeywordForms.DESCRIPTORS),
	ELSE(LspCursorSyntax.ELSE, 0, 0),
	ENUM(LspCursorSyntax.TOP_LEVEL | LspCursorSyntax.AFTER_PRIVATE, 0, 0),
	EXPORT(LspCursorSyntax.TOP_LEVEL, 0, 0),
	EXTENDS(LspCursorSyntax.CLASS_HEADER, LspCursorSyntax.VARIANT_HEADER, AnalysisKeywordForms.OPEN_TYPES),
	FALSE(LspCursorSyntax.EXPRESSION | LspCursorSyntax.PATTERN, 0, 0),
	FOR(LspCursorSyntax.STATEMENT, 0, 0),
	FUN(0, LspCursorSyntax.EXPRESSION, AnalysisKeywordForms.FUN_EXPRS),
	IF(LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION, 0, 0),
	IMPORT(LspCursorSyntax.TOP_LEVEL, 0, 0),
	IN(LspCursorSyntax.FOR_IN, 0, 0),
	LAYOUT(LspCursorSyntax.TOP_LEVEL, 0, 0),
	MATCH(LspCursorSyntax.STATEMENT, 0, 0),
	NEW(LspCursorSyntax.MEMBER_DECL | LspCursorSyntax.AFTER_PRIVATE_MEMBER, 0, 0),
	NULL(LspCursorSyntax.EXPRESSION | LspCursorSyntax.PATTERN, 0, 0),
	PACKING(LspCursorSyntax.TOP_LEVEL | LspCursorSyntax.AFTER_PRIVATE, 0, 0),
	PRIVATE(LspCursorSyntax.TOP_LEVEL | LspCursorSyntax.MEMBER_DECL, 0, 0),
	RETURN(LspCursorSyntax.STATEMENT, 0, 0),
	// Reserved, but no declaration, statement, or expression starts with it.
	STRUCT(0, 0, 0),
	SUPER(LspCursorSyntax.CONSTRUCTOR_HEADER, 0, 0),
	THREAD(LspCursorSyntax.TOP_LEVEL | LspCursorSyntax.AFTER_PRIVATE, 0, 0),
	TRUE(LspCursorSyntax.EXPRESSION | LspCursorSyntax.PATTERN, 0, 0),
	TYPE(LspCursorSyntax.TOP_LEVEL | LspCursorSyntax.AFTER_PRIVATE, 0, 0),
	VAR(LspCursorSyntax.TOP_LEVEL | LspCursorSyntax.MEMBER_DECL | LspCursorSyntax.STATEMENT
		| LspCursorSyntax.PARAMETER | LspCursorSyntax.AFTER_PRIVATE_MEMBER | LspCursorSyntax.AFTER_DEF_MEMBER, 0, 0),
	WHILE(LspCursorSyntax.STATEMENT, 0, 0)
}

// Keyword spellings, lookup, and the candidates at a cursor.
component LspKeywords {
	// Each LspKeyword's spelling, by tag: its name in lower case.
	def SPELLINGS = spell();

	private def spell() -> Array<string> {
		var a = Array<string>.new(LspKeyword.count);
		for (kw in LspKeyword.set.all) {
			var s = Array<byte>.new(kw.name.length);
			for (i < s.length) s[i] = kw.name[i] | '\x20';
			a[kw.tag] = s;
		}
		return a;
	}
	// The keyword that the bytes of {text} from {begin} to {end} spell, if
	// any. Aeneas checks only identifiers of two or more bytes.
	def find(text: Array<byte>, begin: int, end: int) -> (bool, LspKeyword) {
		var len = end - begin;
		if (len < 2 || len > 10) return (false, LspKeyword.BREAK);
		for (kw in LspKeyword.set.all) {
			var s = SPELLINGS[kw.tag];
			if (s.length != len || s[0] != text[begin]) continue;
			var same = true;
			for (i = 1; same && i < len; i++) same = s[i] == text[begin + i];
			if (same) return (true, kw);
		}
		return (false, LspKeyword.BREAK);
	}
	// The keyword spelled {s}, if any.
	def named(s: string) -> (bool, LspKeyword) {
		return find(s, 0, s.length);
	}
	// The keywords to offer at {ctx} with the AnalysisKeywordForms {forms},
	// in alphabetical order: none in a comment, a literal, or after ".";
	// otherwise each of Aeneas's {keywords} that the table accepts at one of
	// the context's positions.
	def candidates(ctx: LspCursorContext, keywords: Array<string>, forms: int) -> Array<string> {
		if (ctx.place != LspCursorPlace.CODE || ctx.member()) return [];
		var result = Vector<string>.new();
		for (word in keywords) {
			var kw = named(word);
			if (!kw.0) continue;
			var positions = kw.1.always | if((forms & kw.1.form) != 0, kw.1.gated);
			if ((positions & ctx.syntax) != 0) result.put(word);
		}
		return result.extract();
	}
}


// The incomplete-code repair of a completion (ADR-0006): a sentinel identifier
// at the cursor, so that the prefix, the sentinel, and the rest of the
// identifier there are one identifier, which the scope query is at, and after
// it the text that completes the expression or statement, chosen from the
// cursor's context rather than tried in turn. See
// docs/architecture.md#completion.
component LspCompletionRepair {
	// An identifier that no program declares.
	def SENTINEL = "virgilLspCursor";

	// The AnalysisScopeKinds of the names that can be at {ctx}, or 0 where
	// no name can: in a comment or a literal, after ".", or where only
	// keywords or a new name go.
	def kinds(ctx: LspCursorContext) -> int {
		if (ctx.place != LspCursorPlace.CODE || ctx.member()) return 0;
		var s = ctx.syntax;
		if ((s & LspCursorSyntax.TYPE) != 0 && refArgument(ctx)) return AnalysisScopeKinds.LAYOUTS;
		return if((s & (LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION)) != 0, AnalysisScopeKinds.VALUES)
			| if((s & LspCursorSyntax.TYPE) != 0, AnalysisScopeKinds.TYPES)
			| if((s & LspCursorSyntax.PATTERN) != 0, AnalysisScopeKinds.PATTERN);
	}
	// Whether {ctx}'s identifier is the first type argument of "Ref" or "ref",
	// which the verifier resolves as a layout's name, and only so
	// (VstCompoundVerifier.resolveRefType): the innermost open delimiter is
	// the "<" of type arguments right after one of those names, and only
	// space and comments come between it and the identifier.
	def refArgument(ctx: LspCursorContext) -> bool {
		var n = ctx.roles.length;
		if (n == 0 || ctx.roles[n - 1] != LspOpenRole.TYPE_ARGS) return false;
		var text = ctx.text, open = ctx.opens[n - 1];
		if (space(text, open + 1) < ctx.prefixStart) return false;
		var before = LspCursorScanner.new(text).scan(open);
		var begin = if(before.prefixStart < open, before.prefixStart, before.previousName);
		return !before.member() && begin >= 0 && begin + 3 <= open && space(text, begin + 3) == open
			&& (text[begin] == 'R' || text[begin] == 'r') && text[begin + 1] == 'e' && text[begin + 2] == 'f';
	}
	// {ctx}'s text, repaired: the sentinel at the cursor, where it joins the
	// identifier there, and after that identifier's rest, the text that
	// {completion} selects.
	def repair(ctx: LspCursorContext) -> Array<byte> {
		var text = ctx.text, end = ctx.cursor;
		while (end < text.length && isIdentMiddle(text[end])) end++;
		var tail = completion(ctx), buf = StringBuilder.new();
		buf.putk(text, 0, ctx.cursor).puts(SENTINEL).putk(text, ctx.cursor, end).puts(tail);
		return buf.putk(text, end, text.length).extract();
	}
	// What completes the identifier at {ctx}'s cursor, from the text that
	// follows it, past whitespace and comments:
	// - in a match's patterns, " => ;" to complete a case unless "=>" or ","
	//   follows;
	// - nothing where the text after it completes the expression: before the
	//   closer of the innermost open delimiter, ",", an operator, or "=", and
	//   before ";" in a for loop's header;
	// - before "{", the closers of the open delimiters in the innermost
	//   block, innermost first, as in "if (" before its body;
	// - otherwise, those closers and ";", which ends the statement or the
	//   declaration.
	def completion(ctx: LspCursorContext) -> string {
		var text = ctx.text, closers = StringBuilder.new();
		for (i = ctx.roles.length - 1; i >= 0; i--) {
			var c = text[ctx.opens[i]];
			if (c == '{') break;
			closers.putc(if(c == '(', ')', if(c == '<', '>', ']')));
		}
		var close = closers.toString();
		var inner = if(ctx.roles.length > 0, ctx.roles[ctx.roles.length - 1], LspOpenRole.TOP);
		var i = next(text, ctx.cursor);
		var n = if(i < text.length, text[i], '\x00'), n2 = if(i + 1 < text.length, text[i + 1], '\x00');
		if ((ctx.syntax & LspCursorSyntax.PATTERN) != 0 && inner == LspOpenRole.MATCH) {
			return if((n == '=' && n2 == '>') || n == ',', "", " => ;");
		}
		if (close.length > 0 && n == close[0]) return "";
		if (n == ';' && (inner == LspOpenRole.FOR || inner == LspOpenRole.FOR_CLAUSES)) return "";
		match (n) {
			',', '=', '+', '-', '*', '/', '%', '&', '|', '^', '<', '>', '!', '?', '.' => return "";
			'{', ';' => return close;
			_ => ;
		}
		return Strings.format1("%s;", close);
	}
	// The first byte at or after {i} that is not part of the identifier
	// there, whitespace, or a comment.
	private def next(text: Array<byte>, i: int) -> int {
		while (i < text.length && isIdentMiddle(text[i])) i++;
		return space(text, i);
	}
	// The first byte at or after {i} that is not whitespace or a comment.
	private def space(text: Array<byte>, i: int) -> int {
		var n = text.length;
		while (i < n) {
			var c = text[i];
			if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
				i++;
			} else if (c == '/' && i + 1 < n && text[i + 1] == '/') {
				while (i < n && text[i] != '\n') i++;
			} else if (c == '/' && i + 1 < n && text[i + 1] == '*') {
				i += 2;
				while (i < n && !(text[i] == '*' && i + 1 < n && text[i + 1] == '/')) i++;
				i = if(i < n, i + 2, n);
			} else {
				break;
			}
		}
		return i;
	}
	private def isIdentMiddle(c: byte) -> bool {
		return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
	}
}

// One textDocument/completion request whose candidates need an analysis, from
// its arrival to its reply. Its job's functions are bound to it, so that a
// request that was replaced or cancelled is told apart from the current one.
class LspCompletionRequest(owner: LspCompletion, id: JsonRpcId, keywords: Array<JsonValue>, range: JsonValue) {
	// Its reply has been sent.
	var answered: bool;
	var job: LspAnalysisJob;
	// The open document as the request found it, its project, the text to
	// analyze for it, as typed or repaired, and the scope query's offset,
	// kinds, and prefix.
	var uri: string;
	var identity: DocumentVersionIdentity;
	var cursor: int;
	var context: ProjectContext;
	var text: Array<byte>;
	var offset: int;
	var kinds: int;
	var prefix: string;
	// LspCompletion's invalidation generation when its analysis began, and
	// whether it has run again because the sources changed while it ran.
	var generation: int;
	var rerun: bool;

	def begin(supervisor: AnalysisSupervisor) -> AnalysisOutcome {
		return owner.begin(this, supervisor);
	}
	def complete(outcome: AnalysisOutcome) {
		owner.complete(this, outcome);
	}
}

// textDocument/completion: the keywords that can start at the cursor, from the
// open document's current text, and the declarations in scope there, from a
// completion analysis of its project: the document as typed if it parses, or
// with the repair that the cursor's context selects (LspCompletionRepair). A
// request that needs no analysis is answered at once. See
// docs/architecture.md#completion.
class LspCompletion(store: DocumentStore, projects: WorkspaceProjects, send: Array<byte> -> void) {
	def KEYWORD_KIND = 14;	// CompletionItemKind.Keyword
	def VARIABLE_KIND = 6;	// CompletionItemKind.Variable, for "this"
	def CLASS_KIND = 7;	// CompletionItemKind.Class, for builtin types
	def MODULE_KIND = 9;	// CompletionItemKind.Module, for System
	// Starts completion analyses, or null without an analysis worker.
	var scheduler: LspSemanticDiagnostics;
	// The completion analyses started, for tests.
	def var analyses: int;
	// The request whose job waits for the worker, and the one whose job runs.
	private var waiting: LspCompletionRequest;
	private var running: LspCompletionRequest;
	// Counts the events that can change a completion's sources or project
	// (invalidate): an analysis that began in an older generation is stale.
	private var generation: int;
	// The last reply with declarations, for its document version and cursor.
	private var cachedUri: string;
	private var cachedIdentity: DocumentVersionIdentity;
	private var cachedCursor: int;
	private var cachedResult: JsonValue;

	def register(dispatcher: JsonRpcDispatcher) {
		dispatcher.onDeferredRequest("textDocument/completion", receive);
	}
	private def receive(request: JsonRpcMessage.Request) {
		var params = if(JsonRpcParams.ByName.?(request.params), JsonRpcParams.ByName.!(request.params).v);
		var doc = objectMember(params, "textDocument"), position = objectMember(params, "position");
		var uri = if(doc != null && doc.has("uri") && JsonValue.String.?(doc["uri"]), JsonValue.String.!(doc["uri"]).v);
		var line = intMember(position, "line"), character = intMember(position, "character");
		if (uri == null || DocumentUri.normalize(uri) == null || line < 0 || character < 0) {
			return respond(request.id, JsonRpcReply.Error(JsonRpcError.new(JsonRpcErrorCode.INVALID_PARAMS,
				"completion params require a valid textDocument.uri and position")));
		}
		var overlay = store.overlay(uri);
		if (overlay == null) return respond(request.id, JsonRpcReply.Result(list([], false)));
		var map = PositionMap.new(overlay.text, PositionEncoding.UTF16);
		var ctx = LspCursorScanner.new(overlay.text).scan(map.positionToOffset(line, character));
		var mapping = projects.forDocument(overlay.uri);
		var forms = AeneasAdapter.keywordForms(mapping.compilerArgs());
		var words = LspKeywords.candidates(ctx, AeneasAdapter.keywords(), forms);
		var range = Strings.newMap<JsonValue>();
		range["start"] = encodePosition(map.offsetToPosition(ctx.prefixStart));
		range["end"] = encodePosition(map.offsetToPosition(ctx.cursor));
		var r = LspCompletionRequest.new(this, request.id, Array<JsonValue>.new(words.length), JsonValue.JObject(range));
		for (i < words.length) r.keywords[i] = item(words[i], KEYWORD_KIND, null, null, r.range);
		var kinds = LspCompletionRepair.kinds(ctx), project = mapping.active;
		var path = DocumentUri.filePath(overlay.uri);
		// Keywords alone where no name can go, and without a project or a worker.
		if (kinds == 0 || project == null || path == null || scheduler == null) return finish(r, keywordList(r));
		if (cachedIdentity != null && cachedIdentity == overlay.identity && cachedCursor == ctx.cursor
				&& Strings.equal(cachedUri, overlay.uri)) {
			return finish(r, JsonRpcReply.Result(cachedResult));
		}
		// The document as typed if it parses, or with the repair; the repair
		// inserts nothing before the cursor, so the identifier's start, where the
		// scope is queried, is the same offset in both (as LspRepairMapping keeps
		// offsets before the cursor).
		var text = overlay.text, options = project.definition.compilerArgs;
		if (!parses(path, text, options)) {
			text = LspCompletionRepair.repair(ctx);
			if (!parses(path, text, options)) return finish(r, keywordList(r));
		}
		r.uri = overlay.uri;
		r.identity = overlay.identity;
		r.cursor = ctx.cursor;
		r.context = project;
		r.text = text;
		r.offset = ctx.prefixStart;
		r.kinds = kinds;
		var prefix = ctx.prefix();
		r.prefix = if(prefix.length > AnalysisScopeOrder.MAX_PREFIX, Arrays.range(prefix, 0, AnalysisScopeOrder.MAX_PREFIX), prefix);
		// A newer request replaces one that waits, which gets its keywords.
		if (waiting != null) finish(waiting, keywordList(waiting));
		submit(r);
	}
	// Queues {r}'s analysis, as the waiting request.
	private def submit(r: LspCompletionRequest) {
		waiting = r;
		r.job = LspAnalysisJob.new(r.begin, r.complete);
		if (!scheduler.submit(r.job)) finish(r, keywordList(r));
	}
	// Starts {r}'s analysis: the project's sources as an automatic analysis
	// captures them, with {r}'s text for its document, admitted within the
	// snapshot budget, which the supervisor does not keep as its latest.
	def begin(r: LspCompletionRequest, supervisor: AnalysisSupervisor) -> AnalysisOutcome {
		if (waiting == r) waiting = null;
		if (r.answered) return AnalysisOutcome.Failed(AnalysisFailure.UNAVAILABLE, "the completion was answered");
		running = r;
		if (!current(r)) return AnalysisOutcome.Failed(AnalysisFailure.UNAVAILABLE, "the document changed");
		var ctx = r.context;
		// The sources are captured now, in this generation.
		r.generation = generation;
		var keys = Array<string>.new(ctx.sources.length), index = -1;
		for (i < keys.length) {
			keys[i] = DocumentUri.normalize(ProjectFiles.uri(ctx.sources[i].path));
			if (keys[i] == null) return AnalysisOutcome.Failed(AnalysisFailure.UNAVAILABLE, "cannot form a document URI");
			if (index < 0 && Strings.equal(keys[i], r.uri)) index = i;
		}
		if (index < 0) return AnalysisOutcome.Failed(AnalysisFailure.UNAVAILABLE, "the document is not in the project");
		var captured = LspAnalysisCapture.capture(store, keys, true);
		if (captured.1 != null) return AnalysisOutcome.Failed(AnalysisFailure.UNAVAILABLE, captured.1);
		var inputs = captured.0;
		inputs.sources[index] = AnalysisSource.new(inputs.sources[index].path, r.text);
		if (!projects.admitSnapshot(ctx, supervisor.snapshot, long.view(AnalysisWire.MAX_RESULT_ALLOCATION) + inputs.snapshotBytes)) {
			return AnalysisOutcome.Failed(AnalysisFailure.TOO_LARGE, "retained analysis snapshots exceed the workspace budget");
		}
		analyses++;
		var scope = AnalysisScopeRequest.new(index, r.offset, r.kinds, r.prefix);
		// No occurrences: the result holds only the candidates' declarations.
		return supervisor.beginTemporary(inputs.sources, ctx.definition.compilerArgs, 0, scope);
	}
	// Whether {r}'s document is open at the version it was requested at, in
	// the same current project.
	private def current(r: LspCompletionRequest) -> bool {
		var overlay = store.overlay(r.uri), ctx = projects.forDocument(r.uri).active;
		return overlay != null && overlay.identity == r.identity && ctx == r.context && ctx.config.current;
	}
	// Replies to {r} once its analysis ends: the declarations in scope and the
	// keywords, or, if it failed or did not parse, the keywords alone. An
	// analysis whose sources an event invalidated while it ran is stale: it
	// runs again, once, if its document is unchanged and no newer completion
	// waits; otherwise the reply is the keywords. A stale result is neither
	// sent nor kept.
	def complete(r: LspCompletionRequest, outcome: AnalysisOutcome) {
		if (running == r) running = null;
		if (r.answered) return;
		if (AnalysisOutcome.Completed.?(outcome) && r.generation != generation) {
			if (!r.rerun && waiting == null && current(r)) {
				r.rerun = true;
				return submit(r);
			}
			return finish(r, keywordList(r));
		}
		if (AnalysisOutcome.Completed.?(outcome)) {
			var result = declarations(r, AnalysisOutcome.Completed.!(outcome).snapshot);
			if (result != JsonValue.Null) {
				cachedUri = r.uri;
				cachedIdentity = r.identity;
				cachedCursor = r.cursor;
				cachedResult = result;
				return finish(r, JsonRpcReply.Result(result));
			}
		}
		finish(r, keywordList(r));
	}
	// The list of {r}'s candidates from {snapshot}'s scope answer, or Null if
	// the program did not parse. Each declaration is an item whose kind is its
	// symbol kind's (LspSymbolKind.completion) and whose detail is its
	// signature; "this" where a method's receiver is in scope; and the builtin
	// types that no candidate's name hides. They are ordered as the worker
	// orders declarations (AnalysisScopeOrder), the builtin types last, and
	// sortText is that rank, so that they sort before the keywords.
	private def declarations(r: LspCompletionRequest, snapshot: AnalysisSnapshot) -> JsonValue {
		var scope = snapshot.scope;
		if (!snapshot.parsed || scope == null) return JsonValue.Null;
		var labels = Vector<string>.new(), kinds = Vector<int>.new(), details = Vector<string>.new();
		var levels = Vector<int>.new(), groups = Vector<int>.new(), names = Strings.newMap<bool>();
		var last = 0;
		for (i < scope.declarations.length) {
			var d = snapshot.declarations[scope.declarations[i]];
			labels.put(d.name);
			kinds.put(LspSymbolKind.completion(d.kind));
			details.put(d.signature);
			levels.put(last = scope.levels[i]);
			groups.put(AnalysisScopeOrder.group(d.kind));
		}
		for (name in scope.hiddenBuiltins) names[name] = true;
		var values = (r.kinds & AnalysisScopeKinds.VALUES) != 0;
		var filtered = fun (name: string) => scope.truncated && !Strings.startsWith(name, r.prefix);
		if (values && scope.thisLevel >= 0 && !filtered("this")) {
			labels.put("this");
			kinds.put(VARIABLE_KIND);
			details.put(null);
			levels.put(scope.thisLevel);
			groups.put(AnalysisScopeOrder.group(AnalysisDeclKind.PARAMETER));
		}
		if ((r.kinds & (AnalysisScopeKinds.VALUES | AnalysisScopeKinds.TYPES)) != 0) {
			for (name in AeneasAdapter.builtinTypes(r.context.definition.compilerArgs)) {
				if (names.has(name) || filtered(name)) continue;
				labels.put(name);
				kinds.put(if(Strings.equal(name, "System"), MODULE_KIND, CLASS_KIND));
				details.put(null);
				levels.put(last + 1);
				groups.put(AnalysisScopeOrder.BUILTIN_GROUP);
			}
		}
		var order = Array<int>.new(labels.length);
		for (i < order.length) order[i] = i;
		order = AnalysisTables.sort(order, fun (a: int, b: int) => AnalysisScopeOrder.before(levels[a], groups[a], labels[a],
			levels[b], groups[b], labels[b]));
		var items = Array<JsonValue>.new(order.length + r.keywords.length);
		for (k < order.length) {
			var i = order[k];
			items[k] = item(labels[i], kinds[i], details[i], rank(k), r.range);
		}
		for (k < r.keywords.length) items[order.length + k] = r.keywords[k];
		return list(items, scope.truncated);
	}
	// Answers the waiting or running completion that {n} cancels with
	// RequestCancelled; its job never starts, or its result is dropped.
	// Other cancellations are ignored.
	def cancel(n: JsonRpcMessage.Notification) {
		if (!JsonRpcParams.ByName.?(n.params)) return;
		var params = JsonRpcParams.ByName.!(n.params).v, id: JsonRpcId;
		if (!params.has("id")) return;
		match (params["id"]) {
			Int(v) => id = JsonRpcId.Int(v);
			String(v) => id = JsonRpcId.String(v);
			_ => return;
		}
		for (r in [waiting, running]) {
			if (r != null && r.id.equal(id)) finish(r, JsonRpcReply.Error(JsonRpcError.new(LspErrorCode.REQUEST_CANCELLED, "the completion was cancelled")));
		}
	}
	// Answers the waiting and running completions with their keywords, at
	// shutdown, exit, or the end of the input.
	def close() {
		for (r in [waiting, running]) if (r != null) finish(r, keywordList(r));
	}
	// Forgets the last reply, and makes the running analysis stale: the
	// sources or the configuration may have changed. Called for document
	// changes, saves, and closes, configuration changes, which replace
	// contexts, and file and folder events.
	def invalidate() {
		generation++;
		cachedResult = JsonValue.Null;
		cachedIdentity = null;
		cachedUri = null;
	}
	private def finish(r: LspCompletionRequest, reply: JsonRpcReply) {
		if (r.answered) return;
		r.answered = true;
		if (waiting == r) waiting = null;
		if (running == r) running = null;
		if (r.job != null && scheduler != null) scheduler.withdraw(r.job);
		respond(r.id, reply);
	}
	private def respond(id: JsonRpcId, reply: JsonRpcReply) {
		match (reply) {
			Result(v) => send(JsonRpcMessage.Response(id, v).encode());
			Error(e) => send(JsonRpcMessage.ErrorResponse(id, e).encode());
		}
	}
	private def parses(path: string, text: Array<byte>, options: Array<string>) -> bool {
		return AeneasAdapter.parseFile(path, text, options).diagnostics.length == 0;
	}
	// {k} in four decimal digits, which sort as the numbers do: there are
	// fewer than 10,000 candidates.
	private def rank(k: int) -> string {
		var digits = Array<byte>.new(4);
		for (i = 3; i >= 0; i--) {
			digits[i] = byte.view('0' + k % 10);
			k = k / 10;
		}
		return digits;
	}
	private def keywordList(r: LspCompletionRequest) -> JsonRpcReply {
		return JsonRpcReply.Result(list(r.keywords, false));
	}
	// An item whose edit replaces {range}, the prefix, with {label}.
	private def item(label: string, kind: int, detail: string, sortText: string, range: JsonValue) -> JsonValue {
		var edit = Strings.newMap<JsonValue>(), item = Strings.newMap<JsonValue>();
		edit["range"] = range;
		edit["newText"] = JsonValue.String(label);
		item["label"] = JsonValue.String(label);
		item["kind"] = JsonValue.Int(kind);
		if (detail != null) item["detail"] = JsonValue.String(detail);
		if (sortText != null) item["sortText"] = JsonValue.String(sortText);
		item["textEdit"] = JsonValue.JObject(edit);
		return JsonValue.JObject(item);
	}
	// A CompletionList. A complete one lets the client filter it by the prefix
	// and ask again only once the prefix no longer matches; an incomplete one,
	// which the cap filtered by the prefix, makes it ask again as the prefix
	// grows.
	private def list(items: Array<JsonValue>, incomplete: bool) -> JsonValue {
		var result = Strings.newMap<JsonValue>();
		result["isIncomplete"] = JsonValue.Bool(incomplete);
		result["items"] = JsonValue.JArray(items);
		return JsonValue.JObject(result);
	}
	private def encodePosition(p: LspPosition) -> JsonValue {
		var obj = Strings.newMap<JsonValue>();
		obj["line"] = JsonValue.Int(p.line);
		obj["character"] = JsonValue.Int(p.character);
		return JsonValue.JObject(obj);
	}
	private def objectMember(obj: HashMap<string, JsonValue>, key: string) -> HashMap<string, JsonValue> {
		if (obj == null || !obj.has(key) || !JsonValue.JObject.?(obj[key])) return null;
		return JsonValue.JObject.!(obj[key]).v;
	}
	private def intMember(obj: HashMap<string, JsonValue>, key: string) -> int {
		if (obj == null || !obj.has(key) || !JsonValue.Int.?(obj[key])) return -1;
		return JsonValue.Int.!(obj[key]).v;
	}
}
