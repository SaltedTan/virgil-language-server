// Full-text synchronization notifications. Validation is atomic: no member of
// a didChange batch is applied unless every member is a full-text change.
// Rejections are reported through an injected warning sink, never as replies.
// A rejected didOpen or didChange whose textDocument.uri is a string marks
// that document out of sync if it is open, since the client's text may now
// differ from the server's (DocumentStore.markOutOfSync).
class LspDocumentSync(store: DocumentStore, warn: string -> void) {
	var capacityWarning: string -> void;
	// One bounded latch for the current pressure episode: only its first
	// capacity rejection reaches the user, and later ones just reach the log.
	// An accepted event that releases retained bytes rearms it.
	private var capacityWarned: bool;
	// Accepted events only; retained records identify the version analyzed or
	// closed. A didChange with no content changes reports the same text at a
	// newer version to {onVersionChange} instead of {onChange}.
	var onOpen: DocumentOverlay -> void;
	var onChange: DocumentOverlay -> void;
	var onVersionChange: DocumentOverlay -> void;
	var onSave: DocumentOverlay -> void;
	var onClose: DocumentOverlay -> void;

	def register(dispatcher: JsonRpcDispatcher) {
		dispatcher
			.onNotification("textDocument/didOpen", didOpen)
			.onNotification("textDocument/didChange", didChange)
			.onNotification("textDocument/didSave", didSave)
			.onNotification("textDocument/didClose", didClose);
	}
	def rejectedMessage(obj: HashMap<string, JsonValue>) {
		if (!stringMember(obj, "method") || obj.has("id")) return;
		if (changesText(JsonValue.String.!(obj["method"]).v)) {
			markRejected(documentUri(objectMember(obj, "params")));
		}
	}
	// The decoder replaced unsupported numbers with null. Do not read params,
	// except a didOpen's or didChange's URI, which is a string, to mark it.
	def unsupportedNumbers(n: JsonRpcMessage.Notification) {
		var changes = changesText(n.method);
		if (changes || Strings.equal(n.method, "textDocument/didSave") || Strings.equal(n.method, "textDocument/didClose")) {
			ignored(n, "params contain a number that is not a 32-bit integer");
		}
		if (changes) markRejected(documentUri(members(n)));
	}
	private def changesText(method: string) -> bool {
		return Strings.equal(method, "textDocument/didOpen") || Strings.equal(method, "textDocument/didChange");
	}
	private def didOpen(n: JsonRpcMessage.Notification) {
		var params = members(n), doc = objectMember(params, "textDocument");
		if (!stringMember(doc, "uri") || !stringMember(doc, "languageId") ||
			!intMember(doc, "version") || !stringMember(doc, "text")) {
			rejected(n, doc, "invalid textDocument (expected uri, languageId, version, text)");
			return;
		}
		var uri = JsonValue.String.!(doc["uri"]).v;
		var reason = store.open(uri, JsonValue.String.!(doc["languageId"]).v,
			JsonValue.Int.!(doc["version"]).v, JsonValue.String.!(doc["text"]).v);
		// A duplicate open of an open document leaves the server's text.
		rejected(n, doc, reason);
		if (reason == null && onOpen != null) onOpen(store.overlay(uri));
	}
	private def didChange(n: JsonRpcMessage.Notification) {
		var params = members(n), doc = objectMember(params, "textDocument");
		if (!stringMember(doc, "uri") || !intMember(doc, "version") || params == null ||
			!params.has("contentChanges") || !JsonValue.JArray.?(params["contentChanges"])) {
			rejected(n, doc, "invalid didChange params");
			return;
		}
		var changes = JsonValue.JArray.!(params["contentChanges"]).v;
		if (changes == null) {
			rejected(n, doc, "invalid didChange params");
			return;
		}
		var uri = JsonValue.String.!(doc["uri"]).v, version = JsonValue.Int.!(doc["version"]).v;
		if (changes.length == 0) {
			// LSP 3.17 allows an empty array: all the changes are applied, so
			// the text is unchanged and the version is the notification's.
			// An out-of-sync mark stays, since the text is still the old one.
			var reason = store.changeVersion(uri, version);
			rejected(n, doc, reason);
			if (reason == null && onVersionChange != null) onVersionChange(store.overlay(uri));
			return;
		}
		var text: string;
		for (change in changes) {
			if (!JsonValue.JObject.?(change)) {
				rejected(n, doc, "invalid content change");
				return;
			}
			var obj = JsonValue.JObject.!(change).v;
			if (obj == null || obj.has("range") || obj.has("rangeLength")) {
				rejected(n, doc, "incremental changes are not supported");
				return;
			}
			if (!stringMember(obj, "text")) {
				rejected(n, doc, "content change text must be a string");
				return;
			}
			text = JsonValue.String.!(obj["text"]).v;
		}
		// Each event replaces the whole text; only the last one survives.
		// An accepted change clears an out-of-sync mark (DocumentStore.change).
		var before = store.usedBytes(), reason = store.change(uri, version, text);
		rejected(n, doc, reason);
		if (reason == null) {
			rearmIfReleased(before);
			if (onChange != null) onChange(store.overlay(uri));
		}
	}
	private def didSave(n: JsonRpcMessage.Notification) {
		var params = members(n), uri = documentUri(params);
		if (uri == null || (params.has("text") && !stringMember(params, "text"))) {
			ignored(n, "invalid didSave params");
			return;
		}
		// Unsolicited save text is not versioned and cannot overwrite edits.
		var reason = store.save(uri);
		ignored(n, reason);
		if (reason == null && onSave != null) onSave(store.overlay(uri));
	}
	private def didClose(n: JsonRpcMessage.Notification) {
		var uri = documentUri(members(n));
		if (uri == null) {
			ignored(n, "invalid didClose params");
			return;
		}
		var doc = store.overlay(uri), before = store.usedBytes(), reason = store.close(uri);
		ignored(n, reason);
		if (reason == null) {
			rearmIfReleased(before);
			if (onClose != null) onClose(doc);
		}
	}
	// An accepted event that made the store charge less released retained
	// bytes, so the next capacity rejection may warn again.
	private def rearmIfReleased(before: long) {
		if (store.usedBytes() < before) capacityWarned = false;
	}
	// Reports a rejected didOpen or didChange, if {reason} isn't null, and
	// marks its document out of sync if {doc} has a string URI.
	private def rejected(n: JsonRpcMessage.Notification, doc: HashMap<string, JsonValue>, reason: string) {
		if (reason == null) return;
		ignored(n, reason);
		if (stringMember(doc, "uri")) markRejected(JsonValue.String.!(doc["uri"]).v);
	}
	private def markRejected(uri: string) {
		if (uri != null) store.markOutOfSync(uri);
	}
	private def ignored(n: JsonRpcMessage.Notification, reason: string) {
		if (reason == null) return;
		var message = Strings.format2("ignored %s: %s", n.method, reason);
		if (warn != null) warn(message);
		if (Strings.equal(reason, DocumentLimits.EXCEEDED) && capacityWarning != null && !capacityWarned) {
			capacityWarned = true;
			capacityWarning(message);
		}
	}
	private def members(n: JsonRpcMessage.Notification) -> HashMap<string, JsonValue> {
		return if(JsonRpcParams.ByName.?(n.params), JsonRpcParams.ByName.!(n.params).v);
	}
	private def objectMember(obj: HashMap<string, JsonValue>, key: string) -> HashMap<string, JsonValue> {
		if (obj == null || !obj.has(key) || !JsonValue.JObject.?(obj[key])) return null;
		return JsonValue.JObject.!(obj[key]).v;
	}
	private def stringMember(obj: HashMap<string, JsonValue>, key: string) -> bool {
		return obj != null && obj.has(key) && JsonValue.String.?(obj[key]) && JsonValue.String.!(obj[key]).v != null;
	}
	private def intMember(obj: HashMap<string, JsonValue>, key: string) -> bool {
		return obj != null && obj.has(key) && JsonValue.Int.?(obj[key]);
	}
	private def documentUri(params: HashMap<string, JsonValue>) -> string {
		var doc = objectMember(params, "textDocument");
		return if(stringMember(doc, "uri"), JsonValue.String.!(doc["uri"]).v);
	}
}
