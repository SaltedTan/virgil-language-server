// textDocument/formatting: ADR-0019's edits of the open document's current
// text, from the same single-file parse with project options that folding
// ranges use, without waiting for an analysis. The text's end is mirrored
// (AnalysisFormatEnd.MIRROR). See docs/architecture.md#formatting.
//
// - Malformed params, or options without an unsigned integer tabSize and a
//   boolean insertSpaces, get InvalidParams. The option values are ignored.
// - A document that isn't open, or whose language isn't virgil, gets [].
// - A document marked out of sync (DocumentStore.outOfSync) gets
//   RequestFailed before it is parsed.
// - The adapter checks for a lone CR before counting tokens.
//   A lone CR or a syntax error gets []. Exceeding the budget gets
//   RequestFailed when the text has no lone CR.
// - RequestFailed, before any edit is built, if the document store couldn't
//   hold the formatted text in place of the current one or if the reply
//   would exceed MAX_REPLY_BYTES.
// - Otherwise one TextEdit for each changed whitespace run, in document
//   order, so that no edit covers a comment. More than MAX_EDITS become one
//   edit from the first change's start to the last change's end, whose text
//   is that span formatted, comments included. If that span contains U+FFFD,
//   which may stand for an unpaired surrogate in the client's text, the
//   request gets RequestFailed instead.
class LspFormatting(store: DocumentStore, projects: WorkspaceProjects) {
	def REGISTRATION_ID = "virgil-lsp/formatting";
	// Production waits this long for the client to answer the registration,
	// as for watched files.
	def REGISTRATION_TIMEOUT_MS = 10000;
	// More edits than this are sent as one (ADR-0019 decision 5).
	def MAX_EDITS = 10000;
	// The bound on a reply's JSON that document symbols use (LspDocumentSymbols).
	def MAX_REPLY_BYTES = 4194304;
	private def EDIT_START = "{\"range\":{\"start\":{\"line\":";
	private def CHARACTER = ",\"character\":";
	private def EDIT_END = "},\"end\":{\"line\":";
	private def EDIT_TEXT = "}},\"newText\":";
	// The client declared textDocument.formatting.dynamicRegistration; set by
	// initialize.
	var dynamic: bool;
	var warn: string -> void;
	private var registered: bool;

	def register(dispatcher: JsonRpcDispatcher) {
		dispatcher.onRequest("textDocument/formatting", formatting);
	}
	// Called for the initialized notification. Asks a client that registers
	// formatting dynamically to send it for Virgil documents only, once per
	// session. Returns the encoded request, or null if there is none to send.
	def initialized(pending: JsonRpcPendingRequests) -> Array<byte> {
		if (!dynamic || registered) return null;
		registered = true;
		var filter = Strings.newMap<JsonValue>();
		filter["language"] = JsonValue.String("virgil");
		var options = Strings.newMap<JsonValue>();
		options["documentSelector"] = JsonValue.JArray([JsonValue.JObject(filter)]);
		var registration = Strings.newMap<JsonValue>();
		registration["id"] = JsonValue.String(REGISTRATION_ID);
		registration["method"] = JsonValue.String("textDocument/formatting");
		registration["registerOptions"] = JsonValue.JObject(options);
		var params = Strings.newMap<JsonValue>();
		params["registrations"] = JsonValue.JArray([JsonValue.JObject(registration)]);
		return pending.sendBy("client/registerCapability", JsonRpcParams.ByName(params),
			System.ticksMs() + REGISTRATION_TIMEOUT_MS, registrationDone);
	}
	private def registrationDone(reply: JsonRpcReply) {
		match (reply) {
			Error(e) => {
				if (warn != null) warn(Strings.format2(
					"client/registerCapability for formatting failed: %d %s; the client may not format Virgil documents",
					e.code, e.message));
			}
			_ => ;
		}
	}
	private def formatting(request: JsonRpcMessage.Request) -> JsonRpcReply {
		var params = if(JsonRpcParams.ByName.?(request.params), JsonRpcParams.ByName.!(request.params).v);
		var doc = objectMember(params, "textDocument");
		if (doc == null || !JsonValue.String.?(doc["uri"]) || JsonValue.String.!(doc["uri"]).v == null ||
			DocumentUri.normalize(JsonValue.String.!(doc["uri"]).v) == null) {
			return invalid("formatting params require a valid textDocument.uri");
		}
		// LSP 3.17's FormattingOptions: tabSize is a uinteger.
		var options = objectMember(params, "options");
		if (options == null || !JsonValue.Int.?(options["tabSize"]) || JsonValue.Int.!(options["tabSize"]).v < 0 ||
			!JsonValue.Bool.?(options["insertSpaces"])) {
			return invalid("formatting params require options with an unsigned integer tabSize and a boolean insertSpaces");
		}
		var resultLimit = MAX_REPLY_BYTES - request.id.resultEnvelopeBytes();
		if (resultLimit < 2) return replyTooLarge();
		var overlay = store.overlay(JsonValue.String.!(doc["uri"]).v);
		if (overlay == null || !Strings.equal(overlay.languageId, "virgil")) return noEdits();
		if (store.outOfSync(overlay)) {
			return failed("the server's copy of this document is out of date, since a change to it was rejected or lost; change the whole document or reopen it");
		}
		var owner = projects.forDocument(overlay.uri);
		var r = AeneasAdapter.formatting(overlay.uri, overlay.text, owner.compilerArgs(), AnalysisFormatEnd.MIRROR);
		match (r.kind) {
			NONE => ;
			// Diagnostics show syntax errors. A lone CR inside a comment may pass parsing.
			LONE_CR, SYNTAX => return noEdits();
			PARSE_BUDGET, UNTOKENIZED => return failed(r.refusal);
		}
		if (!store.fits(overlay, r.size())) {
			return failed(Strings.format1("the formatted document, %d bytes, would not fit in the open-document capacity", r.size()));
		}
		var count = r.editCount();
		if (count == 0) return noEdits();
		var text = overlay.text, map = PositionMap.new(text, PositionEncoding.UTF16);
		var merge = count > MAX_EDITS, first = r.firstChange();
		var size = FormattingReplySize.new(first);
		var measured = r.visitChanges(fun (begin: int, end: int, leading: Range<byte>, tabs: int, trailing: Range<byte>) {
			size.bytes += JsonRpcJson.escapedBytes(leading) + 2L * tabs + JsonRpcJson.escapedBytes(trailing);
			if (merge) size.bytes += JsonRpcJson.escapedBytes(text[size.end ... begin]);
			else size.bytes += editBytes(map, begin, end);
			size.end = end;
		});
		if (!measured) return failed("the formatter could not build its edits");
		if (merge) {
			if (hasReplacement(text, first, size.end)) {
				return failed(Strings.format1("the document needs more than %d formatting changes, too many to send separately, and the single edit that would replace them includes a character the server can't reproduce exactly: U+FFFD, or an unpaired UTF-16 surrogate, which the server stores as U+FFFD", MAX_EDITS));
			}
			size.bytes += editBytes(map, first, size.end);
		} else {
			size.bytes += count - 1;
		}
		if (size.bytes > resultLimit) return replyTooLarge();
		var edits = if(merge, mergedEdits(text, r, first, size.end), r.edits());
		if (edits == null) return failed("the formatter could not build its edits");
		return JsonRpcReply.ResultJson(render(edits, map, size.bytes));
	}
	private def editBytes(map: PositionMap, begin: int, end: int) -> int {
		var start = map.offsetToPosition(begin), finish = map.offsetToPosition(end);
		return EDIT_START.length + 2 * CHARACTER.length + EDIT_END.length + EDIT_TEXT.length + 3
			+ JsonRpcJson.integerBytes(start.line) + JsonRpcJson.integerBytes(start.character)
			+ JsonRpcJson.integerBytes(finish.line) + JsonRpcJson.integerBytes(finish.character);
	}
	private def mergedEdits(text: Array<byte>, formatting: AnalysisFormatting, begin: int, end: int) -> Array<AnalysisTextEdit> {
		var size = formatting.size() - begin - (text.length - end);
		var out = Array<byte>.new(int.view(size)), cursor = FormattingMergeCursor.new(begin);
		var ok = formatting.visitChanges(fun (start: int, finish: int, leading: Range<byte>, tabs: int, trailing: Range<byte>) {
			for (i = cursor.source; i < start; i++) out[cursor.target++] = text[i];
			for (b in leading) out[cursor.target++] = b;
			for (i < tabs) out[cursor.target++] = '\t';
			for (b in trailing) out[cursor.target++] = b;
			cursor.source = finish;
		});
		return if(ok, [AnalysisTextEdit.new(begin, end, out)]);
	}
	// Whether {text[begin ... end]} contains U+FFFD, whose UTF-8 is EF BF BD.
	// JsonRpcJson decodes an unpaired surrogate escape as that character, so
	// the client's text may differ from the server's there, and a merged edit
	// would replace the client's character with U+FFFD.
	private def hasReplacement(text: Array<byte>, begin: int, end: int) -> bool {
		for (i = begin; i + 2 < end; i++) {
			if (text[i] == '\xEF' && text[i + 1] == '\xBF' && text[i + 2] == '\xBD') return true;
		}
		return false;
	}
	// The TextEdit[] of {edits}, whose JSON takes {bytes} bytes.
	private def render(edits: Array<AnalysisTextEdit>, map: PositionMap, bytes: long) -> Range<byte> {
		var buf = StringBuilder.new().grow(int.view(bytes)).putc('[');
		for (i < edits.length) {
			var e = edits[i];
			var start = map.offsetToPosition(e.begin), end = map.offsetToPosition(e.end);
			if (i > 0) buf.putc(',');
			buf.puts(EDIT_START).putd(start.line).puts(CHARACTER).putd(start.character)
				.puts(EDIT_END).putd(end.line).puts(CHARACTER).putd(end.character).puts(EDIT_TEXT);
			JsonRpcJson.renderString(buf, e.text).putc('}');
		}
		buf.putc(']');
		return buf.buf[0 ... buf.length];
	}
	private def noEdits() -> JsonRpcReply {
		return JsonRpcReply.Result(JsonValue.JArray([]));
	}
	private def replyTooLarge() -> JsonRpcReply {
		return failed(Strings.format1("the formatting edits would need more than %d bytes", MAX_REPLY_BYTES));
	}
	private def invalid(msg: string) -> JsonRpcReply {
		return JsonRpcReply.Error(JsonRpcError.new(JsonRpcErrorCode.INVALID_PARAMS, msg));
	}
	private def failed(msg: string) -> JsonRpcReply {
		return JsonRpcReply.Error(JsonRpcError.new(LspErrorCode.REQUEST_FAILED, msg));
	}
	private def objectMember(obj: HashMap<string, JsonValue>, key: string) -> HashMap<string, JsonValue> {
		if (obj == null || !obj.has(key) || !JsonValue.JObject.?(obj[key])) return null;
		return JsonValue.JObject.!(obj[key]).v;
	}
}

class FormattingReplySize(first: int) {
	var bytes = 2L;
	var end = first;
}

class FormattingMergeCursor(begin: int) {
	var source = begin;
	var target: int;
}
