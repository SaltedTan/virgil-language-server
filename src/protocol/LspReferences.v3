// textDocument/references from the occurrences of a current snapshot, which
// LspSnapshotRequests selects as for a definition. See
// docs/architecture.md#references.
component LspReferences {
	// The parameters that a request needs, for its parameter errors.
	def REQUIRES = "a valid textDocument.uri, position, and context.includeDeclaration";
	// Bounds a reply, whose Locations take about 1 KB of heap each until it is
	// encoded: a declaration with more references gets RequestFailed. See
	// docs/architecture.md#references.
	def MAX_LOCATIONS = 10000;

	// The answer function for a request's {params}, which keeps whether to
	// include the declaration while the request waits, or null unless
	// context.includeDeclaration is a boolean.
	def prepare(params: HashMap<string, JsonValue>) -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply) {
		var context = if(params.has("context") && JsonValue.JObject.?(params["context"]), JsonValue.JObject.!(params["context"]).v);
		if (context == null || !context.has("includeDeclaration")) return null;
		match (context["includeDeclaration"]) {
			Bool(include) => return answer(_, _, include, MAX_LOCATIONS);
			_ => return null;
		}
	}
	// The Locations of the references of the declaration that the use or the
	// declaration name containing {offset} selects, if either does: the
	// snapshot's references, with the declaration's name if
	// {includeDeclaration}, in byte order of path and then in source order,
	// except the uses that do not spell the name; or RequestFailed if there
	// are more than {limit}. The locations in a file whose bytes are no longer
	// the ones analyzed are left out, and only those.
	def answer(at: LspSnapshotPosition, offset: int, includeDeclaration: bool, limit: int) -> (bool, JsonRpcReply) {
		var s = at.snapshot, path = at.path(), decl = s.definitionAtOffset(path, offset);
		if (decl == null) decl = s.declarationAtOffset(path, offset);
		if (decl == null) return (false, JsonRpcReply.Result(JsonValue.Null));
		// An index method's name, "[]" or "[]=", and its index operations
		// select their opening bracket; a named call, such as c.[](i),
		// spells the whole name.
		var name = decl.name, bracket = name.length > 0 && name[0] == '[';
		var locations = Vector<JsonValue>.new();
		for (file in s.references(decl, includeDeclaration)) {
			var target = at.target(file.0), j = target.0, text = target.1;
			if (j < 0) continue;
			var map = if(j == at.index, at.map, PositionMap.new(text, PositionEncoding.UTF16)), spans = file.1;
			for (k = 0; k < spans.length; k += 2) {
				var begin = spans[k], end = spans[k + 1];
				// "this" and a default ".new" resolve to their class, but do
				// not name it.
				if (!spells(text, begin, end, name) && !(bracket && spells(text, begin, end, "["))) continue;
				if (locations.length == limit) {
					var error = JsonRpcError.new(LspErrorCode.REQUEST_FAILED,
						Strings.format2("the declaration %s has more than %d references", name, limit));
					return (true, JsonRpcReply.Error(error));
				}
				locations.put(at.location(j, map, begin, end));
			}
		}
		return (true, JsonRpcReply.Result(JsonValue.JArray(locations.extract())));
	}
	// Whether the bytes from {begin} to {end} of {text} are {name}.
	private def spells(text: Array<byte>, begin: int, end: int, name: string) -> bool {
		if (begin < 0 || end > text.length || end - begin != name.length) return false;
		for (i < name.length) if (text[begin + i] != name[i]) return false;
		return true;
	}
}
