// textDocument/definition from the occurrences of a current snapshot, which
// LspSnapshotRequests selects. See docs/architecture.md#definition.
component LspDefinition {
	// The Location of the declaration that the occurrence containing {offset}
	// resolves to, if there is an occurrence there; null if its target has no
	// source range or the target's text is no longer the analyzed text.
	def answer(at: LspSnapshotPosition, offset: int) -> (bool, JsonValue) {
		var s = at.snapshot, decl = s.definitionAtOffset(at.path(), offset);
		return location(at, decl, decl != null);
	}
	def typeAnswer(at: LspSnapshotPosition, offset: int) -> (bool, JsonValue) {
		var found = at.snapshot.typeDefinitionAtOffset(at.path(), offset);
		return location(at, found.1, found.0);
	}
	// Definition and type definition share target freshness and conversion.
	def location(at: LspSnapshotPosition, decl: AnalysisDeclaration, found: bool) -> (bool, JsonValue) {
		if (decl == null) return (found, JsonValue.Null);
		if (decl.range.beginOffset < 0) return (true, JsonValue.Null);
		// The target's bytes must still be the ones the worker analyzed.
		var target = at.target(decl.range.path), j = target.0;
		if (j < 0) return (true, JsonValue.Null);
		var map = at.positionMap(j, target.1);
		return (true, at.location(j, map, decl.range.beginOffset, decl.range.endOffset));
	}
}

// One inlay-hint request can link hundreds of locals to the same declaration.
// Check each target file exactly once with definition's analyzedText rules,
// and share both its conversion map and each declaration's JSON location.
// Nothing survives the synchronous request, including failed freshness checks.
class LspDefinitionLocations(at: LspSnapshotPosition) {
	private def maps = Array<PositionMap>.new(at.snapshot.paths.length);
	private def checked = Array<bool>.new(at.snapshot.paths.length);
	private def declarations = AnalysisIndexMap<int>.new(AnalysisTables.hashInt,
		fun (a: int, b: int) => a == b);
	private def locations = Vector<JsonValue>.new();
	def location(code: int) -> JsonValue {
		var i = declarations.add(code);
		if (i < locations.length) return locations[i];
		var d = at.snapshot.declarations[code - 1];
		var result: JsonValue = JsonValue.Null;
		var j = -1;
		for (k < at.snapshot.paths.length) if (Strings.equal(at.snapshot.paths[k], d.range.path)) { j = k; break; }
		if (j >= 0 && d.range.beginOffset >= 0) {
			if (!checked[j]) {
				checked[j] = true;
				var text = at.analyzedText(j);
				if (text != null) maps[j] = at.positionMap(j, text);
			}
			if (maps[j] != null) result = at.location(j, maps[j], d.range.beginOffset, d.range.endOffset);
		}
		locations.put(result);
		return result;
	}
}
