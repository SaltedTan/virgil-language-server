// References restricted to the requested document, including the declaration.
// Snapshot selection, freshness, waiting, and the byte-before fallback belong
// to LspSnapshotRequests. See docs/architecture.md#document-highlights.
component LspDocumentHighlights {
	def REQUIRES = "a valid textDocument.uri and position";
	// The same heap bound as references. Highlights omit URIs, so 10,000
	// entries also bound the encoded array below 1.3 MiB (at most 128 bytes
	// per entry, including four 11-digit positions and array punctuation).
	def MAX_HIGHLIGHTS = LspReferences.MAX_LOCATIONS;
	def prepare(params: HashMap<string, JsonValue>) -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply) {
		return answer(_, _, MAX_HIGHLIGHTS);
	}
	def answer(at: LspSnapshotPosition, offset: int, limit: int) -> (bool, JsonRpcReply) {
		var decl = LspReferences.declaration(at, offset);
		if (decl == null) return (false, JsonRpcReply.Result(JsonValue.Null));
		var highlights = Vector<JsonValue>.new();
		for (file in at.snapshot.references(decl, true)) {
			if (!Strings.equal(file.0, at.path())) continue;
			var spans = file.1;
			for (k = 0; k < spans.length; k += 2) {
				var begin = spans[k], end = spans[k + 1];
				if (!at.maps(at.index, begin, end)) continue;
				if (!LspReferences.names(at.text, begin, end, decl.name)) continue;
				if (highlights.length == limit) {
					return (true, JsonRpcReply.Error(JsonRpcError.new(LspErrorCode.REQUEST_FAILED,
						Strings.format2("the declaration %s has more than %d document highlights", decl.name, limit))));
				}
				var highlight = Strings.newMap<JsonValue>();
				highlight["range"] = at.range(at.map, begin, end);
				highlight["kind"] = JsonValue.Int(at.snapshot.highlightKind(at.path(), begin));
				highlights.put(JsonValue.JObject(highlight));
			}
		}
		return (true, JsonRpcReply.Result(JsonValue.JArray(highlights.extract())));
	}
}
