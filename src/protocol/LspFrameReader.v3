// Limits of the LSP base protocol framing. See {LspFrameReader}.
component LspFraming {
	// The longest header section accepted, including the empty line that ends it.
	def MAX_HEADER_BYTES = 8192;
	// The default limit on the payload of one incoming message.
	def DEFAULT_MAX_PAYLOAD = 16 * 1024 * 1024;
	// The highest payload limit the server supports with its default 200 MB
	// heap. Body bytes must be bounded along with {JsonRpcJson.MAX_VALUES}
	// before parsing the whole message. See docs/architecture.md#framing for
	// the supported memory budget.
	def MAX_SUPPORTED_PAYLOAD = 16 * 1024 * 1024;
}

// One result of reading the client's byte stream. See {LspFrameReader.next}.
type LspFrame {
	// More input is needed to finish the next message.
	case Incomplete;
	// The payload of one message: exactly Content-Length bytes.
	case Message(payload: Array<byte>);
	// A message that was read and discarded, because its payload is too long or
	// not in UTF-8. Its length was known, so the stream stays in sync.
	// {reason} is for logging.
	case Skipped(reason: string);
	// A header that can't be read. Without its Content-Length, the start of the
	// next message can't be found, so no further messages are read and every
	// later call returns this frame again. {reason} is for logging.
	case Malformed(reason: string);
}

// Splits the client's byte stream into message payloads, following the LSP
// base protocol: a header of "Name: value" fields, each ending with CR LF,
// then an empty line, then exactly Content-Length bytes of payload. It does no
// I/O: the caller feeds in the bytes it reads, in chunks of any size, and takes
// out frames. Where the chunks split the input never changes the result.
//
// - Content-Length counts bytes and is required. Field names are
//   case-insensitive, and spaces and tabs around a value are ignored.
// - Content-Type handling is documented in docs/architecture.md#framing.
// - A payload longer than {maxPayload} bytes is skipped.
//   A payload within the limit is buffered as its bytes arrive, so a header
//   alone never allocates the length it declares.
// - See docs/architecture.md#framing for the buffering and memory guarantees
//   and the caller's responsibility to limit chunks and drain frames.
// - Unknown header fields are ignored.
// - A header is malformed if it contains a byte that isn't printable ASCII, a
//   space, or a tab (apart from the CR LF line ends), has a CR or LF outside a
//   CR LF pair, has a line without a colon or with an invalid field name, has no
//   valid Content-Length, repeats Content-Length or Content-Type, or is longer
//   than {LspFraming.MAX_HEADER_BYTES}.
class LspFrameReader(maxPayload: int) {
	private var input = Array<byte>.new(BUFFER_SIZE);
	private var pos: int;		// start of the unread input
	private var limit: int;		// end of the unread input
	private var scanned: int;	// header bytes after {pos} already checked
	private var payload: Array<byte>;	// the payload being read, if any
	private var length: int;	// the Content-Length of {payload}
	private var filled: int;	// bytes of {payload} read so far
	private var skipReason: string;	// set while a message is being skipped
	private var skipRemaining: long;	// payload bytes left to skip
	private var failure: string;	// set once the header is malformed

	// Takes in {data}. Ignored once the stream is malformed. See
	// docs/architecture.md#framing for the caller's memory contract.
	def feed(data: Range<byte>) -> this {
		while (failure == null && data.length > 0) {
			if (advance()) break;
			if (failure != null) return;
			// The buffered input has been read, apart from part of a header.
			if (payload != null || skipReason != null) {
				data = data[consume(data) ...];
			} else {
				// Buffer no more than the header limit allows, so that the end
				// of the header, or its failure, is found before the rest
				// of the chunk is copied.
				var n = LspFraming.MAX_HEADER_BYTES - (limit - pos);
				if (n > data.length) n = data.length;
				append(data[0 ..+ n]);
				data = data[n ...];
			}
		}
		if (failure == null) append(data);
	}
	// Reads the next frame. Returns {LspFrame.Incomplete} if more input is
	// needed.
	def next() -> LspFrame {
		if (failure == null && advance()) {
			if (skipReason != null) {
				var reason = skipReason;
				skipReason = null;
				return LspFrame.Skipped(reason);
			}
			var result = payload;
			payload = null;
			return LspFrame.Message(result);
		}
		if (failure != null) return LspFrame.Malformed(failure);
		return LspFrame.Incomplete;
	}
	// Returns true if part of a message has been fed in but not yet returned,
	// so that the end of the input would cut that message short.
	def midMessage() -> bool {
		return failure == null && (payload != null || skipReason != null || limit > pos);
	}

	// Reads the buffered input until the next frame is complete. Returns true
	// if it is.
	private def advance() -> bool {
		if (payload == null && skipReason == null && !readHeader()) return false;
		pos += consume(input[pos ... limit]);
		release();
		return if(skipReason != null, skipRemaining == 0, filled == length);
	}
	// Reads the start of {data} into the payload being read or skipped.
	// Returns how many bytes belonged to it.
	private def consume(data: Range<byte>) -> int {
		if (skipReason != null) {
			var n = if(skipRemaining < data.length, int.view(skipRemaining), data.length);
			skipRemaining -= n;
			return n;
		}
		var n = length - filled;
		if (n > data.length) n = data.length;
		if (filled + n > payload.length) {
			// Grow with the bytes received, not to the declared length, which
			// may never arrive. Doubling keeps the copying linear.
			var size = if(payload.length < length - payload.length, 2 * payload.length, length);
			if (size < filled + n) size = filled + n;
			var dest = Array<byte>.new(size);
			for (i < filled) dest[i] = payload[i];
			payload = dest;
		}
		var to = payload[filled ..+ n];
		for (i < n) to[i] = data[i];
		filled += n;
		return n;
	}
	// Appends {data} to the unread input.
	private def append(data: Range<byte>) {
		var n = data.length, live = limit - pos;
		if (limit + n > input.length) {
			// Move the unread input to the front, growing the buffer if needed.
			var dest = input;
			if (live + n > input.length) dest = Array<byte>.new(if(live + n > 2 * input.length, live + n, 2 * input.length));
			for (i < live) dest[i] = input[pos + i];
			input = dest;
			pos = 0;
			limit = live;
		}
		var to = input[limit ..+ n];
		for (i < n) to[i] = data[i];
		limit += n;
	}
	// Once no more than a header's worth of unread input is left in a buffer
	// grown past the header limit, moves it to a smaller buffer, so that a long
	// chunk isn't kept after it has been read.
	private def release() {
		var max = LspFraming.MAX_HEADER_BYTES, live = limit - pos;
		if (input.length <= max || live > max) return;
		var dest = Array<byte>.new(if(live > BUFFER_SIZE, live, BUFFER_SIZE));
		for (i < live) dest[i] = input[pos + i];
		input = dest;
		pos = 0;
		limit = live;
	}
	// Looks for the end of the header, checking each byte on the way, so that
	// a bad header fails as soon as the byte that proves it arrives. Parses the
	// header and returns true once the end has been found.
	private def readHeader() -> bool {
		var max = LspFraming.MAX_HEADER_BYTES;
		for (i = pos + scanned; i < limit; i++) {
			var b = input[i];
			if (b >= 0x7F || (b < ' ' && b != '\t' && b != '\r' && b != '\n')) {
				return fail(Strings.format1("header contains byte 0x%x", b));
			}
			// Header bytes stay buffered until the header ends, so the byte
			// before {i} is still there, even if it came in an earlier chunk.
			var afterCr = i > pos && input[i - 1] == '\r';
			if (b == '\n' && !afterCr) return fail("header has an LF without a CR before it");
			if (b != '\n' && afterCr) return fail("header has a CR without an LF after it");
			var length = i + 1 - pos;
			// An empty first line ends a header that has no fields.
			if (length == 2 && b == '\n' && input[pos] == '\r') return parseHeader(pos, i + 1);
			if (length >= 4 && b == '\n' && input[i - 1] == '\r' && input[i - 2] == '\n' && input[i - 3] == '\r') {
				return parseHeader(pos, i + 1);
			}
			if (length >= max) return fail(Strings.format1("header is longer than %d bytes", max));
		}
		scanned = limit - pos;
		return false;
	}
	// Parses the header in input[start ... end), which ends with an empty line,
	// and consumes it. {readHeader} has checked that every CR and LF in it is
	// part of a CR LF pair.
	private def parseHeader(start: int, end: int) -> bool {
		var contentLength = -1L, contentType: string;
		var i = start, last = end - 2;	// the empty line starts at {last}
		while (i < last) {
			var eol = i;
			while (input[eol] != '\r') eol++;
			var colon = i;
			while (colon < eol && input[colon] != ':') colon++;
			if (colon == eol) return fail("header line has no colon");
			if (colon == i || !isFieldName(i, colon)) return fail("header field name is invalid");
			var value = trimmed(colon + 1, eol);
			if (nameIs(i, colon, "content-length")) {
				if (contentLength >= 0) return fail("header repeats Content-Length");
				contentLength = parseLength(value);
				if (contentLength < 0) return fail(Strings.format1("Content-Length is invalid: \"%s\"", value));
			} else if (nameIs(i, colon, "content-type")) {
				if (contentType != null) return fail("header repeats Content-Type");
				contentType = value;
			}
			i = eol + 2;
		}
		if (contentLength < 0) return fail("header has no Content-Length");
		pos = end;
		scanned = 0;
		if (contentLength > maxPayload) {
			var buf = StringBuilder.new().puts("payload of ").putd(contentLength);
			skip(buf.put1(" bytes is longer than the limit of %d bytes", maxPayload).toString(), contentLength);
			return true;
		}
		var charset = if(contentType != null, charsetOf(contentType));
		if (charset != null && !isUtf8(charset)) {
			skip(Strings.format1("payload charset \"%s\" is not utf-8", charset), contentLength);
			return true;
		}
		// The buffer starts with room for the payload bytes already buffered,
		// and {consume} grows it as more arrive.
		length = int.view(contentLength);
		var available = limit - pos;
		payload = Array<byte>.new(if(available < length, available, length));
		filled = 0;
		return true;
	}
	private def skip(reason: string, length: long) {
		skipReason = reason;
		skipRemaining = length;
	}
	private def fail(reason: string) -> bool {
		failure = reason;
		input = null;
		return false;
	}
	// Returns true if input[start ... end) is an HTTP token, which field names are.
	private def isFieldName(start: int, end: int) -> bool {
		for (i = start; i < end; i++) {
			var b = input[i];
			if (b <= ' ' || b >= 0x7F) return false;
			match (b) {
				'(', ')', ',', '/', ':', ';', '<', '=', '>', '?', '@', '[', '\\', ']', '{', '}', '\"' => return false;
				_ => ;
			}
		}
		return true;
	}
	// Returns true if input[start ... end) equals {lower}, ignoring ASCII case.
	private def nameIs(start: int, end: int, lower: string) -> bool {
		if (end - start != lower.length) return false;
		for (i < lower.length) {
			if (toLower(input[start + i]) != lower[i]) return false;
		}
		return true;
	}
	// Returns input[start ... end) without leading and trailing spaces and tabs.
	private def trimmed(start: int, end: int) -> string {
		while (start < end && isSpace(input[start])) start++;
		while (end > start && isSpace(input[end - 1])) end--;
		return Arrays.range(input, start, end);
	}
}

// The initial size of {LspFrameReader}'s input buffer.
def BUFFER_SIZE = 4096;
// Parses a Content-Length value: one or more decimal digits. Returns -1 if it
// is invalid or longer than 15 digits, which no message could reach.
def parseLength(s: string) -> long {
	if (s.length == 0 || s.length > 15) return -1;
	var n = 0L;
	for (c in s) {
		if (c < '0' || c > '9') return -1;
		n = n * 10 + (c - '0');
	}
	return n;
}
// Returns the charset parameter of a Content-Type value, with any quotes and
// backslash escapes undone, or null if it has none. Parameters are split at
// semicolons outside quoted strings, so text inside another parameter's quoted
// value is never taken for the charset. The media type and other parameters
// are ignored.
def charsetOf(contentType: string) -> string {
	var i = 0, n = contentType.length;
	while (i < n && contentType[i] != ';') i++;	// skip the media type
	while (i < n) {
		var start = ++i;
		while (i < n && contentType[i] != ';') {
			if (contentType[i] != '\"') {
				i++;
			} else {
				var end = endOfQuoted(contentType, i);
				i = if(end < 0, n, end);
			}
		}
		var p = Arrays.range(contentType, start, i), eq = 0;
		while (eq < p.length && p[eq] != '=') eq++;
		if (eq == p.length) continue;
		if (!Strings.equal(lowered(Strings.strip(Arrays.range(p, 0, eq))), "charset")) continue;
		var v = Strings.strip(Arrays.range(p, eq + 1, p.length));
		if (v.length > 0 && v[0] == '\"' && endOfQuoted(v, 0) == v.length) v = unquoted(v);
		return v;
	}
	return null;
}
// Returns the index just past the quoted string that starts at s[start], or -1
// if it is unterminated. A backslash escapes the byte after it.
def endOfQuoted(s: string, start: int) -> int {
	for (i = start + 1; i < s.length; i++) {
		if (s[i] == '\\') i++;
		else if (s[i] == '\"') return i + 1;
	}
	return -1;
}
// Returns the contents of the quoted string {s}, with backslash escapes undone.
def unquoted(s: string) -> string {
	var buf = StringBuilder.new();
	for (i = 1; i < s.length - 1; i++) {
		if (s[i] == '\\') i++;
		buf.putc(s[i]);
	}
	return buf.toString();
}
def isUtf8(charset: string) -> bool {
	var c = lowered(charset);
	return Strings.equal(c, "utf-8") || Strings.equal(c, "utf8");
}
def lowered(s: string) -> string {
	return Arrays.map(s, toLower);
}
def toLower(b: byte) -> byte {
	return if(b >= 'A' && b <= 'Z', byte.view(b + ('a' - 'A')), b);
}
def isSpace(b: byte) -> bool {
	return b == ' ' || b == '\t';
}
