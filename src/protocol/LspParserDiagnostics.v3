// Synchronous, single-file syntax diagnostics for the accepted overlay, parsed
// with the language options of the document's active project. No disk reads
// or verification. UTF-16 is the protocol default; negotiation is not yet
// implemented. {LspDiagnosticLists} merges them with the URI's
// current semantic diagnostics and publishes the complete list.
class LspParserDiagnostics(lists: LspDiagnosticLists) {
	// The last parse of each open document, by URI in byte order; see
	// OrderedStringMap.
	private def parsedWith = OrderedStringMap<LspParsedDocument>.new();

	def update(doc: DocumentOverlay, options: Array<string>) {
		var result = AeneasAdapter.parseFile(pathOf(doc), doc.text, options);
		var map = PositionMap.new(doc.text, PositionEncoding.UTF16);
		var diagnostics = Array<LspDiagnostic>.new(result.diagnostics.length);
		for (i < diagnostics.length) diagnostics[i] = LspDiagnostics.compiler(map, result.diagnostics[i]);
		parsedWith[doc.uri] = LspParsedDocument.new(doc.identity, options, diagnostics.length == 0);
		lists.parsed(doc, diagnostics);
	}
	// Whether {doc}'s text parses with language options {options}: as its
	// last parse found, if that parsed this version with these options, and
	// otherwise by parsing it again, without publishing anything.
	def parses(doc: DocumentOverlay, options: Array<string>) -> bool {
		var last = if(parsedWith.has(doc.uri), parsedWith[doc.uri]);
		if (last != null && last.identity == doc.identity && sameOptions(last.options, options)) return last.clean;
		return AeneasAdapter.parseFile(pathOf(doc), doc.text, options).diagnostics.length == 0;
	}
	// The path that names {doc} in its diagnostics: its file's, or its URI.
	private def pathOf(doc: DocumentOverlay) -> string {
		var path = DocumentUri.filePath(doc.uri);
		return if(path != null, path, doc.uri);
	}
	def close(doc: DocumentOverlay) {
		parsedWith.remove(doc.uri);
		lists.closed(doc);
	}
	// After a configuration change, parses again each open document whose
	// active project now has different language options, and republishes its
	// diagnostics in URI order. Documents without a file path are always in
	// single-file mode.
	def reparse(store: DocumentStore, projects: WorkspaceProjects) {
		var found = Vector<string>.new();
		parsedWith.apply(collectFile(found, _, _));
		var uris = found.extract();
		var owners = projects.owners(Arrays.map(uris, DocumentUri.filePath));
		for (i < uris.length) {
			var doc = store.overlay(uris[i]);
			var options: Array<string> = if(owners[i] != null, owners[i].definition.compilerArgs, []);
			if (doc != null && !sameOptions(parsedWith[uris[i]].options, options)) update(doc, options);
		}
	}
	private def collectFile(uris: Vector<string>, uri: string, last: LspParsedDocument) {
		if (DocumentUri.filePath(uri) != null) uris.put(uri);
	}
	private def sameOptions(a: Array<string>, b: Array<string>) -> bool {
		if (a.length != b.length) return false;
		for (i < a.length) if (!Strings.equal(a[i], b[i])) return false;
		return true;
	}
}

// The last parse of an open document for its diagnostics: the overlay it
// parsed, the language options it parsed with, and whether it parsed.
class LspParsedDocument(identity: DocumentVersionIdentity, options: Array<string>, clean: bool) { }

// One LSP diagnostic and the identity used to merge sources: its byte range,
// code, and message. A whole-program parse error that repeats a single-file
// one has the same identity.
class LspDiagnostic(key: string, value: JsonValue) { }

component LspDiagnostics {
	// An Aeneas error, with a UTF-16 range from its exact byte offsets.
	def compiler(map: PositionMap, d: AnalysisDiagnostic) -> LspDiagnostic {
		return make(map, d.beginOffset, d.endOffset, 1, "aeneas", d.kind, Strings.nonnull(d.message));
	}
	def make(map: PositionMap, begin: int, end: int, severity: int, source: string, code: string, message: string) -> LspDiagnostic {
		var range = Strings.newMap<JsonValue>();
		range["start"] = position(map.offsetToPosition(begin));
		range["end"] = position(map.offsetToPosition(end));
		var diagnostic = Strings.newMap<JsonValue>();
		diagnostic["range"] = JsonValue.JObject(range);
		diagnostic["severity"] = JsonValue.Int(severity); // DiagnosticSeverity
		diagnostic["source"] = JsonValue.String(source);
		if (code != null) diagnostic["code"] = JsonValue.String(code);
		diagnostic["message"] = JsonValue.String(message);
		var key = StringBuilder.new().put2("%d:%d:", begin, end).puts(Strings.nonnull(code)).putc(':').puts(message).extract();
		return LspDiagnostic.new(key, JsonValue.JObject(diagnostic));
	}
	private def position(p: LspPosition) -> JsonValue {
		var obj = Strings.newMap<JsonValue>();
		obj["line"] = JsonValue.Int(p.line);
		obj["character"] = JsonValue.Int(p.character);
		return JsonValue.JObject(obj);
	}
}
