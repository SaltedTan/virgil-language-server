// An automatic analysis the supervisor is running. Inputs keep bounded source
// bytes until completion so the last-parseable cache can record exact inputs.
class LspSemanticRun(context: ProjectContext, keys: Array<string>, inputs: LspAnalysisInputs) {
	// The listener of {LspSemanticDiagnostics.whenAnalyzed}, or null.
	var listener: LspSnapshotWaiters;
}
// A context waiting to be analyzed once {due} (System.ticksMs) has passed. An
// urgent wait stays due, whatever later changes schedule, and starts before
// other due contexts.
class LspSemanticWait(context: ProjectContext) {
	var due: int;
	var urgent: bool;
	var listener: LspSnapshotWaiters;
}

// An analysis that one request needs and no project has, such as a rename's
// preflight (LspRename) or a completion's (LspCompletion). {begin} starts it
// on the supervisor and returns Pending or the failure; {complete} receives
// the outcome, once, unless it was withdrawn: a failure that {begin} returns
// too. Its snapshot is never published, never a context's, and never the
// supervisor's latest.
class LspAnalysisJob(begin: AnalysisSupervisor -> AnalysisOutcome, complete: AnalysisOutcome -> void) {
	var withdrawn: bool;
}

// Automatic whole-program analysis of configured projects and publication of
// its diagnostics, and the one-off analyses of jobs. See
// docs/architecture.md#semantic-diagnostics and docs/architecture.md#rename.
class LspSemanticDiagnostics(store: DocumentStore, projects: WorkspaceProjects, supervisor: AnalysisSupervisor,
		lists: LspDiagnosticLists, send: Array<byte> -> void) {
	// See "Semantic diagnostics" in docs/architecture.md for the measurements.
	def DEBOUNCE_MS = 200;
	var warn: string -> void;
	var info: string -> void;
	var development: LspDevelopmentAnalysis;
	private var running: LspSemanticRun;
	private var waiting = Vector<LspSemanticWait>.new();
	// The jobs waiting for the supervisor, first come first, and the one it
	// runs. Each owner keeps at most one waiting: a rename has one pending
	// at a time, and a completion replaces its waiting job.
	private var jobs = Vector<LspAnalysisJob>.new();
	private var runningJob: LspAnalysisJob;
	// The last analysis started was a job's, so a due context starts next.
	private var jobLast: bool;
	private var configurationChanged: bool;
	private var failureReported: bool;
	private var closed: bool;

	def schedule(contexts: Array<ProjectContext>, debounce: bool) {
		if (closed) return;
		var selected = Vector<ProjectContext>.new();
		for (ctx in contexts) selected.put(ctx);
		for (i = 0; i < selected.length; i++) {
			var paths = Array<string>.new(selected[i].sources.length);
			for (j < paths.length) paths[j] = selected[i].sources[j].path;
			for (owner in projects.owners(paths)) {
				if (owner == null) continue;
				var included = false;
				for (j < selected.length) included = included || selected[j] == owner;
				if (!included) selected.put(owner);
			}
		}
		enqueue(selected.extract(), debounce);
		update();
	}
	// Called for WorkspaceProjects.onConfig, possibly during a refresh; the
	// change is applied by the next update.
	def configChanged() {
		if (!closed) configurationChanged = true;
	}
	// True while the supervisor runs an analysis, or a context or a job waits.
	def busy() -> bool {
		return supervisor.busy() || waitingCount() > 0 || jobs.length > 0;
	}
	// Queues {j} after the waiting jobs, to start once the supervisor is
	// free, which may be before this returns. Jobs and due contexts take
	// turns, so that neither starves the other, and jobs start in the order
	// they were queued, so that none starves another. Returns false, without
	// queueing it, after close.
	def submit(j: LspAnalysisJob) -> bool {
		if (closed) return false;
		jobs.put(j);
		update();
		return true;
	}
	// Drops {j}: if it waits, it never starts, and if it runs, its outcome is
	// discarded when the supervisor completes it.
	def withdraw(j: LspAnalysisJob) {
		j.withdrawn = true;
		removeJob(j);
	}
	// The number of jobs waiting for the supervisor, for tests.
	def jobCount() -> int {
		return jobs.length;
	}
	private def removeJob(j: LspAnalysisJob) {
		var k = 0;
		for (i < jobs.length) if (jobs[i] != j) jobs[k++] = jobs[i];
		jobs.length = k;
	}
	def waitingCount() -> int {
		return waiting.length;
	}
	// The poll timeout: the supervisor's deadline, or the next due context.
	def pollTimeout() -> int {
		var timeout = supervisor.pollTimeout();
		if (closed || supervisor.busy()) return timeout;
		var now = System.ticksMs();
		for (i < waiting.length) {
			var remaining = Ints.max(0, waiting[i].due - now);
			if (timeout < 0 || remaining < timeout) timeout = remaining;
		}
		return timeout;
	}
	// Called after every poll. Completes the supervisor's analysis for its
	// submitter, then starts the next one.
	def onPoll() {
		var outcome = supervisor.onPoll();
		if (!AnalysisOutcome.Pending.?(outcome)) {
			if (running != null) complete(outcome);
			else if (runningJob != null) completeJob(outcome);
			else if (development != null) development.complete(outcome);
		}
		update();
	}
	// Returns the listener of the analysis of {ctx} that captures the newest
	// documents, or null if no analysis of {ctx} waits or runs. That is the
	// waiting one, if there is one, which becomes urgent and starts before any
	// other; otherwise the running one. A scheduler has one consumer, the
	// server's LspSnapshotRequests, so an analysis has at most one listener,
	// its waiting definition and hover requests: {candidate} becomes it unless
	// it already has one. The listener moves from a waiting analysis to the
	// run when it starts, and is notified once, when that analysis completes,
	// fails, or is dropped, which may happen before this returns if the waiting
	// analysis cannot start. Closing drops listeners without notifying them.
	def whenAnalyzed(ctx: ProjectContext, candidate: LspSnapshotWaiters) -> LspSnapshotWaiters {
		if (closed) return null;
		// Apply configuration changes without starting other due work first.
		reconcile();
		for (i < waiting.length) {
			var w = waiting[i];
			if (w.context != ctx) continue;
			w.urgent = true;
			w.due = System.ticksMs();
			if (w.listener == null) w.listener = candidate;
			var listener = w.listener;
			startNext();
			return listener;
		}
		if (running == null || running.context != ctx) return null;
		if (running.listener == null) running.listener = candidate;
		return running.listener;
	}
	// Stops scheduling; the caller closes the supervisor.
	def close() {
		closed = true;
		running = null;
		runningJob = null;
		jobs.clear();
		waiting.clear();
		configurationChanged = false;
	}
	private def enqueue(contexts: Array<ProjectContext>, debounce: bool) {
		if (closed) return;
		var current = Vector<LspSemanticWait>.new(), dropped = Vector<LspSemanticWait>.new();
		for (i < waiting.length) {
			var w = waiting[i];
			if (w.context.config.current) current.put(w);
			else dropped.put(w);
		}
		waiting = current;
		var now = System.ticksMs(), due = now + if(debounce, DEBOUNCE_MS);
		for (ctx in contexts) {
			if (!ctx.config.current) continue;
			var wait: LspSemanticWait;
			for (i < waiting.length) { if(waiting[i].context == ctx) wait = waiting[i]; }
			if (wait == null) waiting.put(wait = LspSemanticWait.new(ctx));
			wait.due = if(wait.urgent, now, due);
		}
		for (i < dropped.length) finished(dropped[i].listener);
	}
	private def finished(listener: LspSnapshotWaiters) {
		if (listener != null) listener.analyzed();
	}
	private def update() {
		if (closed) return;
		reconcile();
		startNext();
	}
	private def reconcile() {
		if (!configurationChanged) return;
		configurationChanged = false;
		lists.clearOwned(null, null);
		enqueue(projects.loadedContexts(), false);
	}
	private def startNext() {
		while (!closed && !supervisor.busy()) {
			var now = System.ticksMs(), next: LspSemanticWait;
			for (i < waiting.length) {
				var w = waiting[i];
				if (w.due - now <= 0 && (next == null || (w.urgent && !next.urgent))) next = w;
			}
			if (jobs.length > 0 && (next == null || !jobLast)) {
				startJob();
				continue;
			}
			if (next == null) return;
			jobLast = false;
			var rest = Vector<LspSemanticWait>.new();
			for (i < waiting.length) { if(waiting[i] != next) rest.put(waiting[i]); }
			waiting = rest;
			start(next.context);
			if (running != null) running.listener = next.listener;
			else finished(next.listener);
		}
	}
	private def start(ctx: ProjectContext) {
		// A replaced configuration's context has a current successor.
		if (!ctx.config.current || ctx.sources.length == 0) return;
		var keys = Array<string>.new(ctx.sources.length);
		for (i < keys.length) {
			keys[i] = ctx.sources[i].uri;
			if (keys[i] == null) return failed(ctx, Strings.format1("cannot form a document URI for %s", ctx.sources[i].path));
		}
		var captured = LspAnalysisCapture.capture(store, keys, true);
		if (captured.1 != null) return failed(ctx, captured.1);
		var inputs = captured.0;
		if (!projects.admitSnapshot(ctx, supervisor.snapshot, long.view(AnalysisWire.MAX_RESULT_ALLOCATION) + inputs.snapshotBytes)) {
			return failed(ctx, "retained analysis snapshots exceed the workspace budget");
		}
		var outcome = supervisor.begin(inputs.sources, ctx.definition.compilerArgs, AnalysisWire.WANT_OCCURRENCES);
		match (outcome) {
			Failed(failure, reason) => failed(ctx, reason);
			_ => running = LspSemanticRun.new(ctx, keys, inputs);
		}
	}
	private def startJob() {
		var j = jobs[0];
		removeJob(j);
		jobLast = true;
		var outcome = j.begin(supervisor);
		if (AnalysisOutcome.Pending.?(outcome)) runningJob = j;
		else j.complete(outcome);
	}
	private def completeJob(outcome: AnalysisOutcome) {
		var j = runningJob;
		runningJob = null;
		if (!j.withdrawn) j.complete(outcome);
	}
	private def complete(outcome: AnalysisOutcome) {
		var run = running, ctx = run.context;
		running = null;
		match (outcome) {
			Completed(snapshot) => {
				snapshot.recordDocumentVersions(run.inputs.versions);
				// Notice a configuration replaced on disk before trusting the result.
				projects.refresh();
				run.inputs.cacheCompleted(ctx, projects.parseableText, snapshot);
				snapshot.recordProject(ctx);
				ctx.snapshot = snapshot;
				failureReported = false;
				publish(run, snapshot);
			}
			Failed(failure, reason) => failed(ctx, reason);
			Pending => ;
		}
		finished(run.listener);
	}
	private def publish(run: LspSemanticRun, snapshot: AnalysisSnapshot) {
		var ctx = run.context, inputs = run.inputs;
		if (!snapshot.matchesProject()) return discard(ctx, snapshot, "its project configuration changed");
		if (!LspAnalysisCapture.matchesSources(inputs.versions, ctx.sources)) return discard(ctx, snapshot, "its source membership changed");
		for (v in inputs.versions) {
			if (!v.matchesDocument(store)) return discard(ctx, snapshot, Strings.format1("%s changed after its sources were captured", v.uri));
		}
		var paths = snapshot.paths, owners = projects.owners(paths), index = OrderedStringMap<int>.new();
		for (i < paths.length) index.add(paths[i], i);
		var found = Array<Vector<LspDiagnostic>>.new(paths.length);
		var maps = Array<PositionMap>.new(paths.length);
		var last = -1, lastDiagnostic: AnalysisDiagnostic;
		for (d in snapshot.diagnostics) {
			if (d.path == null || !index.has(d.path)) {
				log(warn, Strings.format2("project %s reported a diagnostic without a source document: %s", ctx.definition.name, d.toString()));
				continue;
			}
			var i = index[d.path];
			if (owners[i] != ctx) continue;
			if (maps[i] == null) {
				var text = LspAnalysisCapture.analyzedText(store, snapshot, i);
				if (text == null) return discard(ctx, snapshot, Strings.format1("%s changed on disk after its sources were captured", run.keys[i]));
				maps[i] = PositionMap.new(text, PositionEncoding.UTF16);
				found[i] = Vector<LspDiagnostic>.new();
			}
			found[i].put(LspDiagnostics.compiler(maps[i], d));
			last = i;
			lastDiagnostic = d;
		}
		// At its error limit Aeneas stops checking, hiding errors in later
		// declarations and files; say so where the last reported error is.
		if (last >= 0 && snapshot.diagnostics.length >= AeneasAdapter.PROGRAM_MAX_ERRORS) {
			found[last].put(LspDiagnostics.make(maps[last], lastDiagnostic.beginOffset, lastDiagnostic.endOffset, 3, "virgil-lsp", "ErrorLimit",
				Strings.format1("Aeneas stops checking after %d errors, so errors elsewhere in this program may be missing.", AeneasAdapter.PROGRAM_MAX_ERRORS)));
		}
		var keep = OrderedStringMap<bool>.new();
		for (i < paths.length) {
			if (owners[i] != ctx || !keep.add(run.keys[i], true)) continue;
			lists.semantic(run.keys[i], ctx, inputs.versions, if(found[i] != null, found[i].extract(), []));
		}
		lists.clearOwned(ctx, keep);
	}
	private def discard(ctx: ProjectContext, snapshot: AnalysisSnapshot, why: string) {
		log(info, Strings.format3("discarded analysis %d of project %s: %s", snapshot.generation, ctx.definition.name, why));
	}
	private def failed(ctx: ProjectContext, reason: string) {
		log(warn, Strings.format2("automatic analysis of project %s failed: %s; published diagnostics are kept", ctx.definition.name, reason));
		if (failureReported) return;
		failureReported = true;
		var params = Strings.newMap<JsonValue>();
		params["type"] = JsonValue.Int(2); // MessageType.Warning
		params["message"] = JsonValue.String(Strings.format2(
			"Semantic diagnostics for project %s could not be updated: %s. The last published diagnostics are kept; see the server log.",
			ctx.definition.name, reason));
		send(JsonRpcMessage.Notification("window/showMessage", JsonRpcParams.ByName(params)).encode());
	}
	private def log(sink: string -> void, msg: string) {
		if (sink != null) sink(msg);
	}
}
