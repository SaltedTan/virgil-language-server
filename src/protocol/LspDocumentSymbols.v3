// The LSP SymbolKind of each kind of declaration that snapshots record, for
// document symbols and later workspace symbols. Variants and data types are
// classes, and file-scope methods and fields are members of the file's
// synthetic component, so they map as a component's members do. See
// docs/architecture.md#document-symbols. Each reply sends these kinds
// through the client's LspClientKinds.
component LspSymbolKind {
	def of(kind: AnalysisDeclKind) -> int {
		match (kind) {
			COMPONENT => return 3;	// Namespace
			CLASS => return 5;	// Class
			METHOD => return 6;	// Method
			FIELD, LAYOUT_FIELD => return 8;	// Field
			CONSTRUCTOR => return 9;	// Constructor
			ENUM => return 10;	// Enum
			LOCAL, PARAMETER => return 13;	// Variable
			ENUM_CASE, VARIANT_CASE => return 22;	// EnumMember
			LAYOUT, PACKING => return 23;	// Struct
			TYPE_PARAM => return 26;	// TypeParameter
		}
	}
	// The CompletionItemKind of a declaration of {kind}: the completion kind
	// named as its SymbolKind is, so that completion shows each declaration
	// as the outlines do.
	def completion(kind: AnalysisDeclKind) -> int {
		match (of(kind)) {
			3 => return 9;		// Namespace: Module
			5 => return 7;		// Class
			6 => return 2;		// Method
			8 => return 5;		// Field
			9 => return 4;		// Constructor
			10 => return 13;	// Enum
			13 => return 6;		// Variable
			22 => return 20;	// EnumMember
			23 => return 22;	// Struct
			26 => return 25;	// TypeParameter
			_ => return 1;		// Text
		}
	}
	// The SymbolKind sent in place of {kind} to a client that doesn't support
	// it, or {kind} if there is none. Each is an LSP 3.0 kind.
	def symbolFallback(kind: int) -> int {
		match (kind) {
			22 => return 14;	// EnumMember: Constant
			23 => return 5;		// Struct: Class
			26 => return 5;		// TypeParameter: Class, since it is a type
			_ => return kind;
		}
	}
	// The CompletionItemKind sent in place of {kind}, as for symbolFallback.
	def completionFallback(kind: int) -> int {
		match (kind) {
			20 => return 12;	// EnumMember: Value
			22 => return 7;		// Struct: Class
			25 => return 7;		// TypeParameter: Class
			_ => return kind;
		}
	}
	// The SymbolKinds that a client supports, from {capability}, its
	// textDocument.documentSymbol.symbolKind or workspace.symbol.symbolKind,
	// which may be null.
	def symbols(capability: HashMap<string, JsonValue>) -> LspClientKinds {
		return LspClientKinds.new(18, symbolFallback).read(capability);	// File to Array
	}
	// The CompletionItemKinds that a client supports, from {capability}, its
	// textDocument.completion.completionItemKind, which may be null.
	def completions(capability: HashMap<string, JsonValue>) -> LspClientKinds {
		return LspClientKinds.new(18, completionFallback).read(capability);	// Text to Reference
	}
}

// The kinds of one LSP enumeration, SymbolKind or CompletionItemKind, that a
// client supports, and the kind sent for each. Without a valueSet a client
// supports only the kinds of LSP 3.0, 1 to {initial}; with one, the integers
// it lists. A kind it doesn't support is sent as its fallback, if the client
// supports that. Otherwise it is sent unchanged, since a client that lists
// its kinds handles others gracefully. See docs/architecture.md#client-kinds.
class LspClientKinds(initial: int, fallback: int -> int) {
	// The highest kind that LspSymbolKind gives: TypeParameter's SymbolKind.
	def MAX_KIND = 26;
	// The listed kinds up to MAX_KIND, indexed by kind; null without a valueSet.
	private var listed: Array<bool>;

	// Reads the valueSet of {capability}, if it is an array.
	def read(capability: HashMap<string, JsonValue>) -> this {
		if (capability == null || !JsonValue.JArray.?(capability["valueSet"])) return;
		listed = Array<bool>.new(MAX_KIND + 1);
		for (v in JsonValue.JArray.!(capability["valueSet"]).v) {
			if (!JsonValue.Int.?(v)) continue;
			var k = JsonValue.Int.!(v).v;
			if (k > 0 && k <= MAX_KIND) listed[k] = true;
		}
	}
	def supports(kind: int) -> bool {
		if (listed == null) return kind > 0 && kind <= initial;
		return kind > 0 && kind <= MAX_KIND && listed[kind];
	}
	// The kind sent for {kind}.
	def send(kind: int) -> int {
		if (supports(kind)) return kind;
		var f = fallback(kind);
		return if(supports(f), f, kind);
	}
}

// Outlines parse the overlay with the language options of the document's
// active project, as its syntax diagnostics do. A hierarchical symbol's detail
// is its declaration's signature, from the active project's snapshot, but only
// if that snapshot analyzed this very overlay; the outline never waits for one.
// Reply shapes follow the client's capabilities; see
// docs/architecture.md#document-symbols.
class LspDocumentSymbols(store: DocumentStore, projects: WorkspaceProjects) {
	// True if the client's initialize declared
	// textDocument.documentSymbol.hierarchicalDocumentSymbolSupport: true.
	var hierarchy: bool;
	// The client's textDocument.documentSymbol.symbolKind.
	var clientKinds = LspSymbolKind.symbols(null);

	def register(dispatcher: JsonRpcDispatcher) {
		dispatcher.onRequest("textDocument/documentSymbol", documentSymbol);
	}
	private def documentSymbol(request: JsonRpcMessage.Request) -> JsonRpcReply {
		var params = if(JsonRpcParams.ByName.?(request.params), JsonRpcParams.ByName.!(request.params).v);
		var doc = objectMember(params, "textDocument");
		if (doc == null || !doc.has("uri") || !JsonValue.String.?(doc["uri"]) ||
			JsonValue.String.!(doc["uri"]).v == null || DocumentUri.normalize(JsonValue.String.!(doc["uri"]).v) == null) {
			return JsonRpcReply.Error(JsonRpcError.new(JsonRpcErrorCode.INVALID_PARAMS, "documentSymbol params require a valid textDocument.uri"));
		}
		var overlay = store.overlay(JsonValue.String.!(doc["uri"]).v);
		if (overlay == null) return JsonRpcReply.Result(JsonValue.JArray([]));
		var map = PositionMap.new(overlay.text, PositionEncoding.UTF16);
		var owner = projects.forDocument(overlay.uri);
		var symbols = AeneasAdapter.documentSymbols(overlay.uri, overlay.text, owner.compilerArgs());
		var s = if(owner.active != null, owner.active.snapshot);
		// Details need current, unsubstituted overlay text: a matching identity
		// alone can still carry cached-text declaration offsets after fallback.
		if (s != null && (!s.matchesDocument(store, overlay.uri) ||
			s.documentVersions[s.documentIndex(overlay.uri)].substitution != null)) s = null;
		var path = if(s != null, s.paths[s.documentIndex(overlay.uri)]);
		if (hierarchy) return JsonRpcReply.Result(encodeSymbols(symbols, map, s, path));
		return JsonRpcReply.Result(encodeSymbolInformation(overlay.uri, symbols, map));
	}
	private def objectMember(obj: HashMap<string, JsonValue>, key: string) -> HashMap<string, JsonValue> {
		if (obj == null || !obj.has(key) || !JsonValue.JObject.?(obj[key])) return null;
		return JsonValue.JObject.!(obj[key]).v;
	}
	// {s} is null, or a snapshot that analyzed this text as {path}.
	private def encodeSymbols(symbols: Array<AnalysisDocumentSymbol>, map: PositionMap, s: AnalysisSnapshot, path: string) -> JsonValue {
		var result = Vector<JsonValue>.new();
		for (sym in symbols) {
			var obj = Strings.newMap<JsonValue>();
			obj["name"] = JsonValue.String(sym.name);
			obj["kind"] = JsonValue.Int(clientKinds.send(LspSymbolKind.of(sym.kind)));
			obj["range"] = range(map, sym.begin, sym.end);
			obj["selectionRange"] = range(map, sym.nameBegin, sym.nameEnd);
			var signature = if(s != null, signatureOf(s, path, sym));
			if (signature != null) obj["detail"] = JsonValue.String(signature);
			if (sym.children.length > 0) obj["children"] = encodeSymbols(sym.children, map, s, path);
			result.put(JsonValue.JObject(obj));
		}
		return JsonValue.JArray(result.extract());
	}
	// SymbolInformation[]: the same tree in pre-order, so that each symbol
	// follows its parent. Each entry has its full declaration range, not just
	// its name's, and its parent's name. Details belong to DocumentSymbol, so
	// this shape has none.
	private def encodeSymbolInformation(uri: string, symbols: Array<AnalysisDocumentSymbol>, map: PositionMap) -> JsonValue {
		var result = Vector<JsonValue>.new();
		flatten(uri, symbols, null, map, result);
		return JsonValue.JArray(result.extract());
	}
	private def flatten(uri: string, symbols: Array<AnalysisDocumentSymbol>, container: string, map: PositionMap,
			result: Vector<JsonValue>) {
		for (sym in symbols) {
			var location = Strings.newMap<JsonValue>();
			location["uri"] = JsonValue.String(uri);
			location["range"] = range(map, sym.begin, sym.end);
			var obj = Strings.newMap<JsonValue>();
			obj["name"] = JsonValue.String(sym.name);
			obj["kind"] = JsonValue.Int(clientKinds.send(LspSymbolKind.of(sym.kind)));
			obj["location"] = JsonValue.JObject(location);
			if (container != null) obj["containerName"] = JsonValue.String(container);
			result.put(JsonValue.JObject(obj));
			flatten(uri, sym.children, sym.name, map, result);
		}
	}
	// The signature of the declaration named by exactly {sym}'s name token,
	// or null. Names repeat across scopes; the token does not. A data type
	// shares its name token with its single case, and the site there is the
	// type's.
	private def signatureOf(s: AnalysisSnapshot, path: string, sym: AnalysisDocumentSymbol) -> string {
		var d = s.declarationAtOffset(path, sym.nameBegin);
		if (d == null || d.range.beginOffset != sym.nameBegin || d.range.endOffset != sym.nameEnd) return null;
		return d.signature;
	}
	private def range(map: PositionMap, begin: int, end: int) -> JsonValue {
		var obj = Strings.newMap<JsonValue>();
		obj["start"] = position(map.offsetToPosition(begin));
		obj["end"] = position(map.offsetToPosition(end));
		return JsonValue.JObject(obj);
	}
	private def position(p: LspPosition) -> JsonValue {
		var obj = Strings.newMap<JsonValue>();
		obj["line"] = JsonValue.Int(p.line);
		obj["character"] = JsonValue.Int(p.character);
		return JsonValue.JObject(obj);
	}
}
