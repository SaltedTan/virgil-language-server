// textDocument/prepareRename over LspRenameEligibility: the range and
// placeholder of the name at a position, or RequestFailed with the reason it
// cannot be renamed. See docs/architecture.md#prepare-rename.
class LspPrepareRename(projects: WorkspaceProjects) {
	def register(dispatcher: JsonRpcDispatcher, requests: LspSnapshotRequests) {
		requests.registerRejecting(dispatcher, "textDocument/prepareRename", "prepareRename",
			answer, fail);
	}
	// The prepared range and placeholder of the use or declaration containing
	// {offset}, or false if neither is there and the caller should try the byte
	// before it (see LspRenameEligibility.select).
	def answer(at: LspSnapshotPosition, offset: int) -> (bool, JsonRpcReply) {
		var selected = LspRenameEligibility.select(at, projects, offset);
		if (!selected.0) return (false, JsonRpcReply.Result(JsonValue.Null));
		if (selected.2 != null) return (true, fail(selected.2));
		var sel = selected.1, result = Strings.newMap<JsonValue>();
		// The prepared range is the token in the requested document, which is
		// where the editor starts the rename; the placeholder is the
		// declaration's name, which a use's alias never is.
		result["range"] = at.range(at.map, sel.begin, sel.end);
		result["placeholder"] = JsonValue.String(sel.decl.name);
		return (true, JsonRpcReply.Result(JsonValue.JObject(result)));
	}
	// The RequestFailed reply for a request that cannot be prepared, with the
	// reason in the message, rather than null, which would not show a reason.
	def fail(reason: string) -> JsonRpcReply {
		return JsonRpcReply.Error(JsonRpcError.new(LspErrorCode.REQUEST_FAILED, reason));
	}
}
