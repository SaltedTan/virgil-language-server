// A semantic-token request for a file with no active project. Its temporary
// analysis never becomes a project's or the supervisor's retained snapshot.
class LspStandaloneTokenRequest(owner: LspStandaloneTokens, id: JsonRpcId, uri: string,
		identity: DocumentVersionIdentity, disk: DocumentVersionIdentity) {
	var job: LspAnalysisJob;
	var answered: bool;
	var versions: Array<AnalysisDocumentVersion>;
	def begin(supervisor: AnalysisSupervisor) -> AnalysisOutcome { return owner.begin(this, supervisor); }
	def complete(outcome: AnalysisOutcome) { owner.complete(this, outcome); }
}

class LspStandaloneTokens(store: DocumentStore, projects: WorkspaceProjects, send: Array<byte> -> void,
		answer: (LspSnapshotPosition, int) -> (bool, JsonRpcReply),
		failure: (string, DocumentVersionIdentity, string) -> JsonRpcReply) {
	var scheduler: LspSemanticDiagnostics;
	var maxWaiting: int;
	private def requests = Vector<LspStandaloneTokenRequest>.new();

	// The shared snapshot handler has already validated and normalized the URI.
	def receive(request: JsonRpcMessage.Request, uri: string) {
		var doc = store.overlay(uri);
		var r = LspStandaloneTokenRequest.new(this, request.id, uri,
			if(doc != null, doc.identity), if(doc == null, store.diskStamp(uri)));
		if (scheduler == null) return finish(r, failure(uri, r.identity, "semantic tokens need the analysis worker"));
		if (requests.length >= maxWaiting) {
			var oldest = requests[0];
			finish(oldest, failure(oldest.uri, oldest.identity, "too many requests are waiting"));
		}
		requests.put(r);
		r.job = LspAnalysisJob.new(r.begin, r.complete);
		if (!scheduler.submit(r.job)) finish(r, cancelled());
	}
	private def current(r: LspStandaloneTokenRequest) -> bool {
		var doc = store.overlay(r.uri);
		return !r.answered && projects.forDocument(r.uri).active == null
			&& if(r.identity != null, doc != null && doc.identity == r.identity,
				doc == null && store.diskStamp(r.uri) == r.disk);
	}
	def begin(r: LspStandaloneTokenRequest, supervisor: AnalysisSupervisor) -> AnalysisOutcome {
		if (!current(r)) return AnalysisOutcome.Failed(AnalysisFailure.UNAVAILABLE, "the document changed");
		var captured = LspAnalysisCapture.capture(store, [r.uri], false);
		if (captured.1 != null) return AnalysisOutcome.Failed(AnalysisFailure.UNAVAILABLE, captured.1);
		var inputs = captured.0;
		if (!projects.admitKeeping(null, supervisor.snapshot,
			long.view(AnalysisWire.MAX_RESULT_ALLOCATION) + inputs.snapshotBytes)) {
			return AnalysisOutcome.Failed(AnalysisFailure.TOO_LARGE, "retained analysis snapshots exceed the workspace budget");
		}
		r.versions = inputs.versions;
		return supervisor.beginTemporary(inputs.sources, [], AnalysisWire.WANT_OCCURRENCES, null);
	}
	def complete(r: LspStandaloneTokenRequest, outcome: AnalysisOutcome) {
		if (r.answered) return;
		var reason = "the document changed";
		if (current(r)) {
			match (outcome) {
				Completed(snapshot) => {
					snapshot.recordDocumentVersions(r.versions);
					var text = LspAnalysisCapture.analyzedText(store, snapshot, 0);
					if (snapshot.parsed && snapshot.hasOccurrences && text != null) {
						var at = LspSnapshotPosition.new(store, snapshot, 0, text,
							PositionMap.new(text, PositionEncoding.UTF16), []);
						return finish(r, answer(at, 0).1);
					}
					reason = "the document's analysis has parse errors or is stale";
				}
				Failed(_, message) => reason = message;
				Pending => return;
			}
		}
		finish(r, failure(r.uri, r.identity, reason));
	}
	def cancel(n: JsonRpcMessage.Notification) {
		if (!JsonRpcParams.ByName.?(n.params)) return;
		var params = JsonRpcParams.ByName.!(n.params).v, id: JsonRpcId;
		if (!params.has("id")) return;
		match (params["id"]) {
			Int(v) => id = JsonRpcId.Int(v);
			String(v) => id = JsonRpcId.String(v);
			_ => return;
		}
		for (i < requests.length) if (requests[i].id.equal(id)) { finish(requests[i], cancelled()); return; }
	}
	def close() {
		while (requests.length > 0) finish(requests[0], cancelled());
	}
	private def cancelled() -> JsonRpcReply {
		return JsonRpcReply.Error(JsonRpcError.new(LspErrorCode.REQUEST_CANCELLED, "the semantic tokens request was cancelled"));
	}
	private def finish(r: LspStandaloneTokenRequest, reply: JsonRpcReply) {
		if (r.answered) return;
		r.answered = true;
		if (r.job != null) scheduler.withdraw(r.job);
		var k = 0;
		for (i < requests.length) if (requests[i] != r) requests[k++] = requests[i];
		requests.length = k;
		r.versions = null;
		match (reply) {
			Result(v) => send(JsonRpcMessage.Response(r.id, v).encode());
			ResultJson(v) => send(JsonRpcMessage.RawResponse(r.id, v).encode());
			Error(e) => send(JsonRpcMessage.ErrorResponse(r.id, e).encode());
		}
	}
}
