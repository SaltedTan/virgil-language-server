// LSP error codes, beyond the JSON-RPC 2.0 codes in {JsonRpcErrorCode}.
component LspErrorCode {
	def SERVER_NOT_INITIALIZED = -32002;	// a request arrived before initialize
	def REQUEST_CANCELLED = -32800;		// the request was cancelled
	def REQUEST_FAILED = -32803;		// a valid request could not be answered
}

// Where the server is in the LSP lifecycle.
enum LspServerState {
	UNINITIALIZED,	// no initialize request has succeeded yet
	RUNNING,	// initialize succeeded
	SHUTTING_DOWN,	// shutdown succeeded
	EXITED		// exit was received, or the input ended
}

// The LSP 3.17 lifecycle in front of a dispatcher. Each payload is checked
// against the lifecycle state before the dispatcher routes it. Transport I/O
// is injected; project discovery uses bounded host filesystem access. See
// docs/architecture.md.
//
// - Before a successful initialize, requests other than initialize get
//   ServerNotInitialized, and notifications other than exit are dropped.
// - initialize returns the server's capabilities. It may succeed only once.
// - After shutdown, requests get InvalidRequest, and notifications other than
//   exit are dropped.
// - exit, or the end of the input, ends the session. The exit status is 0 if
//   shutdown succeeded first, and 1 otherwise. Nothing is handled after that.
// - Payloads that aren't valid requests or notifications, and responses from
//   the client, are passed to the dispatcher in every state before exit.
class LspServer {
	private var documentCapacity: int;
	// Handlers for the server's features are registered here.
	def dispatcher = JsonRpcDispatcher.new();
	def documents = DocumentStore.new(null, documentCapacity);
	def projects = WorkspaceProjects.new(documents);
	private var diagnosticLists: LspDiagnosticLists;
	private var parserDiagnostics: LspParserDiagnostics;
	private var projectDiagnostics: LspProjectDiagnostics;
	private var semanticDiagnostics: LspSemanticDiagnostics;
	private var documentWarning: Array<byte>;
	// Set when a configuration changes, which may change the language
	// options of open documents; see reparseDocuments.
	private var configurationChanged: bool;
	// The caller supplies stderr logging; unit tests may record warnings.
	var warnDocumentSync: string -> void;
	var warnProject: string -> void;
	var infoProject: string -> void;
	var infoAnalysis: string -> void;
	// Notifications and deferred replies are separate from handle()'s replies.
	var sendNotification: Array<byte> -> void;
	private var documentSync: LspDocumentSync;
	private var developmentAnalysis: LspDevelopmentAnalysis;
	// Definition, hover, references, document highlight, signature help, and
	// rename requests, answered from snapshots.
	private var snapshotRequests: LspSnapshotRequests;
	private def hover = LspHover.new();
	private var inlayHints: LspInlayHints;
	private var prepareRename: LspPrepareRename;
	// Signature help from snapshots, and from call queries where the document
	// does not parse; tests read its count of analyses.
	var signatureHelp: LspSignatureHelp;
	// textDocument/rename; tests may lower its bounds.
	var rename: LspRename;
	private def documentSymbols = LspDocumentSymbols.new(documents, projects);
	private def workspaceSymbols = LspWorkspaceSymbols.new(documents, projects);
	// Keywords from the open document's text, and declarations in scope from
	// a completion analysis; tests read its count of analyses.
	var completion: LspCompletion;
	// Watched-file and workspace-folder notifications, and the watcher registration.
	def workspaceEvents = LspWorkspaceEvents.new(documents, projects);
	// Completes a server request whose deadline has passed.
	private def REQUEST_TIMEOUT = JsonRpcError.new(JsonRpcErrorCode.INTERNAL_ERROR, "the client did not answer in time");
	def var state = LspServerState.UNINITIALIZED;
	// The process exit status, once {exited} is true.
	def var exitStatus: int;
	// Why the exit status is not 0, for logging.
	def var failure: string;

	// Production supplies DocumentLimits.MAX_BYTES; tests may inject less.
	new(documentCapacity) {
		dispatcher
			.onRequest("initialize", initialize)
			.onNotification("initialized", initialized)
			.onRequest("shutdown", shutdown);
		documentSync = LspDocumentSync.new(documents, ignoredDocumentSync);
		documentSync.capacityWarning = capacityExceeded;
		documentSync.register(dispatcher);
		documentSymbols.register(dispatcher);
		workspaceSymbols.register(dispatcher);
		completion = LspCompletion.new(documents, projects, publishNotification);
		completion.register(dispatcher);
		snapshotRequests = LspSnapshotRequests.new(documents, projects, publishNotification);
		snapshotRequests.register(dispatcher, "textDocument/definition", "definition", LspDefinition.answer);
		snapshotRequests.register(dispatcher, "textDocument/typeDefinition", "type definition", LspDefinition.typeAnswer);
		snapshotRequests.register(dispatcher, "textDocument/hover", "hover", hover.answer);
		snapshotRequests.registerPrepared(dispatcher, "textDocument/references", "references",
			LspReferences.REQUIRES, LspReferences.prepare);
		snapshotRequests.registerPrepared(dispatcher, "textDocument/documentHighlight", "document highlights",
			LspDocumentHighlights.REQUIRES, LspDocumentHighlights.prepare);
		signatureHelp = LspSignatureHelp.new(documents, projects, publishNotification);
		signatureHelp.register(dispatcher, snapshotRequests);
		inlayHints = LspInlayHints.new(publishNotification, dispatcher.pending, documents, projects);
		inlayHints.register(dispatcher, snapshotRequests);
		prepareRename = LspPrepareRename.new(documents, projects, publishNotification);
		prepareRename.register(dispatcher, snapshotRequests);
		rename = LspRename.new(documents, projects, snapshotRequests, publishNotification);
		rename.register(dispatcher);
		// Waiting snapshot requests, rename, completion, and repaired
		// signature help requests can be cancelled.
		dispatcher.onNotification("$/cancelRequest", cancel);
		workspaceEvents.register(dispatcher);
		workspaceEvents.schedule = scheduleWatched;
		workspaceEvents.warn = projectWarning;
		workspaceEvents.info = projectInfo;
		diagnosticLists = LspDiagnosticLists.new(documents, publishNotification);
		parserDiagnostics = LspParserDiagnostics.new(diagnosticLists);
		signatureHelp.parser = parserDiagnostics;
		projectDiagnostics = LspProjectDiagnostics.new(publishNotification);
		projects.warn = projectWarning;
		projects.info = projectInfo;
		projects.onConfig = configChanged;
		documentSync.onOpen = documentOpened;
		documentSync.onChange = documentChanged;
		documentSync.onVersionChange = documentVersionChanged;
		documentSync.onSave = documentSaved;
		documentSync.onClose = documentClosed;
	}
	// Production attaches its worker supervisor; lifecycle-only tests need no
	// OS. Automatic semantic diagnostics and the development requests share it.
	def withAnalysis(supervisor: AnalysisSupervisor) -> this {
		developmentAnalysis = LspDevelopmentAnalysis.new(documents, supervisor, publishNotification).withProjects(projects);
		developmentAnalysis.register(dispatcher);
		developmentAnalysis.hintsAnalyzed = inlayHints.analyzed;
		semanticDiagnostics = LspSemanticDiagnostics.new(documents, projects, supervisor, diagnosticLists, publishNotification);
		semanticDiagnostics.parser = developmentAnalysis.parser = parserDiagnostics;
		semanticDiagnostics.development = developmentAnalysis;
		semanticDiagnostics.warn = projectWarning;
		semanticDiagnostics.info = analysisInfo;
		semanticDiagnostics.hintsAnalyzed = inlayHints.analyzed;
		snapshotRequests.whenAnalyzed = semanticDiagnostics.whenAnalyzed;
		rename.scheduler = semanticDiagnostics;
		completion.scheduler = semanticDiagnostics;
		signatureHelp.scheduler = semanticDiagnostics;
	}
	// Called after every poll, including a timeout. Completes analyses and
	// expires server requests the client hasn't answered in time.
	def onPoll() {
		if (semanticDiagnostics != null) semanticDiagnostics.onPoll();
		reparseDocuments();
		if (dispatcher.pending.count() > 0) dispatcher.pending.expire(System.ticksMs(), REQUEST_TIMEOUT);
	}
	// True while an analysis runs or waits to run.
	def analyzing() -> bool {
		return semanticDiagnostics != null && semanticDiagnostics.busy();
	}
	// The poll timeout in milliseconds, or -1 to wait indefinitely.
	def pollTimeout() -> int {
		var analysis = if(semanticDiagnostics != null, semanticDiagnostics.pollTimeout(), -1);
		var requests = dispatcher.pending.timeout(System.ticksMs());
		if (analysis < 0 || (requests >= 0 && requests < analysis)) return requests;
		return analysis;
	}
	private def configChanged(c: WorkspaceConfig) {
		rename.configChanged();
		invalidateQueries();
		projectDiagnostics.update(c);
		if (semanticDiagnostics != null) semanticDiagnostics.configChanged();
		configurationChanged = true;
	}
	// Configurations change during a refresh, so open documents are parsed
	// again only once the payload or poll that refreshed them is handled.
	private def reparseDocuments() {
		if (!configurationChanged) return;
		configurationChanged = false;
		parserDiagnostics.reparse(documents, projects);
		inlayHints.scopesChanged();
	}
	private def documentOpened(doc: DocumentOverlay) {
		documentUpdated(doc, false);
	}
	private def documentChanged(doc: DocumentOverlay) {
		documentUpdated(doc, true);
	}
	// A didChange with no content changes. The text is byte-for-byte the same,
	// so analyses, diagnostics, and cached queries still describe it. Only the
	// version that clients check in edits and diagnostics changed: republish
	// the current list at that version. If the list's semantic diagnostics are
	// stale, the republished list leaves them out, so schedule the document's
	// current projects to analyze its sources again; otherwise this analyzes
	// nothing. Project files have configuration diagnostics, which carry no
	// version.
	private def documentVersionChanged(doc: DocumentOverlay) {
		if (isProjectFile(doc)) return;
		var mapping = projects.forDocument(doc.uri);
		if (!parserDiagnostics.versioned(doc, mapping.active) || semanticDiagnostics == null) return;
		semanticDiagnostics.schedule(mapping.contexts, false);
	}
	private def documentUpdated(doc: DocumentOverlay, debounce: bool) {
		invalidateQueries();
		if (reloadProjectFile(doc)) return;
		var mapping = projects.forDocument(doc.uri);
		parserDiagnostics.update(doc, mapping.compilerArgs());
		if (mapping.active == null) inlayHints.scopesChanged();
		if (semanticDiagnostics != null) semanticDiagnostics.schedule(mapping.contexts, debounce);
	}
	private def documentSaved(doc: DocumentOverlay) {
		invalidateQueries();
		if (semanticDiagnostics != null && !isProjectFile(doc)) {
			semanticDiagnostics.schedule(projects.forDocument(doc.uri).contexts, false);
		}
	}
	private def documentClosed(doc: DocumentOverlay) {
		inlayHints.documentClosed(doc.uri);
		invalidateQueries();
		if (reloadProjectFile(doc)) return;
		parserDiagnostics.close(doc);
		if (semanticDiagnostics != null) semanticDiagnostics.schedule(projects.forDocument(doc.uri).contexts, false);
	}
	// Reloads the configuration of a local project file buffer, which has
	// configuration diagnostics instead. Returns false for other documents.
	private def reloadProjectFile(doc: DocumentOverlay) -> bool {
		if (!isProjectFile(doc)) return false;
		projects.load(DocumentUri.filePath(doc.uri));
		projects.refresh();
		if (semanticDiagnostics != null) {
			semanticDiagnostics.configChanged();
			semanticDiagnostics.schedule([], false);
		}
		return true;
	}
	// Disk changes are debounced like edits, so that a burst of file events
	// (a checkout, say) analyzes each project once.
	private def scheduleWatched(contexts: Array<ProjectContext>) {
		invalidateQueries();
		inlayHints.scopesChanged();
		if (semanticDiagnostics != null) semanticDiagnostics.schedule(contexts, true);
	}
	// An event that can change the sources or the project of a completion's
	// or a signature help's analysis makes it stale and forgets its last reply.
	private def invalidateQueries() {
		completion.invalidate();
		signatureHelp.invalidate();
	}
	private def isProjectFile(doc: DocumentOverlay) -> bool {
		var path = DocumentUri.filePath(doc.uri);
		return path != null && Strings.endsWith(path, "/.virgil-lsp.json");
	}
	private def projectInfo(msg: string) {
		if (infoProject != null) infoProject(msg);
	}
	private def analysisInfo(msg: string) {
		if (infoAnalysis != null) infoAnalysis(msg);
	}
	private def publishNotification(payload: Array<byte>) {
		if (sendNotification != null) sendNotification(payload);
	}
	private def projectWarning(reason: string) {
		if (warnProject != null) warnProject(reason);
	}
	private def ignoredDocumentSync(reason: string) {
		if (warnDocumentSync != null) warnDocumentSync(reason);
	}
	private def capacityExceeded(message: string) {
		var params = Strings.newMap<JsonValue>();
		params["type"] = JsonValue.Int(2); // MessageType.Warning
		params["message"] = JsonValue.String(message);
		documentWarning = JsonRpcMessage.Notification("window/showMessage", JsonRpcParams.ByName(params)).encode();
	}
	// Decodes and handles one payload. Returns a reply or server-notification
	// payload, or null if there is nothing to send.
	def handle(payload: Array<byte>) -> Array<byte> {
		if (state == LspServerState.EXITED) return null;
		var input = JsonRpcDecoder.decode(payload);
		match (input) {
			Valid(msg, unsupportedNumbers) => {
				match (msg) {
					x: JsonRpcMessage.Request => {
						var error = admit(x.method);
						if (error != null) return JsonRpcMessage.ErrorResponse(x.id, error).encode();
					}
					x: JsonRpcMessage.Notification => {
						// Handled here, not by the dispatcher, so that params it
						// can't read don't stop the process from exiting.
						if (Strings.equal(x.method, "exit")) {
							exit("received exit before a shutdown request");
							return null;
						}
						if (state != LspServerState.RUNNING) return null;
						if (unsupportedNumbers) documentSync.unsupportedNumbers(x);
					}
					_ => ;
				}
			}
			_ => ;
		}
		var reply = dispatcher.dispatch(input);
		reparseDocuments();
		// A synchronization notification has no reply. Capacity rejection instead
		// sends a server notification, without inventing a JSON-RPC response id.
		if (documentWarning != null) {
			var warning = documentWarning;
			documentWarning = null;
			return warning;
		}
		return reply;
	}
	// Returns true once the session has ended, so no more input is handled.
	def exited() -> bool {
		return state == LspServerState.EXITED;
	}
	// Handles the end of the input, which ends the session as exit does. Does
	// nothing if it has already ended.
	def close() {
		if (state != LspServerState.EXITED) exit("the input ended before a shutdown request");
	}
	// Returns the error for a request with {method} in the current state, or
	// null if it may be dispatched.
	private def admit(method: string) -> JsonRpcError {
		var initialize = Strings.equal(method, "initialize");
		match (state) {
			UNINITIALIZED => {
				if (!initialize) {
					return JsonRpcError.new(LspErrorCode.SERVER_NOT_INITIALIZED, "the server is not initialized");
				}
			}
			RUNNING => {
				if (initialize) {
					return JsonRpcError.new(JsonRpcErrorCode.INVALID_REQUEST, "the server is already initialized");
				}
			}
			SHUTTING_DOWN => {
				return JsonRpcError.new(JsonRpcErrorCode.INVALID_REQUEST, "the server is shutting down");
			}
			EXITED => ;
		}
		return null;
	}
	private def initialize(request: JsonRpcMessage.Request) -> JsonRpcReply {
		if (!JsonRpcParams.ByName.?(request.params)) {
			return JsonRpcReply.Error(JsonRpcError.new(JsonRpcErrorCode.INVALID_PARAMS, "initialize params must be an object"));
		}
		var params = JsonRpcParams.ByName.!(request.params).v;
		projects.initialize(params);
		inlayHints.configure(member(params, "initializationOptions"),
			member(member(member(params, "capabilities"), "workspace"), "inlayHint"));
		var watched = member(member(member(params, "capabilities"), "workspace"), "didChangeWatchedFiles");
		workspaceEvents.dynamicWatchers = watched != null && watched["dynamicRegistration"] == JsonValue.Bool(true);
		var textDocument = member(member(params, "capabilities"), "textDocument");
		hover.markdown = acceptsMarkdown(member(textDocument, "hover"));
		var parameterInformation = member(member(member(textDocument, "signatureHelp"), "signatureInformation"), "parameterInformation");
		signatureHelp.labelOffsets = parameterInformation != null
			&& parameterInformation["labelOffsetSupport"] == JsonValue.Bool(true);
		var documentSymbol = member(textDocument, "documentSymbol");
		documentSymbols.hierarchy = documentSymbol != null
			&& documentSymbol["hierarchicalDocumentSymbolSupport"] == JsonValue.Bool(true);
		documentSymbols.clientKinds = LspSymbolKind.symbols(member(documentSymbol, "symbolKind"));
		var workspaceSymbol = member(member(member(params, "capabilities"), "workspace"), "symbol");
		workspaceSymbols.clientKinds = LspSymbolKind.symbols(member(workspaceSymbol, "symbolKind"));
		completion.clientKinds = LspSymbolKind.completions(member(member(textDocument, "completion"), "completionItemKind"));
		var workspaceEdit = member(member(member(params, "capabilities"), "workspace"), "workspaceEdit");
		rename.documentChanges = workspaceEdit != null && workspaceEdit["documentChanges"] == JsonValue.Bool(true);
		var renaming = member(textDocument, "rename");
		var prepareSupport = renaming != null && renaming["prepareSupport"] == JsonValue.Bool(true);
		state = LspServerState.RUNNING;
		var serverInfo = Strings.newMap<JsonValue>();
		serverInfo["name"] = JsonValue.String(BuildInfo.NAME);
		serverInfo["version"] = JsonValue.String(BuildInfo.VERSION);
		var result = Strings.newMap<JsonValue>();
		// Advertise only implemented and tested handlers.
		var save = Strings.newMap<JsonValue>();
		save["includeText"] = JsonValue.Bool(false);
		var sync = Strings.newMap<JsonValue>();
		sync["openClose"] = JsonValue.Bool(true);
		sync["change"] = JsonValue.Int(1); // TextDocumentSyncKind.Full
		sync["save"] = JsonValue.JObject(save);
		var capabilities = Strings.newMap<JsonValue>();
		capabilities["textDocumentSync"] = JsonValue.JObject(sync);
		// "." asks for the receiver's members (docs/architecture.md#member-completion).
		var completionOptions = Strings.newMap<JsonValue>();
		completionOptions["triggerCharacters"] = JsonValue.JArray([JsonValue.String(".")]);
		capabilities["completionProvider"] = JsonValue.JObject(completionOptions);
		capabilities["documentSymbolProvider"] = JsonValue.Bool(true);
		capabilities["definitionProvider"] = JsonValue.Bool(true);
		capabilities["typeDefinitionProvider"] = JsonValue.Bool(true);
		capabilities["inlayHintProvider"] = JsonValue.Bool(true);
		capabilities["hoverProvider"] = JsonValue.Bool(true);
		capabilities["workspaceSymbolProvider"] = JsonValue.Bool(true);
		capabilities["referencesProvider"] = JsonValue.Bool(true);
		capabilities["documentHighlightProvider"] = JsonValue.Bool(true);
		// RenameOptions may only be sent to a client that declares
		// textDocument.rename.prepareSupport; others get true, and need no
		// prepareRename.
		if (prepareSupport) {
			var renameOptions = Strings.newMap<JsonValue>();
			renameOptions["prepareProvider"] = JsonValue.Bool(true);
			capabilities["renameProvider"] = JsonValue.JObject(renameOptions);
		} else {
			capabilities["renameProvider"] = JsonValue.Bool(true);
		}
		var signature = Strings.newMap<JsonValue>();
		signature["triggerCharacters"] = JsonValue.JArray([JsonValue.String("("), JsonValue.String(",")]);
		signature["retriggerCharacters"] = JsonValue.JArray([JsonValue.String(")")]);
		capabilities["signatureHelpProvider"] = JsonValue.JObject(signature);
		var folders = Strings.newMap<JsonValue>();
		folders["supported"] = JsonValue.Bool(true);
		folders["changeNotifications"] = JsonValue.Bool(true);
		var workspace = Strings.newMap<JsonValue>();
		workspace["workspaceFolders"] = JsonValue.JObject(folders);
		capabilities["workspace"] = JsonValue.JObject(workspace);
		result["capabilities"] = JsonValue.JObject(capabilities);
		result["serverInfo"] = JsonValue.JObject(serverInfo);
		return JsonRpcReply.Result(JsonValue.JObject(result));
	}
	// The object member {key} of {obj}, or null.
	private def member(obj: HashMap<string, JsonValue>, key: string) -> HashMap<string, JsonValue> {
		if (obj == null || !JsonValue.JObject.?(obj[key])) return null;
		return JsonValue.JObject.!(obj[key]).v;
	}
	// False only if the hover client capabilities {hover} list content
	// formats, but not markdown.
	private def acceptsMarkdown(hover: HashMap<string, JsonValue>) -> bool {
		if (hover == null || !JsonValue.JArray.?(hover["contentFormat"])) return true;
		for (format in JsonValue.JArray.!(hover["contentFormat"]).v) {
			if (JsonValue.String.?(format) && Strings.equal(JsonValue.String.!(format).v, "markdown")) return true;
		}
		return false;
	}
	private def cancel(n: JsonRpcMessage.Notification) {
		rename.cancel(n);
		completion.cancel(n);
		signatureHelp.cancel(n);
		snapshotRequests.cancel(n);
	}
	// The client's first notification after initialize.
	private def initialized(n: JsonRpcMessage.Notification) {
		var request = workspaceEvents.initialized(dispatcher.pending);
		if (request != null) publishNotification(request);
	}
	private def shutdown(request: JsonRpcMessage.Request) -> JsonRpcReply {
		state = LspServerState.SHUTTING_DOWN;
		failPending("the server is shutting down");
		return JsonRpcReply.Result(JsonValue.Null);
	}
	// Ends the session. {reason} explains a nonzero exit status.
	private def exit(reason: string) {
		if (state == LspServerState.SHUTTING_DOWN) {
			exitStatus = 0;
		} else {
			exitStatus = 1;
			failure = reason;
		}
		state = LspServerState.EXITED;
		failPending("the server exited");
	}
	// Cancels incoming analysis, the requests waiting for it, and outstanding
	// server-to-client requests.
	private def failPending(msg: string) {
		inlayHints.close();
		if (semanticDiagnostics != null) semanticDiagnostics.close();
		if (developmentAnalysis != null) developmentAnalysis.close(msg);
		snapshotRequests.close(msg);
		rename.close(msg);
		completion.close();
		signatureHelp.close();
		dispatcher.pending.failAll(JsonRpcError.new(LspErrorCode.REQUEST_CANCELLED, msg));
	}
}
