// textDocument/hover from the display text of a current snapshot, which
// LspSnapshotRequests selects as for a definition. See
// docs/architecture.md#hover.
class LspHover {
	// False if the client's textDocument.hover.contentFormat omits markdown.
	var markdown = true;

	// The Hover of what contains {offset}, if anything does: an occurrence,
	// with its declaration's signature and its use-site type; otherwise a
	// declaration's name, with its signature; otherwise a builtin use, with
	// its type. A declaration's leading comment follows. Null if there is no
	// text to show, or if an occurrence's target is in a file whose bytes are
	// no longer the ones analyzed, as for a definition; a declaration's name
	// and a builtin use are in the request's own file, which is checked
	// already.
	def answer(at: LspSnapshotPosition, offset: int) -> (bool, JsonValue) {
		var s = at.snapshot, path = at.path();
		var o = s.occurrenceAtOffset(path, offset);
		if (o != null) {
			var target = at.target(o.declaration.range.path), r = o.declaration.range;
			if (target.0 < 0 || !at.maps(target.0, r.beginOffset, r.endOffset)) return (true, JsonValue.Null);
			return (true, hover(at, o.range, o.declaration.signature, o.useType, target.0, target.1, o.declaration));
		}
		var d = s.declarationAtOffset(path, offset);
		if (d != null) return (true, hover(at, d.range, d.signature, null, at.index, at.text, d));
		var b = s.builtinUseAtOffset(path, offset);
		if (b != null) return (true, hover(at, b.range, b.useType, null, -1, null, null));
		return (false, JsonValue.Null);
	}
	// The Hover of {first} and {second}, and of the leading comment of {d}, if
	// not null, in the snapshot's file {j}, whose analyzed text is {text}.
	private def hover(at: LspSnapshotPosition, range: AnalysisRange, first: string, second: string,
			j: int, text: Array<byte>, d: AnalysisDeclaration) -> JsonValue {
		if (first == null) {
			first = second;
			second = null;
		}
		if (first == null) return JsonValue.Null;
		var texts = if(second != null, [first, second], [first]);
		var value = render(texts), doc = if(d != null, documentation(at, j, text, d));
		if (doc != null) value = Strings.format2("%s\n\n%s", value, if(markdown, LspDocumentation.prose(doc), doc));
		var contents = Strings.newMap<JsonValue>(), result = Strings.newMap<JsonValue>();
		contents["kind"] = JsonValue.String(if(markdown, "markdown", "plaintext"));
		contents["value"] = JsonValue.String(value);
		result["contents"] = JsonValue.JObject(contents);
		result["range"] = at.range(at.map, range.beginOffset, range.endOffset);
		return JsonValue.JObject(result);
	}
	// The leading comment of {d}, which the analysis recorded, from the
	// analyzed text {text} of the snapshot's file {j}, or null. A
	// substituted file's effective text holds cached bytes, not the current
	// ones, so it documents nothing.
	private def documentation(at: LspSnapshotPosition, j: int, text: Array<byte>, d: AnalysisDeclaration) -> string {
		if (at.snapshot.documentVersions[j].substitution != null || !AnalysisDocumentedDeclaration.?(d)) return null;
		var c = AnalysisDocumentedDeclaration.!(d);
		return DeclarationComments.text(text, c.commentBegin, c.commentEnd);
	}
	// The MarkupContent value of {texts}: in Markdown, each in its own fenced
	// code block with the info string "virgil", and otherwise one per line.
	// Each fence is a run of backquotes longer than any in its text, and at
	// least three, so no text can close its block (CommonMark 0.31, 4.5).
	def render(texts: Array<string>) -> string {
		var buf = StringBuilder.new();
		for (i < texts.length) {
			var text = texts[i];
			if (i > 0) buf.putc('\n');
			if (!markdown) {
				buf.puts(text);
				continue;
			}
			var longest = 0, run = 0;
			for (c in text) {
				run = if(c == '`', run + 1, 0);
				if (run > longest) longest = run;
			}
			var fence = if(longest < 3, 3, longest + 1);
			for (j < fence) buf.putc('`');
			buf.puts("virgil\n").puts(text).putc('\n');
			for (j < fence) buf.putc('`');
		}
		return buf.toString();
	}
}

// A declaration's leading comment as documentation, which hover and
// completionItem/resolve show (docs/architecture.md#hover).
component LspDocumentation {
	// {doc}, a comment's lines, as Markdown that shows them as prose. Each
	// line loses its indentation, which could make it a code block, and ends
	// with a hard line break if the next line has text, so that lines such as
	// a list's stay apart; an empty line separates paragraphs. A backslash
	// escapes each character that could open HTML, an autolink, a link or an
	// image, a code span or a fence, emphasis, an entity, a table, or
	// strikethrough, and the first character of a line, or an ordered list's
	// delimiter, that could make the line a heading, a quote, a list item, or
	// a thematic break (CommonMark 0.31, 2.4). No text can reach the code
	// blocks that hover puts before it.
	def prose(doc: string) -> string {
		var buf = StringBuilder.new(), i = 0, first = true, previous = false;
		while (i < doc.length) {
			var end = i;
			while (end < doc.length && doc[end] != '\n') end++;
			while (i < end && (doc[i] == ' ' || doc[i] == '\t')) i++;
			if (!first) buf.puts(if(previous && i < end, "  \n", "\n"));
			first = false;
			previous = i < end;
			var digits = i;
			while (digits < end && digits - i < 9 && doc[digits] >= '0' && doc[digits] <= '9') digits++;
			for (k = i; k < end; k++) {
				var c = doc[k];
				if (escaped(c, k == i) || (k == digits && k > i && (c == '.' || c == ')'))
					|| (c == '\\' && (k + 1 == end || punctuation(doc[k + 1])))) buf.putc('\\');
				buf.putc(c);
			}
			i = end + 1;
		}
		return buf.toString();
	}
	private def escaped(c: byte, lineStart: bool) -> bool {
		match (c) {
			'`', '*', '_', '[', ']', '<', '&', '~', '|' => return true;
			'#', '>', '-', '+', '=' => return lineStart;
			_ => return false;
		}
	}
	// Whether {c} is ASCII punctuation, which a backslash escapes.
	private def punctuation(c: byte) -> bool {
		return (c >= '!' && c <= '/') || (c >= ':' && c <= '@') || (c >= '[' && c <= '`') || (c >= '{' && c <= '~');
	}
}
