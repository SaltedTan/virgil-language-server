// The sources of one stdio submission, captured together with their
// provenance, which the completed snapshot keeps. Disk inputs' stamps also
// record their length and a 64-bit FNV-1a hash, so that text read again to
// convert ranges can be checked against what the worker analyzed (see
// {LspAnalysisCapture.analyzedText}). Submitters drop {sources} once the
// worker request holds a copy.
class LspAnalysisInputs(versions: Array<AnalysisDocumentVersion>, snapshotBytes: long) {
	var sources: Array<AnalysisSource>;
}

// Captures whole-program inputs for the development request and automatic
// project analysis. Open overlays win; otherwise the file is read from disk
// within the remaining source budget, through ProjectFiles for project
// submissions (which rejects symlinks).
component LspAnalysisCapture {
	// Aggregate paths, source bytes, and a conservative metadata allowance.
	def MAX_SOURCE_BYTES = 4 * 1024 * 1024;

	// Whether {versions} were captured from {sources}' canonical URIs, in
	// count and order. It compares the URIs that expansion formed, so it
	// converts no path.
	def matchesSources(versions: Array<AnalysisDocumentVersion>, sources: Array<ProjectSource>) -> bool {
		if (versions.length != sources.length) return false;
		for (i < versions.length) {
			var key = sources[i].uri;
			if (key == null || !equal(key, versions[i].uri)) return false;
		}
		return true;
	}
	// Strings.equal, eight bytes at a time, since a program's URIs can total
	// 12 MiB. A word is one load, as in AnalysisTables.sipHash; nothing
	// allocates, so neither array can move, between taking their addresses
	// and loading.
	private def equal(a: string, b: string) -> bool {
		if (a == b) return true;
		if (a == null || b == null || a.length != b.length) return false;
		var end = a.length - (a.length & 7), pa = Pointer.atContents(a), pb = Pointer.atContents(b);
		for (i = 0; i < end; i += 8) {
			if ((pa + i).load<u64>() != (pb + i).load<u64>()) return false;
		}
		for (i = end; i < a.length; i++) {
			if (a[i] != b[i]) return false;
		}
		return true;
	}

	// Returns the inputs for canonical document URIs {keys}, or null and the
	// reason they cannot be captured.
	def capture(store: DocumentStore, keys: Array<string>, project: bool) -> (LspAnalysisInputs, string) {
		var sources = Array<AnalysisSource>.new(keys.length);
		var versions = Array<AnalysisDocumentVersion>.new(keys.length);
		// Conservative metadata allowance, then the snapshot's exact path and
		// document-version charges (AnalysisSnapshot.retainedBytes).
		var bytes = 32L, snapshotBytes = 1024L;
		for (i < keys.length) {
			var path = DocumentUri.filePath(keys[i]);
			if (path == null) path = keys[i];
			bytes += long.view(path.length) + 16;
			snapshotBytes += 272L + path.length + keys[i].length;
			if (bytes > MAX_SOURCE_BYTES) return (null, "analysis sources exceed the analysis size budget");
			var budget = int.view(MAX_SOURCE_BYTES - bytes);
			// Capture is synchronous: this is the overlay readBounded uses.
			var doc = store.overlay(keys[i]);
			var text = if(project && doc == null, ProjectFiles.load(path, budget), store.readBounded(keys[i], budget));
			if (text == null) return (null, Strings.format1("cannot read document within the analysis size budget: %s", keys[i]));
			bytes += text.length;
			sources[i] = AnalysisSource.new(path, text);
			var v = versions[i] = AnalysisDocumentVersion.new(keys[i], if(doc != null, doc.version, 0), if(doc != null, doc.identity));
			if (doc == null) {
				v.disk = store.diskStamp(keys[i]);
				v.length = text.length;
				v.hash = hash(text);
			}
		}
		var inputs = LspAnalysisInputs.new(versions, snapshotBytes);
		inputs.sources = sources;
		return (inputs, null);
	}
	// 64-bit FNV-1a.
	def hash(text: Array<byte>) -> u64 {
		var h = 0xcbf29ce484222325ul;
		for (b in text) h = (h ^ b) * 0x100000001b3ul;
		return h;
	}
	// The text that produced source {i} of {snapshot} (see
	// AnalysisSnapshot.documentIndex), or null if it is not available: the
	// overlay if the analyzed identity is still open, or the disk file if
	// it still has the captured length and hash. The file is read again within
	// that length, without following symlinks. Null for an index out of range,
	// so for an unrecorded URI too. Only that source is checked; the caller
	// decides whether the rest of the snapshot is current.
	def analyzedText(store: DocumentStore, snapshot: AnalysisSnapshot, i: int) -> Array<byte> {
		if (i < 0 || i >= snapshot.documentVersions.length) return null;
		var v = snapshot.documentVersions[i];
		if (v.identity != null) {
			var doc = store.overlay(v.uri);
			return if(doc != null && doc.identity == v.identity, doc.text);
		}
		var path = DocumentUri.filePath(v.uri);
		var text = if(path != null && v.length >= 0, ProjectFiles.load(path, v.length));
		return if(text != null && text.length == v.length && hash(text) == v.hash, text);
	}
}
