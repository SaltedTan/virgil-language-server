// The declarations of one completion list's source-backed items, which
// completionItem/resolve documents (LspCompletionResolve), kept without the
// list's analysis: the list's id, its request document's URI, and its
// project's revision and definition; each file that declares an
// item, as its source was captured for the analysis (AnalysisDocumentVersion,
// which holds no text), with the hash of its analyzed text; and for each
// item, its label, its file, its declaration's name offset in that file's
// analyzed text, and the span of its declaration's leading comment there,
// which the analysis recorded (AnalysisDocumentedDeclaration), or -1 for
// none. No snapshot, syntax tree, or source text is kept. {bytes} is what
// the list is charged, which never exceeds {maxBytes}.
class LspCompletionDeclarations(id: int, uri: string, config: ProjectRevision, definition: ProjectDefinition,
		maxBytes: int) {
	def files = Vector<AnalysisDocumentVersion>.new();
	// The 64-bit FNV-1a hash of each file's analyzed text: the one its stamp
	// recorded for a file closed then, or that of the open text analyzed.
	def hashes = Vector<u64>.new();
	def labels = Vector<string>.new();
	def sources = Vector<int>.new();
	def begins = Vector<int>.new();
	def commentBegins = Vector<int>.new();
	def commentEnds = Vector<int>.new();
	var bytes = LspResolveLimits.LIST_BYTES + uri.length;
	// An item did not fit, so no later item is added.
	var full: bool;

	// The fingerprint of item {item} (LspItemFingerprint).
	def fingerprint(item: int) -> int {
		return LspItemFingerprint.of(hashes[sources[item]], begins[item], labels[item]);
	}
}

// The fingerprint of a completion item's declaration, the last integer of
// its data (LspCompletionResolve): the 64-bit FNV-1a hash of the 8 bytes of
// the hash of its declaring file's analyzed text, the 4 bytes of its name's
// offset in that text, and its label's bytes, folded to a non-negative
// 31-bit integer, since a JsonValue integer has 32 bits. It depends on no
// URI, process, or time, so a list's data is the same in every server. Two
// items whose fingerprints are equal read their comments from the same bytes
// at the same offset, unless their files' 64-bit hashes or the 31-bit
// fingerprints collide, about one chance in two billion for two different
// declarations.
component LspItemFingerprint {
	def of(hash: u64, offset: int, label: string) -> int {
		var h = 0xcbf29ce484222325ul, o = u32.view(offset);
		for (k < 8) h = (h ^ byte.view(hash >> byte.view(8 * k))) * 0x100000001b3ul;
		for (k < 4) h = (h ^ byte.view(o >> byte.view(8 * k))) * 0x100000001b3ul;
		for (b in label) h = (h ^ b) * 0x100000001b3ul;
		return int.view(u32.view(h ^ (h >> 32)) & 0x7FFFFFFF);
	}
}

// Adds the source-backed items of a list to its declarations, in the list's
// order, while its reply is built: from the declarations of the list's
// snapshot, whose files are the analysis's {versions}, in order; an open
// file's analyzed text is its overlay in {store}. Neither the snapshot nor
// {versions} is kept. Source {excluded}, the request's own
// document when its analyzed text was repaired at the cursor, documents
// nothing, and neither does a source whose analysis used substituted text:
// their offsets aren't those of their current text.
class LspCompletionItems(store: DocumentStore, list: LspCompletionDeclarations, snapshot: AnalysisSnapshot,
		versions: Array<AnalysisDocumentVersion>, excluded: int) {
	// Each source's index in the list's files plus one, or 0 before an item
	// from it is added.
	private def slots = Array<int>.new(if(versions != null, versions.length));
	private var lastPath: string;
	private var lastSource = -1;

	// The data of the item {label}, which completes the declaration {d}, or
	// Null: if {d} is null, as for "this", a builtin type, or a builtin
	// member, if it can have no documentation, as a local can't
	// (DeclarationComments.documents), if its source can't document it, or if
	// it would take the list past its byte cap, which also leaves every later
	// item without data. The data is the list's id, the item's index in it,
	// and its fingerprint.
	def add(d: AnalysisDeclaration, label: string) -> JsonValue {
		if (d == null || label == null || list.full || !DeclarationComments.documents(d.kind)
			|| d.range.beginOffset < 0) return JsonValue.Null;
		var i = source(d.range.path);
		if (i < 0 || i == excluded || versions[i].substitution != null) return JsonValue.Null;
		var v = versions[i], slot = slots[i] - 1, cost = LspResolveLimits.ITEM_BYTES + label.length, hash = v.hash;
		if (slot < 0) {
			cost += LspResolveLimits.FILE_BYTES + v.uri.length;
			if (v.identity != null) {
				// The overlay analyzed is still open while the reply is built.
				var text = LspAnalysisCapture.versionText(store, v);
				if (text == null) return JsonValue.Null;
				hash = LspAnalysisCapture.hash(text);
			}
		}
		if (list.bytes + cost > list.maxBytes) {
			list.full = true;
			return JsonValue.Null;
		}
		if (slot < 0) {
			slot = list.files.length;
			list.files.put(v);
			list.hashes.put(hash);
			slots[i] = slot + 1;
		}
		list.bytes += cost;
		var item = list.labels.length;
		list.labels.put(label);
		list.sources.put(slot);
		list.begins.put(d.range.beginOffset);
		var c = if(AnalysisDocumentedDeclaration.?(d), AnalysisDocumentedDeclaration.!(d));
		list.commentBegins.put(if(c != null, c.commentBegin, -1));
		list.commentEnds.put(if(c != null, c.commentEnd, -1));
		return JsonValue.JArray([JsonValue.Int(list.id), JsonValue.Int(item), JsonValue.Int(list.fingerprint(item))]);
	}
	// The index of the first of the snapshot's files at {path}, which is its
	// source's index in {versions}, or -1. A declaration's path is the very
	// string of the snapshot's paths that the decoder gave it, so the scan
	// compares references first.
	private def source(path: string) -> int {
		if (path == lastPath) return lastSource;
		var paths = snapshot.paths, k = -1;
		for (j < paths.length) {
			if (paths[j] == path) {
				k = j;
				break;
			}
		}
		if (k < 0 && path != null) {
			for (j < paths.length) {
				if (Strings.equal(paths[j], path)) {
					k = j;
					break;
				}
			}
		}
		if (versions == null || k >= versions.length) k = -1;
		lastPath = path;
		lastSource = k;
		return k;
	}
}

// The bytes that the declarations of a completion list are charged
// (LspCompletionDeclarations).
component LspResolveLimits {
	// The most, which holds the declarations of
	// AnalysisScopeOrder.MAX_DECLARATIONS items in a project of a few hundred
	// files.
	def MAX_BYTES = 128 * 1024;
	// A list's charge for itself, besides its request URI's bytes; for each
	// file, besides its URI's bytes; and for each item, besides its label's
	// bytes. They cover the objects, the vectors' slots, and their spare
	// capacity; a file's include its text's hash.
	def LIST_BYTES = 256;
	def FILE_BYTES = 176;
	def ITEM_BYTES = 64;
}

// completionItem/resolve: an item of the latest completion list with names
// gets the leading comment of its declaration as its documentation, as hover
// reads and renders it (DeclarationComments.text, LspDocumentation), from
// the span that the list's analysis recorded. Every other member of the
// item is returned as the client sent it. Only that list's declarations are
// kept (LspCompletionDeclarations),
// for at most AnalysisScopeOrder.MAX_DECLARATIONS items and {maxBytes} bytes;
// a newer list with names replaces them, and a change of the projects or the
// close of the list's request document drops them, but an edit doesn't: each
// item is documented only while its own file has the text the list was made
// from. An item's data, the list's id, its index, and its fingerprint,
// selects its declaration: nothing else the client sends is read, and it is
// checked against the server's own record before any file is read. Since
// list ids start again in each server, the fingerprint keeps an item kept
// from an older server from matching another declaration at its id and
// index. See docs/architecture.md#item-documentation.
class LspCompletionResolve(store: DocumentStore, projects: WorkspaceProjects) {
	// Tests may lower it.
	var maxBytes = LspResolveLimits.MAX_BYTES;
	// False if the client's
	// textDocument.completion.completionItem.documentationFormat lists
	// formats, but not markdown.
	var markdown = true;
	// The declarations of the latest list with names, or null.
	var latest: LspCompletionDeclarations;
	// The id of the next list. The lists of one server have distinct ids.
	private var nextId = 1;

	// The declarations of a new list for {r}, whose analysis completed, empty.
	def start(r: LspQueryRequest) -> LspCompletionDeclarations {
		return LspCompletionDeclarations.new(nextId++, r.uri, r.context.config, r.context.definition, maxBytes);
	}
	def keep(list: LspCompletionDeclarations) {
		latest = list;
	}
	// The projects changed, as a configuration change, a file event that
	// expands their sources again, or a workspace folder change does.
	def forget() {
		latest = null;
	}
	// The document {uri} was closed; the list goes if it is its request
	// document's.
	def closed(uri: string) {
		if (latest != null && Strings.equal(latest.uri, uri)) latest = null;
	}
	// The item in {request}'s params, with its documentation if its data
	// selects a declaration of the latest list that still has a comment; as
	// sent otherwise, as for an item without data, with an unknown list or
	// item, a label or fingerprint other than the item's, or a stale list or
	// file. Params that are not an object with a string label, or whose data
	// is neither absent, null, nor an array of three non-negative integers,
	// get InvalidParams.
	def resolve(request: JsonRpcMessage.Request) -> JsonRpcReply {
		var params = if(JsonRpcParams.ByName.?(request.params), JsonRpcParams.ByName.!(request.params).v);
		if (params == null || !params.has("label") || !JsonValue.String.?(params["label"])) return invalid();
		var item = JsonValue.JObject(params);
		if (!params.has("data") || params["data"] == JsonValue.Null) return JsonRpcReply.Result(item);
		var data = if(JsonValue.JArray.?(params["data"]), JsonValue.JArray.!(params["data"]).v);
		if (data == null || data.length != 3) return invalid();
		for (n in data) {
			if (!JsonValue.Int.?(n) || JsonValue.Int.!(n).v < 0) return invalid();
		}
		var doc = documentation(JsonValue.Int.!(data[0]).v, JsonValue.Int.!(data[1]).v, JsonValue.Int.!(data[2]).v,
			JsonValue.String.!(params["label"]).v);
		if (doc != JsonValue.Null) params["documentation"] = doc;
		return JsonRpcReply.Result(item);
	}
	private def invalid() -> JsonRpcReply {
		return JsonRpcReply.Error(JsonRpcError.new(JsonRpcErrorCode.INVALID_PARAMS,
			"completion item resolve params require a string label, and data only as a completion reply gave it"));
	}
	// The MarkupContent of the comment of item {item} of list {id}, if it is
	// the latest list, its request document is still in the same current
	// project, the item is {label} with {fingerprint}, its file's text is
	// still the one analyzed ({analyzed}), and its declaration has a comment
	// there, which the analysis recorded; otherwise Null. An item without
	// one reads no file. Edits since the list, to the request document or
	// another, matter only for the items declared in the file they changed.
	private def documentation(id: int, item: int, fingerprint: int, label: string) -> JsonValue {
		var list = latest;
		if (list == null || list.id != id || item >= list.labels.length || !Strings.equal(list.labels[item], label)
			|| list.fingerprint(item) != fingerprint) return JsonValue.Null;
		var ctx = projects.forDocument(list.uri).active;
		if (ctx == null || ctx.config != list.config || ctx.definition != list.definition || !ctx.config.current) {
			return JsonValue.Null;
		}
		var begin = list.commentBegins[item];
		if (begin < 0) return JsonValue.Null;
		var text = analyzed(list.files[list.sources[item]]);
		if (text == null) return JsonValue.Null;
		var doc = DeclarationComments.text(text, begin, list.commentEnds[item]);
		if (doc == null) return JsonValue.Null;
		var content = Strings.newMap<JsonValue>();
		content["kind"] = JsonValue.String(if(markdown, "markdown", "plaintext"));
		content["value"] = JsonValue.String(if(markdown, LspDocumentation.prose(doc), doc));
		return JsonValue.JObject(content);
	}
	// The text of {v}'s file if it is still the text the list's analysis
	// read, or null: as LspAnalysisCapture.versionText checks it, and, for a
	// file that was closed then but is open now, with the open text, which
	// must have the captured length and hash. An offset is never mapped
	// across an edit.
	private def analyzed(v: AnalysisDocumentVersion) -> Array<byte> {
		var doc = if(v.identity == null, store.overlay(v.uri));
		if (doc == null) return LspAnalysisCapture.versionText(store, v);
		var text = doc.text;
		return if(text.length == v.length && LspAnalysisCapture.hash(text) == v.hash, text);
	}
}
