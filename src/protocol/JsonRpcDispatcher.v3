// The result or the error of a response: what a request handler returns, and
// what completes a request the server sent.
type JsonRpcReply {
	case Result(v: JsonValue);
	case Error(error: JsonRpcError);
}

// Routes decoded messages to handlers by method name and returns the reply
// payload, if any. It does no I/O; the caller frames and writes the reply.
//
// - A request gets exactly one response with its original ID: the handler's
//   result or error, or MethodNotFound if no handler is registered. A deferred
//   handler owns sending its response exactly once through its injected sink.
// - A notification never gets a response. Unknown notifications are ignored.
// - An invalid payload gets a ParseError or InvalidRequest error response.
// - A response from the client completes the server request it answers in
//   {pending}, and is never answered. A response that completes nothing is
//   reported to the ignored-response handler, if there is one.
class JsonRpcDispatcher {
	private def requestHandlers = Strings.newMap<JsonRpcMessage.Request -> JsonRpcReply>();
	private def deferredHandlers = Strings.newMap<JsonRpcMessage.Request -> void>();
	private def notificationHandlers = Strings.newMap<JsonRpcMessage.Notification -> void>();
	private var ignoredResponseHandler: string -> void;
	// The requests the server has sent to the client. Send them with
	// {pending.send}, so that their responses are matched.
	def pending = JsonRpcPendingRequests.new();

	def onRequest(method: string, handler: JsonRpcMessage.Request -> JsonRpcReply) -> this {
		requestHandlers[method] = handler;
	}
	def onDeferredRequest(method: string, handler: JsonRpcMessage.Request -> void) -> this {
		deferredHandlers[method] = handler;
	}
	def onNotification(method: string, handler: JsonRpcMessage.Notification -> void) -> this {
		notificationHandlers[method] = handler;
	}
	// Sets {handler} to receive the reason a response completed no request.
	def onIgnoredResponse(handler: string -> void) -> this {
		ignoredResponseHandler = handler;
	}
	// Decodes and handles one payload. Returns the reply payload, or null if
	// there is nothing to send.
	def handle(payload: Array<byte>) -> Array<byte> {
		return dispatch(JsonRpcDecoder.decode(payload));
	}
	// Handles one decoded payload. Returns the reply payload, or null if there
	// is nothing to send.
	def dispatch(input: JsonRpcInput) -> Array<byte> {
		match (input) {
			Valid(msg, unsupportedNumbers) => {
				match (msg) {
					x: JsonRpcMessage.Request => return answer(x, unsupportedNumbers);
					x: JsonRpcMessage.Notification => notify(x, unsupportedNumbers);
					_ => {
						// A response or an error response.
						var reason = pending.complete(msg, unsupportedNumbers);
						if (reason != null && ignoredResponseHandler != null) ignoredResponseHandler(reason);
					}
				}
				return null;
			}
			Rejected(id, error) => return JsonRpcMessage.ErrorResponse(id, error).encode();
			Dropped => return null;
		}
	}
	private def answer(request: JsonRpcMessage.Request, unsupportedNumbers: bool) -> Array<byte> {
		var handler = requestHandlers[request.method];
		var deferred = deferredHandlers[request.method];
		if (handler == null && deferred == null) {
			return error(request.id, JsonRpcErrorCode.METHOD_NOT_FOUND,
				Strings.format1("method not found: %s", request.method));
		}
		if (unsupportedNumbers) {
			return error(request.id, JsonRpcErrorCode.INVALID_PARAMS,
				"params contain a number that is not a 32-bit integer");
		}
		if (deferred != null) {
			deferred(request);
			return null;
		}
		match (handler(request)) {
			Result(v) => return JsonRpcMessage.Response(request.id, v).encode();
			Error(e) => return JsonRpcMessage.ErrorResponse(request.id, e).encode();
		}
	}
	private def notify(notification: JsonRpcMessage.Notification, unsupportedNumbers: bool) {
		var handler = notificationHandlers[notification.method];
		if (handler != null && !unsupportedNumbers) handler(notification);
	}
	private def error(id: JsonRpcId, code: int, msg: string) -> Array<byte> {
		return JsonRpcMessage.ErrorResponse(id, JsonRpcError.new(code, msg)).encode();
	}
}
