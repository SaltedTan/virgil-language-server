// A method of requests at a document position, such as textDocument/definition,
// and how to answer one. Given a request's parameters, whose document and
// position are valid, {prepare} returns its answer function, or null if its
// other parameters are invalid; {requires} describes the valid parameters in
// errors. Given the request's document in a current snapshot and a byte
// offset in it, the answer function returns whether it found something at the
// offset, and the reply: a result, which may be null, or an error. It keeps
// what it needs of the other parameters, such as a references request's
// context.includeDeclaration, while the request waits.
class LspSnapshotMethod(owner: LspSnapshotRequests, label: string, requires: string,
	prepare: HashMap<string, JsonValue> -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply)) {
	var anchor = LspSnapshotAnchor.POSITION;
	var failure: string -> JsonRpcReply;
	def handle(request: JsonRpcMessage.Request) {
		owner.receive(this, request);
	}
}
// Where a request names its document and position: textDocument and
// position; textDocument and range.start, where the answer function gets the
// current-text offset and maps it itself; or a type hierarchy item's data,
// whose uri and position may be stale, so that an offset inside an excluded
// body reaches the answer function as -1 rather than failing the request.
// Only a position is looked up again at the byte before.
enum LspSnapshotAnchor { POSITION, RANGE, ITEM }
// A request's document in a current snapshot, for an answer function: file
// {index} of {snapshot}, whose effective analyzed text is {text}. The position
// map converts current text; ranges pass through the snapshot's mapping first.
// {options} are the compiler options of the project the snapshot analyzed.
class LspSnapshotPosition(store: DocumentStore, snapshot: AnalysisSnapshot, index: int,
		text: Array<byte>, map: PositionMap, options: Array<string>) {
	def path() -> string {
		return snapshot.paths[index];
	}
	// The index of the first of the snapshot's files at {path}, such as the
	// file that declares a use's target, and its analyzed text; or -1 and null
	// if there is no such file or its bytes are no longer the ones the worker
	// analyzed. Stamps alone don't show a closed file changed on disk without
	// a file event. The request's own file was checked already.
	def target(path: string) -> (int, Array<byte>) {
		var j = -1;
		for (k < snapshot.paths.length) { if(j < 0 && Strings.equal(snapshot.paths[k], path)) j = k; }
		if (j < 0) return (-1, null);
		var t = analyzedText(j);
		return (if(t != null, j, -1), t);
	}
	// The analyzed text of the snapshot's file {j}, or null if its bytes are
	// no longer the ones the worker analyzed.
	def analyzedText(j: int) -> Array<byte> {
		return if(j == index, text, LspAnalysisCapture.analyzedText(store, snapshot, j));
	}
	def positionMap(j: int, analyzed: Array<byte>) -> PositionMap {
		return if(j == index, map, PositionMap.new(LspAnalysisCapture.currentText(store, snapshot, j, analyzed), PositionEncoding.UTF16));
	}
	def maps(j: int, begin: int, end: int) -> bool {
		return snapshot.currentRange(j, begin, end).0 >= 0;
	}
	// The snapshot's effective byte range is mapped before {m} converts current
	// text to protocol positions. An excluded range has no Location.
	def location(j: int, m: PositionMap, begin: int, end: int) -> JsonValue {
		var span = snapshot.currentRange(j, begin, end);
		if (span.0 < 0) return JsonValue.Null;
		var location = Strings.newMap<JsonValue>();
		location["uri"] = JsonValue.String(snapshot.documentVersions[j].uri);
		location["range"] = rawRange(m, span.0, span.1);
		return JsonValue.JObject(location);
	}
	// As for {location}, {begin} and {end} are effective-text offsets, while
	// {m} converts current text. An excluded range has no LSP Range.
	def range(m: PositionMap, begin: int, end: int) -> JsonValue {
		return rangeIn(index, m, begin, end);
	}
	// As {range}, in the snapshot's file {j}.
	def rangeIn(j: int, m: PositionMap, begin: int, end: int) -> JsonValue {
		var span = snapshot.currentRange(j, begin, end);
		return if(span.0 >= 0, rawRange(m, span.0, span.1), JsonValue.Null);
	}
	// As {rangeIn}, but for a declaration's whole extent, which can enclose an
	// excluded body: each end maps on its own. An end inside the body has no
	// LSP Range.
	def extentIn(j: int, m: PositionMap, begin: int, end: int) -> JsonValue {
		var b = snapshot.currentRange(j, begin, begin).0, e = snapshot.currentRange(j, end, end).0;
		return if(b >= 0 && e >= 0, rawRange(m, b, e), JsonValue.Null);
	}
	private def rawRange(m: PositionMap, begin: int, end: int) -> JsonValue {
		var range = Strings.newMap<JsonValue>();
		range["start"] = position(m.offsetToPosition(begin));
		range["end"] = position(m.offsetToPosition(end));
		return JsonValue.JObject(range);
	}
	private def position(p: LspPosition) -> JsonValue {
		var obj = Strings.newMap<JsonValue>();
		obj["line"] = JsonValue.Int(p.line);
		obj["character"] = JsonValue.Int(p.character);
		return JsonValue.JObject(obj);
	}
}
// A request waiting for an analysis, with its answer function, {lookup}, where
// its reply goes, and the state of its document when it arrived: the identity
// of the open overlay, or null and the disk stamp. None retains the
// document's text.
class LspSnapshotRequest(lookup: (LspSnapshotPosition, int) -> (bool, JsonRpcReply),
	failure: string -> JsonRpcReply, deliver: JsonRpcReply -> void, id: JsonRpcId, uri: string,
	line: int, character: int, identity: DocumentVersionIdentity, disk: DocumentVersionIdentity) {
	var answered: bool;
	var anchor: LspSnapshotAnchor;
}
// The requests waiting for one pending analysis, in arrival order. It is that
// analysis's listener (LspSemanticDiagnostics.whenAnalyzed), so a context has
// at most two: for its waiting and its running analysis.
class LspSnapshotWaiters(owner: LspSnapshotRequests) {
	def requests = Vector<LspSnapshotRequest>.new();
	var fired: bool;	// the analysis has ended
	// Called once the analysis completes, fails, or is dropped.
	def analyzed() {
		fired = true;
		owner.answer(this);
	}
}

// Requests at a document position, answered from the retained snapshot of the
// document's active project context. Every reply goes through {send}, unless
// a submitter takes it (see {submit}): a request against a missing or stale
// snapshot waits for the context's pending analysis. Each method supplies its
// answer function, how to prepare it from other parameters, and an optional
// failure reply. See docs/architecture.md#definition for the shared rules;
// each method owns its lookup policy, including whether the byte before the
// position is eligible.
class LspSnapshotRequests(store: DocumentStore, projects: WorkspaceProjects, send: Array<byte> -> void) {
	// Bounds the requests of every method that wait at once. A client rarely
	// has more than a few outstanding; past this many, the oldest, the one most
	// likely superseded, is answered through its method's failure policy.
	def MAX_WAITING = 256;
	private def NULL = JsonRpcReply.Result(JsonValue.Null);
	// Returns the listener of a context's pending analysis, registering the
	// candidate if it has none, or null if none is pending
	// (LspSemanticDiagnostics.whenAnalyzed). Without it, a missing or stale
	// snapshot is answered through the method's failure policy at once.
	var whenAnalyzed: (ProjectContext, LspSnapshotWaiters) -> LspSnapshotWaiters;
	// Every waiting request in arrival order, after some answered ones, which
	// {compact} removes.
	private var arrivals = Vector<LspSnapshotRequest>.new();
	private var oldest: int;	// the requests before this index are answered
	private var waitingCount: int;
	// The waiters whose analysis has not ended.
	private var batches = Vector<LspSnapshotWaiters>.new();

	// Handles {method}, whose requests have only a document and a position,
	// with {answer}, which returns whether it found something and the result.
	// {label} names it in parameter errors.
	def register(dispatcher: JsonRpcDispatcher, method: string, label: string,
			answer: (LspSnapshotPosition, int) -> (bool, JsonValue)) {
		registerPrepared(dispatcher, method, label, POSITION, always(answer, _));
	}
	// The method that {register} would register, for a handler that answers
	// some of its requests otherwise and gives the rest to its {handle}, as
	// signature help does (LspSignatureHelp).
	def unregistered(label: string, answer: (LspSnapshotPosition, int) -> (bool, JsonValue)) -> LspSnapshotMethod {
		return LspSnapshotMethod.new(this, label, POSITION, always(answer, _));
	}
	private def POSITION = "a valid textDocument.uri and position";
	// Handles {method}, whose requests also have other parameters, with the
	// answer function that {prepare} returns for each (see LspSnapshotMethod).
	def registerPrepared(dispatcher: JsonRpcDispatcher, method: string, label: string, requires: string,
			prepare: HashMap<string, JsonValue> -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply)) {
		dispatcher.onDeferredRequest(method, LspSnapshotMethod.new(this, label, requires, prepare).handle);
	}
	def registerRange(dispatcher: JsonRpcDispatcher, method: string, label: string,
			prepare: HashMap<string, JsonValue> -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply),
			failure: string -> JsonRpcReply) {
		var handler = LspSnapshotMethod.new(this, label, "a valid textDocument.uri and range", prepare);
		handler.anchor = LspSnapshotAnchor.RANGE;
		handler.failure = failure;
		dispatcher.onDeferredRequest(method, handler.handle);
	}
	// Handles {method}, whose requests name a type hierarchy item, with the
	// answer function that {prepare} returns for each. The item's data.uri and
	// data.position stand for a request's document and position.
	def registerItem(dispatcher: JsonRpcDispatcher, method: string, label: string, requires: string,
			prepare: HashMap<string, JsonValue> -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply)) {
		var handler = LspSnapshotMethod.new(this, label, requires, prepare);
		handler.anchor = LspSnapshotAnchor.ITEM;
		dispatcher.onDeferredRequest(method, handler.handle);
	}
	private def always(answer: (LspSnapshotPosition, int) -> (bool, JsonValue),
			params: HashMap<string, JsonValue>) -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply) {
		return succeed(answer, _, _);
	}
	private def succeed(answer: (LspSnapshotPosition, int) -> (bool, JsonValue),
			at: LspSnapshotPosition, offset: int) -> (bool, JsonRpcReply) {
		var found = answer(at, offset);
		return (found.0, JsonRpcReply.Result(found.1));
	}
	// The number of requests waiting.
	def waiting() -> int {
		return waitingCount;
	}
	// The number of request records held, answered or not, for tests.
	def recorded() -> int {
		var n = arrivals.length;
		for (i < batches.length) n += batches[i].requests.length;
		return n;
	}
	// Answers every waiting request with RequestCancelled and {reason}. All
	// are marked answered first, so a listener notified from within a reply
	// finds none left to answer.
	def close(reason: string) {
		var error = JsonRpcError.new(LspErrorCode.REQUEST_CANCELLED, reason);
		var cancelled = Vector<LspSnapshotRequest>.new();
		for (i = oldest; i < arrivals.length; i++) {
			var r = arrivals[i];
			if (r.answered) continue;
			r.answered = true;
			cancelled.put(r);
		}
		arrivals.clear();
		oldest = waitingCount = 0;
		batches.clear();
		for (i < cancelled.length) reply(cancelled[i].deliver, cancelled[i].id, JsonRpcReply.Error(error));
	}
	// Cancels only requests we answer ourselves. A submitter with a reply
	// sink, such as rename, owns its cancellation and withdraws its request.
	def cancel(n: JsonRpcMessage.Notification) {
		if (!JsonRpcParams.ByName.?(n.params)) return;
		var params = JsonRpcParams.ByName.!(n.params).v, id: JsonRpcId;
		if (!params.has("id")) return;
		match (params["id"]) {
			Int(v) => id = JsonRpcId.Int(v);
			String(v) => id = JsonRpcId.String(v);
			_ => return;
		}
		// MAX_WAITING bounds the live requests, and compact bounds the
		// answered records kept beside them. Scan rather than hashing
		// client-controlled ids with the library's predictable string hash.
		for (i = oldest; i < arrivals.length; i++) {
			var r = arrivals[i];
			if (r.answered || r.deliver != null || !r.id.equal(id)) continue;
			finish(r, JsonRpcReply.Error(JsonRpcError.new(LspErrorCode.REQUEST_CANCELLED, "the request was cancelled")));
			compact();
			return;
		}
	}
	// Answers or defers {request} for {method}.
	def receive(method: LspSnapshotMethod, request: JsonRpcMessage.Request) {
		submitAt(request, method.label, method.requires, method.prepare, method.failure, null, method.anchor);
	}
	// Answers or defers {request}, as a registered method with {label},
	// {requires}, {prepare}, and {failure} would be,
	// but gives its reply to {deliver}, if not null, instead of sending it.
	// Rename does, since its answer needs a further analysis before a reply.
	// Returns the deferred request, which {withdraw} drops, or null if it was
	// answered.
	def submit(request: JsonRpcMessage.Request, label: string, requires: string,
			prepare: HashMap<string, JsonValue> -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply),
			failure: string -> JsonRpcReply, deliver: JsonRpcReply -> void) -> LspSnapshotRequest {
		return submitAt(request, label, requires, prepare, failure, deliver, LspSnapshotAnchor.POSITION);
	}
	private def submitAt(request: JsonRpcMessage.Request, label: string, requires: string,
			prepare: HashMap<string, JsonValue> -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply),
			failure: string -> JsonRpcReply, deliver: JsonRpcReply -> void, anchor: LspSnapshotAnchor) -> LspSnapshotRequest {
		var params = if(JsonRpcParams.ByName.?(request.params), JsonRpcParams.ByName.!(request.params).v);
		var doc = objectMember(params, "textDocument"), position: HashMap<string, JsonValue>;
		match (anchor) {
			POSITION => position = objectMember(params, "position");
			RANGE => position = objectMember(objectMember(params, "range"), "start");
			ITEM => {
				doc = objectMember(objectMember(params, "item"), "data");
				position = objectMember(doc, "position");
			}
		}
		var uri = if(doc != null && doc.has("uri") && JsonValue.String.?(doc["uri"]), JsonValue.String.!(doc["uri"]).v);
		var key = if(uri != null, DocumentUri.normalize(uri));
		var line = intMember(position, "line"), character = intMember(position, "character");
		var lookup = if(key != null && line >= 0 && character >= 0, prepare(params));
		if (lookup == null) {
			var error = JsonRpcError.new(JsonRpcErrorCode.INVALID_PARAMS,
				Strings.format2("%s params require %s", label, requires));
			reply(deliver, request.id, JsonRpcReply.Error(error));
			return null;
		}
		var ctx = projects.forDocument(key).active;
		if (ctx == null || whenAnalyzed == null || (ctx.snapshot != null && current(ctx, ctx.snapshot))) {
			reply(deliver, request.id, locate(lookup, failure, ctx, key, line, character, anchor));
			return null;
		}
		// Join the waiters of the analysis this request waits for.
		var candidate = LspSnapshotWaiters.new(this);
		var waiters = whenAnalyzed(ctx, candidate);
		if (waiters == null) {
			reply(deliver, request.id, locate(lookup, failure, ctx, key, line, character, anchor));
			return null;
		}
		if (waiters == candidate && !waiters.fired) batches.put(waiters);
		// Take the oldest waiting request's slot before answering it, so that
		// a request sent from within that reply cannot exceed the bound.
		var evicted = if(waitingCount >= MAX_WAITING, takeOldest());
		var overlay = store.overlay(key);
		var r = LspSnapshotRequest.new(lookup, failure, deliver, request.id, key, line, character,
			if(overlay != null, overlay.identity), if(overlay == null, store.diskStamp(key)));
		r.anchor = anchor;
		waiters.requests.put(r);
		arrivals.put(r);
		waitingCount++;
		if (evicted != null) reply(evicted.deliver, evicted.id, reject(evicted.failure, "too many requests are waiting"));
		// The analysis ended before the request joined, if it could not start.
		if (waiters.fired) answer(waiters);
		compact();
		return if(r.answered, null, r);
	}
	// Drops {r}, deferred by {submit}, without answering it, as a rename that
	// its submitter answered on cancellation is. Its record goes at once, with
	// the answer function and reply sink that keep the request's parameters.
	def withdraw(r: LspSnapshotRequest) {
		if (r == null || r.answered) return;
		r.answered = true;
		waitingCount--;
		purge();
	}
	// Answers the requests of {waiters} once their analysis has ended. Each is
	// answered from the snapshot of its document's active context now, which
	// a configuration change may have made another context, without waiting
	// again.
	def answer(waiters: LspSnapshotWaiters) {
		var rest = Vector<LspSnapshotWaiters>.new();
		for (i < batches.length) { if(batches[i] != waiters) rest.put(batches[i]); }
		batches = rest;
		var active = Strings.newMap<ProjectContext>(), requests = waiters.requests;
		for (i < requests.length) {
			var r = requests[i];
			if (r.answered) continue;
			if (!active.has(r.uri)) active[r.uri] = projects.forDocument(r.uri).active;
			// The position refers to the text the request was made against.
			var doc = store.overlay(r.uri);
			var same = if(doc != null, doc.identity == r.identity, r.identity == null && store.diskStamp(r.uri) == r.disk);
			finish(r, if(same, locate(r.lookup, r.failure, active[r.uri], r.uri, r.line, r.character, r.anchor),
				reject(r.failure, if(r.failure != null, "the document changed while the rename request waited", "the document changed"))));
		}
		compact();
	}
	// Marks the oldest waiting request answered, without replying, and returns it.
	private def takeOldest() -> LspSnapshotRequest {
		while (oldest < arrivals.length && arrivals[oldest].answered) oldest++;
		if (oldest >= arrivals.length) return null;
		var r = arrivals[oldest];
		r.answered = true;
		waitingCount--;
		return r;
	}
	// Marks {r} answered before replying, so a request sent from within the
	// reply sees the slot free.
	private def finish(r: LspSnapshotRequest, result: JsonRpcReply) {
		r.answered = true;
		waitingCount--;
		reply(r.deliver, r.id, result);
	}
	// Drops answered requests once they are more than half of those recorded,
	// so that each request is copied a bounded number of times.
	private def compact() {
		while (oldest < arrivals.length && arrivals[oldest].answered) oldest++;
		if (arrivals.length - waitingCount <= arrivals.length / 2) return;
		purge();
	}
	// Drops every answered request's record.
	private def purge() {
		var rest = Vector<LspSnapshotRequest>.new();
		for (i = oldest; i < arrivals.length; i++) { if(!arrivals[i].answered) rest.put(arrivals[i]); }
		arrivals = rest;
		oldest = 0;
		for (i < batches.length) {
			var requests = batches[i].requests, kept = Vector<LspSnapshotRequest>.new();
			for (j < requests.length) { if(!requests[j].answered) kept.put(requests[j]); }
			requests.clear();
			requests.puta(kept.extract());
		}
	}
	// Gives {result} to {deliver}, or sends it as the response to {id}.
	private def reply(deliver: JsonRpcReply -> void, id: JsonRpcId, result: JsonRpcReply) {
		if (deliver != null) deliver(result);
		else respond(id, result);
	}
	private def respond(id: JsonRpcId, reply: JsonRpcReply) {
		match (reply) {
			Result(v) => send(JsonRpcMessage.Response(id, v).encode());
			Error(e) => send(JsonRpcMessage.ErrorResponse(id, e).encode());
		}
	}
	// The snapshot is current if its project revision is current, it analyzed
	// the context's current source list, and every source matches its stamp:
	// an edit to any file can change what an unchanged identifier binds to.
	// Rename checks it again before it replies.
	def current(ctx: ProjectContext, s: AnalysisSnapshot) -> bool {
		var versions = s.documentVersions;
		if (!s.matchesProject() || !LspAnalysisCapture.matchesSources(versions, ctx.sources)) return false;
		for (v in versions) if (!v.matchesDocument(store)) return false;
		return true;
	}
	// The reply of {lookup} at {line}:{character} in
	// {key}, from {ctx}'s current snapshot, or {failure}'s reply with the
	// reason it cannot be answered. Without a failure, that reply is null.
	private def locate(lookup: (LspSnapshotPosition, int) -> (bool, JsonRpcReply),
			failure: string -> JsonRpcReply, ctx: ProjectContext, key: string, line: int,
			character: int, anchor: LspSnapshotAnchor) -> JsonRpcReply {
		var s = if(ctx != null, ctx.snapshot);
		if (ctx == null) return reject(failure, "the document is not in a loaded project");
		if (s == null) return reject(failure, "the document's project has not been analyzed");
		if (!current(ctx, s)) return reject(failure, "the project's analysis is stale; it does not describe the current sources");
		if (!s.parsed) return reject(failure, "the project's analysis has parse errors");
		if (!s.hasOccurrences) return reject(failure, "the project's analysis has no occurrences");
		var i = s.documentIndex(key);
		if (i < 0) return reject(failure, "the document is not part of the project's analysis");
		var text = LspAnalysisCapture.analyzedText(store, s, i);
		if (text == null) return reject(failure, "the analyzed text of the document is no longer available");
		var currentText = LspAnalysisCapture.currentText(store, s, i, text);
		var map = PositionMap.new(currentText, PositionEncoding.UTF16), currentOffset = map.positionToOffset(line, character);
		// Ranges filter their mapped results in current-text coordinates; their
		// start may itself lie in an excluded method body.
		var offset = if(anchor == LspSnapshotAnchor.RANGE, currentOffset, s.effectiveOffset(i, currentOffset));
		if (offset < 0 && anchor == LspSnapshotAnchor.POSITION) {
			return reject(failure, "the position is inside a method body excluded from the analysis");
		}
		var at = LspSnapshotPosition.new(store, s, i, text, map, ctx.definition.compilerArgs), found = lookup(at, offset);
		// A cursor just past an identifier selects it. Something found at
		// offset - 1 but not at {offset} ends exactly at {offset}, so only the
		// identifier the cursor touches qualifies, and whatever contains
		// {offset} always wins.
		if (anchor == LspSnapshotAnchor.POSITION && !found.0 && currentOffset > 0) {
			var before = s.effectiveOffset(i, currentOffset - 1);
			if (before >= 0) found = lookup(at, before);
		}
		return if(found.0, found.1,
			reject(failure, "there is no renameable name at this position (an operator, literal, comment, or whitespace)"));
	}
	// {failure}'s reply for {reason}, or null if the method has no failure.
	private def reject(failure: string -> JsonRpcReply, reason: string) -> JsonRpcReply {
		return if(failure != null, failure(reason), NULL);
	}
	private def objectMember(obj: HashMap<string, JsonValue>, key: string) -> HashMap<string, JsonValue> {
		if (obj == null || !obj.has(key) || !JsonValue.JObject.?(obj[key])) return null;
		return JsonValue.JObject.!(obj[key]).v;
	}
	// The integer member {key} of {obj}, or -1.
	private def intMember(obj: HashMap<string, JsonValue>, key: string) -> int {
		if (obj == null || !obj.has(key) || !JsonValue.Int.?(obj[key])) return -1;
		return JsonValue.Int.!(obj[key]).v;
	}
}
