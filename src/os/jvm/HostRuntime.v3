// The JVM target's version of src/os/x86-64-linux/HostRuntime.v3. The JVM has
// no stack pointer or semispace heap, so some members only approximate the
// native ones; see each. Commands reach src/os/jvm/V3S_System.java as
// src/os/jvm/HostOs.v3 describes.
component HostRuntime {
	// A Java program can read its stack only as a count of frames, and
	// Thread.getStackTrace() caps that count at 1,024, so the marks are
	// virtual positions: minus the current thread's frame depth times
	// STACK_SCALE. The parser compares two marks, which gives the frames that
	// parsing used, and its existing STACK_LIMIT of 1 MiB then stops a parse
	// at STACK_LIMIT / STACK_SCALE = 512 frames of recursion, or earlier when
	// a parse starts deep: stackFree() returns the headroom below the 1,024-
	// frame cap, so a parse that starts too deep leaves too little headroom to
	// measure and the guard fires early (failing closed) rather than
	// overflowing the thread's stack.
	//
	// stackBase() samples the depth fresh, once, where a parse starts, so
	// each parse measures from its own start rather than a later reading;
	// stackMark() samples every STACK_SAMPLE calls, so a token never triggers
	// a full stack walk on its own. The first mark after a base is therefore
	// up to STACK_SAMPLE tokens late, and the guard's first check sees a depth
	// up to the descent of those tokens: on x86-64 Linux with JDK 25's default
	// 1 MiB thread stack, a fresh deep-bracket parse takes its first
	// measurement at 768 frames (about 124 brackets, six frames per level),
	// where the unguarded parse overflows at about 960 brackets (about
	// 5,800 frames). The margin covers the interpreter's larger frames, which compiled code replaces, and the shipped
	// darwin-arm64 target, which is untested. A parse that reaches the limit
	// reports "nesting too deep" and stops; nothing catches StackOverflowError,
	// and no larger -Xss is needed. The range() recursion the frame guard
	// can't see is bounded separately by chainLimit(); see
	// docs/aeneas-crash-paths.md.
	def STACK_SCALE = 2048;
	// The parser calls stackMark once per token, and reading the frame depth
	// costs about a microsecond per frame, so sample it every this many
	// calls. Between samples the depth can grow by at most one level per
	// token, which the limit's margin above covers.
	def STACK_SAMPLE = 128;
	// The cap on the frames that getStackTrace() reports, which bounds the
	// reading, not the guard: a parse that starts deeper than this leaves too
	// little headroom to measure, so stackFree() returns a small headroom and
	// the guard fires early (failing closed) rather than overflowing.
	def STACK_CAP = 1024;

	private var stackCalls: int;
	private var stackDepth: long;

	// A fresh mark of the current stack position, in virtual bytes, for a
	// parse's base: it samples the depth now, so the parse measures from its
	// own start. The stack grows down, so {base - stackMark()} is the frames
	// used since {base} was taken, times STACK_SCALE.
	def stackBase() -> long {
		stackDepth = frameDepth();
		return -stackDepth * STACK_SCALE;
	}
	// A mark of the current stack position, in virtual bytes. The depth is
	// sampled every STACK_SAMPLE calls, so a token never triggers a full
	// stack walk on its own.
	def stackMark() -> long {
		stackCalls++;
		if (stackCalls % STACK_SAMPLE == 0) stackDepth = frameDepth();
		return -stackDepth * STACK_SCALE;
	}
	// The virtual bytes left below the mark {base}: the headroom below the
	// 1,024-frame cap of getStackTrace(), scaled by STACK_SCALE. A parse that
	// starts deep leaves little headroom to measure, so the parser's limit
	// shrinks to fit it and the guard fires early (failing closed) rather than
	// overflowing the thread's stack. A shallow base leaves the limit at
	// STACK_LIMIT, unchanged.
	def stackFree(base: long) -> long {
		var baseDepth = -base / STACK_SCALE;
		var headroom = STACK_CAP - baseDepth;
		if (headroom < 0) headroom = 0;
		return headroom * STACK_SCALE;
	}
	// The cap on the range() levels that AnalysisChainCounter estimates. The
	// frame guard can't see range()'s recursion, which builds out of sight of
	// the token skips, so this bounds it. On the JVM, the case that matters is a
	// cold server (the first didOpen, with the parse interpreted or only partly
	// compiled): on x86-64 Linux with JDK 25's default 1 MiB thread stack, a
	// chain of 1+ operators then overflows at about 8,000 levels (about 131
	// bytes per level, measured on the default stack with the limit raised). A
	// warmed-up, JIT-compiled server overflows later, and the interpreter
	// (-Xint) in between. 2,048 levels use at most about 268 KiB of the 1 MiB
	// stack, leaving at least a four-fold margin to the cold-start overflow.
	def chainLimit() -> int {
		return 2048;
	}
	// The JVM's maximum heap, Runtime.maxMemory(), which -Xmx sets. It can be
	// somewhat less than -Xmx, as the collector reserves space of its own.
	def heapBytes() -> long {
		return memory().0;
	}
	// System.gc(), which the JVM may treat as a hint.
	def forceGC() {
		System.fileOpen("\x01gc", false);
	}
	// Runtime.totalMemory() - freeMemory(): an approximation of the live heap
	// after forceGC(), which can include garbage the collector kept.
	def heapUsed() -> long {
		return memory().1;
	}
	// The JVM target has no collection counts or allocation totals, so it
	// can't run the benchmark probes; the Makefile refuses BENCH=1 for it.
	def gcCount() -> int {
		return unsupported();
	}
	def allocatedBytes() -> long {
		return unsupported();
	}

	private def frameDepth() -> long {
		var r = System.fileLoad("\x01stack");
		if (r == null || r.length != 9 || r[0] != 0) System.error("HostRuntimeError", "the JVM runtime's stack reply is malformed");
		return long.view(Ref<Layout_u64>.at(r, 1).val);
	}
	private def memory() -> (long, long) {
		var r = System.fileLoad("\x01memory");
		if (r == null || r.length != 17 || r[0] != 0) System.error("HostRuntimeError", "the JVM runtime's memory reply is malformed");
		return (long.view(Ref<Layout_u64>.at(r, 1).val), long.view(Ref<Layout_u64>.at(r, 9).val));
	}
	private def unsupported() -> int {
		System.error("HostRuntimeError", "benchmark probes are not supported on the JVM target");
		return 0;
	}
}
