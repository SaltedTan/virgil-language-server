// Host system calls that Virgil's {System} component lacks: pipes, process
// creation, readiness polling, signals, random words, and file metadata and
// replacement. This is the x86-64 Linux version;
// src/os/x86-64-darwin/HostOs.v3 declares the same members, and the Makefile
// compiles only the file for the target. Failures return a negated errno.
// See docs/decisions/0004-analysis-worker-process.md.
component HostOs {
	def EINTR = -4;
	def ELOOP = -40;
	def EAGAIN = -11;
	def SIGKILL = 9;
	// Bits of a poll descriptor's events and revents.
	def POLLIN = 0x1;
	def POLLOUT = 0x4;
	def POLLERR = 0x8;
	def POLLHUP = 0x10;
	def POLLNVAL = 0x20;
	// Descriptors this component creates are numbered from here, above every
	// descriptor that spawn() assigns in a child.
	def MIN_FD = 10;

	private def SYS_read = 0;
	private def SYS_write = 1;
	private def SYS_open = 2;
	private def SYS_close = 3;
	private def SYS_fstat = 5;
	private def SYS_lstat = 6;
	private def SYS_fsync = 74;
	private def SYS_rename = 82;
	private def SYS_unlink = 87;
	private def SYS_fchmod = 91;
	private def SYS_fchown = 93;
	private def SYS_llistxattr = 195;
	private def SYS_flistxattr = 196;
	private def SYS_getdents64 = 217;
	private def SYS_fstatat = 262;
	private def SYS_openat = 257;
	private def SYS_poll = 7;
	private def SYS_rt_sigaction = 13;
	private def SYS_setitimer = 38;
	private def SYS_access = 21;
	private def SYS_pipe = 22;
	private def SYS_dup2 = 33;
	private def SYS_fork = 57;
	private def SYS_execve = 59;
	private def SYS_exit = 60;
	private def SYS_wait4 = 61;
	private def SYS_kill = 62;
	private def SYS_fcntl = 72;
	private def SYS_readlink = 89;
	private def SYS_getpid = 39;
	private def SYS_getrandom = 318;
	private def SYS_getrusage = 98;
	private def SYS_clock_gettime = 228;
	private def CLOCK_THREAD_CPUTIME_ID = 3;
	private def RUSAGE_THREAD = 1;
	private def F_GETFD = 1;
	private def F_SETFD = 2;
	private def F_GETFL = 3;
	private def F_SETFL = 4;
	private def F_DUPFD_CLOEXEC = 1030;
	private def EBADF = -9;
	private def EOPNOTSUPP = -95;
	private def O_RDWR = 0x2;
	private def O_CREAT = 0x40;
	private def O_EXCL = 0x80;
	private def O_NOCTTY = 0x100;
	private def O_NONBLOCK = 0x800;
	private def O_CLOEXEC = 0x80000;
	private def O_DIRECTORY = 0x10000;
	private def O_NOFOLLOW = 0x20000;
	private def X_OK = 1;
	private def ITIMER_REAL = 0;
	private def SIGPIPE = 13;
	private def SIG_IGN = 1L;
	// Built with the program, so that reading random words allocates nothing.
	private def words = Array<long>.new(2);
	// Built with the program, so the thread CPU time and context-switch
	// readers allocate nothing inside the interval they measure; near the
	// heap limit an allocation can trigger a collection that contaminates it.
	private def threadCpuTime = Array<long>.new(2); // seconds and nanoseconds
	private def threadRusage = Array<long>.new(18); // struct rusage

	// Creates a pipe. Returns its read and write descriptors, both
	// close-on-exec, or a negated errno as the first value.
	def pipe() -> (int, int) {
		var fds = Array<int>.new(2);
		var r = sys(SYS_pipe, Pointer.atContents(fds));
		if (r < 0) return (r, -1);
		var read = moveUp(fds[0]), write = moveUp(fds[1]);
		if (read < 0 || write < 0) {
			if (read >= 0) close(read);
			if (write >= 0) close(write);
			return (if(read < 0, read, write), -1);
		}
		return (read, write);
	}
	// Opens /dev/null for reading, close-on-exec.
	def openNull() -> int {
		var fd = sys(SYS_open, (Pointer.atContents("/dev/null\x00"), O_CLOEXEC, 0));
		return if(fd < 0, fd, moveUp(fd));
	}
	// Source admission must not block opening a FIFO, nor inherit its fd.
	def openRead(path: string) -> int {
		var name = Arrays.concat(path, "\x00");
		return sys(SYS_open, (Pointer.atContents(name), O_NONBLOCK | O_CLOEXEC, 0));
	}
	def setNonblocking(fd: int) -> bool {
		var flags = sys(SYS_fcntl, (fd, F_GETFL, 0));
		return flags >= 0 && sys(SYS_fcntl, (fd, F_SETFL, flags | O_NONBLOCK)) >= 0;
	}
	def close(fd: int) {
		sys(SYS_close, fd);
	}
	// Returns the bytes read, 0 at the end of the input, or a negated errno.
	def read(fd: int, buf: Range<byte>) -> int {
		return sys(SYS_read, (fd, Pointer.atContents(buf), buf.length));
	}
	// Returns the bytes written or a negated errno.
	def write(fd: int, buf: Range<byte>) -> int {
		return sys(SYS_write, (fd, Pointer.atContents(buf), buf.length));
	}
	// Waits for events on {count} poll descriptors in {fds}, two ints each:
	// the descriptor, then events in the low and revents in the high 16 bits.
	def poll(fds: Array<int>, count: int, timeoutMs: int) -> int {
		return sys(SYS_poll, (Pointer.atContents(fds), count, timeoutMs));
	}
	// Returns 0 if {path} (NUL-terminated) names a file this process may execute.
	def checkExecutable(path: Array<byte>) -> int {
		return sys(SYS_access, (Pointer.atContents(path), X_OK));
	}
	// Starts {args[0]} (each NUL-terminated) with an empty environment. In the
	// child, descriptor i becomes {fds[i]} in increasing order of i, so no
	// source may be a smaller i that is already reassigned. Every descriptor
	// this component created is closed by execve. Returns the child's process
	// ID or a negated errno. A child that cannot execute exits with status 127.
	def spawn(args: Array<Array<byte>>, fds: Array<int>) -> int {
		// Allocate before taking addresses: nothing may move until execve.
		var argv = Array<Pointer>.new(args.length + 1), envp = Array<Pointer>.new(1);
		for (i < args.length) argv[i] = Pointer.atContents(args[i]);
		var pid = sys(SYS_fork, ());
		if (pid != 0) return pid;
		for (i < fds.length) {
			if (fds[i] == i) sys(SYS_fcntl, (i, F_SETFD, 0));
			else sys(SYS_dup2, (fds[i], i));
		}
		Linux.syscall(SYS_execve, (argv[0], Pointer.atContents(argv), Pointer.atContents(envp)));
		Linux.syscall(SYS_exit, 127);
		return 0;
	}
	def kill(pid: int, signal: int) -> int {
		return sys(SYS_kill, (pid, signal));
	}
	// Waits for {pid} to exit and stores its wait status in {status[0]}.
	def wait(pid: int, status: Array<int>) -> int {
		while (true) {
			var r = sys(SYS_wait4, (pid, Pointer.atContents(status), 0, Pointer.NULL));
			if (r != EINTR) return r;
		}
		return 0;
	}
	// Ends this process with SIGALRM after {ms} milliseconds, unless called
	// again first; 0 cancels.
	def setAlarm(ms: int) {
		var timer = Array<long>.new(4); // interval and value, each seconds and microseconds
		timer[2] = ms / 1000;
		timer[3] = (ms % 1000) * 1000;
		sys(SYS_setitimer, (ITIMER_REAL, Pointer.atContents(timer), Pointer.NULL));
	}
	// Makes writes to a closed pipe fail with EPIPE instead of ending the process.
	def ignoreSigpipe() {
		var action = Array<long>.new(4); // handler, flags, restorer, mask
		action[0] = SIG_IGN;
		sys(SYS_rt_sigaction, (SIGPIPE, Pointer.atContents(action), Pointer.NULL, 8));
	}
	// Two words from the kernel's random source, or, if it fails, from the
	// time and the process ID.
	def randomWords() -> (u64, u64) {
		if (sys(SYS_getrandom, (Pointer.atContents(words), 16, 0)) == 16) return (u64.view(words[0]), u64.view(words[1]));
		return ((u64.view(System.ticksUs()) << 32) ^ u64.view(System.ticksNs()), u64.view(sys(SYS_getpid, ())));
	}
	// True on this target: thread CPU time and context-switch readings are
	// supported, though individual calls can fail. The darwin HostOs reports
	// false, as macOS has no RUSAGE_THREAD and no simple thread-level equivalent.
	def threadMetricsSupported = true;
	// The current thread's CPU time in microseconds, from
	// clock_gettime(CLOCK_THREAD_CPUTIME_ID), or -1 if the call fails.
	def threadCpuTimeUs() -> long {
		if (sys(SYS_clock_gettime, (CLOCK_THREAD_CPUTIME_ID, Pointer.atContents(threadCpuTime))) != 0) return -1;
		return threadCpuTime[0] * 1000000 + threadCpuTime[1] / 1000;
	}
	// The current thread's voluntary and involuntary context switches, from
	// getrusage(RUSAGE_THREAD), or (-1, -1) if the call fails.
	def threadContextSwitches() -> (long, long) {
		if (sys(SYS_getrusage, (RUSAGE_THREAD, Pointer.atContents(threadRusage))) != 0) return (-1, -1);
		return (threadRusage[16], threadRusage[17]); // ru_nvcsw, ru_nivcsw
	}
	// The resolved absolute path of this process's executable, or null.
	def executablePath() -> string {
		var buf = Array<byte>.new(4096);
		var n = sys(SYS_readlink, (Pointer.atContents("/proc/self/exe\x00"), Pointer.atContents(buf), buf.length));
		if (n <= 0 || n >= buf.length) return null;
		return Arrays.range(buf, 0, n);
	}

	// Directory traversal never follows symlinks, including intermediate components.
	def openDirectoryRoot(absolute: bool) -> int {
		var name = if(absolute, "/\x00", ".\x00");
		return sys(SYS_open, (Pointer.atContents(name), O_CLOEXEC | O_DIRECTORY, 0));
	}
	def openChild(fd: int, name: string, directory: bool) -> int {
		var z = Arrays.concat(name, "\x00");
		return sys(SYS_openat, (fd, Pointer.atContents(z), O_CLOEXEC | O_NONBLOCK | O_NOFOLLOW | if(directory, O_DIRECTORY, 0), 0));
	}
	def fileMetadata(fd: int) -> (int, long) {
		var buf = Array<long>.new(18);
		var result = sys(SYS_fstat, (fd, Pointer.atContents(buf)));
		if (result < 0) return (result, -1L);
		return (int.view(buf[3]) & 0xF000, buf[6]);
	}
	def childMetadata(fd: int, name: string) -> (int, long) {
		var buf = Array<long>.new(18), z = Arrays.concat(name, "\x00");
		var result = sys(SYS_fstatat, (fd, Pointer.atContents(z), Pointer.atContents(buf), 0x100));
		if (result < 0) return (result, -1L);
		return (int.view(buf[3]) & 0xF000, buf[6]);
	}
	def readDirectory(fd: int, buf: Array<byte>) -> int {
		return sys(SYS_getdents64, (fd, Pointer.atContents(buf), buf.length));
	}
	def directoryNameOffset = 19;
	def directoryTypeOffset = 18;
	def directoryRecordOffset = 16;

	// File replacement for format --write (src/workspace/FileReplacement.v3).
	// This target provides descriptor metadata, so the command can replace
	// files safely here; the JVM's HostOs reports false and its name.
	def REPLACES_FILES = true;
	def PLATFORM = "x86-64-linux";
	// Opens {path} for reading and writing without truncating it, blocking,
	// following a symbolic link, or acquiring a controlling terminal.
	def openReadWrite(path: string) -> int {
		var name = Arrays.concat(path, "\x00");
		return openForReplacement(name, O_RDWR | O_NONBLOCK | O_NOFOLLOW | O_NOCTTY | O_CLOEXEC, 0, 0);
	}
	// Creates {path} for reading and writing with access for its owner
	// alone, failing with EEXIST if any entry, even a symbolic link, has the name.
	def createExclusive(path: string) -> int {
		var name = Arrays.concat(path, "\x00");
		return openForReplacement(name, O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0x180, 0);
	}
	private def openForReplacement(name: Array<byte>, flags: int, mode: int, first: int) -> int {
		for (fd = first; fd < 3; fd++) {
			var r = sys(SYS_fcntl, (fd, F_GETFD, 0));
			if (r >= 0) continue;
			if (r != EBADF) return r;
			var guard = sys(SYS_open, (Pointer.atContents("/dev/null\x00"), O_CLOEXEC, 0));
			if (guard < 0) return guard;
			var opened = openForReplacement(name, flags, mode, fd + 1);
			close(guard);
			return opened;
		}
		return sys(SYS_open, (Pointer.atContents(name), flags, mode));
	}
	def syncFile(fd: int) -> int {
		return sys(SYS_fsync, fd);
	}
	// Fills {s} from fstat(2) of {fd}. Returns 0 or a negated errno.
	def status(fd: int, s: FileStatus) -> int {
		var buf = Array<long>.new(18);
		var r = sys(SYS_fstat, (fd, Pointer.atContents(buf)));
		if (r >= 0) fill(buf, s);
		return r;
	}
	// Fills {s} from lstat(2) of {path}, which doesn't follow a final
	// symbolic link. Returns 0 or a negated errno.
	def linkStatus(path: string, s: FileStatus) -> int {
		var buf = Array<long>.new(18), name = Arrays.concat(path, "\x00");
		var r = sys(SYS_lstat, (Pointer.atContents(name), Pointer.atContents(buf)));
		if (r >= 0) fill(buf, s);
		return r;
	}
	// 1 if the file open as {fd} has an extended attribute, which includes
	// a POSIX ACL here, 0 if it has none, or a negated errno.
	def extendedAttributes(fd: int) -> int {
		return attributes(sys(SYS_flistxattr, (fd, Pointer.NULL, 0)));
	}
	// As extendedAttributes, for {path} without following a final symbolic link.
	def linkExtendedAttributes(path: string) -> int {
		var name = Arrays.concat(path, "\x00");
		return attributes(sys(SYS_llistxattr, (Pointer.atContents(name), Pointer.NULL, 0)));
	}
	// Sets the owning group of the file open as {fd}, keeping its owner.
	def setGroup(fd: int, gid: int) -> int {
		return sys(SYS_fchown, (fd, -1, gid));
	}
	// Sets the permission bits, including set-ID and sticky bits, of the file open as {fd}.
	def setMode(fd: int, mode: int) -> int {
		return sys(SYS_fchmod, (fd, mode & 0xFFF));
	}
	def rename(from: string, to: string) -> int {
		var a = Arrays.concat(from, "\x00"), b = Arrays.concat(to, "\x00");
		return sys(SYS_rename, (Pointer.atContents(a), Pointer.atContents(b)));
	}
	def unlink(path: string) -> int {
		var name = Arrays.concat(path, "\x00");
		return sys(SYS_unlink, Pointer.atContents(name));
	}
	// struct stat on x86-64, in 8-byte words: st_mode and st_uid share word
	// 3, and st_gid is the low half of word 4.
	private def fill(buf: Array<long>, s: FileStatus) {
		s.dev = buf[0];
		s.ino = buf[1];
		s.mode = int.view(buf[3]) & 0xFFFF;
		s.uid = int.view(buf[3] >>> 32);
		s.gid = int.view(buf[4]);
		s.size = buf[6];
		s.mtimeSec = buf[11];
		s.mtimeNsec = buf[12];
		s.ctimeSec = buf[13];
		s.ctimeNsec = buf[14];
	}
	// A listxattr(2) result: the size of the names, so 0 if there are none.
	// A file system without extended attributes has none.
	private def attributes(r: int) -> int {
		if (r == EOPNOTSUPP) return 0;
		if (r < 0) return r;
		return if(r > 0, 1, 0);
	}

	// Moves {fd} to a close-on-exec descriptor numbered at least MIN_FD.
	private def moveUp(fd: int) -> int {
		var moved = sys(SYS_fcntl, (fd, F_DUPFD_CLOEXEC, MIN_FD));
		close(fd);
		return moved;
	}
	private def sys<T>(number: int, args: T) -> int {
		return int.view(Linux.syscall(number, args).0);
	}
}
