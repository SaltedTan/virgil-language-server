// Command-line entry point for the {virgil-lsp} executable.
// This file must be the first source passed to the compiler so that
// {VirgilLsp.main} is selected as the program entry point.
component VirgilLsp {
	def STDIN = 0;
	def STDOUT = 1;

	def main(args: Array<string>) -> int {
		if (args.length == 0) return usage(2);
		var cmd = args[0];
		if (Strings.equal(cmd, "--version")) return version();
		if (Strings.equal(cmd, "--help") || Strings.equal(cmd, "-h")) return usage(0);
		if (Strings.equal(cmd, "--stdio")) return stdio(Arrays.range(args, 1, args.length));
		if (Strings.equal(cmd, "parse")) return parse(Arrays.range(args, 1, args.length));
		if (Strings.equal(cmd, "analyze")) return analyze(Arrays.range(args, 1, args.length));
		if (Strings.equal(cmd, "repair")) return repair(Arrays.range(args, 1, args.length));
		Log.error2("unknown argument '%s'; run '%s --help'", cmd, BuildInfo.NAME);
		return 2;
	}
	def usage(code: int) -> int {
		var buf = StringBuilder.new();
		buf.put1("Usage: %s <command>\n\n", BuildInfo.NAME);
		buf.puts("Commands:\n");
		buf.puts("  --stdio [options]  Run the language server over standard input/output.\n");
		buf.puts("    --max-message-bytes=<n>\n");
		buf.put1("                     Skip incoming messages larger than n bytes (default %d).\n", LspFraming.DEFAULT_MAX_PAYLOAD);
		buf.put1("                     n can be at most %d.\n", LspFraming.MAX_SUPPORTED_PAYLOAD);
		buf.puts("  --version          Print the server version and pinned Virgil revision.\n");
		buf.puts("  --help             Print this summary.\n\n");
		buf.puts("Development commands (unstable):\n");
		buf.puts("  --stdio also accepts the worker policy options below.\n");
		buf.puts("  parse <file.v3>... Parse files with Aeneas and print syntax diagnostics.\n");
		buf.puts("  analyze [options] <file.v3>...\n");
		buf.puts("                     Parse and verify the files as one program and print diagnostics.\n");
		buf.puts("    --bindings       Also print each bound use and the declaration it resolves to.\n");
		buf.puts("    --display        Also print signatures, use types, and call sites.\n");
		buf.puts("    --stats          Print timing and compiler global-state counters to stderr.\n");
		buf.puts("    --repeat=<n>     Run the analysis n times and fail if any run differs.\n");
		buf.puts("    --worker-timeout-ms=<n>\n");
		buf.put1("                     Kill an analysis worker after n ms (default %d).\n", AnalysisWorkerLimits.new().timeoutMs);
		buf.puts("    --worker-max-analyses=<n>\n");
		buf.put1("                     Replace the analysis worker after n analyses (default %d).\n", AnalysisWorkerLimits.new().maxAnalyses);
		buf.puts("  repair [options] --cursor=<file.v3>:<offset> <file.v3>...\n");
		buf.puts("                     Repair incomplete code at a byte offset of one of the files in\n");
		buf.puts("                     each way the completion spike tries, analyze each, and report.\n");
		buf.puts("    --cut=line|file  First delete the rest of the cursor's line, or of its file.\n");
		buf.puts("    --runs=<n>       Also time n analyses of the first usable repair and of the\n");
		buf.puts("                     files as given.\n");
		buf.puts("    --worker-timeout-ms=<n>\n");
		buf.puts("                     As for analyze.\n");
		// Usage goes to stderr when invoked incorrectly so that stdout stays clean.
		if (code == 0) System.puts(buf.toString());
		else Log.raw(buf.toString());
		return code;
	}
	def version() -> int {
		var buf = StringBuilder.new();
		buf.put2("%s %s\n", BuildInfo.NAME, BuildInfo.VERSION);
		buf.put1("  source revision: %s\n", BuildInfo.REVISION);
		buf.put1("  virgil revision: %s\n", BuildInfo.VIRGIL_REVISION);
		System.puts(buf.toString());
		return 0;
	}
	def stdio(args: Array<string>) -> int {
		var maxPayload = LspFraming.DEFAULT_MAX_PAYLOAD;
		var limits = AnalysisWorkerLimits.new();
		for (arg in args) {
			if (Strings.startsWith(arg, "--max-message-bytes=")) {
				var start = "--max-message-bytes=".length, p = Ints.parseDecimal(arg, start);
				// Nine digits keep the value within an int.
				if (p.0 != arg.length - start || p.0 > 9 || p.1 < 1) {
					Log.error1("invalid option '%s'", arg);
					return 2;
				}
				// A longer message could run out of heap once it is parsed.
				if (p.1 > LspFraming.MAX_SUPPORTED_PAYLOAD) {
					Log.error2("invalid option '%s': the supported maximum is %d bytes", arg, LspFraming.MAX_SUPPORTED_PAYLOAD);
					return 2;
				}
				maxPayload = p.1;
			} else if (Strings.startsWith(arg, "--worker-timeout-ms=")) {
				if ((limits.timeoutMs = positiveOption(arg, "--worker-timeout-ms=")) < 0) return 2;
			} else if (Strings.startsWith(arg, "--worker-max-analyses=")) {
				if ((limits.maxAnalyses = positiveOption(arg, "--worker-max-analyses=")) < 0) return 2;
			} else {
				Log.error2("unknown option '%s'; run '%s --help'", arg, BuildInfo.NAME);
				return 2;
			}
		}
		HostOs.ignoreSigpipe();
		var supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), limits);
		supervisor.warn = Log.warn;
		supervisor.info = Log.info;
		var server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
		server.documents.withReader(System.fileLoad).withBoundedReader(AnalysisSourceFiles.load);
		server.warnDocumentSync = Log.warn;
		server.warnProject = Log.warn;
		server.infoProject = Log.info;
		server.infoAnalysis = Log.info;
		server.dispatcher.onIgnoredResponse(warnIgnoredResponse);
		var transport = LspTransport.new(server.handle, server.exited, maxPayload, System.write(STDOUT, _), Log.warn);
		server.sendNotification = transport.send;
		var buf = Array<byte>.new(64 * 1024);
		var fds = Array<int>.new(6);
		while (transport.failure == null && !server.exited()) {
			fds[0] = STDIN;
			fds[1] = HostOs.POLLIN;
			var count = 1 + supervisor.pollFds(fds, 2);
			var r = HostOs.poll(fds, count, server.pollTimeout());
			if (r == HostOs.EINTR) continue;
			if (r < 0) {
				Log.error1("poll failed (errno %d)", -r);
				server.close();
				supervisor.close();
				return 1;
			}
			if ((fds[1] >> 16) != 0) {
				var n = HostOs.read(STDIN, buf);
				if (n == HostOs.EINTR || n == HostOs.EAGAIN) continue;
				if (n <= 0) {
					transport.close();
					break;
				}
				if (!transport.receive(buf[0 ..+ n])) break;
			}
			// Even a continuously readable stdin must not starve the deadline.
			server.onPoll();
		}
		// Ends the session if exit wasn't received, so the exit status is known.
		server.close();
		supervisor.close();
		if (transport.failure != null) {
			Log.error(transport.failure);
			return 1;
		}
		if (server.failure != null) Log.error(server.failure);
		return server.exitStatus;
	}
	def warnIgnoredResponse(reason: string) {
		Log.warn(Strings.format1("ignored a response: %s", reason));
	}
	def parse(paths: Array<string>) -> int {
		if (paths.length == 0) return usage(2);
		var failed = false;
		for (path in paths) {
			var input = System.fileLoad(path);
			if (input == null) {
				Log.error1("cannot read file '%s'", path);
				failed = true;
				continue;
			}
			var result = AeneasAdapter.parseFile(path, input, []);
			for (d in result.diagnostics) {
				System.puts(d.toString());
				System.ln();
			}
			if (result.diagnostics.length > 0) failed = true;
			else System.puts(Strings.format2("%s: ok, %d top-level declarations\n", path, result.declarationCount));
		}
		return if(failed, 1, 0);
	}
	def analyze(args: Array<string>) -> int {
		var bindings = false, display = false, stats = false, repeat = 1;
		var limits = AnalysisWorkerLimits.new();
		var paths = Vector<string>.new();
		for (arg in args) {
			if (Strings.equal(arg, "--bindings")) bindings = true;
			else if (Strings.equal(arg, "--display")) display = true;
			else if (Strings.equal(arg, "--stats")) stats = true;
			else if (Strings.startsWith(arg, "--repeat=")) {
				if ((repeat = positiveOption(arg, "--repeat=")) < 0) return 2;
			} else if (Strings.startsWith(arg, "--worker-timeout-ms=")) {
				if ((limits.timeoutMs = positiveOption(arg, "--worker-timeout-ms=")) < 0) return 2;
			} else if (Strings.startsWith(arg, "--worker-max-analyses=")) {
				if ((limits.maxAnalyses = positiveOption(arg, "--worker-max-analyses=")) < 0) return 2;
			} else if (Strings.startsWith(arg, "-")) {
				Log.error2("unknown option '%s'; run '%s --help'", arg, BuildInfo.NAME);
				return 2;
			} else {
				paths.put(arg);
			}
		}
		if (paths.length == 0) return usage(2);
		var sources = Array<AnalysisSource>.new(paths.length);
		for (i < paths.length) {
			var input = System.fileLoad(paths[i]);
			if (input == null) {
				Log.error1("cannot read file '%s'", paths[i]);
				return 1;
			}
			sources[i] = AnalysisSource.new(paths[i], input);
		}
		// Parsing and verification run in a worker process; see
		// docs/decisions/0004-analysis-worker-process.md. A write to a worker
		// that has died must fail rather than end this process.
		HostOs.ignoreSigpipe();
		var supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), limits);
		supervisor.warn = Log.warn;
		supervisor.info = Log.info;
		var flags = if(bindings || display, AnalysisWire.WANT_OCCURRENCES) | if(stats, AnalysisWire.WANT_STATS);
		var firstHash: u64, status = 0;
		for (run < repeat) {
			var snapshot: AnalysisSnapshot;
			match (supervisor.analyze(sources, [], flags)) {
				Completed(s) => snapshot = s;
				Pending => {
					Log.error("analysis returned without completing");
					status = 1;
					break;
				}
				Failed(failure, reason) => {
					Log.error2("analysis run %d failed: %s", run + 1, reason);
					status = 1;
					break;
				}
			}
			// Only the first run prints; later runs are compared by hash so
			// that large reports never need to be held in memory.
			var out = AnalysisReport.new(run == 0);
			writeReport(out, snapshot, paths, bindings, display);
			if (stats) logStats(run + 1, snapshot, out.occurrences);
			if (run == 0) {
				firstHash = out.hash;
				if (snapshot.diagnostics.length > 0) status = 1;
			} else if (out.hash != firstHash) {
				Log.error1("analysis run %d differs from run 1", run + 1);
				status = 1;
				break;
			}
		}
		supervisor.close();
		return status;
	}
	// The completion repair spike (LspRepairSpike). Exits with 0 if a repair
	// was usable, 1 if none was, and 2 for invalid arguments.
	def repair(args: Array<string>) -> int {
		var limits = AnalysisWorkerLimits.new();
		var paths = Vector<string>.new();
		var cursorPath: string, cursor = -1, cut: string, runs = 0;
		for (arg in args) {
			if (Strings.startsWith(arg, "--cursor=")) {
				var spec = Arrays.range(arg, "--cursor=".length, arg.length), colon = spec.length - 1;
				while (colon >= 0 && spec[colon] != ':') colon--;
				var p = Ints.parseDecimal(spec, colon + 1);
				if (colon <= 0 || p.0 != spec.length - colon - 1 || p.0 == 0 || p.0 > 9) {
					Log.error1("invalid option '%s'", arg);
					return 2;
				}
				cursorPath = Arrays.range(spec, 0, colon);
				cursor = p.1;
			} else if (Strings.equal(arg, "--cut=line") || Strings.equal(arg, "--cut=file")) {
				cut = Arrays.range(arg, "--cut=".length, arg.length);
			} else if (Strings.startsWith(arg, "--runs=")) {
				if ((runs = positiveOption(arg, "--runs=")) < 0) return 2;
			} else if (Strings.startsWith(arg, "--worker-timeout-ms=")) {
				if ((limits.timeoutMs = positiveOption(arg, "--worker-timeout-ms=")) < 0) return 2;
			} else if (Strings.startsWith(arg, "-")) {
				Log.error2("unknown option '%s'; run '%s --help'", arg, BuildInfo.NAME);
				return 2;
			} else {
				paths.put(arg);
			}
		}
		if (paths.length == 0 || cursorPath == null) return usage(2);
		var original = Array<AnalysisSource>.new(paths.length), index = -1;
		for (i < paths.length) {
			var input = System.fileLoad(paths[i]);
			if (input == null) {
				Log.error1("cannot read file '%s'", paths[i]);
				return 1;
			}
			original[i] = AnalysisSource.new(paths[i], input);
			if (index < 0 && Strings.equal(paths[i], cursorPath)) index = i;
		}
		if (index < 0 || cursor > original[index].input.length) {
			Log.error1("the cursor must be an offset within one of the files: '%s'", cursorPath);
			return 2;
		}
		var sources = Arrays.dup(original);
		if (cut != null) {
			var text = original[index].input, end = text.length;
			if (Strings.equal(cut, "line")) {
				end = cursor;
				while (end < text.length && text[end] != '\n') end++;
			}
			sources[index] = AnalysisSource.new(paths[index], Arrays.concat(Arrays.range(text, 0, cursor), Arrays.range(text, end, text.length)));
		}
		HostOs.ignoreSigpipe();
		var supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), limits);
		supervisor.warn = Log.warn;
		supervisor.info = Log.info;
		var spike = LspRepairSpike.new(supervisor, sources, index, cursor, []);
		var usable = spike.report(writeLine, original, runs);
		supervisor.close();
		return if(usable, 0, 1);
	}
	private def writeLine(buf: StringBuilder) {
		System.puts(buf.toString());
	}
	// Parses the positive decimal value of {arg} after {prefix}. Logs and
	// returns -1 if it is not one.
	def positiveOption(arg: string, prefix: string) -> int {
		var start = prefix.length, p = Ints.parseDecimal(arg, start);
		// Nine digits keep the value within an int.
		if (p.0 != arg.length - start || p.0 > 9 || p.1 < 1) {
			Log.error1("invalid option '%s'", arg);
			return -1;
		}
		return p.1;
	}
	// Writes everything an analysis reports, so that runs can be compared.
	def writeReport(out: AnalysisReport, snapshot: AnalysisSnapshot, paths: Vector<string>, bindings: bool, display: bool) {
		var buf = StringBuilder.new();
		for (d in snapshot.diagnostics) buf.puts(d.toString()).ln();
		if (snapshot.verified) buf.put1("ok: %d files parsed and verified\n", paths.length);
		out.write(buf);
		if (!(bindings || display) || !snapshot.parsed) return;
		for (i < paths.length) {
			var occurrences = snapshot.occurrences(paths[i]);
			if (bindings) for (o in occurrences) buf.puts(o.toString()).ln();
			if (display) writeDisplay(out, buf, snapshot, paths[i], occurrences);
			out.occurrences += occurrences.length;
			out.write(buf);
		}
	}
	// Writes the display text of {path}'s declaration sites, occurrences,
	// builtin uses, and call sites, merged in source order. A call is shown by
	// byte offset, since its record keeps only offsets: its argument list's
	// parenthesis to parenthesis, then each argument's span. Each call's line,
	// which lists its signature's parameters, is written to {out} as it is
	// built, so that no line is ever held whole, however many calls share a
	// long signature.
	def writeDisplay(out: AnalysisReport, buf: StringBuilder, snapshot: AnalysisSnapshot, path: string, occurrences: Array<AnalysisOccurrence>) {
		var sites = snapshot.declarationSites(path), builtins = snapshot.builtinUses(path);
		var calls = snapshot.calls(path);
		var i = 0, j = 0, k = 0, c = 0, end = int.max;
		while (i < sites.length || j < occurrences.length || k < builtins.length || c < calls.length) {
			var s = if(i < sites.length, sites[i].range.beginOffset, end);
			var o = if(j < occurrences.length, occurrences[j].range.beginOffset, end);
			var b = if(k < builtins.length, builtins[k].range.beginOffset, end);
			var a = if(c < calls.length, calls[c].open, end);
			if (s <= o && s <= b && s <= a) {
				var d = sites[i++];
				d.range.render(buf).puts(" declares ").puts(d.kind.name).puts(": ").puts(Strings.nonnull(d.signature)).ln();
			} else if (o <= b && o <= a) {
				var u = occurrences[j++], d = u.declaration;
				u.range.render(buf).puts(" uses ").puts(d.kind.name).puts(": ").puts(Strings.nonnull(d.signature));
				if (u.useType != null) buf.puts("; type: ").puts(u.useType);
				buf.ln();
			} else if (b <= a) {
				var u = builtins[k++];
				u.range.render(buf).puts(" builtin: ").puts(u.useType).ln();
			} else {
				out.write(buf);
				AnalysisCallDisplay.write(out, path, calls[c++]);
			}
		}
	}
	def logStats(run: int, snapshot: AnalysisSnapshot, occurrences: int) {
		var buf = StringBuilder.new(), s = snapshot.stats;
		buf.put1("%s: analysis ", BuildInfo.NAME);
		buf.put3("%d: parse %d us, verify %d us, ", run, s.parseUs, s.verifyUs);
		if (s.collectUs >= 0) buf.put3("%d bindings in %d us, %d skipped, ", occurrences, s.collectUs, s.skippedUses);
		buf.put2("uids +%d (next %d), ", s.uidsUsed, s.uidNext);
		buf.put2("global types +%d (total %d), ", s.globalTypesAdded, s.globalTypeTotal);
		buf.put1("result allocation %d bytes\n", snapshot.resultAllocation);
		Log.raw(buf.toString());
	}
}
