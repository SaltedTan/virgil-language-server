// Diagnostic logging for the server process. Standard output is reserved for
// protocol bytes, so every log line is written to standard error.
component Log {
	def STDERR = 2;
	// The program named at the start of each line. The analysis worker sets its own.
	var program = BuildInfo.NAME;

	def raw(msg: string) {
		System.fileWriteK(STDERR, msg, 0, msg.length);
	}
	def error(msg: string) {
		raw(Strings.format2("%s: error: %s\n", program, msg));
	}
	def error1<A>(fmt: string, a: A) {
		error(Strings.format1(fmt, a));
	}
	def error2<A, B>(fmt: string, a: A, b: B) {
		error(Strings.format2(fmt, a, b));
	}
	def warn(msg: string) {
		raw(Strings.format2("%s: warning: %s\n", program, msg));
	}
	def info(msg: string) {
		raw(Strings.format2("%s: %s\n", program, msg));
	}
}
