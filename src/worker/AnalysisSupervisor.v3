// Why an analysis produced no snapshot.
enum AnalysisFailure {
	UNAVAILABLE,	// startup or handshake failed
	CRASHED,	// the worker ended during analysis
	TIMED_OUT,	// killed at the analysis wall-clock limit
	MALFORMED,	// killed after an invalid result
	TOO_LARGE,	// request exceeded the frame limit; nothing sent
	BUSY		// another analysis is outstanding; nothing changed
}

type AnalysisOutcome {
	case Pending; // only the asynchronous API returns this
	case Completed(snapshot: AnalysisSnapshot);
	case Failed(failure: AnalysisFailure, reason: string);
}

// Defaults measured in docs/decisions/0004-analysis-worker-process.md.
class AnalysisWorkerLimits {
	// Wall clock for one analysis, including writing its request.
	var timeoutMs = 10000;
	// Includes first-start Rosetta translation.
	var startTimeoutMs = 10000;
	var maxAnalyses = 100;
	// Verification fails at 2^29; leave at least 2^28 IDs of headroom.
	var maxUid = 1 << 28;
	// -1 means an eighth of the worker's heap.
	var maxLiveBytes = -1L;
}

// Single-threaded, nonblocking supervisor. begin() admits one analysis;
// pollFds(), pollTimeout(), and onPoll() drive both startup and analysis.
// Only successful replies replace the server-owned snapshot. The CLI uses
// analyze(), a synchronous wrapper around exactly the same state machine.
class AnalysisSupervisor(workerPath: string, limits: AnalysisWorkerLimits) {
	var warn: string -> void;
	var info: string -> void;
	// Last completed analysis, even after failure or cancellation, or null.
	def var snapshot: AnalysisSnapshot;
	def var workersStarted: int;
	private var worker: WorkerProcess;
	private var heapBytes: long;
	private var nextId = 1;
	private var generation: int;
	private var starting: bool;
	private var deadline: int;
	private var request: Range<byte>;
	private var paths: Array<string>;
	private var activeId: int;
	private var pending: bool;

	def busy() -> bool { return pending; }

	// Returns an immediate failure or Pending if accepted. A busy rejection never
	// disturbs the existing request; there is no unbounded analysis queue.
	def begin(sources: Array<AnalysisSource>, flags: int) -> AnalysisOutcome {
		if (pending) return AnalysisOutcome.Failed(AnalysisFailure.BUSY, "an analysis is already running");
		var id = nextId++;
		var size = AnalysisWire.analyzeFrameSize(id, flags, limits.timeoutMs, sources) - WorkerFraming.HEADER_BYTES;
		if (size > WorkerFraming.MAX_PAYLOAD) {
			return AnalysisOutcome.Failed(AnalysisFailure.TOO_LARGE,
				Strings.format2("the request takes %d bytes, more than the limit of %d bytes", size, WorkerFraming.MAX_PAYLOAD));
		}
		if (worker == null) {
			var error: string;
			if (workerPath == null) error = "cannot start the analysis worker: the server's executable path is unknown";
			else {
				var started = WorkerProcesses.start(workerPath);
				worker = started.0;
				if (worker == null) error = Strings.format1("cannot start the analysis worker: %s", started.1);
			}
			if (error != null) {
				log(warn, error);
				return AnalysisOutcome.Failed(AnalysisFailure.UNAVAILABLE, error);
			}
			workersStarted++;
			starting = true;
			deadline = System.ticksMs() + limits.startTimeoutMs;
		}
		activeId = id;
		paths = Array<string>.new(sources.length);
		for (i < paths.length) paths[i] = sources[i].path;
		request = AnalysisWire.encodeAnalyze(id, flags, limits.timeoutMs, sources);
		pending = true;
		if (!starting) sendRequest();
		return AnalysisOutcome.Pending;
	}
	def pollFds(fds: Array<int>, index: int) -> int {
		return if(pending, worker.pollFds(fds, index), 0);
	}
	// -1 means an indefinite wait when idle, otherwise the remaining deadline.
	def pollTimeout() -> int {
		return if(pending, Ints.max(0, deadline - System.ticksMs()), -1);
	}
	// Called after poll (including a timeout). Returns Pending until completed.
	def onPoll() -> AnalysisOutcome {
		if (!pending) return AnalysisOutcome.Pending;
		if (deadline - System.ticksMs() <= 0) {
			if (starting) return discard(AnalysisFailure.UNAVAILABLE, "sent no handshake before the startup deadline");
			return discard(AnalysisFailure.TIMED_OUT,
				Strings.format1("exceeded the analysis time limit of %d ms and was killed", limits.timeoutMs));
		}
		match (worker.onPoll()) {
			Message(payload) => {
				if (starting) {
					var hello = AnalysisWire.decodeHello(payload);
					if (hello == null) return discard(AnalysisFailure.UNAVAILABLE, "sent a malformed handshake");
					if (hello.protocol != AnalysisWire.PROTOCOL_VERSION
						|| !Strings.equal(hello.version, BuildInfo.VERSION)
						|| !Strings.equal(hello.revision, BuildInfo.REVISION)) {
						return discard(AnalysisFailure.UNAVAILABLE, "is from a different build");
					}
					heapBytes = hello.heapBytes;
					starting = false;
					sendRequest();
					return AnalysisOutcome.Pending;
				}
				var result = AnalysisWire.decodeResult(payload, generation + 1, paths);
				if (result == null || result.id != activeId) {
					return discard(AnalysisFailure.MALFORMED, "sent a malformed result and was killed");
				}
				generation++;
				snapshot = result.snapshot;
				clearPending();
				retireIfOverLimit(result.state);
				return AnalysisOutcome.Completed(snapshot);
			}
			Closed(reason) => {
				var what = if(starting, "closed its result pipe before its handshake", "crashed during an analysis");
				if (reason != null) what = Strings.format2("%s: %s", what, reason);
				return discard(if(starting, AnalysisFailure.UNAVAILABLE, AnalysisFailure.CRASHED), what);
			}
			_ => return AnalysisOutcome.Pending;
		}
	}
	// Synchronous development CLI and unit-test client.
	def analyze(sources: Array<AnalysisSource>, flags: int) -> AnalysisOutcome {
		var outcome = begin(sources, flags);
		var fds = Array<int>.new(4);
		while (AnalysisOutcome.Pending.?(outcome)) {
			var count = pollFds(fds, 0);
			var r = HostOs.poll(fds, count, pollTimeout());
			if (r < 0 && r != HostOs.EINTR) {
				return discard(AnalysisFailure.CRASHED, Strings.format1("poll failed (errno %d)", -r));
			}
			outcome = onPoll();
		}
		return outcome;
	}
	// Cancels outstanding work and reaps the process, preserving the snapshot.
	def close() {
		if (worker != null) worker.terminate();
		worker = null;
		starting = false;
		clearPending();
	}
	private def clearPending() {
		pending = false;
		request = null;
		paths = null;
	}
	private def sendRequest() {
		deadline = System.ticksMs() + limits.timeoutMs;
		worker.send(request);
		request = null;
	}
	private def discard(failure: AnalysisFailure, what: string) -> AnalysisOutcome {
		var pid = worker.pid, status = worker.terminate();
		worker = null;
		starting = false;
		clearPending();
		var buf = StringBuilder.new();
		buf.put3("analysis worker %d %s; it ended with %s", pid, what, status);
		if (snapshot != null) buf.put1("; snapshot %d is kept", snapshot.generation);
		log(warn, buf.toString());
		return AnalysisOutcome.Failed(failure, Strings.format2("%s (%s)", describe(failure), status));
	}
	private def describe(failure: AnalysisFailure) -> string {
		match (failure) {
			UNAVAILABLE => return "no analysis worker could be started";
			CRASHED => return "the analysis worker crashed";
			TIMED_OUT => return "the analysis worker timed out";
			MALFORMED => return "the analysis worker sent a malformed result";
			TOO_LARGE => return "the request is too large";
			BUSY => return "an analysis is already running";
		}
	}
	private def retireIfOverLimit(state: AnalysisWorkerState) {
		var maxLive = if(limits.maxLiveBytes >= 0, limits.maxLiveBytes, heapBytes / 8);
		var why: string;
		if (state.analyses >= limits.maxAnalyses) {
			why = Strings.format2("after %d analyses (limit %d)", state.analyses, limits.maxAnalyses);
		} else if (state.uidNext >= limits.maxUid) {
			why = Strings.format2("because its UID counter reached %d (limit %d)", state.uidNext, limits.maxUid);
		} else if (state.liveBytes >= maxLive) {
			why = Strings.format2("because its live heap reached %d bytes (limit %d)", state.liveBytes, maxLive);
		} else return;
		var pid = worker.pid;
		worker.terminate();
		worker = null;
		log(info, Strings.format2("replacing analysis worker %d %s", pid, why));
	}
	private def log(sink: string -> void, msg: string) {
		if (sink != null) sink(msg);
	}
}
