// Compile-time test hook. Ordinary builds remove the hook and its marker.
component WorkerStall {
	def enabled = false;

	def beforeAnalysis(sources: Array<AnalysisSource>) {
		if (enabled) {
			def marker = "workerStallsHere";
			for (source in sources) {
				var input = source.input;
				for (i = 0; i + marker.length <= input.length; i++) {
					var k = 0;
					while (k < marker.length && input[i + k] == marker[k]) k++;
					if (k == marker.length) {
						while (true) HostOs.poll([], 0, -1);
					}
				}
			}
		}
	}
}
