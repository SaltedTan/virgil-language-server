// Entry point of the virgil-lsp-worker executable, which runs whole-program
// analyses for virgil-lsp so that compiler crashes, hangs, and leaks end only
// this process. This file must be the first source passed to the compiler for
// that executable. See docs/decisions/0004-analysis-worker-process.md.
component VirgilLspWorker {
	def NAME = AnalysisWire.WORKER_NAME;

	def main(args: Array<string>) -> int {
		Log.program = NAME;
		if (args.length != 1 || !Strings.equal(args[0], AnalysisWire.WORKER_ARG)) {
			Log.error2("%s is started by %s and is not run directly", NAME, BuildInfo.NAME);
			return 2;
		}
		// Key the analysis tables' hashes before any table exists.
		var key = HostOs.randomWords();
		AnalysisTables.seed(key.0, key.1);
		return AnalysisWorker.new(AnalysisWire.REQUEST_FD, AnalysisWire.RESULT_FD).run();
	}
}

// Serves analysis requests on a worker's pipes until the server closes the
// request pipe. Each request is a fresh Aeneas parse and verify; the worker
// keeps nothing of it but process-wide compiler state.
class AnalysisWorker(requestFd: int, resultFd: int) {
	private def reader = WorkerFrameReader.new(WorkerFraming.MAX_PAYLOAD);
	private var analyses: int;

	// Returns the process exit status.
	def run() -> int {
		var heapBytes = long.!(CiRuntime.HEAP_END - CiRuntime.HEAP_START);
		if (!send(AnalysisWire.encodeHello(BuildInfo.VERSION, BuildInfo.REVISION, heapBytes))) return 1;
		while (true) {
			var payload = receive();
			if (payload == null) {
				if (reader.error != null) return fail(reader.error);
				if (reader.midFrame()) return fail("the request pipe ended in the middle of a message");
				return 0; // the server closed the pipe
			}
			var result = handle(payload);
			payload = null;
			if (result == null) return fail("received a malformed request");
			// Report the heap that stays live between analyses, which is what
			// a retention leak would grow. Exclude the result being sent.
			var gcStart = if(BenchProbe.enabled, BenchProbe.now(), 0);
			RiGc.forceGC();
			if (BenchProbe.enabled) {
				BenchProbe.worker(analyses, "force_gc_us", long.view(BenchProbe.now() - gcStart));
			}
			var liveBytes = Semispace.fromSpaceUsed() - result.data.length;
			if (BenchProbe.enabled) {
				BenchProbe.worker(analyses, "live_after_gc_bytes", liveBytes);
			}
			if (!send(AnalysisWire.finishResult(result, liveBytes))) return 1;
		}
		return 0;
	}
	// Decodes and runs one request. Nothing it allocates but the encoded
	// result stays reachable after it returns.
	private def handle(payload: Array<byte>) -> DataWriter {
		var t0 = if(BenchProbe.enabled, BenchProbe.now(), 0), gc0 = if(BenchProbe.enabled, BenchProbe.gcCount(), 0),
			bytes0 = if(BenchProbe.enabled, BenchProbe.allocated(), 0L);
		var request = AnalysisWire.decodeAnalyze(payload);
		var t1 = if(BenchProbe.enabled, BenchProbe.now(), 0);
		if (request == null) return null;
		analyses++;
		// The server kills a worker at its time limit. If the server has died,
		// this timer still ends a worker caught in a compiler loop.
		var alarm = 2L * request.timeoutMs + 1000;
		HostOs.setAlarm(if(request.timeoutMs <= 0, 0, if(alarm > int.max, int.max, int.view(alarm))));
		var stats = (request.flags & AnalysisWire.WANT_STATS) != 0;
		// Only a completion's or a signature help's analysis keeps its program,
		// for its query.
		var analysis = if(request.scope() != null,
			AeneasAdapter.analyzeForScope(request.sources, request.options, stats),
			AeneasAdapter.analyzeProgram(request.sources, request.options, stats));
		var t2 = if(BenchProbe.enabled, BenchProbe.now(), 0);
		var files: Array<(string, Array<AnalysisOccurrence>)>, collectUs = -1;
		if ((request.flags & AnalysisWire.WANT_OCCURRENCES) != 0) {
			var start = System.ticksUs();
			files = request.occurrences(analysis);
			collectUs = System.ticksUs() - start;
		} else if (request.scope() != null) {
			// The candidates' declarations need the occurrence section, with
			// no files.
			files = [];
		}
		// Only a completion asks for the scope or the members at its cursor;
		// see docs/architecture.md#completion.
		var t3 = if(BenchProbe.enabled, BenchProbe.now(), 0);
		var scope = if(files != null, request.scopeAnswer(analysis));
		var members = if(files != null, request.memberAnswer(analysis));
		// Only a signature help asks for the call at its cursor; see
		// docs/architecture.md#signature-help.
		var call = if(files != null, request.callAnswer(analysis));
		HostOs.setAlarm(0);
		var globalTypes = if(stats, AeneasAdapter.globalTypeCount(), -1);
		var t4 = if(BenchProbe.enabled, BenchProbe.now(), 0);
		var encoded = AnalysisWire.encodeResultWithQuery(request.id, analyses, AeneasAdapter.uidCounter(),
			analysis, collectUs, globalTypes, files, scope, members, call);
		var t5 = if(BenchProbe.enabled, BenchProbe.now(), 0);
		if (BenchProbe.enabled) {
			BenchProbe.worker(analyses, "request_decode_us", long.view(t1 - t0));
			BenchProbe.worker(analyses, "adapter_us", long.view(t2 - t1));
			BenchProbe.worker(analyses, "parse_us", long.view(analysis.stats.parseUs));
			BenchProbe.worker(analyses, "verify_us", long.view(analysis.stats.verifyUs));
			BenchProbe.worker(analyses, "collect_us", long.view(t3 - t2));
			BenchProbe.worker(analyses, "query_us", long.view(t4 - t3));
			BenchProbe.worker(analyses, "result_encode_us", long.view(t5 - t4));
			BenchProbe.worker(analyses, "gc_count", long.view(BenchProbe.gcCount() - gc0));
			BenchProbe.worker(analyses, "allocated_bytes", BenchProbe.allocated() - bytes0);
			BenchProbe.worker(analyses, "heap_after_handle_bytes", BenchProbe.heap());
			BenchProbe.worker(analyses, "result_bytes", long.view(encoded.end()));
		}
		return encoded;
	}
	// Reads the next request payload. Returns null at the end of the input,
	// on a read error, or if the frame was invalid.
	private def receive() -> Array<byte> {
		while (true) {
			var space = reader.space();
			if (space.length == 0) return null;
			var n = HostOs.read(requestFd, space);
			if (n == HostOs.EINTR) continue;
			if (n <= 0) return null;
			var payload = reader.advance(n);
			if (payload != null || reader.error != null) return payload;
		}
		return null;
	}
	private def send(frame: Range<byte>) -> bool {
		while (frame.length > 0) {
			var n = HostOs.write(resultFd, frame);
			if (n == HostOs.EINTR) continue;
			if (n <= 0) {
				fail("cannot write to the server");
				return false;
			}
			frame = frame[n ...];
		}
		return true;
	}
	private def fail(msg: string) -> int {
		Log.error(msg);
		return 1;
	}
}
