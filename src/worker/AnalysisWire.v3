// The messages between the server and an analysis worker, each in one
// WorkerFraming frame. The first payload byte is the message kind. Unless
// noted, integers are signed LEB128, and strings are a length (-1 for null)
// followed by their bytes. Encoders and decoders for both directions live
// here, so that the protocol changes in one place; PROTOCOL_VERSION changes
// with it. See docs/decisions/0004-analysis-worker-process.md.
component AnalysisWire {
	def PROTOCOL_VERSION = 5;
	def MAX_RESULT_ALLOCATION = 16 * 1024 * 1024;
	// The worker executable, which the server finds in its own directory.
	def WORKER_NAME = "virgil-lsp-worker";
	// The argument that makes the worker serve a server.
	def WORKER_ARG = "--serve";
	// The worker's descriptors for requests and results.
	def REQUEST_FD = 3;
	def RESULT_FD = 4;

	// Worker to server, once at startup: protocol version, server version,
	// source revision, and heap size in bytes.
	def HELLO: byte = 1;
	// Server to worker: request ID, flags, the server's time limit in
	// milliseconds, the count and strings of the program's language options
	// in the order given (see AeneasAdapter.setLanguageOptions), file count,
	// then each file's path and contents.
	def ANALYZE: byte = 2;
	// Worker to server: see encodeResult.
	def RESULT: byte = 3;

	// ANALYZE flags.
	def WANT_OCCURRENCES = 1;
	def WANT_STATS = 2;

	// RESULT flags.
	private def PARSED = 1;
	private def VERIFIED = 2;
	private def OCCURRENCES = 4;
	// The fixed-width part of a RESULT, after the kind: request ID, the
	// worker's analysis count, its UID counter (u32 each), and live heap
	// bytes (u64), which is filled in after the result is encoded.
	private def LIVE_BYTES_OFFSET = WorkerFraming.HEADER_BYTES + 1 + 3 * 4;
	// Declaration kinds by tag, for decoding.
	def DECL_KINDS = declKinds();

	def encodeHello(version: string, revision: string, heapBytes: long) -> Range<byte> {
		var w = WorkerFraming.start().putb(HELLO);
		w.put_sleb32(PROTOCOL_VERSION);
		putString(w, version);
		putString(w, revision);
		w.put_sleb64(heapBytes);
		return WorkerFraming.finish(w);
	}
	def decodeHello(payload: Array<byte>) -> AnalysisWorkerHello {
		var r = AnalysisWireReader.new(payload, HELLO);
		var hello = AnalysisWorkerHello.new(r.readInt(), r.readString(1), r.readString(1), r.readLong());
		return if(r.finish(), hello);
	}

	def analyzeFrameSize(id: int, flags: int, timeoutMs: int, options: Array<string>, sources: Array<AnalysisSource>) -> long {
		var size = long.view(WorkerFraming.HEADER_BYTES) + 1
			+ sleb32Size(id) + sleb32Size(flags) + sleb32Size(timeoutMs)
			+ sleb32Size(options.length) + sleb32Size(sources.length);
		for (o in options) size += sleb32Size(o.length) + long.view(o.length);
		for (s in sources) {
			var pathLength = if(s.path == null, -1, s.path.length);
			var inputLength = if(s.input == null, 0, s.input.length);
			size += sleb32Size(pathLength) + long.view(if(pathLength < 0, 0, pathLength));
			size += sleb32Size(inputLength) + long.view(inputLength);
		}
		return size;
	}
	private def sleb32Size(value: int) -> int {
		var size = 1;
		while (value < -64 || value > 63) {
			value = value >> 7;
			size++;
		}
		return size;
	}
	def encodeAnalyze(id: int, flags: int, timeoutMs: int, options: Array<string>, sources: Array<AnalysisSource>) -> Range<byte> {
		var w = WorkerFraming.start().putb(ANALYZE);
		w.put_sleb32(id).put_sleb32(flags).put_sleb32(timeoutMs).put_sleb32(options.length);
		for (o in options) putString(w, o);
		w.put_sleb32(sources.length);
		for (s in sources) {
			putString(w, s.path);
			var input = if(s.input == null, Array<byte>.new(0), s.input);
			w.put_sleb32(input.length).puta(input);
		}
		return WorkerFraming.finish(w);
	}
	// Returns null for a malformed request, including one with a language
	// option that a project file would not accept.
	def decodeAnalyze(payload: Array<byte>) -> AnalysisWorkerRequest {
		var r = AnalysisWireReader.new(payload, ANALYZE);
		var id = r.readInt(), flags = r.readInt(), timeoutMs = r.readInt();
		var options = Array<string>.new(r.readCount(1, 64)), seen = Strings.newMap<bool>();
		for (i < options.length) {
			var o = r.readString(1);
			if (o == null || ProjectCompilerFlags.check(o, seen) != null) return null;
			options[i] = o;
		}
		var sources = Array<AnalysisSource>.new(r.readCount(2, 128));
		for (i < sources.length) {
			var path = r.readString(1);
			sources[i] = AnalysisSource.new(path, r.readBytes());
		}
		return if(r.finish(), AnalysisWorkerRequest.new(id, flags, timeoutMs, options, sources));
	}

	// Encodes a RESULT: the fixed-width part, then flags, statistics,
	// diagnostics, and, if {files} is not null, a string table, the distinct
	// declarations, and each file's index. {files} must be the request's
	// distinct paths in request order, and a path is sent as its index there;
	// every declaration is in one of them. A declaration is its kind, its
	// name's string index, its path index, its range (four compiler
	// coordinates and two byte offsets), and its signature's string index plus
	// one, or zero. Each file's declaration sites (see
	// ProgramAnalysis.declarationSites) come first in the declarations, in
	// files order, so a file sends its path index, then their first index and
	// count. Then come its occurrences in source order, each its begin line,
	// begin column, begin offset, length, and declaration index; the
	// occurrences whose use-site type differs from their declaration's, each
	// as the difference from the previous one's occurrence index and the
	// type's string index; and its builtin uses, each a range as an
	// occurrence's and a string index.
	// A use that is not a token span (see AnalysisRange.isTokenSpan), which
	// the collector never records, is omitted rather than misstated. The
	// skipped-uses statistic counts these omissions and the collector's own
	// skips, or is -1 without occurrences. Call finishResult before sending.
	def encodeResult(id: int, analyses: int, uidNext: int, analysis: ProgramAnalysis,
			collectUs: int, globalTypeTotal: int, files: Array<(string, Array<AnalysisOccurrence>)>) -> DataWriter {
		var w = WorkerFraming.start().putb(RESULT);
		w.put_b32(id).put_b32(analyses).put_b32(uidNext).put_b64(0);
		var flags = if(analysis.parsed, PARSED) | if(analysis.verified, VERIFIED) | if(files != null, OCCURRENCES);
		w.putb(flags);
		var s = analysis.stats;
		w.put_sleb32(s.parseUs).put_sleb32(s.verifyUs).put_sleb32(collectUs).put_sleb32(s.uidsUsed);
		w.put_sleb32(s.globalTypesAdded).put_sleb32(globalTypeTotal);
		var skipped = -1;
		if (files != null) {
			skipped = 0;
			for (f in files) {
				skipped += analysis.skippedUses(f.0);
				for (o in f.1) if (!o.range.isTokenSpan()) skipped++;
				for (u in analysis.builtinUses(f.0)) if (!u.range.isTokenSpan()) skipped++;
			}
		}
		w.put_sleb32(skipped);
		w.put_sleb32(analysis.diagnostics.length);
		for (d in analysis.diagnostics) {
			putString(w, d.path);
			w.put_sleb32(d.beginLine).put_sleb32(d.beginColumn).put_sleb32(d.endLine).put_sleb32(d.endColumn);
			w.put_sleb32(d.beginOffset).put_sleb32(d.endOffset);
			putString(w, d.kind);
			putString(w, d.message);
		}
		if (files != null) encodeOccurrences(w, analysis, files);
		return w;
	}
	// Fills in the live heap bytes of a result from {encodeResult} and returns its frame.
	def finishResult(w: DataWriter, liveBytes: long) -> Range<byte> {
		var end = w.end();
		w.at(LIVE_BYTES_OFFSET).put_b64(liveBytes).at(end);
		return WorkerFraming.finish(w);
	}
	private def encodeOccurrences(w: DataWriter, analysis: ProgramAnalysis, files: Array<(string, Array<AnalysisOccurrence>)>) {
		// A path is its file's index in {files}, the request's distinct paths
		// in order, plus one.
		var paths = Strings.newMap<int>();
		for (i < files.length) if (paths[files[i].0] == 0) paths[files[i].0] = i + 1;
		var decls = AnalysisIndexMap<AnalysisDeclaration>.new(hashDeclaration, sameDeclaration);
		var strings = AnalysisStringTable.new();
		var sites = Array<Array<AnalysisDeclaration>>.new(files.length);
		var builtins = Array<Array<AnalysisBuiltinUse>>.new(files.length);
		var firstSite = Array<int>.new(files.length);
		// Each file's sites first, so that they are a run of the declarations.
		for (i < files.length) {
			var f = files[i];
			sites[i] = analysis.declarationSites(f.0);
			builtins[i] = analysis.builtinUses(f.0);
			firstSite[i] = decls.length();
			for (d in sites[i]) decls.add(d);
		}
		// The collector makes each declaration once, but a caller can make one
		// per use; send each once.
		for (f in files) {
			for (o in f.1) {
				if (o.useType != null) strings.add(o.useType);
				if (decls.find(o.declaration) < 0) decls.add(o.declaration);
			}
		}
		for (b in builtins) for (u in b) strings.add(u.useType);
		for (i < decls.length()) {
			var d = decls[i];
			strings.add(d.name);
			if (d.signature != null) strings.add(d.signature);
		}
		w.put_sleb32(strings.length());
		for (i < strings.length()) putString(w, strings[i]);
		w.put_sleb32(decls.length());
		for (i < decls.length()) {
			var d = decls[i];
			w.putb(d.kind.tag);
			w.put_sleb32(strings.add(d.name));
			// Every declaration is in one of the request's files; -1 would be
			// rejected.
			w.put_sleb32(paths[d.range.path] - 1);
			putRange(w, d.range);
			w.put_sleb32(if(d.signature != null, 1 + strings.add(d.signature)));
		}
		w.put_sleb32(files.length);
		for (i < files.length) {
			var f = files[i], count = 0, typed = 0;
			w.put_sleb32(paths[f.0] - 1).put_sleb32(firstSite[i]).put_sleb32(sites[i].length);
			for (o in f.1) {
				if (!o.range.isTokenSpan()) continue;
				count++;
				if (o.useType != null) typed++;
			}
			w.put_sleb32(count);
			for (o in f.1) {
				var r = o.range;
				if (!r.isTokenSpan()) continue;
				putSpan(w, r);
				w.put_sleb32(decls.find(o.declaration));
			}
			w.put_sleb32(typed);
			var index = 0, previous = 0;
			for (o in f.1) {
				if (!o.range.isTokenSpan()) continue;
				if (o.useType != null) {
					w.put_sleb32(index - previous).put_sleb32(strings.add(o.useType));
					previous = index;
				}
				index++;
			}
			count = 0;
			for (u in builtins[i]) if (u.range.isTokenSpan()) count++;
			w.put_sleb32(count);
			for (u in builtins[i]) {
				if (!u.range.isTokenSpan()) continue;
				putSpan(w, u.range);
				w.put_sleb32(strings.add(u.useType));
			}
		}
	}
	// Decodes a RESULT into the worker's state and a snapshot with
	// {generation} for a request with {paths}. Budget exhaustion stops decoding
	// before allocating; it is distinct from a malformed payload. The remainder
	// of an over-budget payload is not validated, so its worker is not reused.
	def decodeResult(payload: Array<byte>, generation: int, paths: Array<string>) -> AnalysisResultDecode {
		var r = AnalysisWireReader.new(payload, RESULT);
		var id = r.readU32(), analyses = r.readU32(), uidNext = r.readU32();
		var state = AnalysisWorkerState.new(analyses, uidNext, r.readU64());
		var flags = r.readByte();
		var stats = AnalysisSnapshotStats.new(r.readInt(), r.readInt(), r.readInt(), r.readInt(), uidNext,
			r.readInt(), r.readInt(), r.readInt());
		// Path, six coordinate ints, kind, and message take at least nine
		// bytes. The record charge includes the two new offset fields, plus
		// the existing conservative diagnostic/JSON response allowance.
		var diagnostics = Array<AnalysisDiagnostic>.new(r.readCount(9, 2056));
		for (i < diagnostics.length) {
			var path = r.readString(32);
			var bl = r.readInt(), bc = r.readInt(), el = r.readInt(), ec = r.readInt();
			var beginOffset = r.readInt(), endOffset = r.readInt();
			var kind = r.readString(32);
			var d = AnalysisDiagnostic.new(path, bl, bc, el, ec, kind, r.readString(32));
			d.beginOffset = beginOffset;
			d.endOffset = endOffset;
			diagnostics[i] = d;
		}
		var hasOccurrences = (flags & OCCURRENCES) != 0;
		var declarations: Array<AnalysisDeclaration> = [];
		var strings: Array<string> = [], files: AnalysisSnapshotFiles;
		if (hasOccurrences) {
			// A path is an index into the request's distinct paths, which the
			// server sent, so the result has no path table and no path is
			// looked up by text.
			files = AnalysisSnapshotFiles.new(paths);
			// Each string is charged as an index string, and its slot.
			strings = Array<string>.new(r.readCount(1, 8));
			for (i < strings.length) strings[i] = r.readString(1);
			// Kind, name, path index, six range ints, and signature take at
			// least ten bytes. The record charge covers the declaration, its
			// range, and the array slot; its strings are in the string table.
			declarations = Array<AnalysisDeclaration>.new(r.readCount(10, 128));
			for (i < declarations.length) {
				var kind = r.readKind(), name = r.readStringIndex(strings), path = r.readPath(files.paths);
				var d = AnalysisDeclaration.new(kind, name, r.readRange(path));
				d.signature = r.readOptionalString(strings);
				declarations[i] = d;
			}
		}
		var snapshot = AnalysisSnapshot.new(generation, paths, (flags & PARSED) != 0,
			(flags & VERIFIED) != 0, diagnostics, stats, hasOccurrences, declarations);
		if (hasOccurrences) {
			snapshot.setStrings(strings);
			snapshot.setFiles(files);
			// Each file is one of the request's, at most once, and the site
			// runs come in order, so that each declaration is checked as a
			// site at most once.
			var siteEnd = 0;
			for (n = r.readCount(6, 256); n > 0 && r.ok(); n--) {
				var fileIndex = r.readInt();
				if (!files.isNew(fileIndex)) {
					r.fail("invalid or repeated file index");
					break;
				}
				var path = files.paths[fileIndex];
				var first = r.readInt(), sites = r.readInt();
				if (!r.checkSites(declarations, path, siteEnd, first, sites)) break;
				siteEnd = first + sites;
				// Each occurrence is four ints of its range and a declaration
				// index, stored as five int array elements.
				var count = r.readCount(5, 20);
				var ranges = Array<int>.new(4 * count), targets = Array<int>.new(count), end = 0;
				for (i = 0; i < count && r.ok(); i++) {
					end = r.readSpan(ranges, 4 * i, end);
					targets[i] = r.readTarget(declarations.length);
				}
				// Occurrence index and type string index pairs.
				var typed = Array<int>.new(2 * r.readCount(2, 8)), index = 0;
				for (i = 0; i < typed.length && r.ok(); i += 2) {
					index += r.readInt();
					typed[i] = r.checkIndex(index, count, i > 0 && index <= typed[i - 2]);
					typed[i + 1] = r.readStringId(strings);
				}
				// A builtin use is an occurrence's four range ints and a type
				// string index.
				var builtins = Array<int>.new(5 * r.readCount(5, 20));
				end = 0;
				for (i = 0; i < builtins.length && r.ok(); i += 5) {
					end = r.readSpan(builtins, i, end);
					builtins[i + 4] = r.readStringId(strings);
				}
				// A builtin use is never an occurrence, so a lookup by offset
				// finds at most one of them.
				r.checkDisjoint(ranges, builtins);
				files.add(fileIndex, AnalysisSnapshotFile.new(ranges, targets, typed, builtins, first, sites));
			}
		}
		if (r.overBudget) return AnalysisResultDecode.TooLarge(id);
		if (!r.finish()) return AnalysisResultDecode.Malformed;
		snapshot.resultAllocation = r.allocationBytes();
		snapshot.retainedBytes += snapshot.resultAllocation;
		return AnalysisResultDecode.Decoded(AnalysisWorkerResult.new(id, state, snapshot));
	}

	private def declKinds() -> Array<AnalysisDeclKind> {
		var kinds = Array<AnalysisDeclKind>.new(AnalysisDeclKind.count);
		for (k in AnalysisDeclKind) kinds[k.tag] = k;
		return kinds;
	}
	private def putString(w: DataWriter, s: string) {
		if (s == null) w.put_sleb32(-1);
		else w.put_sleb32(s.length).puta(s);
	}
	// A token span is its begin line, column, and offset, and its length.
	private def putSpan(w: DataWriter, r: AnalysisRange) {
		w.put_sleb32(r.beginLine).put_sleb32(r.beginColumn).put_sleb32(r.beginOffset);
		w.put_sleb32(r.endOffset - r.beginOffset);
	}
	private def putRange(w: DataWriter, r: AnalysisRange) {
		w.put_sleb32(r.beginLine).put_sleb32(r.beginColumn).put_sleb32(r.endLine).put_sleb32(r.endColumn);
		w.put_sleb32(r.beginOffset).put_sleb32(r.endOffset);
	}
	private def hashDeclaration(d: AnalysisDeclaration) -> int {
		var r = d.range;
		return Strings.hash(r.path) * 31 + r.beginLine * 1009 + r.beginColumn * 7 + d.kind.tag;
	}
	private def sameDeclaration(a: AnalysisDeclaration, b: AnalysisDeclaration) -> bool {
		var x = a.range, y = b.range;
		return a.kind == b.kind && Strings.equal(a.name, b.name) && Strings.equal(x.path, y.path)
			&& x.beginLine == y.beginLine && x.beginColumn == y.beginColumn
			&& x.endLine == y.endLine && x.endColumn == y.endColumn
			&& x.beginOffset == y.beginOffset && x.endOffset == y.endOffset;
	}
}

// The handshake a worker sends when it starts.
class AnalysisWorkerHello(protocol: int, version: string, revision: string, heapBytes: long) { }

// A decoded ANALYZE request.
class AnalysisWorkerRequest(id: int, flags: int, timeoutMs: int, options: Array<string>, sources: Array<AnalysisSource>) { }

// What a worker reports about itself with each result, for the restart policy.
// {liveBytes} is measured after a collection, excluding the result itself.
class AnalysisWorkerState(analyses: int, uidNext: int, liveBytes: long) { }

// A decoded RESULT.
class AnalysisWorkerResult(id: int, state: AnalysisWorkerState, snapshot: AnalysisSnapshot) { }

// TooLarge carries the header ID so a stale or unsolicited result is still
// rejected as malformed. It never exposes the partially decoded snapshot.
type AnalysisResultDecode {
	case Decoded(result: AnalysisWorkerResult);
	case TooLarge(id: int);
	case Malformed;
}

// Reads one message, bounding every count and index by the bytes and tables
// actually present, so that a malformed message is rejected without trapping.
class AnalysisWireReader {
	private var r: DataReader;
	private var remaining: long;
	def var overBudget: bool;

	new(payload: Array<byte>, kind: byte) {
		r = DataReader.new(payload);
		remaining = if(kind == AnalysisWire.RESULT, long.view(AnalysisWire.MAX_RESULT_ALLOCATION), long.max);
		if (r.read1() != kind) r.fail("unexpected message kind");
	}
	def allocationBytes() -> long {
		return long.view(AnalysisWire.MAX_RESULT_ALLOCATION) - remaining;
	}
	def ok() -> bool {
		return r.ok;
	}
	def fail(message: string) {
		r.fail(message);
	}
	// Returns true if the message was well formed and completely read.
	def finish() -> bool {
		return r.ok && r.done();
	}
	def readByte() -> byte {
		return r.read1();
	}
	def readInt() -> int {
		return r.read_sleb32();
	}
	def readLong() -> long {
		return r.read_sleb64();
	}
	def readU32() -> int {
		return int.view(r.read_u32());
	}
	def readU64() -> long {
		return long.view(r.read_u64());
	}
	// A count of items, each of which takes at least {itemBytes} more bytes,
	// so that a count can't make the reader allocate beyond the message's size.
	def readCount(itemBytes: int, allocationBytes: int) -> int {
		var n = r.read_sleb32();
		if (n < 0 || n > r.available() / itemBytes) {
			r.fail("invalid count");
			return 0;
		}
		return if(reserve(64 + long.view(n) * allocationBytes), n, 0);
	}
	// Index strings need only snapshot storage. Diagnostic strings also need
	// room for JSON escaping and response buffers, charged at 32 bytes per byte.
	def readString(allocationBytes: int) -> string {
		var n = r.read_sleb32();
		if (n == -1) return null;
		if (n < -1 || n > r.available()) {
			r.fail("invalid string length");
			return null;
		}
		return if(reserve(64 + long.view(allocationBytes) * n), r.readN(n));
	}
	def readBytes() -> Array<byte> {
		var n = readCount(1, 1);
		return if(r.ok, r.readN(n), []);
	}
	private def reserve(bytes: long) -> bool {
		if (!r.ok) return false;
		if (bytes > remaining) {
			overBudget = true;
			r.fail("result exceeds the allocation budget");
			return false;
		}
		remaining -= bytes;
		return true;
	}
	def readPath(table: Array<string>) -> string {
		var i = r.read_sleb32();
		if (u32.view(i) >= u32.view(table.length)) {
			r.fail("invalid path index");
			return null;
		}
		return table[i];
	}
	def readTarget(declarations: int) -> int {
		var i = r.read_sleb32();
		if (u32.view(i) >= u32.view(declarations)) {
			r.fail("invalid declaration index");
			return 0;
		}
		return i;
	}
	// A string table entry, which is never null.
	def readStringIndex(strings: Array<string>) -> string {
		var i = readStringId(strings);
		return if(r.ok, strings[i]);
	}
	// The index of a string table entry, which is never null.
	def readStringId(strings: Array<string>) -> int {
		var i = r.read_sleb32();
		if (u32.view(i) >= u32.view(strings.length) || strings[i] == null) {
			r.fail("invalid string index");
			return 0;
		}
		return i;
	}
	// A string table index plus one, or zero for null.
	def readOptionalString(strings: Array<string>) -> string {
		var i = r.read_sleb32();
		if (i == 0) return null;
		if (u32.view(i - 1) >= u32.view(strings.length) || strings[i - 1] == null) {
			r.fail("invalid string index");
			return null;
		}
		return strings[i - 1];
	}
	// Returns {index} if it is below {count} and not {disordered}.
	def checkIndex(index: int, count: int, disordered: bool) -> int {
		if (u32.view(index) >= u32.view(count) || disordered) {
			r.fail("invalid occurrence index");
			return 0;
		}
		return index;
	}
	// Checks that declarations {first} to {first + count} are declared in
	// {path}, with nonempty byte ranges in order and not overlapping, so
	// that a binary search finds them, and that they start at or after
	// {after}, the end of the previous file's run.
	def checkSites(declarations: Array<AnalysisDeclaration>, path: string, after: int, first: int, count: int) -> bool {
		if (!r.ok) return false;
		if (first < after || count < 0 || count > declarations.length - first) {
			r.fail("invalid declaration sites");
			return false;
		}
		var end = 0;
		for (i = first; i < first + count; i++) {
			var range = declarations[i].range;
			if (range.path != path || range.beginOffset < end || range.endOffset <= range.beginOffset) {
				r.fail("invalid declaration sites");
				return false;
			}
			end = range.endOffset;
		}
		return true;
	}
	// Reads a use's line, column, byte offset, and length into {a} from
	// index {i}, and returns its end offset. A use is a token span that
	// starts at or after {end}, the end of the previous use, so that uses
	// are in byte order without overlaps, as a binary search requires.
	def readSpan(a: Array<int>, i: int, end: int) -> int {
		var line = r.read_sleb32(), column = r.read_sleb32(), offset = r.read_sleb32(), length = r.read_sleb32();
		if (line < 1 || column < 1 || offset < end || length < 1 || length > int.max - offset || length > int.max - column) {
			r.fail("invalid use range");
			return end;
		}
		a[i] = line;
		a[i + 1] = column;
		a[i + 2] = offset;
		a[i + 3] = length;
		return offset + length;
	}
	// Checks that no occurrence in {ranges}, four ints each, overlaps a
	// builtin use in {builtins}, five ints each. Both are in byte order.
	def checkDisjoint(ranges: Array<int>, builtins: Array<int>) {
		var i = 0, k = 0;
		while (r.ok && i < ranges.length && k < builtins.length) {
			var o = ranges[i + 2], b = builtins[k + 2];
			if (o + ranges[i + 3] <= b) i += 4;
			else if (b + builtins[k + 3] <= o) k += 5;
			else r.fail("builtin use overlaps an occurrence");
		}
	}
	def readKind() -> AnalysisDeclKind {
		var tag = r.read1();
		if (tag >= AnalysisWire.DECL_KINDS.length) {
			r.fail("invalid declaration kind");
			return AnalysisDeclKind.LOCAL;
		}
		return AnalysisWire.DECL_KINDS[tag];
	}
	def readRange(path: string) -> AnalysisRange {
		return AnalysisRange.new(path, r.read_sleb32(), r.read_sleb32(), r.read_sleb32(), r.read_sleb32(),
			r.read_sleb32(), r.read_sleb32());
	}
}
