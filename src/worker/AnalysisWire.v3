// The messages between the server and an analysis worker, each in one
// WorkerFraming frame. The first payload byte is the message kind. Unless
// noted, integers are signed LEB128, and strings are a length (-1 for null)
// followed by their bytes. Encoders and decoders for both directions live
// here, so that the protocol changes in one place; PROTOCOL_VERSION changes
// with it. See docs/decisions/0004-analysis-worker-process.md.
component AnalysisWire {
	def PROTOCOL_VERSION = 12;
	def MAX_RESULT_ALLOCATION = 16 * 1024 * 1024;
	// The worker executable, which the server finds in its own directory.
	def WORKER_NAME = "virgil-lsp-worker";
	// The argument that makes the worker serve a server.
	def WORKER_ARG = "--serve";
	// The worker's descriptors for requests and results.
	def REQUEST_FD = 3;
	def RESULT_FD = 4;

	// Worker to server, once at startup: protocol version, server version,
	// source revision, and heap size in bytes.
	def HELLO: byte = 1;
	// Server to worker: request ID, flags, the server's time limit in
	// milliseconds, the count and strings of the program's language options
	// in the order given (see AeneasAdapter.setLanguageOptions), file count,
	// then each file's path and contents; and, with WANT_SCOPE, a scope query:
	// a source's index, a byte offset in it, AnalysisScopeKinds, and a prefix.
	// The kinds are scope kinds, or MEMBERS alone for a member query, or CALL
	// alone, with no prefix, for a call query. Without WANT_OCCURRENCES, the
	// result of a query has an occurrence section with no files, whose
	// declarations are the answer's.
	def ANALYZE: byte = 2;
	// Worker to server: see encodeResult.
	def RESULT: byte = 3;

	// ANALYZE flags.
	def WANT_OCCURRENCES = 1;
	def WANT_STATS = 2;
	def WANT_SCOPE = 4;

	// RESULT flags.
	private def PARSED = 1;
	private def VERIFIED = 2;
	private def OCCURRENCES = 4;
	private def SCOPE = 8;
	private def MEMBERS = 16;
	private def CALL = 32;
	// A scope or member answer's flags.
	def SCOPE_TRUNCATED: byte = 1;
	// The fixed-width part of a RESULT, after the kind: request ID, the
	// worker's analysis count, its UID counter (u32 each), and live heap
	// bytes (u64), which is filled in after the result is encoded.
	private def LIVE_BYTES_OFFSET = WorkerFraming.HEADER_BYTES + 1 + 3 * 4;
	// Declaration kinds by tag, for decoding.
	def DECL_KINDS = declKinds();

	def encodeHello(version: string, revision: string, heapBytes: long) -> Range<byte> {
		var w = WorkerFraming.start().putb(HELLO);
		w.put_sleb32(PROTOCOL_VERSION);
		putString(w, version);
		putString(w, revision);
		w.put_sleb64(heapBytes);
		return WorkerFraming.finish(w);
	}
	def decodeHello(payload: Array<byte>) -> AnalysisWorkerHello {
		var r = AnalysisWireReader.new(payload, HELLO);
		var hello = AnalysisWorkerHello.new(r.readInt(), r.readString(1), r.readString(1), r.readLong());
		return if(r.finish(), hello);
	}

	// The frame size of an ANALYZE request; {scope} is null unless {flags}
	// has WANT_SCOPE.
	def analyzeFrameSize(id: int, flags: int, timeoutMs: int, options: Array<string>, sources: Array<AnalysisSource>,
			scope: AnalysisScopeRequest) -> long {
		var size = long.view(WorkerFraming.HEADER_BYTES) + 1
			+ sleb32Size(id) + sleb32Size(flags) + sleb32Size(timeoutMs)
			+ sleb32Size(options.length) + sleb32Size(sources.length);
		for (o in options) size += sleb32Size(o.length) + long.view(o.length);
		for (s in sources) {
			var pathLength = if(s.path == null, -1, s.path.length);
			var inputLength = if(s.input == null, 0, s.input.length);
			size += sleb32Size(pathLength) + long.view(if(pathLength < 0, 0, pathLength));
			size += sleb32Size(inputLength) + long.view(inputLength);
		}
		if (scope != null) {
			size += sleb32Size(scope.file) + sleb32Size(scope.offset) + sleb32Size(scope.kinds);
			size += sleb32Size(scope.prefix.length) + long.view(scope.prefix.length);
		}
		return size;
	}
	private def sleb32Size(value: int) -> int {
		var size = 1;
		while (value < -64 || value > 63) {
			value = value >> 7;
			size++;
		}
		return size;
	}
	// Encodes an ANALYZE request, with {scope} unless it is null, in which
	// case {flags} must not have WANT_SCOPE.
	def encodeAnalyze(id: int, flags: int, timeoutMs: int, options: Array<string>, sources: Array<AnalysisSource>,
			scope: AnalysisScopeRequest) -> Range<byte> {
		var w = WorkerFraming.start().putb(ANALYZE);
		w.put_sleb32(id).put_sleb32(flags).put_sleb32(timeoutMs).put_sleb32(options.length);
		for (o in options) putString(w, o);
		w.put_sleb32(sources.length);
		for (s in sources) {
			putString(w, s.path);
			var input = if(s.input == null, Array<byte>.new(0), s.input);
			w.put_sleb32(input.length).puta(input);
		}
		if (scope != null) {
			w.put_sleb32(scope.file).put_sleb32(scope.offset).put_sleb32(scope.kinds);
			putString(w, scope.prefix);
		}
		return WorkerFraming.finish(w);
	}
	// Returns null for a malformed request, including one with a language
	// option that a project file would not accept, and a scope query for a
	// source, offset, kinds, or prefix that do not exist, or a call query
	// with a prefix.
	def decodeAnalyze(payload: Array<byte>) -> AnalysisWorkerRequest {
		var r = AnalysisWireReader.new(payload, ANALYZE);
		var id = r.readInt(), flags = r.readInt(), timeoutMs = r.readInt();
		var options = Array<string>.new(r.readCount(1, 64)), seen = Strings.newMap<bool>();
		for (i < options.length) {
			var o = r.readString(1);
			if (o == null || ProjectCompilerFlags.check(o, seen) != null) return null;
			options[i] = o;
		}
		var sources = Array<AnalysisSource>.new(r.readCount(2, 128));
		for (i < sources.length) {
			var path = r.readString(1);
			sources[i] = AnalysisSource.new(path, r.readBytes());
		}
		var scope: AnalysisScopeRequest;
		if ((flags & WANT_SCOPE) != 0) {
			var file = r.readInt(), offset = r.readInt(), kinds = r.readInt(), prefix = r.readString(1);
			if (u32.view(file) >= u32.view(sources.length) || offset < 0 || offset > sources[file].input.length) return null;
			if (!AnalysisScopeKinds.valid(kinds)) return null;
			if (prefix == null || prefix.length > AnalysisScopeOrder.MAX_PREFIX) return null;
			if (kinds == AnalysisScopeKinds.CALL && prefix.length > 0) return null;
			scope = AnalysisScopeRequest.new(file, offset, kinds, prefix);
		}
		if (!r.finish()) return null;
		if (scope != null) return AnalysisScopedRequest.new(id, flags, timeoutMs, options, sources, scope);
		return AnalysisWorkerRequest.new(id, flags, timeoutMs, options, sources);
	}

	// Encodes a RESULT: the fixed-width part, then flags, statistics,
	// diagnostics, and, if {files} is not null, a string table, the distinct
	// declarations, and each file's index. {files} must be the request's
	// distinct paths in request order, and a path is sent as its index there;
	// every declaration is in one of them. A declaration is its kind, its
	// name's string index, its path index, its range (four compiler
	// coordinates and two byte offsets), and its signature's string index plus
	// one, or zero, then its default source-type target (declaration ID plus
	// one, or zero for null). Each file's declaration sites (see
	// ProgramAnalysis.declarationSites) come first in the declarations, in
	// files order, so a file sends its path index, then their first index and
	// count. Then come its occurrences in source order, each its begin line,
	// begin column, begin offset, length, and declaration index (complemented
	// for a write); the occurrences whose use-site type differs from their
	// declaration's, each as the difference from the previous one's occurrence index and the
	// type's string index; its builtin uses, each a range as an
	// occurrence's and a string index; its sparse type targets (byte offset
	// delta and target code, with an absolute offset every 32 records);
	// and its calls (see encodeCalls). The
	// call signatures come between the declarations and the files: the
	// signature text, strings that the string table lacks, then each
	// signature as its label, the byte in the label where its first parameter
	// starts, and its parameters, each a string index or, past the table, a
	// signature text index. See docs/architecture.md#call-sites.
	// A use that is not a token span (see AnalysisRange.isTokenSpan), which
	// the collector never records, is omitted rather than misstated. The
	// skipped-uses statistic counts these omissions, any call that is not
	// sent (see AnalysisCallCheck), and the collector's own skips, or is -1
	// without occurrences. Call finishResult before sending.
	def encodeResult(id: int, analyses: int, uidNext: int, analysis: ProgramAnalysis,
			collectUs: int, globalTypeTotal: int, files: Array<(string, Array<AnalysisOccurrence>)>) -> DataWriter {
		return encodeResultWithQuery(id, analyses, uidNext, analysis, collectUs, globalTypeTotal, files, null, null, null);
	}
	// Encodes a RESULT as {encodeResult} does, and, if {files} is not null,
	// the answer to the request's scope, member, or call query after the
	// files, if it has {scope}, {members}, or {call}, of which it has at most
	// one. A scope answer is its flags (SCOPE_TRUNCATED), the level of "this"
	// or -1, and a count, then each candidate's declaration index and level,
	// then a count and the strings of hidden builtin names (see
	// AnalysisScopeFinder). A member answer is its flags and a count, then for
	// each candidate: its declaration index plus one, or zero for a builtin
	// member, which is followed by its kind and its name's string index; its
	// detail's string index plus one, or zero; and its level (see
	// AnalysisMemberLookup). A call answer is its call (see encodeCall), sent
	// only if a file's calls would send it (see AnalysisCallCheck). The
	// answer's declarations join the result's after the occurrences', its
	// names and details its string table, and its call's signature the call
	// signatures.
	def encodeResultWithQuery(id: int, analyses: int, uidNext: int, analysis: ProgramAnalysis,
			collectUs: int, globalTypeTotal: int, files: Array<(string, Array<AnalysisOccurrence>)>,
			scope: AnalysisScopeAnswer, members: AnalysisMemberAnswer, call: AnalysisCallAnswer) -> DataWriter {
		var sized = encodeResultWithQueryCounted(id, analyses, uidNext, analysis, collectUs, globalTypeTotal,
			files, scope, members, call);
		var written = long.view(sized.0.end());
		// The sizing pass and the writer ran the same code, so a mismatch is an
		// encoder bug. The bytes are still the writer's and still correct; only
		// the buffer was sized wrong, so the result is sent and the mismatch is
		// logged rather than ending the worker. The unit tests check the pair
		// for every result shape.
		if (sized.1 != written) {
			Log.warn(Strings.format2("result sizer counted %d bytes but the writer wrote %d", sized.1, written));
		}
		return sized.0;
	}
	// Encodes a RESULT as {encodeResultWithQuery} does, and returns the writer
	// with the number of bytes the sizing pass counted. The two must be equal;
	// {encodeResultWithQuery} checks that. The unit tests check the same pair
	// for every result shape.
	def encodeResultWithQueryCounted(id: int, analyses: int, uidNext: int, analysis: ProgramAnalysis,
			collectUs: int, globalTypeTotal: int, files: Array<(string, Array<AnalysisOccurrence>)>,
			scope: AnalysisScopeAnswer, members: AnalysisMemberAnswer, call: AnalysisCallAnswer) -> (DataWriter, long) {
		// The call answer's signature index plus one, or zero, or -1 if its
		// call is not sent.
		var callSignature = if(files != null && call != null, checkCall(call, analysis.callSignatureCount()), -1);
		if (callSignature < 0) call = null;
		var flags = if(analysis.parsed, PARSED) | if(analysis.verified, VERIFIED) | if(files != null, OCCURRENCES)
			| if(files != null && scope != null, SCOPE) | if(files != null && members != null, MEMBERS)
			| if(call != null, CALL);
		// Each file's calls that are sent (see AnalysisCallCheck), and how many
		// of them use each call signature.
		var skipped = -1, calls: Array<int>, uses: Array<int>;
		if (files != null) {
			skipped = 0;
			calls = Array<int>.new(files.length);
			uses = Array<int>.new(analysis.callSignatureCount());
			var check = AnalysisCallCheck.new(uses.length);
			for (i < files.length) {
				var f = files[i], records = analysis.callRecords(f.0);
				skipped += analysis.skippedUses(f.0);
				for (o in f.1) if (!o.range.isTokenSpan()) skipped++;
				for (u in analysis.builtinUses(f.0)) if (!u.range.isTokenSpan()) skipped++;
				var c = check.start(records);
				while (c.next()) {
					if (!check.sends()) continue;
					calls[i]++;
					if (c.signature > 0) uses[c.signature - 1]++;
				}
				skipped += records.1 - calls[i];
			}
			if (callSignature > 0) uses[callSignature - 1]++;
		}
		var prefix = fun (w: DataWriter) {
			w.put_b32(0).putb(RESULT);
			w.put_b32(id).put_b32(analyses).put_b32(uidNext).put_b64(0);
			w.putb(flags);
			var s = analysis.stats;
			w.put_sleb32(s.parseUs).put_sleb32(s.verifyUs).put_sleb32(collectUs).put_sleb32(s.uidsUsed);
			w.put_sleb32(s.globalTypesAdded).put_sleb32(globalTypeTotal);
			w.put_sleb32(skipped);
			w.put_sleb32(analysis.diagnostics.length);
			for (d in analysis.diagnostics) {
				putString(w, d.path);
				w.put_sleb32(d.beginLine).put_sleb32(d.beginColumn).put_sleb32(d.endLine).put_sleb32(d.endColumn);
				w.put_sleb32(d.beginOffset).put_sleb32(d.endOffset);
				putString(w, d.kind);
				putString(w, d.message);
			}
		};
		if (files != null) return encodeOccurrences(prefix, analysis, files, calls, uses, scope, members, call);
		return encodeSized(prefix, fun (w: DataWriter) {});
	}
	// Count the same writes with the already prepared tables, then allocate
	// the frame capacity, rounded up to the runtime's eight-byte allocation
	// alignment. At most seven unused bytes keep array padding out of the
	// worker's retained-heap probe. Neither pass changes encoding or limits.
	// Returns the writer and the counted size, which must equal its length;
	// the caller checks that (see encodeResultWithQuery).
	private def encodeSized(prefix: DataWriter -> void, body: DataWriter -> void) -> (DataWriter, long) {
		var size = AnalysisResultSizer.new();
		prefix(size);
		body(size);
		// An unrepresentable frame still follows the library writer's failure
		// path. Representable oversized frames remain rejected by the reader.
		var w = DataWriter.new();
		if (size.bytes <= int.max - 7) w.grow(int.view((size.bytes + 7) & ~7L));
		else if (size.bytes <= int.max) w.grow(int.view(size.bytes));
		prefix(w);
		body(w);
		return (w, size.bytes);
	}

	// The signature index plus one, or zero, of {call}'s record, if it is
	// valid with {signatures} signatures, as a file's calls must be; or -1.
	private def checkCall(call: AnalysisCallAnswer, signatures: int) -> int {
		var check = AnalysisCallCheck.new(signatures), records: (Range<byte>, int) = (call.record, 1);
		var c = check.start(records);
		return if(c.next() && check.sends(), c.signature, -1);
	}
	// Fills in the live heap bytes of a result from {encodeResult} and returns its frame.
	def finishResult(w: DataWriter, liveBytes: long) -> Range<byte> {
		var end = w.end();
		w.at(LIVE_BYTES_OFFSET).put_b64(liveBytes).at(end);
		return WorkerFraming.finish(w);
	}
	private def encodeOccurrences(prefix: DataWriter -> void, analysis: ProgramAnalysis, files: Array<(string, Array<AnalysisOccurrence>)>,
			calls: Array<int>, uses: Array<int>, scope: AnalysisScopeAnswer, members: AnalysisMemberAnswer,
			call: AnalysisCallAnswer) -> (DataWriter, long) {
		// A path is its file's index in {files}, the request's distinct paths
		// in order, plus one. The paths key an ordered map, which takes
		// O(log n) whatever they are; see OrderedStringMap.
		var paths = OrderedStringMap<int>.new();
		for (i < files.length) paths.add(files[i].0, i + 1);
		// A query's answer without occurrences has no files; its program has
		// the request's paths.
		var queried = if(scope != null, scope.paths, if(members != null, members.paths, if(call != null, call.paths)));
		if (files.length == 0 && queried != null) {
			var n = 0;
			for (p in queried) if (p != null && paths.add(p, n + 1)) n++;
		}
		var decls = AnalysisIndexMap<AnalysisDeclaration>.new(hashDeclaration, sameDeclaration);
		var strings = AnalysisStringTable.new();
		var sites = Array<Array<AnalysisDeclaration>>.new(files.length);
		var builtins = Array<Array<AnalysisBuiltinUse>>.new(files.length);
		var firstSite = Array<int>.new(files.length);
		// Each file's sites first, so that they are a run of the declarations.
		for (i < files.length) {
			var f = files[i];
			sites[i] = analysis.declarationSites(f.0);
			builtins[i] = analysis.builtinUses(f.0);
		}
		var typeEncoding = AnalysisTypeTargetEncoding.new(analysis.typeDeclarationCount(), decls, files.length);
		for (i < files.length) {
			firstSite[i] = decls.length();
			for (d in sites[i]) typeEncoding.add(d);
		}
		// The collector makes each declaration once, but a caller can make one
		// per use; send each once.
		for (i < files.length) {
			for (d in sites[i]) typeEncoding.choose(typeEncoding.declaration(d), d.sourceType);
			var text = DataWriter.new(), ordinal = 0, previous = 0;
			for (o in files[i].1) {
				var useType = if(o.useType != null, strings.add(o.useType), -1);
				var index = typeEncoding.add(o.declaration);
				if (!o.range.isTokenSpan()) continue;
				typeEncoding.choose(index, o.sourceType);
				if (useType >= 0) {
					text.put_sleb32(ordinal - previous).put_sleb32(useType);
					previous = ordinal;
				}
				ordinal++;
			}
			typeEncoding.typedUses[i] = text.alias();
		}
		if (scope != null) for (d in scope.declarations) typeEncoding.add(d);
		if (call != null && call.target != null) typeEncoding.add(call.target);
		if (members != null) {
			for (d in members.declarations) if (d != null) typeEncoding.add(d);
			for (i < members.names.length) {
				if (members.declarations[i] == null) strings.add(members.names[i]);
				if (members.details[i] != null) strings.add(members.details[i]);
			}
		}
		for (i < files.length) {
			var encoded = DataWriter.new();
			for (u in builtins[i]) {
				var useType = strings.add(u.useType);
				if (!u.range.isTokenSpan()) continue;
				typeEncoding.requireTarget(u.sourceType);
				putSpan(encoded, u.range);
				encoded.put_sleb32(useType);
			}
			typeEncoding.builtinUses[i] = encoded.alias();
		}
		// Collection registered distinct targets. Indexing marked those the
		// selected files need, including explicit nondefault uses; ignore
		// targets registered by earlier collections of other files.
		for (i < analysis.sourceTargetCount()) {
			var d = analysis.sourceTargetAt(i);
			if (typeEncoding.needs(d)) typeEncoding.add(d);
		}
		typeEncoding.translateDefaults();
		for (i < files.length) typeEncoding.prepareFile(i, sites[i], files[i].1, builtins[i]);
		// Both wire passes reuse the numeric string and path IDs as well as
		// declaration IDs; none needs to hash the same declaration again.
		var declarationIds = Array<int>.new(3 * decls.length());
		for (i < decls.length()) {
			var d = decls[i];
			declarationIds[3 * i] = strings.add(d.name);
			declarationIds[3 * i + 1] = if(d.signature != null, 1 + strings.add(d.signature));
			declarationIds[3 * i + 2] = paths[d.range.path] - 1;
		}
		// Each signature that a sent call uses, which the display makes once,
		// the most used first, so that most calls name theirs in one byte;
		// {rank} is a signature's index there plus one. A signature's strings
		// that the table lacks are signature text.
		var used = 0;
		for (n in uses) if (n > 0) used++;
		var order = Array<int>.new(used), rank = Array<int>.new(uses.length);
		used = 0;
		for (i < uses.length) if (uses[i] > 0) order[used++] = i;
		order = AnalysisTables.sort(order, fun (a: int, b: int) => uses[a] > uses[b]);
		for (i < order.length) rank[order[i]] = i + 1;
		var text = AnalysisStringTable.new();
		for (i in order) {
			var sig = analysis.callSignature(i);
			if (strings.find(sig.label) < 0) text.add(sig.label);
			for (p in sig.params) if (strings.find(p) < 0) text.add(p);
		}
		return encodeSized(prefix, fun (w: DataWriter) {
			w.put_sleb32(strings.length());
			for (i < strings.length()) putString(w, strings[i]);
			w.put_sleb32(decls.length());
			for (i < decls.length()) {
				var d = decls[i];
				w.putb(d.kind.tag);
				w.put_sleb32(declarationIds[3 * i]);
				// Every declaration is in one of the request's files; -1 would be
				// rejected.
				w.put_sleb32(declarationIds[3 * i + 2]);
				putRange(w, d.range);
				w.put_sleb32(declarationIds[3 * i + 1]);
				w.put_sleb32(typeEncoding.defaults[i]);
			}
			w.put_sleb32(text.length());
			for (i < text.length()) putString(w, text[i]);
			w.put_sleb32(order.length);
			for (i in order) {
				var sig = analysis.callSignature(i);
				w.put_sleb32(stringRef(strings, text, sig.label)).put_sleb32(sig.start).put_sleb32(sig.params.length);
				for (p in sig.params) w.put_sleb32(stringRef(strings, text, p));
			}
			w.put_sleb32(files.length);
			var check = AnalysisCallCheck.new(uses.length);
			for (i < files.length) {
				var f = files[i], counts = typeEncoding.counts[i];
				w.put_sleb32(paths[f.0] - 1).put_sleb32(firstSite[i]).put_sleb32(sites[i].length);
				w.put_sleb32(counts.0);
				for (o in f.1) {
					var r = o.range;
					if (!r.isTokenSpan()) continue;
					putSpan(w, r);
					var target = typeEncoding.declaration(o.declaration);
					w.put_sleb32(if(o.isWrite(), ~target, target));
				}
				w.put_sleb32(counts.1).putr(typeEncoding.typedUses[i]);
				w.put_sleb32(counts.2).putr(typeEncoding.builtinUses[i]);
				w.put_sleb32(typeEncoding.overrideCounts[i]).putr(typeEncoding.overrides[i]);
				w.put_sleb32(calls[i]);
				encodeCalls(w, check.start(analysis.callRecords(f.0)), check, f.1, builtins[i], rank);
			}
			if (call != null) encodeCall(w, call, decls, rank);
			if (members != null) {
				w.putb(if(members.truncated, SCOPE_TRUNCATED, 0)).put_sleb32(members.names.length);
				for (i < members.names.length) {
					var d = members.declarations[i], detail = members.details[i];
					if (d != null) {
						w.put_sleb32(1 + decls.find(d));
					} else {
						w.put_sleb32(0).putb(members.kinds[i].tag);
						w.put_sleb32(strings.add(members.names[i]));
					}
					w.put_sleb32(if(detail != null, 1 + strings.add(detail))).put_sleb32(members.levels[i]);
				}
			}
			if (scope == null) return;
			w.putb(if(scope.truncated, SCOPE_TRUNCATED, 0)).put_sleb32(scope.thisLevel);
			w.put_sleb32(scope.declarations.length);
			for (i < scope.declarations.length) w.put_sleb32(decls.find(scope.declarations[i])).put_sleb32(scope.levels[i]);
			w.put_sleb32(scope.hiddenBuiltins.length);
			for (name in scope.hiddenBuiltins) putString(w, name);
		});
	}

	// A call is unsigned LEB128 numbers: its opening parenthesis, as the
	// difference from the previous call's (the first's from zero); its head,
	// the argument count times eight plus AnalysisCallFlags; the callee's
	// offset before the parenthesis, with CALLEE_OFFSET; its signature index
	// plus one, or zero; for each argument, its length times four plus the
	// bytes between it and the previous argument's end (the first's from just
	// after the parenthesis), or three if they follow as another number; and,
	// with CLOSE_GAP, the bytes between the last argument and the closing
	// parenthesis. The collector's records (see OccurrenceCollector.calls)
	// end the same way, so their arguments and closing gap are sent as they
	// are. A callee is the use that ends at the parenthesis, if it does, and
	// is sent only if its use is.
	private def encodeCalls(w: DataWriter, c: AnalysisCallCursor, check: AnalysisCallCheck,
			occurrences: Array<AnalysisOccurrence>, builtins: Array<AnalysisBuiltinUse>, rank: Array<int>) {
		var last = 0, data = c.r.data;
		while (c.next()) {
			var from = c.r.pos;
			if (!check.sends()) continue;
			var open = c.open, flags = c.flags & AnalysisCallFlags.CLOSE_GAP;
			var calleeEnd = if(c.calleeDelta > 0, useEnd(occurrences, builtins, open - c.calleeDelta), -1);
			if (calleeEnd == open) flags |= AnalysisCallFlags.CALLEE_AT_PAREN;
			else if (calleeEnd >= 0) flags |= AnalysisCallFlags.CALLEE_OFFSET;
			putU(w, open - last);
			putU(w, c.argCount * 8 + flags);
			if ((flags & AnalysisCallFlags.CALLEE_OFFSET) != 0) putU(w, c.calleeDelta);
			putU(w, if(c.signature > 0, rank[c.signature - 1]));
			w.putr(data[from ... c.r.pos]);
			last = open;
		}
	}
	// A call answer is its call, as the first of a file's calls is encoded,
	// except that it names its callee, if it has one, by the offset before its
	// "(" (CALLEE_OFFSET), since the answer has no uses; then the index plus
	// one of its callee's declaration, or zero.
	private def encodeCall(w: DataWriter, call: AnalysisCallAnswer, decls: AnalysisIndexMap<AnalysisDeclaration>, rank: Array<int>) {
		var c = AnalysisCallCursor.new(DataReader.new(call.record), 1);
		c.absolute = true;
		c.next();
		var from = c.r.pos;
		c.skipArgs();
		putU(w, c.open);
		putU(w, c.argCount * 8 + (c.flags & (AnalysisCallFlags.CALLEE_OFFSET | AnalysisCallFlags.CLOSE_GAP)));
		if (c.calleeDelta > 0) putU(w, c.calleeDelta);
		putU(w, if(c.signature > 0, rank[c.signature - 1]));
		w.putr(call.record[from ... c.r.pos]);
		w.put_sleb32(if(call.target != null, 1 + decls.find(call.target)));
	}
	// Decodes a RESULT into the worker's state and a snapshot with
	// {generation} for a request with {paths}. Budget exhaustion stops decoding
	// before allocating; it is distinct from a malformed payload. The remainder
	// of an over-budget payload is not validated, so its worker is not reused.
	def decodeResult(payload: Array<byte>, generation: int, paths: Array<string>) -> AnalysisResultDecode {
		return decodeResultWithQuery(payload, generation, paths, 0);
	}
	// Decodes a RESULT as {decodeResult} does, which may answer a query of
	// AnalysisScopeKinds {kinds}, or 0 for none: a member answer to a MEMBERS
	// query, a call answer to a CALL query, and a scope answer to another. An
	// answer to a request that did not ask for its kind is malformed.
	def decodeResultWithQuery(payload: Array<byte>, generation: int, paths: Array<string>, kinds: int) -> AnalysisResultDecode {
		var r = AnalysisWireReader.new(payload, RESULT);
		var id = r.readU32(), analyses = r.readU32(), uidNext = r.readU32();
		var state = AnalysisWorkerState.new(analyses, uidNext, r.readU64());
		var flags = r.readByte();
		var stats = AnalysisSnapshotStats.new(r.readInt(), r.readInt(), r.readInt(), r.readInt(), uidNext,
			r.readInt(), r.readInt(), r.readInt());
		// Path, six coordinate ints, kind, and message take at least nine
		// bytes. The record charge includes the two new offset fields, plus
		// the existing conservative diagnostic/JSON response allowance.
		var diagnostics = Array<AnalysisDiagnostic>.new(r.readCount(9, 2056));
		for (i < diagnostics.length) {
			var path = r.readString(32);
			var bl = r.readInt(), bc = r.readInt(), el = r.readInt(), ec = r.readInt();
			var beginOffset = r.readInt(), endOffset = r.readInt();
			var kind = r.readString(32);
			var d = AnalysisDiagnostic.new(path, bl, bc, el, ec, kind, r.readString(32));
			d.beginOffset = beginOffset;
			d.endOffset = endOffset;
			diagnostics[i] = d;
		}
		var hasOccurrences = (flags & OCCURRENCES) != 0;
		var declarations: Array<AnalysisDeclaration> = [];
		var strings: Array<string> = [], files: AnalysisSnapshotFiles, signatures: AnalysisSnapshotSignatures;
		if (hasOccurrences) {
			// A path is an index into the request's distinct paths, which the
			// server sent, so the result has no path table and no path is
			// looked up by text.
			files = AnalysisSnapshotFiles.new(paths);
			// Each string is charged as an index string, and its slot.
			strings = Array<string>.new(r.readCount(1, 8));
			for (i < strings.length) strings[i] = r.readString(1);
			// Kind, name, path index, six range ints, signature, and default
			// type target take at least eleven bytes. The conservative 128-byte
			// charge covers the declaration (including that int), its range,
			// and the array slot; strings are in the string table.
			declarations = Array<AnalysisDeclaration>.new(r.readCount(11, 128));
			for (i < declarations.length) {
				var kind = r.readKind(), name = r.readStringIndex(strings), path = r.readPath(files.paths);
				var d = AnalysisDeclaration.new(kind, name, r.readRange(path));
				d.signature = r.readOptionalString(strings);
				d.typeTarget = r.readOptionalTarget(declarations.length);
				declarations[i] = d;
			}
			signatures = r.readSignatures(strings);
		}
		var snapshot = AnalysisSnapshot.new(generation, paths, (flags & PARSED) != 0,
			(flags & VERIFIED) != 0, diagnostics, stats, hasOccurrences, declarations);
		if (hasOccurrences) {
			snapshot.setStrings(strings);
			snapshot.setSignatures(signatures);
			snapshot.setFiles(files);
			// Each file is one of the request's, at most once, and the site
			// runs come in order, so that each declaration is checked as a
			// site at most once.
			var siteEnd = 0;
			for (n = r.readCount(8, 256); n > 0 && r.ok(); n--) {
				var fileIndex = r.readInt();
				if (!files.isNew(fileIndex)) {
					r.fail("invalid or repeated file index");
					break;
				}
				var path = files.paths[fileIndex];
				var first = r.readInt(), sites = r.readInt();
				if (!r.checkSites(declarations, path, siteEnd, first, sites)) break;
				siteEnd = first + sites;
				// Each occurrence is four ints of its range and a declaration
				// index with its write bit, stored as five int array elements.
				var count = r.readCount(5, 20);
				var ranges = Array<int>.new(4 * count), targets = Array<int>.new(count), end = 0;
				for (i = 0; i < count && r.ok(); i++) {
					end = r.readSpan(ranges, 4 * i, end);
					targets[i] = r.readOccurrenceTarget(declarations.length);
				}
				// Occurrence index and type string index pairs.
				var typed = Array<int>.new(2 * r.readCount(2, 8)), index = 0;
				for (i = 0; i < typed.length && r.ok(); i += 2) {
					index += r.readInt();
					typed[i] = r.checkIndex(index, count, i > 0 && index <= typed[i - 2]);
					typed[i + 1] = r.readStringId(strings);
				}
				// A builtin use is an occurrence's four range ints and a type
				// string index.
				var builtins = Array<int>.new(5 * r.readCount(5, 20));
				end = 0;
				for (i = 0; i < builtins.length && r.ok(); i += 5) {
					end = r.readSpan(builtins, i, end);
					builtins[i + 4] = r.readStringId(strings);
				}
				// A builtin use is never an occurrence, so a lookup by offset
				// finds at most one of them.
				r.checkDisjoint(ranges, builtins);
				var file = AnalysisSnapshotFile.new(ranges, targets, typed, builtins, first, sites);
				file.typeTargets = r.readTypeTargets(file, declarations);
				r.readCalls(file, signatures);
				files.add(fileIndex, file);
			}
			var memberQuery = kinds == AnalysisScopeKinds.MEMBERS, callQuery = kinds == AnalysisScopeKinds.CALL;
			if ((flags & CALL) != 0 && r.ok()) {
				if (callQuery) snapshot.queriedCall = r.readCall(declarations, signatures);
				else r.fail("unrequested call answer");
			}
			if ((flags & MEMBERS) != 0 && r.ok()) {
				if (memberQuery) snapshot.members = r.readMembers(declarations, strings);
				else r.fail("unrequested member answer");
			}
			if ((flags & SCOPE) != 0 && r.ok()) {
				if (kinds != 0 && !memberQuery && !callQuery) snapshot.scope = r.readScope(declarations.length);
				else r.fail("unrequested scope answer");
			}
		} else if ((flags & (SCOPE | MEMBERS | CALL)) != 0) {
			r.fail("query answer without occurrences");
		}
		if (r.overBudget) return AnalysisResultDecode.TooLarge(id);
		if (!r.finish()) return AnalysisResultDecode.Malformed;
		snapshot.resultAllocation = r.allocationBytes();
		snapshot.retainedBytes += snapshot.resultAllocation;
		return AnalysisResultDecode.Decoded(AnalysisWorkerResult.new(id, state, snapshot));
	}

	private def declKinds() -> Array<AnalysisDeclKind> {
		var kinds = Array<AnalysisDeclKind>.new(AnalysisDeclKind.count);
		for (k in AnalysisDeclKind) kinds[k.tag] = k;
		return kinds;
	}
	private def putU(w: DataWriter, value: int) {
		w.put_uleb32(u32.view(value));
	}
	// A signature's string is an index into the string table or, past its
	// end, into the signature text.
	private def stringRef(strings: AnalysisStringTable, text: AnalysisStringTable, s: string) -> int {
		var i = strings.find(s);
		return if(i >= 0, i, strings.length() + text.find(s));
	}
	// The end offset of the use that starts at {offset} and is sent: an
	// occurrence or a builtin use that is a token span. Otherwise -1.
	private def useEnd(occurrences: Array<AnalysisOccurrence>, builtins: Array<AnalysisBuiltinUse>, offset: int) -> int {
		if (offset < 0) return -1;
		var low = 0, high = occurrences.length;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (occurrences[mid].range.beginOffset < offset) low = mid + 1;
			else high = mid;
		}
		for (i = low; i < occurrences.length && occurrences[i].range.beginOffset == offset; i++) {
			var r = occurrences[i].range;
			if (r.isTokenSpan()) return r.endOffset;
		}
		low = 0;
		high = builtins.length;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (builtins[mid].range.beginOffset < offset) low = mid + 1;
			else high = mid;
		}
		for (i = low; i < builtins.length && builtins[i].range.beginOffset == offset; i++) {
			var r = builtins[i].range;
			if (r.isTokenSpan()) return r.endOffset;
		}
		return -1;
	}
	private def putString(w: DataWriter, s: string) {
		if (s == null) w.put_sleb32(-1);
		else w.put_sleb32(s.length).puta(s);
	}
	// A token span is its begin line, column, and offset, and its length.
	private def putSpan(w: DataWriter, r: AnalysisRange) {
		w.put_sleb32(r.beginLine).put_sleb32(r.beginColumn).put_sleb32(r.beginOffset);
		w.put_sleb32(r.endOffset - r.beginOffset);
	}
	private def putRange(w: DataWriter, r: AnalysisRange) {
		w.put_sleb32(r.beginLine).put_sleb32(r.beginColumn).put_sleb32(r.endLine).put_sleb32(r.endColumn);
		w.put_sleb32(r.beginOffset).put_sleb32(r.endOffset);
	}
	// As the display's declaration keys (AnalysisDeclarationKeys.hash) do.
	private def hashDeclaration(d: AnalysisDeclaration) -> int {
		if (AnalysisWorkerDeclaration.?(d)) return AnalysisWorkerDeclaration.!(d).positionHash;
		var r = d.range;
		return int.view(AnalysisTables.hashPosition(r.path, r.beginLine, r.beginColumn, d.kind.tag));
	}
	private def sameDeclaration(a: AnalysisDeclaration, b: AnalysisDeclaration) -> bool {
		var x = a.range, y = b.range;
		return a.kind == b.kind && Strings.equal(a.name, b.name) && Strings.equal(x.path, y.path)
			&& x.beginLine == y.beginLine && x.beginColumn == y.beginColumn
			&& x.endLine == y.endLine && x.endColumn == y.endColumn
			&& x.beginOffset == y.beginOffset && x.endOffset == y.endOffset;
	}
}

// Counts precisely the primitives used by RESULT encoding, without a byte
// buffer. Long arithmetic keeps the count from wrapping at an int boundary.
class AnalysisResultSizer extends DataWriter {
	def var bytes: long;

	def putb(value: int) -> this {
		bytes++;
	}
	def put_b32(value: int) -> this {
		bytes += 4;
	}
	def put_b64(value: long) -> this {
		bytes += 8;
	}
	def put_sleb32(value: int) -> this {
		bytes++;
		while (value < -64 || value > 63) {
			value = value >> 7;
			bytes++;
		}
	}
	def put_uleb32(value: u32) -> this {
		bytes++;
		while (value >= 128) {
			value = value >> 7;
			bytes++;
		}
	}
	def putr(value: Range<byte>) -> this {
		bytes += value.length;
	}
}

// The handshake a worker sends when it starts.
class AnalysisWorkerHello(protocol: int, version: string, revision: string, heapBytes: long) { }

// A decoded ANALYZE request. One with a scope query is an
// AnalysisScopedRequest, so that an ordinary request carries nothing for it.
class AnalysisWorkerRequest(id: int, flags: int, timeoutMs: int, options: Array<string>, sources: Array<AnalysisSource>) {
	// The scope query, or null.
	def scope() -> AnalysisScopeRequest {
		return null;
	}
	// The answer to the scope query from {analysis}, if there is one and the
	// program parsed: see ProgramAnalysis.scopeAt.
	def scopeAnswer(analysis: ProgramAnalysis) -> AnalysisScopeAnswer {
		var q = scope();
		if (q == null || q.kinds == AnalysisScopeKinds.MEMBERS || q.kinds == AnalysisScopeKinds.CALL) return null;
		return analysis.scopeAt(sources[q.file].path, q.offset, q.kinds, q.prefix);
	}
	// The answer to the member query from {analysis}, if there is one, the
	// program parsed, and a member expression is at its offset: see
	// ProgramAnalysis.membersAt.
	def memberAnswer(analysis: ProgramAnalysis) -> AnalysisMemberAnswer {
		var q = scope();
		if (q == null || q.kinds != AnalysisScopeKinds.MEMBERS) return null;
		return analysis.membersAt(sources[q.file].path, q.offset, q.prefix);
	}
	// The answer to the call query from {analysis}, if there is one, the
	// program parsed, and a call opens at its offset: see
	// ProgramAnalysis.callAt.
	def callAnswer(analysis: ProgramAnalysis) -> AnalysisCallAnswer {
		var q = scope();
		if (q == null || q.kinds != AnalysisScopeKinds.CALL) return null;
		return analysis.callAt(sources[q.file].path, q.offset);
	}
	// The occurrences in each distinct path of the request, in order; a
	// repeated path keeps the first file's bindings, as ProgramAnalysis does.
	// The paths key an ordered map; see OrderedStringMap.
	def occurrences(analysis: ProgramAnalysis) -> Array<(string, Array<AnalysisOccurrence>)> {
		var seen = OrderedStringMap<bool>.new(), list = Vector<(string, Array<AnalysisOccurrence>)>.new();
		for (s in sources) {
			if (!seen.add(s.path, true)) continue;
			list.put((s.path, analysis.occurrences(s.path)));
		}
		return list.extract();
	}
}
class AnalysisScopedRequest extends AnalysisWorkerRequest {
	private def query: AnalysisScopeRequest;
	new(i: int, f: int, t: int, o: Array<string>, s: Array<AnalysisSource>, query) super(i, f, t, o, s) { }
	def scope() -> AnalysisScopeRequest {
		return query;
	}
}

// What a worker reports about itself with each result, for the restart policy.
// {liveBytes} is measured after a collection, excluding the result itself.
class AnalysisWorkerState(analyses: int, uidNext: int, liveBytes: long) { }

// A decoded RESULT.
class AnalysisWorkerResult(id: int, state: AnalysisWorkerState, snapshot: AnalysisSnapshot) { }

// TooLarge carries the header ID so a stale or unsolicited result is still
// rejected as malformed. It never exposes the partially decoded snapshot.
type AnalysisResultDecode {
	case Decoded(result: AnalysisWorkerResult);
	case TooLarge(id: int);
	case Malformed;
}

// Reads one message, bounding every count and index by the bytes and tables
// actually present, so that a malformed message is rejected without trapping.
class AnalysisWireReader {
	private var r: DataReader;
	private var remaining: long;
	def var overBudget: bool;

	new(payload: Array<byte>, kind: byte) {
		r = DataReader.new(payload);
		remaining = if(kind == AnalysisWire.RESULT, long.view(AnalysisWire.MAX_RESULT_ALLOCATION), long.max);
		if (r.read1() != kind) r.fail("unexpected message kind");
	}
	def allocationBytes() -> long {
		return long.view(AnalysisWire.MAX_RESULT_ALLOCATION) - remaining;
	}
	def ok() -> bool {
		return r.ok;
	}
	def fail(message: string) {
		r.fail(message);
	}
	// Returns true if the message was well formed and completely read.
	def finish() -> bool {
		return r.ok && r.done();
	}
	def readByte() -> byte {
		return r.read1();
	}
	def readInt() -> int {
		return r.read_sleb32();
	}
	def readLong() -> long {
		return r.read_sleb64();
	}
	def readU32() -> int {
		return int.view(r.read_u32());
	}
	def readU64() -> long {
		return long.view(r.read_u64());
	}
	// A count of items, each of which takes at least {itemBytes} more bytes,
	// so that a count can't make the reader allocate beyond the message's size.
	def readCount(itemBytes: int, allocationBytes: int) -> int {
		var n = r.read_sleb32();
		if (n < 0 || n > r.available() / itemBytes) {
			r.fail("invalid count");
			return 0;
		}
		return if(reserve(64 + long.view(n) * allocationBytes), n, 0);
	}
	// Index strings need only snapshot storage. Diagnostic strings also need
	// room for JSON escaping and response buffers, charged at 32 bytes per byte.
	def readString(allocationBytes: int) -> string {
		var n = r.read_sleb32();
		if (n == -1) return null;
		if (n < -1 || n > r.available()) {
			r.fail("invalid string length");
			return null;
		}
		return if(reserve(64 + long.view(allocationBytes) * n), r.readN(n));
	}
	def readBytes() -> Array<byte> {
		var n = readCount(1, 1);
		return if(r.ok, r.readN(n), []);
	}
	private def reserve(bytes: long) -> bool {
		if (!r.ok) return false;
		if (bytes > remaining) {
			overBudget = true;
			r.fail("result exceeds the allocation budget");
			return false;
		}
		remaining -= bytes;
		return true;
	}
	def readPath(table: Array<string>) -> string {
		var i = r.read_sleb32();
		if (u32.view(i) >= u32.view(table.length)) {
			r.fail("invalid path index");
			return null;
		}
		return table[i];
	}
	// A write is the complement of its declaration index on the wire. The
	// snapshot packs the flag in the sign bit of the existing target int:
	// the allocation bound limits declaration indexes well below 2^31.
	def readOccurrenceTarget(declarations: int) -> int {
		var packed = r.read_sleb32(), write = packed < 0;
		var index = if(write, ~packed, packed);
		if (u32.view(index) >= u32.view(declarations)) {
			r.fail("invalid declaration index");
			return 0;
		}
		return index | if(write, int.min);
	}
	// A source type's declaration ID plus one, or zero for no location.
	def readOptionalTarget(declarations: int) -> int {
		var i = r.read_sleb32();
		if (i < 0 || i > declarations) {
			r.fail("invalid type declaration index");
			return 0;
		}
		return i;
	}
	def readTarget(declarations: int) -> int {
		var i = r.read_sleb32();
		if (u32.view(i) >= u32.view(declarations)) {
			r.fail("invalid declaration index");
			return 0;
		}
		return i;
	}
	// A string table entry, which is never null.
	def readStringIndex(strings: Array<string>) -> string {
		var i = readStringId(strings);
		return if(r.ok, strings[i]);
	}
	// The index of a string table entry, which is never null.
	def readStringId(strings: Array<string>) -> int {
		var i = r.read_sleb32();
		if (u32.view(i) >= u32.view(strings.length) || strings[i] == null) {
			r.fail("invalid string index");
			return 0;
		}
		return i;
	}
	// A string table index plus one, or zero for null.
	def readOptionalString(strings: Array<string>) -> string {
		var i = r.read_sleb32();
		if (i == 0) return null;
		if (u32.view(i - 1) >= u32.view(strings.length) || strings[i - 1] == null) {
			r.fail("invalid string index");
			return null;
		}
		return strings[i - 1];
	}
	// Returns {index} if it is below {count} and not {disordered}.
	def checkIndex(index: int, count: int, disordered: bool) -> int {
		if (u32.view(index) >= u32.view(count) || disordered) {
			r.fail("invalid occurrence index");
			return 0;
		}
		return index;
	}
	// Checks that declarations {first} to {first + count} are declared in
	// {path}, with nonempty byte ranges in order and not overlapping, so
	// that a binary search finds them, and that they start at or after
	// {after}, the end of the previous file's run.
	def checkSites(declarations: Array<AnalysisDeclaration>, path: string, after: int, first: int, count: int) -> bool {
		if (!r.ok) return false;
		if (first < after || count < 0 || count > declarations.length - first) {
			r.fail("invalid declaration sites");
			return false;
		}
		var end = 0;
		for (i = first; i < first + count; i++) {
			var range = declarations[i].range;
			if (range.path != path || range.beginOffset < end || range.endOffset <= range.beginOffset) {
				r.fail("invalid declaration sites");
				return false;
			}
			end = range.endOffset;
		}
		return true;
	}
	// Reads a use's line, column, byte offset, and length into {a} from
	// index {i}, and returns its end offset. A use is a token span that
	// starts at or after {end}, the end of the previous use, so that uses
	// are in byte order without overlaps, as a binary search requires.
	def readSpan(a: Array<int>, i: int, end: int) -> int {
		var line = r.read_sleb32(), column = r.read_sleb32(), offset = r.read_sleb32(), length = r.read_sleb32();
		if (line < 1 || column < 1 || offset < end || length < 1 || length > int.max - offset || length > int.max - column) {
			r.fail("invalid use range");
			return end;
		}
		a[i] = line;
		a[i + 1] = column;
		a[i + 2] = offset;
		a[i + 3] = length;
		return offset + length;
	}
	// Checks that no occurrence in {ranges}, four ints each, overlaps a
	// builtin use in {builtins}, five ints each. Both are in byte order.
	def checkDisjoint(ranges: Array<int>, builtins: Array<int>) {
		var i = 0, k = 0;
		while (r.ok && i < ranges.length && k < builtins.length) {
			var o = ranges[i + 2], b = builtins[k + 2];
			if (o + ranges[i + 3] <= b) i += 4;
			else if (b + builtins[k + 3] <= o) k += 5;
			else r.fail("builtin use overlaps an occurrence");
		}
	}
	// A sparse type-target map. Every key must begin a recorded use or
	// declaration name, strictly in source order. Bounds apply even to a
	// no-parse snapshot; no index can escape the declaration table.
	def readTypeTargets(file: AnalysisSnapshotFile, declarations: Array<AnalysisDeclaration>) -> AnalysisSnapshotTypeTargets {
		var count = r.read_sleb32(), start = r.pos;
		if (count < 0 || count > r.available() / 2) {
			r.fail("invalid type target count");
			return null;
		}
		if (count == 0) return null;
		if (count > file.targets.length + file.builtinCount() + file.siteCount) {
			r.fail("too many type targets");
			return null;
		}
		var blocks = (count + 31) / 32;
		if (!reserve(64 + 8L * blocks)) return null;
		var checkpoints = Array<int>.new(2 * blocks), previous = -1;
		var occurrence = 0, builtin = 0, site = file.firstSite;
		for (i = 0; i < count && r.ok; i++) {
			var delta = r.read_sleb32(), offset = if(i % 32 == 0, long.view(delta), long.view(previous) + delta);
			if (delta < 0 || offset <= previous || offset > int.max) {
				r.fail("invalid type target offset");
				break;
			}
			var at = int.view(offset);
			// Keys are strictly increasing, and all three name streams were
			// validated above. Equality requires a name's beginning, never an
			// interior byte or a gap; advancing preserves the same checks.
			while (occurrence < file.targets.length && file.ranges[4 * occurrence + 2] < at) occurrence++;
			while (builtin < file.builtinCount() && file.builtins[5 * builtin + 2] < at) builtin++;
			while (site < file.firstSite + file.siteCount && declarations[site].range.beginOffset < at) site++;
			var found = (occurrence < file.targets.length && file.ranges[4 * occurrence + 2] == at)
				|| (builtin < file.builtinCount() && file.builtins[5 * builtin + 2] == at)
				|| (site < file.firstSite + file.siteCount && declarations[site].range.beginOffset == at);
			if (!found) r.fail("type target has no recorded name");
			if (i % 32 == 0) {
				checkpoints[2 * (i / 32)] = at;
				checkpoints[2 * (i / 32) + 1] = r.pos - start;
			}
			readOptionalTarget(declarations.length);
			previous = at;
		}
		return if(count > 0, AnalysisSnapshotTypeTargets.new(copyFrom(start, 64), checkpoints));
	}
	// Reads the signature text and the signatures, which the snapshot keeps
	// in their encoding. A string reference is a string table index or, past
	// the table, a signature text index. Signature text is charged as one
	// array, plus an offset for each string; the records, as their bytes,
	// plus an offset for each.
	def readSignatures(strings: Array<string>) -> AnalysisSnapshotSignatures {
		var count = readCount(1, 4), start = r.pos, total = 0;
		for (i < count) {
			var n = r.read_sleb32();
			if (n < 0 || n > r.available()) {
				r.fail("invalid string length");
				break;
			}
			r.skipN(n);
			total += n;
		}
		var text: Array<byte> = [], textOffsets = Array<int>.new(count + 1);
		if (r.ok && reserve(64 + long.view(total))) {
			text = Array<byte>.new(total);
			var t = DataReader.new(r.data).at(start), end = 0;
			for (i < count) {
				var n = t.read_sleb32();
				for (k < n) text[end + k] = t.data[t.pos + k];
				t.skipN(n);
				end += n;
				textOffsets[i + 1] = end;
			}
		}
		var table = AnalysisSnapshotSignatures.new(strings, text, textOffsets, [], []);
		// Each record is a label reference, a parameter offset, and a count.
		var records = readCount(3, 4), offsets = Array<int>.new(records);
		start = r.pos;
		for (i = 0; i < records && r.ok; i++) {
			offsets[i] = r.pos - start;
			var label = readStringRef(table), offset = r.read_sleb32();
			if (r.ok && (offset < 0 || offset > table.length(label))) r.fail("invalid parameter offset");
			var n = r.read_sleb32(), end = long.view(offset);
			if (n < 0 || n > r.available()) r.fail("invalid parameter count");
			// Laid out from the offset with separators, as the label lists
			// them, the parameters end at an offset that an int holds.
			for (k = 0; k < n && r.ok; k++) {
				var p = readStringRef(table);
				if (!r.ok) break;
				end += table.length(p) + if(k > 0, 2);
				if (end > int.max) r.fail("parameters past the last offset");
			}
		}
		return AnalysisSnapshotSignatures.new(strings, text, textOffsets, copyFrom(start, 64), offsets);
	}
	private def readStringRef(table: AnalysisSnapshotSignatures) -> int {
		var i = r.read_sleb32();
		if (!table.valid(i)) {
			r.fail("invalid string index");
			return 0;
		}
		return i;
	}
	// Reads {file}'s calls, which the snapshot keeps in their encoding,
	// charged as their bytes, and checks each: their opening parentheses
	// strictly increase, their argument lists nest, a callee is one of the
	// file's uses, and a signature is one of {signatures}.
	def readCalls(file: AnalysisSnapshotFile, signatures: AnalysisSnapshotSignatures) {
		// The open delta, head, and signature take a byte each.
		var count = readCount(3, 0), start = r.pos;
		var cursor = AnalysisCallCursor.new(r, count), closes = Array<int>.new(16), depth = 0;
		while (cursor.next()) {
			var open = cursor.open;
			if (cursor.calleeEndsAtParen()) {
				if (file.useEndingAt(open) < 0) r.fail("invalid callee");
			} else if (cursor.calleeDelta > 0) {
				if (file.useAt(open - cursor.calleeDelta) < 0) r.fail("invalid callee");
			}
			if (cursor.signature > signatures.count()) r.fail("invalid signature index");
			for (i = 0; i < cursor.argCount && r.ok; i++) cursor.nextArg();
			if (!r.ok || !cursor.finish()) break;
			while (depth > 0 && closes[depth - 1] <= open) depth--;
			if (depth > 0 && cursor.close > closes[depth - 1]) {
				r.fail("argument lists that do not nest");
				break;
			}
			if (depth == closes.length) closes = Arrays.grow(closes, 2 * depth);
			closes[depth++] = cursor.close;
		}
		if (r.ok) file.setCalls(count, copyFrom(start, 0));
	}
	// Reads a call answer (AnalysisWire.encodeCall) for a result with
	// {declarations} and {signatures}: one call, checked as a file's first
	// call is, whose callee is an offset, not a use, and whose signature is
	// one of {signatures}, then its callee's declaration index plus one, or
	// zero. The call is charged 64 bytes, and 8 for each argument; its
	// signature, 64 bytes, 8 for each parameter, and the signature text that
	// it copies (AnalysisSnapshotSignatures.copiedBytes).
	def readCall(declarations: Array<AnalysisDeclaration>, signatures: AnalysisSnapshotSignatures) -> AnalysisCall {
		var cursor = AnalysisCallCursor.new(r, 1);
		if (!cursor.next()) return null;
		if (cursor.calleeEndsAtParen()) r.fail("invalid callee");
		if (cursor.signature > signatures.count()) r.fail("invalid signature index");
		if (!reserve(64 + 8L * cursor.argCount)) return null;
		var args = Array<int>.new(2 * cursor.argCount);
		for (i = 0; i < cursor.argCount && r.ok; i++) {
			if (!cursor.nextArg()) break;
			args[2 * i] = cursor.argBegin;
			args[2 * i + 1] = cursor.argEnd;
		}
		if (!r.ok || !cursor.finish()) return null;
		var target = r.read_sleb32() - 1;
		if (target < -1 || target >= declarations.length) {
			r.fail("invalid declaration index");
			return null;
		}
		var s: AnalysisSignature;
		if (cursor.signature > 0) {
			var i = cursor.signature - 1;
			if (!reserve(64 + signatures.copiedBytes(i))) return null;
			s = signatures.signature(i, AnalysisSignatureReader.new(signatures));
		}
		var callee = if(cursor.calleeDelta > 0, cursor.open - cursor.calleeDelta, -1);
		return AnalysisCall.new(cursor.open, cursor.close, args, callee, if(target >= 0, declarations[target]), s);
	}
	// Reads a scope answer (AnalysisWire.encodeResultWithScope) for a result
	// with {declarations} declarations: at most MAX_DECLARATIONS candidates,
	// each a different declaration, with levels that never decrease. Each
	// candidate takes at least two bytes and is charged its index and level.
	def readScope(declarations: int) -> AnalysisSnapshotScope {
		var flags = r.read1(), thisLevel = r.read_sleb32();
		if (flags > AnalysisWire.SCOPE_TRUNCATED || thisLevel < -1) {
			r.fail("invalid scope");
			return null;
		}
		var count = readCount(2, 8);
		if (count > AnalysisScopeOrder.MAX_DECLARATIONS) {
			r.fail("too many scope declarations");
			return null;
		}
		var indices = Array<int>.new(count), levels = Array<int>.new(count), previous = 0;
		for (i = 0; i < count && r.ok; i++) {
			indices[i] = readTarget(declarations);
			var level = r.read_sleb32();
			if (level < previous) r.fail("invalid scope level");
			levels[i] = previous = level;
		}
		if (!r.ok) return null;
		var sorted = AnalysisTables.sort(Arrays.dup(indices), int.<);
		for (i = 1; i < sorted.length; i++) {
			if (sorted[i] == sorted[i - 1]) {
				r.fail("repeated scope declaration");
				return null;
			}
		}
		var hiddenCount = readCount(1, 8);
		if (hiddenCount > AnalysisScopeOrder.MAX_DECLARATIONS) {
			r.fail("too many hidden builtin names");
			return null;
		}
		var hidden = Array<string>.new(hiddenCount), seen = Strings.newMap<bool>();
		for (i = 0; i < hiddenCount && r.ok; i++) {
			var name = readString(1);
			if (name == null || name.length == 0 || seen.has(name)) r.fail("invalid hidden builtin name");
			else seen[name] = true;
			hidden[i] = name;
		}
		return AnalysisSnapshotScope.new(indices, levels, thisLevel, flags == AnalysisWire.SCOPE_TRUNCATED, hidden);
	}
	// Reads a member answer (AnalysisWire.encodeResultWithQuery) for a result
	// with {declarations} and {strings}: at most MAX_DECLARATIONS candidates,
	// each a declaration of a member's kind or a builtin member of such a
	// kind with a name, with levels that never decrease, and no declaration
	// or name twice: a member of a name hides any other further up. A
	// candidate takes at least three bytes and is charged its five slots;
	// its strings are in the string table.
	def readMembers(declarations: Array<AnalysisDeclaration>, strings: Array<string>) -> AnalysisSnapshotMembers {
		var flags = r.read1();
		if (flags > AnalysisWire.SCOPE_TRUNCATED) {
			r.fail("invalid member answer");
			return null;
		}
		var count = readCount(3, 32);
		if (count > AnalysisScopeOrder.MAX_DECLARATIONS) {
			r.fail("too many members");
			return null;
		}
		var indices = Array<int>.new(count), names = Array<string>.new(count), kinds = Array<AnalysisDeclKind>.new(count);
		var details = Array<string>.new(count), levels = Array<int>.new(count), previous = 0;
		for (i = 0; i < count && r.ok; i++) {
			var index = r.read_sleb32() - 1;
			if (index == -1) {
				kinds[i] = readKind();
				names[i] = readStringIndex(strings);
				if (r.ok && names[i].length == 0) r.fail("invalid member name");
			} else if (u32.view(index) < u32.view(declarations.length)) {
				kinds[i] = declarations[index].kind;
				names[i] = declarations[index].name;
			} else {
				r.fail("invalid declaration index");
				break;
			}
			if (r.ok && !memberKind(kinds[i])) r.fail("invalid member kind");
			indices[i] = index;
			details[i] = readOptionalString(strings);
			var level = r.read_sleb32();
			if (level < previous) r.fail("invalid member level");
			levels[i] = previous = level;
		}
		if (!r.ok) return null;
		var sorted = AnalysisTables.sort(Arrays.dup(indices), int.<);
		for (i = 1; i < sorted.length; i++) {
			if (sorted[i] >= 0 && sorted[i] == sorted[i - 1]) {
				r.fail("repeated member declaration");
				return null;
			}
		}
		var byName = AnalysisTables.sort(Arrays.dup(names), fun (a: string, b: string) => AnalysisTables.compareBytes(a, b) < 0);
		for (i = 1; i < byName.length; i++) {
			if (Strings.equal(byName[i], byName[i - 1])) {
				r.fail("repeated member name");
				return null;
			}
		}
		return AnalysisSnapshotMembers.new(indices, names, kinds, details, levels, flags == AnalysisWire.SCOPE_TRUNCATED);
	}
	// The kinds of declaration that a member can be: a builtin member
	// pretends to one of them too, and "set" of an enum type is a type.
	private def memberKind(kind: AnalysisDeclKind) -> bool {
		match (kind) {
			FIELD, METHOD, CONSTRUCTOR, CLASS, ENUM_CASE, VARIANT_CASE, LAYOUT_FIELD => return true;
			_ => return false;
		}
	}
	// The bytes read since {start}, charged with {header} more for their array.
	private def copyFrom(start: int, header: int) -> Array<byte> {
		var n = r.pos - start;
		if (!r.ok || !reserve(long.view(header) + n)) return [];
		return Ranges.dup(r.data[start ..+ n]);
	}
	def readKind() -> AnalysisDeclKind {
		var tag = r.read1();
		if (tag >= AnalysisWire.DECL_KINDS.length) {
			r.fail("invalid declaration kind");
			return AnalysisDeclKind.LOCAL;
		}
		return AnalysisWire.DECL_KINDS[tag];
	}
	def readRange(path: string) -> AnalysisRange {
		return AnalysisRange.new(path, r.read_sleb32(), r.read_sleb32(), r.read_sleb32(), r.read_sleb32(),
			r.read_sleb32(), r.read_sleb32());
	}
}

// Reads a file's call records (see OccurrenceCollector.calls) and decides
// which to send: those whose spans and signature are valid, in order, and
// whose argument lists nest, as the decoder requires. The collector makes no
// other kind. Allocates only to grow its stack of closing parentheses.
class AnalysisCallCheck(signatures: int) {
	private def closes = Vector<int>.new();
	private var cursor: AnalysisCallCursor;
	private var previous: int;

	// Starts on {records}, and returns the cursor that reads each call.
	def start(records: (Range<byte>, int)) -> AnalysisCallCursor {
		cursor = AnalysisCallCursor.new(DataReader.new(records.0), records.1);
		cursor.absolute = true;
		closes.length = 0;
		previous = -1;
		return cursor;
	}
	// Reads the rest of the call whose head the cursor has read, and returns
	// whether to send it.
	def sends() -> bool {
		var c = cursor;
		for (i < c.argCount) if (!c.nextArg()) return false;
		if (!c.finish() || c.open <= previous || c.signature > signatures) return false;
		while (closes.length > 0 && closes[closes.length - 1] <= c.open) closes.length--;
		if (closes.length > 0 && c.close > closes[closes.length - 1]) return false;
		closes.put(c.close);
		previous = c.open;
		return true;
	}
}
