// Replays the pinned Parser.skipToNextToken column rules over source bytes.
// Checkpoints bound spans whose columns advance one per byte. Unlike the
// context-free PositionMap conversions, tabs in block comments and literals
// count as one byte, and line comments freeze the column until their newline.
// This helper is shared by whole-program range consumers; it does no I/O.
class AnalysisCoordinates {
	private def points = Vector<(int, int, int)>.new(); // line, column, byte offset
	private var eofLine: int;
	private var eofColumn: int;
	private var length: int;

	new(input: Array<byte>) {
		length = input.length;
		var i = 0, line = 1, column = 1;
		points.put((line, column, i));
		while (i < length) {
			var b = input[i];
			if (b == '\"' || b == '\'') {
				// The parser consumes a valid literal with advance(length), not
				// the whitespace skipper. Comment markers and tabs are literal
				// bytes here. Invalid literals leave the parser at their opener.
				var size = if(b == '\"', Strings.parseLiteral(input, i).0, Chars.parseLiteral(input, i).0);
				if (size > 0) {
					i += size;
					column += size;
					continue;
				}
			}
			if (b == '/' && i + 1 < length && input[i + 1] == '/') {
				points.put((line, column, i));
				i += 2;
				while (i < length && input[i] != '\n') i++;
				points.put((line, column, i));
				continue;
			}
			if (b == '/' && i + 1 < length && input[i + 1] == '*') {
				i += 2;
				column += 2;
				while (i < length) {
					if (input[i] == '\n') {
						points.put((line, column, i));
						i++;
						line++;
						column = 1;
						points.put((line, column, i));
					} else if (input[i] == '*' && i + 1 < length && input[i + 1] == '/') {
						i += 2;
						column += 2;
						break;
					} else {
						i++;
						column++;
					}
				}
				continue;
			}
			if (b == '\n' || b == '\t') {
				points.put((line, column, i));
				i++;
				if (b == '\n') {
					line++;
					column = 1;
				} else column = 1 + ((column + 8) / 8) * 8;
				points.put((line, column, i));
			} else {
				i++;
				column++;
			}
		}
		eofLine = line;
		eofColumn = column;
		points.put((line, column, length));
	}

	// Nonempty ranges use the first offset at a coordinate: a token end
	// must not drift over a following line comment with that same column.
	// A point error at the EOF coordinate instead denotes the actual EOF.
	def offset(line: int, column: int, point: bool) -> int {
		if (point && line == eofLine && column == eofColumn) return length;
		var low = 0, high = points.length;
		while (low < high) {
			var mid = low + (high - low) / 2, p = points[mid];
			if (p.0 < line || (p.0 == line && p.1 < column)) low = mid + 1;
			else high = mid;
		}
		if (low < points.length) {
			var p = points[low];
			if (p.0 == line && p.1 == column) return p.2;
		}
		if (low == 0) return 0;
		var prev = points[low - 1];
		if (prev.0 != line) return prev.2;
		var end = if(low < points.length, points[low].2, length);
		// A column inside a tab expansion maps to the tab, not its end.
		if (low < points.length && points[low].0 == line &&
			points[low].1 - prev.1 > points[low].2 - prev.2) return prev.2;
		var delta = column - prev.1;
		if (delta < 0) delta = 0;
		if (delta > end - prev.2) delta = end - prev.2;
		return prev.2 + delta;
	}
}

// Lazily builds one replay map per referenced source path, preserving the
// first source if paths repeat, as the program's binding index does.
class AnalysisSourceCoordinates {
	private def inputs = Strings.newMap<Array<byte>>();
	private def maps = Strings.newMap<AnalysisCoordinates>();
	new(sources: Array<AnalysisSource>) {
		for (s in sources) {
			if (s.path != null && !inputs.has(s.path)) inputs[s.path] = if(s.input == null, Array<byte>.new(0), s.input);
		}
	}
	def diagnostic(d: AnalysisDiagnostic) {
		if (d.path == null || !inputs.has(d.path)) return;
		var map = maps[d.path];
		if (map == null) {
			map = AnalysisCoordinates.new(inputs[d.path]);
			maps[d.path] = map;
		}
		var point = d.beginLine == d.endLine && d.beginColumn == d.endColumn;
		d.beginOffset = map.offset(d.beginLine, d.beginColumn, point);
		d.endOffset = map.offset(d.endLine, d.endColumn, point);
	}
}
