// Replays the pinned Parser.skipToNextToken column rules over source bytes.
// Checkpoints bound spans whose columns advance one per byte. Unlike the
// context-free PositionMap conversions, tabs in block comments and literals
// count as one byte, and line comments freeze the column until their newline.
// This helper is shared by whole-program range consumers; it does no I/O.
class AnalysisCoordinates {
	private def points = Vector<(int, int, int)>.new(); // line, column, byte offset
	private var eofLine: int;
	private var eofColumn: int;
	private var length: int;

	new(input: Array<byte>) {
		length = input.length;
		var i = 0, line = 1, column = 1, literalEnd = 0;
		points.put((line, column, i));
		while (i < length) {
			var b = input[i];
			if (i >= literalEnd && (b == '\"' || b == '\'')) {
				// The parser consumes a valid literal with advance(length), not
				// the whitespace skipper. Comment markers and tabs are literal
				// bytes here. Invalid literals leave the parser at their opener.
				var size = if(b == '\"', Strings.parseLiteral(input, i).0, Chars.parseLiteral(input, i).0);
				literalEnd = i + Ints.max(1, -size);
				if (size > 0) {
					i += size;
					column += size;
					continue;
				}
			}
			if (b == '/' && i + 1 < length && input[i + 1] == '/') {
				points.put((line, column, i));
				i += 2;
				while (i < length && input[i] != '\n') i++;
				points.put((line, column, i));
				continue;
			}
			if (b == '/' && i + 1 < length && input[i + 1] == '*') {
				i += 2;
				column += 2;
				while (i < length) {
					if (input[i] == '\n') {
						points.put((line, column, i));
						i++;
						line++;
						column = 1;
						points.put((line, column, i));
					} else if (input[i] == '*' && i + 1 < length && input[i + 1] == '/') {
						i += 2;
						column += 2;
						break;
					} else {
						i++;
						column++;
					}
				}
				continue;
			}
			if (b == '\n' || b == '\t') {
				points.put((line, column, i));
				i++;
				if (b == '\n') {
					line++;
					column = 1;
				} else column = 1 + ((column + 8) / 8) * 8;
				points.put((line, column, i));
			} else {
				i++;
				column++;
			}
		}
		eofLine = line;
		eofColumn = column;
		points.put((line, column, length));
	}

	// Nonempty ranges use the first offset at a coordinate: a token end
	// must not drift over a following line comment with that same column.
	// A point error at the EOF coordinate instead denotes the actual EOF.
	def offset(line: int, column: int, point: bool) -> int {
		if (point && line == eofLine && column == eofColumn) return length;
		var low = 0, high = points.length;
		while (low < high) {
			var mid = low + (high - low) / 2, p = points[mid];
			if (p.0 < line || (p.0 == line && p.1 < column)) low = mid + 1;
			else high = mid;
		}
		if (low < points.length) {
			var p = points[low];
			if (p.0 == line && p.1 == column) return p.2;
		}
		if (low == 0) return 0;
		var prev = points[low - 1];
		if (prev.0 != line) return prev.2;
		var end = if(low < points.length, points[low].2, length);
		// A column inside a tab expansion maps to the tab, not its end.
		if (low < points.length && points[low].0 == line &&
			points[low].1 - prev.1 > points[low].2 - prev.2) return prev.2;
		var delta = column - prev.1;
		if (delta < 0) delta = 0;
		if (delta > end - prev.2) delta = end - prev.2;
		return prev.2 + delta;
	}
}

// Maps long keys, such as packed compiler coordinates or byte offsets, to
// values. The parser records positions in increasing order, so a new key is
// normally appended and lookups use binary search; an earlier key is inserted
// in place. HashMap stops growing its table at 1024 buckets, so its lookups
// slow down in proportion to the number of tokens in a file. Parsers clear
// and reuse one index for each file: a whole program's worth of discarded
// arrays would trigger an extra collection of the program in the worker heap.
class AnalysisPositionIndex<V> {
	private var keys = Array<long>.new(64);
	private var values = Array<V>.new(64);
	private var length: int;

	// Records {value} at {key}, replacing an existing value only if {replace}.
	def set(key: long, value: V, replace: bool) {
		var n = length;
		if (n == 0 || keys[n - 1] < key) {
			if (n == keys.length) grow();
			keys[n] = key;
			values[n] = value;
			length = n + 1;
			return;
		}
		var i = if(keys[n - 1] == key, n - 1, search(key));
		if (keys[i] == key) {
			if (replace) values[i] = value;
			return;
		}
		if (n == keys.length) grow();
		for (j = n; j > i; j--) {
			keys[j] = keys[j - 1];
			values[j] = values[j - 1];
		}
		keys[i] = key;
		values[i] = value;
		length = n + 1;
	}
	def has(key: long) -> bool {
		var i = search(key);
		return i < length && keys[i] == key;
	}
	// Removes every key, keeping the arrays.
	def clear() {
		length = 0;
	}
	// The value at {key}, or {none} if there is none.
	def get(key: long, none: V) -> V {
		var i = search(key);
		return if(i < length && keys[i] == key, values[i], none);
	}
	private def grow() {
		keys = Arrays.grow(keys, keys.length * 2);
		values = Arrays.grow(values, values.length * 2);
	}
	// The index of the first key not less than {key}.
	private def search(key: long) -> int {
		var low = 0, high = length;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (keys[mid] < key) low = mid + 1;
			else high = mid;
		}
		return low;
	}
}

// A token that the analysis parser extracted from source, with the UTF-8 byte
// offset of its first byte. Names that the compiler manufactures, such as an
// index method's "[]", are plain {Token}s.
class AnalysisCapturedToken extends Token {
	def offset: int;
	new(fileName: string, image: Array<byte>, beginLine: int, beginColumn: int, offset)
		super(fileName, image, beginLine, beginColumn) { }
}

// A token that the parser extracted after moving past it (ParserState.tokenAt).
// Its exported coordinates keep the pinned compiler's context-free columns;
// {sourceLine} and {sourceColumn} are the live parser coordinates.
class AnalysisRetrospectiveToken extends AnalysisCapturedToken {
	def sourceLine: int;
	def sourceColumn: int;
	new(t: Token, offset: int, sourceLine, sourceColumn)
		super(t.fileName, t.image, t.beginLine, t.beginColumn, offset) { }
	def rangeOf(len: int) -> FileRange {
		return FileRange.new(fileName, sourceLine, sourceColumn, sourceLine, sourceColumn + len);
	}
}

// Captures one file's retrospective tokens. {positions} serves only while the
// file is parsed, so consecutive files share it.
class AnalysisTokenCoordinates {
	private def positions: AnalysisPositionIndex<(int, int)>;
	private def begins = AnalysisPositionIndex<(int, int, int)>.new();
	private def ends = AnalysisPositionIndex<(int, int, int)>.new();
	new(positions) {
		positions.clear();
	}
	def record(p: ParserState) { positions.set(p.curPos, (p.curLine, p.curCol), true); }
	def token(t: Token, begin: int, end: int) -> Token {
		var p = positions.get(begin, (0, 0));
		begins.set(key(p.0, p.1), (t.beginLine, t.beginColumn, begin), true);
		ends.set(key(p.0, p.1 + end - begin), (t.beginLine, t.beginColumn + end - begin, end), true);
		return AnalysisRetrospectiveToken.new(t, begin, p.0, p.1);
	}
	def diagnostic(d: AnalysisDiagnostic) -> AnalysisDiagnostic {
		var point = d.beginLine == d.endLine && d.beginColumn == d.endColumn;
		if (point && d.beginOffset >= 0 && d.endOffset >= 0) return d;
		var bkey = key(d.beginLine, d.beginColumn), ekey = key(d.endLine, d.endColumn);
		var b = (d.beginLine, d.beginColumn, d.beginOffset), e = (d.endLine, d.endColumn, d.endOffset);
		b = begins.get(bkey, b);
		e = ends.get(ekey, e);
		if (point) {
			if (begins.has(bkey)) e = b;
			else if (ends.has(ekey)) b = e;
		}
		var result = AnalysisDiagnostic.new(d.path, b.0, b.1, e.0, e.1, d.kind, d.message);
		result.beginOffset = if(d.beginOffset >= 0, d.beginOffset, b.2);
		result.endOffset = if(d.endOffset >= 0, d.endOffset, e.2);
		return result;
	}
	// Orders coordinates by line, then column.
	private def key(line: int, column: int) -> long { return (long.!(line) << 32) | u32.view(column); }
}

// Maps whole-program diagnostics to byte offsets: through each file's captured
// retrospective tokens, then its replay map, built only for files with
// diagnostics. The first source is kept if paths repeat, as the program's
// binding index does.
class AnalysisSourceCoordinates {
	private def maps = AnalysisSourceMaps.new();
	private def tokens = Strings.newMap<AnalysisTokenCoordinates>();
	private def positions = AnalysisPositionIndex<(int, int)>.new();
	new(sources: Array<AnalysisSource>) {
		for (s in sources) maps.add(s.path, s.input);
	}
	def capture(path: string) -> AnalysisTokenCoordinates {
		var result = AnalysisTokenCoordinates.new(positions);
		if (!tokens.has(path)) tokens[path] = result;
		return result;
	}
	def diagnostic(d: AnalysisDiagnostic) -> AnalysisDiagnostic {
		if (d.path == null) return d;
		var map = maps.map(d.path);
		if (map == null) return d;
		var captured = tokens[d.path];
		if (captured != null) d = captured.diagnostic(d);
		var point = d.beginLine == d.endLine && d.beginColumn == d.endColumn;
		if (d.beginOffset < 0) d.beginOffset = map.offset(d.beginLine, d.beginColumn, point);
		if (d.endOffset < 0) d.endOffset = map.offset(d.endLine, d.endColumn, point);
		return d;
	}
}

// The source bytes of a program's files by path, each with a replay map built
// on first use. The first source is kept if paths repeat. The worker-side
// {ProgramAnalysis} keeps one for lazy binding collection; the server never
// holds source bytes this way.
class AnalysisSourceMaps {
	private def inputs = Strings.newMap<Array<byte>>();
	private def maps = Strings.newMap<AnalysisCoordinates>();

	// A missing capture is empty source, as in AeneasAdapter.analyzeProgram.
	def add(path: string, input: Array<byte>) {
		if (path != null && !inputs.has(path)) inputs[path] = if(input == null, Array<byte>.new(0), input);
	}
	// The replay map of {path}, or null if it has no source.
	def map(path: string) -> AnalysisCoordinates {
		if (path == null) return null;
		var map = maps[path];
		if (map == null) {
			var input = inputs[path];
			if (input == null) return null;
			map = AnalysisCoordinates.new(input);
			maps[path] = map;
		}
		return map;
	}
	// The range of {token}, with byte offsets in its own file. A token the
	// parser extracted carries its offset, and its image is its source text.
	// A name the compiler manufactures is located by replaying its live
	// coordinates, and its span covers only the bytes that the source spells
	// of it there. An index method declaration, such as "def [i: int]", is
	// named "[]" or "[]=" at its opening bracket, and selects just that
	// bracket. Offsets are -1 if the file has no source. Compiler coordinates
	// are the token's own, ending after its image.
	def range(token: Token) -> AnalysisRange {
		var line = token.beginLine, column = token.beginColumn, image = token.image;
		var begin = -1, end = -1;
		if (AnalysisCapturedToken.?(token)) {
			begin = AnalysisCapturedToken.!(token).offset;
			end = begin + image.length;
		} else {
			var map = map(token.fileName);
			if (map != null) {
				var input = inputs[token.fileName];
				var length = if(image.length > 0 && image[0] == '[', 1, image.length);
				begin = end = map.offset(line, column, false);
				while (end - begin < length && end < input.length && input[end] == image[end - begin]) end++;
			}
		}
		return AnalysisRange.new(token.fileName, line, column, line, column + image.length, begin, end);
	}
}
