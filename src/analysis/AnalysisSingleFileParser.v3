// Parser driver adapted from the pinned Aeneas Parser.v3; see THIRD_PARTY_NOTICES.md.

class AnalysisParseErrors extends ErrorGen {
	var parser: ParserState;
	def offsets = Vector<(int, int)>.new();
	private var positions = Strings.newMap<int>();

	def startFile() {
		parser = null;
		positions = Strings.newMap<int>();
	}

	new(maxErrors: int) super(maxErrors) { }

	def record(p: ParserState) {
		parser = p;
		// Preserve token ends when a trailing line comment later reaches EOF
		// with the same compiler column. Empty current-point errors use curPos.
		recordPosition(p.curLine, p.curCol, p.curPos);
	}
	def recordToken(token: Token, begin: int, end: int) {
		var range = token.range();
		recordPosition(range.beginLine, range.beginColumn, begin);
		recordPosition(range.endLine, range.endColumn, end);
	}
	private def recordPosition(line: int, column: int, pos: int) {
		var key = coordinate(line, column);
		if (!positions.has(key)) positions[key] = pos;
	}
	def addError(range: FileRange, sourceLine: string, error: string, msg: string) {
		var begin = -1, end = -1;
		if (range != null && parser != null) {
			if (range.beginLine == parser.curLine && range.endLine == parser.curLine &&
				range.beginColumn == parser.curCol && range.endColumn == parser.curCol) {
				begin = end = parser.curPos;
			} else {
				begin = offset(range.beginLine, range.beginColumn);
				end = offset(range.endLine, range.endColumn);
			}
		}
		offsets.put((begin, end));
		errors = List.new(Error.new(range, sourceLine, error, msg), errors);
		incErrors();
		if (parser != null && Strings.equal(msg, "invalid start of expression") &&
			parser.curByte == '.' && parser.peek(1) == '.' &&
			(parser.peek(2) == '.' || parser.peek(2) == '+')) {
			parser.advance(3);
		}
	}
	private def coordinate(line: int, column: int) -> string {
		return Strings.format2("%d:%d", line, column);
	}
	private def offset(line: int, column: int) -> int {
		var key = coordinate(line, column);
		return if(positions.has(key), positions[key], -1);
	}
}

// Observes each parser skip for diagnostic offsets and, for outlines, for the
// symbol syntax index. Created before the parser state, whose constructor skips.
class AnalysisParseSkipper(errors: AnalysisParseErrors, syntax: SymbolSyntaxIndex, coordinates: AnalysisTokenCoordinates) {
	def skip(p: ParserState) {
		errors.record(p);
		if (syntax != null) syntax.finish(p);
		Parser.skipToNextToken(p);
		errors.record(p);
		if (syntax != null) syntax.start(p);
		if (coordinates != null) coordinates.record(p);
	}
}

class AnalysisParserState extends ParserState {
	def coordinates: AnalysisTokenCoordinates;
	new(file: VstFile, errors: AnalysisParseErrors, syntax: SymbolSyntaxIndex, typeCache: TypeCache, coordinates)
		super(file, errors, AnalysisParseSkipper.new(errors, syntax, coordinates).skip, typeCache) { }

	def tokenAt(start: int, end: int) -> Token {
		var t = Token.new(fileName, Arrays.range(input, start, end), line(start), column(start));
		if (coordinates != null) {
			t = coordinates.token(t, start, end);
			AnalysisParseErrors.!(ERROR).recordToken(t, start, end);
		}
		return t;
	}

	def token(len: int) -> Token {
		var end = curPos + len;
		if (end > input.length) end = input.length;
		var t = Token.new(fileName, Arrays.range(input, curPos, end), curLine, curCol);
		AnalysisParseErrors.!(ERROR).recordToken(t, curPos, end);
		advance(t.image.length);
		return t;
	}
}

// The single-file parser driver shared by parser diagnostics and document
// symbols, so both get the same recovery. {syntax} may be null.
component AnalysisSingleFileParser {
	def parse(path: string, input: Array<byte>, errors: AnalysisParseErrors, syntax: SymbolSyntaxIndex,
			typeCache: TypeCache, coordinates: AnalysisTokenCoordinates) -> VstFile {
		var file = VstFile.new(path, input);
		errors.startFile();
		var p = AnalysisParserState.new(file, errors, syntax, typeCache, coordinates);
		p.enableFunExprs = CLOptions.FUN_EXPRS.get();
		p.enableSimpleBodies = CLOptions.SIMPLE_BODIES.get();
		p.enableOpenTypes = CLOptions.OPEN_TYPES.get();
		p.enableDescriptors = CLOptions.DESCRIPTORS.get();
		while (p.curByte != Parser.END) {
			if (!Parser.parseToplevelDecl(p, file)) break;
		}
		if (syntax != null) syntax.finish(p);
		if (file.synthetic != null) file.synthetic.members = Lists.reverse(file.synthetic.members);
		return file;
	}
}
