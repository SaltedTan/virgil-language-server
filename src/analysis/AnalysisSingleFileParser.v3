// Parser driver adapted from the pinned Aeneas Parser.v3 and ParserState.v3;
// see THIRD_PARTY_NOTICES.md.

class AnalysisParseErrors extends ErrorGen {
	var parser: ParserState;
	def offsets = Vector<(int, int)>.new();
	private def positions = AnalysisPositionIndex<int>.new();

	def startFile() {
		parser = null;
		stopped = false;
		positions.clear();
	}
	// Set once the parser has been stopped early. Later errors describe the
	// cut, not the source, and are dropped.
	var stopped: bool;

	new(maxErrors: int) super(maxErrors) { }

	def record(p: ParserState) {
		parser = p;
		// Preserve token ends when a trailing line comment later reaches EOF
		// with the same compiler column. Empty current-point errors use curPos.
		recordPosition(p.curLine, p.curCol, p.curPos);
	}
	def recordToken(token: Token, begin: int, end: int) {
		var range = token.range();
		recordPosition(range.beginLine, range.beginColumn, begin);
		recordPosition(range.endLine, range.endColumn, end);
	}
	private def recordPosition(line: int, column: int, pos: int) {
		positions.set(coordinate(line, column), pos, false);
	}
	def addError(range: FileRange, sourceLine: string, error: string, msg: string) {
		if (stopped) return;
		var begin = -1, end = -1;
		if (range != null && parser != null) {
			if (range.beginLine == parser.curLine && range.endLine == parser.curLine &&
				range.beginColumn == parser.curCol && range.endColumn == parser.curCol) {
				begin = end = parser.curPos;
			} else {
				begin = offset(range.beginLine, range.beginColumn);
				end = offset(range.endLine, range.endColumn);
			}
		}
		offsets.put((begin, end));
		errors = List.new(Error.new(range, sourceLine, error, msg), errors);
		incErrors();
	}
	// Reports {msg} at the current point and moves {p} to EOF, so the parser
	// unwinds as it would for input that ended here.
	def stop(p: ParserState, msg: string) {
		p.error(msg);
		stopped = true;
		p.setPos(p.input.length, p.curLine, p.curCol);
	}
	// Orders coordinates by line, then column.
	private def coordinate(line: int, column: int) -> long {
		return (long.!(line) << 32) | u32.view(column);
	}
	private def offset(line: int, column: int) -> int {
		return positions.get(coordinate(line, column), -1);
	}
}

// Observes each parser skip for diagnostic offsets and, for outlines, for the
// symbol syntax index. Created before the parser state, whose constructor skips.
class AnalysisParseSkipper(errors: AnalysisParseErrors, syntax: SymbolSyntaxIndex, coordinates: AnalysisTokenCoordinates) {
	// Measure parser stack use from here rather than charging the caller's
	// frames to it. Available stack and compiled frame sizes affect the cutoff.
	private def stackBase = AnalysisSingleFileParser.stackPointer();
	private def stackLimit = AnalysisSingleFileParser.stackLimit(stackBase);
	private def chains = AnalysisChainCounter.new();
	// Where the token that the parser is consuming starts.
	private var tokenStart: int;

	def skip(p: ParserState) {
		var tokenEnd = p.curPos;
		errors.record(p);
		if (syntax != null) syntax.finish(p);
		Parser.skipToNextToken(p);
		errors.record(p);
		if (syntax != null) syntax.start(p);
		if (coordinates != null) coordinates.record(p);
		if (!errors.stopped) {
			// Every level of parser recursion consumes a token, and so skips.
			if (stackBase - AnalysisSingleFileParser.stackPointer() > stackLimit) {
				errors.stop(p, "nesting too deep; parsing stopped here");
			} else if (tokenEnd > tokenStart && chains.add(p.input, tokenStart, tokenEnd) > AnalysisSingleFileParser.CHAIN_LIMIT) {
				errors.stop(p, "expression too long; parsing stopped here");
			}
		}
		tokenStart = p.curPos;
	}
}

// Bounds the operator and suffix chains that the parser builds in loops, out
// of sight of the stack limit. Parser.parseExprStmt passes them to the
// recursive Expr.range() methods, and each level of that recursion has an
// operator, dot, or opening bracket of its own, so a count of those tokens
// bounds its depth. A statement, list element, or block starts a new count,
// and parenthesized text leaves the count when it closes.
class AnalysisChainCounter {
	// Operator, dot, and opening-bracket tokens in the current statement or
	// list element, including those before each enclosing open bracket.
	var count: int;
	// The current level: its opening byte, FUN_BODY, or 0 outside brackets;
	// the count when it opened; its '<' tokens not yet closed, as commas
	// between type arguments do not end an element; and its fun keywords
	// whose body has not started with '{', ';', or '=>'.
	private var kind: byte;
	private var mark: int;
	private var angles: int;
	private var funs: int;
	// The same four values for each enclosing level, innermost last.
	private var outer = Array<int>.new(64);
	private var depth: int;
	// Whether the last token was a dot, which makes the next word a member
	// name, or a keyword whose parenthesis holds a condition, not a call.
	private var dot: bool;
	private var keyword: bool;

	// Counts the token input[start ..< end] and returns the count.
	def add(input: Array<byte>, start: int, end: int) -> int {
		var ch = input[start], afterDot = dot, afterKeyword = keyword;
		dot = keyword = false;
		if (Char.isIdentMiddle(ch)) {
			if (!afterDot && end - start <= 5) {
				match (ch) {
					'i' => keyword = isWord(input, start, end, "if");
					'w' => keyword = isWord(input, start, end, "while");
					'm' => keyword = isWord(input, start, end, "match");
					'f' => {
						keyword = isWord(input, start, end, "for");
						if (isWord(input, start, end, "fun")) funs++;
					}
				}
			}
			return count;
		}
		match (ch) {
			',' => if (angles == 0) count = mark;
			';' => {
				// An empty fun body does not end the enclosing expression.
				if (funs > 0) funs--;
				else {
					count = mark;
					angles = 0;
				}
			}
			// range() does not enter parentheses, but it does follow a range's
			// end inside brackets.
			')' => if (kind == '(') {
				count = mark;
				pop();
			}
			']' => if (kind == '[') pop();
			'}' => {
				var block = kind == '{';
				if (block || kind == FUN_BODY) pop();
				// A block ends a statement or declaration; a fun body does not
				// end the expression around it.
				if (block) {
					count = mark;
					angles = 0;
				}
			}
			'{' => {
				var body = funs > 0;
				if (body) funs--;
				push(if(body, FUN_BODY, '{'));
			}
			'\'', '\"' => ;
			_ => {
				if (end - start > 1) {
					// Includes the member names .[] and .[]=, which are not brackets.
					count++;
					if (ch == '<') angles++;
					if (end - start == 2 && ch == '=' && input[start + 1] == '>' && funs > 0) funs--;
					return count;
				}
				if (ch != '(' || !afterKeyword) count++;
				match (ch) {
					'(', '[' => push(ch);
					'.' => dot = true;
					'<' => angles++;
					'>' => if (angles > 0) angles--;
				}
			}
		}
		return count;
	}
	private def push(opening: byte) {
		if (depth + 4 > outer.length) outer = Arrays.grow(outer, 2 * outer.length);
		outer[depth] = kind;
		outer[depth + 1] = mark;
		outer[depth + 2] = angles;
		outer[depth + 3] = funs;
		depth += 4;
		kind = opening;
		mark = count;
		angles = 0;
		funs = 0;
	}
	private def pop() {
		depth -= 4;
		kind = byte.view(outer[depth]);
		mark = outer[depth + 1];
		angles = outer[depth + 2];
		funs = outer[depth + 3];
	}
	private def isWord(input: Array<byte>, start: int, end: int, word: string) -> bool {
		if (end - start != word.length) return false;
		for (i < word.length) {
			if (input[start + i] != word[i]) return false;
		}
		return true;
	}
}
def FUN_BODY: byte = 'f';

class AnalysisParserState extends ParserState {
	// Set by a malformed number until the parser has skipped past it.
	private var numberFailed: bool;

	def coordinates: AnalysisTokenCoordinates;
	new(file: VstFile, errors: AnalysisParseErrors, syntax: SymbolSyntaxIndex, typeCache: TypeCache, coordinates)
		super(file, errors, AnalysisParseSkipper.new(errors, syntax, coordinates).skip, typeCache) { }

	def tokenAt(start: int, end: int) -> Token {
		var t = Token.new(fileName, Arrays.range(input, start, end), line(start), column(start));
		if (coordinates != null) {
			t = coordinates.token(t, start, end);
			AnalysisParseErrors.!(ERROR).recordToken(t, start, end);
		}
		return t;
	}

	def token(len: int) -> Token {
		var end = curPos + len;
		if (end > input.length) end = input.length;
		var t = Token.new(fileName, Arrays.range(input, curPos, end), curLine, curCol);
		AnalysisParseErrors.!(ERROR).recordToken(t, curPos, end);
		advance(t.image.length);
		return t;
	}
	// The overrides below restate ParserState's methods, as Virgil cannot call
	// an overridden method, and add range recovery. A term that fails to parse
	// leaves an expression without a start, and Parser.parseIndexSuffix then
	// accepts a range operator. Parser.parseExprStmt traps on the range of a
	// RangeExpr that has neither bound.
	def advance(len: int) -> int {
		var p = setPos(curPos + len, curLine, curCol + len);
		skipFunc(this);
		// A term's number starts with a digit, which parseNumber consumes even
		// when the literal is malformed. Layouts and packings also call it on
		// other bytes, which it leaves.
		if (numberFailed) {
			numberFailed = false;
			if (len > 0) skipBoundlessRanges();
		}
		return p;
	}
	// Recovery at an expression start runs even past the error limit, but not
	// for an error repeated at one position. The position recorded for that
	// check is taken after recovery.
	def error(msg: string) {
		var limited = ERROR.numErrors >= ERROR.maxErrors, q = curPos;
		for (l = errors; !limited && l != null; l = l.tail) {
			if (l.head == q) return; // only generate one error per position
			if (l.head < q) break;   // assume errors are sorted
		}
		if (!limited) errorAt(range(), msg);
		// The malformed operator itself is consumed, so the parser moves on.
		if (Strings.equal(msg, "invalid start of expression") && atRangeOperator()) {
			advance(3);
			skipBoundlessRanges();
		}
		if (!limited) errors = List<int>.new(curPos, errors);
	}
	// Only parseNumber reports here; it then advances past the malformed
	// literal and returns null.
	def errorAtOffset(offset: int, msg: string) {
		curPos = curPos + offset;
		curCol = curCol + offset;
		error(msg);
		curPos = curPos - offset;
		curCol = curCol - offset;
		numberFailed = true;
	}
	// Consumes the range operators that would build a range without bounds.
	private def skipBoundlessRanges() {
		while (atRangeOperator() && !termAt(tokenAfter(curPos + 3))) advance(3);
	}
	private def atRangeOperator() -> bool {
		return curByte == '.' && peek(1) == '.' && (peek(2) == '.' || peek(2) == '+');
	}
	// Whether Parser.parseTerm certainly returns an expression at {pos}.
	private def termAt(pos: int) -> bool {
		var d = input;
		if (pos >= d.length) return false;
		var ch = d[pos];
		if (Char.isIdentStart(ch)) return true;
		match (ch) {
			'\'' => return Chars.parseLiteral(d, pos).0 > 0;
			'\"' => return Strings.parseLiteral(d, pos).0 > 0;
			'_' => return pos + 1 == d.length || !Char.isIdentMiddle(d[pos + 1]);
			'+' => return pos + 1 < d.length && d[pos + 1] == '+';
			'(', '[', '!', '~' => return true;
			'-' => if (pos + 1 == d.length || !Char.isDecimal(d[pos + 1])) return true;
			_ => if (!Char.isDecimal(ch)) return false;
		}
		var np = NumberParser.new(d[pos ...]);
		np.accept_width = true;
		return np.parse();
	}
	// Where Parser.skipToNextToken, which this mirrors without side effects,
	// would stop after {pos}.
	private def tokenAfter(pos: int) -> int {
		var d = input, max = d.length;
		while (pos < max) {
			var ch = d[pos];
			if (ch == '/' && pos + 1 < max && d[pos + 1] == '/') {
				while (pos < max && d[pos] != '\n') pos++;
			} else if (ch == '/' && pos + 1 < max && d[pos + 1] == '*') {
				pos += 2;
				while (pos < max && !(d[pos] == '*' && pos + 1 < max && d[pos + 1] == '/')) pos++;
				pos += 2;
			} else if (ch <= ' ' || ch > '~') {
				pos++; // whitespace, or an invalid character that the skipper reports
			} else {
				break;
			}
		}
		return pos;
	}
}

// The per-file parser driver shared by parser diagnostics, document symbols,
// and whole-program analysis, so all get the same recovery. {syntax} may be null.
component AnalysisSingleFileParser {
	// Cap parser recursion's native stack use. stackLimit may lower this to
	// preserve CHAIN_STACK and STACK_RESERVE above the runtime's red zone.
	def STACK_LIMIT = 1024 * 1024;
	// Stack always left free, in case parsing starts deep in the stack.
	def STACK_RESERVE = 64 * 1024;
	// Cap the tokens that AnalysisChainCounter counts. Expr.range() recursion
	// uses at most CHAIN_FRAME bytes of stack per counted token (a binary
	// operator; measured on x86-64), and real code stays far below the limit.
	def CHAIN_LIMIT = 8192;
	def CHAIN_FRAME = 72;
	// Stack left for range() after parser recursion.
	def CHAIN_STACK = CHAIN_LIMIT * CHAIN_FRAME;

	def parse(path: string, input: Array<byte>, errors: AnalysisParseErrors, syntax: SymbolSyntaxIndex,
			typeCache: TypeCache, coordinates: AnalysisTokenCoordinates) -> VstFile {
		var file = VstFile.new(path, input);
		errors.startFile();
		var p = AnalysisParserState.new(file, errors, syntax, typeCache, coordinates);
		p.enableFunExprs = CLOptions.FUN_EXPRS.get();
		p.enableSimpleBodies = CLOptions.SIMPLE_BODIES.get();
		p.enableOpenTypes = CLOptions.OPEN_TYPES.get();
		p.enableDescriptors = CLOptions.DESCRIPTORS.get();
		while (p.curByte != Parser.END) {
			if (!Parser.parseToplevelDecl(p, file)) break;
		}
		if (syntax != null) syntax.finish(p);
		if (file.synthetic != null) file.synthetic.members = Lists.reverse(file.synthetic.members);
		return file;
	}
	def stackPointer() -> Pointer {
		return CiRuntime.callerSp();
	}
	// The stack that parsing from {base} may use: STACK_LIMIT, unless less is
	// left above CHAIN_STACK, STACK_RESERVE, and the native runtime's red zone.
	def stackLimit(base: Pointer) -> long {
		var free = base - RiRuntime.stackRedZoneEnd - CHAIN_STACK - STACK_RESERVE;
		return if(free < STACK_LIMIT, free, STACK_LIMIT);
	}
}
