// Parser driver adapted from the pinned Aeneas Parser.v3; see THIRD_PARTY_NOTICES.md.

// Observe the pinned parser's token boundaries rather than lexing comments a
// second time. Compiler columns alone cannot identify EOF after a line comment
// or tokens following tabs in block comments. The skip hook retains their
// actual byte positions; ErrorGen captures them at the instant an error occurs.
class AnalysisParseErrors extends ErrorGen {
	var parser: ParserState;
	def offsets = Vector<(int, int)>.new();
	private def positions = Strings.newMap<int>();

	new(maxErrors: int) super(maxErrors) { }

	def record(p: ParserState) {
		parser = p;
		var key = coordinate(p.curLine, p.curCol);
		// Preserve token ends when a trailing line comment later reaches EOF
		// with the same compiler column. Empty current-point errors use curPos.
		if (!positions.has(key)) positions[key] = p.curPos;
	}
	def addError(range: FileRange, sourceLine: string, error: string, msg: string) {
		var begin = -1, end = -1;
		if (range != null && parser != null) {
			if (range.beginLine == parser.curLine && range.endLine == parser.curLine &&
				range.beginColumn == parser.curCol && range.endColumn == parser.curCol) {
				begin = end = parser.curPos;
			} else {
				begin = offset(range.beginLine, range.beginColumn);
				end = offset(range.endLine, range.endColumn);
			}
		}
		offsets.put((begin, end));
		errors = List.new(Error.new(range, sourceLine, error, msg), errors);
		incErrors();
	}
	private def coordinate(line: int, column: int) -> string {
		return Strings.format2("%d:%d", line, column);
	}
	private def offset(line: int, column: int) -> int {
		var key = coordinate(line, column);
		if (positions.has(key)) return positions[key];
		// ParserState.tokenAt computes columns by scanning raw bytes, using
		// the ordinary tab rule rather than skipToNextToken's comment rules.
		return PositionMap.new(parser.input, PositionEncoding.UTF8).compilerToOffset(line, column);
	}
}

component AnalysisSingleFileParser {
	def skip(p: ParserState) {
		var errors = AnalysisParseErrors.!(p.ERROR);
		errors.record(p);
		Parser.skipToNextToken(p);
		errors.record(p);
	}
	// The setup and top-level driver from the pinned Parser.parseFile, with
	// an injected skip hook. Grammar parsing remains entirely in Aeneas.
	def parse(path: string, input: Array<byte>, errors: AnalysisParseErrors) -> VstFile {
		var file = VstFile.new(path, input);
		var p = ParserState.new(file, errors, skip, TypeCache.new());
		p.enableFunExprs = CLOptions.FUN_EXPRS.get();
		p.enableSimpleBodies = CLOptions.SIMPLE_BODIES.get();
		p.enableOpenTypes = CLOptions.OPEN_TYPES.get();
		p.enableDescriptors = CLOptions.DESCRIPTORS.get();
		while (p.curByte != Parser.END) {
			if (!Parser.parseToplevelDecl(p, file)) break;
		}
		if (file.synthetic != null) file.synthetic.members = Lists.reverse(file.synthetic.members);
		return file;
	}
}
