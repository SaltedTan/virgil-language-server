// The result of one whole-program analysis as the server holds it: diagnostics,
// declarations, and occurrences decoded from an analysis worker's message. It
// references no compiler objects, so it stays usable after the worker that
// produced it has crashed or been replaced. See
// docs/decisions/0004-analysis-worker-process.md.
class AnalysisSnapshot {
	// Counts the snapshots one supervisor has produced, from 1.
	def generation: int;
	var retainedBytes = 1024L;
	// The decoded allocation charged for the result, against
	// AnalysisWire.MAX_RESULT_ALLOCATION.
	var resultAllocation: long;
	// The program's files in analysis order.
	def paths: Array<string>;
	// Submission provenance attached by the stdio server, never sent to the
	// worker. Raw worker/CLI snapshots have no document-store provenance.
	def var documentVersions: Array<AnalysisDocumentVersion> = [];
	def var projectRevision: ProjectRevision;
	def var projectName: string;
	def recordProject(context: ProjectContext) {
		projectRevision = context.config;
		projectName = context.definition.name;
	}
	def matchesProject() -> bool {
		return projectRevision == null || projectRevision.current;
	}
	def parsed: bool;	// parsing reported no errors, so verification ran
	def verified: bool;	// parsing and verification both reported no errors
	def diagnostics: Array<AnalysisDiagnostic>;
	def stats: AnalysisSnapshotStats;
	// True if the analysis collected occurrences; otherwise none are recorded.
	def hasOccurrences: bool;
	// Every declaration named in the program's files or that an occurrence
	// resolves to, each once.
	def declarations: Array<AnalysisDeclaration>;
	// The answer to the analysis's scope query, as indices into
	// {declarations}, or null without one; see docs/architecture.md#completion.
	var scope: AnalysisSnapshotScope;
	// The answer to the analysis's member query, as indices into
	// {declarations} and builtin members, or null without one; see
	// docs/architecture.md#member-completion.
	var members: AnalysisSnapshotMembers;
	// The answer to the analysis's call query, or null without one or where
	// no call opens at its offset; see docs/architecture.md#signature-help.
	var queriedCall: AnalysisCall;
	// Each file's index, or null without occurrences.
	private var files: AnalysisSnapshotFiles;
	// The result's string table, which holds the use-site types.
	private var strings: Array<string> = [];
	// The result's call signatures, or null without occurrences.
	private var signatures: AnalysisSnapshotSignatures;

	new(generation, paths, parsed, verified, diagnostics, stats, hasOccurrences, declarations) {
		for (path in paths) retainedBytes += 128L + if(path != null, path.length, 0);
	}

	// Called once on completion, before exposing the snapshot to handlers.
	def recordDocumentVersions(versions: Array<AnalysisDocumentVersion>) {
		documentVersions = versions;
		for (v in versions) {
			retainedBytes += 144L + v.uri.length;
			if (v.substitution != null) retainedBytes += v.substitution.bytes;
		}
	}
	def degraded() -> bool {
		for (v in documentVersions) if (v.substitution != null) return true;
		return false;
	}
	def effectiveOffset(i: int, offset: int) -> int {
		var sub = documentVersions[i].substitution;
		return if(sub != null, sub.mapping.toEffective(offset), offset);
	}
	def currentRange(i: int, begin: int, end: int) -> (int, int) {
		var sub = documentVersions[i].substitution;
		if (sub == null) return (begin, end);
		var m = sub.mapping;
		if (!m.maps(begin, end)) return (-1, -1);
		return (if(begin >= m.effectiveEnd, begin + m.delta, begin), if(end >= m.effectiveEnd, end + m.delta, end));
	}

	// False for an unrecorded URI. Disk inputs are current while no overlay is
	// open and the client has reported no disk change to the file since.
	def matchesDocument(store: DocumentStore, uri: string) -> bool {
		if (!matchesProject()) return false;
		var i = documentIndex(uri);
		return i >= 0 && documentVersions[i].matchesDocument(store);
	}
	// The index of {uri}'s stamp in {documentVersions}, which is also its index
	// in {paths}, or -1 for an unrecorded URI.
	def documentIndex(uri: string) -> int {
		var key = DocumentUri.normalize(uri);
		if (key == null) return -1;
		for (i < documentVersions.length) {
			if (Strings.equal(documentVersions[i].uri, key)) return i;
		}
		return -1;
	}

	// Records the files' indexes, which the decoder fills in.
	def setFiles(f: AnalysisSnapshotFiles) {
		files = f;
	}
	private def fileOf(path: string) -> AnalysisSnapshotFile {
		return if(files != null, files[path]);
	}
	// The index of the file at {path}, or null without occurrences or for a
	// path the analysis did not have. A rename's preflight compares two
	// snapshots' indexes with it (LspRenameBindings).
	def fileIndex(path: string) -> AnalysisSnapshotFile {
		return fileOf(path);
	}
	// Records the string table that the files' type indexes refer to.
	def setStrings(table: Array<string>) {
		strings = table;
	}
	def hintString(i: int) -> string { return strings[i]; }
	// Records the signatures that the files' calls refer to.
	def setSignatures(s: AnalysisSnapshotSignatures) {
		signatures = s;
	}
	// Source-declaration uses in {path}, as ProgramAnalysis.occurrences reports
	// them. Each call returns a new array.
	def occurrences(path: string) -> Array<AnalysisOccurrence> {
		var file = fileOf(path);
		if (file == null) return [];
		var result = Array<AnalysisOccurrence>.new(file.targets.length);
		for (i < result.length) result[i] = occurrence(path, file, i);
		return result;
	}
	// Uses in {path} with a type but no source declaration, as
	// ProgramAnalysis.builtinUses reports them. Each call returns a new array.
	def builtinUses(path: string) -> Array<AnalysisBuiltinUse> {
		var file = fileOf(path);
		if (file == null) return [];
		var result = Array<AnalysisBuiltinUse>.new(file.builtinCount());
		for (i < result.length) result[i] = AnalysisBuiltinUse.new(file.builtinRange(path, i), strings[file.builtinType(i)]);
		return result;
	}
	// The declarations named in {path}, as ProgramAnalysis.declarationSites
	// reports them. Each call returns a new array.
	def declarationSites(path: string) -> Array<AnalysisDeclaration> {
		var file = fileOf(path);
		if (file == null) return [];
		return Arrays.range(declarations, file.firstSite, file.firstSite + file.siteCount);
	}
	// Whether the analysis has any declaration sites. A parse failure leaves
	// the program unverified and records none at all, so there is nothing to
	// answer definition, hover, or workspace-symbol queries from, though the
	// wire result still carries an empty file index.
	def hasDeclarationSites() -> bool {
		return files != null && declarations.length > 0;
	}
	// The run of {declarations} that {declarationSites} returns for {path}:
	// its first index and its end, exclusive. Does not allocate.
	def declarationSiteRun(path: string) -> (int, int) {
		var file = fileOf(path);
		if (file == null) return (0, 0);
		return (file.firstSite, file.firstSite + file.siteCount);
	}

	// Display data for hover; see docs/architecture.md#display-text. All
	// offsets are UTF-8 byte offsets, and every range's end is exclusive.

	// The declaration whose name contains {offset} in {path}, such as a
	// local, parameter, method, or class at its declaration, whether or not
	// anything uses it, or null. Does not allocate.
	def declarationAtOffset(path: string, offset: int) -> AnalysisDeclaration {
		var file = fileOf(path);
		if (file == null) return null;
		var low = file.firstSite, high = low + file.siteCount;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (declarations[mid].range.endOffset <= offset) low = mid + 1;
			else high = mid;
		}
		if (low >= file.firstSite + file.siteCount) return null;
		var d = declarations[low];
		return if(d.range.beginOffset <= offset, d);
	}
	// The use-site type of the use containing {offset} in {path}: for an
	// occurrence, the text of its type if that differs from its declaration's,
	// as at a generic call, and for a builtin use, its type. Otherwise null.
	// The declaration's text is its signature. Does not allocate.
	def useTypeAtOffset(path: string, offset: int) -> string {
		var file = fileOf(path);
		if (file == null) return null;
		var i = file.findOffset(offset);
		if (i >= 0) {
			var t = file.useType(i);
			return if(t >= 0, strings[t]);
		}
		i = file.findBuiltin(offset);
		return if(i >= 0, strings[file.builtinType(i)]);
	}
	// The occurrence containing {offset} in {path}, with its range and
	// use-site type, or null.
	def occurrenceAtOffset(path: string, offset: int) -> AnalysisOccurrence {
		var file = fileOf(path);
		if (file == null) return null;
		var i = file.findOffset(offset);
		return if(i >= 0, occurrence(path, file, i));
	}
	// The builtin use containing {offset} in {path}, or null.
	def builtinUseAtOffset(path: string, offset: int) -> AnalysisBuiltinUse {
		var file = fileOf(path);
		if (file == null) return null;
		var i = file.findBuiltin(offset);
		return if(i >= 0, AnalysisBuiltinUse.new(file.builtinRange(path, i), strings[file.builtinType(i)]));
	}
	// Call sites for signature help; see docs/architecture.md#call-sites.

	// The calls in {path}, in the order of their opening parentheses, as
	// ProgramAnalysis.calls reports them. Each call returns new objects, and
	// its calls that name one signature share it.
	def calls(path: string) -> Array<AnalysisCall> {
		var file = fileOf(path);
		if (file == null) return [];
		var cursor = file.callCursor(), result = Array<AnalysisCall>.new(file.callCount);
		var reader = AnalysisSignatureReader.new(signatures);
		for (i < result.length) {
			cursor.next();
			result[i] = call(file, cursor, reader);
		}
		return result;
	}
	// The innermost call in {path} whose argument list holds {offset}: one
	// whose opening parenthesis is before it and whose closing parenthesis is
	// at or after it, so that {offset} is between the two. Null if there is
	// none. Reads the file's calls up to {offset} and allocates only the
	// result, with its signature.
	def callAt(path: string, offset: int) -> AnalysisCall {
		var file = fileOf(path);
		if (file == null) return null;
		var cursor = file.callCursor(), found = -1, last = -1;
		while (cursor.next() && cursor.open < offset) {
			var start = cursor.start, startOpen = cursor.startOpen;
			cursor.skipArgs();
			// Argument lists nest, so the last that holds the offset is innermost.
			if (offset < cursor.close) {
				found = start;
				last = startOpen;
			}
		}
		if (found < 0) return null;
		cursor = file.callCursor().seek(found, last);
		cursor.next();
		return call(file, cursor, AnalysisSignatureReader.new(signatures));
	}
	// The call that {cursor} has just started to read, which it reads to its
	// end, with its signature from {reader}.
	private def call(file: AnalysisSnapshotFile, cursor: AnalysisCallCursor, reader: AnalysisSignatureReader) -> AnalysisCall {
		var args = Array<int>.new(2 * cursor.argCount);
		for (i < cursor.argCount) {
			cursor.nextArg();
			args[2 * i] = cursor.argBegin;
			args[2 * i + 1] = cursor.argEnd;
		}
		cursor.finish();
		var callee = -1, target: AnalysisDeclaration, open = cursor.open;
		var use = if(cursor.calleeEndsAtParen(), file.useEndingAt(open), if(cursor.calleeDelta > 0, file.useAt(open - cursor.calleeDelta), -1));
		if (use >= 0) {
			callee = file.useBegin(use);
			if (use < file.targets.length) target = declarations[file.target(use)];
		}
		var s = if(cursor.signature > 0, reader[cursor.signature - 1]);
		return AnalysisCall.new(open, cursor.close, args, callee, target, s);
	}
	private def occurrence(path: string, file: AnalysisSnapshotFile, i: int) -> AnalysisOccurrence {
		var range = file.range(path, i), decl = declarations[file.target(i)];
		var o: AnalysisOccurrence = if(file.isWrite(i), AnalysisWriteOccurrence.new(range, decl), AnalysisOccurrence.new(range, decl));
		var t = file.useType(i);
		if (t >= 0) o.useType = strings[t];
		return o;
	}
	// LSP kinds: declarations are Text (1), assigned uses Write (3), and
	// other recorded uses Read (2). The caller supplies a recorded name span.
	def highlightKind(path: string, offset: int) -> int {
		if (declarationAtOffset(path, offset) != null) return 1;
		var file = fileOf(path), i = if(file != null, file.findOffset(offset), -1);
		return if(i >= 0 && file.isWrite(i), 3, 2);
	}
	// The declaration that the indexed use at compiler coordinates
	// ({line}, {column}) in {path} resolves to, or null if there is none.
	def definitionAt(path: string, line: int, column: int) -> AnalysisDeclaration {
		var file = fileOf(path);
		if (file == null) return null;
		var i = file.find(line, column);
		return if(i >= 0, declarations[file.target(i)]);
	}
	// The declaration that the indexed use containing UTF-8 byte offset
	// {offset} in {path} resolves to, or null if there is none.
	def definitionAtOffset(path: string, offset: int) -> AnalysisDeclaration {
		var file = fileOf(path);
		if (file == null) return null;
		var i = file.findOffset(offset);
		return if(i >= 0, declarations[file.target(i)]);
	}
	// Whether a recorded name contains {offset}, and the source declaration
	// of its resolved type, or null for a built-in, structural or unknown
	// type. Distinguishing a found null prevents cursor fallback from taking
	// the type of an adjacent name. At type names this is definition's target.
	def typeDefinitionAtOffset(path: string, offset: int) -> (bool, AnalysisDeclaration) {
		var file = fileOf(path);
		if (file == null) return (false, null);
		var declaration = file.siteAt(declarations, offset), begin = -1;
		if (declaration >= 0) begin = declarations[declaration].range.beginOffset;
		else {
			var use = file.findOffset(offset);
			if (use >= 0) {
				begin = file.occurrenceBegin(use);
				declaration = file.target(use);
			}
			else {
				var builtin = file.findBuiltin(offset);
				if (builtin >= 0) begin = file.builtins[5 * builtin + 2];
			}
		}
		if (begin < 0) return (false, null);
		var target = if(file.typeTargets != null, file.typeTargets.find(begin), -1);
		if (target < 0) target = if(declaration >= 0, declarations[declaration].typeTarget);
		return (true, if(target > 0, declarations[target - 1]));
	}
	// A validated type-hint record already names its local declaration and
	// exact span. Reuse the source-type override without searching the sites.
	def hintTarget(file: AnalysisSnapshotFile, local: int, begin: int) -> int {
		var target = if(file.typeTargets != null, file.typeTargets.find(begin), -1);
		return if(target < 0, declarations[local - 1].typeTarget, target);
	}

	// The references of {decl}, one of {declarations}: the uses that
	// definitionAtOffset resolves to it, or to another declaration with the
	// same name token, such as a data type's single case or a class
	// parameter's field; and its name if {withName}, and otherwise never. For
	// each file that has any, in byte order of path: the path, and the begin
	// and end offsets of each, in source order and once. Navigation aliases,
	// which resolve to a declaration without naming it, are among them: "this"
	// and a default ".new" resolve to their class (see OccurrenceCollector).
	// Scans every file's targets without an object per use, and allocates
	// only the result. See docs/architecture.md#references.
	def references(decl: AnalysisDeclaration, withName: bool) -> Array<(string, Array<int>)> {
		if (files == null || decl == null) return [];
		var r = decl.range, ids = sharingName(decl), result = Vector<(string, Array<int>)>.new();
		for (k < files.paths.length) {
			var path = files.pathAt(k), file = files.fileAt(k);
			// In the declaring file, a use with the name's range is the name.
			var own = r.beginOffset >= 0 && Strings.equal(path, r.path);
			var name = own && withName, count = 0;
			var targets: Array<int> = if(file != null, file.targets, []);
			for (i < targets.length) {
				if (among(ids, file.target(i)) && !(own && file.spans(i, r.beginOffset, r.endOffset))) count++;
			}
			if (name) count++;
			if (count == 0) continue;
			var spans = Array<int>.new(2 * count), n = 0;
			for (i < targets.length) {
				if (!among(ids, file.target(i)) || (own && file.spans(i, r.beginOffset, r.endOffset))) continue;
				var begin = file.occurrenceBegin(i), end = file.occurrenceEnd(i);
				if (name && r.beginOffset < begin) {
					spans[n++] = r.beginOffset;
					spans[n++] = r.endOffset;
					name = false;
				}
				spans[n++] = begin;
				spans[n++] = end;
			}
			if (name) {
				spans[n++] = r.beginOffset;
				spans[n++] = r.endOffset;
			}
			result.put((path, spans));
		}
		return result.extract();
	}
	// The indexes in {declarations} of {decl} and of each declaration with the
	// same name token. Declarations differ by kind or token, so these differ
	// only by kind.
	private def sharingName(decl: AnalysisDeclaration) -> Array<int> {
		var r = decl.range, ids = Vector<int>.new();
		for (i < declarations.length) {
			var d = declarations[i], q = d.range;
			if (d == decl || (r.beginOffset >= 0 && q.beginOffset == r.beginOffset
					&& q.endOffset == r.endOffset && Strings.equal(q.path, r.path))) ids.put(i);
		}
		return ids.extract();
	}
	private def among(ids: Array<int>, target: int) -> bool {
		for (id in ids) if (id == target) return true;
		return false;
	}
}

// One canonical URI's submission stamp. A null identity denotes disk, not
// overlay version zero (all integer overlay versions, including negative, work).
// The token carries no source bytes and prevents close/reopen version reuse.
// A disk input also records the store's disk stamp, which a reported disk
// change replaces, and the length and 64-bit FNV-1a hash of the bytes the
// worker analyzed, which LspAnalysisCapture.analyzedText checks a re-read
// against. An overlay input has length -1 and relies on its identity.
class AnalysisDocumentVersion(uri: string, version: int, identity: DocumentVersionIdentity) {
	var substitution: AnalysisSubstitution;
	var disk: DocumentVersionIdentity;
	var length = -1;
	var hash: u64;
	// An overlay stays current while the same accepted identity is open. A
	// version-only didChange keeps the record's identity, since its text is
	// unchanged, so it does not make the analysis stale. {uri} was captured
	// canonical, so the lookups skip normalizing it again.
	def matchesDocument(store: DocumentStore) -> bool {
		var doc = store.canonicalOverlay(uri);
		if (identity == null) return doc == null && (disk == null || disk == store.canonicalDiskStamp(uri));
		return doc != null && doc.identity == identity;
	}
	// The version to report for this source: the open overlay's current
	// version while it has this identity, including after a version-only change,
	// and otherwise the version captured with the analysis.
	def reportedVersion(store: DocumentStore) -> int {
		if (identity == null) return version;
		var doc = store.overlay(uri);
		return if(doc != null && doc.identity == identity, doc.version, version);
	}
}

// Kept by the snapshot, independently of text-cache eviction. Its charge is
// reserved before submission and included in snapshot.retainedBytes.
class AnalysisSubstitution(effective: Array<byte>, mapping: LspBodyFallback) {
	def bytes = 256L + effective.length;
}

// Measurements of the analysis that produced a snapshot, taken in the worker.
// Fields that were not requested are -1. {skippedUses} counts the uses that
// the collector or the encoder dropped because they are not token spans; it
// is zero for every program we know of (see AnalysisRange.isTokenSpan).
class AnalysisSnapshotStats(parseUs: int, verifyUs: int, collectUs: int, uidsUsed: int,
	uidNext: int, globalTypesAdded: int, globalTypeTotal: int, skippedUses: int) { }

// A snapshot's file indexes, one for each distinct path of its request, in
// request order. A result names a file by its index here, so decoding never
// looks a path up by text. Lookups by text binary-search the paths in byte
// order, sorted once from the paths the server itself sent: Virgil's HashMap
// stops growing at 1,024 buckets, and paths with equal hashes share one, so
// hashing a large request's paths would take time quadratic in their count.
class AnalysisSnapshotFiles {
	// The request's distinct paths, each once.
	def var paths: Array<string>;
	private var files: Array<AnalysisSnapshotFile>;
	// The indexes of {paths} in the byte order of their paths.
	private var sorted: Array<int>;

	new(requestPaths: Array<string>) {
		var n = requestPaths.length, count = 0, order = Array<int>.new(n);
		for (i < n) if (requestPaths[i] != null) order[count++] = i;
		order = AnalysisTables.sort(Arrays.range(order, 0, count),
			fun (a: int, b: int) => AnalysisTables.compareBytes(requestPaths[a], requestPaths[b]) < 0);
		// The sort is stable, so the first of equal paths is the request's
		// first; it alone becomes a file.
		var first = Array<bool>.new(n);
		for (i < order.length) {
			if (i == 0 || AnalysisTables.compareBytes(requestPaths[order[i - 1]], requestPaths[order[i]]) != 0) first[order[i]] = true;
		}
		var slots = Array<int>.new(n), list = Vector<string>.new();
		for (i < n) {
			if (!first[i]) continue;
			slots[i] = list.length;
			list.put(requestPaths[i]);
		}
		paths = list.extract();
		sorted = Array<int>.new(paths.length);
		var k = 0;
		for (i in order) if (first[i]) sorted[k++] = slots[i];
		files = Array<AnalysisSnapshotFile>.new(paths.length);
	}
	def [path: string] -> AnalysisSnapshotFile {
		if (path == null) return null;
		var low = 0, high = sorted.length;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (AnalysisTables.compareBytes(paths[sorted[mid]], path) < 0) low = mid + 1;
			else high = mid;
		}
		if (low < sorted.length && AnalysisTables.compareBytes(paths[sorted[low]], path) == 0) return files[sorted[low]];
		return null;
	}
	// The path of the {k}th file in byte order of path.
	def pathAt(k: int) -> string {
		return paths[sorted[k]];
	}
	// The index of the {k}th file in byte order of path, or null.
	def fileAt(k: int) -> AnalysisSnapshotFile {
		return files[sorted[k]];
	}
	// Whether file {index} has no index yet.
	def isNew(index: int) -> bool {
		return u32.view(index) < u32.view(files.length) && files[index] == null;
	}
	def add(index: int, file: AnalysisSnapshotFile) {
		files[index] = file;
	}
}

// The index of one file, without an object per use: {ranges} holds the begin
// line, begin column, begin offset, and byte length of occurrence i at 4 * i.
// With compactCoordinates, it instead holds packed 16-bit line/column, begin
// offset, and byte length at 3 * i. The full-width fallback preserves larger
// compiler coordinates. The array {targets} holds its declaration index in the low 31 bits and its
// assignment flag in the sign bit. This adds no retained allocation. An
// occurrence is a token span (see AnalysisRange.isTokenSpan): it ends on its
// begin line, and its length is also its compiler column span. Occurrences
// are in source order and do not overlap. {typed} holds pairs of an
// occurrence index, in increasing order, and the string index of that
// occurrence's use-site type. {builtins} holds five ints per builtin use: a
// full-width range and the string index of its type; builtin uses
// are also token spans in source order. The file's declaration sites are
// the snapshot's declarations {firstSite} to {firstSite + siteCount}, in
// source order. The file's {callCount} calls are kept in their wire
// encoding, which the decoder checked, in {calls} (see AnalysisCallCursor).
// A use index is an occurrence's index, or the number of occurrences plus a
// builtin use's index.
class AnalysisSnapshotFile(ranges: Array<int>, targets: Array<int>, typed: Array<int>, builtins: Array<int>,
		firstSite: int, siteCount: int) {
	var compactCoordinates: bool;
	def occurrenceBegin(i: int) -> int { return ranges[if(compactCoordinates, 3 * i + 1, 4 * i + 2)]; }
	def occurrenceEnd(i: int) -> int { return occurrenceBegin(i) + ranges[if(compactCoordinates, 3 * i + 2, 4 * i + 3)]; }
	private def occurrenceLine(i: int) -> int { return if(compactCoordinates, int.view(u32.view(ranges[3 * i]) >> 16), ranges[4 * i]); }
	private def occurrenceColumn(i: int) -> int { return if(compactCoordinates, ranges[3 * i] & 65535, ranges[4 * i + 1]); }
	def siteAt(declarations: Array<AnalysisDeclaration>, offset: int) -> int {
		var low = firstSite, high = low + siteCount;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (declarations[mid].range.endOffset <= offset) low = mid + 1;
			else high = mid;
		}
		return if(low < firstSite + siteCount && declarations[low].range.beginOffset <= offset, low, -1);
	}
	def target(i: int) -> int {
		return targets[i] & int.max;
	}
	def isWrite(i: int) -> bool {
		return targets[i] < 0;
	}
	var typeTargets: AnalysisSnapshotTypeTargets;
	def var hintCount: int;
	def var hints: Array<byte> = [];
	def setHints(count: int, encoded: Array<byte>) { hintCount = count; hints = encoded; }
	def hintCursor() -> AnalysisFileHintCursor {
		return AnalysisFileHintCursor.new(AnalysisHintCursor.new(DataReader.new(hints), hintCount), callCursor());
	}
	def var callCount: int;
	def var calls: Array<byte> = [];

	// Records the calls, which the decoder checked against this file's uses.
	def setCalls(count: int, encoded: Array<byte>) {
		callCount = count;
		calls = encoded;
	}
	def range(path: string, i: int) -> AnalysisRange {
		var line = occurrenceLine(i), column = occurrenceColumn(i), begin = occurrenceBegin(i), end = occurrenceEnd(i);
		return AnalysisRange.new(path, line, column, line, column + end - begin, begin, end);
	}
	// Whether occurrence {i} has exactly the byte range from {begin} to {end}.
	def spans(i: int, begin: int, end: int) -> bool {
		return occurrenceBegin(i) == begin && occurrenceEnd(i) == end;
	}
	def callCursor() -> AnalysisCallCursor {
		return AnalysisCallCursor.new(DataReader.new(calls), callCount);
	}
	// The use index of the use that starts at {offset}, or -1.
	def useAt(offset: int) -> int {
		var i = findOffset(offset);
		if (i >= 0) return if(occurrenceBegin(i) == offset, i, -1);
		i = findBuiltin(offset);
		return if(i >= 0 && builtins[5 * i + 2] == offset, targets.length + i, -1);
	}
	// The use index of the use that ends just before {offset}, or -1.
	def useEndingAt(offset: int) -> int {
		var i = findOffset(offset - 1);
		if (i >= 0) return if(occurrenceEnd(i) == offset, i, -1);
		i = findBuiltin(offset - 1);
		return if(i >= 0 && builtins[5 * i + 2] + builtins[5 * i + 3] == offset, targets.length + i, -1);
	}
	def useBegin(use: int) -> int {
		return if(use < targets.length, occurrenceBegin(use), builtins[5 * (use - targets.length) + 2]);
	}
	def builtinCount() -> int {
		return builtins.length / 5;
	}
	def builtinRange(path: string, i: int) -> AnalysisRange {
		return span(path, builtins, 5 * i);
	}
	def builtinType(i: int) -> int {
		return builtins[5 * i + 4];
	}
	// The string index of occurrence {i}'s use-site type, or -1.
	def useType(i: int) -> int {
		var low = 0, high = typed.length / 2;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (typed[2 * mid] < i) low = mid + 1;
			else high = mid;
		}
		return if(low < typed.length / 2 && typed[2 * low] == i, typed[2 * low + 1], -1);
	}
	// The index of the builtin use whose byte range contains {offset}, or -1.
	def findBuiltin(offset: int) -> int {
		return search(builtins, 5, offset);
	}
	private def span(path: string, a: Array<int>, r: int) -> AnalysisRange {
		var line = a[r], column = a[r + 1], offset = a[r + 2], length = a[r + 3];
		return AnalysisRange.new(path, line, column, line, column + length, offset, offset + length);
	}
	// The index of the occurrence whose range contains the position, or -1.
	// A retrospective "[]" or "[]=" use followed closely on its line by
	// another use can be out of compiler-coordinate order (see
	// docs/architecture.md#coordinates); {findOffset} has no such exception.
	def find(line: int, column: int) -> int {
		// Occurrence tokens do not overlap, so their exclusive ends are also
		// in source order. Find the first token ending after the query point.
		var low = 0, high = targets.length;
		while (low < high) {
			var mid = low + (high - low) / 2;
			var endLine = occurrenceLine(mid), endColumn = occurrenceColumn(mid) + occurrenceEnd(mid) - occurrenceBegin(mid);
			if (endLine < line || (endLine == line && endColumn <= column)) low = mid + 1;
			else high = mid;
		}
		if (low >= targets.length) return -1;
		var beginLine = occurrenceLine(low), beginColumn = occurrenceColumn(low);
		if (line < beginLine || (line == beginLine && column < beginColumn)) return -1;
		return low;
	}
	// The index of the occurrence whose byte range contains {offset}, or -1.
	// The end offset is exclusive, so the offset just past an occurrence is
	// not in it.
	def findOffset(offset: int) -> int {
		var low = 0, high = targets.length;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (occurrenceEnd(mid) <= offset) low = mid + 1;
			else high = mid;
		}
		return if(low < targets.length && occurrenceBegin(low) <= offset, low, -1);
	}
	// Searches spans of {stride} ints, each starting with a range as an
	// occurrence's.
	private def search(a: Array<int>, stride: int, offset: int) -> int {
		var count = a.length / stride, low = 0, high = count;
		while (low < high) {
			var mid = low + (high - low) / 2, r = stride * mid;
			if (a[r + 2] + a[r + 3] <= offset) low = mid + 1;
			else high = mid;
		}
		if (low >= count || offset < a[stride * low + 2]) return -1;
		return low;
	}
}

// The flags in a call's head, below its argument count; see
// AnalysisWire.encodeCalls.
component AnalysisCallFlags {
	// The callee is the use that ends at the opening parenthesis.
	def CALLEE_AT_PAREN = 1;
	// The callee is the use that starts at an offset that follows.
	def CALLEE_OFFSET = 2;
	// Bytes between the last argument and the closing parenthesis follow.
	def CLOSE_GAP = 4;
}

// Reads one file's calls in the encoding that the worker sends and the
// snapshot keeps (see AnalysisWire.encodeCalls), checking each as it goes:
// the decoder checks a result's calls with it, and the snapshot then reads
// the calls it checked. A malformed call fails {r}. For each call, {next}
// reads its opening parenthesis, callee, signature, and argument count;
// {nextArg} reads each argument in turn, and {finish} its closing
// parenthesis. Allocates nothing. The collector's records (see
// OccurrenceCollector.calls) differ only in that each opening parenthesis is
// its offset, not a difference, which {absolute} reads.
class AnalysisCallCursor(r: DataReader, var remaining: int) {
	var absolute: bool;
	// Where the current call's record starts, and the opening parenthesis of
	// the call before it, or -1, from which seek can read it again.
	def var start: int;
	def var startOpen: int;
	def var open: int;
	def var close: int;
	def var flags: int;
	// The callee's offset before {open} with CALLEE_OFFSET, or zero.
	def var calleeDelta: int;
	// A signature index plus one, or zero.
	def var signature: int;
	def var argCount: int;
	// After nextArg, the argument's begin and exclusive end.
	def var argBegin: int;
	def var argEnd: int;
	// Label string ID plus one, or zero. Both callee bits mark wire labels.
	// In absolute records bit 1 marks labels,
	// since worker callees always use explicit offsets, never AT_PAREN.
	def var argHint: int;
	def hasHints() -> bool { return if(absolute, (flags & AnalysisCallFlags.CALLEE_AT_PAREN) != 0, (flags & 3) == 3); }
	def rewindArgs(at: int) { r.at(at); position = open + 1; }
	// The opening parenthesis of the last call read, or -1.
	private var last = -1;
	// Where the next argument may start.
	private var position: int;

	// Continues with the call whose record starts at {start}, after a call
	// whose opening parenthesis is {last}.
	def seek(start: int, last: int) -> this {
		r.at(start);
		this.last = last;
		remaining = 1;
	}
	def calleeEndsAtParen() -> bool {
		return (flags & 3) == AnalysisCallFlags.CALLEE_AT_PAREN;
	}
	// Reads the next call's head. False after the last call or if it is malformed.
	def next() -> bool {
		if (remaining <= 0 || !r.ok) return false;
		remaining--;
		start = r.pos;
		startOpen = last;
		var delta = uleb();
		// Opening parentheses strictly increase.
		if (!absolute && last >= 0 && (delta < 1 || delta > int.max - last)) return fail("calls out of order");
		open = last = if(absolute || last < 0, delta, last + delta);
		var head = uleb();
		flags = head & 7;
		argCount = head >> 3;
		var offset = (flags & AnalysisCallFlags.CALLEE_OFFSET) != 0;
		calleeDelta = if(offset, uleb());
		if (offset && (calleeDelta < if(!absolute && hasHints(), 0, 1) || calleeDelta > open)) return fail("invalid callee offset");
		signature = uleb();
		// Each argument takes at least a byte.
		if (argCount > r.available() || open == int.max) return fail("invalid call");
		position = open + 1;
		return r.ok;
	}
	// Reads the next argument: a length and a gap after the previous one's end.
	def nextArg() -> bool {
		var v = uleb(), gap = v & 3, length = v >> 2;
		if (gap == 3) gap = uleb();
		if (!r.ok || length < 1 || gap > int.max - position || length > int.max - position - gap) return fail("invalid argument range");
		argBegin = position + gap;
		argEnd = position = argBegin + length;
		argHint = if(hasHints(), uleb());
		return r.ok;
	}
	def skipArgs() {
		for (i < argCount) if (!nextArg()) return;
		finish();
	}
	// Reads the closing parenthesis, after the last argument.
	def finish() -> bool {
		var gap = if((flags & AnalysisCallFlags.CLOSE_GAP) != 0, uleb());
		if (!r.ok || gap > int.max - position - 1) return fail("invalid call range");
		close = position + gap + 1;
		return true;
	}
	private def uleb() -> int {
		var v = r.read_uleb32();
		if (v > u32.view(int.max)) {
			r.fail("invalid call number");
			return 0;
		}
		return int.view(v);
	}
	private def fail(msg: string) -> bool {
		r.fail(msg);
		return false;
	}
}

// A result's call signatures, kept in their wire encoding (see
// AnalysisWire.encodeResult): record i starts at byte {offsets[i]} of
// {records}. A string reference is an index into the result's string
// table, {strings}, or, past its end, into the signature text, the strings
// that only signatures have, which are kept in one array: text i is bytes
// {textOffsets[i]} to {textOffsets[i + 1]} of {text}. The decoder checked
// every record and reference.
class AnalysisSnapshotSignatures(strings: Array<string>, text: Array<byte>, textOffsets: Array<int>,
		records: Array<byte>, offsets: Array<int>) {
	def count() -> int {
		return offsets.length;
	}
	// Whether {ref} names a string: a string table entry that is not null,
	// or signature text.
	def valid(ref: int) -> bool {
		if (ref < 0) return false;
		if (ref < strings.length) return strings[ref] != null;
		return ref - strings.length < textOffsets.length - 1;
	}
	// The length of the string that {ref} names, which is valid.
	def length(ref: int) -> int {
		if (ref < strings.length) return strings[ref].length;
		var i = ref - strings.length;
		return textOffsets[i + 1] - textOffsets[i];
	}
	// Signature {i}, as new objects, with its signature text from {reader}.
	def signature(i: int, reader: AnalysisSignatureReader) -> AnalysisSignature {
		var r = DataReader.new(records).at(offsets[i]);
		var label = string(r.read_sleb32(), reader), start = r.read_sleb32();
		var params = Array<string>.new(r.read_sleb32());
		for (k < params.length) params[k] = string(r.read_sleb32(), reader);
		return AnalysisSignature.new(label, start, params);
	}
	// The bytes that decoding signature {i} allocates beyond its object: 8
	// for each parameter's slot, and each string of signature text that it
	// names, which is copied, with 64 bytes for its array.
	def copiedBytes(i: int) -> long {
		var r = DataReader.new(records).at(offsets[i]);
		var label = r.read_sleb32(), start = r.read_sleb32(), n = r.read_sleb32();
		var bytes = 8L * n + copied(label);
		for (k < n) bytes += copied(r.read_sleb32());
		return bytes;
	}
	private def copied(ref: int) -> long {
		return if(ref < strings.length, 0, 64L + length(ref));
	}
	// A copy of signature text {i}.
	def copyText(i: int) -> string {
		return Arrays.range(text, textOffsets[i], textOffsets[i + 1]);
	}
	private def string(ref: int, reader: AnalysisSignatureReader) -> string {
		return if(ref < strings.length, strings[ref], reader.text(ref - strings.length));
	}
}

// One query's signatures from {table}: each signature that it reads is
// decoded once, however many of the query's calls name it, and each
// signature text string copied once, however often they name it. What a
// query allocates is thus bounded by the calls it returns and the sizes of
// the distinct signatures they use. Each query makes its own; the snapshot
// keeps none.
class AnalysisSignatureReader(table: AnalysisSnapshotSignatures) {
	private var signatures: AnalysisIndexMap<int>;
	private def decoded = Vector<AnalysisSignature>.new();
	private var texts: AnalysisIndexMap<int>;
	private def copies = Vector<string>.new();

	// Signature {i}.
	def [i: int] -> AnalysisSignature {
		if (signatures == null) signatures = AnalysisIndexMap<int>.new(int.!<int>, int.==);
		var k = signatures.add(i);
		if (k == decoded.length) decoded.put(table.signature(i, this));
		return decoded[k];
	}
	// Signature text {i}.
	def text(i: int) -> string {
		if (texts == null) texts = AnalysisIndexMap<int>.new(int.!<int>, int.==);
		var k = texts.add(i);
		if (k == copies.length) copies.put(table.copyText(i));
		return copies[k];
	}
}
