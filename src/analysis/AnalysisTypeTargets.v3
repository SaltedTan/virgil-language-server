// Sparse overrides of a declaration's default source-type target, keyed by
// a recorded name's byte offset. Codes are declaration IDs plus one, or zero
// for an explicit null; absence (-1) uses the declaration's default.
// The wire's delta-coded pairs are retained directly. Every 32nd offset is
// absolute; checkpoints hold that offset and the byte position of its target.
// A lookup searches the checkpoints, then reads at most 32 small records.
// Neither a compiler object nor display text is retained. Other consumers,
// including inlay hints, can reuse the targets with the occurrence spans.
class AnalysisSnapshotTypeTargets(data: Array<byte>, checkpoints: Array<int>) {
	def find(offset: int) -> int {
		var low = 0, high = checkpoints.length / 2;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (checkpoints[2 * mid] <= offset) low = mid + 1;
			else high = mid;
		}
		if (low == 0) return -1;
		var at = checkpoints[2 * (low - 1)];
		var r = DataReader.new(data).at(checkpoints[2 * (low - 1) + 1]);
		for (i = 0; i < 32 && r.ok && !r.done(); i++) {
			var target = r.read_sleb32();
			if (at == offset) return target;
			if (at > offset || i == 31 || r.done()) break;
			at += r.read_sleb32();
		}
		return -1;
	}
}

// Numeric declaration indexing and sparse type-target preparation share the
// encoder's existing passes. Defaults are chosen while indexing names, then
// translated once per declaration. Merging the three source-ordered streams
// prepares overrides and span counts together, with no per-override sort.
class AnalysisTypeTargetEncoding(workerCount: int, declarations: AnalysisIndexMap<AnalysisDeclaration>, fileCount: int) {
	// Positive: wire index plus one. Zero: not indexed or needed. Minus
	// one: needed by a selected name, but not yet in the declaration table.
	private def indices = Array<int>.new(workerCount + 1);
	def defaults = Vector<int>.new();
	// Prepared wire bytes are shared by sizing and writing; neither pass
	// repeats string indexing or integer encoding for these sparse records.
	def overrides = Array<Range<byte>>.new(fileCount);
	def overrideCounts = Array<int>.new(fileCount);
	def typedUses = Array<Range<byte>>.new(fileCount);
	def builtinUses = Array<Range<byte>>.new(fileCount);
	// Token occurrence count, typed occurrence count, and builtin count.
	def counts = Array<(int, int, int)>.new(fileCount);
	def add(d: AnalysisDeclaration) -> int {
		var i = declaration(d);
		if (i >= 0) return i;
		i = declarations.add(d);
		if (d.typeTarget > 0) indices[d.typeTarget] = i + 1;
		if (i == defaults.length) defaults.put(0);
		return i;
	}
	def declaration(d: AnalysisDeclaration) -> int {
		return if(d.typeTarget > 0, indices[d.typeTarget] - 1, declarations.find(d));
	}
	def choose(i: int, sourceType: int) {
		if (sourceType <= 0) return;
		if (defaults[i] == 0) defaults[i] = sourceType;
		requireTarget(sourceType);
	}
	def requireTarget(code: int) {
		if (code > 0 && indices[code] == 0) indices[code] = -1;
	}
	def needs(d: AnalysisDeclaration) -> bool {
		return indices[d.typeTarget] < 0;
	}
	def translateDefaults() {
		for (i < defaults.length) defaults[i] = target(defaults[i]);
	}
	private def target(code: int) -> int {
		return if(code > 0, indices[code]);
	}
	def prepareFile(f: int, sites: Array<AnalysisDeclaration>, occurrences: Array<AnalysisOccurrence>, builtins: Array<AnalysisBuiltinUse>) {
		var changes = DataWriter.new(), previousOffset = 0, changeCount = 0;
		var si = 0, oi = 0, bi = 0, count = 0, typed = 0, builtinCount = 0;
		while (true) {
			while (oi < occurrences.length && !occurrences[oi].range.isTokenSpan()) oi++;
			while (bi < builtins.length && !builtins[bi].range.isTokenSpan()) bi++;
			if (si == sites.length && oi == occurrences.length && bi == builtins.length) break;
			var offset = int.max, stream = 0, decl = -1, sourceType = 0;
			if (si < sites.length) offset = sites[si].range.beginOffset;
			if (oi < occurrences.length && occurrences[oi].range.beginOffset < offset) {
				offset = occurrences[oi].range.beginOffset;
				stream = 1;
			}
			if (bi < builtins.length && builtins[bi].range.beginOffset < offset) {
				offset = builtins[bi].range.beginOffset;
				stream = 2;
			}
			if (stream == 0) {
				var d = sites[si++];
				decl = declaration(d);
				sourceType = d.sourceType;
			} else if (stream == 1) {
				var o = occurrences[oi++];
				decl = declaration(o.declaration);
				sourceType = o.sourceType;
				count++;
				if (o.useType != null) typed++;
			} else {
				sourceType = builtins[bi++].sourceType;
				builtinCount++;
			}
			var code = target(sourceType), own = if(decl >= 0, defaults[decl]);
			if (code != own) {
				changes.put_sleb32(if(changeCount % 32 == 0, offset, offset - previousOffset)).put_sleb32(code);
				previousOffset = offset;
				changeCount++;
			}
		}
		overrides[f] = changes.alias();
		overrideCounts[f] = changeCount;
		counts[f] = (count, typed, builtinCount);
	}
}
