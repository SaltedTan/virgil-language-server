// The bounds and markers of display text; see docs/architecture.md#display-text.
component AnalysisDisplayText {
	// Rendering stops before the text would pass this many bytes, and
	// appends ELISION instead.
	def MAX_BYTES = 256;
	// A type nested this many levels inside a declaration's or use's type
	// renders as ELISION.
	def MAX_DEPTH = 12;
	// U+2026 HORIZONTAL ELLIPSIS, three UTF-8 bytes.
	def ELISION = "\xE2\x80\xA6";
	// A null type, an error type (including an unresolved type name), or an
	// inference variable without a solution.
	def UNKNOWN = "?";
}

// A declaration as the worker makes it, once per source declaration (see
// AnalysisDisplay.declaration). The types of its uses are compared with its
// own type {ownType}, if that is one Type, and otherwise with the text of its
// type, which is rendered from {syntax} when a use first needs it.
class AnalysisWorkerDeclaration extends AnalysisDeclaration {
	def syntax: Decl;
	def ownType: Type;
	var typeText: string;
	var rendered: bool;
	new(kind: AnalysisDeclKind, name: string, range: AnalysisRange, signature: string, syntax, ownType)
			super(kind, name, range) {
		this.signature = signature;
	}
}

// Renders and interns the display text of one program: a signature for each
// declaration and the types of uses, in Virgil syntax. The collectors of all
// of a program's files share it, so each declaration is made, and each type
// rendered, once. Rendering is bounded while it runs (see AnalysisDisplayText),
// so it is linear in its output even for types whose trees share subtrees.
class AnalysisDisplay(sources: AnalysisSourceMaps) {
	private def strings = AnalysisStringTable.new();
	// Types are hash-consed, so the text of each is rendered once.
	private def types = AnalysisIndexMap<Type>.new(hashType, identical<Type>);
	private def typeTexts = Vector<string>.new();
	private def declarations = AnalysisIndexMap<(Token, AnalysisDeclKind)>.new(AnalysisDeclarationKeys.hash, AnalysisDeclarationKeys.equal);
	private def declarationList = Vector<AnalysisWorkerDeclaration>.new();
	// Call signatures by content, each once, and the index there of each
	// call's signature by callee declaration, type, and whether the call
	// passes the receiver, so that each is rendered once.
	private def signatures = AnalysisIndexMap<AnalysisSignature>.new(AnalysisSignatures.hash, AnalysisSignatures.equal);
	private def calls = AnalysisIndexMap<(AnalysisDeclaration, Type, bool)>.new(hashCall, sameCall);
	private def callList = Vector<int>.new();
	private def buf = StringBuilder.new();
	private var full: bool;
	// While a member of an instantiated class renders, its class's type
	// parameters and the type arguments that replace them.
	private var substParams: List<TypeParamType>;
	private var substArgs: List<Type>;

	// The declaration of {kind} named by {token}, the same object for every
	// use, or null if the compiler synthesized it. {decl} is its syntax, and
	// {t} the type of a declaration that has none, a type parameter.
	def declaration(kind: AnalysisDeclKind, token: Token, decl: Decl, t: Type) -> AnalysisDeclaration {
		if (token == null || token.beginLine <= 0) return null;
		var key = (token, kind), index = declarations.add(key);
		if (index < declarationList.length) return declarationList[index];
		var d = AnalysisWorkerDeclaration.new(kind, token.image, sources.range(token),
			signature(kind, token, decl), decl, if(decl == null, t, ownType(decl)));
		declarationList.put(d);
		return d;
	}
	// The text of the type of a use of {decl}, or null if it is the
	// declaration's own type or is unknown. Most uses have exactly their
	// declaration's type, which needs no text.
	def useType(decl: AnalysisDeclaration, t: Type) -> string {
		var d = AnalysisWorkerDeclaration.!(decl);
		if (t == d.ownType) return null;
		var text = typeText(t);
		return if(text != null, differing(d, text));
	}
	def superclassUseType(decl: AnalysisDeclaration, tref: TypeRef) -> string {
		start();
		putSuperclass(tref);
		return differing(AnalysisWorkerDeclaration.!(decl), strings.intern(buf));
	}
	// The text of the type of a use of method {m}, declared as {decl}, by an
	// index operation on {receiver}, or null if it is the declaration's own
	// type. {owner} is the class that declares {m}, as {receiver}'s type
	// instantiates it: for a Child that extends Chain<int>, Chain<int>. An
	// index operation has no type of its own, so this renders the method's
	// type with {owner}'s type arguments in place of its type parameters, and
	// a return of "this" as {receiver}, as verification types a call of it.
	def methodUseType(decl: AnalysisDeclaration, owner: Type, receiver: Type, m: VstMethod) -> string {
		var ret = returnType(m), self = false;
		match (m.func.rettype) {
			This => {
				receiver = resolve(receiver, 0);
				if (!unknown(receiver)) {
					ret = receiver;
					self = true;
				}
			}
			_ => ;
		}
		var c = if(ClassType.?(owner), ClassType.!(owner).classDecl);
		var generic = c != null && c.typeParams != null && owner.nested != null;
		if (!generic && !self) return null;
		if (generic) {
			substParams = c.typeParams;
			substArgs = owner.nested;
		}
		var text = functionText(m.func.params, ret, self);
		substParams = null;
		substArgs = null;
		return differing(AnalysisWorkerDeclaration.!(decl), text);
	}
	// {text}, or null if it is the text of {d}'s own type.
	private def differing(d: AnalysisWorkerDeclaration, text: string) -> string {
		if (!d.rendered) {
			d.typeText = if(d.syntax == null, typeText(d.ownType), declarationType(d.syntax));
			d.rendered = true;
		}
		return if(text != d.typeText, text);
	}
	// The interned text of {t}, or null if it is unknown.
	def typeText(t: Type) -> string {
		t = resolve(t, 0);
		if (unknown(t)) return null;
		var index = types.add(t);
		if (index < typeTexts.length) return typeTexts[index];
		start();
		putType(t, 0);
		var text = strings.intern(buf);
		typeTexts.put(text);
		return text;
	}

	// The index of the signature that verification checked a call against,
	// whose callee has binding {b} and type {t} and is a use of {target}, or
	// -1; see
	// docs/architecture.md#call-sites. A method, constructor, or variant case
	// has its declaration's form and parameter names, and a class constructed
	// by its default constructor has its own; any other function's signature
	// is its type. A call with its callee's declared parameter types, as most
	// have, has its declaration's signature text, and its parameters have their
	// declarations' texts. Otherwise the types are the call's, without type
	// parameters, and so is the result. A method called through its class, as
	// in C.m(c, x), has the receiver as its first parameter, a type without a
	// name, and always the call's types.
	def callSignature(target: AnalysisDeclaration, b: VarBinding, t: Type) -> int {
		t = resolve(t, 0);
		if (unknown(t) || !Function_TypeCon.?(t.typeCon) || t.nested == null || t.nested.tail == null) return -1;
		var key = (target, t, VarBinding.ClassMethod.?(b)), index = calls.add(key);
		if (index < callList.length) return callList[index];
		var s = signatures.add(renderCall(target, b, t, key.2));
		callList.put(s);
		return s;
	}
	// The call signature with index {i}, from callSignature.
	def callSignatureAt(i: int) -> AnalysisSignature {
		return signatures[i];
	}
	def callSignatureCount() -> int {
		return signatures.length();
	}
	private def renderCall(target: AnalysisDeclaration, b: VarBinding, t: Type, receiver: bool) -> AnalysisSignature {
		var form: Decl, params: VstList<ParamDecl>, fields = false;
		match (if(target != null, AnalysisWorkerDeclaration.!(target).syntax)) {
			x: VstMethod => {
				form = x;
				params = x.func.params;
			}
			x: VstCaseMember => if (x.decl != null) {
				form = x;
				params = x.decl.params;
				fields = !x.decl.isSynthetic;
			}
			// Its default constructor shares the class's parameters.
			x: VstClass => if (VarBinding.ClassNew.?(b)) {
				form = x;
				params = x.params;
				fields = true;
			}
		}
		var list = if(params != null, params.list), first = if(receiver, 1);
		var types = if(form != null, splitParams(t.nested.head, Lists.length(list) + first));
		if (types == null) return function(t);
		var ret = t.nested.tail.head, method = if(VstMethod.?(form) && !VstNew.?(form), VstMethod.!(form));
		// A method that returns "this" keeps it when its parameters keep their types.
		var declared = !receiver, i = first;
		for (l = list; l != null; (l = l.tail, i++)) {
			if (typeText(types[i]) != typeText(l.head.vtype)) declared = false;
		}
		if (method != null && !method.func.returnThis && typeText(ret) != typeText(returnType(method))) declared = false;
		// A class constructed through its default constructor is instantiated
		// at the call, as in Box<Foo>.new(), even without parameters to compare.
		if (declared && VstClass.?(form) && typeText(ret) != typeText(compoundType(VstClass.!(form)))) declared = false;
		var labels = Array<string>.new(types.length);
		if (receiver) labels[0] = paramLabel(null, types[0], false);
		i = first;
		for (l = list; l != null; (l = l.tail, i++)) {
			var p = l.head;
			labels[i] = paramLabel(p.token.image, if(declared, p.vtype, types[i]),
				fields && p.member != null && p.member.writability != Writability.READ_ONLY);
		}
		start();
		if (method != null) {
			put("def ").put(method.token.image);
			if (declared) putTypeParams(method.typeParams);
		}
		match (form) {
			x: VstNew => put("new");
			x: VstCaseMember => {
				put(if(fields, "type ", "case ")).put(x.token.image);
				if (declared && fields) putTypeParams(x.decl.typeParams);
			}
			x: VstClass => {
				put(if(x.kind == Kind.VARIANT, "type ", "class "));
				if (declared) {
					put(x.token.image);
					putTypeParams(x.typeParams);
				} else {
					putType(ret, 0);
				}
			}
		}
		var offset = if(params != null || receiver, paramList(labels), buf.length);
		if (method != null) {
			match (method.func.rettype) {
				Void => ;
				This => if (declared) put(" -> this"); else putReturn(ret);
				_ => putReturn(if(declared, returnType(method), ret));
			}
		}
		if (VstClass.?(form)) {
			var c = VstClass.!(form);
			if (c.superclass != null) {
				// The superclass names the class's type parameters, which the
				// call's class type instantiates.
				if (!declared && c.typeParams != null) {
					substParams = c.typeParams;
					substArgs = resolve(ret, 0).nested;
				}
				put(" extends ");
				putSuperclass(c.superclass);
				substParams = null;
				substArgs = null;
			}
		}
		return signatureOf(strings.intern(buf), offset, labels);
	}
	// A function's signature from its type alone, as for a closure or a
	// builtin: the type's text, as a use has it.
	private def function(t: Type) -> AnalysisSignature {
		var types = Tuple.toTypeArray(resolve(t.nested.head, 0));
		var labels = Array<string>.new(types.length);
		for (i < types.length) labels[i] = paramLabel(null, types[i], false);
		// As putType writes "&((a, b) -> c)" or "(a -> b) -> c".
		var offset = if(Function_TypeCon.!(t.typeCon).kind == Kind.FUNCREF, 2);
		if (types.length > 1 || (types.length == 1 && isFunction(types[0]))) offset++;
		return signatureOf(typeText(t), offset, labels);
	}
	// The types of {n} parameters in {ptype}, a function type's parameter
	// type, or null if it does not have that many.
	private def splitParams(ptype: Type, n: int) -> Array<Type> {
		if (n == 1) return [ptype];
		var types = Tuple.toTypeArray(resolve(ptype, 0));
		return if(types.length == n, types);
	}
	private def paramLabel(name: string, t: Type, writable: bool) -> string {
		start();
		if (writable) put("var ");
		if (name != null) put(name).put(": ");
		putType(t, 0);
		return strings.intern(buf);
	}
	// Writes {labels} in parentheses, separated as putParams separates them,
	// and returns where the first starts, or the text's end if it is full.
	private def paramList(labels: Array<string>) -> int {
		put("(");
		var offset = buf.length;
		for (i < labels.length) {
			if (i > 0) put(", ");
			put(labels[i]);
		}
		put(")");
		return offset;
	}
	private def putReturn(t: Type) {
		put(" -> ");
		putType(t, 0);
	}
	private def signatureOf(label: string, offset: int, labels: Array<string>) -> AnalysisSignature {
		return AnalysisSignature.new(label, Ints.min(offset, label.length), labels);
	}

	private def signature(kind: AnalysisDeclKind, token: Token, decl: Decl) -> string {
		start();
		match (decl) {
			x: VstNew => {
				put("new");
				putParams(x.func.params, false);
			}
			x: VstMethod => putMethod(x);
			x: VstField => {
				put(if(x.writability == Writability.READ_ONLY, "def ",
					if(x.writability == Writability.PRIVATE_WRITEABLE, "def var ", "var ")));
				putTyped(x.token.image, x.vtype);
			}
			x: ParamDecl => putTyped(x.token.image, x.vtype);
			// A packing parameter has a size in bits, not a type.
			x: PackingParamDecl => putPackingParam(x);
			x: VarDecl => {
				put(if(x.isReadOnly, "def ", "var "));
				putTyped(x.token.image, x.vtype);
			}
			x: VstClass => putClass(x);
			x: VstComponent => {
				put("component ");
				put(x.token.image);
			}
			x: VstEnum => {
				put("enum ");
				put(x.token.image);
				putParams(x.params, false);
			}
			x: VstLayout => {
				put("layout ");
				put(x.token.image);
			}
			// A packing's parameters and width are sizes in bits.
			x: VstPacking => {
				put("packing ");
				put(x.token.image);
				put("(");
				for (l = if(x.pparams != null, x.pparams.list); l != null && !full; l = l.tail) {
					if (l != x.pparams.list) put(", ");
					putPackingParam(l.head);
				}
				put("): ");
				put(if(x.size != null, x.size.token.image, AnalysisDisplayText.UNKNOWN));
			}
			x: VstEnumCase => {
				if (x.receiver != null) put(x.receiver.token.image).put(".");
				put(x.token.image);
			}
			// A data type, "type T(x: int)", is its own single case.
			x: VstCaseMember => {
				if (x.decl != null && !x.decl.isSynthetic) {
					putClass(x.decl);
				} else {
					put("case ");
					put(x.token.image);
					if (x.decl != null) putParams(x.decl.params, false);
				}
			}
			// A layout field's type is its memory type, as the source writes it.
			x: VstLayoutField => {
				put("+");
				if (x.offset != null) put(x.offset.token.image);
				put(" ");
				put(x.token.image);
				put(": ");
				var mt = x.mtref;
				if (mt != null && mt.tname != null) {
					put(mt.tname.name.image);
					if (mt.repeat != null) put("[").put(mt.repeat.token.image).put("]");
				} else {
					put(AnalysisDisplayText.UNKNOWN);
				}
			}
			_ => put(token.image);
		}
		return strings.intern(buf);
	}
	private def putClass(c: VstClass) {
		put(if(c.kind == Kind.VARIANT, "type ", "class "));
		put(c.token.image);
		putTypeParams(c.typeParams);
		putParams(c.params, true);
		var s = c.superclass;
		if (s == null) return;
		put(" extends ");
		putSuperclass(s);
	}
	private def putSuperclass(s: TypeRef) {
		// With -lang:open-types, "type W extends V" extends V's default case,
		// "case _", which verification binds; the source names the variant.
		var t = resolve(s.binding, 0);
		if (NamedTypeRef.?(s) && NamedTypeRef.!(s).left == null && ClassType.?(t) && !unknown(t)) {
			var vc = ClassType.!(t).classDecl.variantCase;
			if (vc != null && vc.decl.isSynthetic && vc.isDefaultCase()) {
				putNamed(t, 0, false);
				return;
			}
		}
		putType(t, 0);
	}
	// An index method is spelled as it is declared: "def [i: int] -> int"
	// and "def [i: int] = v: int".
	private def putMethod(m: VstMethod) {
		var f = m.func, name = m.token.image;
		put("def ");
		if (m.isIndexed()) {
			var setter = Strings.equal(name, "[]="), params = if(f.params != null, f.params.list);
			put("[");
			for (l = params; l != null && !full; l = l.tail) {
				if (setter && l.tail == null) {
					put("] = ");
					putTyped(l.head.token.image, l.head.vtype);
					return;
				}
				if (l != params) put(", ");
				putTyped(l.head.token.image, l.head.vtype);
			}
			put("]");
		} else {
			put(name);
			putTypeParams(m.typeParams);
			putParams(f.params, false);
		}
		match (f.rettype) {
			Void => ;
			// Constructors return this too, but they render as "new(...)".
			This => put(" -> this");
			_ => {
				put(" -> ");
				putType(returnType(m), 0);
			}
		}
	}
	// Class parameters declared with var are writable {fields}.
	private def putParams(params: VstList<ParamDecl>, fields: bool) {
		if (params == null) return;
		put("(");
		for (l = params.list; l != null && !full; l = l.tail) {
			if (l != params.list) put(", ");
			var p = l.head;
			if (fields && p.member != null && p.member.writability != Writability.READ_ONLY) put("var ");
			putTyped(p.token.image, p.vtype);
		}
		put(")");
	}
	private def putPackingParam(p: PackingParamDecl) {
		put(p.token.image);
		put(": ");
		put(if(p.size != null, p.size.token.image, AnalysisDisplayText.UNKNOWN));
	}
	private def putTypeParams(list: List<TypeParamType>) {
		if (list == null) return;
		put("<");
		for (l = list; l != null && !full; l = l.tail) {
			if (l != list) put(", ");
			put(l.head.token.image);
		}
		put(">");
	}
	private def putTyped(name: string, t: Type) {
		put(name);
		put(": ");
		putType(t, 0);
	}

	// A declaration's own type, if it is one Type, or null.
	private def ownType(decl: Decl) -> Type {
		match (decl) {
			x: VstNew => return null;
			x: VstMethod => return x.func.ftype;
			x: VstField => return x.vtype;
			x: VarDecl => return x.vtype;
			x: VstCompound => return compoundType(x);
			x: VstEnumCase => return if(x.receiver != null, compoundType(x.receiver));
			x: VstCaseMember => return if(x.decl != null, x.decl.declType, if(x.receiver != null, x.receiver.declType));
			x: VstLayoutField => return if(x.mtref != null, x.mtref.getType());
		}
		return null;
	}
	// The text of a declaration's own type. Types are never created here:
	// collection runs after the adapter released the global type cache (see
	// AnalysisTypeCache), so a function type is rendered from its parts.
	private def declarationType(decl: Decl) -> string {
		match (decl) {
			x: VstNew => return functionText(x.func.params, if(x.receiver != null, x.receiver.declType), false);
			x: VstMethod => return functionText(x.func.params, returnType(x), false);
		}
		return typeText(ownType(decl));
	}
	// Renders as putType renders the function type, if any.
	// {ret} is a {concrete} type, the receiver's, that substitution must not
	// change.
	private def functionText(params: VstList<ParamDecl>, ret: Type, concrete: bool) -> string {
		start();
		var list = if(params != null, params.list);
		if (list == null) {
			put("void");
		} else if (list.tail == null) {
			var paren = isFunction(list.head.vtype);
			if (paren) put("(");
			putType(list.head.vtype, 1);
			if (paren) put(")");
		} else {
			put("(");
			for (l = list; l != null && !full; l = l.tail) {
				if (l != list) put(", ");
				putType(l.head.vtype, 2);
			}
			put(")");
		}
		put(" -> ");
		if (concrete) putUnsubstituted(ret, 1);
		else putType(ret, 1);
		return strings.intern(buf);
	}
	// Reads the verifier's result: VstFunc.getReturnType traps on a return
	// type that failed to resolve.
	private def returnType(m: VstMethod) -> Type {
		match (m.func.rettype) {
			Void => return Void.TYPE;
			This => return if(m.receiver != null, m.receiver.declType);
			Implicit(expr) => return if(expr.implicitType == null, expr.exactType, expr.implicitType);
			Explicit(tref) => return tref.binding;
		}
	}
	// Does not create the type, unlike VstCompound.getDeclaredType.
	private def compoundType(c: VstCompound) -> Type {
		if (c.declType != null) return c.declType;
		return if(c.typeCon != null, c.typeCon.singleton);
	}

	// Writes the text of {t}, at nesting {depth}.
	private def putType(t: Type, depth: int) {
		if (full) return;
		if (depth >= AnalysisDisplayText.MAX_DEPTH) {
			put(AnalysisDisplayText.ELISION);
			return;
		}
		t = resolve(t, depth);
		if (unknown(t)) {
			put(AnalysisDisplayText.UNKNOWN);
			return;
		}
		if (substParams != null && TypeParamType.?(t)) {
			var arg = substitute(TypeParamType.!(t));
			if (arg != null) {
				putUnsubstituted(arg, depth);
				return;
			}
		}
		var nested = t.nested;
		match (t.typeCon) {
			x: Function_TypeCon => {
				if (nested == null || nested.tail == null) {
					put(AnalysisDisplayText.UNKNOWN);
					return;
				}
				var ref = x.kind == Kind.FUNCREF, paren = isFunction(nested.head);
				if (ref) put("&(");
				if (paren) put("(");
				putType(nested.head, depth + 1);
				if (paren) put(")");
				put(" -> ");
				putType(nested.tail.head, depth + 1);
				if (ref) put(")");
			}
			x: Tuple_TypeCon => {
				if (nested == null) {
					put("void");
				} else if (nested.tail == null) {
					putType(nested.head, depth + 1);
				} else {
					put("(");
					putTypes(nested, depth + 1);
					put(")");
				}
			}
			x: V3Ref_TypeCon => {
				put(x.name);
				if (x.layoutDecl != null) put("<").put(x.layoutDecl.fullName).put(">");
			}
			_ => putNamed(t, depth, true);
		}
	}
	// A variant case's class is named "V.A", but its type arguments are the
	// variant's: V<T>.A. Without {withCase}, the variant alone: V<T>.
	private def putNamed(t: Type, depth: int, withCase: bool) {
		var name = t.typeCon.name, suffix: string, nested = t.nested;
		if (ClassType.?(t)) {
			var c = ClassType.!(t).classDecl;
			if (c != null && c.isSynthetic && c.variantCase != null) {
				suffix = c.token.image;
				if (name.length > suffix.length) name = Arrays.range(name, 0, name.length - suffix.length - 1);
				else suffix = null;
			}
		}
		put(name);
		if (nested != null) {
			put("<");
			putTypes(nested, depth + 1);
			put(">");
		}
		if (suffix != null && withCase) put(".").put(suffix);
	}
	// Renders {t} without substitution. Substitution happens once: an
	// argument can name the parameters it replaces, as in Box<T> for T.
	private def putUnsubstituted(t: Type, depth: int) {
		var params = substParams, args = substArgs;
		substParams = null;
		substArgs = null;
		putType(t, depth);
		substParams = params;
		substArgs = args;
	}
	private def substitute(p: TypeParamType) -> Type {
		var a = substArgs;
		for (l = substParams; l != null && a != null; l = l.tail) {
			if (l.head == p) return a.head;
			a = a.tail;
		}
		return null;
	}
	private def putTypes(list: List<Type>, depth: int) {
		for (l = list; l != null && !full; l = l.tail) {
			if (l != list) put(", ");
			putType(l.head, depth);
		}
	}
	// Follows solved inference variables. Returns null for one without a
	// solution, or for a chain longer than the depth bound.
	private def resolve(t: Type, depth: int) -> Type {
		for (i = depth; i < AnalysisDisplayText.MAX_DEPTH; i++) {
			if (!TypeVarType.?(t)) return t;
			var v = TypeVarType.!(t).vtype;
			if (v == t) return null;
			t = v;
		}
		return null;
	}
	private def unknown(t: Type) -> bool {
		if (t == null || TypeVarType.?(t) || NullType.?(t) || AnyFuncType.?(t)) return true;
		// The error type, and each unresolved type name, has a VOID type constructor.
		return t.typeCon.kind == Kind.VOID && t != Void.TYPE;
	}
	// Whether {t} renders as a function type, which needs parentheses as a
	// parameter. A substituted type parameter renders as its argument.
	private def isFunction(t: Type) -> bool {
		t = resolve(t, 0);
		if (substParams != null && TypeParamType.?(t)) {
			var arg = substitute(TypeParamType.!(t));
			if (arg != null) t = resolve(arg, 0);
		}
		return t != null && Function_TypeCon.?(t.typeCon);
	}

	private def start() {
		buf.reset();
		full = false;
	}
	// Appends {s} unless the text would pass MAX_BYTES; then appends the
	// elision marker instead, and nothing more.
	private def put(s: string) -> this {
		if (full) return;
		if (buf.length + s.length > AnalysisDisplayText.MAX_BYTES - AnalysisDisplayText.ELISION.length) {
			full = true;
			buf.puts(AnalysisDisplayText.ELISION);
			return;
		}
		buf.puts(s);
	}
}

def hashType(t: Type) -> int {
	return t.hash;
}
// Identity, for maps of objects that are already unique, such as types.
def identical<T>(a: T, b: T) -> bool {
	return a == b;
}
// A call's signature key is its callee's declaration, which the display
// makes once, its type, which is hash-consed, and whether it passes the receiver.
def hashCall(key: (AnalysisDeclaration, Type, bool)) -> int {
	var d = key.0, h = if(d != null, d.range.beginOffset * 31 + d.kind.tag);
	return h * 1009 + key.1.hash * 7 + if(key.2, 1);
}
def sameCall(a: (AnalysisDeclaration, Type, bool), b: (AnalysisDeclaration, Type, bool)) -> bool {
	return a.0 == b.0 && a.1 == b.1 && a.2 == b.2;
}
// Signatures are equal if their texts and parameter offsets are.
component AnalysisSignatures {
	def hash(s: AnalysisSignature) -> int {
		var h = AnalysisTables.hashBytes(s.label, s.label.length) * 31 + s.start;
		for (p in s.params) h = h * 31 + AnalysisTables.hashBytes(p, p.length);
		return h;
	}
	def equal(a: AnalysisSignature, b: AnalysisSignature) -> bool {
		if (a.start != b.start || a.params.length != b.params.length || !Strings.equal(a.label, b.label)) return false;
		for (i < a.params.length) if (!Strings.equal(a.params[i], b.params[i])) return false;
		return true;
	}
}
// A declaration is its name token and kind: a class parameter's token names
// both a parameter and a field.
component AnalysisDeclarationKeys {
	def hash(key: (Token, AnalysisDeclKind)) -> int {
		var t = key.0, file = t.fileName, h = t.beginLine * 1009 + t.beginColumn * 31 + key.1.tag;
		if (file != null) h += AnalysisTables.hashBytes(file, file.length);
		return h;
	}
	def equal(a: (Token, AnalysisDeclKind), b: (Token, AnalysisDeclKind)) -> bool {
		return a.0 == b.0 && a.1 == b.1;
	}
}

// Writes a call site's display text. A call is "path:@open-close call", then
// its callee, as "METHOD add" for a declaration or "builtin", and ": " and
// its signature, each parameter in brackets, and each argument's span.
// Each piece is written to {out} as it is made, so that a line whose
// parameters all name one long string is never held whole.
component AnalysisCallDisplay {
	def write(out: AnalysisReport, path: string, call: AnalysisCall) {
		out.puts(path).put2(":@%d-%d call", call.open, call.close);
		if (call.target != null) out.sp().puts(call.target.kind.name).sp().puts(call.target.name);
		else if (call.callee >= 0) out.puts(" builtin");
		var s = call.signature;
		out.puts(": ").puts(if(s != null, s.label, AnalysisDisplayText.UNKNOWN));
		if (s != null) {
			out.puts("; parameters");
			for (p in s.params) out.puts(" [").puts(p).puts("]");
		}
		out.puts("; arguments");
		for (i < call.argCount()) {
			if (i > 0) out.puts(",");
			out.put2(" @%d-%d", call.args[2 * i], call.args[2 * i + 1]);
		}
		out.ln();
	}
}

// Output of the analyze command. Prints only if asked, and hashes everything
// written (64-bit FNV-1a) so that repeated runs can be compared cheaply.
class AnalysisReport(print: bool) {
	var hash = 0xcbf29ce484222325ul;
	var occurrences: int;
	var bytes: long;
	// Holds the pieces that need formatting, never a whole line.
	private def formatBuf = StringBuilder.new();

	// Writes and clears {buf}.
	def write(buf: StringBuilder) {
		for (i < buf.length) hash = (hash ^ buf.buf[i]) * 0x100000001b3ul;
		if (print && buf.length > 0) System.out.putr(buf.buf[0 ..+ buf.length]);
		bytes += long.view(buf.length);
		buf.reset();
	}
	// Writes {s} without copying it.
	def puts(s: string) -> this {
		for (i < s.length) hash = (hash ^ s[i]) * 0x100000001b3ul;
		if (print && s.length > 0) System.out.puts(s);
		bytes += long.view(s.length);
	}
	// Writes {fmt} rendered with {a} and {b}.
	def put2<A, B>(fmt: string, a: A, b: B) -> this {
		formatBuf.put2(fmt, a, b);
		write(formatBuf);
	}
	def sp() -> this {
		puts(" ");
	}
	def ln() -> this {
		puts("\n");
	}
}
