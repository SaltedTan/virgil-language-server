// The declarations visible at a byte offset of one file of a parsed program,
// as the verifier binds names there: MethodEnv.lookupVar for a name in an
// expression, which tries the locals of the method and of the methods around
// a lambda, the members of the receiver's type, the file's own top-level
// declarations, the types, and the layouts, in that order; and TypeEnv.lookup
// for a name in a type. It walks only the member and the statements that
// contain the offset, binding locals in the order TypeChecker binds them, so
// that no local leaks from a sibling scope or from later in its block.
// See docs/architecture.md#completion.
class AnalysisScopeFinder(sources: AnalysisSourceMaps, display: AnalysisDisplay, prog: Program, file: VstFile, syntax: SymbolSyntaxIndex)
		extends VstVisitor<void, void> {
	// A cycle of superclasses is an error; stop following one.
	def MAX_HIERARCHY = 256;
	private var offset: int;
	private var coordinates: AnalysisCoordinates;
	// The local scopes that contain the offset, outermost first, each with
	// the variables bound in it before the offset (VarEnvironment).
	private def scopes = Vector<Vector<VarDecl>>.new();
	// The scope that binds the receiver, "this", or -1.
	private var thisScope = -1;
	// The compound and the method whose member holds the offset, or null.
	private var compound: VstCompound;
	private var method: VstMethod;
	// Names resolve through the members of the receiver's type: in a method,
	// a constructor, or a field's initializer (MethodEnv.thisParam).
	private var receiver: bool;
	// The field whose initializer holds the offset, or null.
	private var initField: VstField;
	// MethodEnv.initOrder at the offset, which TypeChecker.typeCheckNew sets:
	// in a class's field initializer, the field's initOrder, and 0 elsewhere,
	// as in a component's, whose fields have none. Where it is above 0, the
	// receiver's members are checked (MethodEnv.checkMemberInit).
	private var initOrder: int;
	// The offset is in a class's super clause, which typeCheckNew checks
	// with initOrder at the class's superInitOrder (see members).
	private var superCall: bool;
	// The match whose patterns, rather than a case's statement, hold the offset.
	private var patterns: MatchStmt;
	// A pattern's head that compares a value: only the constants that
	// TypeChecker.visitMatchPattern accepts are offered (see members).
	private var constants: bool;
	// The answer: candidates, their levels, and the names each kind of name
	// has bound so far, nearest first, which hide later ones. AA trees keep
	// the names, not Virgil's HashMaps: a map stops growing at 1,024 buckets,
	// so each of tens of thousands of names scans a long chain, and its
	// polynomial string hash lets equal-length names built from "Aa" and
	// "BB" blocks all collide in one (OrderedStringSet).
	private def found = Vector<AnalysisDeclaration>.new();
	private def levels = Vector<int>.new();
	private def valueNames = OrderedStringSet.new();
	private def typeNames = OrderedStringSet.new();
	// Where the statement that the walk enters ends, as the statement or
	// block around it found (see holds).
	private var end: int;
	// The lambdas that the last lambda entered ends with, after it, which
	// end where it does, at {edgeEnd}; the walk meets them in this order, and
	// {edgeNext} is the next (see visitFunExpr).
	private def edge = Vector<FunExpr>.new();
	private var edgeNext: int;
	private var edgeEnd: int;
	// The members, statements, cases, expressions, types, and parameters
	// that the walk has read, including those that each range() it asks for
	// reads (see range), which grows in proportion to the code that contains
	// the offset and its siblings; AnalysisScope:deep_nesting checks it.
	private var steps: int;
	// For a member query (findMembers), the member expression whose "." the
	// offset follows, once the walk has found it; the walk then stops.
	private var memberQuery: bool;
	private var memberExpr: VarExpr;
	// The member expression whose receiver memberExpr is, as "L.f.offset" is
	// for "L.f", if any.
	private var memberUse: VarExpr;

	// The names of {kinds} (AnalysisScopeKinds) visible at {offset}; see
	// AnalysisScopeOrder for the order and the cap, which {prefix} applies.
	// Null if verification did not reach the offset (see reached).
	def find(offset: int, kinds: int, prefix: string) -> AnalysisScopeAnswer {
		this.offset = offset;
		locate();
		if (!reached()) return null;
		var values = (kinds & AnalysisScopeKinds.VALUES) != 0, types = (kinds & AnalysisScopeKinds.TYPES) != 0;
		var layouts = values || (kinds & AnalysisScopeKinds.LAYOUTS) != 0;
		// A pattern's head names a case of the matched type, or, for a type
		// without cases, a constant; for a type that verification left
		// unknown, nothing.
		if ((kinds & AnalysisScopeKinds.PATTERN) != 0) constants = cases() == 0;
		var memberValues = values || constants;
		var level = 0, thisLevel = -1;
		for (i = scopes.length - 1; i >= 0; i--) {
			var s = scopes[i];
			if (memberValues) for (j < s.length) local(s[j], level, values);
			if (i == thisScope) {
				if (valueNames.add("this")) thisLevel = level;
			}
			level++;
		}
		if (receiver && compound != null && !compound.isFileScope) {
			var c = compound;
			for (depth = 0; c != null && depth < MAX_HIERARCHY; depth++) {
				if (memberValues) members(c, level, true);
				level++;
				c = superclass(c);
			}
		}
		if (file.synthetic != null) {
			if (memberValues) members(file.synthetic, level, false);
			level++;
		}
		if (method != null) typeParams(method.typeParams, values, types, level);
		level++;
		if (compound != null) typeParams(compound.typeParams, values, types, level);
		level++;
		if (file.typeEnv != null) typeCons(file.typeEnv, values, types, level);
		level++;
		typeCons(prog.typeEnv, values, types, level);
		level++;
		// Layouts are values (MethodEnv.lookupVar), and the one argument that
		// Ref<...> takes (VstCompoundVerifier.resolveRefType).
		if (layouts && prog.layouts != null) {
			var l = level;
			prog.layouts.apply(fun (name: string, decl: VstLayout) => add(valueNames, make(AnalysisDeclKind.LAYOUT, decl), l, true));
		}
		return answer(thisLevel, prefix, values, types);
	}
	// The members of the receiver of the member expression whose "." comes
	// before {offset}, with only space, comments, and the start of its name
	// between, as AnalysisMemberLookup finds them; see AnalysisScopeOrder for
	// the order and the cap, which {prefix} applies. The walk to the offset
	// is a scope query's, which reads each expression of the statement that
	// holds it until it meets the member expression. Null if verification
	// did not reach the offset (see reached), or if no member expression is
	// there, as in a type's name.
	def findMembers(offset: int, prefix: string) -> AnalysisMemberAnswer {
		this.offset = offset;
		memberQuery = true;
		locate();
		if (!reached() || memberExpr == null) return null;
		var answer = AnalysisMemberLookup.new(display, file.fileName, prog.layouts).find(memberExpr, memberUse, prefix);
		answer.steps += steps;
		return answer;
	}
	// Whether verification reached the offset. Verifier.verify type-checks
	// compound after compound, and stops between two (Verifier.forAll) once
	// the error limit is reached (ErrorGen.notTooMany); it then has bound no
	// name in the compounds it skipped. So the offset is reached if the limit
	// never was, or if the code around it was type-checked: TypeChecker.
	// enterMethod sets a method's func.thisParam, and nothing else does
	// before code generation; and typeCheckNew enters a compound's
	// constructor, which every compound but a layout has, so a constructor
	// with it means that its compound's fields were type-checked, and, as
	// typeCheckVstCompound does not stop, all its members. Outside a
	// compound, only a verification that never stopped reaches the offset.
	private def reached() -> bool {
		if (prog.ERROR.notTooMany) return true;
		var f = if(method != null, method.func, if(compound != null && compound.constructor != null, compound.constructor.func));
		return f != null && f.thisParam != null;
	}
	// Sorts the candidates, and caps them: past the cap, only those that
	// start with {prefix} are kept, up to it.
	private def answer(thisLevel: int, prefix: string, values: bool, types: bool) -> AnalysisScopeAnswer {
		var order = Array<int>.new(found.length);
		for (i < order.length) order[i] = i;
		order = AnalysisTables.sort(order, fun (a: int, b: int) => AnalysisScopeOrder.before(
			levels[a], AnalysisScopeOrder.group(found[a].kind), found[a].name,
			levels[b], AnalysisScopeOrder.group(found[b].kind), found[b].name));
		var truncated = order.length > AnalysisScopeOrder.MAX_DECLARATIONS;
		var kept = Vector<int>.new();
		for (i in order) {
			if (kept.length == AnalysisScopeOrder.MAX_DECLARATIONS) break;
			if (!truncated || Strings.startsWith(found[i].name, prefix)) kept.put(i);
		}
		var decls = Array<AnalysisDeclaration>.new(kept.length), result = Array<int>.new(kept.length);
		for (i < kept.length) {
			decls[i] = found[kept[i]];
			result[i] = levels[kept[i]];
		}
		var answer = AnalysisScopeAnswer.new(decls, result, thisLevel, truncated);
		answer.steps = steps;
		var hidden = Vector<string>.new();
		var hide = fun (name: string) {
			if ((values || types) && (!values || valueNames.has(name)) && (!types || typeNames.has(name))) hidden.put(name);
		};
		for (name in AeneasAdapter.BUILTIN_TYPES) hide(name);
		for (width = 1; width <= Int.MAX_WIDTH; width++) {
			for (sign in ["i", "u"]) hide(Strings.format2("%s%d", sign, width));
		}
		answer.hiddenBuiltins = hidden.extract();
		answer.nameComparisons = valueNames.compares + typeNames.compares;
		return answer;
	}
	// Adds {d} at {level} unless an earlier candidate has its name in the
	// namespace of {names}, or it is a candidate already: a type is added for
	// both namespaces in turn, so only the last candidate can be it.
	private def add(names: OrderedStringSet, d: AnalysisDeclaration, level: int, offered: bool) {
		if (d == null || !names.add(d.name)) return;
		if (!offered) return;
		if (found.length > 0 && found[found.length - 1] == d) return;
		found.put(d);
		levels.put(level);
	}
	private def local(v: VarDecl, level: int, offered: bool) {
		if (v.isUnderscore()) return;
		add(valueNames, make(if(ParamDecl.?(v), AnalysisDeclKind.PARAMETER, AnalysisDeclKind.LOCAL), v), level, offered);
	}
	// The fields and methods of {c} that a name resolves to through the
	// receiver if {receiver} (MethodEnv.lookupExprMember), or as a member of
	// the file's synthetic component: those that are not private to another
	// file (VstCompoundVerifier.canAccessMember), and that an identifier can
	// name, unlike an index or operator method such as "[]" or "==". An
	// enum's methods are not (MethodEnv.lookupEnumExprMember). A variant's
	// or an enum's "tag" and "name" are, through the receiver
	// (lookupVariantExprMember, lookupEnumExprMember), and the cases of a
	// variant are not: only a type names them, as in V.B.
	private def members(c: VstCompound, level: int, receiver: bool) {
		var checked = receiver && (initOrder > 0 || superCall);
		// MethodEnv.checkMemberInit: no method while checked.
		var methods = !checked && !constants;
		for (l = c.members; l != null; l = l.tail) {
			var m = l.head;
			if (m.isPrivate && !sameFile(c)) continue;
			if (!identifier(m.token.image)) continue;
			match (m) {
				x: VstNew => ;
				x: VstMethod => if (!VstEnum.?(c) && !x.isSynthetic) add(valueNames, make(AnalysisDeclKind.METHOD, x), level, methods);
				x: VstField => add(valueNames, make(AnalysisDeclKind.FIELD, x), level, field(x, c, checked));
				x: VstVariantTagMember => if (receiver) add(valueNames, make(AnalysisDeclKind.FIELD, x), level, !constants);
				x: VstVariantNameMember => if (receiver) add(valueNames, make(AnalysisDeclKind.FIELD, x), level, !constants);
				_ => ;
			}
		}
	}
	// Whether field {f} of {c} is offered.
	// - A pattern's head compares only a read-only component field whose
	//   initializer is a literal (TypeChecker.visitMatchPattern).
	// - A field whose type is inferred from its own initializer is a cycle
	//   there (MethodEnv.cyclicMemberTypeInference).
	// - While {checked}, MethodEnv.checkMemberInit rejects a field whose
	//   initOrder is at most MethodEnv.initOrder. VstCompoundVerifier.verify
	//   numbers a class's fields above its superclass's superInitOrder, and
	//   in reverse order of declaration, with the constructor's parameters'
	//   fields above all: so a field initializer sees the earlier fields and
	//   those of the parameters, and no inherited field; and the super
	//   clause, checked at superInitOrder, sees the class's own fields and
	//   no inherited one.
	private def field(f: VstField, c: VstCompound, checked: bool) -> bool {
		if (constants) return VstComponent.?(c) && f.writability == Writability.READ_ONLY && Literal.?(f.init);
		if (f == initField && f.tref == null) return false;
		if (!checked) return true;
		if (superCall) return c == compound;
		return f.initOrder > initOrder;
	}
	private def sameFile(c: VstCompound) -> bool {
		return c.token != null && Strings.equal(c.token.fileName, file.fileName);
	}
	private def identifier(name: string) -> bool {
		if (name.length == 0) return false;
		var c = name[0];
		return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
	}
	// The class that {c} extends, as verification resolved it, or null.
	private def superclass(c: VstCompound) -> VstCompound {
		if (!VstClass.?(c)) return null;
		var t = VstClass.!(c).superclass;
		return if(t != null && ClassType.?(t.binding), ClassType.!(t.binding).classDecl);
	}
	private def typeParams(list: List<TypeParamType>, values: bool, types: bool, level: int) {
		for (l = list; l != null; l = l.tail) {
			var d = display.declaration(AnalysisDeclKind.TYPE_PARAM, l.head.token, null, l.head);
			if (values) add(valueNames, d, level, true);
			if (types) add(typeNames, d, level, true);
		}
	}
	// The types that {env} itself binds, other than the builtin types, which
	// have no declaration.
	private def typeCons(env: TypeEnv, values: bool, types: bool, level: int) {
		env.typecons.apply(fun (name: string, tc: TypeCon) {
			var d = typeDeclaration(tc);
			if (values) add(valueNames, d, level, true);
			if (types) add(typeNames, d, level, true);
		});
	}
	private def typeDeclaration(tc: TypeCon) -> AnalysisDeclaration {
		match (tc) {
			x: V3Class_TypeCon => return if(!x.classDecl.isSynthetic, make(AnalysisDeclKind.CLASS, x.classDecl));
			x: V3Component_TypeCon => return make(AnalysisDeclKind.COMPONENT, x.componentDecl);
		}
		if (tc.kind == Kind.ENUM && EnumType.?(tc.singleton)) return make(AnalysisDeclKind.ENUM, EnumType.!(tc.singleton).enumDecl);
		return null;
	}
	// Adds, at level 0, the cases that an unqualified pattern's head can name
	// in the match of {patterns}, as TypeChecker.visitMatchPattern looks them
	// up in the type that verification inferred for its expression
	// (MatchStmtVerifier): an enum's cases (checkEnumPattern); for a variant,
	// a case member of the type's own declaration (checkVariantPattern,
	// ClassType.lookupCase), so none for a case's type, such as V.A, or a
	// variant without cases, such as "type Box(x: int);". Returns 1 then, 0
	// for another type, whose patterns compare values, and -1 if there is no
	// match or verification left its type unknown: ErrorGen's types for
	// errors are of kind VOID.
	//
	// ClassType.lookupCase returns the declaration's member map's binding for
	// the case's name, if that binding is a case member itself: Verifier.
	// buildMembers filled the map in member order with the first member of
	// each name. A synthetic member that verification adds afterwards, such
	// as the method of a lambda's name (TypeChecker.visitFunExpr), is not in
	// the map and so hides nothing. The query asks the same map, as the
	// verifier does itself while checking the match, so it does no more of
	// that work than the analysis that produced it; the map's 1,024-bucket
	// cap is tracked in #155.
	private def cases() -> int {
		var t = if(patterns != null && patterns.expr != null, patterns.expr.exactType);
		if (t == null || t.typeCon == null || t.typeCon.kind == Kind.VOID) return -1;
		if (EnumType.?(t)) {
			for (c in EnumType.!(t).enumDecl.cases) add(valueNames, make(AnalysisDeclKind.ENUM_CASE, c), 0, true);
			return 1;
		}
		if (!V3.isVariant(t) || !ClassType.?(t)) return 0;
		var decl = ClassType.!(t).classDecl;
		for (l = decl.members; l != null; l = l.tail) {
			steps++;
			if (!VstCaseMember.?(l.head)) continue;
			var c = VstCaseMember.!(l.head);
			if (!c.isDefaultCase() && decl.memberMap != null && decl.memberMap[c.name()] == c) {
				add(valueNames, make(AnalysisDeclKind.VARIANT_CASE, c), 0, true);
			}
		}
		return 1;
	}
	private def make(kind: AnalysisDeclKind, decl: Decl) -> AnalysisDeclaration {
		return if(decl != null, display.declaration(kind, decl.token, decl, null));
	}

	// Finds the member that holds the offset and enters it as the verifier
	// does (TypeChecker.enterMethod, enterCompound, and typeCheckNew).
	private def locate() {
		var best: VstMember, bestCompound: VstCompound, size = int.max;
		var header: VstCompound, headerBegin = -1;
		var boundaries = DocumentSymbolCollector.new(file, syntax);
		for (i < file.components.length + file.classes.length + file.enums.length + file.layouts.length) {
			var c: VstCompound;
			if (i < file.components.length) c = file.components[i];
			else if (i < file.components.length + file.classes.length) c = file.classes[i - file.components.length];
			else if (i < file.components.length + file.classes.length + file.enums.length) c = file.enums[i - file.components.length - file.classes.length];
			else c = file.layouts[i - file.components.length - file.classes.length - file.enums.length];
			// A class's own super clause is its constructor's.
			if (c.superclause != null && c.superclause.args != null && inside(range(c.superclause.args)) && c.constructor != null) {
				enterConstructor(c, c.constructor, c.superclause.args);
				return;
			}
			var first = int.max;
			for (l = c.members; l != null; l = l.tail) {
				var m = l.head;
				steps++;
				// A parameter's field, a default constructor, or a lambda's method.
				if (m.isSynthetic) continue;
				var e = extent(m);
				if (e.0 < 0) continue;
				if (e.0 < first) first = e.0;
				if (e.0 <= offset && offset < e.1 && e.1 - e.0 < size) {
					best = m;
					bestCompound = c;
					size = e.1 - e.0;
				}
			}
			// A type in a declaration's header, before its members.
			var begin = if(!c.isSynthetic, tokenBegin(c.token), -1);
			if (begin >= 0 && begin <= offset && offset < first && begin > headerBegin && offset < boundaries.compoundEnd(c)) {
				header = c;
				headerBegin = begin;
			}
		}
		if (best == null) {
			compound = header;
			return;
		}
		compound = bestCompound;
		match (best) {
			x: VstNew => {
				var sc = x.superclause;
				if (sc != null && sc.args != null && inside(range(sc.args))) enterConstructor(compound, x, sc.args);
				else enterMethod(x);
			}
			x: VstMethod => enterMethod(x);
			// In the initializer, or in the space or comments before it,
			// after the field's name and type.
			x: VstField => if (x.init != null && offset >= fieldHeaderEnd(x)) {
				// A component's initializers bind "this" (typeCheckNew calls
				// enterMethod); a class's and an enum's do not (enterCompound).
				receiver = true;
				initField = x;
				initOrder = x.initOrder;
				if (VstComponent.?(compound) && !compound.isFileScope) enterScope(true);
				walk(x.init);
			}
			x: VstEnumCase => if (x.args != null) {
				for (l = x.args.list; l != null; l = l.tail) walk(l.head);
			}
			_ => ;
		}
	}
	// The method's body, or its header, where only types are named.
	private def enterMethod(m: VstMethod) {
		method = m;
		var body = m.func.body;
		if (body == null || offset < point(stmtRange(body))) return;
		receiver = true;
		enterScope(!compound.isFileScope);
		params(m.func.params, null);
		walkStmt(body);
	}
	// A super clause, checked with the constructor's receiver and parameters,
	// after the field initializers (typeCheckNew), but with initOrder at the
	// class's superInitOrder, above 0: "this" is an error there
	// (MethodEnv.lookupVar: InvalidThisUse), and so are the members that
	// checkMemberInit rejects.
	private def enterConstructor(c: VstCompound, ctor: VstNew, args: TupleExpr) {
		compound = c;
		method = ctor;
		receiver = true;
		superCall = true;
		enterScope(false);
		params(ctor.func.params, null);
		walk(args);
	}
	private def enterScope(binds: bool) {
		if (binds) thisScope = scopes.length;
		scopes.put(Vector<VarDecl>.new());
	}
	private def bind(v: VarDecl) {
		if (v != null) scopes[scopes.length - 1].put(v);
	}
	// Binds {list}, less the parameters that verification appended to a
	// lambda's for the variables it {captures}. Those are the last: MethodEnv.
	// lookupVar numbers each capture's parameter after the declared ones,
	// which TypeChecker.enterFunc numbers from 1, and TypeChecker.
	// visitFunExpr rebuilds the list in that order. lookupVar names each
	// with the token of a use in the lambda's body, after the header that
	// holds the declared ones, so the walk stops at the first and reads no
	// other capture: nested lambdas that capture the same variables read
	// only their own parameters.
	private def params(list: VstList<ParamDecl>, captures: List<(ParamDecl, VarBinding.Local)>) {
		if (list == null) return;
		var header = rangeEnd(list.src);
		for (l = list.list; l != null; l = l.tail) {
			steps++;
			if (captures != null && tokenBegin(l.head.token) > header) return;
			bind(l.head);
		}
	}
	// Enters a branch, which has a scope of its own (typeCheckStmtWithNewScope).
	private def branch(s: Stmt) {
		if (s == null) return;
		if (!BlockStmt.?(s)) enterScope(false);
		walkStmt(s);
	}
	// Each statement and expression that the walk enters is a step.
	private def walk(e: Expr) {
		if (e == null || memberExpr != null) return;
		steps++;
		e.accept(this, ());
	}
	private def walkStmt(s: Stmt) {
		if (memberExpr != null) return;
		steps++;
		s.accept(this, ());
	}

	// Statements that hold the offset.
	def visitBlock(s: BlockStmt, env: void) {
		enterScope(false);
		for (l = if(s.stmts != null, s.stmts.list); l != null; l = l.tail) {
			var st = l.head;
			steps++;
			if (stmtBegin(st) > offset) return;
			var e = stmtEnd(st);
			if (e <= offset) {
				// A statement before the offset binds only its own locals.
				if (LocalStmt.?(st)) for (v = LocalStmt.!(st).vars; v != null; v = v.tail) bind(v.head);
				continue;
			}
			end = e;
			walkStmt(st);
			return;
		}
	}
	// A statement's last branch or body ends where the statement does.
	def visitIf(s: IfStmt, env: void) {
		var e = end;
		if (inside(range(s.cond))) walk(s.cond);
		else if (holds(s.tbranch, if(s.fbranch == null, e, -1))) branch(s.tbranch);
		else if (holds(s.fbranch, e)) branch(s.fbranch);
	}
	def visitWhile(s: WhileStmt, env: void) {
		var e = end;
		if (inside(range(s.cond))) walk(s.cond);
		else if (holds(s.body, e)) branch(s.body);
	}
	// The variable is bound after its initializer, and the condition, update,
	// and body see it (TypeChecker.visitFor).
	def visitFor(s: ForStmt, env: void) {
		var e = end;
		enterScope(false);
		var v = s.varDecl;
		if (v != null) {
			if (v.init != null && inside(range(v.init))) return walk(v.init);
			if (offset < varEnd(v)) return;
			bind(v);
		}
		if (inside(range(s.cond))) walk(s.cond);
		else if (inside(range(s.update))) walk(s.update);
		else if (holds(s.body, e)) branch(s.body);
	}
	// The variable is bound before the expression is checked, so the
	// expression sees it (TypeChecker.visitForeach).
	def visitForeach(s: ForeachStmt, env: void) {
		var e = end;
		enterScope(false);
		bind(s.varDecl);
		if (inside(range(s.expr))) walk(s.expr);
		else if (holds(s.body, e)) branch(s.body);
	}
	// The variable is bound after the limit is checked, and the body is
	// checked in the loop's scope (TypeChecker.visitForLess). The space
	// before the limit is the limit's.
	def visitForLess(s: ForLessStmt, env: void) {
		var e = end;
		enterScope(false);
		if (s.expr != null && offset < rangeEnd(range(s.expr))) return walk(s.expr);
		bind(s.varDecl);
		if (holds(s.body, e)) walkStmt(s.body);
	}
	// Each variable is bound after its initializer (TypeChecker.checkVarDecl).
	def visitLocal(s: LocalStmt, env: void) {
		for (l = s.vars; l != null; l = l.tail) {
			var v = l.head;
			if (v.init != null && inside(range(v.init))) return walk(v.init);
			if (offset < varEnd(v)) return;
			bind(v);
		}
	}
	def visitBreak(s: BreakStmt, env: void) { }
	def visitContinue(s: ContinueStmt, env: void) { }
	def visitExpr(s: ExprStmt, env: void) {
		walk(s.expr);
	}
	// A case with one pattern binds its variable or its parameters for its
	// statement (TypeChecker.visitMatch); otherwise the offset is in the
	// patterns. The space before the matched expression is the expression's,
	// and a case's statement begins where its patterns end, after "=>" or
	// "else" (Parser.parseMatchCase), so the space before it is the case's.
	// A statement after "else" and the braces ends where the match does.
	def visitMatch(s: MatchStmt, env: void) {
		var e = end;
		if (s.expr != null && offset < rangeEnd(range(s.expr))) return walk(s.expr);
		var last = elseStmt(s);
		for (l = if(s.cases != null, s.cases.list); l != null; l = l.tail) {
			var c = l.head;
			steps++;
			if (c.stmt == null || c.patterns == null) continue;
			var begin = rangeEnd(c.patterns.range());
			if (begin < 0 || offset < begin) continue;
			var caseEnd = if(c.stmt == last, e, stmtEnd(c.stmt));
			if (offset >= caseEnd) continue;
			var pats = if(c.patterns != null, c.patterns.list);
			var pat = if(pats != null && pats.tail == null, pats.head);
			// The default case's pattern binds a variable named by the
			// keyword "else" (Parser.parseMatchStmt), which no name can use.
			if (pat != null && pat.vdecl != null && Strings.equal(pat.vdecl.token.image, "else")) pat = null;
			if (pat != null && (pat.vdecl != null || pat.params != null)) {
				enterScope(false);
				if (pat.vdecl != null) bind(pat.vdecl);
				else for (p = pat.params.list; p != null; p = p.tail) bind(p.head);
			}
			end = caseEnd;
			walkStmt(c.stmt);
			return;
		}
		patterns = s;
	}
	def visitEmpty(s: EmptyStmt, env: void) { }
	def visitReturn(s: ReturnStmt, env: void) {
		walk(s.expr);
	}

	// Expressions, searched for the lambda that holds the offset.
	def visitTuple(e: TupleExpr, env: void) {
		exprs(e.exprs);
	}
	def visitParamExpr(e: ParamExpr, env: void) { }
	def visitAutoExpr(e: AutoExpr, env: void) {
		walk(e.expr);
	}
	def visitArray(e: ArrayExpr, env: void) {
		exprs(e.exprs);
	}
	// A member query's expression is the member expression whose "." is
	// before the offset and whose name starts at or after it (VarExpr.dot);
	// what follows a "." is one member's name, so no other has the offset
	// between the two.
	def visitVar(e: VarExpr, env: void) {
		if (memberQuery && e.expr != null) {
			var dot = point(e.dot);
			if (dot >= 0 && dot < offset && offset <= tokenBegin(e.ident.name)) {
				memberExpr = e;
				return;
			}
		}
		walk(e.expr);
		if (memberExpr != null && memberExpr == e.expr && memberUse == null) memberUse = e;
	}
	def visitLiteral(e: Literal, env: void) { }
	def visitString(e: StringExpr, env: void) { }
	def visitApp(e: AppExpr, env: void) {
		walk(e.func);
		walk(e.args);
	}
	def visitIndex(e: IndexExpr, env: void) {
		walk(e.expr);
		exprs(e.exprs);
	}
	def visitRange(e: RangeExpr, env: void) {
		walk(e.expr);
		walk(e.start);
		walk(e.end);
	}
	def visitNot(e: NotExpr, env: void) {
		walk(e.expr);
	}
	def visitNeg(e: NegExpr, env: void) {
		walk(e.expr);
	}
	def visitBitwiseNeg(e: BitwiseNegExpr, env: void) {
		walk(e.expr);
	}
	def visitAssign(e: AssignExpr, env: void) {
		walk(e.target);
		walk(e.expr);
	}
	def visitBinOp(e: BinOpExpr, env: void) {
		walk(e.left);
		walk(e.right);
	}
	def visitIfExpr(e: IfExpr, env: void) {
		exprs(e.exprs);
	}
	// A lambda's body sees its parameters, then the locals of the methods
	// around it, which it captures, and their receiver (TypeChecker.enterFunc,
	// MethodEnv.lookupVar). One on the edge of the last lambda entered ends
	// where that does.
	def visitFunExpr(e: FunExpr, env: void) {
		var b = point(e.start);
		if (b < 0 || b > offset) return;
		var onEdge = edgeNext < edge.length && edge[edgeNext] == e;
		var lambdaEnd = if(onEdge, edgeEnd, exprEnd(e, false));
		if (offset >= lambdaEnd) return;
		if (onEdge) {
			edgeNext++;
		} else {
			edge.clear();
			edgeNext = 0;
			edgeEnd = lambdaEnd;
			exprEnd(e, true);
		}
		enterScope(false);
		params(e.func.params, e.captures);
		if (e.func.body != null) walkStmt(e.func.body);
	}
	private def exprs(list: VstList<Expr>) {
		if (list != null) for (l = list.list; l != null; l = l.tail) walk(l.head);
	}

	// Byte extents. A statement's or a member's ends where its last part does;
	// a local statement's range covers only its keyword.
	private def extent(m: VstMember) -> (int, int) {
		var b = tokenBegin(m.token), e = tokenEnd(m.token);
		match (m) {
			x: VstMethod => if (x.func.body != null) e = Ints.max(e, stmtEnd(x.func.body));
			x: VstField => {
				if (x.tref != null) e = Ints.max(e, rangeEnd(typeRange(x.tref)));
				if (x.init != null) e = Ints.max(e, rangeEnd(range(x.init)));
			}
			x: VstEnumCase => if (x.args != null) e = Ints.max(e, rangeEnd(x.args.range()));
			_ => ;
		}
		return (b, e);
	}
	// Where a field's name, or its type if it has one, ends: only "=" and
	// space come between that and its initializer.
	private def fieldHeaderEnd(f: VstField) -> int {
		var e = tokenEnd(f.token);
		if (f.tref != null) e = Ints.max(e, rangeEnd(typeRange(f.tref)));
		return if(e < 0, int.max, e);
	}
	// Where {s} begins. The range() of a statement with a branch or a body
	// reads every statement that it ends with, as each of those does.
	private def stmtBegin(s: Stmt) -> int {
		match (s) {
			x: IfStmt => return point(x.start);
			x: WhileStmt => return point(x.start);
			x: ForStmt => return point(x.start);
			x: ForeachStmt => return point(x.start);
			x: ForLessStmt => return point(x.start);
			x: MatchStmt => return point(x.src);
		}
		return point(stmtRange(s));
	}
	// Where {s} ends: where the last statement that it ends with does, such
	// as an unbraced body's, or a match's braces. This reads each of those
	// statements once, rather than calling range() on each in turn; and the
	// walk reads them once in all, as it enters each with its end (see holds).
	private def stmtEnd(s: Stmt) -> int {
		var e = -1;
		while (s != null) {
			steps++;
			var next: Stmt;
			match (s) {
				x: IfStmt => next = if(x.fbranch != null, x.fbranch, x.tbranch);
				x: WhileStmt => next = x.body;
				x: ForStmt => next = x.body;
				x: ForeachStmt => next = x.body;
				x: ForLessStmt => next = x.body;
				x: MatchStmt => {
					if (x.cases != null) e = Ints.max(e, rangeEnd(x.cases.range()));
					next = elseStmt(x);
					if (next == null) return e;
				}
				x: LocalStmt => for (v = x.vars; v != null; v = v.tail) e = Ints.max(e, varEnd(v.head));
				_ => ;
			}
			if (next == null) return Ints.max(e, rangeEnd(stmtRange(s)));
			s = next;
		}
		return e;
	}
	// The statement of a match's default case that follows "else" after its
	// braces (Parser.parseMatchStmt), or null. Every other case's ends
	// inside the braces.
	private def elseStmt(s: MatchStmt) -> Stmt {
		if (s.cases == null) return null;
		var last: MatchCase;
		for (l = s.cases.list; l != null; l = l.tail) {
			steps++;
			last = l.head;
		}
		if (last == null || last.stmt == null) return null;
		var braces = rangeEnd(s.cases.range());
		return if(braces >= 0 && stmtBegin(last.stmt) >= braces, last.stmt);
	}
	// Whether {s} holds the offset, given {e}, where it ends if its statement
	// ends with it, or -1 to find that. If so, the walk enters it next, with
	// {end} there.
	private def holds(s: Stmt, e: int) -> bool {
		if (s == null) return false;
		var b = stmtBegin(s);
		if (b < 0 || b > offset) return false;
		if (e < 0) e = stmtEnd(s);
		if (offset >= e) return false;
		end = e;
		return true;
	}
	// Where {e} ends: where the last expression that it ends with does, as
	// each Expr.range() finds it, without reading what comes before that.
	// If {record}, the lambdas among those, after {e}, are put in {edge}.
	private def exprEnd(e: Expr, record: bool) -> int {
		var first = e;
		while (e != null) {
			steps++;
			match (e) {
				x: BinOpExpr => {
					if (x.left == null) return rangeEnd(x.op.token.range());
					e = if(x.right != null, x.right, x.left);
				}
				x: AssignExpr => {
					if (x.target == null) return rangeEnd(range(x));
					e = if(x.expr != null, x.expr, x.target);
				}
				x: NotExpr => if (x.expr != null) e = x.expr; else return rangeEnd(range(x));
				x: NegExpr => if (x.expr != null) e = x.expr; else return rangeEnd(range(x));
				x: BitwiseNegExpr => if (x.expr != null) e = x.expr; else return rangeEnd(range(x));
				x: RangeExpr => e = if(x.end != null, x.end, x.start);
				x: FunExpr => {
					if (record && x != first) edge.put(x);
					var body = x.func.body;
					if (!ReturnStmt.?(body) || ReturnStmt.!(body).expr == null) return rangeEnd(range(x));
					e = ReturnStmt.!(body).expr;
				}
				x: VarExpr => return rangeEnd(x.ident.range());
				x: AutoExpr => return rangeEnd(x.token.range());
				x: AppExpr => if (x.args != null) return rangeEnd(range(x.args)); else e = x.func;
				x: IndexExpr => if (x.exprs != null) return rangeEnd(x.exprs.range()); else e = x.expr;
				// Tuples, arrays, if(...), literals, and strings end with
				// their own last token.
				_ => return rangeEnd(range(e));
			}
		}
		return -1;
	}
	private def varEnd(v: VarDecl) -> int {
		var e = tokenEnd(v.token);
		if (v.tref != null) e = Ints.max(e, rangeEnd(typeRange(v.tref)));
		if (v.init != null) e = Ints.max(e, rangeEnd(range(v.init)));
		return e;
	}
	// Aeneas's range() for an expression, a statement, or a type reads each
	// node that it begins or ends with (Vst.v3), as exprReads, stmtReads,
	// and typeReads count them; the scope query asks for one only through
	// these, which count those nodes as steps.
	private def range(e: Expr) -> FileRange {
		if (e == null) return null;
		steps += exprReads(e);
		return e.range();
	}
	private def stmtRange(s: Stmt) -> FileRange {
		if (s == null) return null;
		steps += stmtReads(s);
		return s.range();
	}
	private def typeRange(t: TypeRef) -> FileRange {
		if (t == null) return null;
		steps += typeReads(t);
		return t.range();
	}
	private def exprReads(e: Expr) -> int {
		if (e == null) return 0;
		match (e) {
			x: VarExpr => return 1 + exprReads(x.expr);
			x: AutoExpr => return 1 + exprReads(x.expr);
			x: AppExpr => return 1 + exprReads(x.func) + exprReads(x.args);
			x: IndexExpr => return 1 + exprReads(x.expr);
			x: RangeExpr => return 1 + exprReads(x.expr) + exprReads(if(x.end != null, x.end, x.start));
			x: NotExpr => return 1 + exprReads(x.expr);
			x: NegExpr => return 1 + exprReads(x.expr);
			x: BitwiseNegExpr => return 1 + exprReads(x.expr);
			x: AssignExpr => return if(x.target == null, 1, 1 + exprReads(x.target) + exprReads(x.expr));
			x: BinOpExpr => return if(x.left == null, 1, 1 + exprReads(x.left) + exprReads(x.right));
			x: FunExpr => return 1 + stmtReads(x.func.body);
		}
		return 1;
	}
	private def stmtReads(s: Stmt) -> int {
		if (s == null) return 0;
		match (s) {
			x: IfStmt => return 1 + stmtReads(x.tbranch) + stmtReads(x.fbranch);
			x: WhileStmt => return 1 + stmtReads(x.body);
			x: ForStmt => return 1 + stmtReads(x.body);
			x: ForeachStmt => return 1 + stmtReads(x.body);
			x: ForLessStmt => return 1 + stmtReads(x.body);
			x: MatchStmt => return 1 + if(x.defcase != null, 1 + stmtReads(x.defcase.stmt));
			x: ReturnStmt => return 1 + exprReads(x.expr);
		}
		return 1;
	}
	private def typeReads(t: TypeRef) -> int {
		match (t) {
			x: FuncTypeRef => return 1 + typeReads(x.paramType) + typeReads(x.returnType);
		}
		return 1;
	}
	private def inside(r: FileRange) -> bool {
		var b = point(r);
		return b >= 0 && b <= offset && offset < rangeEnd(r);
	}
	private def tokenBegin(t: Token) -> int {
		if (AnalysisCapturedToken.?(t)) return if(Strings.equal(t.fileName, file.fileName), AnalysisCapturedToken.!(t).offset, -1);
		return point(t.range());
	}
	private def tokenEnd(t: Token) -> int {
		var b = tokenBegin(t);
		return if(b < 0, -1, b + t.image.length);
	}
	private def point(p: FilePoint) -> int {
		if (p == null || !Strings.equal(p.fileName, file.fileName)) return -1;
		return offsetOf(p.beginLine, p.beginColumn);
	}
	private def rangeEnd(r: FileRange) -> int {
		if (r == null || !Strings.equal(r.fileName, file.fileName)) return -1;
		return offsetOf(r.endLine, r.endColumn);
	}
	// The byte offset of live parser coordinates, which ranges hold; the
	// replay map locates them, as OccurrenceCollector.offset does.
	private def offsetOf(line: int, column: int) -> int {
		if (coordinates == null) coordinates = sources.map(file.fileName);
		return if(coordinates != null, coordinates.offset(line, column, false), -1);
	}
}
