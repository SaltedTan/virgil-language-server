// The compiler adapter boundary (see docs/decisions/0002-pinned-virgil-adapter-boundary.md).
// This directory is the only place allowed to reference Aeneas internals such as
// {Parser}, {VstFile}, {ErrorGen}, or {Compilation}. Everything it returns is
// expressed in server-owned types so that compiler changes stay contained here.

// A compiler diagnostic. One-based compiler coordinates remain available for
// CLI reports. Single-file and whole-program diagnostics also supply exact
// UTF-8 byte offsets; -1 means unavailable (no captured source). LSP consumers
// use offsets, since compiler columns have comment-dependent rules. {path}
// is null for diagnostics that are not attached to a source file.
class AnalysisDiagnostic(path: string, beginLine: int, beginColumn: int,
		endLine: int, endColumn: int, kind: string, message: string) {
	var beginOffset: int = -1;
	var endOffset: int = -1;

	def toString() -> string {
		var buf = StringBuilder.new();
		buf.put3("%s:%d:%d: ", if(path == null, "<program>", path), beginLine, beginColumn);
		if (kind != null) buf.puts(kind).puts(": ");
		buf.puts(Strings.nonnull(message));
		return buf.toString();
	}
}

// The result of parsing a single file.
class FileParseResult(path: string, diagnostics: Array<AnalysisDiagnostic>, declarationCount: int) { }

// One source file of a program, supplied as in-memory bytes. Whole-program
// analysis never reads its inputs from disk.
class AnalysisSource(path: string, input: Array<byte>) { }

// A source range in compiler coordinates (see {AnalysisDiagnostic}). The end
// column is exclusive.
class AnalysisRange(path: string, beginLine: int, beginColumn: int, endLine: int, endColumn: int) {
	def contains(line: int, column: int) -> bool {
		if (line < beginLine || line > endLine) return false;
		if (line == beginLine && column < beginColumn) return false;
		if (line == endLine && column >= endColumn) return false;
		return true;
	}
	def render(buf: StringBuilder) -> StringBuilder {
		buf.put3("%s:%d:%d", path, beginLine, beginColumn);
		return buf.put2("-%d:%d", endLine, endColumn);
	}
}

// The kinds of declaration a use can resolve to.
enum AnalysisDeclKind {
	LOCAL, PARAMETER, FIELD, METHOD, CONSTRUCTOR, CLASS, COMPONENT, ENUM,
	ENUM_CASE, VARIANT_CASE, LAYOUT, LAYOUT_FIELD
}

// A declaration in the program. {range} covers the declaration's name token;
// the syntax tree does not record where a whole declaration ends.
class AnalysisDeclaration(kind: AnalysisDeclKind, name: string, range: AnalysisRange) {
	def render(buf: StringBuilder) -> StringBuilder {
		buf.puts(kind.name).putc(' ').puts(name).puts(" @ ");
		return range.render(buf);
	}
}

// A use of a name that verification resolved to a declaration in the program.
// {range} covers the identifier at the use site.
class AnalysisOccurrence(range: AnalysisRange, declaration: AnalysisDeclaration) {
	def toString() -> string {
		var buf = StringBuilder.new();
		range.render(buf).puts(" -> ");
		return declaration.render(buf).toString();
	}
}

// Measurements of one whole-program analysis. {globalTypesAdded} counts retained
// global types after cleanup, or is -1 when statistics were not requested.
class AnalysisStats(parseUs: int, verifyUs: int, uidsUsed: int, globalTypesAdded: int) { }

// The result of parsing and verifying a whole program. It keeps the syntax
// tree for binding queries; see docs/architecture.md#compiler-adapter.
class ProgramAnalysis {
	def diagnostics: Array<AnalysisDiagnostic>;
	def stats: AnalysisStats;
	def parsed: bool;	// parsing reported no errors, so verification ran
	def verified: bool;	// parsing and verification both reported no errors
	private def files = Strings.newMap<AnalysisFileIndex>();

	new(diagnostics, stats, parsed, verified, prog: Program) {
		if (parsed) {
			for (f in prog.vst.files) {
				// Preserve the first file's bindings if an input path is repeated.
				if (f != null && !files.has(f.fileName)) files[f.fileName] = AnalysisFileIndex.new(f);
			}
		}
	}

	// Source-declaration uses in {path}; see docs/architecture.md#compiler-adapter.
	// Callers must not modify the cached array shared with definition queries.
	def occurrences(path: string) -> Array<AnalysisOccurrence> {
		var file = files[path];
		if (file == null) return [];
		return file.occurrences();
	}
	// The declaration that the identifier at compiler coordinates
	// ({line}, {column}) in {path} resolves to, or null if there is none.
	def definitionAt(path: string, line: int, column: int) -> AnalysisDeclaration {
		var uses = occurrences(path), low = 0, high = uses.length;
		// Identifier tokens do not overlap, so their exclusive ends are also
		// in source order. Find the first token ending after the query point.
		while (low < high) {
			var mid = low + (high - low) / 2, r = uses[mid].range;
			if (r.endLine < line || (r.endLine == line && r.endColumn <= column)) low = mid + 1;
			else high = mid;
		}
		if (low < uses.length && uses[low].range.contains(line, column)) return uses[low].declaration;
		return null;
	}
}

// Snapshot-local lazy index: no walk for diagnostics-only analyses, and no
// repeated walk, allocation, or sort for subsequent binding queries.
class AnalysisFileIndex(file: VstFile) {
	private var uses: Array<AnalysisOccurrence>;

	def occurrences() -> Array<AnalysisOccurrence> {
		if (uses == null) uses = OccurrenceCollector.new().collect(file);
		return uses;
	}
}

component AeneasAdapter {
	def MAX_ERRORS = 100;
	// Program.ERROR's limit, which the adapter cannot replace. Once a program
	// has this many errors, parsing stops recording them and verification
	// stops at the next declaration.
	// AeneasAdapter:program_error_limit checks it against the pinned compiler.
	def PROGRAM_MAX_ERRORS = 15;
	// Parse/verify do not mutate compiler configuration. Each analysis still
	// owns a fresh Program and Compilation; only this default configuration
	// is reused. Language options live in CLOptions instead; see
	// setLanguageOptions.
	private def compiler = Compiler.new(null);

	// Parse one file in isolation with language options {options} (see
	// setLanguageOptions). Does not verify, initialize, or generate code.
	def parseFile(path: string, input: Array<byte>, options: Array<string>) -> FileParseResult {
		var errors = AnalysisParseErrors.new(MAX_ERRORS);
		setLanguageOptions(options);
		var file = AnalysisSingleFileParser.parse(path, input, errors, null, TypeCache.new(), null);
		resetLanguageOptions();
		var decls = file.classes.length + file.components.length + file.enums.length
			+ file.layouts.length + file.packings.length;
		var diagnostics = convertErrors(path, errors);
		for (i < diagnostics.length) {
			diagnostics[i].beginOffset = errors.offsets[i].0;
			diagnostics[i].endOffset = errors.offsets[i].1;
		}
		return FileParseResult.new(path, diagnostics, decls);
	}
	// Parse current document bytes without verification, through the same
	// driver and recovery as {parseFile}. A failed parse yields no symbols:
	// the compiler stops early and its partial VST is not an outline.
	def documentSymbols(path: string, input: Array<byte>, options: Array<string>) -> Array<AnalysisDocumentSymbol> {
		// LSP accepts CRLF and bare CR. Preserve byte offsets while presenting
		// line terminators the compiler understands; never mutate the overlay.
		var normalized = Array<byte>.new(input.length);
		for (i < input.length) normalized[i] = if(input[i] == '\r',
			if(i + 1 < input.length && input[i + 1] == '\n', ' ', '\n'), input[i]);
		var errors = AnalysisParseErrors.new(MAX_ERRORS), syntax = SymbolSyntaxIndex.new();
		setLanguageOptions(options);
		var file = AnalysisSingleFileParser.parse(path, normalized, errors, syntax, TypeCache.new(), null);
		resetLanguageOptions();
		if (errors.numErrors > 0) return [];
		return DocumentSymbolCollector.new(file, syntax).collect();
	}
	// The pinned compiler's language options, without their "lang:" prefix,
	// and their defaults, in declaration order. The project file accepts
	// these flags ({ProjectCompilerFlags}).
	def languageOptions() -> Array<(string, bool)> {
		var options = Vector<(string, bool)>.new();
		for (l = Lists.reverse(CLOptions.langOpt.list); l != null; l = l.tail) {
			var opt = l.head.0, name = opt.name;
			if (Strings.startsWith(name, "lang:")) name = Arrays.range(name, 5, name.length);
			// Every language option is boolean; another kind reports false.
			options.put((name, Option<bool>.?(opt) && Option<bool>.!(opt).init));
		}
		return options.extract();
	}
	// Sets Aeneas's process-wide language options to their defaults, then
	// applies {args} in order, as v3c does. Each is a flag that
	// {ProjectCompilerFlags} accepts: -lang:<name>, -lang:<name>=true, or
	// -lang:<name>=false. Setting -lang:fun-exprs also sets
	// -lang:simple-bodies, through the option's own handler.
	def setLanguageOptions(args: Array<string>) {
		resetLanguageOptions();
		for (arg in args) {
			var t = CLOptions.options.parseOption(arg), name = t.0;
			for (l = CLOptions.langOpt.list; l != null; l = l.tail) {
				if (Strings.equal(l.head.0.name, name)) l.head.0.parse(t.1);
			}
		}
	}
	// Restores every language option's default. Each parse and analysis
	// restores them when it ends, so that no project's options outlive it.
	def resetLanguageOptions() {
		for (l = CLOptions.langOpt.list; l != null; l = l.tail) {
			var opt = l.head.0;
			if (Option<bool>.?(opt)) Option<bool>.!(opt).val = Option<bool>.!(opt).init;
		}
	}
	// Parse and verify a whole program from in-memory sources, in the given
	// order, with language options {options} (see setLanguageOptions).
	// Builds a fresh {Program} each time and runs only the shared parser and,
	// if parsing succeeded, {Compilation.verify()}.
	// Never initializes, runs reachability, or generates code.
	// {collectStats} enables the expensive process-wide type-cache counts.
	def analyzeProgram(sources: Array<AnalysisSource>, options: Array<string>, collectStats: bool) -> ProgramAnalysis {
		AnalysisTypeCache.prepare();
		setLanguageOptions(options);
		var uidBefore = UID.next, globalBefore = if(collectStats, globalTypeCount(), 0);
		var prog = Program.new();
		// Without a target, Aeneas provides a synthetic System component, as
		// it does for the interpreter (see Aeneas.makeProgram).
		SystemCalls.install(prog);
		prog.files = Array<string>.new(sources.length);
		prog.inputs = Array<Array<byte>>.new(sources.length);
		for (i < sources.length) {
			prog.files[i] = sources[i].path;
			// Treat a missing capture as empty source to keep analysis independent of disk.
			var input = sources[i].input;
			prog.inputs[i] = if(input == null, Array<byte>.new(0), input);
		}
		var compilation = Compilation.new(compiler, prog);
		var t0 = System.ticksUs();
		var coordinates = AnalysisSourceCoordinates.new(sources);
		var parseErrors = parseProgram(prog, coordinates);
		var parsed = prog.ERROR.noErrors;
		var t1 = System.ticksUs();
		// Compilation.compile() skips verification after a parse error, and so
		// does the adapter: the parser stops at the first error in a file, and
		// verifying the truncated tree would report spurious errors.
		var verified = parsed && compilation.verify();
		var t2 = System.ticksUs();
		resetLanguageOptions();
		// Drop process-wide roots even when parsing or verification failed.
		// The result still owns its VST; dropping that result makes it collectible.
		AnalysisTypeCache.release();
		var diagnostics = convertErrors(null, prog.ERROR);
		for (i < diagnostics.length) {
			var d = diagnostics[i];
			if (!parsed && i < parseErrors.offsets.length) {
				d.beginOffset = parseErrors.offsets[i].0;
				d.endOffset = parseErrors.offsets[i].1;
			}
			diagnostics[i] = coordinates.diagnostic(d);
		}
		var stats = AnalysisStats.new(t1 - t0, t2 - t1, UID.next - uidBefore,
			if(collectStats, globalTypeCount() - globalBefore, -1));
		return ProgramAnalysis.new(diagnostics, stats, parsed, verified, prog);
	}
	private def parseProgram(prog: Program, coordinates: AnalysisSourceCoordinates) -> AnalysisParseErrors {
		var errors = AnalysisParseErrors.new(prog.ERROR.maxErrors);
		prog.vst = VstModule.new();
		var files = Vector<VstFile>.new().grow(prog.files.length);
		for (i = 0; i < prog.files.length && errors.notTooMany; i++) {
			files.put(AnalysisSingleFileParser.parse(prog.files[i], prog.inputs[i], errors, null,
				prog.typeCache, coordinates.capture(prog.files[i])));
		}
		prog.vst.files = files.extract();
		prog.ERROR.copy(errors);
		if (CLOptions.REDEF_FIELD.val != null) {
			var input = StringBuilder.new().puts("-").puts(CLOptions.REDEF_FIELD.name).puts("=");
			var skip = input.length;
			input.puts(CLOptions.REDEF_FIELD.val);
			var redefs = Parser.parseRedefFields("<options>", input.toString(), skip, prog.ERROR);
			prog.vst.redefFile = redefs.0;
			prog.vst.fieldRedefs = redefs.1;
		}
		return errors;
	}
	// The next value of Aeneas's process-wide UID counter. It never resets, so
	// it measures how many IDs analyses have consumed.
	def uidCounter() -> int {
		return UID.next;
	}
	// The number of types interned in Aeneas's process-wide type cache.
	def globalTypeCount() -> int {
		var cache = TypeUtil.globalCache;
		return countChains(cache.singleBuckets) + countChains(cache.multiBuckets);
	}
	private def countChains(buckets: Array<Type>) -> int {
		var count = 0;
		for (b in buckets) {
			for (t = b; t != null; t = t.link) count++;
		}
		return count;
	}
	private def convertErrors(path: string, errors: ErrorGen) -> Array<AnalysisDiagnostic> {
		var result = Vector<AnalysisDiagnostic>.new();
		for (l = Lists.reverse(errors.errors); l != null; l = l.tail) {
			var e = l.head, r = e.range;
			var d = if(r == null,
				AnalysisDiagnostic.new(path, 0, 0, 0, 0, e.error, e.description),
				AnalysisDiagnostic.new(Strings.nonnull(r.fileName), r.beginLine, r.beginColumn,
					r.endLine, r.endColumn, e.error, e.description));
			result.put(d);
		}
		return result.extract();
	}
}
