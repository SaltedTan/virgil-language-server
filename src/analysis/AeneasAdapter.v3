// The compiler adapter boundary (see docs/decisions/0002-pinned-virgil-adapter-boundary.md).
// This directory is the only place allowed to reference Aeneas internals such as
// {Parser}, {VstFile}, {ErrorGen}, or {Compilation}. Everything it returns is
// expressed in server-owned types so that compiler changes stay contained here.

// A compiler diagnostic. One-based compiler coordinates remain available for
// CLI reports. Single-file and whole-program diagnostics also supply exact
// UTF-8 byte offsets; -1 means unavailable (no captured source). LSP consumers
// use offsets, since compiler columns have comment-dependent rules. {path}
// is null for diagnostics that are not attached to a source file.
class AnalysisDiagnostic(path: string, beginLine: int, beginColumn: int,
		endLine: int, endColumn: int, kind: string, message: string) {
	var beginOffset: int = -1;
	var endOffset: int = -1;
	// How many more of its path's diagnostics follow this one and were not
	// reported, or 0; see AeneasAdapter.MAX_FILE_DIAGNOSTICS.
	var omitted: int;

	def toString() -> string {
		var buf = StringBuilder.new();
		buf.put3("%s:%d:%d: ", if(path == null, "<program>", path), beginLine, beginColumn);
		if (kind != null) buf.puts(kind).puts(": ");
		buf.puts(Strings.nonnull(message));
		return buf.toString();
	}
}

// The result of parsing a single file.
class FileParseResult(path: string, diagnostics: Array<AnalysisDiagnostic>, declarationCount: int) {
	// The end of the token before the first error, or -1 if the file parsed
	// (AnalysisParseErrors.firstTokenEnd).
	var repairAt = -1;
	// The start of the statement that a ";" at {repairAt} would end, as
	// AnalysisStatementStart finds it for AeneasAdapter.parseStatement, or -1.
	var statementStart = -1;
	// Where a ";" could also end that statement, earlier on the same line
	// (AnalysisStatementStart.alternative), or -1.
	var alternativeAt = -1;

	// Where the first error begins, or -1 if the file parsed.
	def errorAt() -> int {
		return if(diagnostics.length > 0, diagnostics[0].beginOffset, -1);
	}
}

// One source file of a program, supplied as in-memory bytes. Whole-program
// analysis never reads its inputs from disk.
class AnalysisSource(path: string, input: Array<byte>) { }

// A source range in compiler coordinates (see {AnalysisDiagnostic}), with its
// exact UTF-8 byte offsets in the file at {path}. The end column and end
// offset are exclusive. Offsets are -1 when the file has no captured source.
class AnalysisRange(path: string, beginLine: int, beginColumn: int, endLine: int, endColumn: int,
		beginOffset: int, endOffset: int) {
	// True if the range is on one line and its compiler and byte spans have
	// the same length, as a token that the source spells has. Every occurrence
	// must be, since snapshots store it as a begin and a length
	// (see AnalysisSnapshotFile).
	def isTokenSpan() -> bool {
		return beginLine == endLine && beginOffset >= 0
			&& endOffset - beginOffset == endColumn - beginColumn;
	}
	def contains(line: int, column: int) -> bool {
		if (line < beginLine || line > endLine) return false;
		if (line == beginLine && column < beginColumn) return false;
		if (line == endLine && column >= endColumn) return false;
		return true;
	}
	def render(buf: StringBuilder) -> StringBuilder {
		buf.put3("%s:%d:%d", path, beginLine, beginColumn);
		return buf.put2("-%d:%d", endLine, endColumn);
	}
}

// The kinds of declaration a use can resolve to.
// A kind's tag is its wire value; new kinds go last.
enum AnalysisDeclKind {
	LOCAL, PARAMETER, FIELD, METHOD, CONSTRUCTOR, CLASS, COMPONENT, ENUM,
	ENUM_CASE, VARIANT_CASE, LAYOUT, LAYOUT_FIELD, TYPE_PARAM, PACKING
}

// A declaration in the program. Compiler coordinates cover its name token;
// byte offsets select its source spelling (see AnalysisSourceMaps.range).
// The syntax tree does not record where a whole declaration ends.
// {signature} is its display text, such as "def f(x: int) -> int"; see
// docs/architecture.md#display-text.
class AnalysisDeclaration(kind: AnalysisDeclKind, name: string, range: AnalysisRange) {
	var signature: string;
	// Snapshot storage default: resolved type declaration ID plus one, or
	// zero. Occurrence-specific overrides live beside the file index. The
	// existing 128-byte declaration/range budget includes this integer.
	// On worker declarations it instead identifies this declaration in the
	// display table, before encoding translates the collector's codes.
	var typeTarget: int;
	// Worker-only resolved type code at the declaration site. The display
	// assigns codes; snapshots retain only the default above.
	var sourceType = -1;
	// The compiler's flag for this kind of declaration, which semantic tokens
	// classify by (docs/architecture.md#semantic-tokens): for a local,
	// parameter, or field, that nothing may assign it, as with `def`; for a
	// class, that it is a variant, declared with `type`; for a method, that a
	// component declares it, as a file's own component declares its
	// top-level functions. Always false for other kinds. A flagged
	// declaration's type, a subclass with no fields, carries it.
	def flagged() -> bool { return false; }
	def render(buf: StringBuilder) -> StringBuilder {
		buf.puts(kind.name).putc(' ').puts(name).puts(" @ ");
		return range.render(buf);
	}
}

// A snapshot's declaration with the flag set. The object's type tag carries
// the flag, so it has the same fields and allocation size as any other.
class AnalysisFlaggedDeclaration extends AnalysisDeclaration {
	new(kind: AnalysisDeclKind, name: string, range: AnalysisRange) super(kind, name, range) { }
	def flagged() -> bool { return true; }
}

// A source use that verification resolved to a declaration in the program.
// {range} is a token span; see docs/architecture.md#compiler-adapter.
// {useType} is the text of the use's type where it differs from the
// declaration's, as at a generic call, or null.
class AnalysisOccurrence(range: AnalysisRange, declaration: AnalysisDeclaration) {
	// The object's existing type tag carries the assignment flag without
	// growing the transient occurrence object. Snapshots pack it in an int.
	def isWrite() -> bool { return AnalysisWriteOccurrence.?(this); }
	var useType: string;
	// Worker display declaration ID plus one; zero means no source type.
	var sourceType: int;
	def toString() -> string {
		var buf = StringBuilder.new();
		range.render(buf).puts(" -> ");
		return declaration.render(buf).toString();
	}
}

// A write has the same fields and allocation size as an ordinary occurrence.
class AnalysisWriteOccurrence extends AnalysisOccurrence {
	new(range: AnalysisRange, declaration: AnalysisDeclaration) super(range, declaration) { }
}

// A use that verification resolved to something with a type but no source
// declaration, such as ".length" or "int.max", and the text of that type.
// {range} is a token span. It is not an occurrence: it has no definition.
class AnalysisBuiltinUse(range: AnalysisRange, useType: string) {
	var sourceType: int;
	def toString() -> string {
		var buf = StringBuilder.new();
		return range.render(buf).puts(": ").puts(useType).toString();
	}
}

// The parameters of a function as a call was checked against them, for
// signature help; see docs/architecture.md#call-sites. {label} is display
// text such as "def get(i: int) -> T" or "(int, int) -> bool", in which the
// first parameter starts at byte {start}. {params} are the parameter labels,
// such as "i: int", or only a type where a parameter has no name. The label
// lists them in order, separated by ", ", so parameter i starts at
// {paramOffset(i)}, unless the label was cut short before it. A decoded
// signature's parameters, so laid out, end within int.max.
class AnalysisSignature(label: string, start: int, params: Array<string>) {
	// The byte in {label} where parameter {i} starts, or -1 if that is past
	// the label's end, so that the label was cut short before it.
	def paramOffset(i: int) -> int {
		var offset = long.view(start);
		for (j < i) {
			if (offset > label.length) return -1;
			offset += params[j].length + 2;
		}
		return if(offset <= label.length, int.view(offset), -1);
	}
	// Whether {label} holds all of parameter {i}, at {paramOffset(i)}.
	def holds(i: int) -> bool {
		var offset = paramOffset(i), p = params[i];
		if (offset < 0 || p.length > label.length - offset) return false;
		for (k < p.length) if (label[offset + k] != p[k]) return false;
		return true;
	}
}

// A call in the source, as verification checked it. Offsets are UTF-8 byte
// offsets in its file. {open} is its opening parenthesis and {close} the
// byte just past its closing one. {args} holds each argument's begin and
// exclusive end offsets, two ints per argument, in order. {callee} is the
// offset of the callee's name, as in "f" in "a.f<int>(x)", where the name is
// an occurrence or a builtin use, or -1; {target} is that occurrence's
// declaration, or null. {signature} is null if the callee's type is not a
// known function type.
class AnalysisCall(open: int, close: int, args: Array<int>, callee: int, target: AnalysisDeclaration,
		signature: AnalysisSignature) {
	def argCount() -> int {
		return args.length / 2;
	}
}

// Measurements of one whole-program analysis. {globalTypesAdded} counts retained
// global types after cleanup, or is -1 when statistics were not requested.
class AnalysisStats(parseUs: int, verifyUs: int, uidsUsed: int, globalTypesAdded: int) { }

// The result of parsing and verifying a whole program. It keeps the syntax
// tree for binding queries; see docs/architecture.md#compiler-adapter.
class ProgramAnalysis {
	def diagnostics: Array<AnalysisDiagnostic>;
	def stats: AnalysisStats;
	def parsed: bool;	// parsing reported no errors, so verification ran
	def verified: bool;	// parsing and verification both reported no errors
	// By path, in an ordered map; see OrderedStringMap.
	private def files = OrderedStringMap<AnalysisFileIndex>.new();
	// Every file's source, for the byte offsets of uses and of their
	// declarations, which can be in other files.
	private def sources = AnalysisSourceMaps.new();
	// Signatures and types, rendered once for all files.
	private def display = AnalysisDisplay.new(sources);
	// The program's packings, for their uses; null if it was not verified.
	private var packings: AnalysisPackings;
	// For each file's collector in turn.
	private def callEnds = AnalysisCallEnds.new();
	private def buffers = AnalysisCollectorBuffers.new();
	// The names that the program's files declare, for each file's collector.
	private var names: AnalysisDeclaredNames;

	new(diagnostics, stats, parsed, verified, prog: Program) {
		if (parsed) {
			packings = AnalysisPackings.new(prog);
			names = AnalysisDeclaredNames.new(prog.vst.files);
			for (i < prog.files.length) sources.add(prog.files[i], prog.inputs[i]);
			for (f in prog.vst.files) {
				// Preserve the first file's bindings if an input path is repeated.
				if (f != null && !files.has(f.fileName)) files[f.fileName] = AnalysisFileIndex.new(f, sources, display, packings, callEnds, names, buffers);
			}
		}
	}

	// Source-declaration uses in {path}; see docs/architecture.md#compiler-adapter.
	// Callers must not modify the cached array shared with definition queries.
	def occurrences(path: string) -> Array<AnalysisOccurrence> {
		var file = files[path];
		if (file == null) return [];
		return file.occurrences();
	}
	// The uses in {path} that resolved to no source declaration but have a
	// type, in source order. Collects the file if needed.
	def builtinUses(path: string) -> Array<AnalysisBuiltinUse> {
		var file = files[path];
		if (file == null) return [];
		file.occurrences();
		return file.builtins;
	}
	// The declarations named in {path}, including those that nothing uses,
	// in source order; their ranges do not overlap. Collects the file if
	// needed. See docs/architecture.md#display-text.
	def declarationSites(path: string) -> Array<AnalysisDeclaration> {
		var file = files[path];
		if (file == null) return [];
		file.occurrences();
		return file.sites;
	}
	def hintStringCount() -> int { return display.hintStringCount(); }
	def hintString(i: int) -> string { return display.hintString(i); }
	// The parents of the declarations named in {path}: for each that has
	// one, its index in {declarationSites} and its parent's code, which
	// {typeDeclaration} resolves, in the order of the sites. A class's or a
	// variant case's parent is its base, and a method's the method it
	// overrides; see docs/architecture.md#implementation. Collects the file
	// if needed.
	def parentLinks(path: string) -> Array<int> {
		var file = files[path];
		if (file == null) return [];
		file.occurrences();
		return file.parents;
	}
	// Resolves a collector's source-type code, shared with declaration sites,
	// occurrences, and builtin uses. Inlay hints can reuse it with display data.
	def typeDeclarationCount() -> int { return display.declarationCount(); }
	def typeDeclaration(code: int) -> AnalysisDeclaration {
		return if(code > 0, display.declarationAt(code - 1));
	}
	def sourceTargetCount() -> int { return display.sourceTargetCount(); }
	def sourceTargetAt(index: int) -> AnalysisDeclaration { return display.sourceTargetAt(index); }
	// The calls in {path}, in the order of their opening parentheses; see
	// docs/architecture.md#call-sites. Collects the file if needed. Each call
	// returns new objects; the encoder reads {callRecords} instead.
	def calls(path: string) -> Array<AnalysisCall> {
		var file = files[path];
		if (file == null) return [];
		var uses = file.occurrences(), c = AnalysisCallCursor.new(DataReader.new(file.calls), file.callCount);
		var result = Array<AnalysisCall>.new(file.callCount);
		c.absolute = true;
		for (i = 0; c.next(); i++) {
			var args = Array<int>.new(2 * c.argCount);
			for (k < c.argCount) {
				c.nextArg();
				args[2 * k] = c.argBegin;
				args[2 * k + 1] = c.argEnd;
			}
			c.finish();
			var callee = if(c.calleeDelta > 0, c.open - c.calleeDelta, -1);
			result[i] = AnalysisCall.new(c.open, c.close, args, callee, declarationAt(uses, callee),
				if(c.signature > 0, display.callSignatureAt(c.signature - 1)));
		}
		return result;
	}
	// The records of the calls in {path} and their count; see
	// OccurrenceCollector.calls. Collects the file if needed.
	def callRecords(path: string) -> (Range<byte>, int) {
		var file = files[path];
		if (file == null) return (Array<byte>.new(0), 0);
		file.occurrences();
		return (file.calls, file.callCount);
	}
	// The call signature that a call record names with {i} plus one.
	def callSignature(i: int) -> AnalysisSignature {
		return display.callSignatureAt(i);
	}
	def callSignatureCount() -> int {
		return display.callSignatureCount();
	}
	// The uses in {path} that {occurrences} skipped because they are not
	// token spans (see AnalysisRange.isTokenSpan), and the calls that {calls}
	// skipped because their spans do not locate their parentheses and
	// arguments. Collects the file if needed.
	def skippedUses(path: string) -> int {
		var file = files[path];
		if (file == null) return 0;
		file.occurrences();
		return file.skipped;
	}
	// The expressions that collecting {path} read to locate its calls'
	// parentheses and arguments (see OccurrenceCollector.endOf), for tests.
	// Collects the file if needed.
	def locatedExprs(path: string) -> int {
		var file = files[path];
		if (file == null) return 0;
		file.occurrences();
		return file.located;
	}
	// The declarations of {kinds} (AnalysisScopeKinds) visible at byte
	// {offset} of {path}, or null if the program did not parse or has no such
	// file, if verification did not reach the offset, or if this analysis
	// keeps no program: only an AnalysisScopedProgram does. See
	// AnalysisScopeFinder and docs/architecture.md#completion.
	def scopeAt(path: string, offset: int, kinds: int, prefix: string) -> AnalysisScopeAnswer {
		return null;
	}
	private def scopeIn(program: Program, syntax: SymbolSyntaxIndex, path: string, offset: int, kinds: int, prefix: string) -> AnalysisScopeAnswer {
		if (program == null) return null;
		for (f in program.vst.files) {
			if (f == null || !Strings.equal(f.fileName, path)) continue;
			var answer = AnalysisScopeFinder.new(sources, display, program, f, syntax).find(offset, kinds, prefix);
			if (answer != null) answer.paths = program.files;
			return answer;
		}
		return null;
	}
	// The members of the receiver of the member expression whose "." comes
	// before byte {offset} of {path}, or null where scopeAt is, or where no
	// member expression is there. See AnalysisScopeFinder.findMembers and
	// docs/architecture.md#member-completion.
	def membersAt(path: string, offset: int, prefix: string) -> AnalysisMemberAnswer {
		return null;
	}
	private def membersIn(program: Program, syntax: SymbolSyntaxIndex, path: string, offset: int, prefix: string) -> AnalysisMemberAnswer {
		if (program == null) return null;
		for (f in program.vst.files) {
			if (f == null || !Strings.equal(f.fileName, path)) continue;
			var answer = AnalysisScopeFinder.new(sources, display, program, f, syntax).findMembers(offset, prefix);
			if (answer != null) answer.paths = program.files;
			return answer;
		}
		return null;
	}
	// The call whose argument list opens at byte {offset} of {path}, its "(",
	// as the collector records it, or null where scopeAt is, or where no call
	// opens there. See AnalysisScopeFinder.findCall and
	// docs/architecture.md#signature-help.
	def callAt(path: string, offset: int) -> AnalysisCallAnswer {
		return null;
	}
	private def callIn(program: Program, syntax: SymbolSyntaxIndex, path: string, offset: int) -> AnalysisCallAnswer {
		if (program == null) return null;
		for (f in program.vst.files) {
			if (f == null || !Strings.equal(f.fileName, path)) continue;
			var collector = OccurrenceCollector.new(sources, display, packings, AnalysisCallEnds.new(), names,
				AnalysisCollectorBuffers.new());
			var answer = AnalysisScopeFinder.new(sources, display, program, f, syntax).findCall(offset, collector);
			if (answer != null) answer.paths = program.files;
			return answer;
		}
		return null;
	}
	// The declaration of the occurrence in {uses} that starts at {offset}, or null.
	private def declarationAt(uses: Array<AnalysisOccurrence>, offset: int) -> AnalysisDeclaration {
		var low = 0, high = uses.length;
		while (low < high) {
			var mid = low + (high - low) / 2;
			if (uses[mid].range.beginOffset < offset) low = mid + 1;
			else high = mid;
		}
		return if(low < uses.length && uses[low].range.beginOffset == offset, uses[low].declaration);
	}
	// The declaration that the indexed use at compiler coordinates
	// ({line}, {column}) in {path} resolves to, or null if there is none.
	// See AnalysisSnapshotFile.find for its one ordering exception.
	def definitionAt(path: string, line: int, column: int) -> AnalysisDeclaration {
		var uses = occurrences(path), low = 0, high = uses.length;
		// Occurrence tokens do not overlap, so their exclusive ends are also
		// in source order. Find the first token ending after the query point.
		while (low < high) {
			var mid = low + (high - low) / 2, r = uses[mid].range;
			if (r.endLine < line || (r.endLine == line && r.endColumn <= column)) low = mid + 1;
			else high = mid;
		}
		if (low < uses.length && uses[low].range.contains(line, column)) return uses[low].declaration;
		return null;
	}
}

// A ProgramAnalysis that answers scope queries: it keeps the parsed program,
// which an ordinary analysis does not, so that one carries nothing for them.
// Only an analysis with a scope, member, or call query is one
// (AeneasAdapter.analyzeForScope).
class AnalysisScopedProgram extends ProgramAnalysis {
	private def syntax: OrderedStringMap<SymbolSyntaxIndex>;
	// Null if the program did not parse.
	private var program: Program;

	new(d: Array<AnalysisDiagnostic>, s: AnalysisStats, p: bool, v: bool, prog: Program, syntax) super(d, s, p, v, prog) {
		if (p) program = prog;
	}
	def scopeAt(path: string, offset: int, kinds: int, prefix: string) -> AnalysisScopeAnswer {
		return scopeIn(program, syntax[path], path, offset, kinds, prefix);
	}
	def membersAt(path: string, offset: int, prefix: string) -> AnalysisMemberAnswer {
		return membersIn(program, syntax[path], path, offset, prefix);
	}
	def callAt(path: string, offset: int) -> AnalysisCallAnswer {
		return callIn(program, syntax[path], path, offset);
	}
}

// Snapshot-local lazy index: no walk for diagnostics-only analyses, and no
// repeated walk, allocation, or sort for subsequent binding queries.
class AnalysisFileIndex(file: VstFile, sources: AnalysisSourceMaps, display: AnalysisDisplay, packings: AnalysisPackings,
		callEnds: AnalysisCallEnds, names: AnalysisDeclaredNames, buffers: AnalysisCollectorBuffers) {
	private var uses: Array<AnalysisOccurrence>;
	def var skipped: int;
	def var located: int;
	def var builtins: Array<AnalysisBuiltinUse>;
	def var sites: Array<AnalysisDeclaration>;
	def var parents: Array<int>;
	def var calls: Range<byte>;
	def var callCount: int;

	def occurrences() -> Array<AnalysisOccurrence> {
		if (uses == null) {
			var collector = OccurrenceCollector.new(sources, display, packings, callEnds, names, buffers);
			uses = collector.collect(file);
			skipped = collector.skipped;
			located = collector.located;
			builtins = collector.builtins;
			sites = collector.sites;
			parents = collector.parents;
			calls = collector.calls;
			callCount = collector.callCount;
		}
		return uses;
	}
}

// Keyword forms that a language option enables in the parser
// (AeneasAdapter.keywordForms), as flags.
component AnalysisKeywordForms {
	def FUN_EXPRS = 1;	// fun expressions (-lang:fun-exprs)
	def DESCRIPTORS = 2;	// descriptor and describes clauses (-lang:descriptors)
	def OPEN_TYPES = 4;	// a variant that extends another (-lang:open-types)
}

component AeneasAdapter {
	def MAX_ERRORS = 100;
	// Program.ERROR's limit, which the adapter cannot replace. Once a program
	// has this many errors, parsing stops recording them and verification
	// stops at the next declaration.
	// AeneasAdapter:program_error_limit checks it against the pinned compiler.
	def PROGRAM_MAX_ERRORS = 15;
	// The most whole-program diagnostics reported for one path. Program.ERROR
	// stops checking only between declarations, so one long expression, such
	// as a chain of 8,000 unresolved operators, reports an error for each
	// operator. Each reported diagnostic is charged about 6.5 KB against the
	// result's allocation budget (see AnalysisWire.decodeResult), so 100 take
	// about 4% of it and fit beside the largest program measured (the Aeneas
	// sources, 78%); the single-file parser stops at the same count
	// (MAX_ERRORS). See docs/architecture.md#semantic-diagnostics.
	def MAX_FILE_DIAGNOSTICS = 100;
	// Parse/verify do not mutate compiler configuration. Each analysis still
	// owns a fresh Program and Compilation; only this default configuration
	// is reused. Language options live in CLOptions instead; see
	// setLanguageOptions.
	private def compiler = Compiler.new(null);

	// Parse one file in isolation with language options {options} (see
	// setLanguageOptions). Does not verify, initialize, or generate code.
	def parseFile(path: string, input: Array<byte>, options: Array<string>) -> FileParseResult {
		return parseWith(path, input, options, null);
	}
	// {parseFile}, also setting FileParseResult.statementStart and alternativeAt
	// from the tokens that the parser consumed (AnalysisStatementStart), with
	// no extra parse.
	def parseStatement(path: string, input: Array<byte>, options: Array<string>) -> FileParseResult {
		var syntax = SymbolSyntaxIndex.new();
		var result = parseWith(path, input, options, syntax);
		if (result.repairAt >= 0 && result.diagnostics.length > 0) {
			var walk = AnalysisStatementStart.new(input, syntax.tokens);
			result.statementStart = walk.find(result.repairAt, result.diagnostics[0].beginOffset);
			result.alternativeAt = walk.alternative;
		}
		return result;
	}
	private def parseWith(path: string, input: Array<byte>, options: Array<string>, syntax: SymbolSyntaxIndex) -> FileParseResult {
		var errors = AnalysisParseErrors.new(MAX_ERRORS);
		setLanguageOptions(options);
		var file = AnalysisSingleFileParser.parse(path, input, errors, syntax, TypeCache.new(), null);
		resetLanguageOptions();
		var decls = file.classes.length + file.components.length + file.enums.length
			+ file.layouts.length + file.packings.length;
		var diagnostics = convertErrors(path, errors);
		for (i < diagnostics.length) {
			diagnostics[i].beginOffset = errors.offsets[i].0;
			diagnostics[i].endOffset = errors.offsets[i].1;
		}
		var result = FileParseResult.new(path, diagnostics, decls);
		if (errors.numErrors > 0) result.repairAt = errors.firstTokenEnd;
		return result;
	}
	// Parse block-bodied method/constructor ranges for last-parseable text.
	// Null means the text did not parse with these language options.
	def methodBodies(path: string, input: Array<byte>, options: Array<string>) -> Array<(int, int)> {
		return repairParse(path, input, options).0;
	}
	// One parse for current-text repair: the method bodies, as {methodBodies}
	// gives them, or null and the end of the token before the first error
	// (FileParseResult.repairAt).
	def repairParse(path: string, input: Array<byte>, options: Array<string>) -> (Array<(int, int)>, int) {
		var errors = AnalysisParseErrors.new(MAX_ERRORS), syntax = SymbolSyntaxIndex.new();
		setLanguageOptions(options);
		var file = AnalysisSingleFileParser.parse(path, input, errors, syntax, TypeCache.new(), null);
		resetLanguageOptions();
		if (errors.numErrors > 0) return (null, errors.firstTokenEnd);
		return (AnalysisMethodBodies.new(file, syntax).collect(), -1);
	}
	// Parse current document bytes without verification, through the same
	// driver and recovery as {parseFile}. A failed parse yields no symbols:
	// the compiler stops early and its partial VST is not an outline.
	def documentSymbols(path: string, input: Array<byte>, options: Array<string>) -> Array<AnalysisDocumentSymbol> {
		var normalized = normalizeLineTerminators(input);
		var errors = AnalysisParseErrors.new(MAX_ERRORS), syntax = SymbolSyntaxIndex.new();
		setLanguageOptions(options);
		var file = AnalysisSingleFileParser.parse(path, normalized, errors, syntax, TypeCache.new(), null);
		resetLanguageOptions();
		if (errors.numErrors > 0) return [];
		return DocumentSymbolCollector.new(file, syntax).collect();
	}
	// The leading comment of the declaration of {kind} whose name is the
	// bytes {begin} to {end} of {input}, as DocumentCommentCollector finds it
	// in the outline, or null if it has none or the outline cannot place it
	// unambiguously. A file over DeclarationComments.MAX_INPUT bytes, or one
	// that does not parse, has none. The parse is released on return.
	def declarationComment(path: string, input: Array<byte>, options: Array<string>,
			kind: AnalysisDeclKind, begin: int, end: int) -> string {
		if (!DeclarationComments.documents(kind) || begin < 0 || input.length > DeclarationComments.MAX_INPUT) return null;
		var normalized = normalizeLineTerminators(input);
		var errors = AnalysisParseErrors.new(MAX_ERRORS), syntax = SymbolSyntaxIndex.new();
		setLanguageOptions(options);
		var file = AnalysisSingleFileParser.parse(path, normalized, errors, syntax, TypeCache.new(), null);
		resetLanguageOptions();
		if (errors.numErrors > 0) return null;
		var symbols = DocumentSymbolCollector.new(file, syntax).collect();
		return DocumentCommentCollector.new(normalized, syntax.tokens).find(symbols, kind, begin, end);
	}
	// Foldable brace blocks and comments from the current text, without
	// verification. A failed parse keeps only what ends before its first
	// error; an error whose position the parser could not resolve drops
	// everything. See docs/architecture.md#folding-ranges.
	def foldingRanges(path: string, input: Array<byte>, options: Array<string>) -> Array<AnalysisFoldingRange> {
		var normalized = normalizeLineTerminators(input);
		var errors = AnalysisParseErrors.new(MAX_ERRORS), syntax = SymbolSyntaxIndex.new();
		setLanguageOptions(options);
		AnalysisSingleFileParser.parse(path, normalized, errors, syntax, TypeCache.new(), null);
		resetLanguageOptions();
		var cutoff = -1;
		if (errors.numErrors > 0) {
			if (errors.offsets.length == 0 || errors.offsets[0].0 < 0) return [];
			cutoff = errors.offsets[0].0;
		}
		return DocumentFoldingCollector.new(normalized, syntax.tokens, cutoff).collect();
	}
	// All positions share one current-text parse and one syntax index. Only
	// token recovery after the first error uses a conservative lexer.
	def selectionRanges(path: string, input: Array<byte>, options: Array<string>, positions: Array<int>) -> Array<Array<AnalysisSelectionRange>> {
		var normalized = normalizeLineTerminators(input);
		var errors = AnalysisParseErrors.new(MAX_ERRORS), syntax = SymbolSyntaxIndex.new();
		setLanguageOptions(options);
		var file = AnalysisSingleFileParser.parse(path, normalized, errors, syntax, TypeCache.new(), null);
		resetLanguageOptions();
		var cutoff = -1;
		if (errors.numErrors > 0) cutoff = if(errors.offsets.length > 0 && errors.offsets[0].0 >= 0, errors.offsets[0].0, 0);
		var symbols = DocumentSymbolCollector.new(file, syntax);
		symbols.partial = cutoff >= 0;
		if (cutoff >= 0) symbols.cutoff = cutoff;
		return DocumentSelectionCollector.new(input, syntax.tokens, cutoff, symbols.collect()).collect(positions);
	}
	// LSP accepts CRLF and bare CR. Preserve byte offsets while presenting
	// line terminators the compiler understands; never mutate the overlay.
	private def normalizeLineTerminators(input: Array<byte>) -> Array<byte> {
		var normalized = Array<byte>.new(input.length);
		for (i < input.length) normalized[i] = if(input[i] == '\r',
			if(i + 1 < input.length && input[i + 1] == '\n', ' ', '\n'), input[i]);
		return normalized;
	}
	// The pinned compiler's language options, without their "lang:" prefix,
	// and their defaults, in declaration order. The project file accepts
	// these flags ({ProjectCompilerFlags}).
	def languageOptions() -> Array<(string, bool)> {
		var options = Vector<(string, bool)>.new();
		for (l = Lists.reverse(CLOptions.langOpt.list); l != null; l = l.tail) {
			var opt = l.head.0, name = opt.name;
			if (Strings.startsWith(name, "lang:")) name = Arrays.range(name, 5, name.length);
			// Every language option is boolean; another kind reports false.
			options.put((name, Option<bool>.?(opt) && Option<bool>.!(opt).init));
		}
		return options.extract();
	}
	// The parser's keywords (Keywords.kwKeys), which no identifier may spell,
	// in byte order.
	def keywords() -> Array<string> {
		if (sortedKeywords == null) {
			var v = Vector<string>.new();
			for (kw in Keywords.kwKeys) if (kw != null) v.put(kw);
			sortedKeywords = AnalysisTables.sort(v.extract(), fun (a: string, b: string) => AnalysisTables.compareBytes(a, b) < 0);
		}
		return sortedKeywords;
	}
	private var sortedKeywords: Array<string>;
	// The builtin types a name can name, which have no declaration, in byte
	// order: those of {BUILTIN_TYPES} and of the integer types that the
	// verifier's top-level type lookup (V3.lookupToplevelType) resolves with
	// language options {options} (see setLanguageOptions), such as "array"
	// with read-only arrays, and the System component that analyses install
	// (SystemCalls.install). The integer types are iN and uN for each width
	// N up to Aeneas's Int.MAX_WIDTH in decimal, as Int.lookupFsi reads them.
	def builtinTypes(options: Array<string>) -> Array<string> {
		// Every completion with names asks, mostly with the same options.
		if (builtinOptions != null && sameOptions(builtinOptions, options)) return builtinNames;
		builtinOptions = options;
		return builtinNames = listBuiltinTypes(options);
	}
	private var builtinOptions: Array<string>;
	private var builtinNames: Array<string>;
	private def sameOptions(a: Array<string>, b: Array<string>) -> bool {
		if (a == b) return true;
		if (a == null || b == null || a.length != b.length) return false;
		for (i < a.length) if (!Strings.equal(a[i], b[i])) return false;
		return true;
	}
	private def listBuiltinTypes(options: Array<string>) -> Array<string> {
		setLanguageOptions(options);
		var v = Vector<string>.new();
		for (name in BUILTIN_TYPES) {
			if (V3.lookupToplevelType(name) != null || Strings.equal(name, SystemCalls.TYPECON.name)) v.put(name);
		}
		for (width = 1; width <= Int.MAX_WIDTH; width++) {
			for (sign in ["i", "u"]) {
				var name = Strings.format2("%s%d", sign, width);
				if (V3.lookupToplevelType(name) != null) v.put(name);
			}
		}
		resetLanguageOptions();
		return AnalysisTables.sort(v.extract(), fun (a: string, b: string) => AnalysisTables.compareBytes(a, b) < 0);
	}
	// The builtin type names other than the integer types iN and uN.
	def BUILTIN_TYPES = ["Array", "Range", "Ref", "System", "array", "bool", "byte", "double", "float",
		"int", "long", "range", "ref", "short", "string", "void"];
	// The AnalysisKeywordForms that the parser accepts with language options
	// {options} (see setLanguageOptions), read as Parser.parseFile reads them.
	def keywordForms(options: Array<string>) -> int {
		setLanguageOptions(options);
		var forms = if(enabled(CLOptions.FUN_EXPRS), AnalysisKeywordForms.FUN_EXPRS)
			| if(enabled(CLOptions.DESCRIPTORS), AnalysisKeywordForms.DESCRIPTORS)
			| if(enabled(CLOptions.OPEN_TYPES), AnalysisKeywordForms.OPEN_TYPES);
		resetLanguageOptions();
		return forms;
	}
	private def enabled(opt: Option<bool>) -> bool {
		return opt != null && opt.get();
	}
	// Sets Aeneas's process-wide language options to their defaults, then
	// applies {args} in order, as v3c does. Each is a flag that
	// {ProjectCompilerFlags} accepts: -lang:<name>, -lang:<name>=true, or
	// -lang:<name>=false. Setting -lang:fun-exprs also sets
	// -lang:simple-bodies, through the option's own handler.
	def setLanguageOptions(args: Array<string>) {
		resetLanguageOptions();
		for (arg in args) {
			var t = CLOptions.options.parseOption(arg), name = t.0;
			for (l = CLOptions.langOpt.list; l != null; l = l.tail) {
				if (Strings.equal(l.head.0.name, name)) l.head.0.parse(t.1);
			}
		}
	}
	// Restores every language option's default. Each parse and analysis
	// restores them when it ends, so that no project's options outlive it.
	def resetLanguageOptions() {
		for (l = CLOptions.langOpt.list; l != null; l = l.tail) {
			var opt = l.head.0;
			if (Option<bool>.?(opt)) Option<bool>.!(opt).val = Option<bool>.!(opt).init;
		}
	}
	// Parse and verify a whole program from in-memory sources, in the given
	// order, with language options {options} (see setLanguageOptions).
	// Builds a fresh {Program} each time and runs only the shared parser and,
	// if parsing succeeded, {Compilation.verify()}.
	// Never initializes, runs reachability, or generates code.
	// {collectStats} enables the expensive process-wide type-cache counts.
	def analyzeProgram(sources: Array<AnalysisSource>, options: Array<string>, collectStats: bool) -> ProgramAnalysis {
		return analyze(sources, options, collectStats, false);
	}
	// Analyzes a program as {analyzeProgram} does, keeping it for scope
	// queries (AnalysisScopedProgram).
	def analyzeForScope(sources: Array<AnalysisSource>, options: Array<string>, collectStats: bool) -> ProgramAnalysis {
		return analyze(sources, options, collectStats, true);
	}
	private def analyze(sources: Array<AnalysisSource>, options: Array<string>, collectStats: bool, scoped: bool) -> ProgramAnalysis {
		AnalysisTypeCache.prepare();
		setLanguageOptions(options);
		var uidBefore = UID.next, globalBefore = if(collectStats, globalTypeCount(), 0);
		var prog = Program.new();
		// Without a target, Aeneas provides a synthetic System component, as
		// it does for the interpreter (see Aeneas.makeProgram).
		SystemCalls.install(prog);
		prog.files = Array<string>.new(sources.length);
		prog.inputs = Array<Array<byte>>.new(sources.length);
		for (i < sources.length) {
			prog.files[i] = sources[i].path;
			// Treat a missing capture as empty source to keep analysis independent of disk.
			var input = sources[i].input;
			prog.inputs[i] = if(input == null, Array<byte>.new(0), input);
		}
		var compilation = Compilation.new(compiler, prog);
		if (BenchProbe.enabled) BenchProbe.classifyParse(prog.files, prog.inputs, languageFingerprint());
		var t0 = System.ticksUs();
		var coordinates = AnalysisSourceCoordinates.new(sources);
		var syntax = if(scoped, OrderedStringMap<SymbolSyntaxIndex>.new());
		var parseErrors = parseProgram(prog, coordinates, syntax);
		var parsed = prog.ERROR.noErrors;
		var t1 = System.ticksUs();
		// Compilation.compile() skips verification after a parse error, and so
		// does the adapter: the parser stops at the first error in a file, and
		// verifying the truncated tree would report spurious errors.
		var verified = parsed && compilation.verify();
		var t2 = System.ticksUs();
		resetLanguageOptions();
		// Drop process-wide roots even when parsing or verification failed.
		// The result still owns its VST; dropping that result makes it collectible.
		AnalysisTypeCache.release();
		var diagnostics = convertErrors(null, prog.ERROR);
		for (i < diagnostics.length) {
			var d = diagnostics[i];
			if (!parsed && i < parseErrors.offsets.length) {
				d.beginOffset = parseErrors.offsets[i].0;
				d.endOffset = parseErrors.offsets[i].1;
			}
			diagnostics[i] = coordinates.diagnostic(d);
		}
		diagnostics = capDiagnostics(diagnostics);
		var stats = AnalysisStats.new(t1 - t0, t2 - t1, UID.next - uidBefore,
			if(collectStats, globalTypeCount() - globalBefore, -1));
		if (scoped) return AnalysisScopedProgram.new(diagnostics, stats, parsed, verified, prog, syntax);
		return ProgramAnalysis.new(diagnostics, stats, parsed, verified, prog);
	}
	private def parseProgram(prog: Program, coordinates: AnalysisSourceCoordinates, syntax: OrderedStringMap<SymbolSyntaxIndex>) -> AnalysisParseErrors {
		var errors = AnalysisParseErrors.new(prog.ERROR.maxErrors);
		prog.vst = VstModule.new();
		var files = Vector<VstFile>.new().grow(prog.files.length);
		for (i = 0; i < prog.files.length && errors.notTooMany; i++) {
			var index = if(syntax != null, SymbolSyntaxIndex.new());
			if (syntax != null) syntax.add(prog.files[i], index);
			var start = if(BenchProbe.enabled, BenchProbe.now(), 0);
			files.put(AnalysisSingleFileParser.parse(prog.files[i], prog.inputs[i], errors, index,
				prog.typeCache, coordinates.capture(prog.files[i])));
			if (BenchProbe.enabled) BenchProbe.parsedFile(i, prog.inputs[i].length, BenchProbe.now() - start);
		}
		prog.vst.files = files.extract();
		prog.ERROR.copy(errors);
		if (CLOptions.REDEF_FIELD.val != null) {
			var input = StringBuilder.new().puts("-").puts(CLOptions.REDEF_FIELD.name).puts("=");
			var skip = input.length;
			input.puts(CLOptions.REDEF_FIELD.val);
			var redefs = Parser.parseRedefFields("<options>", input.toString(), skip, prog.ERROR);
			prog.vst.redefFile = redefs.0;
			prog.vst.fieldRedefs = redefs.1;
		}
		return errors;
	}
	// The language options in effect, one bit each in declaration order, for
	// benchmark probes that compare one program's parse with the next.
	private def languageFingerprint() -> u64 {
		var bits = 0ul;
		for (l = CLOptions.langOpt.list; l != null; l = l.tail) {
			var opt = l.head.0;
			bits = (bits << 1) | if(Option<bool>.?(opt) && Option<bool>.!(opt).get(), 1ul, 0ul);
		}
		return bits;
	}
	// The next value of Aeneas's process-wide UID counter. It never resets, so
	// it measures how many IDs analyses have consumed.
	def uidCounter() -> int {
		return UID.next;
	}
	// The number of types interned in Aeneas's process-wide type cache.
	def globalTypeCount() -> int {
		var cache = TypeUtil.globalCache;
		return countChains(cache.singleBuckets) + countChains(cache.multiBuckets);
	}
	private def countChains(buckets: Array<Type>) -> int {
		var count = 0;
		for (b in buckets) {
			for (t = b; t != null; t = t.link) count++;
		}
		return count;
	}
	// Keeps the first MAX_FILE_DIAGNOSTICS of each path's diagnostics, in
	// order, and sets the last one kept's {omitted} to the number dropped.
	// A null path is a path of its own.
	def capDiagnostics(diagnostics: Array<AnalysisDiagnostic>) -> Array<AnalysisDiagnostic> {
		if (diagnostics.length <= MAX_FILE_DIAGNOSTICS) return diagnostics;
		var counts = OrderedStringMap<int>.new(), over = false;
		for (d in diagnostics) {
			var n = counts[d.path] + 1;
			counts[d.path] = n;
			if (n > MAX_FILE_DIAGNOSTICS) over = true;
		}
		if (!over) return diagnostics;
		var kept = Vector<AnalysisDiagnostic>.new(), seen = OrderedStringMap<int>.new();
		for (d in diagnostics) {
			var n = seen[d.path] + 1;
			if (n > MAX_FILE_DIAGNOSTICS) continue;
			seen[d.path] = n;
			if (n == MAX_FILE_DIAGNOSTICS) d.omitted = counts[d.path] - n;
			kept.put(d);
		}
		return kept.extract();
	}
	private def convertErrors(path: string, errors: ErrorGen) -> Array<AnalysisDiagnostic> {
		var result = Vector<AnalysisDiagnostic>.new();
		for (l = Lists.reverse(errors.errors); l != null; l = l.tail) {
			var e = l.head, r = e.range;
			var d = if(r == null,
				AnalysisDiagnostic.new(path, 0, 0, 0, 0, e.error, e.description),
				AnalysisDiagnostic.new(Strings.nonnull(r.fileName), r.beginLine, r.beginColumn,
					r.endLine, r.endColumn, e.error, e.description));
			result.put(d);
		}
		return result.extract();
	}
}
