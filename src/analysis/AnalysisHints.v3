// Forty Unicode code points, including the elision marker. Display text is
// valid UTF-8; continuation bytes never count as another character.
component AnalysisHintText {
	def bound(text: string) -> string {
		var chars = 0, cut = 0;
		for (i < text.length) {
			if ((text[i] & 0xC0) == 0x80) continue;
			if (chars == 39) cut = i;
			if (++chars > 40) return StringBuilder.new().putr(text[0 ... cut]).puts("\xE2\x80\xA6").extract();
		}
		return text;
	}
	def valid(text: string, isType: bool) -> bool {
		if (text == null || text.length == 0) return false;
		var chars = 0;
		for (i = 0; i < text.length;) {
			var decoded = Utf8.decode1(text[i ...]);
			if (decoded.0 <= 0 || decoded.1 < 32 || decoded.1 == 127 || (isType && decoded.1 == '?')) return false;
			i += decoded.0;
			chars++;
		}
		return !isType || chars <= 40;
	}
}

// Snapshot hint records stay in their validated wire encoding: begin delta,
// span length, local declaration ID plus one (zero for parameter names), and
// string-table ID. A type hint sits at the end; a parameter hint at the begin.
class AnalysisHintCursor(r: DataReader, var remaining: int) {
	def var begin: int;
	def var end: int;
	def var local: int;
	def var label: int;
	def next() -> bool {
		if (remaining <= 0 || !r.ok) return false;
		remaining--;
		var delta = r.read_sleb32(), length = r.read_sleb32();
		local = r.read_sleb32();
		label = r.read_sleb32();
		if (delta < 0 || delta > int.max - begin || length <= 0 || length > int.max - begin - delta) {
			r.fail("invalid hint span");
			return false;
		}
		begin += delta;
		end = begin + length;
		return r.ok;
	}
	def position() -> int { return if(local > 0, end, begin); }
}

// Merge local declaration sites with call arguments in source order. Calls
// arrive by opening parenthesis; a small heap holds the later arguments of
// enclosing calls until their nested calls have been visited. Each span is
// read from the existing call record, without a second collected span stream
// or a whole-file hint sort.
class AnalysisHintEncoding(analysis: ProgramAnalysis, strings: AnalysisStringTable, ids: Array<int>,
		targets: AnalysisTypeTargetEncoding) {
	private def pending = Vector<(int, int, int)>.new();
	private var sites: Array<AnalysisDeclaration>;
	private var site: int;
	private var previous: int;
	private var output: DataWriter;
	def var count: int;
	def encode(path: string, declarations: Array<AnalysisDeclaration>) -> Range<byte> {
		sites = declarations;
		site = previous = count = 0;
		pending.length = 0;
		output = DataWriter.new().grow(6 * analysis.hintCount(path));
		var records = analysis.callRecords(path), c = AnalysisCallCursor.new(DataReader.new(records.0), records.1);
		c.absolute = true;
		while (c.next()) {
			flush(c.open);
			for (i < c.argCount) {
				c.nextArg();
				if (c.argHint > 0) push(c.argBegin, c.argEnd, c.argHint - 1);
			}
			c.finish();
		}
		flush(int.max);
		locals(int.max);
		return output.alias();
	}
	private def locals(before: int) {
		while (site < sites.length && sites[site].range.beginOffset < before) {
			var d = sites[site++];
			if (!AnalysisWorkerDeclaration.?(d)) continue;
			var label = AnalysisWorkerDeclaration.!(d).hintLabel;
			if (label >= 0) put(d.range.beginOffset, d.range.endOffset, targets.declaration(d) + 1, label);
		}
	}
	private def put(begin: int, end: int, local: int, label: int) {
		if (ids[label] == 0) ids[label] = strings.add(analysis.hintString(label)) + 1;
		output.put_sleb32(begin - previous).put_sleb32(end - begin).put_sleb32(local).put_sleb32(ids[label] - 1);
		previous = begin;
		count++;
	}
	private def push(begin: int, end: int, label: int) {
		var value = (begin, end, label), i = pending.length;
		pending.put(value);
		while (i > 0) {
			var parent = (i - 1) / 2;
			if (pending[parent].0 <= begin) break;
			pending[i] = pending[parent];
			i = parent;
		}
		pending[i] = value;
	}
	private def flush(before: int) {
		while (pending.length > 0 && pending[0].0 < before) {
			var value = pending[0], last = pending[pending.length - 1];
			pending.length--;
			if (pending.length > 0) {
				var i = 0;
				while (2 * i + 1 < pending.length) {
					var child = 2 * i + 1;
					if (child + 1 < pending.length && pending[child + 1].0 < pending[child].0) child++;
					if (last.0 <= pending[child].0) break;
					pending[i] = pending[child];
					i = child;
				}
				pending[i] = last;
			}
			locals(value.0);
			put(value.0, value.1, 0, value.2);
		}
	}
}
