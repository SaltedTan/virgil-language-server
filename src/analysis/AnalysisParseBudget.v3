// Bounds the server's own parse of one document's text, behind its outline,
// folding ranges, and selection ranges (AeneasAdapter.outline, which
// documentSymbols wraps, foldingRanges, and selectionRanges). That parse runs
// in the server, not the analysis worker, and its syntax tree and index grow
// with the tokens it reads, whatever their bytes: a 1 MiB document of
// "var a,a,a,..." exhausted the server's heap. So, before parsing, a pass
// that allocates nothing counts the tokens as the parser's lexer separates
// them, and a document with more than {maxTokens} is not parsed. See
// docs/architecture.md#document-symbols.
component AnalysisParseBudget {
	// The densest text, lists such as "(a,a,a,...)" with a token in each byte,
	// peaked at about 113 bytes of live heap per token in this parse, and the
	// largest file in the pinned Virgil checkout has 58,590 tokens. With the
	// default 200 MiB heap, whose copying collector leaves 100 MiB for live
	// data, 1,007,265 tokens of such a list answered, but only 693,906 with
	// two snapshots of the Aeneas sources retained and the overlay budget
	// full. This bound is half that, and a parse of this many tokens peaks
	// below 40 MB.
	def MAX_TOKENS = 350000;
	// The bound that {admits} applies; tests may lower it.
	var maxTokens = MAX_TOKENS;

	// Whether {input} has at most {maxTokens} tokens. Each token takes at
	// least one byte, so a shorter input is not counted.
	def admits(input: Array<byte>) -> bool {
		return input.length <= maxTokens || count(input, maxTokens) <= maxTokens;
	}
	// The message of a request refused because its document's text has more
	// than {maxTokens} tokens.
	def refusal() -> string {
		return Strings.format1("the document has more than %d tokens", maxTokens);
	}
	// The tokens of {input}, or the first count past {limit}. A token is a run
	// of identifier characters, which also covers keywords and most numbers, a
	// character or string literal, or any other printable byte, so an operator
	// of two or three bytes counts as two or three. Whitespace, comments, and
	// the bytes that the parser reports as invalid characters separate tokens,
	// as Parser.skipToNextToken skips them.
	def count(input: Array<byte>, limit: int) -> int {
		var tokens = 0, i = 0, max = input.length;
		while (i < max) {
			var ch = input[i];
			if (ch <= ' ' || ch > '~') {
				i++;
				continue;
			}
			if (ch == '/' && i + 1 < max) {
				var next = input[i + 1];
				if (next == '/') {
					i += 2;
					while (i < max && input[i] != '\n') i++;
					continue;
				}
				if (next == '*') {
					i += 2;
					while (i < max && !(input[i] == '*' && i + 1 < max && input[i + 1] == '/')) i++;
					i += 2;
					continue;
				}
			}
			if (++tokens > limit) return tokens;
			if (Char.isIdentMiddle(ch)) {
				i++;
				while (i < max && Char.isIdentMiddle(input[i])) i++;
			} else if (ch == '\"' || ch == '\'') {
				i = afterLiteral(input, i);
			} else {
				i++;
			}
		}
		return tokens;
	}
	// Where the literal that opens with the quote at {start} ends: after its
	// closing quote, or at the line end or end of input that leaves it open.
	private def afterLiteral(input: Array<byte>, start: int) -> int {
		var quote = input[start], i = start + 1, max = input.length;
		while (i < max) {
			var ch = input[i];
			if (ch == '\\') i += 2;
			else if (ch == quote) return i + 1;
			else if (ch == '\n') return i;
			else i++;
		}
		return max;
	}
}
