// The occurrence-index contract is documented in
// docs/architecture.md#compiler-adapter.
class OccurrenceCollector(sources: AnalysisSourceMaps) extends VstVisitor<void, void> {
	private def result = Vector<AnalysisOccurrence>.new();
	private var fileName: string;
	private var captures: List<(ParamDecl, VarBinding.Local)>;
	private var thisParam: ParamDecl;
	private var thisClass: VstClass;
	// Uses skipped because they are not token spans (see record).
	def var skipped: int;

	def collect(file: VstFile) -> Array<AnalysisOccurrence> {
		fileName = file.fileName;
		for (i < file.components.length) visitCompound(file.components[i]);
		for (i < file.classes.length) visitCompound(file.classes[i]);
		for (i < file.enums.length) visitCompound(file.enums[i]);
		for (i < file.exports.length) {
			var e = file.exports[i].expr;
			var inline = false;
			for (l = file.exports[i].synthetic.members; l != null; l = l.tail) {
				if (e.ident.name == l.head.token) {
					inline = true;
					break;
				}
			}
			if (!inline) expr(e);
		}
		var a = result.extract();
		return Arrays.sort(a, 0, a.length, before);
	}
	// Source order is byte order. Compiler coordinates follow it, except that
	// a retrospective token's context-free column can pass a later token's.
	private def before(a: AnalysisOccurrence, b: AnalysisOccurrence) -> bool {
		var x = a.range, y = b.range;
		if (x.beginOffset != y.beginOffset) return x.beginOffset < y.beginOffset;
		return x.beginLine < y.beginLine || (x.beginLine == y.beginLine && x.beginColumn < y.beginColumn);
	}
	private def visitCompound(decl: VstCompound) {
		// Verification clears compound.verifier; functions retain the receiver.
		thisParam = if(decl.constructor != null, decl.constructor.func.thisParam);
		thisClass = if(VstClass.?(decl), VstClass.!(decl));
		// Verification shares class parameters with their synthesized fields
		// and with the constructor, so only this walk visits their types.
		params(decl.params);
		if (thisClass != null) {
			// A variant case's superclass is synthesized from the variant's own
			// name and type parameter tokens; it is not a use.
			if (!thisClass.isSynthetic || thisClass.variantCase == null) superclass(thisClass.superclass);
			var info = thisClass.descriptorInfo;
			if (info != null) {
				typeRef(info.descriptorTypeRef);
				typeRef(info.describesTypeRef);
			}
		}
		if (decl.superclause != null) expr(decl.superclause.args);
		for (l = decl.members; l != null; l = l.tail) {
			match (l.head) {
				x: VstNew => {
					thisParam = x.func.thisParam;
					if (!x.isSynthetic && x.func.params != decl.params) params(x.func.params);
					// Verification shares the class clause with its constructor.
					// Only a constructor-local clause needs a second walk.
					if (x.superclause != null && x.superclause != decl.superclause) expr(x.superclause.args);
					stmt(x.func.body);
				}
				// Traverse lambda bodies through FunExpr so their capture mapping
				// is active, rather than through synthetic method wrappers.
				x: VstMethod => {
					if (x.isSynthetic) continue;
					thisParam = x.func.thisParam;
					func(x.func);
					stmt(x.func.body);
				}
				x: VstField => {
					if (!x.isSynthetic) typeRef(x.tref);
					expr(x.init);
				}
				x: VstEnumCase => exprs(x.args);
			}
		}
	}
	private def stmt(s: Stmt) {
		if (s != null) s.accept(this, ());
	}
	private def expr(e: Expr) {
		if (e != null) e.accept(this, ());
	}
	private def exprs(list: VstList<Expr>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) expr(l.head);
	}
	private def varDecl(v: VarDecl) {
		if (v == null) return;
		typeRef(v.tref);
		expr(v.init);
	}
	private def params(list: VstList<ParamDecl>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) typeRef(l.head.tref);
	}
	private def func(f: VstFunc) {
		params(f.params);
		match (f.rettype) {
			Explicit(tref) => typeRef(tref);
			_ => ;
		}
	}
	// A variant that extends another (-lang:open-types) extends its default
	// case: verification rebinds the reference to the case's synthetic class.
	// The source names the variant that declares the case. An explicit case,
	// such as V.A, has a left part and keeps its target.
	private def superclass(tref: TypeRef) {
		if (NamedTypeRef.?(tref) && ClassType.?(tref.binding)) {
			var x = NamedTypeRef.!(tref), c = ClassType.!(tref.binding).classDecl.variantCase;
			if (x.left == null && c != null && c.decl.isSynthetic && c.isDefaultCase()) {
				typeRefs(x.nested);
				record(x.name, make(AnalysisDeclKind.CLASS, c.receiver));
				return;
			}
		}
		typeRef(tref);
	}
	private def typeRefs(list: VstList<TypeRef>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) typeRef(l.head);
	}
	// Records the names in a type reference that verification resolved.
	// Function and tuple types nest them.
	private def typeRef(tref: TypeRef) {
		if (tref == null) return;
		match (tref) {
			x: NamedTypeRef => {
				typeRef(x.left);
				typeRefs(x.nested);
				record(x.name, typeDeclaration(x.binding));
			}
			x: FuncTypeRef => {
				typeRef(x.paramType);
				typeRef(x.returnType);
			}
			x: TupleTypeRef => typeRefs(x.nested);
		}
	}

	def visitIf(s: IfStmt, env: void) {
		expr(s.cond);
		stmt(s.tbranch);
		stmt(s.fbranch);
	}
	def visitBlock(s: BlockStmt, env: void) {
		for (l = s.stmts.list; l != null; l = l.tail) stmt(l.head);
	}
	def visitWhile(s: WhileStmt, env: void) {
		expr(s.cond);
		stmt(s.body);
	}
	def visitFor(s: ForStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.cond);
		expr(s.update);
		stmt(s.body);
	}
	def visitForeach(s: ForeachStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitForLess(s: ForLessStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitLocal(s: LocalStmt, env: void) {
		for (l = s.vars; l != null; l = l.tail) varDecl(l.head);
	}
	def visitBreak(s: BreakStmt, env: void) { }
	def visitContinue(s: ContinueStmt, env: void) { }
	def visitExpr(s: ExprStmt, env: void) {
		expr(s.expr);
	}
	def visitMatch(s: MatchStmt, env: void) {
		expr(s.expr);
		// defcase aliases a case in this list; it is not another subtree.
		for (l = s.cases.list; l != null; l = l.tail) matchCase(l.head, s.expr.exactType);
	}
	private def matchCase(c: MatchCase, matchType: Type) {
		for (l = c.patterns.list; l != null; l = l.tail) {
			var pat = l.head;
			expr(pat.expr);
			if (pat.vdecl != null) typeRef(pat.vdecl.tref);
			if (!VarExpr.?(pat.expr)) continue;
			var ve = VarExpr.!(pat.expr);
			// Qualified cases already have bindings. Unqualified case names
			// bypass ordinary name resolution in the verifier.
			if (ve.expr != null || ve.varbind.ok()) continue;
			if (pat.variantCase != null) {
				record(ve.ident.name, make(AnalysisDeclKind.VARIANT_CASE, pat.variantCase));
			} else if (pat.val != null && EnumType.?(matchType)) {
				// Enum patterns retain only their resolved case value; look up
				// the declaration in the verified scrutinee's enum.
				var member = EnumType.!(matchType).lookupCase(ve.ident.name.image);
				record(ve.ident.name, make(AnalysisDeclKind.ENUM_CASE, member));
			}
		}
		stmt(c.stmt);
	}
	def visitEmpty(s: EmptyStmt, env: void) { }
	def visitReturn(s: ReturnStmt, env: void) {
		expr(s.expr);
	}

	def visitTuple(e: TupleExpr, env: void) {
		exprs(e.exprs);
	}
	def visitParamExpr(e: ParamExpr, env: void) { }
	def visitAutoExpr(e: AutoExpr, env: void) {
		expr(e.expr);
	}
	def visitArray(e: ArrayExpr, env: void) {
		exprs(e.exprs);
	}
	def visitVar(e: VarExpr, env: void) {
		expr(e.expr);
		typeRefs(e.ident.params);
		var decl = declarationOf(e.varbind);
		// A literal enum argument folds E.Case.param to Const, losing the
		// field in the binding. Require an EnumConst receiver: E.count is a
		// built-in even when the enum has a parameter named count.
		if (decl == null && VarBinding.Const.?(e.varbind) && VarExpr.?(e.expr)
				&& VarBinding.EnumConst.?(VarExpr.!(e.expr).varbind) && EnumType.?(e.expr.exactType)) {
			var et = EnumType.!(e.expr.exactType);
			var member = et.enumDecl.memberMap[e.ident.name.image];
			if (VstField.?(member)) decl = make(AnalysisDeclKind.FIELD, member);
		}
		record(e.ident.name, decl);
	}
	// Every use is recorded here. A use must be a token span (see
	// AnalysisRange.isTokenSpan). Parser tokens always are; a name the compiler
	// manufactured where the source doesn't spell it would not be, and is
	// skipped, since neither its compiler span nor its byte span would locate it.
	private def record(token: Token, decl: AnalysisDeclaration) {
		if (decl == null || token.beginLine <= 0 || !Strings.equal(token.fileName, fileName)) return;
		var range = sources.range(token);
		if (range.isTokenSpan()) result.put(AnalysisOccurrence.new(range, decl));
		else skipped++;
	}
	def visitLiteral(e: Literal, env: void) { }
	def visitString(e: StringExpr, env: void) { }
	def visitApp(e: AppExpr, env: void) {
		expr(e.func);
		expr(e.args);
	}
	def visitIndex(e: IndexExpr, env: void) {
		expr(e.expr);
		exprs(e.exprs);
		// An index operation occupies its opening bracket, where an index
		// method is declared. A compound assignment such as c[i] += v reads
		// and writes through the one bracket; it records the write, since the
		// expression is the assignment's target. Builtin indexing binds no
		// method and records nothing.
		var decl = indexDeclaration(e.write);
		if (decl == null) decl = indexDeclaration(e.read);
		var src = e.exprs.src;
		if (decl != null && src != null) record(Token.new(src.fileName, "[", src.beginLine, src.beginColumn), decl);
	}
	def visitRange(e: RangeExpr, env: void) {
		expr(e.expr);
		expr(e.start);
		expr(e.end);
	}
	def visitNot(e: NotExpr, env: void) {
		expr(e.expr);
	}
	def visitNeg(e: NegExpr, env: void) {
		expr(e.expr);
	}
	def visitBitwiseNeg(e: BitwiseNegExpr, env: void) {
		expr(e.expr);
	}
	def visitAssign(e: AssignExpr, env: void) {
		expr(e.target);
		expr(e.expr);
	}
	def visitBinOp(e: BinOpExpr, env: void) {
		expr(e.left);
		expr(e.right);
	}
	def visitIfExpr(e: IfExpr, env: void) {
		exprs(e.exprs);
	}
	def visitFunExpr(e: FunExpr, env: void) {
		var outer = captures;
		for (l = e.captures; l != null; l = l.tail) captures = List.new(l.head, captures);
		func(e.func);
		stmt(e.func.body);
		captures = outer;
	}

	// Follows a verifier binding to the declaration it names, if that
	// declaration comes from program source.
	private def declarationOf(b: VarBinding) -> AnalysisDeclaration {
		match (b) {
			Local(decl) => {
				// Captured locals are represented by synthetic parameters. Follow
				// their outer bindings, including captures through nested lambdas.
				for (l = captures; l != null; l = l.tail) {
					if (l.head.0 == decl) return declarationOf(l.head.1);
				}
				// `this` is a synthetic receiver parameter whose token comes from
				// the class or constructor. Only the enclosing class is a target.
				if (decl == thisParam) return make(AnalysisDeclKind.CLASS, thisClass);
				return make(if(ParamDecl.?(decl), AnalysisDeclKind.PARAMETER, AnalysisDeclKind.LOCAL), decl);
			}
			ObjectField(receiver, member) => return make(AnalysisDeclKind.FIELD, member);
			ComponentField(member) => return make(AnalysisDeclKind.FIELD, member);
			ClassField(receiver, member) => return make(AnalysisDeclKind.FIELD, member);
			VariantField(receiver, member) => return make(AnalysisDeclKind.FIELD, member);
			ObjectMethod(receiver, member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			ClassMethod(receiver, member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			ComponentMethod(member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			ClassNew(receiver, member, funcType) => return constructorDeclaration(member);
			VariantCase(receiver, member) => return make(AnalysisDeclKind.VARIANT_CASE, member);
			EnumConst(member) => return make(AnalysisDeclKind.ENUM_CASE, member);
			Inst(op, facts) => return operatorDeclaration(op);
			Apply(op, facts) => return operatorDeclaration(op);
			Type(t) => return typeDeclaration(t);
			LayoutDecl(decl) => return make(AnalysisDeclKind.LAYOUT, decl);
			LayoutFieldDecl(decl) => return make(AnalysisDeclKind.LAYOUT_FIELD, decl);
			RefLayoutField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutRepeatedField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutRepeatedNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			RefLayoutRepeatedField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			RefLayoutNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			RefLayoutRepeatedNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			_ => return null; // bindings without a source declaration
		}
	}
	private def operatorDeclaration(op: Operator) -> AnalysisDeclaration {
		match (op.opcode) {
			VstSugar(sugar) => match (sugar) {
				EnumGetParam(field) => return make(AnalysisDeclKind.FIELD, field);
				// Construction of a class with a descriptor (-lang:descriptors).
				ClassNewDesc => {
					var t = op.typeArgs[0];
					return if(ClassType.?(t), constructorDeclaration(ClassType.!(t).classDecl.constructor));
				}
				_ => return null;
			}
			_ => return null;
		}
	}
	// The default constructor is the class's own name.
	private def constructorDeclaration(member: VstNew) -> AnalysisDeclaration {
		if (member == null) return null;
		if (member.isSynthetic) return make(AnalysisDeclKind.CLASS, member.receiver);
		return make(AnalysisDeclKind.CONSTRUCTOR, member);
	}
	// The method that an index operation calls, if the program declares it.
	private def indexDeclaration(b: AppBinding) -> AnalysisDeclaration {
		match (b) {
			CallObjectMethod(receiver, member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			_ => return null;
		}
	}
	private def typeDeclaration(t: Type) -> AnalysisDeclaration {
		// Verification errors can leave a Type binding with no resolved type.
		if (t == null) return null;
		match (t) {
			x: ClassType => {
				// A variant case's type is a synthetic class; the source declares the case.
				var decl = x.classDecl;
				if (decl != null && decl.isSynthetic && decl.variantCase != null) return make(AnalysisDeclKind.VARIANT_CASE, decl.variantCase);
				return make(AnalysisDeclKind.CLASS, decl);
			}
			x: EnumType => return make(AnalysisDeclKind.ENUM, x.enumDecl);
			// Ref<L> binds to the layout's reference type, but it names the
			// builtin Ref, which has no source declaration. Its layout
			// argument has no binding of its own and is not yet indexed.
			x: RefType => return null;
			// Builtin type parameters have no source token; inferred type
			// variables are TypeVarTypes.
			x: TypeParamType => return declare(AnalysisDeclKind.TYPE_PARAM, x.token);
		}
		if (V3Component_TypeCon.?(t.typeCon)) {
			return make(AnalysisDeclKind.COMPONENT, V3Component_TypeCon.!(t.typeCon).componentDecl);
		}
		return null;
	}
	private def make(kind: AnalysisDeclKind, decl: Decl) -> AnalysisDeclaration {
		return if(decl != null, declare(kind, decl.token));
	}
	private def declare(kind: AnalysisDeclKind, token: Token) -> AnalysisDeclaration {
		if (token == null || token.beginLine <= 0) return null; // synthesized by the compiler
		return AnalysisDeclaration.new(kind, token.image, sources.range(token));
	}
}
