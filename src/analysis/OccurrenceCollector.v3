// The occurrence-index contract is documented in
// docs/architecture.md#compiler-adapter, and display data in
// docs/architecture.md#display-text.
// {packings} is the program's packings, or null if it was not verified.
// {callEnds} and {names} are shared by the program's files.
class OccurrenceCollector(sources: AnalysisSourceMaps, display: AnalysisDisplay,
		packings: AnalysisPackings, callEnds: AnalysisCallEnds, names: AnalysisDeclaredNames) extends VstVisitor<void, void> {
	private def result = Vector<AnalysisOccurrence>.new();
	private def builtinUses = Vector<AnalysisBuiltinUse>.new();
	// Declaration sites in the order the walk finds them, which breaks ties.
	private def siteList = Vector<AnalysisDeclaration>.new();
	// The calls in the order the walk finds them (see calls), and the
	// argument spans of the call being recorded.
	private def callRecords = DataWriter.new();
	private def argSpans = Vector<int>.new();
	def var hintCount: int;
	// The last call's opening parenthesis, and whether every call so far
	// opened after the one before it.
	private var lastOpen = -1;
	private var callsInOrder = true;
	// While positive, endOf keeps no ends in {callEnds}: the walk has passed
	// those calls.
	private var suspended: int;
	// The expressions that endOf has read, which grows in proportion to the
	// file's syntax tree; OccurrenceCollector:nested_call_scaling checks it.
	def var located: int;
	// The calls whose arguments the walk is in.
	private var depth: int;
	// The last call that the walk finished, and its closing parenthesis, or
	// -1, so that a call of its result finds its own parenthesis.
	private var lastCall: Expr;
	private var lastClose = -1;
	private var fileName: string;
	// The file's source and replay map, on first use.
	private var input: Array<byte>;
	private var coordinates: AnalysisCoordinates;
	private var captures: List<(ParamDecl, VarBinding.Local)>;
	private var thisParam: ParamDecl;
	private var thisClass: VstClass;
	// Only this expression is written, never its receiver or index arguments.
	private var writeTarget: Expr;
	// The token of the last use recorded, and its byte offset and declaration
	// (null for a builtin use), so that a call finds its callee's.
	private var lastToken: Token;
	private var lastOffset: int;
	private var lastDeclaration: AnalysisDeclaration;
	// Uses skipped because they are not token spans (see record), and calls
	// skipped because their spans do not locate them (see call).
	def var skipped: int;
	// After collect: the uses that resolved to no source declaration but
	// have a type, and the declarations named in the file, each in source
	// order, and the calls, {callCount} records in the order of their opening
	// parentheses. A record has a call's wire encoding (see
	// AnalysisWire.encodeCalls), except that its opening parenthesis is its
	// offset, its callee is an offset before it (CALLEE_OFFSET) or none, and
	// its signature is an index plus one from AnalysisDisplay.callSignature;
	// In these absolute records bit 1 instead marks a label ID plus one
	// after each argument (zero suppresses that argument). AnalysisCallCursor
	// reads them with {absolute}. A few bytes a call,
	// rather than objects, keep the garbage of a large program's calls small
	// enough that collection does not make the worker collect its heap.
	def var builtins: Array<AnalysisBuiltinUse>;
	def var sites: Array<AnalysisDeclaration>;
	def var calls: Range<byte>;
	def var callCount: int;

	def collect(file: VstFile) -> Array<AnalysisOccurrence> {
		fileName = file.fileName;
		for (i < file.components.length) visitCompound(file.components[i]);
		for (i < file.classes.length) visitCompound(file.classes[i]);
		for (i < file.enums.length) visitCompound(file.enums[i]);
		for (i < file.layouts.length) visitLayout(file.layouts[i]);
		for (i < file.packings.length) visitPacking(file.packings[i]);
		for (i < file.exports.length) {
			var e = file.exports[i].expr;
			var inline = false;
			for (l = file.exports[i].synthetic.members; l != null; l = l.tail) {
				if (e.ident.name == l.head.token) {
					inline = true;
					break;
				}
			}
			if (!inline) expr(e);
		}
		builtins = AnalysisTables.sort(builtinUses.extract(), builtinBefore);
		sites = sortSites(siteList.extract());
		calls = sortCalls();
		return AnalysisTables.sort(result.extract(), before);
	}
	// The walk finds a file's components, classes, and other declarations in
	// turn, not in source order, so the calls it records may need sorting:
	// each record's opening parenthesis and start, as one long, then the
	// records in that order.
	private def sortCalls() -> Range<byte> {
		var data = callRecords.alias();
		if (callsInOrder) return data;
		var keys = Array<long>.new(callCount), c = AnalysisCallCursor.new(DataReader.new(data), callCount);
		c.absolute = true;
		for (i = 0; c.next(); i++) {
			keys[i] = (long.view(c.open) << 32) | c.start;
			c.skipArgs();
		}
		keys = AnalysisTables.sort(keys, longBefore);
		var sorted = DataWriter.new().grow(data.length), r = DataReader.new(data);
		c = AnalysisCallCursor.new(r, callCount);
		c.absolute = true;
		for (key in keys) {
			var start = int.view(key & 0xFFFFFFFF);
			c.seek(start, -1).next();
			c.skipArgs();
			sorted.putr(data[start ... r.pos]);
		}
		return sorted.alias();
	}
	private def longBefore(a: long, b: long) -> bool {
		return a < b;
	}
	// Source order is byte order. Compiler coordinates follow it, except that
	// a retrospective token's context-free column can pass a later token's.
	private def before(a: AnalysisOccurrence, b: AnalysisOccurrence) -> bool {
		return rangeBefore(a.range, b.range);
	}
	private def builtinBefore(a: AnalysisBuiltinUse, b: AnalysisBuiltinUse) -> bool {
		return rangeBefore(a.range, b.range);
	}
	private def rangeBefore(x: AnalysisRange, y: AnalysisRange) -> bool {
		if (x.beginOffset != y.beginOffset) return x.beginOffset < y.beginOffset;
		return x.beginLine < y.beginLine || (x.beginLine == y.beginLine && x.beginColumn < y.beginColumn);
	}
	// Sorts declaration sites by byte offset and keeps the first found of
	// any that overlap. A token names two declarations only where
	// verification shares it, as a variant with parameters shares its name
	// with its single case; the walk finds the declaration a reader means first.
	private def sortSites(list: Array<AnalysisDeclaration>) -> Array<AnalysisDeclaration> {
		list = AnalysisTables.sort(list, siteBefore);
		var count = 0, end = 0;
		for (i < list.length) {
			var r = list[i].range;
			if (count > 0 && r.beginOffset < end) continue;
			list[count++] = list[i];
			end = r.endOffset;
		}
		return if(count == list.length, list, Arrays.range(list, 0, count));
	}
	private def siteBefore(a: AnalysisDeclaration, b: AnalysisDeclaration) -> bool {
		return a.range.beginOffset < b.range.beginOffset;
	}
	// Records {decl} as declared in this file, if the source spells its name
	// there: an index method's name "[]" or "[]=" selects its opening bracket
	// (see AnalysisSourceMaps.range). A declaration whose name the compiler
	// manufactured elsewhere has no site.
	private def site(decl: AnalysisDeclaration) {
		if (decl == null) return;
		var r = decl.range;
		if (!Strings.equal(r.path, fileName) || r.beginOffset < 0 || r.endOffset <= r.beginOffset) return;
		var bracket = decl.name.length > 0 && decl.name[0] == '[' && r.endOffset - r.beginOffset == 1;
		if (!bracket && !r.isTokenSpan()) return;
		siteList.put(decl);
		declarationSource(decl);
	}
	private def siteVar(v: VarDecl) -> AnalysisDeclaration {
		// Verification appends synthetic capture parameters to lambda params.
		// Their tokens are uses in the body, not source declarations.
		for (l = captures; l != null; l = l.tail) if (l.head.0 == v) return null;
		// "_" declares nothing a use can name.
		if (v == null || v.isUnderscore()) return null;
		var d = make(if(ParamDecl.?(v), AnalysisDeclKind.PARAMETER, AnalysisDeclKind.LOCAL), v);
		site(d);
		return d;
	}
	private def siteTypeParams(list: List<TypeParamType>) {
		for (l = list; l != null; l = l.tail) site(declare(AnalysisDeclKind.TYPE_PARAM, l.head.token, l.head));
	}
	// A compound's own parameters are its fields.
	private def siteFields(list: VstList<ParamDecl>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) {
			var p = l.head;
			site(if(p.member != null, make(AnalysisDeclKind.FIELD, p.member), make(AnalysisDeclKind.PARAMETER, p)));
		}
	}
	private def visitLayout(decl: VstLayout) {
		site(make(AnalysisDeclKind.LAYOUT, decl));
		for (l = decl.members; l != null; l = l.tail) {
			if (!VstLayoutField.?(l.head)) continue;
			var f = VstLayoutField.!(l.head);
			site(make(AnalysisDeclKind.LAYOUT_FIELD, f));
			memoryType(f.mtref);
		}
	}
	// A layout field's memory type is a name with no type reference of its
	// own. Verification keeps the reference type of a nested layout, which
	// it looked up by that name, or else the type it resolved the name to.
	private def memoryType(mt: MemoryTypeRef) {
		if (mt == null || mt.tname == null) return;
		if (mt.mtlayout != null) record(mt.tname.name, make(AnalysisDeclKind.LAYOUT, mt.mtlayout.layoutDecl), null, false);
		else record(mt.tname.name, typeDeclaration(mt.mttype), mt.mttype, false);
	}
	// A packing and its parameters are its own declarations; see packingExpr.
	private def visitPacking(decl: VstPacking) {
		site(make(AnalysisDeclKind.PACKING, decl));
		if (decl.pparams != null) for (l = decl.pparams.list; l != null; l = l.tail) site(make(AnalysisDeclKind.PARAMETER, l.head));
		if (packings != null && packings.verified(decl)) packingExpr(decl, decl.expr);
	}
	// Verification looks up a field of a packing expression among the
	// packing's parameters alone, where a later parameter hides an earlier
	// one of the same name, and a packing application's name among the
	// program's packings, where a later packing replaces an earlier one; it
	// keeps neither binding. Both lookups ignore type arguments, as in
	// P<int>(b), which name nothing. It checks an application's arguments
	// only if they are as many as the packing's parameters. A bit pattern is
	// one literal token whose letters select parameters by their initials;
	// it names none of them.
	private def packingExpr(decl: VstPacking, e: VstPackingExpr) {
		match (e) {
			Concat(list) => packingExprs(decl, list);
			App(p, args) => {
				var target = packings.named(p.ident.name.image);
				if (target == null) return;
				record(p.ident.name, make(AnalysisDeclKind.PACKING, target), null, false);
				var arity = if(target.pparams != null, target.pparams.length());
				if (args != null && args.length() == arity) packingExprs(decl, args);
			}
			Field(f) => {
				var name = f.ident.name, param: PackingParamDecl;
				for (l = if(decl.pparams != null, decl.pparams.list); l != null; l = l.tail) {
					if (Strings.equal(l.head.token.image, name.image)) param = l.head;
				}
				record(name, make(AnalysisDeclKind.PARAMETER, param), null, false);
			}
			_ => ;
		}
	}
	private def packingExprs(decl: VstPacking, list: VstList<VstPackingExpr>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) packingExpr(decl, l.head);
	}
	private def visitCompound(decl: VstCompound) {
		// Verification clears compound.verifier; functions retain the receiver.
		thisParam = if(decl.constructor != null, decl.constructor.func.thisParam);
		thisClass = if(VstClass.?(decl), VstClass.!(decl));
		// A variant case's class shares its token with the case member, and
		// its type parameters with the variant.
		if (!decl.isSynthetic && !decl.isFileScope) {
			match (decl) {
				x: VstComponent => site(make(AnalysisDeclKind.COMPONENT, x));
				x: VstEnum => site(make(AnalysisDeclKind.ENUM, x));
				x: VstClass => site(make(AnalysisDeclKind.CLASS, x));
			}
			siteTypeParams(decl.typeParams);
		}
		siteFields(decl.params);
		// Verification shares class parameters with their synthesized fields
		// and with the constructor, so only this walk visits their types.
		params(decl.params);
		if (thisClass != null) {
			// A variant case's superclass is synthesized from the variant's own
			// name and type parameter tokens; it is not a use.
			if (!thisClass.isSynthetic || thisClass.variantCase == null) superclass(thisClass.superclass);
			var info = thisClass.descriptorInfo;
			if (info != null) {
				typeRef(info.descriptorTypeRef);
				typeRef(info.describesTypeRef);
			}
		}
		if (decl.superclause != null) expr(decl.superclause.args);
		for (l = decl.members; l != null; l = l.tail) {
			match (l.head) {
				x: VstNew => {
					thisParam = x.func.thisParam;
					if (!x.isSynthetic) site(make(AnalysisDeclKind.CONSTRUCTOR, x));
					if (!x.isSynthetic && x.func.params != decl.params) {
						if (x.func.params != null) for (p = x.func.params.list; p != null; p = p.tail) siteVar(p.head);
						params(x.func.params);
					}
					// Verification shares the class clause with its constructor.
					// Only a constructor-local clause needs a second walk.
					if (x.superclause != null && x.superclause != decl.superclause) expr(x.superclause.args);
					stmt(x.func.body);
				}
				// Traverse lambda bodies through FunExpr so their capture mapping
				// is active, rather than through synthetic method wrappers.
				x: VstMethod => {
					if (x.isSynthetic) continue;
					thisParam = x.func.thisParam;
					site(make(AnalysisDeclKind.METHOD, x));
					siteTypeParams(x.typeParams);
					func(x.func);
					stmt(x.func.body);
				}
				x: VstField => {
					if (!x.isSynthetic) {
						site(make(AnalysisDeclKind.FIELD, x));
						typeRef(x.tref);
					}
					expr(x.init);
				}
				x: VstEnumCase => {
					site(make(AnalysisDeclKind.ENUM_CASE, x));
					exprs(x.args);
				}
				x: VstCaseMember => site(make(AnalysisDeclKind.VARIANT_CASE, x));
			}
		}
	}
	private def stmt(s: Stmt) {
		if (s != null) s.accept(this, ());
	}
	private def expr(e: Expr) {
		if (e != null) e.accept(this, ());
	}
	private def exprs(list: VstList<Expr>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) expr(l.head);
	}
	private def varDecl(v: VarDecl) {
		if (v == null) return;
		var d = siteVar(v);
		if (d != null && !ParamDecl.?(v) && v.tref == null) {
			var label = display.hintText(v.vtype);
			if (label >= 0 && d.range.beginOffset >= 0) {
				AnalysisWorkerDeclaration.!(d).hintLabel = label;
				hintCount++;
			}
		}
		typeRef(v.tref);
		expr(v.init);
	}
	private def params(list: VstList<ParamDecl>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) typeRef(l.head.tref);
	}
	private def func(f: VstFunc) {
		if (f.params != null) for (l = f.params.list; l != null; l = l.tail) siteVar(l.head);
		params(f.params);
		match (f.rettype) {
			Explicit(tref) => typeRef(tref);
			_ => ;
		}
	}
	// A variant that extends another (-lang:open-types) extends its default
	// case: verification rebinds the reference to the case's synthetic class.
	// The source names the variant that declares the case. An explicit case,
	// such as V.A, has a left part and keeps its target.
	private def superclass(tref: TypeRef) {
		if (NamedTypeRef.?(tref) && ClassType.?(tref.binding)) {
			var x = NamedTypeRef.!(tref), c = ClassType.!(tref.binding).classDecl.variantCase;
			if (x.left == null && c != null && c.decl.isSynthetic && c.isDefaultCase()) {
				typeRefs(x.nested);
				var o = record(x.name, make(AnalysisDeclKind.CLASS, c.receiver), null, false);
				if (o != null) {
					o.useType = display.superclassUseType(o.declaration, tref);
					o.sourceType = sourceCode(o.declaration);
				}
				return;
			}
		}
		typeRef(tref);
	}
	private def typeRefs(list: VstList<TypeRef>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) typeRef(l.head);
	}
	// Records the names in a type reference that verification resolved.
	// Function and tuple types nest them.
	private def typeRef(tref: TypeRef) {
		if (tref == null) return;
		match (tref) {
			x: NamedTypeRef => {
				typeRef(x.left);
				if (RefType.?(x.binding)) layoutArgument(RefType.!(x.binding), x.nested);
				else typeRefs(x.nested);
				record(x.name, typeDeclaration(x.binding), x.binding, false);
			}
			x: FuncTypeRef => {
				typeRef(x.paramType);
				typeRef(x.returnType);
			}
			x: TupleTypeRef => typeRefs(x.nested);
		}
	}
	// Ref<L> binds to the reference type of layout L, which verification
	// looked up by L's name; L itself has no binding. Records L if {args} is
	// exactly that name. Ref is a builtin and records nothing.
	private def layoutArgument(t: RefType, args: VstList<TypeRef>) {
		var arg = if(args != null && args.length() == 1, args.list.head), decl = t.layoutDecl;
		if (NamedTypeRef.?(arg) && decl != null) {
			var x = NamedTypeRef.!(arg);
			if (x.left == null && x.nested == null && Strings.equal(x.name.image, decl.token.image)) {
				record(x.name, make(AnalysisDeclKind.LAYOUT, decl), null, false);
				return;
			}
		}
		typeRefs(args);
	}

	def visitIf(s: IfStmt, env: void) {
		expr(s.cond);
		stmt(s.tbranch);
		stmt(s.fbranch);
	}
	def visitBlock(s: BlockStmt, env: void) {
		for (l = s.stmts.list; l != null; l = l.tail) stmt(l.head);
	}
	def visitWhile(s: WhileStmt, env: void) {
		expr(s.cond);
		stmt(s.body);
	}
	def visitFor(s: ForStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.cond);
		expr(s.update);
		stmt(s.body);
	}
	def visitForeach(s: ForeachStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitForLess(s: ForLessStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitLocal(s: LocalStmt, env: void) {
		for (l = s.vars; l != null; l = l.tail) varDecl(l.head);
	}
	def visitBreak(s: BreakStmt, env: void) { }
	def visitContinue(s: ContinueStmt, env: void) { }
	def visitExpr(s: ExprStmt, env: void) {
		expr(s.expr);
	}
	def visitMatch(s: MatchStmt, env: void) {
		expr(s.expr);
		// defcase aliases a case in this list; it is not another subtree.
		for (l = s.cases.list; l != null; l = l.tail) matchCase(l.head, s.expr.exactType);
	}
	private def matchCase(c: MatchCase, matchType: Type) {
		for (l = c.patterns.list; l != null; l = l.tail) {
			var pat = l.head;
			expr(pat.expr);
			if (pat.params != null) for (p = pat.params.list; p != null; p = p.tail) siteVar(p.head);
			if (pat.vdecl != null) {
				siteVar(pat.vdecl);
				typeRef(pat.vdecl.tref);
			}
			if (!VarExpr.?(pat.expr)) continue;
			var ve = VarExpr.!(pat.expr);
			// Qualified cases already have bindings. Unqualified case names
			// bypass ordinary name resolution in the verifier.
			if (ve.expr != null || ve.varbind.ok()) continue;
			if (pat.variantCase != null) {
				var o = record(ve.ident.name, make(AnalysisDeclKind.VARIANT_CASE, pat.variantCase), null, false);
				if (o != null) o.sourceType = sourceCode(o.declaration);
			} else if (pat.val != null && EnumType.?(matchType)) {
				// Enum patterns retain only their resolved case value; look up
				// the declaration in the verified scrutinee's enum.
				var member = EnumType.!(matchType).lookupCase(ve.ident.name.image);
				record(ve.ident.name, make(AnalysisDeclKind.ENUM_CASE, member), matchType, false);
			}
		}
		stmt(c.stmt);
	}
	def visitEmpty(s: EmptyStmt, env: void) { }
	def visitReturn(s: ReturnStmt, env: void) {
		expr(s.expr);
	}

	def visitTuple(e: TupleExpr, env: void) {
		exprs(e.exprs);
	}
	def visitParamExpr(e: ParamExpr, env: void) { }
	def visitAutoExpr(e: AutoExpr, env: void) {
		assigned(e.expr);
	}
	def visitArray(e: ArrayExpr, env: void) {
		exprs(e.exprs);
	}
	def visitVar(e: VarExpr, env: void) {
		expr(e.expr);
		match (e.varbind) {
			Type(t) => if (RefType.?(t)) layoutArgument(RefType.!(t), e.ident.params); else typeRefs(e.ident.params);
			_ => typeRefs(e.ident.params);
		}
		var decl = declarationOf(e.varbind);
		// A literal enum argument folds E.Case.param to Const, losing the
		// field in the binding. Require an EnumConst receiver: E.count is a
		// built-in even when the enum has a parameter named count.
		if (decl == null && VarBinding.Const.?(e.varbind) && VarExpr.?(e.expr)
				&& VarBinding.EnumConst.?(VarExpr.!(e.expr).varbind) && EnumType.?(e.expr.exactType)) {
			var et = EnumType.!(e.expr.exactType);
			var member = et.enumDecl.memberMap[e.ident.name.image];
			if (VstField.?(member)) decl = make(AnalysisDeclKind.FIELD, member);
		}
		if (decl != null) {
			var o = record(e.ident.name, decl, e.exactType, e == writeTarget);
			if (o != null && VarBinding.Type.?(e.varbind)) o.sourceType = sourceCode(decl);
		} else builtin(e.ident.name, e.varbind, e.exactType);
	}
	// Every use is recorded here, with the text of its type {t} if that
	// differs from its declaration's. A use must be a token span (see
	// AnalysisRange.isTokenSpan). Parser tokens always are; a name the compiler
	// manufactured where the source doesn't spell it would not be, and is
	// skipped, since neither its compiler span nor its byte span would locate it.
	// Returns the occurrence, or null if nothing was recorded.
	private def record(token: Token, decl: AnalysisDeclaration, t: Type, write: bool) -> AnalysisOccurrence {
		if (decl == null || token.beginLine <= 0 || !Strings.equal(token.fileName, fileName)) return null;
		var range = sources.range(token);
		if (!range.isTokenSpan()) {
			skipped++;
			return null;
		}
		var o: AnalysisOccurrence = if(write, AnalysisWriteOccurrence.new(range, decl), AnalysisOccurrence.new(range, decl));
		if (t != null) o.useType = display.useType(decl, t);
		var d = AnalysisWorkerDeclaration.!(decl);
		if (isTypeName(d.kind) && (ClassType.?(t) || EnumType.?(t) || TypeParamType.?(t))) o.sourceType = sourceCode(d);
		else o.sourceType = if(t == d.ownType, declarationSource(decl),
			if(t == null && decl.kind == AnalysisDeclKind.LAYOUT, sourceCode(decl), resolvedSourceType(t)));
		result.put(o);
		last(token, range.beginOffset, decl);
		return o;
	}
	private def last(token: Token, offset: int, decl: AnalysisDeclaration) {
		lastToken = token;
		lastOffset = offset;
		lastDeclaration = decl;
	}
	// A resolved use with no source declaration, such as ".length" or
	// "int.max", has only its type, which it keeps if that is known.
	private def builtin(token: Token, b: VarBinding, t: Type) {
		if (!b.ok() || b == VarBinding.Void || token.beginLine <= 0 || !Strings.equal(token.fileName, fileName)) return;
		var text = display.typeText(t);
		if (text == null) return;
		var range = sources.range(token);
		if (range.isTokenSpan()) {
			var u = AnalysisBuiltinUse.new(range, text);
			u.sourceType = resolvedSourceType(t);
			builtinUses.put(u);
			last(token, range.beginOffset, null);
		} else {
			skipped++;
		}
	}
	def visitLiteral(e: Literal, env: void) { }
	def visitString(e: StringExpr, env: void) { }
	def visitApp(e: AppExpr, env: void) {
		expr(e.func);
		// Parentheses preserve a callee's name. Do not follow applications:
		// in factory()(), factory's result is the inner function value.
		var callee = e.func;
		while (TupleExpr.?(callee)) {
			var list = TupleExpr.!(callee).exprs.list;
			if (list == null || list.tail != null) break;
			callee = list.head;
		}
		if (VarExpr.?(callee) && lastToken == VarExpr.!(callee).ident.name) {
			var target = resolvedSourceType(e.exactType);
			if (lastDeclaration != null) result[result.length - 1].sourceType = target;
			else builtinUses[builtinUses.length - 1].sourceType = target;
		}
		var close = call(e);
		depth++;
		expr(e.args);
		depth--;
		lastCall = e;
		lastClose = close;
		// Every end kept in the arguments has been read, unless a call was
		// missed; none is known.
		if (depth == 0) callEnds.clear();
	}
	// Records the call {e} in {file} alone, as collect records it with the rest
	// of the file, for a call query (AnalysisScopeFinder.findCall): it walks
	// {e}'s callee, then reads its arguments only to locate them (see call).
	// {thisParam} and {thisClass} are the receiver of the member around {e},
	// and {lambdas} the lambdas around it, innermost first, whose captures
	// name the variables of the code around them, as in visitFunExpr. Returns
	// the call's record and the declaration that its callee names, or null
	// where collect records no call, as for "void(e)".
	def recordCall(file: VstFile, e: AppExpr, thisParam: ParamDecl, thisClass: VstClass, lambdas: List<FunExpr>) -> AnalysisCallAnswer {
		fileName = file.fileName;
		this.thisParam = thisParam;
		this.thisClass = thisClass;
		for (l = Lists.reverse(lambdas); l != null; l = l.tail) {
			for (c = l.head.captures; c != null; c = c.tail) captures = List.new(c.head, captures);
		}
		expr(e.func);
		// The callee's own calls, as in f(a)(b), come first.
		var start = callRecords.pos;
		if (call(e) < 0) return null;
		var record = Ranges.dup(callRecords.alias()[start ...]);
		var c = AnalysisCallCursor.new(DataReader.new(record), 1);
		c.absolute = true;
		c.next();
		return AnalysisCallAnswer.new(c.open, record, if(c.calleeDelta > 0, lastDeclaration));
	}
	// Records the call {e}, after its callee, whose name is the last use
	// recorded if it is a use at all. Its parentheses and arguments are found
	// from the tokens around them, which the parser captured with their
	// offsets: only whitespace, comments, and commas can separate a callee,
	// its parenthesis, its arguments, and the closing parenthesis (see
	// endOf). A call whose syntax is not where that puts it is skipped and
	// counted; none is known. Each application in the syntax tree is a call,
	// including one through a class (C.m(c, x)), a constructor, a variant
	// case, a closure, a builtin, and a partial application, whose "_"
	// arguments are arguments like any other, except "void(e)", which only
	// discards its operands, and Pointer.atField, which needs a target, so
	// verification never accepts it here. What the tree does not keep as an
	// application has no call: a constructor's super(...) clause, an index
	// operation, and an operator. See docs/architecture.md#call-sites.
	// Returns the offset just past the call's closing parenthesis, or -1.
	private def parameterHints(e: AppExpr, target: AnalysisDeclaration, b: VarBinding, arity: int) -> Array<int> {
		if (arity == 0 || AppBinding.None.?(e.appbind) || AppBinding.Partial.?(e.appbind)) return null;
		var labels = display.hintParams(target, b), args = e.args.exprs;
		// Tuple expansion and partially applied calls have no one-to-one map.
		if (labels == null || labels.length != arity) return null;
		for (a = args.list; a != null; a = a.tail) if (ParamExpr.?(a.head)) return null;
		return labels;
	}
	private def redundantArgument(arg: Expr, label: int) -> bool {
		while (TupleExpr.?(arg)) {
			var list = TupleExpr.!(arg).exprs.list;
			if (list == null || list.tail != null) break;
			arg = list.head;
		}
		return VarExpr.?(arg) && Strings.equal(VarExpr.!(arg).ident.name.image, display.hintString(label));
	}
	private def call(e: AppExpr) -> int {
		// The end of the last argument, if endOf found it before, which is
		// read first so that the next call finds its own.
		var memo = callEnds.read(e);
		match (e.appbind) {
			Void => return -1;
			// Pointer.atField replaces its argument with an empty list; see
			// Verifier.visitPtrAtField.
			PtrAtComponentField, PtrAtObjectField, PtrAtRefLayoutField,
			PtrAtUnboxedObjectField, PtrAtUnboxedComponentField => return -1;
			None => if (VarExpr.?(e.func)) {
				var v = VarExpr.!(e.func);
				match (v.varbind) {
					PtrAtField => return -1;
					None => {
						// Each name could also be a declaration of the program's,
						// called like any other, so it excludes a call only where
						// the program declares nothing by that name.
						if (v.expr == null && Strings.equal(v.ident.name.image, "void") && !names.declaresVoid()) return -1;
						if (VarExpr.?(v.expr) && Strings.equal(v.ident.name.image, "atField")) {
							var owner = VarExpr.!(v.expr);
							if (owner.expr == null && Strings.equal(owner.ident.name.image, "Pointer") && !names.declaresPointer()) return -1;
						}
					}
					_ => ;
				}
			}
			_ => ;
		}
		var list = e.args.exprs;
		if (list.src == null || list.src.beginLine <= 0 || !Strings.equal(list.src.fileName, fileName)) return -1;
		var open = parenAfter(e.func, list.src, true), n = list.length(), end = open + 1;
		var region = callEnds.length();
		argSpans.length = 0;
		for (l = if(open >= 0, list.list); l != null; l = l.tail) {
			if (argSpans.length > 0) {
				end = skipSpace(end);
				if (byteAt(end) != ',') break;
				end++;
			}
			var begin = skipSpace(end);
			end = if(l.tail == null && memo >= 0, memo, endOf(l.head, begin));
			if (end <= begin || !startsAt(l.head, begin)) break;
			argSpans.put(begin).put(end);
		}
		callEnds.region(region);
		var close = if(open >= 0 && argSpans.length == 2 * n, closeAfter(end, ')'), -1);
		if (close < 0) {
			skipped++;
			return -1;
		}
		var callee = -1, target: AnalysisDeclaration, b: VarBinding, func = e.func;
		while (TupleExpr.?(func)) {
			var parts = TupleExpr.!(func).exprs.list;
			if (parts == null || parts.tail != null) break;
			func = parts.head;
		}
		if (VarExpr.?(func)) {
			var v = VarExpr.!(func);
			b = v.varbind;
			if (lastToken == v.ident.name && lastOffset < open) {
				callee = lastOffset;
				target = lastDeclaration;
			}
		}
		var labels = parameterHints(e, target, b, n);
		var signature = display.callSignature(target, b, e.func.exactType);
		var flags = if(callee >= 0, AnalysisCallFlags.CALLEE_OFFSET) | if(close - 1 > end, AnalysisCallFlags.CLOSE_GAP)
			| if(labels != null, AnalysisCallFlags.CALLEE_AT_PAREN);
		if (open <= lastOpen) callsInOrder = false;
		lastOpen = open;
		callCount++;
		var w = callRecords;
		putU(w, open);
		putU(w, n * 8 + flags);
		if (callee >= 0) putU(w, open - callee);
		putU(w, signature + 1);
		// Each argument's length times four plus the bytes before it, or three
		// and then those bytes.
		end = open + 1;
		var argument = list.list;
		for (i = 0; i < argSpans.length; (i += 2, argument = argument.tail)) {
			var gap = argSpans[i] - end, length = argSpans[i + 1] - argSpans[i];
			putU(w, 4 * length + if(gap < 3, gap, 3));
			if (gap >= 3) putU(w, gap);
			if (labels != null) {
				var label = labels[i / 2];
				if (label >= 0 && redundantArgument(argument.head, label)) label = -1;
				putU(w, label + 1);
				if (label >= 0) hintCount++;
			}
			end = argSpans[i + 1];
		}
		if (close - 1 > end) putU(w, close - 1 - end);
		return close;
	}
	private def putU(w: DataWriter, value: int) {
		w.put_uleb32(u32.view(value));
	}
	// The opening parenthesis of a call of {func} whose argument list has
	// range {src}, or -1. If the walk has {visited} {func}, it has passed the
	// calls there, so the ends that endOf finds there are not kept; if not,
	// as when endOf locates a call with no arguments ahead of the walk, they
	// are, as for any call it locates ahead.
	private def parenAfter(func: Expr, src: FileRange, visited: bool) -> int {
		if (visited) suspended++;
		var end = endOf(func, -1);
		if (visited) suspended--;
		var open = skipSpace(end);
		if (byteAt(open) != '(') open = point(src);
		return if(byteAt(open) == '(', open, -1);
	}
	// The byte offset just past {e}, which starts at {begin} if that is
	// known, or -1. It is the end of the token or the closing bracket at the
	// end of {e}'s right spine. A bracket follows the last element of its
	// list, past whitespace, comments, and perhaps a trailing comma, or the
	// opening bracket of an empty list. Syntax ranges would mislocate some:
	// the range of a prefix ++x ends at its operator, and that of a range,
	// as in x[a ... b], ends before its closing bracket, which no syntax
	// records. Where the tokens do not locate a bracket, as at the end of a
	// block, the replay map does (see AnalysisSourceMaps). The last call that
	// the walk finished ends at its closing parenthesis, so that a call of a
	// result, as in f(a)(b) or a[f(i)](), finds its own without reading the
	// walked calls again.
	private def endOf(e: Expr, begin: int) -> int {
		while (true) {
			located++;
			match (e) {
				x: VarExpr => {
					var params = x.ident.params;
					return if(params == null, tokenEnd(x.ident.name), typeListEnd(params));
				}
				x: AppExpr => {
					if (x == lastCall && lastClose >= 0) return lastClose;
					var args = x.args.exprs;
					if (args.list != null) {
						// The call will need its last argument's end too.
						var slot = if(suspended == 0, callEnds.reserve(x), -1), end = endOf(lastOf(args), -1);
						if (slot >= 0) callEnds.fill(slot, end);
						return closeAfter(end, ')');
					}
					var open = parenAfter(x.func, args.src, false);
					return if(open >= 0, closeAfter(open + 1, ')'), -1);
				}
				x: BinOpExpr => {
					if (x.right == null) return tokenEnd(x.op.token);
					begin = skipSpace(tokenEnd(x.op.token));
					e = x.right;
				}
				x: AutoExpr => {
					if (x.post) return tokenEnd(x.token);
					begin = skipSpace(tokenEnd(x.token));
					e = x.expr;
				}
				x: AssignExpr => {
					if (x.expr == null || !Token.?(x.assign)) return -1;
					begin = skipSpace(tokenEnd(Token.!(x.assign)));
					e = x.expr;
				}
				x: IndexExpr => {
					if (x.exprs.list != null) return closeAfter(endOf(lastOf(x.exprs), -1), ']');
					var open = skipSpace(endOf(x.expr, begin));
					return if(byteAt(open) == '[', closeAfter(open + 1, ']'), rangeEnd(x.exprs.src));
				}
				x: RangeExpr => return closingBracket(endOf(if(x.end != null, x.end, x.start), -1), x.end == null && !x.plus);
				x: Literal => return tokenEnd(x.token);
				x: StringExpr => return tokenEnd(x.token);
				x: ParamExpr => return tokenEnd(x.token);
				x: TupleExpr => return listEnd(x.exprs, begin, ')');
				x: ArrayExpr => return listEnd(x.exprs, begin, ']');
				x: IfExpr => return listEnd(x.exprs, -1, ')');
				// The operators "!", "-", and "~" take a byte.
				x: NotExpr => {
					begin = if(begin >= 0, skipSpace(begin + 1), -1);
					e = x.expr;
				}
				x: NegExpr => {
					begin = if(begin >= 0, skipSpace(begin + 1), -1);
					e = x.expr;
				}
				x: BitwiseNegExpr => {
					begin = if(begin >= 0, skipSpace(begin + 1), -1);
					e = x.expr;
				}
				// A simple body, as in fun (x: int) => x + 1, is its
				// expression, and an empty one, as in fun ();, its semicolon.
				x: FunExpr => {
					match (x.func.body) {
						y: ReturnStmt => {
							if (y.expr == null) return -1;
							begin = -1;
							e = y.expr;
						}
						y: BlockStmt => return rangeEnd(y.stmts.src);
						y: EmptyStmt => {
							var at = if(Token.?(y.point), tokenBegin(Token.!(y.point)), point(y.point));
							return if(at >= 0 && byteAt(at) == ';', at + 1, -1);
						}
						_ => return -1;
					}
				}
				_ => return -1;
			}
		}
		return -1;
	}
	// The end of the bracketed {list}, closed by {close}, whose opening
	// bracket is at {open} if that is known.
	private def listEnd(list: VstList<Expr>, open: int, close: byte) -> int {
		if (list.list != null) return closeAfter(endOf(lastOf(list), -1), close);
		return if(open >= 0, closeAfter(open + 1, close), rangeEnd(list.src));
	}
	// The end of type arguments, as in f<A, B>.
	private def typeListEnd(list: VstList<TypeRef>) -> int {
		return if(list.list != null, closeAfter(typeRefEnd(lastOf(list)), '>'), rangeEnd(list.src));
	}
	private def typeRefEnd(t: TypeRef) -> int {
		while (true) {
			match (t) {
				x: NamedTypeRef => return if(x.nested == null, tokenEnd(x.name), typeListEnd(x.nested));
				x: FuncTypeRef => t = x.returnType;
				x: TupleTypeRef => {
					var list = x.nested;
					return if(list.list != null, closeAfter(typeRefEnd(lastOf(list)), ')'), rangeEnd(list.src));
				}
				_ => return -1;
			}
		}
		return -1;
	}
	private def lastOf<T>(list: VstList<T>) -> T {
		var l = list.list;
		while (l.tail != null) l = l.tail;
		return l.head;
	}
	// The offset just past {close} after {offset}, past whitespace,
	// comments, and perhaps a trailing comma, or -1.
	private def closeAfter(offset: int, close: byte) -> int {
		if (offset < 0) return -1;
		offset = skipSpace(offset);
		if (byteAt(offset) == ',') offset = skipSpace(offset + 1);
		return if(byteAt(offset) == close, offset + 1, -1);
	}
	// Whether {e}'s first token or bracket is at {offset}.
	private def startsAt(e: Expr, offset: int) -> bool {
		while (true) {
			match (e) {
				x: VarExpr => if (x.expr != null) e = x.expr; else return tokenBegin(x.ident.name) == offset;
				x: AppExpr => e = x.func;
				x: BinOpExpr => if (x.left != null) e = x.left; else return false;
				x: AutoExpr => if (x.post) e = x.expr; else return tokenBegin(x.token) == offset;
				x: IndexExpr => e = x.expr;
				x: RangeExpr => e = x.expr;
				x: AssignExpr => if (x.target != null) e = x.target; else return false;
				x: Literal => return tokenBegin(x.token) == offset;
				x: StringExpr => return tokenBegin(x.token) == offset;
				x: ParamExpr => return tokenBegin(x.token) == offset;
				x: TupleExpr => return byteAt(offset) == '(';
				x: ArrayExpr => return byteAt(offset) == '[';
				x: NotExpr => return byteAt(offset) == '!';
				x: NegExpr => return byteAt(offset) == '-';
				x: BitwiseNegExpr => return byteAt(offset) == '~';
				x: IfExpr => return byteAt(offset) == 'i';
				x: FunExpr => return byteAt(offset) == 'f';
				_ => return false;
			}
		}
		return false;
	}
	// The offset past the closing bracket of a range whose last part ends at
	// {offset}, after "..." too if {dots}; only whitespace and comments
	// separate them. Otherwise -1.
	private def closingBracket(offset: int, dots: bool) -> int {
		if (offset < 0) return -1;
		offset = skipSpace(offset);
		if (dots) {
			for (i < 3) if (byteAt(offset + i) != '.') return -1;
			offset = skipSpace(offset + 3);
		}
		return if(byteAt(offset) == ']', offset + 1, -1);
	}
	// The offset of the first byte at or after {offset} that is not
	// whitespace or in a comment.
	private def skipSpace(offset: int) -> int {
		while (true) {
			var b = byteAt(offset), next = byteAt(offset + 1);
			if (b == ' ' || b == '\t' || b == '\n' || b == '\r') {
				offset++;
			} else if (b == '/' && next == '/') {
				offset += 2;
				while ((b = byteAt(offset)) >= 0 && b != '\n') offset++;
			} else if (b == '/' && next == '*') {
				offset += 2;
				while ((b = byteAt(offset)) >= 0 && !(b == '*' && byteAt(offset + 1) == '/')) offset++;
				if (b >= 0) offset += 2;
			} else {
				return offset;
			}
		}
		return offset;
	}
	// A token's byte offset, which the parser captured, or else the replayed
	// offset of its live coordinates.
	private def tokenBegin(t: Token) -> int {
		if (AnalysisCapturedToken.?(t)) return AnalysisCapturedToken.!(t).offset;
		return point(t.range());
	}
	private def tokenEnd(t: Token) -> int {
		if (AnalysisCapturedToken.?(t)) return AnalysisCapturedToken.!(t).offset + t.image.length;
		return rangeEnd(t.range());
	}
	private def point(p: FilePoint) -> int {
		if (p == null || !Strings.equal(p.fileName, fileName)) return -1;
		return offset(p.beginLine, p.beginColumn);
	}
	private def rangeEnd(r: FileRange) -> int {
		if (r == null || !Strings.equal(r.fileName, fileName)) return -1;
		return offset(r.endLine, r.endColumn);
	}
	// The byte offset of live parser coordinates in the file, which the
	// parser's points and lists hold, as do the ranges of retrospective tokens
	// (see AnalysisRetrospectiveToken); the replay map locates them.
	private def offset(line: int, column: int) -> int {
		if (coordinates == null) coordinates = sources.map(fileName);
		return if(coordinates != null, coordinates.offset(line, column, false), -1);
	}
	// The file's byte at {offset}, or -1 if there is none.
	private def byteAt(offset: int) -> int {
		if (input == null) input = sources.input(fileName);
		return if(input != null && u32.view(offset) < u32.view(input.length), input[offset], -1);
	}
	def visitIndex(e: IndexExpr, env: void) {
		expr(e.expr);
		exprs(e.exprs);
		// An index operation occupies its opening bracket, where an index
		// method is declared. A compound assignment such as c[i] += v reads
		// and writes through the one bracket; it records the write, since the
		// expression is the assignment's target. Builtin indexing binds no
		// method and records nothing.
		var b = e.write, decl = indexDeclaration(b);
		if (decl == null) {
			b = e.read;
			decl = indexDeclaration(b);
		}
		var src = e.exprs.src;
		if (decl == null || src == null) return;
		var o = record(Token.new(src.fileName, "[", src.beginLine, src.beginColumn), decl, null, e == writeTarget);
		if (o != null) o.sourceType = resolvedSourceType(e.exactType);
		match (b) {
			CallObjectMethod(receiver, member, typeArgs) => {
				if (o != null) o.useType = display.methodUseType(decl, receiver, e.expr.exactType, member);
			}
			_ => ;
		}
	}
	def visitRange(e: RangeExpr, env: void) {
		expr(e.expr);
		expr(e.start);
		expr(e.end);
	}
	def visitNot(e: NotExpr, env: void) {
		expr(e.expr);
	}
	def visitNeg(e: NegExpr, env: void) {
		expr(e.expr);
	}
	def visitBitwiseNeg(e: BitwiseNegExpr, env: void) {
		expr(e.expr);
	}
	def visitAssign(e: AssignExpr, env: void) {
		assigned(e.target);
		expr(e.expr);
	}
	// AssignExpr covers = and compound operators; AutoExpr covers both
	// prefix and postfix ++/--. Nested assignments restore the outer target.
	private def assigned(target: Expr) {
		var outer = writeTarget;
		writeTarget = target;
		expr(target);
		writeTarget = outer;
	}
	def visitBinOp(e: BinOpExpr, env: void) {
		expr(e.left);
		expr(e.right);
	}
	def visitIfExpr(e: IfExpr, env: void) {
		exprs(e.exprs);
	}
	def visitFunExpr(e: FunExpr, env: void) {
		var outer = captures;
		for (l = e.captures; l != null; l = l.tail) captures = List.new(l.head, captures);
		func(e.func);
		stmt(e.func.body);
		captures = outer;
	}

	// Follows a verifier binding to the declaration it names, if that
	// declaration comes from program source.
	private def declarationOf(b: VarBinding) -> AnalysisDeclaration {
		match (b) {
			Local(decl) => {
				// Captured locals are represented by synthetic parameters. Follow
				// their outer bindings, including captures through nested lambdas.
				for (l = captures; l != null; l = l.tail) {
					if (l.head.0 == decl) return declarationOf(l.head.1);
				}
				// `this` is a synthetic receiver parameter whose token comes from
				// the class or constructor. Only the enclosing class is a target.
				if (decl == thisParam) return make(AnalysisDeclKind.CLASS, thisClass);
				return make(if(ParamDecl.?(decl), AnalysisDeclKind.PARAMETER, AnalysisDeclKind.LOCAL), decl);
			}
			ObjectField(receiver, member) => return make(AnalysisDeclKind.FIELD, member);
			ComponentField(member) => return make(AnalysisDeclKind.FIELD, member);
			ClassField(receiver, member) => return make(AnalysisDeclKind.FIELD, member);
			VariantField(receiver, member) => return make(AnalysisDeclKind.FIELD, member);
			ObjectMethod(receiver, member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			ClassMethod(receiver, member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			ComponentMethod(member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			ClassNew(receiver, member, funcType) => return constructorDeclaration(member);
			VariantCase(receiver, member) => return make(AnalysisDeclKind.VARIANT_CASE, member);
			EnumConst(member) => return make(AnalysisDeclKind.ENUM_CASE, member);
			Inst(op, facts) => return operatorDeclaration(op);
			Apply(op, facts) => return operatorDeclaration(op);
			Type(t) => return typeDeclaration(t);
			LayoutDecl(decl) => return make(AnalysisDeclKind.LAYOUT, decl);
			LayoutFieldDecl(decl) => return make(AnalysisDeclKind.LAYOUT_FIELD, decl);
			RefLayoutField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutRepeatedField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutRepeatedNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			RefLayoutRepeatedField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			RefLayoutNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			RefLayoutRepeatedNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			_ => return null; // bindings without a source declaration
		}
	}
	private def operatorDeclaration(op: Operator) -> AnalysisDeclaration {
		match (op.opcode) {
			VstSugar(sugar) => match (sugar) {
				EnumGetParam(field) => return make(AnalysisDeclKind.FIELD, field);
				// Construction of a class with a descriptor (-lang:descriptors).
				ClassNewDesc => {
					var t = op.typeArgs[0];
					return if(ClassType.?(t), constructorDeclaration(ClassType.!(t).classDecl.constructor));
				}
				_ => return null;
			}
			_ => return null;
		}
	}
	// The default constructor is the class's own name.
	private def constructorDeclaration(member: VstNew) -> AnalysisDeclaration {
		if (member == null) return null;
		if (member.isSynthetic) return make(AnalysisDeclKind.CLASS, member.receiver);
		return make(AnalysisDeclKind.CONSTRUCTOR, member);
	}
	// The method that an index operation calls, if the program declares it.
	private def indexDeclaration(b: AppBinding) -> AnalysisDeclaration {
		match (b) {
			CallObjectMethod(receiver, member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			_ => return null;
		}
	}
	private def isTypeName(kind: AnalysisDeclKind) -> bool {
		return kind == AnalysisDeclKind.CLASS || kind == AnalysisDeclKind.ENUM
			|| kind == AnalysisDeclKind.TYPE_PARAM || kind == AnalysisDeclKind.LAYOUT;
	}
	// No recursive descent into structural types: Array<Foo> is not Foo.
	// Follow solved inference variables only, never names or display text.
	private def resolvedSourceType(t: Type) -> int {
		for (i = 0; TypeVarType.?(t) && i < 1024; i++) {
			var next = TypeVarType.!(t).vtype;
			if (next == t) return 0;
			t = next;
		}
		if (!(RefType.?(t) || ClassType.?(t) || EnumType.?(t) || TypeParamType.?(t))) return 0;
		var i = display.nominalTypeIndex(t.typeCon), cached = display.nominalCode(i);
		if (cached >= 0) return cached;
		var target = sourceCode(if(RefType.?(t), make(AnalysisDeclKind.LAYOUT, RefType.!(t).layoutDecl), typeDeclaration(t)));
		display.rememberNominal(target);
		return target;
	}
	private def declarationSource(decl: AnalysisDeclaration) -> int {
		if (decl.sourceType < 0) {
			var d = AnalysisWorkerDeclaration.!(decl);
			d.sourceType = if(isTypeName(d.kind), sourceCode(d), resolvedSourceType(d.ownType));
		}
		return decl.sourceType;
	}
	private def sourceCode(target: AnalysisDeclaration) -> int {
		return display.sourceCode(target);
	}
	private def typeDeclaration(t: Type) -> AnalysisDeclaration {
		// Verification errors can leave a Type binding with no resolved type.
		if (t == null) return null;
		match (t) {
			x: ClassType => {
				// A variant case's type is a synthetic class; the source declares the case.
				var decl = x.classDecl;
				if (decl != null && decl.isSynthetic && decl.variantCase != null) return make(AnalysisDeclKind.VARIANT_CASE, decl.variantCase);
				return make(AnalysisDeclKind.CLASS, decl);
			}
			x: EnumType => return make(AnalysisDeclKind.ENUM, x.enumDecl);
			// Ref<L> names the builtin Ref; see layoutArgument.
			x: RefType => return null;
			// Builtin type parameters have no source token; inferred type
			// variables are TypeVarTypes.
			x: TypeParamType => return declare(AnalysisDeclKind.TYPE_PARAM, x.token, x);
		}
		if (V3Component_TypeCon.?(t.typeCon)) {
			return make(AnalysisDeclKind.COMPONENT, V3Component_TypeCon.!(t.typeCon).componentDecl);
		}
		return null;
	}
	private def make(kind: AnalysisDeclKind, decl: Decl) -> AnalysisDeclaration {
		return if(decl != null, display.declaration(kind, decl.token, decl, null));
	}
	// A declaration that is not a Decl: a type parameter of type {t}. Null if
	// the compiler synthesized it.
	private def declare(kind: AnalysisDeclKind, token: Token, t: Type) -> AnalysisDeclaration {
		return display.declaration(kind, token, null, t);
	}
}

// The ends of last arguments that OccurrenceCollector.endOf found before the
// walk reached their calls, each with its call, which reads it rather than
// finding it again: in f(f(f(1))), each call would otherwise read the calls
// inside it again, in time quadratic in the depth. Ends are kept in
// regions: each call that finds ends in its arguments adds them as a
// region, in the walk's order, and the walk reaches the rest of the region
// below only after the calls of the region above. A call reads only the
// next end of the top region, so that keeping and reading take constant
// time, and finds its end itself if that is not its own. A program's files
// share one, which each file's collection leaves empty.
class AnalysisCallEnds {
	private def calls = Vector<AppExpr>.new();
	private def ends = Vector<int>.new();
	// Two ints a region: its start and its next end to read.
	private def regions = Vector<int>.new();

	def length() -> int {
		return calls.length;
	}
	// Keeps a slot for the end of {e}'s last argument and returns it.
	def reserve(e: AppExpr) -> int {
		calls.put(e);
		ends.put(-1);
		return ends.length - 1;
	}
	def fill(slot: int, end: int) {
		ends[slot] = end;
	}
	// Makes the ends kept since {start} a region, if there are any.
	def region(start: int) {
		if (calls.length > start) regions.put(start).put(start);
	}
	// The end of {e}'s last argument, if it is the next one to read, or -1.
	// Reading a region's last end removes the region.
	def read(e: AppExpr) -> int {
		var r = regions.length - 2;
		if (r < 0) return -1;
		var next = regions[r + 1];
		if (calls[next] != e) return -1;
		var end = ends[next];
		if (next + 1 < calls.length) {
			regions[r + 1] = next + 1;
		} else {
			calls.length = regions[r];
			ends.length = regions[r];
			regions.length = r;
		}
		return end;
	}
	def clear() {
		calls.length = 0;
		ends.length = 0;
		regions.length = 0;
	}
}

// A program's packings, as verification left them, for collecting their
// uses. It keeps no binding in a packing expression; see
// OccurrenceCollector.packingExpr. Retains no Program.
class AnalysisPackings {
	// Verification resolves a packing application by name here, where a
	// later packing of the same name replaces an earlier one.
	private var byName: HashMap<string, VstPacking>;
	// The packings that verification reached although their bit width is 0.
	private var unsized: List<VstPacking>;

	new(prog: Program) {
		byName = prog.packings;
		for (i < prog.vst.packings.length) {
			var p = prog.vst.packings[i];
			if (p.bitWidth == 0 && p.size != null && reportedSize(prog.ERROR.errors, p.size.token)) unsized = List.new(p, unsized);
		}
	}
	def named(name: string) -> VstPacking {
		return if(byName != null, byName[name]);
	}
	// Whether verification reached {p}; it stops before later declarations at
	// the error limit. Only Verifier.verifyPacking sets the bit width, which
	// is the declared size as a byte. A size from 1 to 64 makes it nonzero;
	// any other size, including one that truncates to 0, is reported at the
	// size literal, where nothing else reports an error. Exact for each
	// indexed file: errors name a file by path, so copies of a repeated path
	// share coordinates, and a skipped copy can match another's error. Only
	// the first copy of a path is indexed (see ProgramAnalysis).
	def verified(p: VstPacking) -> bool {
		if (p.bitWidth != 0) return true;
		for (l = unsized; l != null; l = l.tail) if (l.head == p) return true;
		return false;
	}
	private def reportedSize(errors: List<Error>, t: Token) -> bool {
		for (l = errors; l != null; l = l.tail) {
			var r = l.head.range;
			if (r != null && r.beginLine == t.beginLine && r.beginColumn == t.beginColumn
					&& Strings.equal(r.fileName, t.fileName) && Strings.equal(l.head.error, "PackingDeclError")) return true;
		}
		return false;
	}
}

// Whether a program declares anything named "void" or "Pointer", in any
// file and of any kind, for OccurrenceCollector.call, which asks only of an
// application that verification left unbound. The first question walks
// every file's syntax tree once; the parser built it whole, including the
// bodies and declarations that verification never reached.
class AnalysisDeclaredNames(files: Array<VstFile>) extends VstVisitor<void, void> {
	private var scanned: bool;
	private var hasVoid: bool;
	private var hasPointer: bool;
	def var visited: int;

	def declaresVoid() -> bool {
		scan();
		return hasVoid;
	}
	def declaresPointer() -> bool {
		scan();
		return hasPointer;
	}
	private def scan() {
		if (scanned) return;
		scanned = true;
		if (files == null) return;
		for (f in files) {
			if (f == null) continue;
			for (i < f.components.length) compound(f.components[i]);
			for (i < f.classes.length) compound(f.classes[i]);
			for (i < f.enums.length) compound(f.enums[i]);
			for (i < f.layouts.length) compound(f.layouts[i]);
			for (i < f.packings.length) compound(f.packings[i]);
			for (i < f.exports.length) name(f.exports[i].token);
		}
	}
	private def name(t: Token) {
		if (t == null) return;
		visited++;
		if (Strings.equal(t.image, "void")) hasVoid = true;
		else if (Strings.equal(t.image, "Pointer")) hasPointer = true;
	}
	private def compound(c: VstCompound) {
		name(c.token);
		if (!c.isSynthetic) typeParams(c.typeParams);
		params(c.params);
		if (c.superclause != null) expr(c.superclause.args);
		if (VstPacking.?(c)) {
			var pparams = VstPacking.!(c).pparams;
			if (pparams != null) for (l = pparams.list; l != null; l = l.tail) name(l.head.token);
		}
		for (l = c.members; l != null; l = l.tail) {
			name(l.head.token);
			match (l.head) {
				x: VstNew => {
					if (x.superclause != null && x.superclause != c.superclause) expr(x.superclause.args);
					if (!x.isSynthetic && x.func.params != c.params) params(x.func.params);
					stmt(x.func.body);
				}
				x: VstMethod => {
					if (x.isSynthetic) continue;
					typeParams(x.typeParams);
					func(x.func);
				}
				x: VstField => expr(x.init);
				x: VstEnumCase => exprs(x.args);
				_ => ;
			}
		}
	}
	private def typeParams(list: List<TypeParamType>) {
		for (l = list; l != null; l = l.tail) name(l.head.token);
	}
	private def params(list: VstList<ParamDecl>) {
		if (list != null) for (l = list.list; l != null; l = l.tail) name(l.head.token);
	}
	private def func(f: VstFunc) {
		params(f.params);
		stmt(f.body);
	}
	private def varDecl(v: VarDecl) {
		if (v == null) return;
		name(v.token);
		expr(v.init);
	}
	private def stmt(s: Stmt) {
		if (s != null) {
			visited++;
			s.accept(this, ());
		}
	}
	private def expr(e: Expr) {
		if (e != null) {
			visited++;
			e.accept(this, ());
		}
	}
	private def exprs(list: VstList<Expr>) {
		if (list != null) for (l = list.list; l != null; l = l.tail) expr(l.head);
	}

	def visitIf(s: IfStmt, env: void) {
		expr(s.cond);
		stmt(s.tbranch);
		stmt(s.fbranch);
	}
	def visitBlock(s: BlockStmt, env: void) {
		for (l = s.stmts.list; l != null; l = l.tail) stmt(l.head);
	}
	def visitWhile(s: WhileStmt, env: void) {
		expr(s.cond);
		stmt(s.body);
	}
	def visitFor(s: ForStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.cond);
		expr(s.update);
		stmt(s.body);
	}
	def visitForeach(s: ForeachStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitForLess(s: ForLessStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitLocal(s: LocalStmt, env: void) {
		for (l = s.vars; l != null; l = l.tail) varDecl(l.head);
	}
	def visitBreak(s: BreakStmt, env: void) { }
	def visitContinue(s: ContinueStmt, env: void) { }
	def visitExpr(s: ExprStmt, env: void) {
		expr(s.expr);
	}
	def visitMatch(s: MatchStmt, env: void) {
		expr(s.expr);
		for (l = s.cases.list; l != null; l = l.tail) {
			var c = l.head;
			for (p = c.patterns.list; p != null; p = p.tail) {
				var pat = p.head;
				expr(pat.expr);
				if (pat.params != null) for (v = pat.params.list; v != null; v = v.tail) varDecl(v.head);
				varDecl(pat.vdecl);
			}
			stmt(c.stmt);
		}
	}
	def visitEmpty(s: EmptyStmt, env: void) { }
	def visitReturn(s: ReturnStmt, env: void) {
		expr(s.expr);
	}

	def visitTuple(e: TupleExpr, env: void) {
		exprs(e.exprs);
	}
	def visitParamExpr(e: ParamExpr, env: void) { }
	def visitAutoExpr(e: AutoExpr, env: void) {
		expr(e.expr);
	}
	def visitArray(e: ArrayExpr, env: void) {
		exprs(e.exprs);
	}
	def visitVar(e: VarExpr, env: void) {
		expr(e.expr);
	}
	def visitLiteral(e: Literal, env: void) { }
	def visitString(e: StringExpr, env: void) { }
	def visitApp(e: AppExpr, env: void) {
		expr(e.func);
		expr(e.args);
	}
	def visitIndex(e: IndexExpr, env: void) {
		expr(e.expr);
		exprs(e.exprs);
	}
	def visitRange(e: RangeExpr, env: void) {
		expr(e.expr);
		expr(e.start);
		expr(e.end);
	}
	def visitNot(e: NotExpr, env: void) {
		expr(e.expr);
	}
	def visitNeg(e: NegExpr, env: void) {
		expr(e.expr);
	}
	def visitBitwiseNeg(e: BitwiseNegExpr, env: void) {
		expr(e.expr);
	}
	def visitAssign(e: AssignExpr, env: void) {
		expr(e.target);
		expr(e.expr);
	}
	def visitBinOp(e: BinOpExpr, env: void) {
		expr(e.left);
		expr(e.right);
	}
	def visitIfExpr(e: IfExpr, env: void) {
		exprs(e.exprs);
	}
	def visitFunExpr(e: FunExpr, env: void) {
		name(e.name);
		func(e.func);
	}
}
