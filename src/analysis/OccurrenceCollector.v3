// The occurrence-index contract is documented in
// docs/architecture.md#compiler-adapter, and display data in
// docs/architecture.md#display-text.
// {packings} is the program's packings, or null if it was not verified.
class OccurrenceCollector(sources: AnalysisSourceMaps, display: AnalysisDisplay,
		packings: AnalysisPackings) extends VstVisitor<void, void> {
	private def result = Vector<AnalysisOccurrence>.new();
	private def builtinUses = Vector<AnalysisBuiltinUse>.new();
	// Declaration sites in the order the walk finds them, which breaks ties.
	private def siteList = Vector<AnalysisDeclaration>.new();
	private var fileName: string;
	private var captures: List<(ParamDecl, VarBinding.Local)>;
	private var thisParam: ParamDecl;
	private var thisClass: VstClass;
	// Uses skipped because they are not token spans (see record).
	def var skipped: int;
	// After collect: the uses that resolved to no source declaration but
	// have a type, and the declarations named in the file, each in source order.
	def var builtins: Array<AnalysisBuiltinUse>;
	def var sites: Array<AnalysisDeclaration>;

	def collect(file: VstFile) -> Array<AnalysisOccurrence> {
		fileName = file.fileName;
		for (i < file.components.length) visitCompound(file.components[i]);
		for (i < file.classes.length) visitCompound(file.classes[i]);
		for (i < file.enums.length) visitCompound(file.enums[i]);
		for (i < file.layouts.length) visitLayout(file.layouts[i]);
		for (i < file.packings.length) visitPacking(file.packings[i]);
		for (i < file.exports.length) {
			var e = file.exports[i].expr;
			var inline = false;
			for (l = file.exports[i].synthetic.members; l != null; l = l.tail) {
				if (e.ident.name == l.head.token) {
					inline = true;
					break;
				}
			}
			if (!inline) expr(e);
		}
		builtins = AnalysisTables.sort(builtinUses.extract(), builtinBefore);
		sites = sortSites(siteList.extract());
		return AnalysisTables.sort(result.extract(), before);
	}
	// Source order is byte order. Compiler coordinates follow it, except that
	// a retrospective token's context-free column can pass a later token's.
	private def before(a: AnalysisOccurrence, b: AnalysisOccurrence) -> bool {
		return rangeBefore(a.range, b.range);
	}
	private def builtinBefore(a: AnalysisBuiltinUse, b: AnalysisBuiltinUse) -> bool {
		return rangeBefore(a.range, b.range);
	}
	private def rangeBefore(x: AnalysisRange, y: AnalysisRange) -> bool {
		if (x.beginOffset != y.beginOffset) return x.beginOffset < y.beginOffset;
		return x.beginLine < y.beginLine || (x.beginLine == y.beginLine && x.beginColumn < y.beginColumn);
	}
	// Sorts declaration sites by byte offset and keeps the first found of
	// any that overlap. A token names two declarations only where
	// verification shares it, as a variant with parameters shares its name
	// with its single case; the walk finds the declaration a reader means first.
	private def sortSites(list: Array<AnalysisDeclaration>) -> Array<AnalysisDeclaration> {
		list = AnalysisTables.sort(list, siteBefore);
		var count = 0, end = 0;
		for (i < list.length) {
			var r = list[i].range;
			if (count > 0 && r.beginOffset < end) continue;
			list[count++] = list[i];
			end = r.endOffset;
		}
		return if(count == list.length, list, Arrays.range(list, 0, count));
	}
	private def siteBefore(a: AnalysisDeclaration, b: AnalysisDeclaration) -> bool {
		return a.range.beginOffset < b.range.beginOffset;
	}
	// Records {decl} as declared in this file, if the source spells its name
	// there: an index method's name "[]" or "[]=" selects its opening bracket
	// (see AnalysisSourceMaps.range). A declaration whose name the compiler
	// manufactured elsewhere has no site.
	private def site(decl: AnalysisDeclaration) {
		if (decl == null) return;
		var r = decl.range;
		if (!Strings.equal(r.path, fileName) || r.beginOffset < 0 || r.endOffset <= r.beginOffset) return;
		var bracket = decl.name.length > 0 && decl.name[0] == '[' && r.endOffset - r.beginOffset == 1;
		if (!bracket && !r.isTokenSpan()) return;
		siteList.put(decl);
	}
	private def siteVar(v: VarDecl) {
		// Verification appends synthetic capture parameters to lambda params.
		// Their tokens are uses in the body, not source declarations.
		for (l = captures; l != null; l = l.tail) if (l.head.0 == v) return;
		// "_" declares nothing a use can name.
		if (v != null && !v.isUnderscore()) site(make(if(ParamDecl.?(v), AnalysisDeclKind.PARAMETER, AnalysisDeclKind.LOCAL), v));
	}
	private def siteTypeParams(list: List<TypeParamType>) {
		for (l = list; l != null; l = l.tail) site(declare(AnalysisDeclKind.TYPE_PARAM, l.head.token, l.head));
	}
	// A compound's own parameters are its fields.
	private def siteFields(list: VstList<ParamDecl>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) {
			var p = l.head;
			site(if(p.member != null, make(AnalysisDeclKind.FIELD, p.member), make(AnalysisDeclKind.PARAMETER, p)));
		}
	}
	private def visitLayout(decl: VstLayout) {
		site(make(AnalysisDeclKind.LAYOUT, decl));
		for (l = decl.members; l != null; l = l.tail) {
			if (!VstLayoutField.?(l.head)) continue;
			var f = VstLayoutField.!(l.head);
			site(make(AnalysisDeclKind.LAYOUT_FIELD, f));
			memoryType(f.mtref);
		}
	}
	// A layout field's memory type is a name with no type reference of its
	// own. Verification keeps the reference type of a nested layout, which
	// it looked up by that name, or else the type it resolved the name to.
	private def memoryType(mt: MemoryTypeRef) {
		if (mt == null || mt.tname == null) return;
		if (mt.mtlayout != null) record(mt.tname.name, make(AnalysisDeclKind.LAYOUT, mt.mtlayout.layoutDecl), null);
		else record(mt.tname.name, typeDeclaration(mt.mttype), mt.mttype);
	}
	// A packing and its parameters are its own declarations; see packingExpr.
	private def visitPacking(decl: VstPacking) {
		site(make(AnalysisDeclKind.PACKING, decl));
		if (decl.pparams != null) for (l = decl.pparams.list; l != null; l = l.tail) site(make(AnalysisDeclKind.PARAMETER, l.head));
		if (packings != null && packings.verified(decl)) packingExpr(decl, decl.expr);
	}
	// Verification looks up a field of a packing expression among the
	// packing's parameters alone, where a later parameter hides an earlier
	// one of the same name, and a packing application's name among the
	// program's packings, where a later packing replaces an earlier one; it
	// keeps neither binding. Both lookups ignore type arguments, as in
	// P<int>(b), which name nothing. It checks an application's arguments
	// only if they are as many as the packing's parameters. A bit pattern is
	// one literal token whose letters select parameters by their initials;
	// it names none of them.
	private def packingExpr(decl: VstPacking, e: VstPackingExpr) {
		match (e) {
			Solve(list) => packingExprs(decl, list);
			Concat(list) => packingExprs(decl, list);
			App(p, args) => {
				var target = packings.named(p.ident.name.image);
				if (target == null) return;
				record(p.ident.name, make(AnalysisDeclKind.PACKING, target), null);
				var arity = if(target.pparams != null, target.pparams.length());
				if (args != null && args.length() == arity) packingExprs(decl, args);
			}
			Field(f) => {
				var name = f.ident.name, param: PackingParamDecl;
				for (l = if(decl.pparams != null, decl.pparams.list); l != null; l = l.tail) {
					if (Strings.equal(l.head.token.image, name.image)) param = l.head;
				}
				record(name, make(AnalysisDeclKind.PARAMETER, param), null);
			}
			_ => ;
		}
	}
	private def packingExprs(decl: VstPacking, list: VstList<VstPackingExpr>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) packingExpr(decl, l.head);
	}
	private def visitCompound(decl: VstCompound) {
		// Verification clears compound.verifier; functions retain the receiver.
		thisParam = if(decl.constructor != null, decl.constructor.func.thisParam);
		thisClass = if(VstClass.?(decl), VstClass.!(decl));
		// A variant case's class shares its token with the case member, and
		// its type parameters with the variant.
		if (!decl.isSynthetic && !decl.isFileScope) {
			match (decl) {
				x: VstComponent => site(make(AnalysisDeclKind.COMPONENT, x));
				x: VstEnum => site(make(AnalysisDeclKind.ENUM, x));
				x: VstClass => site(make(AnalysisDeclKind.CLASS, x));
			}
			siteTypeParams(decl.typeParams);
		}
		siteFields(decl.params);
		// Verification shares class parameters with their synthesized fields
		// and with the constructor, so only this walk visits their types.
		params(decl.params);
		if (thisClass != null) {
			// A variant case's superclass is synthesized from the variant's own
			// name and type parameter tokens; it is not a use.
			if (!thisClass.isSynthetic || thisClass.variantCase == null) superclass(thisClass.superclass);
			var info = thisClass.descriptorInfo;
			if (info != null) {
				typeRef(info.descriptorTypeRef);
				typeRef(info.describesTypeRef);
			}
		}
		if (decl.superclause != null) expr(decl.superclause.args);
		for (l = decl.members; l != null; l = l.tail) {
			match (l.head) {
				x: VstNew => {
					thisParam = x.func.thisParam;
					if (!x.isSynthetic) site(make(AnalysisDeclKind.CONSTRUCTOR, x));
					if (!x.isSynthetic && x.func.params != decl.params) {
						if (x.func.params != null) for (p = x.func.params.list; p != null; p = p.tail) siteVar(p.head);
						params(x.func.params);
					}
					// Verification shares the class clause with its constructor.
					// Only a constructor-local clause needs a second walk.
					if (x.superclause != null && x.superclause != decl.superclause) expr(x.superclause.args);
					stmt(x.func.body);
				}
				// Traverse lambda bodies through FunExpr so their capture mapping
				// is active, rather than through synthetic method wrappers.
				x: VstMethod => {
					if (x.isSynthetic) continue;
					thisParam = x.func.thisParam;
					site(make(AnalysisDeclKind.METHOD, x));
					siteTypeParams(x.typeParams);
					func(x.func);
					stmt(x.func.body);
				}
				x: VstField => {
					if (!x.isSynthetic) {
						site(make(AnalysisDeclKind.FIELD, x));
						typeRef(x.tref);
					}
					expr(x.init);
				}
				x: VstEnumCase => {
					site(make(AnalysisDeclKind.ENUM_CASE, x));
					exprs(x.args);
				}
				x: VstCaseMember => site(make(AnalysisDeclKind.VARIANT_CASE, x));
			}
		}
	}
	private def stmt(s: Stmt) {
		if (s != null) s.accept(this, ());
	}
	private def expr(e: Expr) {
		if (e != null) e.accept(this, ());
	}
	private def exprs(list: VstList<Expr>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) expr(l.head);
	}
	private def varDecl(v: VarDecl) {
		if (v == null) return;
		siteVar(v);
		typeRef(v.tref);
		expr(v.init);
	}
	private def params(list: VstList<ParamDecl>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) typeRef(l.head.tref);
	}
	private def func(f: VstFunc) {
		if (f.params != null) for (l = f.params.list; l != null; l = l.tail) siteVar(l.head);
		params(f.params);
		match (f.rettype) {
			Explicit(tref) => typeRef(tref);
			_ => ;
		}
	}
	// A variant that extends another (-lang:open-types) extends its default
	// case: verification rebinds the reference to the case's synthetic class.
	// The source names the variant that declares the case. An explicit case,
	// such as V.A, has a left part and keeps its target.
	private def superclass(tref: TypeRef) {
		if (NamedTypeRef.?(tref) && ClassType.?(tref.binding)) {
			var x = NamedTypeRef.!(tref), c = ClassType.!(tref.binding).classDecl.variantCase;
			if (x.left == null && c != null && c.decl.isSynthetic && c.isDefaultCase()) {
				typeRefs(x.nested);
				var o = record(x.name, make(AnalysisDeclKind.CLASS, c.receiver), null);
				if (o != null) o.useType = display.superclassUseType(o.declaration, tref);
				return;
			}
		}
		typeRef(tref);
	}
	private def typeRefs(list: VstList<TypeRef>) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) typeRef(l.head);
	}
	// Records the names in a type reference that verification resolved.
	// Function and tuple types nest them.
	private def typeRef(tref: TypeRef) {
		if (tref == null) return;
		match (tref) {
			x: NamedTypeRef => {
				typeRef(x.left);
				if (RefType.?(x.binding)) layoutArgument(RefType.!(x.binding), x.nested);
				else typeRefs(x.nested);
				record(x.name, typeDeclaration(x.binding), x.binding);
			}
			x: FuncTypeRef => {
				typeRef(x.paramType);
				typeRef(x.returnType);
			}
			x: TupleTypeRef => typeRefs(x.nested);
		}
	}
	// Ref<L> binds to the reference type of layout L, which verification
	// looked up by L's name; L itself has no binding. Records L if {args} is
	// exactly that name. Ref is a builtin and records nothing.
	private def layoutArgument(t: RefType, args: VstList<TypeRef>) {
		var arg = if(args != null && args.length() == 1, args.list.head), decl = t.layoutDecl;
		if (NamedTypeRef.?(arg) && decl != null) {
			var x = NamedTypeRef.!(arg);
			if (x.left == null && x.nested == null && Strings.equal(x.name.image, decl.token.image)) {
				record(x.name, make(AnalysisDeclKind.LAYOUT, decl), null);
				return;
			}
		}
		typeRefs(args);
	}

	def visitIf(s: IfStmt, env: void) {
		expr(s.cond);
		stmt(s.tbranch);
		stmt(s.fbranch);
	}
	def visitBlock(s: BlockStmt, env: void) {
		for (l = s.stmts.list; l != null; l = l.tail) stmt(l.head);
	}
	def visitWhile(s: WhileStmt, env: void) {
		expr(s.cond);
		stmt(s.body);
	}
	def visitFor(s: ForStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.cond);
		expr(s.update);
		stmt(s.body);
	}
	def visitForeach(s: ForeachStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitForLess(s: ForLessStmt, env: void) {
		varDecl(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitLocal(s: LocalStmt, env: void) {
		for (l = s.vars; l != null; l = l.tail) varDecl(l.head);
	}
	def visitBreak(s: BreakStmt, env: void) { }
	def visitContinue(s: ContinueStmt, env: void) { }
	def visitExpr(s: ExprStmt, env: void) {
		expr(s.expr);
	}
	def visitMatch(s: MatchStmt, env: void) {
		expr(s.expr);
		// defcase aliases a case in this list; it is not another subtree.
		for (l = s.cases.list; l != null; l = l.tail) matchCase(l.head, s.expr.exactType);
	}
	private def matchCase(c: MatchCase, matchType: Type) {
		for (l = c.patterns.list; l != null; l = l.tail) {
			var pat = l.head;
			expr(pat.expr);
			if (pat.params != null) for (p = pat.params.list; p != null; p = p.tail) siteVar(p.head);
			if (pat.vdecl != null) {
				siteVar(pat.vdecl);
				typeRef(pat.vdecl.tref);
			}
			if (!VarExpr.?(pat.expr)) continue;
			var ve = VarExpr.!(pat.expr);
			// Qualified cases already have bindings. Unqualified case names
			// bypass ordinary name resolution in the verifier.
			if (ve.expr != null || ve.varbind.ok()) continue;
			if (pat.variantCase != null) {
				record(ve.ident.name, make(AnalysisDeclKind.VARIANT_CASE, pat.variantCase), null);
			} else if (pat.val != null && EnumType.?(matchType)) {
				// Enum patterns retain only their resolved case value; look up
				// the declaration in the verified scrutinee's enum.
				var member = EnumType.!(matchType).lookupCase(ve.ident.name.image);
				record(ve.ident.name, make(AnalysisDeclKind.ENUM_CASE, member), null);
			}
		}
		stmt(c.stmt);
	}
	def visitEmpty(s: EmptyStmt, env: void) { }
	def visitReturn(s: ReturnStmt, env: void) {
		expr(s.expr);
	}

	def visitTuple(e: TupleExpr, env: void) {
		exprs(e.exprs);
	}
	def visitParamExpr(e: ParamExpr, env: void) { }
	def visitAutoExpr(e: AutoExpr, env: void) {
		expr(e.expr);
	}
	def visitArray(e: ArrayExpr, env: void) {
		exprs(e.exprs);
	}
	def visitVar(e: VarExpr, env: void) {
		expr(e.expr);
		match (e.varbind) {
			Type(t) => if (RefType.?(t)) layoutArgument(RefType.!(t), e.ident.params); else typeRefs(e.ident.params);
			_ => typeRefs(e.ident.params);
		}
		var decl = declarationOf(e.varbind);
		// A literal enum argument folds E.Case.param to Const, losing the
		// field in the binding. Require an EnumConst receiver: E.count is a
		// built-in even when the enum has a parameter named count.
		if (decl == null && VarBinding.Const.?(e.varbind) && VarExpr.?(e.expr)
				&& VarBinding.EnumConst.?(VarExpr.!(e.expr).varbind) && EnumType.?(e.expr.exactType)) {
			var et = EnumType.!(e.expr.exactType);
			var member = et.enumDecl.memberMap[e.ident.name.image];
			if (VstField.?(member)) decl = make(AnalysisDeclKind.FIELD, member);
		}
		if (decl != null) record(e.ident.name, decl, e.exactType);
		else builtin(e.ident.name, e.varbind, e.exactType);
	}
	// Every use is recorded here, with the text of its type {t} if that
	// differs from its declaration's. A use must be a token span (see
	// AnalysisRange.isTokenSpan). Parser tokens always are; a name the compiler
	// manufactured where the source doesn't spell it would not be, and is
	// skipped, since neither its compiler span nor its byte span would locate it.
	// Returns the occurrence, or null if nothing was recorded.
	private def record(token: Token, decl: AnalysisDeclaration, t: Type) -> AnalysisOccurrence {
		if (decl == null || token.beginLine <= 0 || !Strings.equal(token.fileName, fileName)) return null;
		var range = sources.range(token);
		if (!range.isTokenSpan()) {
			skipped++;
			return null;
		}
		var o = AnalysisOccurrence.new(range, decl);
		if (t != null) o.useType = display.useType(decl, t);
		result.put(o);
		return o;
	}
	// A resolved use with no source declaration, such as ".length" or
	// "int.max", has only its type, which it keeps if that is known.
	private def builtin(token: Token, b: VarBinding, t: Type) {
		if (!b.ok() || b == VarBinding.Void || token.beginLine <= 0 || !Strings.equal(token.fileName, fileName)) return;
		var text = display.typeText(t);
		if (text == null) return;
		var range = sources.range(token);
		if (range.isTokenSpan()) builtinUses.put(AnalysisBuiltinUse.new(range, text));
		else skipped++;
	}
	def visitLiteral(e: Literal, env: void) { }
	def visitString(e: StringExpr, env: void) { }
	def visitApp(e: AppExpr, env: void) {
		expr(e.func);
		expr(e.args);
	}
	def visitIndex(e: IndexExpr, env: void) {
		expr(e.expr);
		exprs(e.exprs);
		// An index operation occupies its opening bracket, where an index
		// method is declared. A compound assignment such as c[i] += v reads
		// and writes through the one bracket; it records the write, since the
		// expression is the assignment's target. Builtin indexing binds no
		// method and records nothing.
		var b = e.write, decl = indexDeclaration(b);
		if (decl == null) {
			b = e.read;
			decl = indexDeclaration(b);
		}
		var src = e.exprs.src;
		if (decl == null || src == null) return;
		var o = record(Token.new(src.fileName, "[", src.beginLine, src.beginColumn), decl, null);
		match (b) {
			CallObjectMethod(receiver, member, typeArgs) => {
				if (o != null) o.useType = display.methodUseType(decl, receiver, e.expr.exactType, member);
			}
			_ => ;
		}
	}
	def visitRange(e: RangeExpr, env: void) {
		expr(e.expr);
		expr(e.start);
		expr(e.end);
	}
	def visitNot(e: NotExpr, env: void) {
		expr(e.expr);
	}
	def visitNeg(e: NegExpr, env: void) {
		expr(e.expr);
	}
	def visitBitwiseNeg(e: BitwiseNegExpr, env: void) {
		expr(e.expr);
	}
	def visitAssign(e: AssignExpr, env: void) {
		expr(e.target);
		expr(e.expr);
	}
	def visitBinOp(e: BinOpExpr, env: void) {
		expr(e.left);
		expr(e.right);
	}
	def visitIfExpr(e: IfExpr, env: void) {
		exprs(e.exprs);
	}
	def visitFunExpr(e: FunExpr, env: void) {
		var outer = captures;
		for (l = e.captures; l != null; l = l.tail) captures = List.new(l.head, captures);
		func(e.func);
		stmt(e.func.body);
		captures = outer;
	}

	// Follows a verifier binding to the declaration it names, if that
	// declaration comes from program source.
	private def declarationOf(b: VarBinding) -> AnalysisDeclaration {
		match (b) {
			Local(decl) => {
				// Captured locals are represented by synthetic parameters. Follow
				// their outer bindings, including captures through nested lambdas.
				for (l = captures; l != null; l = l.tail) {
					if (l.head.0 == decl) return declarationOf(l.head.1);
				}
				// `this` is a synthetic receiver parameter whose token comes from
				// the class or constructor. Only the enclosing class is a target.
				if (decl == thisParam) return make(AnalysisDeclKind.CLASS, thisClass);
				return make(if(ParamDecl.?(decl), AnalysisDeclKind.PARAMETER, AnalysisDeclKind.LOCAL), decl);
			}
			ObjectField(receiver, member) => return make(AnalysisDeclKind.FIELD, member);
			ComponentField(member) => return make(AnalysisDeclKind.FIELD, member);
			ClassField(receiver, member) => return make(AnalysisDeclKind.FIELD, member);
			VariantField(receiver, member) => return make(AnalysisDeclKind.FIELD, member);
			ObjectMethod(receiver, member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			ClassMethod(receiver, member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			ComponentMethod(member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			ClassNew(receiver, member, funcType) => return constructorDeclaration(member);
			VariantCase(receiver, member) => return make(AnalysisDeclKind.VARIANT_CASE, member);
			EnumConst(member) => return make(AnalysisDeclKind.ENUM_CASE, member);
			Inst(op, facts) => return operatorDeclaration(op);
			Apply(op, facts) => return operatorDeclaration(op);
			Type(t) => return typeDeclaration(t);
			LayoutDecl(decl) => return make(AnalysisDeclKind.LAYOUT, decl);
			LayoutFieldDecl(decl) => return make(AnalysisDeclKind.LAYOUT_FIELD, decl);
			RefLayoutField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutRepeatedField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			LayoutRepeatedNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			RefLayoutRepeatedField(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			RefLayoutNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			RefLayoutRepeatedNested(receiver, member) => return make(AnalysisDeclKind.LAYOUT_FIELD, member);
			_ => return null; // bindings without a source declaration
		}
	}
	private def operatorDeclaration(op: Operator) -> AnalysisDeclaration {
		match (op.opcode) {
			VstSugar(sugar) => match (sugar) {
				EnumGetParam(field) => return make(AnalysisDeclKind.FIELD, field);
				// Construction of a class with a descriptor (-lang:descriptors).
				ClassNewDesc => {
					var t = op.typeArgs[0];
					return if(ClassType.?(t), constructorDeclaration(ClassType.!(t).classDecl.constructor));
				}
				_ => return null;
			}
			_ => return null;
		}
	}
	// The default constructor is the class's own name.
	private def constructorDeclaration(member: VstNew) -> AnalysisDeclaration {
		if (member == null) return null;
		if (member.isSynthetic) return make(AnalysisDeclKind.CLASS, member.receiver);
		return make(AnalysisDeclKind.CONSTRUCTOR, member);
	}
	// The method that an index operation calls, if the program declares it.
	private def indexDeclaration(b: AppBinding) -> AnalysisDeclaration {
		match (b) {
			CallObjectMethod(receiver, member, typeArgs) => return make(AnalysisDeclKind.METHOD, member);
			_ => return null;
		}
	}
	private def typeDeclaration(t: Type) -> AnalysisDeclaration {
		// Verification errors can leave a Type binding with no resolved type.
		if (t == null) return null;
		match (t) {
			x: ClassType => {
				// A variant case's type is a synthetic class; the source declares the case.
				var decl = x.classDecl;
				if (decl != null && decl.isSynthetic && decl.variantCase != null) return make(AnalysisDeclKind.VARIANT_CASE, decl.variantCase);
				return make(AnalysisDeclKind.CLASS, decl);
			}
			x: EnumType => return make(AnalysisDeclKind.ENUM, x.enumDecl);
			// Ref<L> names the builtin Ref; see layoutArgument.
			x: RefType => return null;
			// Builtin type parameters have no source token; inferred type
			// variables are TypeVarTypes.
			x: TypeParamType => return declare(AnalysisDeclKind.TYPE_PARAM, x.token, x);
		}
		if (V3Component_TypeCon.?(t.typeCon)) {
			return make(AnalysisDeclKind.COMPONENT, V3Component_TypeCon.!(t.typeCon).componentDecl);
		}
		return null;
	}
	private def make(kind: AnalysisDeclKind, decl: Decl) -> AnalysisDeclaration {
		return if(decl != null, display.declaration(kind, decl.token, decl, null));
	}
	// A declaration that is not a Decl: a type parameter of type {t}. Null if
	// the compiler synthesized it.
	private def declare(kind: AnalysisDeclKind, token: Token, t: Type) -> AnalysisDeclaration {
		return display.declaration(kind, token, null, t);
	}
}

// A program's packings, as verification left them, for collecting their
// uses. It keeps no binding in a packing expression; see
// OccurrenceCollector.packingExpr. Retains no Program.
class AnalysisPackings {
	// Verification resolves a packing application by name here, where a
	// later packing of the same name replaces an earlier one.
	private var byName: HashMap<string, VstPacking>;
	// The packings that verification reached although their bit width is 0.
	private var unsized: List<VstPacking>;

	new(prog: Program) {
		byName = prog.packings;
		for (i < prog.vst.packings.length) {
			var p = prog.vst.packings[i];
			if (p.bitWidth == 0 && p.size != null && reportedSize(prog.ERROR.errors, p.size.token)) unsized = List.new(p, unsized);
		}
	}
	def named(name: string) -> VstPacking {
		return if(byName != null, byName[name]);
	}
	// Whether verification reached {p}; it stops before later declarations at
	// the error limit. Only Verifier.verifyPacking sets the bit width, which
	// is the declared size as a byte. A size from 1 to 64 makes it nonzero;
	// any other size, including one that truncates to 0, is reported at the
	// size literal, where nothing else reports an error. Exact for each
	// indexed file: errors name a file by path, so copies of a repeated path
	// share coordinates, and a skipped copy can match another's error. Only
	// the first copy of a path is indexed (see ProgramAnalysis).
	def verified(p: VstPacking) -> bool {
		if (p.bitWidth != 0) return true;
		for (l = unsized; l != null; l = l.tail) if (l.head == p) return true;
		return false;
	}
	private def reportedSize(errors: List<Error>, t: Token) -> bool {
		for (l = errors; l != null; l = l.tail) {
			var r = l.head.range;
			if (r != null && r.beginLine == t.beginLine && r.beginColumn == t.beginColumn
					&& Strings.equal(r.fileName, t.fileName) && Strings.equal(l.head.error, "PackingDeclError")) return true;
		}
		return false;
	}
}
