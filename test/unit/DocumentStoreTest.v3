def T = UnitTests.register;
def X = [
	T("DocumentStore:overlay_precedence", test_store_overlay_precedence),
	T("DocumentStore:wsl_overlay_and_disk_fallback", test_store_wsl_overlay_and_disk_fallback),
	T("DocumentStore:versions", test_store_versions),
	T("DocumentStore:duplicate_open", test_store_duplicate_open),
	T("DocumentStore:save", test_store_save),
	T("DocumentStore:opaque_and_invalid", test_store_opaque_and_invalid),
	T("DocumentStore:capacity", test_store_capacity),
	T("DocumentStore:metadata_capacity", test_store_metadata_capacity),
	T("DocumentStore:resize_capacity", test_store_resize_capacity),
	()
];

class DocumentReaderFake {
	var calls: int;
	var bytes: Array<byte> = "disk";
	var path: string;
	def read(path: string) -> Array<byte> {
		calls++;
		this.path = path;
		return bytes;
	}
}

def test_store_overlay_precedence(t: Tester) {
	var disk = DocumentReaderFake.new(), store = DocumentStore.new(disk.read, DocumentLimits.MAX_BYTES);
	var uri = "file:///tmp/a%20b.v3", alias = "FILE://localhost/tmp/a b.v3";
	t.assert_string("disk", store.read(uri));
	t.assert_string("/tmp/a b.v3", disk.path);
	t.assert(store.open(uri, "virgil", 1, "") == null, "open failed");
	t.assert_string("", store.read(alias));
	t.asserti(1, disk.calls);
	t.assert(store.change(alias, 2, "unsaved") == null, "change failed");
	t.assert_string("unsaved", store.read(uri));
	t.asserti(1, disk.calls);
	t.assert(store.close(alias) == null, "close failed");
	t.assert(store.overlay(uri) == null, "close must drop the overlay");
	disk.bytes = "new disk";
	t.assert_string("new disk", store.read(uri));
	t.asserti(2, disk.calls);
	disk.bytes = null;
	t.assert(store.read(uri) == null, "missing file must return null");
	t.asserti(3, disk.calls);
}

def test_store_wsl_overlay_and_disk_fallback(t: Tester) {
	var disk = DocumentReaderFake.new(), store = DocumentStore.new(disk.read, DocumentLimits.MAX_BYTES);
	var uri = "file:///mnt/c/Users/Name/My%20Project/a.v3";
	t.assert_string("disk", store.read(uri));
	t.assert_string("/mnt/c/Users/Name/My Project/a.v3", disk.path);
	t.asserti(1, disk.calls);

	t.assert(store.open(uri, "virgil", 1, "overlay") == null, "open failed");
	disk.bytes = "changed on disk";
	t.assert_string("overlay", store.read(uri));
	t.asserti(1, disk.calls);
	t.assert(store.close(uri) == null, "close failed");
	t.assert_string("changed on disk", store.read(uri));
	t.asserti(2, disk.calls);
}

def test_store_versions(t: Tester) {
	var store = DocumentStore.new(null, DocumentLimits.MAX_BYTES), uri = "file:///a.v3";
	t.assert_string("document is not open", store.change(uri, 1, "x"));
	t.assert(store.open(uri, "virgil", -10, "first") == null, "open failed");
	var snapshot = store.overlay(uri);
	for (version in [-11, -10, -2147483648]) {
		t.assert_string("document version is not newer", store.change(uri, version, "stale"));
		t.asserti(-10, store.overlay(uri).version);
		t.assert_string("first", store.read(uri));
	}
	t.assert(store.change(uri, 8, "new") == null, "versions may skip");
	t.assert_string("document version is not newer", store.change(uri, 7, "out of order"));
	t.asserti(8, store.overlay(uri).version);
	t.asserti(-10, snapshot.version);
	t.assert_string("first", snapshot.text);
	t.assert(store.change(uri, 2147483647, "max") == null, "maximum version must work");
	t.assert_string("document version is not newer", store.change(uri, -2147483648, "wrapped"));
	t.asserti(2147483647, store.overlay(uri).version);
	t.assert_string("max", store.read(uri));
}

def test_store_duplicate_open(t: Tester) {
	var store = DocumentStore.new(null, DocumentLimits.MAX_BYTES), uri = "file:///a%20b.v3", alias = "file:/a b.v3";
	t.assert(store.open(uri, "virgil", 5, "original") == null, "open failed");
	for (version in [4, 5, 99]) {
		t.assert_string("document is already open", store.open(alias, "other", version, "duplicate"));
		t.asserti(5, store.overlay(uri).version);
		t.assert_string("virgil", store.overlay(uri).languageId);
		t.assert_string("original", store.read(uri));
	}
	t.assert(store.close(uri) == null, "close failed");
	t.assert(store.open(alias, "virgil", 1, "reopened") == null, "close resets version sequence");
	t.asserti(1, store.overlay(uri).version);
}

def test_store_save(t: Tester) {
	var store = DocumentStore.new(null, DocumentLimits.MAX_BYTES), uri = "untitled:a";
	t.assert_string("document is not open", store.save(uri));
	t.assert(store.open(uri, "virgil", 3, "text") == null, "open failed");
	var doc = store.overlay(uri);
	t.assert(store.save(uri) == null, "save failed");
	t.assert(store.overlay(uri) == doc, "save must preserve the overlay record");
	t.assert(store.save(uri) == null, "repeated save failed");
	t.assert(store.overlay(uri) == doc, "repeated save must preserve the overlay record");
	t.asserti(3, store.overlay(uri).version);
	t.assert_string("text", store.read(uri));
	t.assert(store.change(uri, 4, "edit") == null, "change failed");
	doc = store.overlay(uri);
	t.assert(store.save(uri) == null, "save after change failed");
	t.assert(store.overlay(uri) == doc, "save after change must preserve the overlay record");
	t.asserti(4, doc.version);
	t.assert_string("edit", store.read(uri));
	t.assert(store.close(uri) == null, "close failed");
	t.assert_string("document is not open", store.close(uri));
	t.assert_string("document is not open", store.save(uri));
}

def test_store_opaque_and_invalid(t: Tester) {
	var disk = DocumentReaderFake.new(), store = DocumentStore.new(disk.read, DocumentLimits.MAX_BYTES);
	t.assert(store.open("untitled:a%20b", "virgil", 0, "virtual") == null, "virtual open failed");
	t.assert_string("virtual", store.read("untitled:a%20b"));
	t.assert(store.read("untitled:a b") == null, "opaque URI spellings must stay distinct");
	t.assert_string("invalid or nonlocal file URI", store.open("file://remote/a", "virgil", 0, "bad"));
	t.assert(store.read("file:///a%00b") == null, "invalid path must not reach reader");
	t.asserti(0, disk.calls);
}

// Tiny injected budgets exercise the real admission logic, not MiB allocations.
def test_store_capacity(t: Tester) {
	var a = "file:///a", alias = "file:/a", b = "untitled:b";
	var capacity = 2 * DocumentLimits.RECORD_BYTES + a.length + b.length + 2 + 8;
	var store = DocumentStore.new(null, capacity);
	t.assert(store.open(a, "v", 1, "12345") == null, "first open failed");
	t.assert(store.open(b, "v", 1, "123") == null, "exact capacity must fit");
	var original = store.overlay(a), other = store.overlay(b);
	t.assert_string(DocumentLimits.EXCEEDED, store.open("untitled:c", "v", 1, ""));
	t.assert(store.overlay("untitled:c") == null, "rejected open must not create an overlay");
	t.assert_string("document is already open", store.open(alias, "v", 9, "long duplicate"));
	t.assert_string("document version is not newer", store.change(alias, 1, "long stale"));
	t.assert_string(DocumentLimits.EXCEEDED, store.change(alias, 2, "123456"));
	t.assert(store.overlay(a) == original, "rejection must preserve text and version");
	t.assert(store.overlay(b) == other, "other accepted documents must remain intact");
	t.assert(store.save(a) == null, "save must not charge again");
	t.assert(store.change(alias, 2, "abcde") == null, "same-size replacement must fit");
	t.assert(store.change(alias, 3, "abc") == null, "shrinking must release capacity");
	t.assert(store.change(b, 2, "12345") == null, "released capacity must be reusable");
	t.assert_string(DocumentLimits.EXCEEDED, store.change(b, 3, "123456"));
	t.assert(store.close(alias) == null, "close failed");
	t.assert_string("document is not open", store.close(alias));
	t.assert(store.open(a, "v", 0, "123") == null, "close must release capacity exactly once");
	t.assert_string(DocumentLimits.EXCEEDED, store.change(a, 1, "1234"));
	t.assert_string("12345", original.text);
}

def test_store_metadata_capacity(t: Tester) {
	var uri = "untitled:é", language = "virgil";
	var capacity = DocumentLimits.RECORD_BYTES + uri.length + language.length;
	var store = DocumentStore.new(null, capacity);
	t.assert_string(DocumentLimits.EXCEEDED, store.open(uri, language, 1, "é"));
	t.assert(store.open(uri, language, 1, "") == null, "metadata at exact capacity must fit");
	t.assert_string(DocumentLimits.EXCEEDED, store.open("untitled:b", "", 1, ""));
	t.assert(store.close(uri) == null, "close failed");
	t.assert_string(DocumentLimits.EXCEEDED, store.open("untitled:éx", language, 1, ""));
	t.assert_string(DocumentLimits.EXCEEDED, store.open(uri, "virgilx", 1, ""));
	t.assert(store.open(uri, language, 1, "") == null, "failed opens must not consume capacity");
}

def test_store_resize_capacity(t: Tester) {
	var uris = [
		"file:///tmp/AaAaAa.v3", "file:///tmp/AaAaBB.v3", "file:///tmp/AaBBAa.v3",
		"file:///tmp/AaBBBB.v3", "file:///tmp/BBAaAa.v3", "file:///tmp/BBAaBB.v3",
		"file:///tmp/BBBBAa.v3"
	];
	var alias = "FILE://localhost/tmp/BBAaBB.v3";
	var capacity = 7 * (DocumentLimits.RECORD_BYTES + uris[0].length + 1) + 8;
	for (text in ["", "abcd", "abcdefgh"]) {
		var store = DocumentStore.new(null, capacity);
		for (i < 5) t.assert(store.open(uris[i], "v", 1, "") == null, "empty open failed");
		t.assert(store.open(uris[5], "v", 1, "1234") == null, "resize open failed");
		var original = store.overlay(uris[5]);
		t.assert(store.change(alias, 2, text) == null, "replacement after resize failed");
		var otherText = Arrays.range("12345678", 0, 8 - text.length);
		t.assert(store.open(uris[6], "v", 1, otherText) == null, "exact capacity must fit after replacement");
		t.assert_string(DocumentLimits.EXCEEDED, store.open("untitled:extra", "v", 1, ""));
		t.assert_string("", store.read(uris[0]));
		t.assert_string(text, store.read(uris[5]));
		t.asserti(2, store.overlay(alias).version);
		t.assert_string("document version is not newer", store.change(alias, 2, "stale"));
		t.assert_string("1234", original.text);
		t.asserti(1, original.version);
		t.assert_string(otherText, store.read(uris[6]));
		t.assert(store.close(alias) == null, "close after cache eviction failed");
		t.assert(store.overlay(uris[5]) == null, "close must remove the retained entry");
		t.assert_string("document is not open", store.close(alias));
		t.assert(store.open(uris[5], "v", 0, text) == null, "close must release the replacement charge");
		var rejection = store.change(uris[6], 2, "123456789");
		t.assert(rejection != null, "growth must exceed capacity after close and reopen");
		if (rejection != null) t.assert_string(DocumentLimits.EXCEEDED, rejection);
		t.assert_string(otherText, store.read(uris[6]));
		t.asserti(1, store.overlay(uris[6]).version);
	}
}
