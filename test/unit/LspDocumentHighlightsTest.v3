// textDocument/documentHighlight with the real worker. The project-fixtures/references
// directory is the build's own copy, so each session rewrites its sources
// before the project is loaded. Its project analyzes Refs.v3 before Decl.v3,
// which lets the tests distinguish local ranges from other files. Replies arrive
// through the server's outgoing-message sink. Highlights share their snapshot
// selection, freshness, waiting, and position rules with definition, which
// LspDefinitionTest covers in full; these tests cover each highlight set, and
// that highlights take part in the shared snapshot rules.
def T = UnitTests.register;
def X = [
	T("LspDocumentHighlights:assignment_kinds", test_assignment_kinds),
	T("LspDocumentHighlights:assignment_kinds_more", test_assignment_kinds_more),
	T("LspDocumentHighlights:locals_and_captures", test_locals_and_captures),
	T("LspDocumentHighlights:members_and_generics", test_members_and_generics),
	T("LspDocumentHighlights:components_and_classes", test_components_and_classes),
	T("LspDocumentHighlights:cases", test_cases),
	T("LspDocumentHighlights:index_operators", test_index_operators),
	T("LspDocumentHighlights:layouts_and_packings", test_layouts_and_packings),
	T("LspDocumentHighlights:include_declaration", test_include_declaration),
	T("LspDocumentHighlights:nothing_selected", test_nothing_selected),
	T("LspDocumentHighlights:cross_file", test_cross_file),
	T("LspDocumentHighlights:cross_file_matching_offsets", test_cross_file_matching_offsets),
	T("LspSnapshotRequests:cancelled_cursor_burst", test_cancelled_cursor_burst),
	T("LspSnapshotRequests:cancel_waiting_methods", test_cancel_waiting_methods),
	T("LspSnapshotRequests:cancel_ids", test_cancel_ids),
	T("LspSnapshotRequests:cancel_owned_request", test_cancel_owned_request),
	T("LspSnapshotRequests:cancel_reentrant_reply", test_cancel_reentrant_reply),
	T("LspDocumentHighlights:file_changed_on_disk", test_file_changed_on_disk),
	T("LspDocumentHighlights:semantic_errors", test_semantic_errors),
	T("LspDocumentHighlights:stale_waits_for_analysis", test_stale_waits_for_analysis),
	T("LspDocumentHighlights:stale_without_analysis", test_stale_without_analysis),
	T("LspDocumentHighlights:params", test_params),
	T("LspDocumentHighlights:reply_bound", test_reply_bound),
	T("LspDocumentHighlights:missing_snapshot", test_missing_snapshot),
	()
];
// Shadowed and captured locals, same-named members of unrelated classes,
// generic classes and methods, a class with a default constructor that "this"
// and ".new" resolve to, an explicit constructor, enum and variant cases in
// expressions and patterns, a data type, index operators read, written, and
// both, a builtin, layouts, and packings. Every line is ASCII.
def SOURCE = "component Refs {\n\tdef value = 1;\n\tdef shadow(value: int) -> int {\n\t\tvar x = value;\n\t\tif (x > 0) { var x = 2; return x + Refs.value; }\n\t\treturn x;\n\t}\n\tdef capture(base: int) -> int {\n\t\tvar step = base;\n\t\tvar f = fun (a: int) => a + step;\n\t\tvar g = fun (b: int) => fun (c: int) => b + c + step;\n\t\treturn f(step) + g(1)(2);\n\t}\n\tdef kinds(r: Rect, q: Square, b: Box, c: Color, s: Shape, g: Grid, w: Row) -> int {\n\t\tvar total = r.area() + q.area() + Cell<int>.new(1).get() + Cell<Box>.new(b).get().size;\n\t\ttotal += id(1) + id<Box>(b).size + \"abc\".length;\n\t\tvar n = Node.new().self();\n\t\tvar made = Box.new(2);\n\t\tif (c == Color.RED) total++;\n\t\tmatch (c) {\n\t\t\tRED => total++;\n\t\t\tGREEN => total--;\n\t\t}\n\t\tvar circle = Shape.Circle(3);\n\t\tmatch (s) {\n\t\t\tCircle(radius) => total += radius;\n\t\t\tDot => total--;\n\t\t}\n\t\ttotal += g[0] + g.[](4);\n\t\tg[1] = total;\n\t\tg[2] += 3;\n\t\tvar row = Row(1, 2);\n\t\treturn total + row.m + w.index + Decl.thing;\n\t}\n\tdef id<T>(p: T) -> T { return p; }\n}\nclass Rect {\n\tdef area() -> int { return 1; }\n}\nclass Square {\n\tdef area() -> int { return 2; }\n}\nclass Cell<T>(item: T) {\n\tdef get() -> T { return item; }\n}\nclass Box {\n\tvar size: int;\n\tnew(size) { }\n}\nclass Node {\n\tdef self() -> Node { return this; }\n}\nenum Color { RED, GREEN }\ntype Shape {\n\tcase Circle(r: int);\n\tcase Dot;\n}\ntype Row(m: int, index: int) { }\nclass Grid {\n\tdef [i: int] -> int { return i; }\n\tdef [i: int] = v: int { }\n}\nlayout Tag {\n\t+0 kind: u8;\n\t=1;\n}\nlayout Pair {\n\t+0 head: Tag;\n\t+1 tags: Tag[2];\n\t=3;\n}\ncomponent Mem {\n\tdef head(r: Range<byte>) -> Ref<Tag> {\n\t\tvar p: Ref<Pair> = Ref<Pair>.of(r);\n\t\tvar t: ref<Tag> = p.tags[1];\n\t\treturn p.head;\n\t}\n}\npacking Low(a: 4, b: 4): 8 = #concat(b, a);\npacking Wide(x: 4, y: 8): 16 = #concat(Low(x, 0b0000), y);\n";
// Decl.v3 declares the thing that Refs.v3 uses, and uses it twice, after
// non-ASCII text (U+00E9, two UTF-8 bytes and one UTF-16 unit; U+1D11E, four
// bytes and two units) in a block comment on line 3. Its other lines are ASCII.
def DECL = "// Declares Decl.thing.\ncomponent Decl {\n\tdef thing = 1;\n\tdef twice() -> int { /*\xC3\xA9\xF0\x9D\x84\x9E*/ return thing + thing; }\n}\n";
// In DECL, the uses of thing on line 3 start at UTF-16 characters 37 and 45.
def TWICE_LINE = 3;
def TWICE_FIRST = 37;
def TWICE_SECOND = 45;
// A change of the same length, which only the bytes reveal.
def DECL_CHANGED = "// Declares Decl.thing!\ncomponent Decl {\n\tdef thing = 1;\n\tdef twice() -> int { /*\xC3\xA9\xF0\x9D\x84\x9E*/ return thing + thing; }\n}\n";

// The project-fixtures/references directory, which prepare.py makes and each
// session rewrites.
def highlightsBase() -> string {
	return ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), ProjectFiles.join("project-fixtures", "references"));
}
// Writes {text} to {name} in the project fixture {base}.
def writeFixture(t: Tester, base: string, name: string, text: string) {
	var fd = System.fileOpen(ProjectFiles.join(base, name), false);
	t.assert(fd >= 0, "fixture file written");
	if (fd < 0) return;
	System.fileWriteK(fd, text, 0, text.length);
	System.fileClose(fd);
}

class HighlightsTestSession {
	def supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	def server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
	def store = server.documents;
	var base: string;
	// The responses received, in order.
	def replies = Vector<HashMap<string, JsonValue>>.new();
	var nextId = 100;
	// What handle() returned for the last request; replies use the sink.
	var handled: Array<byte>;
	var onReply: JsonValue -> void;
	new(t: Tester, source: string) {
		base = highlightsBase();
		write(t, "Refs.v3", source);
		write(t, "Decl.v3", DECL);
		HostOs.ignoreSigpipe();
		server.sendNotification = receive;
		var params = Strings.newMap<JsonValue>();
		params["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
		server.handle(JsonRpcMessage.Request(JsonRpcId.Int(0), "initialize", JsonRpcParams.ByName(params)).encode());
	}
	def receive(bytes: Array<byte>) {
		var parser = JsonRpcJsonParser.new(bytes);
		// Server output can contain more values than the client input limit.
		parser.maxValues = int.max;
		var parsed = JsonValue.JObject.!(parser.parseDocument()).v;
		if (!parsed.has("id")) return;
		replies.put(parsed);
		if (onReply != null) onReply(parsed["id"]);
	}
	def uri(name: string) -> string { return ProjectFiles.uri(ProjectFiles.join(base, name)); }
	def write(t: Tester, name: string, text: string) {
		writeFixture(t, base, name, text);
	}
	def open(name: string, version: int, text: string) {
		var doc = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		doc["languageId"] = JsonValue.String("virgil");
		doc["version"] = JsonValue.Int(version);
		doc["text"] = JsonValue.String(text);
		notify("textDocument/didOpen", doc, null);
	}
	def change(name: string, version: int, text: string) {
		var doc = Strings.newMap<JsonValue>(), change = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		doc["version"] = JsonValue.Int(version);
		change["text"] = JsonValue.String(text);
		notify("textDocument/didChange", doc, [JsonValue.JObject(change)]);
	}
	private def notify(method: string, doc: HashMap<string, JsonValue>, changes: Array<JsonValue>) {
		var params = Strings.newMap<JsonValue>();
		params["textDocument"] = JsonValue.JObject(doc);
		if (changes != null) params["contentChanges"] = JsonValue.JArray(changes);
		server.handle(JsonRpcMessage.Notification(method, JsonRpcParams.ByName(params)).encode());
	}
	// Polls until no analysis runs or waits, including the debounce interval.
	def settle() {
		var fds = Array<int>.new(4);
		while (server.analyzing()) {
			var count = supervisor.pollFds(fds, 0);
			HostOs.poll(fds, count, server.pollTimeout());
			server.onPoll();
		}
	}
	// Sends a {method} request for {line}:{character} in {name}, with
	// no context, and returns its id.
	def request(method: string, name: string, line: int, character: int) -> int {
		var id = nextId++;
		requestId(JsonRpcId.Int(id), method, name, line, character);
		return id;
	}
	def requestId(id: JsonRpcId, method: string, name: string, line: int, character: int) {
		var params = positionParams(name, line, character);
		if (Strings.equal(method, "textDocument/references")) {
			var context = Strings.newMap<JsonValue>();
			context["includeDeclaration"] = JsonValue.Bool(true);
			JsonRpcParams.ByName.!(params).v["context"] = JsonValue.JObject(context);
		}
		handled = server.handle(JsonRpcMessage.Request(id, method, params).encode());
	}
	def positionParams(name: string, line: int, character: int) -> JsonRpcParams {
		var doc = Strings.newMap<JsonValue>(), position = Strings.newMap<JsonValue>(), params = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		position["line"] = JsonValue.Int(line);
		position["character"] = JsonValue.Int(character);
		params["textDocument"] = JsonValue.JObject(doc);
		params["position"] = JsonValue.JObject(position);
		return JsonRpcParams.ByName(params);
	}
	def cancel(id: JsonValue) {
		var params = Strings.newMap<JsonValue>();
		params["id"] = id;
		server.handle(JsonRpcMessage.Notification("$/cancelRequest", JsonRpcParams.ByName(params)).encode());
	}
	def highlights(name: string, line: int, character: int) -> int {
		return request("textDocument/documentHighlight", name, line, character);
	}
	// The response to {id}, or null if none has arrived.
	def reply(id: int) -> HashMap<string, JsonValue> { return replyId(JsonValue.Int(id)); }
	def replyId(id: JsonValue) -> HashMap<string, JsonValue> {
		for (i < replies.length) {
			var got = replies[i]["id"];
			if (got == id || (JsonValue.String.?(got) && JsonValue.String.?(id)
				&& Strings.equal(JsonValue.String.!(got).v, JsonValue.String.!(id).v))) return replies[i];
		}
		return null;
	}
	// The result of the response to {id}, which must have arrived.
	def result(t: Tester, id: int) -> JsonValue {
		var r = reply(id);
		t.assert(r != null, "the request was answered");
		if (r == null) return JsonValue.Null;
		t.assert(r.has("result"), "the request succeeded");
		return r["result"];
	}
	// Requests and returns the highlights, which must be answered at once.
	def answer(t: Tester, name: string, line: int, character: int) -> JsonValue {
		var id = highlights(name, line, character);
		t.assert(handled == null, "replies use the sink");
		return result(t, id);
	}
	def context() -> ProjectContext {
		return server.projects.forDocument(uri("Refs.v3")).active;
	}
}
// A highlight in {file}, on {line} from UTF-16 character {begin} to {end}.
class HighlightSpot(file: string, var line: int, begin: int, end: int) {
	var kind = 2;
}
// The LSP position of byte {skip} past the first {needle} in ASCII lines of {text}.
def at(text: string, needle: string, skip: int) -> (int, int) {
	var line = 0, start = 0;
	for (i = 0; i + needle.length <= text.length; i++) {
		if (Strings.equal(Arrays.range(text, i, i + needle.length), needle)) return (line, i + skip - start);
		if (text[i] == '\n') {
			line++;
			start = i + 1;
		}
	}
	return (-1, -1);
}
// The {length} bytes from {skip} bytes into the first {needle} in SOURCE.
def S(needle: string, skip: int, length: int) -> HighlightSpot {
	var p = at(SOURCE, needle, skip);
	return HighlightSpot.new(if(p.0 >= 0, "Refs.v3"), p.0, p.1, p.1 + length);
}
// Declaration and write spots; ordinary S spots are reads.
def D(needle: string, skip: int, length: int) -> HighlightSpot {
	var spot = S(needle, skip, length);
	spot.kind = 1;
	return spot;
}
def W(needle: string, skip: int, length: int) -> HighlightSpot {
	var spot = S(needle, skip, length);
	spot.kind = 3;
	return spot;
}
def member(v: JsonValue, key: string) -> JsonValue {
	return if(JsonValue.JObject.?(v), JsonValue.JObject.!(v).v[key]);
}
def intAt(v: JsonValue, key: string) -> int {
	var m = member(v, key);
	return if(JsonValue.Int.?(m), JsonValue.Int.!(m).v, -1);
}
def stringAt(v: JsonValue, key: string) -> string {
	var m = member(v, key);
	return if(JsonValue.String.?(m), JsonValue.String.!(m).v, "<none>");
}
// Checks exact kinds and highlights in source order, including their UTF-16 ranges.
def expectHighlightSpots(t: Tester, s: HighlightsTestSession, result: JsonValue, spots: Array<HighlightSpot>, what: string) {
	t.assert(JsonValue.JArray.?(result), Strings.format1("highlights for %s", what));
	if (!JsonValue.JArray.?(result)) return;
	var want = StringBuilder.new().puts(what), got = StringBuilder.new().puts(what);
	for (spot in spots) {
		t.assert(spot.file != null, "fixture text found");
		want.put1("; kind %d", spot.kind).put2(" %d:%d", spot.line, spot.begin).put2("-%d:%d", spot.line, spot.end);
	}
	for (highlight in JsonValue.JArray.!(result).v) {
		t.assert(!JsonValue.JObject.!(highlight).v.has("uri"), "no URI in a highlight");
		var range = member(highlight, "range"), start = member(range, "start"), stop = member(range, "end");
		got.put1("; kind %d", intAt(highlight, "kind")).put2(" %d:%d", intAt(start, "line"), intAt(start, "character"))
			.put2("-%d:%d", intAt(stop, "line"), intAt(stop, "character"));
	}
	t.assert_string(want.toString(), got.toString());
}
def expectHighlights(t: Tester, s: HighlightsTestSession, needle: string, skip: int, spots: Array<HighlightSpot>) {
	var p = at(SOURCE, needle, skip);
	t.assert(p.0 >= 0, "fixture text found");
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", p.0, p.1), spots, needle);
}
def expectNull(t: Tester, v: JsonValue, what: string) {
	t.assert(v == JsonValue.Null, what);
}
def session(t: Tester) -> HighlightsTestSession {
	var s = HighlightsTestSession.new(t, SOURCE);
	s.open("Refs.v3", 1, SOURCE);
	s.settle();
	return s;
}
// Exercise collector flags, worker round trips, and the final LSP kinds.
// Assignment receivers and index operands stay reads, even in compound or
// nested targets. Calls in the same body exercise uses untouched by writes.
def test_assignment_kinds(t: Tester) {
	var text = "component Kinds {\n  var field: int;\n  var initialized = 1;\n  def body(p: int, a: Array<int>, b: Box) -> int {\n    var x: int;\n    x = p;\n    x += 1; x -= 1; x *= 2; x /= 2; x %= 3;\n    x &= 3; x |= 4; x ^= 5; x <<= 1; x >>= 1;\n    x++; x--; ++x; --x;\n    p = x;\n    a[x] = p; a[x] += p; a[x]++;\n    b.field = x; b.field += x; b.field++;\n    field = p; initialized += x;\n    var bound = p;\n    return identity(x) + bound + initialized;\n  }\n  def identity(value: int) -> int { return value; }\n}\nclass Box { var field: int; }\n";
	var s = HighlightsTestSession.new(t, text);
	s.open("Refs.v3", 1, text);
	s.settle();
	t.assert(s.context().snapshot.verified, "the assignment fixture verifies");
	var analysis = AeneasAdapter.analyzeProgram([AnalysisSource.new("Refs.v3", text)], [], false);
	t.assert(analysis.verified, "the collector fixture verifies");
	// All uses of each name, including its declaration, in source order.
	var expected: Array<(string, Array<int>)> = [
		("x", [1, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 2, 2, 2, 2, 2, 2, 2, 2]),
		("p", [1, 2, 3, 2, 2, 2, 2]),
		("a", [1, 2, 2, 2]),
		("b", [1, 2, 2, 2]),
		("initialized", [1, 3, 2]),
		("bound", [1, 2]),
		("identity", [2, 1]),
		("value", [1, 2])
	];
	expectKinds(t, s, analysis, text, expected);
	// Two different fields share the spelling; only the receiver's field
	// joins the Box declaration, and its receiver remains a read above.
	var field = at(text, "b.field =", 2), result = s.answer(t, "Refs.v3", field.0, field.1);
	var entries = JsonValue.JArray.!(result).v;
	t.asserti(4, entries.length);
	for (i < entries.length) t.asserti(if(i == 3, 1, 3), intAt(entries[i], "kind"));
	field = at(text, "var field", 4);
	entries = JsonValue.JArray.!(s.answer(t, "Refs.v3", field.0, field.1)).v;
	t.asserti(2, entries.length);
	t.asserti(1, intAt(entries[0], "kind"));
	t.asserti(3, intAt(entries[1], "kind"));
	s.server.close();
}
// Forms beyond the first fixture: an unsigned shift assignment, an
// increment used as a value, writes through chained and indexed receivers,
// and a field written in a constructor.
def test_assignment_kinds_more(t: Tester) {
	var text = "component More {\n  def body(x: int, d: Outer, cells: Array<Cell>, k: int) -> int {\n    var y: int;\n    x >>>= 1;\n    y = x++;\n    d.inner.leaf = y;\n    cells[k].slot = y;\n    return x + y;\n  }\n}\nclass Outer { var inner: Inner; }\nclass Inner { var leaf: int; }\nclass Cell { var slot: int; }\nclass Made {\n  var made: int;\n  new(v: int) { made = v; }\n}\n";
	var s = HighlightsTestSession.new(t, text);
	s.open("Refs.v3", 1, text);
	s.settle();
	t.assert(s.context().snapshot.verified, "the fixture verifies");
	var analysis = AeneasAdapter.analyzeProgram([AnalysisSource.new("Refs.v3", text)], [], false);
	t.assert(analysis.verified, "the collector fixture verifies");
	expectKinds(t, s, analysis, text, [
		("x", [1, 3, 3, 2]),
		("y", [1, 3, 2, 2, 2]),
		("d", [1, 2]),
		("inner", [2, 1]),
		("leaf", [3, 1]),
		("cells", [1, 2]),
		("k", [1, 2]),
		("slot", [3, 1]),
		("made", [1, 3]),
		("v", [1, 2])
	]);
	s.server.close();
}
// Checks each name's highlights, from its first occurrence, against its
// expected kinds in source order (1 Text, 2 Read, 3 Write), and the
// collector's write flag on each use.
def expectKinds(t: Tester, s: HighlightsTestSession, analysis: ProgramAnalysis, text: string, expected: Array<(string, Array<int>)>) {
	for (entry in expected) {
		var name = entry.0, kinds = entry.1, spots = Vector<HighlightSpot>.new();
		var line = 0, column = 0;
		for (i = 0; i < text.length;) {
			var c = text[i];
			if (Char.isIdentStart(c)) {
				var begin = i, start = column;
				while (i < text.length && Char.isIdentMiddle(text[i])) { i++; column++; }
				if (!Strings.equal(Arrays.range(text, begin, i), name)) continue;
				var spot = HighlightSpot.new("Refs.v3", line, start, column), n = spots.length;
				spot.kind = if(n < kinds.length, kinds[n], -1);
				spots.put(spot);
				var use: AnalysisOccurrence;
				for (o in analysis.occurrences("Refs.v3")) if (o.range.beginOffset == begin) use = o;
				if (spot.kind != 1) t.assert(use != null && use.isWrite() == (spot.kind == 3), Strings.format3("collector flag for %s at %d:%d", name, line, start));
			} else {
				i++;
				column++;
				if (c == '\n') { line++; column = 0; }
			}
		}
		t.asserti(kinds.length, spots.length);
		var first = spots[0];
		expectHighlightSpots(t, s, s.answer(t, "Refs.v3", first.line, first.begin), spots.extract(), name);
	}
}
def test_locals_and_captures(t: Tester) {
	var s = session(t);
	// An outer local, and one of the same name that shadows it in a block.
	var outer = D("var x = value", 4, 1), inner = D("var x = 2", 4, 1);
	expectHighlights(t, s, "if (x > 0)", 4, [outer, S("if (x > 0)", 4, 1), S("return x;", 7, 1)]);
	expectHighlights(t, s, "return x + Refs", 7, [inner, S("return x + Refs", 7, 1)]);
	// A parameter that shadows a field, and the field.
	var parameter = D("shadow(value", 7, 5), field = D("def value", 4, 5);
	expectHighlights(t, s, "var x = value", 8, [parameter, S("var x = value", 8, 5)]);
	expectHighlights(t, s, "Refs.value", 5, [field, S("Refs.value", 5, 5)]);
	// A local captured by a lambda and by a nested lambda, and a lambda's
	// parameter that the nested lambda captures.
	var step = D("var step", 4, 4);
	expectHighlights(t, s, "a + step", 4, [step, S("a + step", 4, 4), S("b + c + step", 8, 4), S("f(step)", 2, 4)]);
	var b = D("fun (b: int)", 5, 1);
	expectHighlights(t, s, "b + c", 0, [b, S("b + c", 0, 1)]);
	// A match pattern's binding.
	var radius = D("Circle(radius)", 7, 6);
	expectHighlights(t, s, "+= radius", 3, [radius, S("+= radius", 3, 6)]);
	s.server.close();
}
// Same-named methods of unrelated classes, a generic class's method used at
// two instantiations, a generic method, and same-named type parameters.
def test_members_and_generics(t: Tester) {
	var s = session(t);
	var rect = D("def area() -> int { return 1", 4, 4), square = D("def area() -> int { return 2", 4, 4);
	expectHighlights(t, s, "r.area()", 2, [S("r.area()", 2, 4), rect]);
	expectHighlights(t, s, "q.area()", 2, [S("q.area()", 2, 4), square]);
	var get = D("def get()", 4, 3);
	expectHighlights(t, s, "new(1).get", 7, [S("new(1).get", 7, 3), S("new(b).get", 7, 3), get]);
	var cell = D("class Cell", 6, 4);
	expectHighlights(t, s, "Cell<Box>", 0, [S("Cell<int>", 0, 4), S("Cell<Box>", 0, 4), cell]);
	var id = D("def id<T>", 4, 2);
	expectHighlights(t, s, "id<Box>", 0, [S("id(1)", 0, 2), S("id<Box>", 0, 2), id]);
	var methodT = D("def id<T>", 7, 1), classT = D("class Cell<T>", 11, 1);
	expectHighlights(t, s, "(p: T) -> T", 4, [methodT, S("(p: T) -> T", 4, 1), S("(p: T) -> T", 10, 1)]);
	expectHighlights(t, s, "def get() -> T", 13, [classT, S("(item: T)", 7, 1), S("def get() -> T", 13, 1)]);
	var item = D("(item: T)", 1, 4);
	expectHighlights(t, s, "return item", 7, [item, S("return item", 7, 4)]);
	s.server.close();
}
// "this" and a default ".new" resolve to their class but are not its
// references; either selects the class. An explicit constructor's uses are
// its own.
def test_components_and_classes(t: Tester) {
	var s = session(t);
	var refs = D("component Refs", 10, 4);
	expectHighlights(t, s, "Refs.value", 0, [refs, S("Refs.value", 0, 4)]);
	var node = D("class Node", 6, 4), nodes = [S("Node.new()", 0, 4), node, S("self() -> Node", 10, 4)];
	expectHighlights(t, s, "class Node", 6, nodes);
	expectHighlights(t, s, "return this", 7, nodes);
	expectHighlights(t, s, "Node.new()", 5, nodes);
	var box = D("class Box", 6, 3);
	expectHighlights(t, s, "b: Box", 3, [S("b: Box", 3, 3), S("Cell<Box>", 5, 3), S("id<Box>", 3, 3), S("Box.new(2)", 0, 3), box]);
	var constructor = D("new(size)", 0, 3);
	expectHighlights(t, s, "Box.new(2)", 4, [S("Box.new(2)", 4, 3), constructor]);
	var size = D("var size", 4, 4);
	expectHighlights(t, s, "get().size", 6, [S("get().size", 6, 4), S("(b).size", 4, 4), size]);
	s.server.close();
}
// Enum and variant cases in expressions and patterns, their types, and a
// data type, which shares its name with its single case: the uses of both are
// its references.
def test_cases(t: Tester) {
	var s = session(t);
	var red = D("{ RED", 2, 3), green = D("RED, GREEN", 5, 5), color = D("enum Color", 5, 5);
	expectHighlights(t, s, "Color.RED", 6, [S("Color.RED", 6, 3), S("RED =>", 0, 3), red]);
	expectHighlights(t, s, "GREEN =>", 0, [S("GREEN =>", 0, 5), green]);
	expectHighlights(t, s, "c: Color", 3, [S("c: Color", 3, 5), S("Color.RED", 0, 5), color]);
	var circle = D("case Circle", 5, 6), dot = D("case Dot", 5, 3), shape = D("type Shape", 5, 5);
	expectHighlights(t, s, "Shape.Circle(3)", 6, [S("Shape.Circle(3)", 6, 6), S("Circle(radius)", 0, 6), circle]);
	expectHighlights(t, s, "Dot =>", 0, [S("Dot =>", 0, 3), dot]);
	expectHighlights(t, s, "s: Shape", 3, [S("s: Shape", 3, 5), S("Shape.Circle(3)", 0, 5), shape]);
	var row = D("type Row", 5, 3), rows = [S("w: Row", 3, 3), S("Row(1, 2)", 0, 3), row];
	expectHighlights(t, s, "type Row", 5, rows);
	expectHighlights(t, s, "w: Row", 3, rows);
	expectHighlights(t, s, "Row(1, 2)", 0, rows);
	var m = D("Row(m", 4, 1);
	expectHighlights(t, s, "row.m", 4, [S("row.m", 4, 1), m]);
	s.server.close();
}
// An index operation is a use of its bracket. c[i] += v uses only []=, and a
// named call spells the method's whole name.
def test_index_operators(t: Tester) {
	var s = session(t);
	var read = D("def [i: int] -> int", 4, 1), write = D("def [i: int] = v", 4, 1);
	var reads = [S("g[0]", 1, 1), S("g.[](4)", 2, 2), read], writes = [W("g[1]", 1, 1), W("g[2] += 3", 1, 1), write];
	expectHighlights(t, s, "g[0]", 1, reads);
	expectHighlights(t, s, "g.[](4)", 2, reads);
	expectHighlights(t, s, "def [i: int] -> int", 4, reads);
	expectHighlights(t, s, "g[1]", 1, writes);
	expectHighlights(t, s, "g[2] += 3", 1, writes);
	expectHighlights(t, s, "def [i: int] = v", 4, writes);
	s.server.close();
}
// Layouts in layout fields' memory types and in Ref and ref, a layout field
// and a method of the same name, packings in applications, and packing
// parameters in #concat and as arguments.
def test_layouts_and_packings(t: Tester) {
	var s = session(t);
	var tag = D("layout Tag", 7, 3), pair = D("layout Pair", 7, 4);
	expectHighlights(t, s, "head: Tag", 6, [tag, S("head: Tag", 6, 3), S("Tag[2]", 0, 3), S("-> Ref<Tag>", 7, 3), S("ref<Tag>", 4, 3)]);
	expectHighlights(t, s, "Ref<Pair>.of", 4, [pair, S("Ref<Pair> =", 4, 4), S("Ref<Pair>.of", 4, 4)]);
	var head = D("+0 head", 3, 4), method = D("def head", 4, 4);
	expectHighlights(t, s, "p.head", 2, [head, S("p.head", 2, 4)]);
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", method.line, method.begin), [method], "a method named as a layout field");
	var low = D("packing Low", 8, 3), x = D("Wide(x", 5, 1), a = D("Low(a", 4, 1);
	expectHighlights(t, s, "Low(x,", 0, [low, S("Low(x,", 0, 3)]);
	expectHighlights(t, s, "Low(x,", 4, [x, S("Low(x,", 4, 1)]);
	expectHighlights(t, s, "b, a)", 3, [a, S("b, a)", 3, 1)]);
	s.server.close();
}
// The declaration's name is always in the reply, wherever the
// request selects it, and a declaration that nothing uses has only its name.
def test_include_declaration(t: Tester) {
	var s = session(t);
	var made = D("var made", 4, 4);
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", made.line, made.begin), [made], "an unused local");
	// Just past an identifier, before ; and before a space.
	var outer = D("var x = value", 4, 1), uses = [S("if (x > 0)", 4, 1), S("return x;", 7, 1)];
	var p = at(SOURCE, "return x;", 8);
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", p.0, p.1), [outer, uses[0], uses[1]], "just past a use");
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", outer.line, outer.end), [outer, uses[0], uses[1]], "just past a declaration's name");
	s.server.close();
}
def test_nothing_selected(t: Tester) {
	var s = session(t);
	var p = at(SOURCE, "\"abc\".length", 6);
	expectNull(t, s.answer(t, "Refs.v3", p.0, p.1), "a builtin member");
	p = at(SOURCE, "return total + row", 0);
	expectNull(t, s.answer(t, "Refs.v3", p.0, p.1), "a keyword");
	p = at(SOURCE, "id(1)", 3);
	expectNull(t, s.answer(t, "Refs.v3", p.0, p.1), "a literal");
	p = at(SOURCE, "-> Ref<Tag>", 3);
	expectNull(t, s.answer(t, "Refs.v3", p.0, p.1), "a builtin type");
	p = at(SOURCE, "def head(r: Range<byte>", 18);
	expectNull(t, s.answer(t, "Refs.v3", p.0, p.1), "a builtin type argument");
	expectNull(t, s.answer(t, "Refs.v3", 1000, 0), "past the end of the document");
	s.server.close();
}
// Highlights stay in the requested file even when the declaration or uses
// are in another file. Closed requests convert UTF-16 after non-ASCII text.
def test_cross_file(t: Tester) {
	var s = session(t);
	var declaration = HighlightSpot.new("Decl.v3", 2, 5, 10), use = S("Decl.thing", 5, 5);
	var twice = [HighlightSpot.new("Decl.v3", TWICE_LINE, TWICE_FIRST, TWICE_FIRST + 5), HighlightSpot.new("Decl.v3", TWICE_LINE, TWICE_SECOND, TWICE_SECOND + 5)];
	declaration.kind = 1;
	var all = [declaration, twice[0], twice[1], use];
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", use.line, use.begin), [use], "only the requested file");
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", use.line, use.begin), [use], "the other file excluded");
	// From the closed file's own declaration and use, which is read again too.
	expectHighlightSpots(t, s, s.answer(t, "Decl.v3", 2, 7), [declaration, twice[0], twice[1]], "from the declaration");
	expectHighlightSpots(t, s, s.answer(t, "Decl.v3", TWICE_LINE, TWICE_SECOND + 1), [declaration, twice[0], twice[1]], "from a use after non-ASCII text");
	// The component Decl, used from Refs.v3.
	var decl = HighlightSpot.new("Decl.v3", 1, 10, 14);
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", use.line, use.begin - 2), [S("Decl.thing", 0, 4)], "the component");
	s.server.close();
}
// A closed file changed on disk without a file event keeps every stamp
// current, but its bytes are no longer the ones analyzed. Highlights in the
// other file are unchanged; a request in the changed file gets null.
def test_file_changed_on_disk(t: Tester) {
	var s = session(t);
	var use = S("Decl.thing", 5, 5);
	s.write(t, "Decl.v3", DECL_CHANGED);
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", use.line, use.begin), [use], "no ranges from the changed file");
	expectNull(t, s.answer(t, "Decl.v3", 2, 7), "a request in the changed file");
	s.write(t, "Decl.v3", DECL);
	var declaration = HighlightSpot.new("Decl.v3", 2, 5, 10);
	var twice = [HighlightSpot.new("Decl.v3", TWICE_LINE, TWICE_FIRST, TWICE_FIRST + 5), HighlightSpot.new("Decl.v3", TWICE_LINE, TWICE_SECOND, TWICE_SECOND + 5)];
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", use.line, use.begin), [use], "the file restored");
	// An open file's analyzed text is its overlay, whatever is on disk.
	var step = D("var step", 4, 4);
	s.write(t, "Refs.v3", "");
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", step.line, step.begin), [step, S("a + step", 4, 4), S("b + c + step", 8, 4), S("f(step)", 2, 4)], "an open file");
	s.server.close();
}
// A program with semantic errors is answered from the uses that resolved.
def test_semantic_errors(t: Tester) {
	var text = Strings.format1("%s\ncomponent Broken {\n\tdef f(step: int) -> int { return step + missing; }\n}\n", SOURCE);
	var s = HighlightsTestSession.new(t, text);
	s.open("Refs.v3", 1, text);
	s.settle();
	t.assert(s.context().snapshot.parsed && !s.context().snapshot.verified, "the program parsed and has errors");
	var p = at(text, "step + missing", 0), q = at(text, "f(step: int)", 2);
	var mine = [HighlightSpot.new("Refs.v3", q.0, q.1, q.1 + 4), HighlightSpot.new("Refs.v3", p.0, p.1, p.1 + 4)];
	mine[0].kind = 1;
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", p.0, p.1), mine, "a parameter beside an unresolved name");
	var step = D("var step", 4, 4);
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", step.line, step.begin), [step, S("a + step", 4, 4), S("b + c + step", 8, 4), S("f(step)", 2, 4)], "another declaration of the same name");
	p = at(text, "missing", 0);
	expectNull(t, s.answer(t, "Refs.v3", p.0, p.1), "the unresolved name");
	s.server.close();
}
// Requests against a stale snapshot wait for the analysis and are answered
// in arrival order beside definition requests.
def test_stale_waits_for_analysis(t: Tester) {
	var s = session(t);
	var generation = s.context().snapshot.generation;
	// An unsaved edit adds a line before every declaration. The change waits
	// for the debounce interval, which the requests skip.
	s.change("Refs.v3", 2, Strings.format1("\n%s", SOURCE));
	t.assertz(false, s.supervisor.busy());
	var p = at(SOURCE, "a + step", 4);
	var first = s.highlights("Refs.v3", p.0 + 1, p.1), second = s.highlights("Refs.v3", p.0 + 1, p.1);
	var definition = s.request("textDocument/definition", "Refs.v3", p.0 + 1, p.1);
	t.assert(s.handled == null, "replies use the sink");
	t.assert(s.reply(first) == null && s.reply(second) == null && s.reply(definition) == null, "the replies wait");
	t.assertz(true, s.supervisor.busy());
	s.settle();
	t.assert(s.context().snapshot.generation > generation, "a new analysis completed");
	var spots = [D("var step", 4, 4), S("a + step", 4, 4), S("b + c + step", 8, 4), S("f(step)", 2, 4)];
	for (spot in spots) spot.line++;
	expectHighlightSpots(t, s, s.result(t, first), spots, "from the first request");
	expectHighlightSpots(t, s, s.result(t, second), spots, "from the second request");
	t.assert(JsonValue.JObject.?(s.result(t, definition)), "the definition is answered too");
	t.asserti(3, s.replies.length);
	if (s.replies.length == 3) {
		t.assert(s.replies[0]["id"] == JsonValue.Int(first) && s.replies[1]["id"] == JsonValue.Int(second), "answered in arrival order");
	}
	s.server.close();
}
def test_stale_without_analysis(t: Tester) {
	var s = session(t);
	var step = D("var step", 4, 4);
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", step.line, step.begin), [step, S("a + step", 4, 4), S("b + c + step", 8, 4), S("f(step)", 2, 4)], "a current snapshot");
	// An edit that schedules no analysis leaves the snapshot stale.
	t.assert(s.store.change(s.uri("Refs.v3"), 2, Strings.format1("%s\n", SOURCE)) == null, "edit");
	t.assertz(false, s.server.analyzing());
	expectNull(t, s.answer(t, "Refs.v3", step.line, step.begin), "a stale snapshot");
	t.assertz(false, s.server.analyzing());
	// A program that does not parse has no occurrences.
	s.change("Refs.v3", 3, Strings.format1("%s}\n", SOURCE));
	s.settle();
	t.assert(!s.context().snapshot.parsed, "the program does not parse");
	expectNull(t, s.answer(t, "Refs.v3", step.line, step.begin), "a parse failure");
	s.server.close();
}
def test_missing_snapshot(t: Tester) {
	var s = session(t), step = D("var step", 4, 4);
	s.context().snapshot = null;
	expectNull(t, s.answer(t, "Refs.v3", step.line, step.begin), "no snapshot and no pending analysis");
	s.server.close();
}
def test_params(t: Tester) {
	var s = session(t);
	var cases = ["null", "[]", "{}", "{\"textDocument\":{\"uri\":\"file:relative\"},\"position\":{\"line\":0,\"character\":0}}",
		Strings.format1("{\"textDocument\":{\"uri\":\"%s\"},\"position\":{\"line\":-1,\"character\":0}}", s.uri("Refs.v3")),
		Strings.format1("{\"textDocument\":{\"uri\":\"%s\"},\"position\":{\"line\":0,\"character\":\"0\"}}", s.uri("Refs.v3"))];
	for (i < cases.length) {
		var payload = Strings.format2("{\"jsonrpc\":\"2.0\",\"id\":%d,\"method\":\"textDocument/documentHighlight\",\"params\":%s}", i + 1, cases[i]);
		t.assert(s.server.handle(payload) == null, "replies use the sink");
		var r = s.reply(i + 1);
		t.assert(r != null && r.has("error"), cases[i]);
		if (r != null && r.has("error")) {
			t.asserti(JsonRpcErrorCode.INVALID_PARAMS, intAt(r["error"], "code"));
			t.assert_string("document highlights params require a valid textDocument.uri and position", stringAt(r["error"], "message"));
		}
	}
	s.server.close();
}
def threeHighlights(params: HashMap<string, JsonValue>) -> (LspSnapshotPosition, int) -> (bool, JsonRpcReply) {
	return LspDocumentHighlights.answer(_, _, 3);
}
def test_reply_bound(t: Tester) {
	var s = session(t), replies = Vector<HashMap<string, JsonValue>>.new();
	var requests = LspSnapshotRequests.new(s.store, s.server.projects, fun (bytes: Array<byte>) {
		replies.put(JsonValue.JObject.!(JsonRpcJsonParser.new(bytes).parseDocument()).v);
	});
	var dispatcher = JsonRpcDispatcher.new();
	requests.registerPrepared(dispatcher, "textDocument/documentHighlight", "document highlights", LspDocumentHighlights.REQUIRES, threeHighlights);
	var cases = [D("class Node", 6, 4), D("var step", 4, 4), S("return this", 7, 4)];
	for (p in cases) {
		var payload = Strings.format3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"textDocument/documentHighlight\",\"params\":{\"textDocument\":{\"uri\":\"%s\"},\"position\":{\"line\":%d,\"character\":%d}}}", s.uri("Refs.v3"), p.line, p.begin);
		t.assert(dispatcher.handle(payload) == null, "replies use the sink");
	}
	t.asserti(3, replies.length);
	if (replies.length == 3) {
		var node = D("class Node", 6, 4), nodes = [S("Node.new()", 0, 4), node, S("self() -> Node", 10, 4)];
		expectHighlightSpots(t, s, replies[0]["result"], nodes, "exactly the bound");
		t.asserti(LspErrorCode.REQUEST_FAILED, intAt(replies[1]["error"], "code"));
		t.assert_string("the declaration step has more than 3 document highlights", stringAt(replies[1]["error"], "message"));
		expectHighlightSpots(t, s, replies[2]["result"], nodes, "aliases do not count");
	}
	s.server.close();
}

// A foreign use's byte span also spells the name in a comment in Refs.v3.
// Name validation therefore cannot substitute for the document-path filter.
def test_cross_file_matching_offsets(t: Tester) {
	var decl = "component Decl { def thing = 1; def get() -> int { return thing; } }\n";
	var foreign = at(decl, "return thing", 7).1;
	var padding = Array<byte>.new(foreign - 2);
	for (i < padding.length) padding[i] = ' ';
	var text = Strings.format1("//%sthing\ncomponent Refs { def get() -> int { return Decl.thing; } }\n", padding);
	var s = HighlightsTestSession.new(t, text);
	s.write(t, "Decl.v3", decl);
	s.open("Refs.v3", 1, text);
	s.settle();
	t.assert_string("thing", Arrays.range(text, foreign, foreign + 5));
	var use = at(text, "Decl.thing", 5);
	expectHighlightSpots(t, s, s.answer(t, "Refs.v3", use.0, use.1),
		[HighlightSpot.new("Refs.v3", use.0, use.1, use.1 + 5)], "a foreign span with matching bytes");
	s.server.close();
}
// The same server and fixture exercise cancellation of every shared snapshot
// method, without polling the worker until the requests have been cancelled.
def expectCancelled(t: Tester, r: HashMap<string, JsonValue>) {
	t.assert(r != null && r.has("error"), "the waiting request was cancelled");
	if (r != null && r.has("error")) t.asserti(LspErrorCode.REQUEST_CANCELLED, intAt(r["error"], "code"));
}
def test_cancelled_cursor_burst(t: Tester) {
	var s = session(t), requests = s.server.rename.requests;
	s.change("Refs.v3", 2, Strings.format1("%s\n", SOURCE));
	var p = at(SOURCE, "a + step", 4);
	var definition = s.request("textDocument/definition", "Refs.v3", p.0, p.1);
	t.assert(s.reply(definition) == null, "the definition waits for the analysis");
	var ids = Array<int>.new(requests.MAX_WAITING);
	for (i < ids.length) {
		ids[i] = s.highlights("Refs.v3", p.0, p.1);
		t.assert(s.reply(ids[i]) == null, "the highlight waits for the analysis");
		s.cancel(JsonValue.Int(ids[i]));
	}
	t.assert(s.reply(definition) == null, "cancelled cursor requests never evict the definition");
	for (id in ids) expectCancelled(t, s.reply(id));
	t.asserti(requests.MAX_WAITING, s.replies.length);
	t.asserti(1, requests.waiting());
	s.settle();
	t.assert(JsonValue.JObject.?(s.result(t, definition)), "the definition is answered from the completed snapshot");
	t.asserti(requests.MAX_WAITING + 1, s.replies.length);
	t.asserti(0, requests.waiting());
	s.server.close();
}
def test_cancel_waiting_methods(t: Tester) {
	var s = session(t), requests = s.server.rename.requests;
	s.change("Refs.v3", 2, Strings.format1("%s\n", SOURCE));
	var p = at(SOURCE, "a + step", 4);
	var methods = ["textDocument/definition", "textDocument/typeDefinition", "textDocument/hover", "textDocument/references",
		"textDocument/implementation", "textDocument/signatureHelp", "textDocument/prepareRename"];
	var ids = Array<int>.new(methods.length);
	for (i < methods.length) ids[i] = s.request(methods[i], "Refs.v3", p.0, p.1);
	t.asserti(methods.length, requests.waiting());
	for (i < ids.length) {
		t.assert(s.reply(ids[i]) == null, "the request waits");
		s.cancel(JsonValue.Int(ids[i]));
		expectCancelled(t, s.reply(ids[i]));
		t.asserti(ids.length - i - 1, requests.waiting());
	}
	t.asserti(0, requests.recorded());
	s.settle();
	t.asserti(ids.length, s.replies.length);
	s.server.close();
}
def test_cancel_ids(t: Tester) {
	var s = session(t), requests = s.server.rename.requests;
	s.change("Refs.v3", 2, Strings.format1("%s\n", SOURCE));
	var p = at(SOURCE, "a + step", 4);
	s.requestId(JsonRpcId.Int(123), "textDocument/definition", "Refs.v3", p.0, p.1);
	s.requestId(JsonRpcId.String("123"), "textDocument/hover", "Refs.v3", p.0, p.1);
	for (id in [JsonValue.Int(999), JsonValue.String("unknown"), JsonValue.Null, JsonValue.Bool(true)]) s.cancel(id);
	s.server.handle(JsonRpcMessage.Notification("$/cancelRequest", JsonRpcParams.Absent).encode());
	s.server.handle(JsonRpcMessage.Notification("$/cancelRequest", JsonRpcParams.ByName(Strings.newMap<JsonValue>())).encode());
	t.asserti(0, s.replies.length);
	t.asserti(2, requests.waiting());
	s.cancel(JsonValue.String("123"));
	expectCancelled(t, s.replyId(JsonValue.String("123")));
	t.assert(s.reply(123) == null, "string and integer ids are distinct");
	t.asserti(1, requests.waiting());
	s.cancel(JsonValue.String("123"));
	t.asserti(1, s.replies.length);
	s.settle();
	t.assert(JsonValue.JObject.?(s.result(t, 123)), "the integer id completes normally");
	s.cancel(JsonValue.Int(123));
	t.asserti(2, s.replies.length);
	s.server.close();
}
// Even before its owner withdraws it, a request with a sink is excluded from
// snapshot cancellation. LspRenameTest covers rename's own cancellation.
def test_cancel_owned_request(t: Tester) {
	var s = session(t), requests = s.server.rename.requests;
	s.change("Refs.v3", 2, Strings.format1("%s\n", SOURCE));
	var p = at(SOURCE, "a + step", 4), replies = Vector<JsonRpcReply>.new();
	var request = JsonRpcMessage.Request(JsonRpcId.Int(123), "owned", s.positionParams("Refs.v3", p.0, p.1));
	var r = requests.submit(request, "owned", LspDocumentHighlights.REQUIRES, LspDocumentHighlights.prepare,
		null, fun (reply: JsonRpcReply) { replies.put(reply); });
	t.assert(r != null, "the owned request waits");
	s.cancel(JsonValue.Int(123));
	t.asserti(0, replies.length);
	t.asserti(0, s.replies.length);
	t.asserti(1, requests.waiting());
	requests.withdraw(r);
	t.asserti(0, requests.waiting());
	s.settle();
	t.asserti(0, replies.length);
	s.server.close();
}
class HighlightsCancellationReply(s: HighlightsTestSession, t: Tester, first: int) {
	var sent = -1;
	def receive(id: JsonValue) {
		if (id != JsonValue.Int(first) || sent >= 0) return;
		sent = 0;
		var requests = s.server.rename.requests;
		t.asserti(requests.MAX_WAITING - 1, requests.waiting());
		// Repeating the cancellation during its reply must not answer twice.
		s.cancel(id);
		sent = s.highlights("Refs.v3", 3, 6);
	}
}
def test_cancel_reentrant_reply(t: Tester) {
	var s = session(t), requests = s.server.rename.requests;
	s.change("Refs.v3", 2, Strings.format1("%s\n", SOURCE));
	var ids = Array<int>.new(requests.MAX_WAITING);
	for (i < ids.length) ids[i] = s.highlights("Refs.v3", 3, 6);
	var sender = HighlightsCancellationReply.new(s, t, ids[0]);
	s.onReply = sender.receive;
	s.cancel(JsonValue.Int(ids[0]));
	s.onReply = null;
	expectCancelled(t, s.reply(ids[0]));
	t.assert(sender.sent > 0, "a new request was sent within the reply");
	t.asserti(1, s.replies.length);
	t.asserti(requests.MAX_WAITING, requests.waiting());
	s.settle();
	t.asserti(ids.length + 1, s.replies.length);
	for (i = 1; i < ids.length; i++) t.assert(s.reply(ids[i]) != null, "each original request completes once");
	t.assert(s.reply(sender.sent) != null, "the reentrant request completes");
	t.asserti(0, requests.waiting());
	s.server.close();
}
