// The cursor scanner, its context classification, the keyword table, and
// textDocument/completion. In the texts below, "$" marks the cursor and is
// removed before scanning.
def T = UnitTests.register;
def X = [
	T("LspCompletion:comments", test_comments),
	T("LspCompletion:strings", test_strings),
	T("LspCompletion:byte_literals", test_byte_literals),
	T("LspCompletion:prefix_range", test_prefix_range),
	T("LspCompletion:numbers", test_numbers),
	T("LspCompletion:empty_fraction_operators", test_empty_fraction_operators),
	T("LspCompletion:decimal_members", test_decimal_members),
	T("LspCompletion:member_after_dot", test_member_after_dot),
	T("LspCompletion:operator_members", test_operator_members),
	T("LspCompletion:text_bounds", test_text_bounds),
	T("LspCompletion:crlf", test_crlf),
	T("LspCompletion:open_calls", test_open_calls),
	T("LspCompletion:linear_scan", test_linear_scan),
	T("LspCompletion:context_positions", test_context_positions),
	T("LspCompletion:parameter_delimiters", test_parameter_delimiters),
	T("LspCompletion:index_setter_parameter", test_index_setter_parameter),
	T("LspCompletion:auto_operators", test_auto_operators),
	T("LspCompletion:lambda_bodies", test_lambda_bodies),
	T("LspCompletion:lambda_hints", test_lambda_hints),
	T("LspCompletion:type_positions", test_type_positions),
	T("LspCompletion:type_argument_adjacency", test_type_argument_adjacency),
	T("LspCompletion:ref_arguments", test_ref_arguments),
	T("LspCompletion:if_expressions", test_if_expressions),
	T("LspCompletion:nested_else", test_nested_else),
	T("LspCompletion:for_in", test_for_in),
	T("LspCompletion:keyword_sets", test_keyword_sets),
	T("LspCompletion:language_options", test_language_options),
	T("LspCompletion:pinned_keywords", test_pinned_keywords),
	T("LspCompletion:capability", test_capability),
	T("LspCompletion:parse_failure", test_parse_failure),
	T("LspCompletion:nothing_offered", test_nothing_offered),
	T("LspCompletion:text_edits", test_text_edits),
	T("LspCompletion:utf16_ranges", test_utf16_ranges),
	T("LspCompletion:positions_out_of_range", test_positions_out_of_range),
	T("LspCompletion:closed_document", test_closed_document),
	T("LspCompletion:project_options", test_project_options),
	T("LspCompletion:no_analysis", test_no_analysis),
	T("LspCompletion:cancellation_and_shutdown", test_cancellation_and_shutdown),
	T("LspCompletion:params", test_params),
	()
];

def S = LspCursorSyntax.render;
// The context at the "$" in {marked}.
def at(marked: string) -> LspCursorContext {
	var cursor = -1;
	var text = Vector<byte>.new();
	for (c in marked) {
		if (c == '$' && cursor < 0) cursor = text.length;
		else text.put(c);
	}
	return LspCursorScanner.new(text.extract()).scan(cursor);
}

def test_ref_arguments(t: Tester) {
	for (name in ["Ref", "ref"]) {
		for (trivia in ["", " ", " /* comment */ ", " // comment\n", " /* // */ /* next */ "]) {
			var marked = Strings.format2("var r: %s<%s$Pixel>;", name, trivia);
			t.asserti(AnalysisScopeKinds.LAYOUTS, LspCompletionRepair.kinds(at(marked)));
		}
	}
	for (marked in ["var r: Array<$Pixel>;", "var r: MoreRef<$Pixel>;", "var r: RefMore<$Pixel>;",
		"var r: C.Ref<$Pixel>;", "var r: C. /* comment */ Ref< /* comment */ $Pixel>;",
		"var r: Ref<Pixel, $int>;", "var r: Ref<Array<$int>>;"]) {
		t.asserti(AnalysisScopeKinds.TYPES, LspCompletionRepair.kinds(at(marked)));
	}
}
// Checks that the cursor in {marked} is in {place}.
def checkPlace(t: Tester, marked: string, place: LspCursorPlace) {
	var ctx = at(marked);
	if (ctx.place != place) t.fail3("%s: expected %s, got %s", marked, place.name, ctx.place.name);
	if (place != LspCursorPlace.CODE && ctx.syntax != 0) t.fail1("%s: expected no syntax outside code", marked);
}
// Checks the positions of the cursor in {marked}.
def checkSyntax(t: Tester, marked: string, expected: int) {
	var ctx = at(marked);
	if (ctx.place != LspCursorPlace.CODE) t.fail2("%s: expected CODE, got %s", marked, ctx.place.name);
	var e = S(expected), got = S(ctx.syntax);
	if (!Strings.equal(e, got)) t.fail3("%s: expected [%s], got [%s]", marked, e, got);
}
// The keywords offered at the cursor in {marked}, with the default forms,
// separated by spaces.
def offered(marked: string, forms: int) -> string {
	var words = LspKeywords.candidates(at(marked), AeneasAdapter.keywords(), forms);
	var buf = StringBuilder.new();
	for (i < words.length) {
		if (i > 0) buf.putc(' ');
		buf.puts(words[i]);
	}
	return buf.toString();
}
def DEFAULT_FORMS = AnalysisKeywordForms.FUN_EXPRS;
def checkOffered(t: Tester, marked: string, expected: string) {
	var got = offered(marked, DEFAULT_FORMS);
	if (!Strings.equal(expected, got)) t.fail3("%s: expected [%s], got [%s]", marked, expected, got);
}

def test_comments(t: Tester) {
	checkPlace(t, "// a $comment", LspCursorPlace.LINE_COMMENT);
	checkPlace(t, "/$/ between the slashes", LspCursorPlace.LINE_COMMENT);
	checkPlace(t, "$// before it", LspCursorPlace.CODE);
	checkPlace(t, "x // up to the end of the line$\n", LspCursorPlace.LINE_COMMENT);
	checkPlace(t, "x // a line comment\n$", LspCursorPlace.CODE);
	checkPlace(t, "x // at the end of the text$", LspCursorPlace.LINE_COMMENT);
	checkPlace(t, "/* a $block */", LspCursorPlace.BLOCK_COMMENT);
	checkPlace(t, "/* a block *$/", LspCursorPlace.BLOCK_COMMENT);
	checkPlace(t, "/* a block */$", LspCursorPlace.CODE);
	checkPlace(t, "/* over\nlines\n$ */", LspCursorPlace.BLOCK_COMMENT);
	// Block comments don't nest: the first "*/" ends both.
	checkPlace(t, "/* outer /* inner */ $ */", LspCursorPlace.CODE);
	checkPlace(t, "/*/ $ is not closed */", LspCursorPlace.BLOCK_COMMENT);
	checkPlace(t, "/* unterminated $", LspCursorPlace.BLOCK_COMMENT);
	checkPlace(t, "/* unterminated$", LspCursorPlace.BLOCK_COMMENT);
	checkPlace(t, "/* // a line comment inside */ $", LspCursorPlace.CODE);
	checkPlace(t, "// /* a block comment inside\n$", LspCursorPlace.CODE);
	// Comment markers in literals start no comment.
	checkPlace(t, "var s = \"// not a comment\"; $", LspCursorPlace.CODE);
	checkPlace(t, "var s = \"/* not a comment\"; $", LspCursorPlace.CODE);
	checkPlace(t, "var c = '/'; /$/", LspCursorPlace.LINE_COMMENT);
}

def test_strings(t: Tester) {
	checkPlace(t, "\"$\"", LspCursorPlace.STRING);
	checkPlace(t, "\"abc$\"", LspCursorPlace.STRING);
	checkPlace(t, "\"abc\"$", LspCursorPlace.CODE);
	checkPlace(t, "$\"abc\"", LspCursorPlace.CODE);
	checkPlace(t, "\"a\\\"b$\"", LspCursorPlace.STRING);	// "a\"b
	checkPlace(t, "\"a\\\\\"$", LspCursorPlace.CODE);	// "a\\" is closed
	checkPlace(t, "\"\\x41$\"", LspCursorPlace.STRING);
	checkPlace(t, "\"unterminated $", LspCursorPlace.STRING);
	checkPlace(t, "\"unterminated$", LspCursorPlace.STRING);
	// A string ends at a line break, where Aeneas reports it.
	checkPlace(t, "\"unterminated$\nx", LspCursorPlace.STRING);
	checkPlace(t, "\"unterminated\n$", LspCursorPlace.CODE);
	checkPlace(t, "\"tab\tends it\" $", LspCursorPlace.STRING);
	checkPlace(t, "\"\xC3\xA9 $\"", LspCursorPlace.STRING);
	checkPlace(t, "\"'\" $", LspCursorPlace.CODE);
}

def test_byte_literals(t: Tester) {
	checkPlace(t, "'$a'", LspCursorPlace.CHARACTER);
	checkPlace(t, "'a$'", LspCursorPlace.CHARACTER);
	checkPlace(t, "'a'$", LspCursorPlace.CODE);
	checkPlace(t, "$'a'", LspCursorPlace.CODE);
	checkPlace(t, "'\\''$", LspCursorPlace.CODE);
	checkPlace(t, "'\\'$'", LspCursorPlace.CHARACTER);
	checkPlace(t, "'\\x4$1'", LspCursorPlace.CHARACTER);
	checkPlace(t, "'\\x41'$", LspCursorPlace.CODE);
	checkPlace(t, "'\\\"' $", LspCursorPlace.CODE);
	checkPlace(t, "'\"'$", LspCursorPlace.CODE);
	checkPlace(t, "'$", LspCursorPlace.CHARACTER);
	checkPlace(t, "'a$", LspCursorPlace.CHARACTER);
	checkPlace(t, "'a$\n", LspCursorPlace.CHARACTER);
	checkPlace(t, "'a\n$", LspCursorPlace.CODE);
	// A malformed literal ends where Aeneas stops reading it.
	checkPlace(t, "'ab' $", LspCursorPlace.CHARACTER);
	checkPlace(t, "'ab'; x$", LspCursorPlace.CODE);
	checkPlace(t, "'' $", LspCursorPlace.CODE);
}

def checkPrefix(t: Tester, marked: string, prefix: string) {
	var ctx = at(marked);
	t.assert_string(prefix, ctx.prefix());
	t.asserti(ctx.cursor - prefix.length, ctx.prefixStart);
}
def test_prefix_range(t: Tester) {
	checkPrefix(t, "def f() { $whi }", "");
	checkPrefix(t, "def f() { w$hi }", "w");
	checkPrefix(t, "def f() { wh$i }", "wh");
	checkPrefix(t, "def f() { whi$ }", "whi");
	checkPrefix(t, "def f() { whi$", "whi");
	checkPrefix(t, "def f() { a_1$ }", "a_1");
	checkPrefix(t, "def f() { X9$ }", "X9");
	checkPrefix(t, "def f() { return$ }", "return");
	checkPrefix(t, "def f() { x = y$+1 }", "y");
	checkPrefix(t, "def f() { x = y+$1 }", "");
	// The look-back skips the prefix: it is in a statement either way.
	checkSyntax(t, "def f() { wh$ }", LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION);
	checkSyntax(t, "def f() { $ }", LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION);
}

def test_numbers(t: Tester) {
	checkPlace(t, "var x = 12$", LspCursorPlace.NUMBER);
	checkPlace(t, "var x = 1$2", LspCursorPlace.NUMBER);
	checkPlace(t, "var x = 0x1f$", LspCursorPlace.NUMBER);
	checkPlace(t, "var x = 1.5e3$", LspCursorPlace.NUMBER);
	checkPlace(t, "var x = 10u$", LspCursorPlace.NUMBER);
	checkPlace(t, "var x = f(_$", LspCursorPlace.NUMBER);
	checkPlace(t, "var x = 12 $", LspCursorPlace.CODE);
	t.assert_string("", at("var x = 0x1f$").prefix());
	// Every number form that NumberParser accepts is one literal, with a
	// signed exponent included.
	for (form in ["1e+3", "1e-3", "1E+3", "0e+3", "1.5e+3", "1.5E-3", "1.e+3",
			"0x1F", "0X1f_FF", "0x1Fu8", "0x1Fl", "0b1010", "0B1_010", "0b101u8",
			"1u", "1U", "1l", "1L", "1u8", "1i8", "1ul", "1f", "1F", "1d", "1D",
			"1.5f", "1.5d", "1_000", "1_000_000u32",
			// Fractional underscores, leading, trailing, and repeated, and an
			// empty fraction before an exponent or a suffix.
			"1._5e+3", "1._5", "1._e+3", "1._", "1.5_", "1.__5", "1.5__2",
			"1.f", "1._f", "0.f",
			// An underscore before an exponent.
			"1_e3", "1_e+3", "1__e-3",
			// The zero path takes the same fraction, exponent, and suffixes.
			"0._5e+3", "0.5_", "0._"]) {
		checkPlace(t, Strings.format1("var x = %s$", form), LspCursorPlace.NUMBER);
	}
	// An exponent with no digit ends before a float suffix, since
	// NumberParser reports its error without taking one.
	checkPlace(t, "var x = 1e+f$", LspCursorPlace.CODE);
	checkPrefix(t, "var x = 1e+f$", "f");
	checkPlace(t, "var x = 1.ef$", LspCursorPlace.CODE);
	checkPrefix(t, "var x = 1.ef$", "f");
	// A "." that begins no fraction stays outside the number, so a member
	// completion after it knows that it follows a number.
	var ctx = at("var x = 1.$");
	t.assertz(true, ctx.member());
	t.assertz(true, ctx.dotAfterNumber);
	ctx = at("var x = 0x1F.$");
	t.assertz(true, ctx.member());
	t.assertz(true, ctx.dotAfterNumber);
	ctx = at("var t = (1, 2); var x = t.0.$");
	t.assertz(true, ctx.member());
	t.assertz(true, ctx.dotAfterNumber);
	ctx = at("var x = 1e+3.$");
	t.assertz(true, ctx.member());
	t.assertz(true, ctx.dotAfterNumber);
}

def test_empty_fraction_operators(t: Tester) {
	for (number in ["0", "1", "12_3"]) {
		for (trivia in ["", " ", " /*c*/ ", " //c\n"]) {
			for (op in ["+", "-", "*", "/", "%", "^", "!=", "!==", "==", "===", "|", "||", "&", "&&",
				"<", "<=", "<<", "<<=", ">", ">=", ">>", ">>>", ">>=", ">>>=", "+=", "-=", "!", "?", "~"]) {
				var marked = Strings.format3("def f() { var x = %s.%s%s $; }", number, trivia, op);
				var last = op[op.length - 1];
				var syntax = LspCursorSyntax.EXPRESSION | if(last == '<', LspCursorSyntax.TYPE);
				checkOffered(t, marked, "false fun if null true");
				checkSyntax(t, marked, syntax);
				t.asserti(AnalysisScopeKinds.VALUES | if((syntax & LspCursorSyntax.TYPE) != 0, AnalysisScopeKinds.TYPES), LspCompletionRepair.kinds(at(marked)));
			}
			var marked = Strings.format2("def f() { var x = %s.%s+ loc$al; }", number, trivia);
			checkOffered(t, marked, "false fun if null true");
			checkSyntax(t, marked, LspCursorSyntax.EXPRESSION);
			t.asserti(AnalysisScopeKinds.VALUES, LspCompletionRepair.kinds(at(marked)));
			marked = Strings.format2("def f() { var x = %s.%s$; }", number, trivia);
			checkOffered(t, marked, "");
			checkSyntax(t, marked, LspCursorSyntax.MEMBER);
			t.asserti(0, LspCompletionRepair.kinds(at(marked)));
			for (op in ["++", "--"]) {
				marked = Strings.format3("def f() { g(%s.%s%s $); }", number, trivia, op);
				checkOffered(t, marked, "");
				checkSyntax(t, marked, 0);
				t.asserti(0, LspCompletionRepair.kinds(at(marked)));
			}
		}
		var parser = NumberParser.new(Arrays.concat(number, ".+"));
		t.assertz(true, parser.parse());
		t.assertz(true, parser.is_float);
		t.asserti(number.length + 1, parser.pos);
	}
	for (receiver in ["t.0", "t.1", "t.0.1", "int", "x", "V.Case", "0x1F", "0b1", "1e3", "1f", "1.5", "1 ", "0 "]) {
		for (trivia in ["", " ", " /*c*/ "]) {
			for (op in ["+", "==", "!"]) {
				var marked = Strings.format3("def f() { var x = %s.%s%s $; }", receiver, trivia, op);
				checkOffered(t, marked, "");
				checkSyntax(t, marked, 0);
				t.asserti(0, LspCompletionRepair.kinds(at(marked)));
			}
		}
	}
	for (receiver in ["t.0", "t.0.1", "0x1F"]) {
		var marked = Strings.format1("def f() { var x = %s.$; }", receiver);
		checkOffered(t, marked, "");
		checkSyntax(t, marked, LspCursorSyntax.MEMBER);
		t.asserti(0, LspCompletionRepair.kinds(at(marked)));
	}
	checkSyntax(t, "def f() { var x = 1.[$]; }", LspCursorSyntax.EXPRESSION);
	t.asserta("number index roles", [LspOpenRole.STATEMENTS, LspOpenRole.INDEX], at("def f() { var x = 1.[$]; }").roles, putRole);
	for (text in ["def f() { var x = 1.+2; }", "def f(t: (int, int)) { var x = t.0.+; }"]) {
		t.asserti(0, AeneasAdapter.parseFile("NumberDot.v3", text, []).diagnostics.length);
	}
}

def test_decimal_members(t: Tester) {
	for (index in ["0", "1", "12", "007", "0.1", "1.0"]) {
		for (trivia in ["", " ", " /*c*/ ", " //c\n"]) {
			var receiver = Strings.format2("t.%s%s", trivia, index);
			var marked = Strings.format1("def f() { var x = %s.$; }", receiver);
			checkOffered(t, marked, "");
			checkSyntax(t, marked, LspCursorSyntax.MEMBER);
			t.asserti(0, LspCompletionRepair.kinds(at(marked)));
			for (member in ["f", "F", "d", "D", "e", "E", "e3", "E3"]) {
				marked = Strings.format2("def f() { var x = %s.%s.$; }", receiver, member);
				checkOffered(t, marked, "");
				checkSyntax(t, marked, LspCursorSyntax.MEMBER);
				t.asserti(AnalysisScopeKinds.MEMBERS, LspCompletionRepair.kinds(at(marked)));
				t.assertz(false, at(marked).dotAfterNumber);
				for (op in ["+", "-"]) {
					marked = Strings.format3("def f() { var x = %s.%s%s $; }", receiver, member, op);
					checkOffered(t, marked, "false fun if null true");
					checkSyntax(t, marked, LspCursorSyntax.EXPRESSION);
					t.asserti(AnalysisScopeKinds.VALUES, LspCompletionRepair.kinds(at(marked)));
				}
			}
		}
	}
	for (suffix in ["f", "F", "d", "D", "e", "E", "u8", "i32"]) {
		var marked = Strings.format1("def f() { var x = t.0%s$; }", suffix);
		checkPlace(t, marked, LspCursorPlace.CODE);
		checkPrefix(t, marked, suffix);
	}
	checkPlace(t, "def f() { var x = t.0$12; }", LspCursorPlace.NUMBER);
	checkPlace(t, "def f() { var x = t.01$2; }", LspCursorPlace.NUMBER);
	checkSyntax(t, "def f() { var x = t.0.e+ loc$al; }", LspCursorSyntax.EXPRESSION);
	t.asserti(AnalysisScopeKinds.VALUES, LspCompletionRepair.kinds(at("def f() { var x = t.0.e+ loc$al; }")));
}

def test_member_after_dot(t: Tester) {
	var ctx = at("def f() { x.$ }");
	t.assertz(true, ctx.member());
	t.asserti(11, ctx.dot);
	t.asserti(LspCursorSyntax.MEMBER, ctx.syntax);
	ctx = at("def f() { x.fo$ }");
	t.assertz(true, ctx.member());
	t.assert_string("fo", ctx.prefix());
	t.asserti(11, ctx.dot);
	ctx = at("def f() { x . /* a\ncomment */ // and another\n\t$ }");
	t.assertz(true, ctx.member());
	t.asserti(12, ctx.dot);
	ctx = at("def f() { x.y$ }");
	t.assertz(true, ctx.member());
	ctx = at("def f() { x.y $ }");
	t.assertz(false, ctx.member());
	t.asserti(-1, ctx.dot);
	// A float's "." is part of the number, and ".." is no member access.
	t.assertz(false, at("var x = 1.5 $").member());
	t.assertz(false, at("x ... $").member());
	t.assertz(true, at("var t = (1, 2).$").member());
	t.assertz(true, at("var b = 3.$").member());
}

def test_operator_members(t: Tester) {
	var STMT = LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION;
	// Every operator member name that Parser.addMemberSuffix reads is one
	// complete operand, so no expression keyword is offered after it. An
	// operator and its "=" are one token even where the compound is illegal,
	// as Parser.parseInfix reads "===".
	var ops = ["!", "?", "~", "==", "!=", "||", "|", "&&", "&", "<=", "<<", "<<=", "<",
		">=", ">>", ">>=", ">>>", ">>>=", ">", "+", "+=", "-", "-=", "*", "*=", "/", "/=",
		"%", "%=", "^", "^=", "[]", "[]=", "===", "!==", "<==", ">=="];
	for (op in ops) {
		var after = Strings.format1("def f() { g(int.%s $) }", op);
		checkOffered(t, after, "");
		checkSyntax(t, after, 0);
	}
	// After one, a line break lets a new statement start, as after any
	// operand that a missing ";" leaves unseparated.
	checkSyntax(t, "def f() { int.==\n\t$ }", STMT);
	checkOffered(t, "def f() { int.==\n\t$ }", "break continue def false for fun if match null return true var while");
	// "||" and "&&" end before "=", as Parser.parseInfix returns them at
	// once; the "=" is the assignment, after which an expression starts.
	for (op in ["||", "&&"]) {
		var marked = Strings.format1("def f() { bool.%s= $; }", op);
		checkOffered(t, marked, "false fun if null true");
		checkSyntax(t, marked, LspCursorSyntax.EXPRESSION);
		var c = at(marked);
		t.asserta("logical assignment", [LspOpenRole.STATEMENTS], c.roles, putRole);
	}
	checkSyntax(t, "def f() { bool.||=$ }", LspCursorSyntax.EXPRESSION);
	checkSyntax(t, "def f() { bool.&&=$ }", LspCursorSyntax.EXPRESSION);
	// "!" and "?" may take adjacent type arguments, which open a TYPE_ARGS
	// delimiter of their own as after a type's name: the member is just the
	// one-byte name, and the type arguments are an ordinary type position.
	checkPrefix(t, "def f() { var y = Child.!<It$em>(x); }", "It");
	checkSyntax(t, "def f() { var y = Child.!<It$em>(x); }", LspCursorSyntax.TYPE);
	var ctx = at("def f() { var y = Child.!<It$em>(x); }");
	t.asserta("operator type arguments", [LspOpenRole.STATEMENTS, LspOpenRole.TYPE_ARGS], ctx.roles, putRole);
	checkSyntax(t, "def f() { var y = Child.!<$", LspCursorSyntax.TYPE);
	checkPlace(t, "def f() { var y = Child.!</* $ */ int>(x); }", LspCursorPlace.BLOCK_COMMENT);
	checkPlace(t, "def f() { var y = Child.?</* $ */ int>(x); }", LspCursorPlace.BLOCK_COMMENT);
	var repaired = LspCompletionRepair.repair(at("def f() { var x = int.!<$ }"));
	t.asserti(0, AeneasAdapter.parseFile("Repair.v3", repaired, []).diagnostics.length);
	// Only a one-byte "!" or "?" takes type arguments, and only when "<" is
	// adjacent, as Parser.addMemberSuffix checks with peek(1).
	checkSyntax(t, "def f() { x = int.! < $; }", LspCursorSyntax.EXPRESSION | LspCursorSyntax.TYPE);
	checkSyntax(t, "def f() { x = int.!=<$", LspCursorSyntax.EXPRESSION | LspCursorSyntax.TYPE);
	checkOffered(t, "def f() { g(V.Case.!<int> $) }", "");
	checkSyntax(t, "def f() { g(V.Case.!<int> $) }", 0);
	checkCalls(t, "def f() { V.Case.!<int>( $) }", [23]);
	checkCalls(t, "def f() { V.Case.!<Array<int>>( $) }", [30]);
	checkCalls(t, "def f() { V.Case.?<int>( $) }", [23]);
	// A call after an operator member is a call, not a group.
	checkCalls(t, "def f() { V.Case.!( $) }", [18]);
	checkCalls(t, "def f() { g(V.Case.!( $)) }", [11, 20]);
	checkCalls(t, "def f() { x.+($) }", [13]);
	checkCalls(t, "def f() { x.[]=($) }", [15]);
	// A completed operator member ends the member access.
	t.assertz(false, at("def f() { int.== $ }").member());
}

def test_for_in(t: Tester) {
	// "in" belongs to the loop variable's position alone, before an optional
	// type, at every form of the variable.
	checkOffered(t, "def f() { for (i $", "in");
	checkSyntax(t, "def f() { for (i $", LspCursorSyntax.FOR_IN);
	checkOffered(t, "def f() { for (i: int $", "in");
	checkSyntax(t, "def f() { for (i: int $", LspCursorSyntax.FOR_IN);
	checkOffered(t, "def f() { for (i: Array<int> $", "in");
	checkSyntax(t, "def f() { for (i: Array<int> $", LspCursorSyntax.FOR_IN);
	// At "<", "in", or "=" the position ends, so no "in" follows.
	for (marked in [
		"def f() { for (i < n $) }",
		"def f(n: int) { for (i: int < n >> 1 $) {} }",
		"def f(n: int) { for (i: A.B < n $) {} }",
		"def f(n: int) { for (i: int /*c*/ < n $) {} }",
		"def f(n: int) { for (i: Array<int> < n $) {} }",
		"def f() { for (i in xs $) }",
		"def f() { for (i = 0 $; i < n; i++) }",
		"def f() { for (i: int = 0 $; i < n; i++) }"
	]) {
		checkOffered(t, marked, "");
		checkSyntax(t, marked, 0);
		var ctx = at(marked);
		t.asserta("roles", [LspOpenRole.STATEMENTS, LspOpenRole.FOR], ctx.roles, putRole);
	}
	// In the clauses, after the header's first ";", "in" is not offered.
	checkOffered(t, "def f() { for (i = 0; i $", "");
	checkSyntax(t, "def f() { for (i = 0; i $", 0);
}

def test_text_bounds(t: Tester) {
	var ctx = at("$class C { }");
	t.asserti(0, ctx.cursor);
	t.asserti(0, ctx.prefixStart);
	t.asserti(LspCursorSyntax.TOP_LEVEL, ctx.syntax);
	ctx = at("$");
	t.asserti(LspCursorSyntax.TOP_LEVEL, ctx.syntax);
	t.asserti(0, ctx.opens.length);
	ctx = at("class C { def f() { va$");
	t.assert_string("va", ctx.prefix());
	t.asserti(2, ctx.opens.length);
	// Offsets are clamped to the text.
	var text = "def f() { }";
	t.asserti(0, LspCursorScanner.new(text).scan(-5).cursor);
	t.asserti(text.length, LspCursorScanner.new(text).scan(text.length + 5).cursor);
}

def test_crlf(t: Tester) {
	checkSyntax(t, "class C {\r\n\tdef f() {\r\n\t\t$", LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION);
	checkPlace(t, "// a comment\r\n$", LspCursorPlace.CODE);
	checkPlace(t, "// a comment\r$\n", LspCursorPlace.LINE_COMMENT);
	checkPlace(t, "\"a string\r\n$", LspCursorPlace.CODE);
	// A line break before the cursor lets a new statement start.
	checkSyntax(t, "def f() {\r\n\tx = y\r\n\t$", LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION);
}

def checkCalls(t: Tester, marked: string, expected: Array<int>) {
	var got = at(marked).calls();
	t.asserta("calls", expected, got, StringBuilder.putd<int>);
}
def test_open_calls(t: Tester) {
	checkCalls(t, "def f() { g($", [11]);
	checkCalls(t, "def f() { g(a, h(b, $", [11, 16]);
	checkCalls(t, "def f() { g(a, h(b), $", [11]);
	checkCalls(t, "def f() { g(a, \"(\", '(', /* ( */ $", [11]);
	checkCalls(t, "def f() { x.m<int>(a, $", [18]);
	checkCalls(t, "def f() { C.new($", [15]);
	checkCalls(t, "def f() { g(a)($", [14]);
	checkCalls(t, "def f() { a[g($", [13]);
	// Not calls: control, grouping, tuples, and parameter lists.
	checkCalls(t, "def f() { if ($", []);
	checkCalls(t, "def f() { while (g($", [18]);
	checkCalls(t, "def f() { x = ($", []);
	checkCalls(t, "def f($", []);
	checkCalls(t, "class C($", []);
	checkCalls(t, "def f() { var g = fun ($", []);
	checkCalls(t, "class C { new($", []);
	var ctx = at("class C { def f() { if (g(a[$");
	t.asserta("opens", [8, 18, 23, 25, 27], ctx.opens, StringBuilder.putd<int>);
	var roles = [LspOpenRole.MEMBERS, LspOpenRole.STATEMENTS, LspOpenRole.CONTROL, LspOpenRole.CALL, LspOpenRole.INDEX];
	t.asserti(5, ctx.roles.length);
	for (i < roles.length) if (i < ctx.roles.length && ctx.roles[i] != roles[i]) t.fail2("role %d: %s", i, ctx.roles[i].name);
}

// Deep nesting, long lines, and many comments scan in one pass; stray
// closers are skipped at once.
def test_linear_scan(t: Tester) {
	var buf = StringBuilder.new();
	buf.puts("def f() { ");
	for (i < 20000) buf.puts("g(");
	buf.puts("a, ");
	var ctx = at(buf.puts("$").toString());
	t.asserti(20000, ctx.calls().length);
	t.asserti(LspCursorSyntax.EXPRESSION, ctx.syntax);
	buf.puts("def f() { ");
	for (i < 20000) buf.puts("{");
	for (i < 20000) buf.puts(")]");
	ctx = at(buf.puts("$").toString());
	t.asserti(20001, ctx.opens.length);
	for (i < 20000) buf.puts("/* c */ x;");
	ctx = at(buf.puts("$").toString());
	t.asserti(LspCursorSyntax.TOP_LEVEL, ctx.syntax);
	// Lambdas nested in hints' arguments, each with its header pending.
	buf = StringBuilder.new();
	buf.puts("def f() { ");
	for (i < 20000) buf.puts("g(fun () #hint(");
	var nested = buf.puts("fun ();").toString();
	ctx = at(Strings.format1("%s, $", nested));
	t.asserti(20000, ctx.calls().length);
	t.asserti(LspCursorSyntax.EXPRESSION, ctx.syntax);
	buf.puts(nested);
	for (i < 20000) buf.puts(") ;)");
	ctx = at(buf.puts("; $").toString());
	t.asserti(1, ctx.opens.length);
	t.asserti(LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION, ctx.syntax);
	buf = StringBuilder.new().puts("def f() { ");
	for (i < 100000) buf.puts("g(t.0.f, 1. + ");
	var chain = buf.toString();
	ctx = at(Arrays.concat(chain, "$"));
	t.asserti(100000, ctx.calls().length);
	t.asserti(LspCursorSyntax.EXPRESSION, ctx.syntax);
	t.asserti(AnalysisScopeKinds.VALUES, LspCompletionRepair.kinds(ctx));
	buf.puts(chain);
	for (i < 100000) buf.puts(")");
	ctx = at(buf.puts("; $").toString());
	t.asserti(1, ctx.opens.length);
	t.asserti(LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION, ctx.syntax);
}

def test_parameter_delimiters(t: Tester) {
	var indexed = [
		"class C { def [va$ }",
		"class C { def [$ }",
		"class C { def [a: int, $ }",
		"class C { def [a: Array<(int, bool)>, $ }",
		"class C { def [a: (int, Array<bool>), va$] = value: int {} }",
		"class C { private def [a: int, $] -> int; }"
	];
	for (marked in indexed) {
		checkOffered(t, marked, "var");
		checkSyntax(t, marked, LspCursorSyntax.PARAMETER);
		checkCalls(t, marked, []);
		t.asserta("indexed roles", [LspOpenRole.MEMBERS, LspOpenRole.INDEX_PARAMS], at(marked).roles, putRole);
	}
	var variant = "type V { case C { def [$ } }";
	checkOffered(t, variant, "var");
	checkSyntax(t, variant, LspCursorSyntax.PARAMETER);
	t.asserta("variant index", [LspOpenRole.VARIANT, LspOpenRole.MEMBERS, LspOpenRole.INDEX_PARAMS], at(variant).roles, putRole);
	var typed = "class C { def [a: Array<(int, $";
	checkOffered(t, typed, "");
	checkSyntax(t, typed, LspCursorSyntax.TYPE);
	t.asserta("nested types", [LspOpenRole.MEMBERS, LspOpenRole.INDEX_PARAMS, LspOpenRole.TYPE_ARGS, LspOpenRole.TYPES], at(typed).roles, putRole);
	checkOffered(t, "class C { def [var $", "");
	checkSyntax(t, "class C { def [a: int) , $", LspCursorSyntax.PARAMETER);
	t.asserta("closed index", [LspOpenRole.MEMBERS], at("class C { def [a: (int, bool)] $").roles, putRole);
	t.asserta("index recovery", [LspOpenRole.MEMBERS], at("class C { def [a: int; $").roles, putRole);
	checkOffered(t, "class C { def [a: int] -> int { $", "break continue def false for fun if match null return true var while");
	checkOffered(t, "class C { def [a: int] = value: int { $", "break continue def false for fun if match null return true var while");
	checkOffered(t, "def f() { a[$", "false fun if null true");

	var patterns = [
		"match (x) { Some($ }",
		"match (x) { V.Some(a, $ }",
		"match (x) { V.Some($ }",
		"match (x) { V.N.Some(a, _, $ }",
		"match (x) { V<int>.Some(a, $ }",
		"match (x) { V<Array<(int, bool)>>.Some<int>($ }",
		"match (x) { None, V.Some($ }",
		"match (x) { Some(a) => g(); V.Some($ }",
		"match (x) { Some(a) => { g(); } V.Some($ }"
	];
	for (marked in patterns) {
		checkOffered(t, marked, "");
		checkSyntax(t, marked, 0);
		checkCalls(t, marked, []);
		t.asserta("pattern roles", [LspOpenRole.MATCH, LspOpenRole.PATTERN_PARAMS], at(marked).roles, putRole);
	}
	t.asserta("nested patterns", [LspOpenRole.MATCH, LspOpenRole.MATCH, LspOpenRole.PATTERN_PARAMS],
		at("match (x) { Some(a) => match (a) { V.Some(_, $ }").roles, putRole);
	var body = "match (x) { Some(a) => g($ }";
	checkOffered(t, body, "false fun if null true");
	t.asserta("arm call", [LspOpenRole.MATCH, LspOpenRole.CALL], at(body).roles, putRole);
	t.asserti(1, at(body).calls().length);
	checkSyntax(t, "match (x) { V.Some(a), $ }", LspCursorSyntax.PATTERN);
	checkOffered(t, "match (x) { V.Some(a) => $ }", "break continue def false for fun if match null return true var while");
}

def test_index_setter_parameter(t: Tester) {
	for (marked in [
		"class C { def [i: int] = va$ }",
		"class C { def [i: int] = $ }",
		"class C { private def [i: Array<(int, bool)>] /* c */ = /* c */ $ }",
		"component C { def [i: int, j: int]\n=\n$ }"
	]) {
		checkOffered(t, marked, "var");
		checkSyntax(t, marked, LspCursorSyntax.PARAMETER);
		checkCalls(t, marked, []);
		t.asserta("setter roles", [LspOpenRole.MEMBERS], at(marked).roles, putRole);
		t.assert_string("var", labels(t, marked));
	}
	checkOffered(t, "type V { case C { def [i: int] = $ } }", "var");
	checkOffered(t, "class C { def [i: int] = var $ }", "");
	checkOffered(t, "class C { def [i: int] = value $ }", "");
	checkSyntax(t, "class C { def [i: int] = value: $ }", LspCursorSyntax.TYPE);
	var typed = "class C { def [i: int] = var value: Array<(int, $";
	checkSyntax(t, typed, LspCursorSyntax.TYPE);
	checkOffered(t, typed, "");
	t.asserta("setter type roles", [LspOpenRole.MEMBERS, LspOpenRole.TYPE_ARGS, LspOpenRole.TYPES], at(typed).roles, putRole);
	checkOffered(t, "class C { def [i: int] = value: int; $ }", "def new private var");
	checkSyntax(t, "class C { def [i: int] = value: int { $ } }", LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION);
	checkOffered(t, "class C { def [i: int] => $ }", "false fun if null true");
	checkOffered(t, "class C { var x = $ }", "false fun if null true");
	checkOffered(t, "def f() { a[i] = $ }", "false fun if null true");
	t.asserti(0, AeneasAdapter.parseFile("setter.v3", "class C { def [i: int] = var value: int {} }", []).diagnostics.length);
}

def test_auto_operators(t: Tester) {
	var EXPR = LspCursorSyntax.EXPRESSION;
	var STMT = LspCursorSyntax.STATEMENT | EXPR;
	for (op in ["++", "--"]) {
		for (marked in [
			"def f() { g(i%s $) }",
			"def f() { a[i%s $] }",
			"def f() { if (i%s $) {} }",
			"def f() { i%s $ }",
			"def f() { g(a[i]%s $) }",
			"def f() { g(h()%s $) }",
			"def f() { g((i)%s $) }"
		]) {
			var text = Strings.format1(marked, op);
			checkOffered(t, text, "");
			checkSyntax(t, text, 0);
		}
		for (marked in ["def f() { i%s\n wh$ }", "def f() { i%s; wh$ }"]) {
			var text = Strings.format1(marked, op);
			checkSyntax(t, text, STMT);
			t.assert_string("break continue def false for fun if match null return true var while", labels(t, text));
		}
		for (marked in [
			"def f() { g(%s$) }",
			"def f() { a[%s$] }",
			"def f() { %s$ }",
			"def f() { return %s$ }",
			"def f() { if (x) %s$ }",
			"def f() { while (x) %s$ }",
			"def f() { for (i < n) %s$ }",
			"def f() { {} %s$ }",
			"def f() { g(i > %s$) }",
			"def f() { g(i + %s$) }"
		]) {
			var text = Strings.format1(marked, op);
			checkOffered(t, text, "false fun if null true");
			checkSyntax(t, text, EXPR);
		}
		checkSyntax(t, Strings.format1("def f() { g(%sx $) }", op), 0);
		checkSyntax(t, Strings.format1("def f() { %sx\n wh$ }", op), STMT);
		checkSyntax(t, Strings.format1("def f() { for (i = 0; i < n; i%s $) }", op), 0);
		checkSyntax(t, Strings.format1("def f() { for (i = 0; i < n; %s$) }", op), EXPR);
		checkOffered(t, Strings.format1("def f() { g(i%s, $) }", op), "false fun if null true");
		checkSyntax(t, Strings.format1("def f() { i\n%s $ }", op), 0);
		t.asserti(0, AeneasAdapter.parseFile("auto.v3", Strings.format2("def f() { var i = 0; %si; i%s; }", op, op), []).diagnostics.length);
	}
}

def test_context_positions(t: Tester) {
	var STMT = LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION;
	var EXPR = LspCursorSyntax.EXPRESSION;
	var TYPE = LspCursorSyntax.TYPE;
	checkSyntax(t, "$", LspCursorSyntax.TOP_LEVEL);
	checkSyntax(t, "class A { }\n$", LspCursorSyntax.TOP_LEVEL);
	checkSyntax(t, "var x = 1;\n$", LspCursorSyntax.TOP_LEVEL);
	checkSyntax(t, "def f() { }\n$", LspCursorSyntax.TOP_LEVEL);
	checkSyntax(t, "class A { $ }", LspCursorSyntax.MEMBER_DECL);
	checkSyntax(t, "component A { def f() { } $ }", LspCursorSyntax.MEMBER_DECL);
	checkSyntax(t, "class A { var x: int; $ }", LspCursorSyntax.MEMBER_DECL);
	checkSyntax(t, "type V { $ }", LspCursorSyntax.CASE_DECL);
	checkSyntax(t, "type V { case A; $ }", LspCursorSyntax.CASE_DECL);
	checkSyntax(t, "type V { case A { $ } }", LspCursorSyntax.MEMBER_DECL);
	checkSyntax(t, "enum E { A, $ }", 0);
	checkSyntax(t, "layout L { $ }", 0);
	checkSyntax(t, "def f() { $ }", STMT);
	checkSyntax(t, "def f() { x = 1; $ }", STMT);
	checkSyntax(t, "def f() { { } $ }", STMT);
	checkSyntax(t, "def f() { while (x) $ }", STMT);
	checkSyntax(t, "def f() { for (i < n) $ }", STMT);
	checkSyntax(t, "def f() { for (i = 0; i < n; i++) $ }", STMT);
	checkSyntax(t, "def f() { if (x) y(); else $ }", STMT);
	checkSyntax(t, "def f() { if (x) y(); $ }", STMT | LspCursorSyntax.ELSE);
	checkSyntax(t, "def f() { if (x) { y(); } $ }", STMT | LspCursorSyntax.ELSE);
	checkSyntax(t, "def f() { while (x) if (y) z(); $ }", STMT | LspCursorSyntax.ELSE);
	checkSyntax(t, "def f() { if (x) y(); else z(); $ }", STMT);
	checkSyntax(t, "def f() { if (x) y(); else if (z) w(); $ }", STMT | LspCursorSyntax.ELSE);
	checkSyntax(t, "def f() { while (x) { } $ }", STMT);
	checkSyntax(t, "def f() { match (x) { } $ }", STMT | LspCursorSyntax.ELSE);
	checkSyntax(t, "def f() { var y = if(a, b, c); $ }", STMT);
	checkSyntax(t, "def f() { match (x) $ }", 0);
	checkSyntax(t, "def f() { match (x) { $ } }", LspCursorSyntax.PATTERN);
	checkSyntax(t, "def f() { match (x) { A, $ } }", LspCursorSyntax.PATTERN);
	checkSyntax(t, "def f() { match (x) { A => $ } }", STMT);
	checkSyntax(t, "def f() { match (x) { A => y(); $ } }", LspCursorSyntax.PATTERN);
	checkSyntax(t, "def f() { match (x) { A => { } $ } }", LspCursorSyntax.PATTERN);
	checkSyntax(t, "def f() { match (x) { A => { $ } } }", STMT);
	checkSyntax(t, "def f() { if (x) match (y) { $ } }", LspCursorSyntax.PATTERN);
	checkSyntax(t, "def f() { var y = $ }", EXPR);
	checkSyntax(t, "def f() { return $ }", EXPR);
	checkSyntax(t, "def f() { x = a + $ }", EXPR);
	checkSyntax(t, "def f() { x = !$ }", EXPR);
	checkSyntax(t, "def f() { g($ }", EXPR);
	checkSyntax(t, "def f() { g(a, $ }", EXPR);
	checkSyntax(t, "def f() { a[$ }", EXPR);
	checkSyntax(t, "def f() { if ($ }", EXPR);
	checkSyntax(t, "def f() { x = a < $ }", EXPR | TYPE);
	checkSyntax(t, "def f() => $", EXPR);
	checkSyntax(t, "def x = $", EXPR);
	checkSyntax(t, "class A { def f() -> int => $ }", EXPR);
	checkSyntax(t, "def f() { var g = fun (x: int) => $ }", EXPR);
	checkSyntax(t, "def f() { g(fun () { $ }) }", STMT);
	// After an operand, an operator follows; or after a line break, a new
	// statement that a missing ";" leaves unseparated.
	checkSyntax(t, "def f() { x = y $ }", 0);
	checkSyntax(t, "def f() { x = g(y) $ }", 0);
	checkSyntax(t, "def f() { x = y\n\t$ }", STMT);
	checkSyntax(t, "def f() { g(y $ }", 0);
	checkSyntax(t, "def f() { g(y\n\t$ }", 0);
	checkSyntax(t, "def f() { x = true $ }", 0);
	// Types and names.
	checkSyntax(t, "def f(x: $", TYPE);
	checkSyntax(t, "def f() -> $", TYPE);
	checkSyntax(t, "var x: $", TYPE);
	checkSyntax(t, "class A extends $", TYPE);
	checkSyntax(t, "def f() { var x: $ }", TYPE);
	checkSyntax(t, "def f() { match (x) { y: $ } }", TYPE);
	checkSyntax(t, "def f($", LspCursorSyntax.PARAMETER);
	checkSyntax(t, "def f<T>(a: T, $", LspCursorSyntax.PARAMETER);
	checkSyntax(t, "class A($", LspCursorSyntax.PARAMETER);
	checkSyntax(t, "class A { new($", LspCursorSyntax.PARAMETER);
	checkSyntax(t, "def f() { var g = fun ($", LspCursorSyntax.PARAMETER);
	checkSyntax(t, "type V(x: int, $", LspCursorSyntax.PARAMETER);
	checkSyntax(t, "enum E($", 0);
	checkSyntax(t, "type V { case A($", 0);
	checkSyntax(t, "packing P($", 0);
	checkSyntax(t, "def $", 0);
	checkSyntax(t, "class $", 0);
	checkSyntax(t, "def f() { var $", 0);
	checkSyntax(t, "def f() { for ($", 0);
	checkSyntax(t, "def f() { for (x $", LspCursorSyntax.FOR_IN);
	checkSyntax(t, "def f() { for (x: int $", LspCursorSyntax.FOR_IN);
	checkSyntax(t, "def f() { for (x = 0; x $", 0);
	checkSyntax(t, "def f() { for (x in $", EXPR);
	// Headers.
	checkSyntax(t, "class A $", LspCursorSyntax.CLASS_HEADER);
	checkSyntax(t, "class A<T> $", LspCursorSyntax.CLASS_HEADER);
	checkSyntax(t, "class A(x: int) $", LspCursorSyntax.CLASS_HEADER);
	checkSyntax(t, "class A extends B $", LspCursorSyntax.CLASS_HEADER);
	checkSyntax(t, "type V $", LspCursorSyntax.VARIANT_HEADER);
	checkSyntax(t, "type V(x: int) $", LspCursorSyntax.VARIANT_HEADER);
	checkSyntax(t, "class A { new(x: int) $", LspCursorSyntax.CONSTRUCTOR_HEADER);
	checkSyntax(t, "class A { new(x: int) : $", TYPE | LspCursorSyntax.CONSTRUCTOR_HEADER);
	checkSyntax(t, "class A { def f(x: int) $", 0);
	// Modifiers.
	checkSyntax(t, "private $", LspCursorSyntax.AFTER_PRIVATE);
	checkSyntax(t, "class A { private $", LspCursorSyntax.AFTER_PRIVATE_MEMBER);
	checkSyntax(t, "class A { def $", LspCursorSyntax.AFTER_DEF_MEMBER);
	checkSyntax(t, "thread $", LspCursorSyntax.AFTER_THREAD);
	checkSyntax(t, "import $", LspCursorSyntax.AFTER_IMPORT);
	checkSyntax(t, "import \"name\" $", LspCursorSyntax.AFTER_IMPORT);
	checkSyntax(t, "export $", LspCursorSyntax.AFTER_EXPORT);
	checkSyntax(t, "export \"name\" $", LspCursorSyntax.AFTER_EXPORT);
	// Hints and members.
	checkSyntax(t, "type V #$", 0);
	checkSyntax(t, "def f() { x.$ }", LspCursorSyntax.MEMBER);
	checkSyntax(t, "def f() { C.new.$ }", LspCursorSyntax.MEMBER);
}

// A lambda's body may be a block or an empty ";" inside parentheses or
// brackets, and neither ends the enclosing statement or call.
def test_lambda_bodies(t: Tester) {
	var STMT = LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION;
	var EXPR = LspCursorSyntax.EXPRESSION;
	checkOffered(t, "def f() { g(fun ();, $); }", "false fun if null true");
	checkCalls(t, "def f() { g(fun ();, $); }", [11]);
	checkCalls(t, "def f() { g(a, h(fun x;, $", [11, 16]);
	checkCalls(t, "def f() { g(fun () -> int;, $", [11]);
	checkCalls(t, "def f() { g(fun () -> Array<int>;, $", [11]);
	checkCalls(t, "def f() { g(fun () { x(); y(); }, $", [11]);
	checkCalls(t, "def f() { g(fun () => x;, $", []);
	checkCalls(t, "def f() { a[fun ();, $", []);
	checkSyntax(t, "def f() { a[fun ();, $", EXPR);
	checkSyntax(t, "def f() { g(fun () { x(); $", STMT);
	checkSyntax(t, "def f() { g(fun () { if (x) y(); $", STMT | LspCursorSyntax.ELSE);
	// After a lambda, an operator or a separator follows.
	checkSyntax(t, "def f() { g(fun (); $", 0);
	checkSyntax(t, "def f() { g(fun () { } $", 0);
	checkSyntax(t, "def f() { var h = fun () { } $ }", 0);
	checkSyntax(t, "def f() { var h = fun ();$ }", 0);
	checkSyntax(t, "def f() { var h = fun ();; $ }", STMT);
	checkSyntax(t, "def f() { var h = fun () { }; $ }", STMT);
	checkSyntax(t, "def f() { var h = fun () { }\n\t$ }", STMT);
	// In a match case, a lambda's "=>" begins its body, not a case.
	checkSyntax(t, "def f() { match (x) { A => g(fun () => $", EXPR);
	checkSyntax(t, "def f() { match (x) { A => var h = fun () => y; $", LspCursorSyntax.PATTERN);
	// A header that goes wrong is no lambda's.
	checkCalls(t, "def f() { g(fun, h(); $", []);
	checkSyntax(t, "def f() { g(fun 1 { $", STMT);
}

// Representation hints may follow a lambda's parameters or return type, and
// a lambda in a hint's arguments has a header of its own.
def test_lambda_hints(t: Tester) {
	var STMT = LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION;
	var EXPR = LspCursorSyntax.EXPRESSION;
	var cases = [
		"def f() { g(fun () #no-inline ;, $); }",
		"def f() { g(fun () #hint<int,int> ;, $); }",
		"def f() { g(fun () #hint(fun ();) ;, $); }",
		"def f() { g(fun () #hint(fun ();, h(fun () #no-inline ;)) ;, $); }",
		"def f() { g(fun () #inline #hint<Array<int>> { }, $); }",
		"def f() { g(fun () -> int #inline => 1, $); }",
		"def f() { g(fun () -> int #no-inline { return 1; }, $); }",
		"def f() { g(fun () -> Array<int> #hint<(int, bool)> => null, $); }",
		"def f() { g(fun (x: int) -> int #hint:x-y => x, $); }",
		"def f() { g(fun () #boxed ;, $); }",
		"def f() { g(fun () #unboxed ;, $); }",
		"def f() { g(fun () #packed ;, $); }",
		"def f() { g(fun () #big-endian ;, $); }",
		"def f() { g(fun () #custom ;, $); }",
		"def f() { g(fun #inline ;, $); }",
		// "#packing", whose label is a keyword, and its packing expressions.
		"def f() { g(fun () #packing(0) ;, $); }",
		"def f() { g(fun () #packing(0b1?x, f(y)) ;, $); }",
		"def f() { g(fun () #packing 0 ;, $); }",
		"def f() { g(fun () #packing -1 ;, $); }",
		"def f() { g(fun () #packing 0x0F ;, $); }",
		"def f() { g(fun () #packing 0.5 ;, $); }",
		"def f() { g(fun () #packing 1u8 ;, $); }",
		// Number forms, including signed exponents, whose sign must stay in
		// the literal rather than cancel the lambda's header.
		"def f() { g(fun () #packing 1e+3 ;, $); }",
		"def f() { g(fun () #packing 1e-3 ;, $); }",
		"def f() { g(fun () #packing 1.5e+3 ;, $); }",
		"def f() { g(fun () #packing 1.e+3 ;, $); }",
		"def f() { g(fun () #packing 1._5e+3 ;, $); }",
		"def f() { g(fun () #packing 1._ ;, $); }",
		"def f() { g(fun () #packing 0b1010 ;, $); }",
		"def f() { g(fun () #packing 1_000 ;, $); }",
		"def f() { g(fun () #packing 1.5d ;, $); }",
		"def f() { g(fun () #packing 0X1f_FF ;, $); }",
		"def f() { g(fun () #packing 0b1?x ;, $); }",
		"def f() { g(fun () #packing 0b??_01xy ;, $); }",
		"def f() { g(fun () #packing #concat(a, 0b01) ;, $); }",
		"def f() { g(fun () #packing #solve(a, b) ;, $); }",
		"def f() { g(fun () #packing f ;, $); }",
		"def f() { g(fun () #packing f(0, x) ;, $); }",
		"def f() { g(fun () #packing f<int>(x) ;, $); }",
		"def f() { g(fun () #packing f<int, bool> ;, $); }",
		"def f() { g(fun () #packing 0 { }, $); }",
		"def f() { g(fun () #packing 0 #inline ;, $); }",
		"def f() { g(fun () #inline #packing 0 ;, $); }",
		"def f() { g(fun #packing 0 ;, $); }",
		"def f() { g(fun () -> int #packing 0 => 1, $); }",
		"def f() { g(fun () -> int #packing(0) { return 1; }, $); }",
		"def f() { g(fun () -> int #packing 0b1?x #no-inline => 1, $); }"
	];
	for (marked in cases) {
		checkOffered(t, marked, "false fun if null true");
		checkCalls(t, marked, [11]);
	}
	// In a hint.
	checkOffered(t, "def f() { g(fun () #no-in$", "");
	checkPrefix(t, "def f() { g(fun () #no-in$", "no-in");
	checkSyntax(t, "def f() { g(fun () #hint($", EXPR);
	checkSyntax(t, "def f() { g(fun () #hint<$", LspCursorSyntax.TYPE);
	checkSyntax(t, "def f() { g(fun () #hint<int, $", LspCursorSyntax.TYPE);
	checkSyntax(t, "def f() { g(fun () #hint(fun () { $", STMT);
	checkCalls(t, "def f() { g(fun () #hint(h($", [11, 26]);
	var ctx = at("def f() { g(fun () #hint($");
	t.asserta("roles", [LspOpenRole.STATEMENTS, LspOpenRole.CALL, LspOpenRole.HINT_ARGS], ctx.roles, putRole);
	ctx = at("def f() { g(fun () #packing($");
	t.asserta("roles", [LspOpenRole.STATEMENTS, LspOpenRole.CALL, LspOpenRole.HINT_ARGS], ctx.roles, putRole);
	checkSyntax(t, "def f() { g(fun () #packing f<$", LspCursorSyntax.TYPE);
	checkCalls(t, "def f() { g(fun () #packing f($", [11, 29]);
	// After a hint, the body begins, and after it, an operator or a separator.
	checkSyntax(t, "def f() { g(fun () #inline { $", STMT);
	checkSyntax(t, "def f() { g(fun () -> int #inline => $", EXPR);
	checkSyntax(t, "def f() { g(fun () #no-inline ; $", 0);
	checkSyntax(t, "def f() { var h = fun () #no-inline ; $ }", 0);
	// A hint does not make a header of what is no lambda's.
	checkCalls(t, "def f() { g(fun () #inline + h(); $", []);
	checkCalls(t, "def f() { g(fun () #packing 0 + h(); $", []);
	checkCalls(t, "def f() { g(fun () #inline 0; $", []);
	checkCalls(t, "def f() { g(fun () #inline -1; $", []);
	checkCalls(t, "def f() { g(fun () #packing 0 #hint(fun () 1;) ; $", []);
	// Outside a lambda's header, "#packing" is still read as the keyword.
	checkSyntax(t, "type T(a: u8) #packing P($", 0);
	ctx = at("type T(a: u8) #packing P($");
	t.asserta("roles", [LspOpenRole.PARAMS], ctx.roles, putRole);
}

def test_type_argument_adjacency(t: Tester) {
	for (name in ["int", "A.B", "Array<int>.B", "Ref", "ref"]) {
		for (trivia in [" ", "\t", "\n", "/**/", " /*c*/ ", " //c\n"]) {
			var marked = Strings.format2("def f(n: int) { for (i: %s%s< $) {} }", name, trivia);
			checkOffered(t, marked, "false fun if null true");
			checkSyntax(t, marked, LspCursorSyntax.EXPRESSION | LspCursorSyntax.TYPE);
			t.asserta("comparison roles", [LspOpenRole.STATEMENTS, LspOpenRole.FOR], at(marked).roles, putRole);
			marked = Strings.format2("def f(n: int) { for (i: %s%s< n >> 1 $) {} }", name, trivia);
			checkOffered(t, marked, "");
			checkSyntax(t, marked, 0);
			t.asserta("limit roles", [LspOpenRole.STATEMENTS, LspOpenRole.FOR], at(marked).roles, putRole);
			marked = Strings.format2("var x: %s%s< $", name, trivia);
			checkOffered(t, marked, "false fun if null true");
			checkSyntax(t, marked, LspCursorSyntax.EXPRESSION | LspCursorSyntax.TYPE);
			t.asserti(0, at(marked).roles.length);
			t.asserti(AnalysisScopeKinds.VALUES | AnalysisScopeKinds.TYPES, LspCompletionRepair.kinds(at(marked)));
		}
	}
	for (name in ["Array", "A.B", "Array<int>.B"]) {
		var marked = Strings.format1("def f() { for (i: %s<$int>) {} }", name);
		checkOffered(t, marked, "");
		checkSyntax(t, marked, LspCursorSyntax.TYPE);
		t.asserta("adjacent type roles", [LspOpenRole.STATEMENTS, LspOpenRole.FOR, LspOpenRole.TYPE_ARGS], at(marked).roles, putRole);
		marked = Strings.format1("def f() { for (i: %s<int> $) {} }", name);
		checkOffered(t, marked, "in");
		checkSyntax(t, marked, LspCursorSyntax.FOR_IN);
		t.asserta("closed type roles", [LspOpenRole.STATEMENTS, LspOpenRole.FOR], at(marked).roles, putRole);
	}
	for (trivia in [" ", "/**/", " //c\n"]) {
		var marked = Strings.format1("def f() { g(fun () #packing f%s< $", trivia);
		checkOffered(t, marked, "false fun if null true");
		checkSyntax(t, marked, LspCursorSyntax.EXPRESSION | LspCursorSyntax.TYPE);
		t.asserta("packing comparison roles", [LspOpenRole.STATEMENTS, LspOpenRole.CALL], at(marked).roles, putRole);
		marked = Strings.format1("def f() { g(fun () #hint%s< $", trivia);
		checkOffered(t, marked, "");
		checkSyntax(t, marked, LspCursorSyntax.TYPE);
		t.asserta("hint type roles", [LspOpenRole.STATEMENTS, LspOpenRole.CALL, LspOpenRole.TYPE_ARGS], at(marked).roles, putRole);
		marked = Strings.format1("class A%s< $", trivia);
		checkOffered(t, marked, "false fun if null true");
		checkSyntax(t, marked, LspCursorSyntax.EXPRESSION | LspCursorSyntax.TYPE);
	}
}

// Tuple types, type arguments, and function types stay type positions.
def test_type_positions(t: Tester) {
	var TYPE = LspCursorSyntax.TYPE;
	checkOffered(t, "def f(x: ($)) {}", "");
	checkOffered(t, "def f(x: Array<$>) {}", "");
	checkSyntax(t, "def f(x: ($)) {}", TYPE);
	checkSyntax(t, "def f(x: Array<$>) {}", TYPE);
	checkSyntax(t, "def f(x: (int, $", TYPE);
	checkSyntax(t, "def f(x: ((int, $", TYPE);
	checkSyntax(t, "def f(x: Array<(int, $", TYPE);
	checkSyntax(t, "def f(x: HashMap<int, $", TYPE);
	checkSyntax(t, "def f(x: Array<Array<$", TYPE);
	checkSyntax(t, "def f(x: A.B<$", TYPE);
	checkOffered(t, "def f(x: V<int>.A<$>) {}", "");
	checkSyntax(t, "def f(x: V<int>.A<$", TYPE);
	checkSyntax(t, "def f(x: V<int>.A<int>.B<$", TYPE);
	checkSyntax(t, "def f(x: V<int>.$", LspCursorSyntax.MEMBER);
	checkSyntax(t, "def f(x: (int -> $", TYPE);
	checkSyntax(t, "def f() -> ($", TYPE);
	checkSyntax(t, "def f() -> Array<$", TYPE);
	checkSyntax(t, "var x: ($", TYPE);
	checkSyntax(t, "var x: Array<$", TYPE);
	checkSyntax(t, "def f() { var x: (int, $ }", TYPE);
	checkSyntax(t, "def f() { var x: Array<$ }", TYPE);
	checkSyntax(t, "class A extends B<$", TYPE);
	checkSyntax(t, "def f() { var g = fun (x: Array<$", TYPE);
	checkSyntax(t, "def f() { var g = fun () -> ($", TYPE);
	// After a type, its declaration goes on.
	checkSyntax(t, "def f(x: (int, int) $", 0);
	checkSyntax(t, "def f(x: Array<int> $", 0);
	checkSyntax(t, "def f(x: Array<Array<int>>, $", LspCursorSyntax.PARAMETER);
	checkSyntax(t, "def f(x: Array<Array<int>>) -> Array<int> $", 0);
	checkSyntax(t, "class A extends B<int> $", LspCursorSyntax.CLASS_HEADER);
	checkSyntax(t, "def f() { var x: Array<int> = $ }", LspCursorSyntax.EXPRESSION);
	checkSyntax(t, "def f() { var x: Array<int>; $ }", LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION);
	checkCalls(t, "def f(x: Array<int>) { g($", [24]);
	// In an expression, "<" may compare or begin type arguments.
	checkSyntax(t, "def f() { x = a < $ }", LspCursorSyntax.EXPRESSION | TYPE);
	checkSyntax(t, "def f() { x = g<$ }", LspCursorSyntax.EXPRESSION | TYPE);
	checkSyntax(t, "def f() { x = (a < $ }", LspCursorSyntax.EXPRESSION | TYPE);
	checkSyntax(t, "def f() { x = ($ }", LspCursorSyntax.EXPRESSION);
}

// An if in an expression is an operand, not a statement.
def test_if_expressions(t: Tester) {
	var STMT = LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION;
	var EXPR = LspCursorSyntax.EXPRESSION;
	checkOffered(t, "def f() { var x = if(true, 1, 2) $; }", "");
	checkSyntax(t, "def f() { var x = if(true, 1, 2) $; }", 0);
	checkSyntax(t, "def f() { var x = if($", EXPR);
	checkSyntax(t, "def f() { var x = if(a, $", EXPR);
	checkSyntax(t, "def f() { return if(a, b, c) $", 0);
	checkSyntax(t, "def f() { g(if(a, b, c) $", 0);
	checkSyntax(t, "def f() { g(if(a, b, c), $", EXPR);
	checkSyntax(t, "def f() => if(a, b, c) $", 0);
	checkSyntax(t, "def f() { var x = if(a, b, c)\n\t$ }", STMT);
	checkSyntax(t, "def f() { var x = if(a, b, c); $ }", STMT);
	// Statements.
	checkSyntax(t, "def f() { if (a) $", STMT);
	checkSyntax(t, "def f() { if (a) if (b) $", STMT);
	checkSyntax(t, "def f() { while (a) if (b) $", STMT);
	checkSyntax(t, "def f() { if (a) x(); else if (b) $", STMT);
	checkSyntax(t, "def f() { match (x) { A => if (b) $", STMT);
	checkCalls(t, "def f() { var x = if(g($", [22]);
	var ctx = at("def f() { x = if(a, $");
	t.asserta("roles", [LspOpenRole.STATEMENTS, LspOpenRole.IF_ARGS], ctx.roles, putRole);
}
def putRole(buf: StringBuilder, r: LspOpenRole) -> StringBuilder {
	return buf.puts(r.name);
}

// An else attaches to the innermost if or match without one, and the outer
// ones can take theirs after it.
def test_nested_else(t: Tester) {
	var STMT = LspCursorSyntax.STATEMENT | LspCursorSyntax.EXPRESSION;
	var ELSE = LspCursorSyntax.ELSE;
	checkOffered(t, "def f() { if (true) if (false) f(); else f(); el$ }",
		"break continue def else false for fun if match null return true var while");
	checkSyntax(t, "def f() { if (a) if (b) x(); $ }", STMT | ELSE);
	checkSyntax(t, "def f() { if (a) if (b) x(); else y(); $ }", STMT | ELSE);
	checkSyntax(t, "def f() { if (a) if (b) x(); else y(); else z(); $ }", STMT);
	checkSyntax(t, "def f() { if (a) if (b) if (c) x(); else y(); else z(); $ }", STMT | ELSE);
	checkSyntax(t, "def f() { if (a) while (b) if (c) x(); else y(); $ }", STMT | ELSE);
	checkSyntax(t, "def f() { if (a) while (b) x(); $ }", STMT | ELSE);
	checkSyntax(t, "def f() { if (a) match (x) { } $ }", STMT | ELSE);
	checkSyntax(t, "def f() { if (a) match (x) { } else y(); $ }", STMT | ELSE);
	checkSyntax(t, "def f() { if (a) { if (b) x(); } $ }", STMT | ELSE);
	checkSyntax(t, "def f() { if (a) { if (b) x(); $ } }", STMT | ELSE);
	checkSyntax(t, "def f() { if (a) x(); else if (b) y(); else z(); $ }", STMT);
	// Another statement ends the chain.
	checkSyntax(t, "def f() { if (a) if (b) x(); y(); $ }", STMT);
	checkSyntax(t, "def f() { if (a) if (b) x(); ; $ }", STMT);
	checkSyntax(t, "def f() { if (a) if (b) x(); { } $ }", STMT);
	checkSyntax(t, "def f() { if (a) if (b) x(); if (c) y(); else z(); $ }", STMT);
	// Deep chains stay a count.
	var buf = StringBuilder.new();
	buf.puts("def f() { ");
	for (i < 1000) buf.puts("if (a) ");
	buf.puts("x(); ");
	for (i < 999) buf.puts("else y(); ");
	var chain = buf.toString();
	t.asserti(STMT | ELSE, at(Strings.format1("%s$", chain)).syntax);
	t.asserti(STMT, at(Strings.format1("%selse y(); $", chain)).syntax);
}

def test_keyword_sets(t: Tester) {
	checkOffered(t, "$", "class component def enum export import layout packing private thread type var");
	checkOffered(t, "class A { $ }", "def new private var");
	checkOffered(t, "type V { $ }", "case def");
	checkOffered(t, "def f() { $ }", "break continue def false for fun if match null return true var while");
	checkOffered(t, "def f() { if (x) y(); $ }", "break continue def else false for fun if match null return true var while");
	checkOffered(t, "def f() { var y = $ }", "false fun if null true");
	checkOffered(t, "def f() { match (x) { $ } }", "false null true");
	checkOffered(t, "def f(x: $", "");
	checkOffered(t, "def f($", "var");
	checkOffered(t, "enum E($", "");
	checkOffered(t, "def f() { for (x $", "in");
	checkOffered(t, "class A $", "extends");
	checkOffered(t, "type V $", "");
	checkOffered(t, "class A { new() $", "super");
	checkOffered(t, "private $", "class component enum packing thread type");
	checkOffered(t, "class A { private $", "def new var");
	checkOffered(t, "class A { def $", "var");
	checkOffered(t, "thread $", "component");
	checkOffered(t, "import \"x\" $", "component");
	checkOffered(t, "export $", "def");
	checkOffered(t, "def f() { x.$ }", "");
	checkOffered(t, "def f() { x.wh$ }", "");
	checkOffered(t, "def f() { // $\n }", "");
	checkOffered(t, "def f() { \"$\" }", "");
	checkOffered(t, "def f() { 'a$' }", "");
	checkOffered(t, "def f() { x = 1$ }", "");
	// Every keyword is offered somewhere, except the reserved "struct".
	var all = Vector<string>.new();
	for (marked in ["$", "class A { $ }", "type V { $ }", "def f() { if (x) y(); $ }", "def f() { for (x $",
			"class A $", "class A { new() $", "def f($"]) {
		var words = LspKeywords.candidates(at(marked), AeneasAdapter.keywords(), -1);
		for (w in words) all.put(w);
	}
	for (w in AeneasAdapter.keywords()) {
		var found = false;
		for (i < all.length) found = found || Strings.equal(all[i], w);
		if (found == Strings.equal(w, "struct")) t.fail1("keyword %s", w);
	}
}

def test_language_options(t: Tester) {
	// The forms follow the language options, as the parser reads them.
	var DESC = AnalysisKeywordForms.DESCRIPTORS, OPEN = AnalysisKeywordForms.OPEN_TYPES, FUN = AnalysisKeywordForms.FUN_EXPRS;
	t.asserti(FUN, AeneasAdapter.keywordForms([]));
	t.asserti(FUN | DESC, AeneasAdapter.keywordForms(["-lang:descriptors"]));
	t.asserti(FUN | OPEN, AeneasAdapter.keywordForms(["-lang:open-types=true"]));
	t.asserti(0, AeneasAdapter.keywordForms(["-lang:fun-exprs=false"]));
	t.asserti(FUN, AeneasAdapter.keywordForms(["-lang:descriptors", "-lang:descriptors=false"]));
	// Each call restores the defaults.
	t.asserti(FUN, AeneasAdapter.keywordForms([]));
	var after = "class A $", expr = "def f() { var y = $ }", variant = "type V(x: int) $";
	t.assert_string("extends", offered(after, FUN));
	t.assert_string("describes descriptor extends", offered(after, FUN | DESC));
	t.assert_string("false fun if null true", offered(expr, FUN));
	t.assert_string("false if null true", offered(expr, 0));
	t.assert_string("", offered(variant, FUN));
	t.assert_string("extends", offered(variant, FUN | OPEN));
}

// The table and Aeneas's list of keywords are the same, so a keyword that
// the pinned compiler adds or drops fails here rather than drifting.
def test_pinned_keywords(t: Tester) {
	var pinned = AeneasAdapter.keywords();
	t.asserti(LspKeyword.count, pinned.length);
	for (word in pinned) {
		var kw = LspKeywords.named(word);
		if (!kw.0) t.fail1("the table lacks Aeneas's keyword %s", word);
	}
	for (kw in LspKeyword.set.all) {
		var found = false;
		for (word in pinned) found = found || Strings.equal(word, LspKeywords.SPELLINGS[kw.tag]);
		if (!found) t.fail1("Aeneas has no keyword %s", LspKeywords.SPELLINGS[kw.tag]);
	}
	for (i = 1; i < pinned.length; i++) t.assert(AnalysisTables.compareBytes(pinned[i - 1], pinned[i]) < 0, "keywords in byte order");
}

// A server whose open documents are given by {texts}, as pairs of URI and text.
def URI = "untitled:complete.v3";
def server(t: Tester) -> LspServer {
	var s = LspServer.new(DocumentLimits.MAX_BYTES);
	t.assert(s.handle("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}") != null, "initialize reply");
	return s;
}
def request(uri: string, line: int, character: int) -> string {
	return Strings.format3("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"%s\"},\"position\":{\"line\":%d,\"character\":%d}}}",
		uri, line, character);
}
// Handles {payload} and returns the reply to it, which a completion sends to
// the server's sink, or null if none came yet. The other messages go on to the
// sink that was set.
def answer(s: LspServer, payload: string) -> Array<byte> {
	var sent = Vector<Array<byte>>.new(), previous = s.sendNotification;
	s.sendNotification = fun (b: Array<byte>) { sent.put(b); };
	var reply = s.handle(payload);
	s.sendNotification = previous;
	for (i < sent.length) {
		var obj = JsonValue.JObject.!(JsonRpcJsonParser.new(sent[i]).parseDocument()).v;
		if (reply == null && obj.has("id") && !obj.has("method")) reply = sent[i];
		else if (previous != null) previous(sent[i]);
	}
	return reply;
}
// The result of a completion at {line} and {character} of {uri}, which needs
// no analysis.
def complete(t: Tester, s: LspServer, uri: string, line: int, character: int) -> HashMap<string, JsonValue> {
	var reply = answer(s, request(uri, line, character));
	t.assert(reply != null, "completion is answered at once");
	if (reply == null) return null;
	var obj = JsonValue.JObject.!(JsonRpcJsonParser.new(reply).parseDocument()).v;
	t.assert(obj.has("result"), "completion succeeds");
	return JsonValue.JObject.!(obj["result"]).v;
}
// The labels offered at the "$" in {marked}, opened as {URI}.
def labels(t: Tester, marked: string) -> string {
	var s = server(t);
	var cursor = 0;
	while (marked[cursor] != '$') cursor++;
	var text = Arrays.concat(Arrays.range(marked, 0, cursor), Arrays.range(marked, cursor + 1, marked.length));
	s.documents.open(URI, "virgil", 1, text);
	var map = PositionMap.new(text, PositionEncoding.UTF16), p = map.offsetToPosition(cursor);
	var result = complete(t, s, URI, p.line, p.character);
	return render(result);
}
def render(result: HashMap<string, JsonValue>) -> string {
	if (result == null) return null;
	var buf = StringBuilder.new();
	for (item in JsonValue.JArray.!(result["items"]).v) {
		if (buf.length > 0) buf.putc(' ');
		buf.puts(JsonValue.String.!(JsonValue.JObject.!(item).v["label"]).v);
	}
	return buf.toString();
}

def test_capability(t: Tester) {
	var s = LspServer.new(DocumentLimits.MAX_BYTES);
	var reply = s.handle("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}");
	var caps = JsonValue.JObject.!(JsonValue.JObject.!(JsonValue.JObject.!(JsonRpcJsonParser.new(reply).parseDocument()).v["result"]).v["capabilities"]).v;
	t.assert(caps.has("completionProvider"), "completionProvider advertised");
	// "." triggers member completion, and there is no resolve.
	t.assert_string("{\"triggerCharacters\":[\".\"]}", JsonRpcJson.render(StringBuilder.new(), caps["completionProvider"]).toString());
}

def test_parse_failure(t: Tester) {
	// The file fails to parse, here and in the rest of the method, but the
	// statement position is plain from the text.
	var marked = "class A {\n\tdef f() {\n\t\tvar x = g(1,;\n\t\twh$\n\t}\n\tdef g( {\n}\n";
	t.assert_string("break continue def false for fun if match null return true var while", labels(t, marked));
	t.assert(AeneasAdapter.parseFile("a.v3", "class A {\n\tdef f() {\n\t\tvar x = g(1,;\n\t\twh\n\t}\n\tdef g( {\n}\n", []).diagnostics.length > 0, "fails to parse");
	t.assert_string("def new private var", labels(t, "class A { def f() { x.; } $"));
}

def test_nothing_offered(t: Tester) {
	for (marked in ["def f() { // wh$\n}", "def f() { /* wh$ */ }", "def f() { /* wh$", "var s = \"wh$\";",
			"var s = \"wh$", "var c = 'w$';", "def f() { x.$ }", "def f() { x.wh$ }", "def f() { x. /* c */ $ }",
			"var x = 12$", "def f() { x = y $ }"]) {
		var got = labels(t, marked);
		if (got == null || got.length != 0) t.fail2("%s: expected nothing, got [%s]", marked, got);
	}
}

def checkRange(t: Tester, item: JsonValue, line: int, start: int, end: int, label: string) {
	var obj = JsonValue.JObject.!(item).v;
	t.assert_string(label, JsonValue.String.!(obj["label"]).v);
	t.asserti(14, JsonValue.Int.!(obj["kind"]).v);
	t.assert(!obj.has("insertText") && !obj.has("sortText") && !obj.has("filterText"), "only a label, kind, and edit");
	var edit = JsonValue.JObject.!(obj["textEdit"]).v;
	t.assert_string(label, JsonValue.String.!(edit["newText"]).v);
	var range = JsonValue.JObject.!(edit["range"]).v;
	var s = JsonValue.JObject.!(range["start"]).v, e = JsonValue.JObject.!(range["end"]).v;
	t.asserti(line, JsonValue.Int.!(s["line"]).v);
	t.asserti(start, JsonValue.Int.!(s["character"]).v);
	t.asserti(line, JsonValue.Int.!(e["line"]).v);
	t.asserti(end, JsonValue.Int.!(e["character"]).v);
}
def test_text_edits(t: Tester) {
	var s = server(t);
	s.documents.open(URI, "virgil", 1, "class A {\n\tdef f() {\n\t\twhile (x) re\n\t}\n}\n");
	// Just past "re": the prefix is replaced, and every keyword of the
	// position is offered, for the client to filter, in alphabetical order.
	var result = complete(t, s, URI, 2, 14);
	t.assertz(false, JsonValue.Bool.!(result["isIncomplete"]).v);
	var items = JsonValue.JArray.!(result["items"]).v;
	t.assert_string("break continue def false for fun if match null return true var while", render(result));
	for (item in items) checkRange(t, item, 2, 12, 14, JsonValue.String.!(JsonValue.JObject.!(item).v["label"]).v);
	// In the middle of "re", only the bytes before the cursor are replaced.
	items = JsonValue.JArray.!(complete(t, s, URI, 2, 13)["items"]).v;
	checkRange(t, items[9], 2, 12, 13, "return");
	// Before it, nothing is replaced.
	items = JsonValue.JArray.!(complete(t, s, URI, 2, 12)["items"]).v;
	checkRange(t, items[9], 2, 12, 12, "return");
	// After a keyword spelled in full, it is offered for itself.
	s.documents.change(URI, 2, "class A {\n\tdef f() {\n\t\treturn\n\t}\n}\n");
	items = JsonValue.JArray.!(complete(t, s, URI, 2, 8)["items"]).v;
	checkRange(t, items[9], 2, 2, 8, "return");
}

def test_utf16_ranges(t: Tester) {
	var s = server(t);
	// U+00E9 is two UTF-8 bytes and one UTF-16 unit; U+1D11E is four bytes
	// and two units.
	s.documents.open(URI, "virgil", 1, "def f() { /*\xC3\xA9\xF0\x9D\x84\x9E*/ wh }");
	var items = JsonValue.JArray.!(complete(t, s, URI, 0, 20)["items"]).v;
	t.asserti(13, items.length);
	checkRange(t, items[12], 0, 18, 20, "while");
	// A cursor inside the surrogate pair maps to the character's start, in
	// the comment.
	t.asserti(0, JsonValue.JArray.!(complete(t, s, URI, 0, 14)["items"]).v.length);
}

def test_positions_out_of_range(t: Tester) {
	var s = server(t);
	s.documents.open(URI, "virgil", 1, "class A {\n\tdef f() {\n\t\tre");
	// A character past the line's end is its end, and a line past the last
	// is the end of the text, as for other requests.
	var items = JsonValue.JArray.!(complete(t, s, URI, 2, 99)["items"]).v;
	checkRange(t, items[9], 2, 2, 4, "return");
	items = JsonValue.JArray.!(complete(t, s, URI, 50, 0)["items"]).v;
	checkRange(t, items[9], 2, 2, 4, "return");
	t.assert_string("def new private var", render(complete(t, s, URI, 0, 99)));
}

def test_closed_document(t: Tester) {
	var s = server(t);
	// No overlay, and no disk fallback: completion needs an open document.
	var result = complete(t, s, URI, 0, 0);
	t.assertz(false, JsonValue.Bool.!(result["isIncomplete"]).v);
	t.asserti(0, JsonValue.JArray.!(result["items"]).v.length);
	s.documents.open(URI, "virgil", 1, "");
	t.asserti(12, JsonValue.JArray.!(complete(t, s, URI, 0, 0)["items"]).v.length);
	s.documents.close(URI);
	t.asserti(0, JsonValue.JArray.!(complete(t, s, URI, 0, 0)["items"]).v.length);
	// A file on disk that is not open is not read.
	var path = ProjectTestFiles.repository("test/fixtures/projects/two-file/main.v3");
	t.asserti(0, JsonValue.JArray.!(complete(t, s, ProjectFiles.uri(path), 0, 0)["items"]).v.length);
}

// The project's compilerArgs decide the keyword forms.
def test_project_options(t: Tester) {
	var s = LspServer.new(DocumentLimits.MAX_BYTES);
	var root = ProjectTestFiles.repository("test/fixtures/projects/compiler-flags");
	s.handle(Strings.format1("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":\"%s\",\"capabilities\":{}}}", ProjectFiles.uri(root)));
	var described = ProjectFiles.uri(ProjectFiles.join(root, "descriptors/Described.v3"));
	var plain = ProjectFiles.uri(ProjectFiles.join(root, "defaults/Main.v3"));
	var text = "class Shape \n";
	s.documents.open(described, "virgil", 1, text);
	s.documents.open(plain, "virgil", 1, text);
	t.assert_string("describes descriptor extends", render(complete(t, s, described, 0, 12)));
	t.assert_string("extends", render(complete(t, s, plain, 0, 12)));
}

// Where only keywords can go, completion answers from the text even while
// an analysis is pending, and starts none; where names can, it waits for its
// own analysis (LspCompletionScopeTest).
def test_no_analysis(t: Tester) {
	HostOs.ignoreSigpipe();
	var supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	var s = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
	var sent = Vector<Array<byte>>.new();
	s.sendNotification = fun (b: Array<byte>) { sent.put(b); };
	var root = ProjectTestFiles.repository("test/fixtures/projects/two-file");
	s.handle(Strings.format1("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":\"%s\",\"capabilities\":{}}}", ProjectFiles.uri(root)));
	var uri = ProjectFiles.uri(ProjectFiles.join(root, "main.v3"));
	var doc = Strings.newMap<JsonValue>(), params = Strings.newMap<JsonValue>();
	doc["uri"] = JsonValue.String(uri);
	doc["languageId"] = JsonValue.String("virgil");
	doc["version"] = JsonValue.Int(1);
	doc["text"] = JsonValue.String("component Main {\n\tdef main() {\n\t\tvar s = 123456.;\n\t\t// wh\n\t}\n}\n");
	params["textDocument"] = JsonValue.JObject(doc);
	s.handle(JsonRpcMessage.Notification("textDocument/didOpen", JsonRpcParams.ByName(params)).encode());
	t.assert(s.analyzing(), "the open schedules an analysis");
	var started = supervisor.workersStarted, busy = supervisor.busy(), notifications = sent.length;
	t.assert(s.projects.forDocument(uri).active != null, "the document is in a project");
	t.assert(s.projects.forDocument(uri).active.snapshot == null, "no analysis has completed");
	// After a number's ".", in a comment, and where a new name goes.
	t.asserti(0, JsonValue.JArray.!(complete(t, s, uri, 2, 17)["items"]).v.length);
	t.asserti(0, JsonValue.JArray.!(complete(t, s, uri, 3, 7)["items"]).v.length);
	t.assert_string("def new private var", render(complete(t, s, uri, 4, 2)));
	t.asserti(started, supervisor.workersStarted);
	t.assertz(busy, supervisor.busy());
	t.asserti(notifications, sent.length);
	t.asserti(0, s.completion.analyses);
	t.assert(s.analyzing(), "the analysis is still pending");
	s.close();
	supervisor.close();
}

def test_cancellation_and_shutdown(t: Tester) {
	var s = server(t);
	s.documents.open(URI, "virgil", 1, "");
	t.assert(answer(s, request(URI, 0, 0)) != null, "answered at once");
	// Cancellation arrives after the reply, and is never answered.
	t.assert(s.handle("{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{\"id\":7}}") == null, "no reply to a cancellation");
	t.assert(s.handle("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}") != null, "shutdown");
	var reply = answer(s, request(URI, 0, 0));
	t.assert_string("{\"jsonrpc\":\"2.0\",\"id\":7,\"error\":{\"code\":-32600,\"message\":\"the server is shutting down\"}}", reply);
}

def test_params(t: Tester) {
	var s = server(t);
	var error = "{\"jsonrpc\":\"2.0\",\"id\":7,\"error\":{\"code\":-32602,\"message\":\"completion params require a valid textDocument.uri and position\"}}";
	for (params in ["{}", "null", "[]", "{\"textDocument\":{\"uri\":\"untitled:a\"}}",
			"{\"textDocument\":{\"uri\":\"\"},\"position\":{\"line\":0,\"character\":0}}",
			"{\"textDocument\":{\"uri\":3},\"position\":{\"line\":0,\"character\":0}}",
			"{\"textDocument\":{\"uri\":\"file:relative\"},\"position\":{\"line\":0,\"character\":0}}",
			"{\"textDocument\":{\"uri\":\"untitled:a\"},\"position\":{\"line\":-1,\"character\":0}}",
			"{\"textDocument\":{\"uri\":\"untitled:a\"},\"position\":{\"line\":0}}",
			"{\"textDocument\":{\"uri\":\"untitled:a\"},\"position\":{\"line\":0,\"character\":\"1\"}}"]) {
		var reply = answer(s, Strings.format1("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/completion\",\"params\":%s}", params));
		t.assert_string(error, reply);
	}
	// A completion context is accepted and changes nothing.
	s.documents.open(URI, "virgil", 1, "");
	var reply = answer(s, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"untitled:complete.v3\"},\"position\":{\"line\":0,\"character\":0},\"context\":{\"triggerKind\":1}}}");
	var result = JsonValue.JObject.!(JsonValue.JObject.!(JsonRpcJsonParser.new(reply).parseDocument()).v["result"]).v;
	t.assert_string("class component def enum export import layout packing private thread type var", render(result));
}
