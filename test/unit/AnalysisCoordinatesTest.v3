def T = UnitTests.register;
def X = [
	T("AnalysisCoordinates:semantic_offsets", test_semantic_offsets),
	T("AnalysisCoordinates:trailing_line_comment", test_trailing_line_comment),
	T("AnalysisCoordinates:token_end_before_comment", test_token_end_before_comment),
	T("AnalysisCoordinates:parser_coordinate_ambiguities", test_parser_coordinate_ambiguities),
	T("AnalysisCoordinates:retrospective_tokens", test_retrospective_tokens),
	T("AnalysisCoordinates:binding_compiler_coordinates", test_binding_compiler_coordinates),
	T("AnalysisCoordinates:binding_offsets", test_binding_offsets),
	T("AnalysisCoordinates:cross_file_binding_offsets", test_cross_file_binding_offsets),
	T("AnalysisCoordinates:retrospective_binding_offsets", test_retrospective_binding_offsets),
	T("AnalysisCoordinates:manufactured_name_spans", test_manufactured_name_spans),
	T("AnalysisCoordinates:malformed_literal_bound", test_malformed_literal_bound),
	T("AnalysisCoordinates:no_file", test_no_file),
	T("AnalysisCoordinates:replay_boundaries", test_replay_boundaries),
	T("AnalysisCoordinates:position_index", test_position_index),
	T("AnalysisCoordinates:position_index_backfill", test_position_index_backfill),
	T("AnalysisCoordinates:position_index_reference", test_position_index_reference),
	T("AnalysisCoordinates:position_index_reverse_work", test_position_index_reverse_work),
	T("AnalysisCoordinates:nested_lambda_work", test_nested_lambda_work),
	T("AnalysisCoordinates:large_file_offsets", test_large_file_offsets),
	()
];

// Coordinate comparisons require a successfully decoded snapshot.
def decodedResult(payload: Array<byte>, generation: int, paths: Array<string>) -> AnalysisWorkerResult {
	match (AnalysisWire.decodeResult(payload, generation, paths)) {
		Decoded(result) => return result;
		_ => return null;
	}
}

// Assert both worker-side and decoded offsets, and the resulting UTF-16 LSP
// range. No semantic publication is needed to exercise the complete boundary.
def check(t: Tester, text: string, begin: int, end: int, line: int, character: int) {
	var sources = [AnalysisSource.new("coordinates.v3", text)];
	var a = AeneasAdapter.analyzeProgram(sources, [], false);
	t.assert(a.diagnostics.length > 0, "expected a diagnostic");
	if (a.diagnostics.length == 0) return;
	var w = AnalysisWire.encodeResult(1, 1, 1, a, -1, -1, null);
	var frame = AnalysisWire.finishResult(w, 0L);
	var result = decodedResult(Ranges.dup(frame[WorkerFraming.HEADER_BYTES ...]), 1, ["coordinates.v3"]);
	if (result == null) return t.fail("result did not decode");
	var map = PositionMap.new(text, PositionEncoding.UTF16);
	for (d in [a.diagnostics[0], result.snapshot.diagnostics[0]]) {
		t.asserti(begin, d.beginOffset);
		t.asserti(end, d.endOffset);
		var start = map.offsetToPosition(d.beginOffset), finish = map.offsetToPosition(d.endOffset);
		t.asserti(line, start.line);
		t.asserti(character, start.character);
		t.asserti(line, finish.line);
		t.asserti(character + end - begin, finish.character);
	}
}

def test_semantic_offsets(t: Tester) {
	var prefixes = ["component C {\n/*\t*/ def x: int = ",
		"component C {\n\tdef x: int = ",
		"component C {\n/* start\n\t*/ def x: int = ",
		"component C {\n/*\t😀é*/ def x: int = ",
		"component C {\n def s = \"/*\\\"//😀é\"; def x: int = ",
		"component C {\n/*\t*/\tdef x: int = "];
	var lines = [1, 1, 2, 1, 1, 1];
	// LSP counts an emoji as two UTF-16 units and é as one, not six bytes.
	var characters = [19, 14, 17, 22, 35, 19];
	for (i < prefixes.length) {
		var prefix = prefixes[i];
		check(t, Arrays.concat(prefix, "\"s\";\n}\n"), prefix.length, prefix.length + 3, lines[i], characters[i]);
	}
}

def test_trailing_line_comment(t: Tester) {
	var text = "component C { // trailing\t😀";
	check(t, text, text.length, text.length, 0, 28);
}

def test_token_end_before_comment(t: Tester) {
	var text = "/*\t*/ def if// trailing\t😀";
	check(t, text, 10, 12, 0, 10);
}

// ParserState.advance1 does not advance the column when consuming the last
// byte; tokenAt uses context-free tabs. Neither can be inverted unambiguously
// from just a line/column pair, so whole-program parser errors reuse capture.
def ambiguityCases = ["component C { def x = 1;", "/*\t*/ def f() => missing.[](in);",
	"/*\t*/ def if // trailing\tcomment", "component C { def x = ; }",
	"component C {\n/*\t*/ def f() => C.[]// trailing\t😀",
	"component C {\n/*\t*/ def f() => C.[]=// trailing\t😀"];

def test_parser_coordinate_ambiguities(t: Tester) {
	for (text in ambiguityCases) {
		var single = AeneasAdapter.parseFile("ambiguity.v3", text, []);
		var whole = AeneasAdapter.analyzeProgram([AnalysisSource.new("ambiguity.v3", text)], [], false);
		t.asserti(single.diagnostics.length, whole.diagnostics.length);
		for (i < whole.diagnostics.length) {
			t.asserti(single.diagnostics[i].beginOffset, whole.diagnostics[i].beginOffset);
			t.asserti(single.diagnostics[i].endOffset, whole.diagnostics[i].endOffset);
			t.assert_string(single.diagnostics[i].toString(), whole.diagnostics[i].toString());
		}
	}
}

def test_no_file(t: Tester) {
	var d = AnalysisDiagnostic.new(null, 0, 0, 0, 0, "ProgramError", "no file");
	AnalysisSourceCoordinates.new([AnalysisSource.new("a.v3", "class A {}")]).diagnostic(d);
	t.asserti(-1, d.beginOffset);
	t.asserti(-1, d.endOffset);
	var a = ProgramAnalysis.new([d], AnalysisStats.new(0, 0, 0, -1), false, false, null);
	var frame = AnalysisWire.finishResult(AnalysisWire.encodeResult(1, 1, 1, a, -1, -1, null), 0L);
	var r = decodedResult(Ranges.dup(frame[WorkerFraming.HEADER_BYTES ...]), 1, []);
	if (r == null) return t.fail("non-file result did not decode");
	t.assert(r.snapshot.diagnostics[0].path == null, "null path preserved");
	t.asserti(-1, r.snapshot.diagnostics[0].beginOffset);
	t.asserti(-1, r.snapshot.diagnostics[0].endOffset);
}

def test_replay_boundaries(t: Tester) {
	var text = "a\t/*\t\n\t*/b// trailing\t😀", map = AnalysisCoordinates.new(text);
	t.asserti(0, map.offset(1, 1, false));
	t.asserti(1, map.offset(1, 3, false)); // inside whitespace tab expansion
	t.asserti(4, map.offset(1, 11, false)); // block-comment tab counts one
	t.asserti(9, map.offset(2, 4, false));
	t.asserti(10, map.offset(2, 5, false)); // token end, before trailing comment
	t.asserti(text.length, map.offset(2, 5, true)); // EOF point, same column
	var next = AnalysisCoordinates.new("// ignored\t\n\tname");
	t.asserti(13, next.offset(2, 9, false));
	// CR is an ordinary compiler byte; LSP alone treats it as a line end.
	t.asserti(2, AnalysisCoordinates.new("a\rb").offset(1, 3, false));
}

def test_position_index(t: Tester) {
	var index = AnalysisPositionIndex<int>.new();
	for (i < 100) index.set(2L * i, i, false);
	index.set(10, -1, false); // the first value is kept
	t.asserti(5, index.get(10, -2));
	index.set(10, 50, true);
	t.asserti(50, index.get(10, -2));
	// Earlier keys are inserted in place.
	index.set(11, 111, false);
	index.set(-5, 7, false);
	t.asserti(111, index.get(11, -2));
	t.asserti(7, index.get(-5, -2));
	t.asserti(0, index.get(0, -2));
	t.asserti(6, index.get(12, -2));
	t.asserti(99, index.get(198, -2));
	t.assert(!index.has(13), "13 was never recorded");
	t.asserti(-2, index.get(-6, -2));
	t.asserti(-2, index.get(199, -2));
	// An insertion into full arrays (64 entries initially) grows them.
	var full = AnalysisPositionIndex<int>.new();
	for (i < 64) full.set(2L * i + 2, i, false);
	full.set(1, -1, false);
	t.asserti(-1, full.get(1, -2));
	for (i < 64) t.asserti(i, full.get(2L * i + 2, -2));
}

// Keys further back than SHIFT_LIMIT wait for the next lookup, and resolve as
// if set in place: the first set inserts, and only later replacing sets win.
def test_position_index_backfill(t: Tester) {
	var index = AnalysisPositionIndex<int>.new(), n = 200;
	for (i < n) index.set(1000L + i, i, false);
	AnalysisPositionWork.moves = 0;
	AnalysisPositionWork.comparisons = 0;
	index.set(60, 1, false);
	index.set(50, 2, true);
	index.set(60, 3, false);
	index.set(60, 4, true);
	index.set(60, 5, false);
	index.set(50, 6, false);
	index.set(1199, -1, false); // the last key, kept
	index.set(1200, 7, false);  // appended past the buffered keys
	t.asserti(0, AnalysisPositionWork.moves);
	t.asserti(4, index.get(60, -2));
	t.assert(AnalysisPositionWork.comparisons > 0, "the lookup sorted the buffer");
	// Every one of the n + 1 recorded entries moves once, and two keys land.
	t.asserti(n + 3, AnalysisPositionWork.moves);
	t.asserti(2, index.get(50, -2));
	t.asserti(199, index.get(1199, -2));
	t.asserti(7, index.get(1200, -2));
	t.assert(!index.has(55), "55 was never recorded");
	// Merged keys behave as any other: replaced only with {replace}.
	index.set(60, 8, false);
	t.asserti(4, index.get(60, -2));
	index.set(50, 9, true);
	t.asserti(9, index.get(50, -2));
	// has() merges too, and clear() drops what is buffered.
	index.set(70, 10, false);
	t.assert(index.has(70), "has() sees a buffered key");
	index.set(80, 11, false);
	index.clear();
	t.assert(!index.has(80), "clear() drops buffered keys");
	t.asserti(-2, index.get(1000, -2));
	index.set(5, 12, false);
	t.asserti(12, index.get(5, -2));
}

// The index matches a sorted array that shifts every insertion into place,
// over a deterministic mix of appends, near and far insertions, repeated
// keys with and without {replace}, and interleaved lookups.
def test_position_index_reference(t: Tester) {
	var index = AnalysisPositionIndex<int>.new();
	var keys = Array<long>.new(4096), values = Array<int>.new(4096), length = 0;
	var seed = 12345, next = 0L, buffered = false;
	for (op < 3000) {
		seed = seed * 1103515245 + 12345;
		var r = (seed >>> 8) & 0xFFFF, key: long;
		match (r % 8) {
			0, 1, 2 => key = 10 * next++;               // append
			3 => key = 10 * next - 10 * (r % 64);       // near the end
			4, 5 => key = (r * 7919L) % (10 * next + 1); // anywhere, often between keys
			6 => key = 10 * next - 10 * (r % 300) - 5;  // far back, between keys
			_ => key = if(length > 0, keys[(r * 31) % length], 0L); // an existing key
		}
		var value = op, replace = (r & 0x100) != 0;
		var before = AnalysisPositionWork.comparisons;
		index.set(key, value, replace);
		// The reference shifts every insertion into place, as the index once did.
		var i = 0;
		while (i < length && keys[i] < key) i++;
		if (i < length && keys[i] == key) {
			if (replace) values[i] = value;
		} else {
			for (j = length; j > i; j--) {
				keys[j] = keys[j - 1];
				values[j] = values[j - 1];
			}
			keys[i] = key;
			values[i] = value;
			length++;
		}
		if (op % 97 == 96) {
			for (k = 0; k < length; k += 7) t.asserti(values[k], index.get(keys[k], -1));
			if (AnalysisPositionWork.comparisons > before) buffered = true;
			t.assert(!index.has(-3), "a key below every other is absent");
		}
	}
	t.assert(buffered, "some insertions were buffered");
	for (k < length) {
		t.asserti(values[k], index.get(keys[k], -1));
		t.assert(index.has(keys[k]), "every reference key is present");
		if (k > 0 && keys[k] - keys[k - 1] > 1) t.assert(!index.has(keys[k] - 1), "gaps stay absent");
	}
}

// Reverse insertion, as nested lambdas insert their "=>" begins, moves each
// entry about once and sorts once. Shifting every key into place moves
// n(n-1)/2 entries: 44,850 for n = 300 and 719,400 for n = 1,200.
def test_position_index_reverse_work(t: Tester) {
	for (n in [300, 1200]) {
		var index = AnalysisPositionIndex<int>.new(), limit = AnalysisPositionWork.SHIFT_LIMIT;
		AnalysisPositionWork.moves = 0;
		AnalysisPositionWork.comparisons = 0;
		for (i = n; i > 0; i--) index.set(i, i, false);
		for (i = 1; i <= n; i++) t.asserti(i, index.get(i, -1));
		// The first SHIFT_LIMIT keys shift into place; the rest merge once.
		t.asserti(limit * (limit + 1) / 2 + n, AnalysisPositionWork.moves);
		var log = 0;
		for (p = 1; p < n; p *= 2) log++;
		t.assert(AnalysisPositionWork.comparisons <= n * log, "one n log n sort");
	}
}

// Parsing nested expression lambdas inserts their "=>" coordinates in reverse
// order. The position indexes once shifted n(n-1) entries for n lambdas,
// 1,438,800 for n = 1,200; now they move a few per lambda.
def test_nested_lambda_work(t: Tester) {
	for (n in [300, 1200]) {
		var buf = StringBuilder.new().puts("component C { def m() { var f = ");
		for (i < n) buf.puts("fun() => ");
		var text = buf.puts("0; } }\n").toString();
		AnalysisPositionWork.moves = 0;
		var a = AeneasAdapter.analyzeProgram([AnalysisSource.new("nested.v3", text)], [], false);
		t.asserti(0, a.diagnostics.length);
		var moves = AnalysisPositionWork.moves;
		t.assert(moves <= 4 * n + 8192, Strings.format2("%d lambdas moved %d entries", n, moves));
	}
}

// Each ambiguity case reports the same offsets, shifted by the prefix length,
// after enough tokens to grow every position index many times.
def test_large_file_offsets(t: Tester) {
	var buf = StringBuilder.new().puts("component P {\n");
	for (i < 2000) buf.put2("\tdef x%d: int = %d;\n", i, i);
	var prefix = buf.puts("}\n").toString();
	for (text in ambiguityCases) {
		var small = AeneasAdapter.parseFile("small.v3", text, []), large = Arrays.concat(prefix, text);
		var single = AeneasAdapter.parseFile("large.v3", large, []);
		var whole = AeneasAdapter.analyzeProgram([AnalysisSource.new("large.v3", large)], [], false);
		t.asserti(small.diagnostics.length, single.diagnostics.length);
		t.asserti(small.diagnostics.length, whole.diagnostics.length);
		if (small.diagnostics.length == 0) t.fail("expected a parse error");
		for (i < small.diagnostics.length) {
			if (i >= single.diagnostics.length || i >= whole.diagnostics.length) break;
			for (d in [single.diagnostics[i], whole.diagnostics[i]]) {
				t.asserti(small.diagnostics[i].beginOffset + prefix.length, d.beginOffset);
				t.asserti(small.diagnostics[i].endOffset + prefix.length, d.endOffset);
			}
		}
	}
}


def test_retrospective_tokens(t: Tester) {
	for (op in ["[]", "[]="]) {
		var prefix = "component C {\n/*\t*/ def f() => C.";
		check(t, StringBuilder.new().puts(prefix).puts(op).puts(";\n}\n").toString(),
			prefix.length, prefix.length + op.length, 1, 19);
	}
	var cases = [
		"component C {\n/*\t*/ def f() => C.[]; def x: int = \"s\";\n}\n",
		"class C { def [] -> int { return 1; }\n/*\t*/ def f(c: C) -> int => c.[];\n}\n",
		"class C { def [] = x: int {}\n/*\t*/ def f(c: C) -> int => c.[]=;\n}\n",
		"component C {\n/*\t*/ def f() -> int => ;\n}\n",
		"component C {\n/*\t*/ def f() -> int => C.[](in);\n}\n"
	];
	var begins = [50, 66, 57, 38, 43], ends = [53, 70, 62, 38, 45];
	for (i < cases.length) {
		var text = cases[i], sources = [AnalysisSource.new("retrospective.v3", text)];
		var a = AeneasAdapter.analyzeProgram(sources, [], false);
		t.assert(a.diagnostics.length > 0, "expected retrospective diagnostic");
		if (a.diagnostics.length == 0) continue;
		t.asserti(begins[i], a.diagnostics[0].beginOffset);
		t.asserti(ends[i], a.diagnostics[0].endOffset);
		if (i == 0) {
			t.asserti(2, a.diagnostics.length);
			if (a.diagnostics.length == 2) {
				t.asserti(33, a.diagnostics[1].beginOffset);
				t.asserti(35, a.diagnostics[1].endOffset);
			}
		}
		var frame = AnalysisWire.finishResult(AnalysisWire.encodeResult(1, 1, 1, a, -1, -1, null), 0L);
		var decoded = decodedResult(Ranges.dup(frame[WorkerFraming.HEADER_BYTES ...]), 1, ["retrospective.v3"]);
		if (decoded == null) return t.fail("retrospective result did not decode");
		for (j < a.diagnostics.length) {
			t.asserti(a.diagnostics[j].beginOffset, decoded.snapshot.diagnostics[j].beginOffset);
			t.asserti(a.diagnostics[j].endOffset, decoded.snapshot.diagnostics[j].endOffset);
		}
		var prog = Program.new();
		SystemCalls.install(prog);
		prog.files = ["retrospective.v3"];
		prog.inputs = [text];
		var compilation = Compilation.new(Compiler.new(null), prog);
		if (compilation.parse()) compilation.verify();
		var original = Lists.reverse(prog.ERROR.errors), j = 0;
		for (e = original; e != null; e = e.tail) {
			t.assert(j < a.diagnostics.length, "compiler diagnostic retained");
			if (j >= a.diagnostics.length) break;
			var d = a.diagnostics[j++], r = e.head.range;
			t.assert_string(e.head.description, d.message);
			t.asserti(r.beginLine, d.beginLine);
			t.asserti(r.beginColumn, d.beginColumn);
			t.asserti(r.endLine, d.endLine);
			t.asserti(r.endColumn, d.endColumn);
		}
		t.asserti(a.diagnostics.length, j);
		AnalysisTypeCache.release();
	}
	var clean = "class C { def [x: int] -> int { return x; } def [x: int] = y: int {}\n/*\t*/ def f(c: C) -> int => c.[](1); def g(c: C) => c.[]=(1, 2);\n}\n";
	var successful = AeneasAdapter.analyzeProgram([AnalysisSource.new("clean.v3", clean)], [], false);
	t.assertz(true, successful.parsed);
	t.assertz(true, successful.verified);
	t.asserti(0, successful.diagnostics.length);
}

def test_malformed_literal_bound(t: Tester) {
	for (count in [32768, 262144]) {
		var buffer = StringBuilder.new().puts("def s = \"");
		for (i < count) buffer.puts("a\\\"");
		var text = buffer.toString(), start = System.ticksUs();
		var map = AnalysisCoordinates.new(text);
		t.asserti(8, map.offset(1, 9, false));
		t.assert(System.ticksUs() - start < 1000000, "malformed literal replay must finish within one second");
		start = System.ticksUs();
		var result = AeneasAdapter.analyzeProgram([AnalysisSource.new("literal.v3", text)], [], false);
		t.asserti(1, result.diagnostics.length);
		if (result.diagnostics.length > 0) {
			t.assert_string("invalid string literal", result.diagnostics[0].message);
			t.asserti(8, result.diagnostics[0].beginOffset);
			t.asserti(8, result.diagnostics[0].endOffset);
		}
		t.assert(System.ticksUs() - start < 1000000, "malformed literal analysis must finish within one second");
	}
}


def test_binding_compiler_coordinates(t: Tester) {
	var cases = [
		"class C { def [x: int] -> int { return x; }\n/*\t*/ def f(c: C) -> int => c.[](1);\n}\n",
		"class C { def [x: int] = y: int {}\n/*\t*/ def f(c: C) => c.[]=(1, 2);\n}\n"
	];
	var names = ["[]", "[]="], columns = [36, 29], liveColumns = [31, 24];
	for (i < cases.length) {
		var path = "binding-coordinates.v3", text = cases[i];
		var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path, text)], [], false);
		t.assertz(true, a.verified);
		t.asserti(0, a.diagnostics.length);
		var uses = a.occurrences(path);
		var frame = AnalysisWire.finishResult(AnalysisWire.encodeResult(1, 1, 1, a, 0, -1,
			[(path, uses)]), 0L);
		var result = decodedResult(Ranges.dup(frame[WorkerFraming.HEADER_BYTES ...]), 1, [path]);
		if (result == null) return t.fail("binding result did not decode");
		var decoded = result.snapshot.occurrences(path);
		var prog = Program.new();
		SystemCalls.install(prog);
		prog.files = [path];
		prog.inputs = [text];
		var compilation = Compilation.new(Compiler.new(null), prog);
		t.assertz(true, compilation.parse());
		t.assertz(true, compilation.verify());
		var stock = ProgramAnalysis.new([], AnalysisStats.new(0, 0, 0, -1), true, true, prog);
		var original = stock.occurrences(path);
		// A stock parse's retrospective token has only its context-free column,
		// which does not locate it in the source, so that analysis skips the
		// operator use, and counts it; every other use matches.
		t.asserti(uses.length - 1, original.length);
		t.asserti(1, stock.skippedUses(path));
		t.asserti(0, a.skippedUses(path));
		t.asserti(0, result.snapshot.stats.skippedUses);
		t.asserti(uses.length, decoded.length);
		if (original.length != uses.length - 1 || uses.length != decoded.length) return;
		var count = 0, k = 0;
		for (j < uses.length) {
			t.assert_string(uses[j].toString(), decoded[j].toString());
			if (!Strings.equal(uses[j].declaration.name, names[i])) {
				if (k < original.length) t.assert_string(original[k++].toString(), uses[j].toString());
				continue;
			}
			count++;
			for (o in [uses[j], decoded[j]]) {
				t.asserti(2, o.range.beginLine);
				t.asserti(2, o.range.endLine);
				t.asserti(columns[i], o.range.beginColumn);
				t.asserti(columns[i] + names[i].length, o.range.endColumn);
				t.assert(o.declaration.kind == AnalysisDeclKind.METHOD, "indexing method target");
				t.assert_string(path, o.declaration.range.path);
				t.asserti(1, o.declaration.range.beginLine);
				t.asserti(1, o.declaration.range.endLine);
				t.asserti(15, o.declaration.range.beginColumn);
				t.asserti(15 + names[i].length, o.declaration.range.endColumn);
			}
		}
		t.asserti(1, count);
		for (column = columns[i]; column < columns[i] + names[i].length; column++) {
			for (d in [a.definitionAt(path, 2, column), result.snapshot.definitionAt(path, 2, column)]) {
				if (d == null) return t.fail("operator definition missing at compiler column");
				t.assert_string(names[i], d.name);
				t.asserti(15, d.range.beginColumn);
				t.asserti(15 + names[i].length, d.range.endColumn);
			}
		}
		for (column in [columns[i] - 1, columns[i] + names[i].length, liveColumns[i]]) {
			t.assert(a.definitionAt(path, 2, column) == null, "compiler lookup excludes adjacent and live columns");
			t.assert(result.snapshot.definitionAt(path, 2, column) == null, "snapshot lookup excludes adjacent and live columns");
		}
		AnalysisTypeCache.release();
	}
}

// The byte offset of the first {needle} in {text}, or -1.
def indexOf(text: string, needle: string) -> int {
	for (i = 0; i + needle.length <= text.length; i++) {
		if (Strings.equal(needle, Arrays.range(text, i, i + needle.length))) return i;
	}
	return -1;
}
// Analyzes {sources}, then encodes every file's occurrences and decodes them
// as the server would.
def bindingSnapshot(t: Tester, sources: Array<AnalysisSource>) -> (ProgramAnalysis, AnalysisSnapshot) {
	var a = AeneasAdapter.analyzeProgram(sources, [], false);
	var paths = Array<string>.new(sources.length);
	var files = Array<(string, Array<AnalysisOccurrence>)>.new(sources.length);
	for (i < sources.length) {
		paths[i] = sources[i].path;
		files[i] = (paths[i], a.occurrences(paths[i]));
	}
	var frame = AnalysisWire.finishResult(AnalysisWire.encodeResult(1, 1, 1, a, 0, -1, files), 0L);
	var result = decodedResult(Ranges.dup(frame[WorkerFraming.HEADER_BYTES ...]), 1, paths);
	if (result == null) {
		t.fail("binding result did not decode");
		return (a, null);
	}
	return (a, result.snapshot);
}
// Asserts that {path}'s occurrences, in the analysis and in the snapshot, are
// the uses of {names} in order, and that the use of names[i] spans the bytes
// from begins[i] to ends[i]. Returns the analysis's occurrences.
def assertUses(t: Tester, a: ProgramAnalysis, s: AnalysisSnapshot, path: string,
		names: Array<string>, begins: Array<int>, ends: Array<int>) -> Array<AnalysisOccurrence> {
	var uses = a.occurrences(path);
	for (list in [uses, s.occurrences(path)]) {
		t.asserti(names.length, list.length);
		if (list.length != names.length) return [];
		for (i < list.length) {
			t.assert_string(names[i], list[i].declaration.name);
			t.asserti(begins[i], list[i].range.beginOffset);
			t.asserti(ends[i], list[i].range.endOffset);
		}
	}
	for (i < uses.length) {
		t.assert(uses[i].range.isTokenSpan(), "every use is a token span");
		var d = uses[i].declaration.range, decoded = s.occurrences(path)[i].declaration.range;
		t.asserti(d.beginOffset, decoded.beginOffset);
		t.asserti(d.endOffset, decoded.endOffset);
		// Every byte of a use resolves; the bytes just outside it do not.
		for (b = begins[i]; b < ends[i]; b++) {
			var found = s.definitionAtOffset(path, b);
			if (found == null) {
				t.fail(Strings.format2("missing definition in %s at byte offset %d", path, b));
				return uses;
			}
			t.assert_string(names[i], found.name);
			t.asserti(d.beginOffset, found.range.beginOffset);
		}
		t.assert(s.definitionAtOffset(path, begins[i] - 1) == null, "byte before a use");
		t.assert(s.definitionAtOffset(path, ends[i]) == null, "exclusive end offset");
	}
	return uses;
}

// Occurrence and declaration offsets come from the source bytes, not from
// compiler columns, which count a tab in a block comment as one column.
def test_binding_offsets(t: Tester) {
	var prefixes = ["/*\t*/ ", "/*\t\xF0\x9F\x98\x80\xC3\xA9*/ ", "\t", "/* start\n\t*/ "];
	var lines = [2, 2, 2, 3];
	// LSP counts an emoji as two UTF-16 units and é as one.
	var characters = [14, 17, 9, 12];
	for (i < prefixes.length) {
		var head = "component C {\n\tdef x = 1;\n", path = "binding-offsets.v3";
		var text = StringBuilder.new().puts(head).puts(prefixes[i]).puts("def y = x;\n}\n").toString();
		var use = head.length + prefixes[i].length + 8;
		var r = bindingSnapshot(t, [AnalysisSource.new(path, text)]), a = r.0, s = r.1;
		if (s == null) return;
		t.assertz(true, a.verified);
		var uses = assertUses(t, a, s, path, ["x"], [use], [use + 1]);
		if (uses.length != 1) continue;
		var decl = uses[0].declaration;
		t.assert(decl.kind == AnalysisDeclKind.FIELD, "component field");
		t.asserti(19, decl.range.beginOffset);
		t.asserti(20, decl.range.endOffset);
		var map = PositionMap.new(text, PositionEncoding.UTF16);
		var start = map.offsetToPosition(uses[0].range.beginOffset);
		t.asserti(lines[i], start.line);
		t.asserti(characters[i], start.character);
	}
}

// A declaration in another file takes its offsets from that file's bytes.
def test_cross_file_binding_offsets(t: Tester) {
	var a = "// \xC3\xA9\xF0\x9F\x98\x80\ncomponent A {\n/*\t\xF0\x9F\x98\x80*/ def x = 1;\n}\n";
	var b = "component B {\n\tdef y = A.x;\n}\n";
	var r = bindingSnapshot(t, [AnalysisSource.new("b.v3", b), AnalysisSource.new("a.v3", a)]);
	if (r.1 == null) return;
	t.assertz(true, r.0.verified);
	var use = indexOf(b, "A.x");
	var uses = assertUses(t, r.0, r.1, "b.v3", ["A", "x"], [use, use + 2], [use + 1, use + 3]);
	if (uses.length != 2) return;
	var decls = [indexOf(a, "A {"), indexOf(a, "x = 1")];
	for (i < uses.length) {
		var d = uses[i].declaration.range;
		t.assert_string("a.v3", d.path);
		t.asserti(decls[i], d.beginOffset);
		t.asserti(decls[i] + 1, d.endOffset);
	}
	t.asserti(0, r.1.occurrences("a.v3").length);
}

// Retrospective "[]" and "[]=" uses take their captured offsets, not their
// exported context-free columns, and stay in byte order. An index method
// declaration selects its opening bracket, with or without parameters.
def test_retrospective_binding_offsets(t: Tester) {
	var path = "retrospective-offsets.v3";
	// Three block-comment tabs move the exported column of "[]" past "i".
	var get = "class C { def [x: int] -> int { return x; }\n/*\t\t\t*/ def f(c: C, i: int) -> int => c.[](i);\n}\n";
	var r = bindingSnapshot(t, [AnalysisSource.new(path, get)]);
	if (r.1 == null) return;
	t.assertz(true, r.0.verified);
	var c = indexOf(get, "c.[](i)"), tref = indexOf(get, "C, i");
	var uses = assertUses(t, r.0, r.1, path, ["x", "C", "c", "[]", "i"],
		[indexOf(get, "x; }"), tref, c, c + 2, c + 5], [indexOf(get, "x; }") + 1, tref + 1, c + 1, c + 4, c + 6]);
	if (uses.length == 5) {
		t.assert(uses[4].range.beginColumn < uses[3].range.beginColumn, "exported column of [] passes i");
		var d = uses[3].declaration;
		t.asserti(indexOf(get, "[x"), d.range.beginOffset);
		t.asserti(indexOf(get, "[x") + 1, d.range.endOffset);
		t.asserti(15, d.range.beginColumn);
		t.asserti(17, d.range.endColumn);
	}
	var set = "class C { def [x: int] = y: int {}\n/*\t*/ def f(c: C) => c.[]=(1, 2);\n}\n";
	r = bindingSnapshot(t, [AnalysisSource.new(path, set)]);
	if (r.1 == null) return;
	t.assertz(true, r.0.verified);
	c = indexOf(set, "c.[]=");
	tref = indexOf(set, "C)");
	uses = assertUses(t, r.0, r.1, path, ["C", "c", "[]="], [tref, c, c + 2], [tref + 1, c + 1, c + 5]);
	if (uses.length == 3) {
		t.asserti(indexOf(set, "[x"), uses[2].declaration.range.beginOffset);
		t.asserti(indexOf(set, "[x") + 1, uses[2].declaration.range.endOffset);
	}
	var empty = "class C { def [] -> int { return 1; }\n/*\t*/ def f(c: C) -> int => c.[]();\n}\n";
	r = bindingSnapshot(t, [AnalysisSource.new(path, empty)]);
	if (r.1 == null) return;
	t.assertz(true, r.0.verified);
	c = indexOf(empty, "c.[]()");
	tref = indexOf(empty, "C)");
	uses = assertUses(t, r.0, r.1, path, ["C", "c", "[]"], [tref, c, c + 2], [tref + 1, c + 1, c + 4]);
	if (uses.length == 3) {
		t.asserti(indexOf(empty, "[] ->"), uses[2].declaration.range.beginOffset);
		t.asserti(indexOf(empty, "[] ->") + 1, uses[2].declaration.range.endOffset);
	}
}

// A name the compiler manufactures is located by replay, and spans only what
// the source spells there. An index method's "[]" spans its opening bracket,
// so it is not a token span: as a declaration it keeps that range, but the
// collector would skip it as a use. A constructor's "new" is spelled in full.
def test_manufactured_name_spans(t: Tester) {
	var path = "manufactured.v3", text = "class C {\n/*\t*/ def [x: int] -> int { return x; }\n\tnew() { }\n}\n";
	var maps = AnalysisSourceMaps.new();
	maps.add(path, text);
	var bracket = indexOf(text, "[x"), ctor = indexOf(text, "new");
	var index = maps.range(Token.new(path, "[]", 2, 11));
	t.asserti(bracket, index.beginOffset);
	t.asserti(bracket + 1, index.endOffset);
	t.asserti(13, index.endColumn);
	t.assertz(false, index.isTokenSpan());
	var made = maps.range(Token.new(path, "new", 3, 9));
	t.asserti(ctor, made.beginOffset);
	t.asserti(ctor + 3, made.endOffset);
	t.assertz(true, made.isTokenSpan());
	var captured = maps.range(AnalysisCapturedToken.new(path, "new", 3, 9, ctor));
	t.asserti(ctor, captured.beginOffset);
	t.assertz(true, captured.isTokenSpan());
	var unknown = maps.range(Token.new("other.v3", "x", 1, 1));
	t.asserti(-1, unknown.beginOffset);
	t.assertz(false, unknown.isTokenSpan());
}
