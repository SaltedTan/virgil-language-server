// textDocument/completion with the declarations in scope, from a completion
// analysis on the real worker, or on the unit-test executable where a worker
// must fail. Each session writes its project file and sources into the build's
// project-fixtures/completion directory, and edits Main.v3 in the editor
// without saving it: "$" marks the cursor in the texts below, and is removed
// before they are sent. AnalysisScopeTest covers the scope query in full.
def T = UnitTests.register;
def X = [
	T("LspCompletionScope:as_typed", test_as_typed),
	T("LspCompletionScope:items", test_items),
	T("LspCompletionScope:insert_replace", test_insert_replace),
	T("LspCompletionScope:hidden_bindings", test_hidden_bindings),
	T("LspCompletionScope:shadowed_this", test_shadowed_this),
	T("LspCompletionScope:repairs", test_repairs),
	T("LspCompletionScope:auto_closed", test_auto_closed),
	T("LspCompletionScope:repairs_past_headers", test_repairs_past_headers),
	T("LspCompletionScope:positions", test_positions),
	T("LspCompletionScope:operator_type_arguments", test_operator_type_arguments),
	T("LspCompletionScope:empty_fraction_operators", test_empty_fraction_operators),
	T("LspCompletionMembers:decimal_receivers", test_decimal_receivers),
	T("LspCompletionScope:unrepaired", test_unrepaired),
	T("LspCompletionScope:cap", test_cap),
	T("LspCompletionScope:reuse", test_reuse),
	T("LspCompletionScope:replacement", test_replacement),
	T("LspCompletionScope:cancel", test_cancel),
	T("LspCompletionScope:time_limit", test_time_limit),
	T("LspCompletionScope:worker_crash", test_worker_crash),
	T("LspCompletionScope:malformed_scope", test_malformed_scope),
	T("LspCompletionScope:answer_too_large", test_answer_too_large),
	T("LspCompletionScope:shutdown", test_shutdown),
	T("LspCompletionScope:closed_while_waiting", test_closed_while_waiting),
	T("LspCompletionScope:admission", test_admission),
	T("LspCompletionScope:submit_refused", test_submit_refused),
	T("LspCompletionScope:takes_turns", test_takes_turns),
	T("LspCompletionScope:no_project", test_no_project),
	T("LspCompletionScope:invalidated_while_running", test_invalidated_while_running),
	T("LspCompletionScope:stale_reruns_once", test_stale_reruns_once),
	T("LspCompletionScope:stale_document_or_superseded", test_stale_document_or_superseded),
	T("LspCompletionScope:ref_layouts", test_ref_layouts),
	T("LspCompletionScope:unreached", test_unreached),
	T("LspCompletionScope:other_file_unparsed", test_other_file_unparsed),
	T("LspCompletionScope:broken_sibling", test_broken_sibling),
	T("LspCompletionScope:broken_sibling_cold", test_broken_sibling_cold),
	T("LspCompletionScope:broken_sibling_refused", test_broken_sibling_refused),
	T("LspCompletionScope:querying_document_kept", test_querying_document_kept),
	T("LspCompletionScope:broken_sibling_edited_while_running", test_broken_sibling_edited_while_running),
	T("LspCompletionScope:broken_sibling_options_while_running", test_broken_sibling_options_while_running),
	T("LspCompletionScope:broken_sibling_admission", test_broken_sibling_admission),
	T("LspCompletionScope:broken_sibling_over_budget", test_broken_sibling_over_budget),
	T("LspCompletionMembers:as_typed", test_members_as_typed),
	T("LspCompletionMembers:items", test_members_items),
	T("LspCompletionMembers:insert_replace", test_members_insert_replace),
	T("LspCompletionMembers:repairs", test_members_repairs),
	T("LspCompletionMembers:no_analysis", test_members_no_analysis),
	T("LspCompletionMembers:receivers", test_members_receivers),
	T("LspCompletionMembers:unvisited_arguments", test_members_unvisited_arguments),
	T("LspCompletionMembers:malformed", test_members_malformed),
	()
];

def CONFIG = "{\"version\":1,\"projects\":[{\"name\":\"c\",\"sources\":[\"Main.v3\",\"Other.v3\"]}]}";
// Main.v3 on disk; the editor's text adds {MARK}'s line, in Shape.scale.
def MAIN = "class Shape(sides: int) {\n\tvar area: int;\n\tdef scale(factor: int) -> int {\n\t\tvar total = area * factor;\n\t\treturn total;\n\t}\n}\nclass Square extends Shape {\n\tnew() super(4) { }\n\tdef grow() { }\n}\ncomponent Registry {\n\tdef count = 3;\n\tdef paint(c: Color, t: Token) -> int { return 0; }\n}\nenum Color { RED, GREEN }\ntype Token {\n\tcase Word(text: string);\n\tcase End;\n}\ndef mainShared = 1;\n";
def MARK = "\t\treturn total;";
def OTHER = "component Other {\n\tdef helper() -> int { return hidden(); }\n\tprivate def hidden() -> int { return 1; }\n}\ndef otherShared = 2;\n";

def session(t: Tester) -> RenameTestSession {
	return sessionOn(null, t);
}
// A session on the worker at {worker}, with Main.v3 open as it is on disk.
def sessionOn(worker: string, t: Tester) -> RenameTestSession {
	var s = RenameTestSession.new("completion", [(".virgil-lsp.json", CONFIG), ("Main.v3", MAIN), ("Other.v3", OTHER)], true, worker, t);
	s.open("Main.v3", 1, MAIN);
	s.settle();
	return s;
}
// As session, for a client that also declares
// textDocument.completion.completionItem.insertReplaceSupport.
def sessionWithInsertReplace(t: Tester) -> RenameTestSession {
	var s = RenameTestSession.new("completion", [(".virgil-lsp.json", CONFIG), ("Main.v3", MAIN), ("Other.v3", OTHER)], true, null, t);
	s.withInsertReplace(t);
	s.open("Main.v3", 1, MAIN);
	s.settle();
	return s;
}
// {text} with {insert} and a newline before the first {needle}.
def before(text: string, needle: string, insert: string) -> string {
	for (i = 0; i + needle.length <= text.length; i++) {
		if (Strings.equal(Arrays.range(text, i, i + needle.length), needle)) {
			return Strings.format3("%s%s\n%s", Arrays.range(text, 0, i), insert, Arrays.range(text, i, text.length));
		}
	}
	return null;
}
// Main.v3 with the marked {line} in Shape.scale.
def inScale(line: string) -> string {
	return before(MAIN, MARK, line);
}
// The text and the cursor's offset of {marked}.
def unmark(marked: string) -> (string, int) {
	var cursor = 0;
	while (marked[cursor] != '$') cursor++;
	return (Arrays.concat(Arrays.range(marked, 0, cursor), Arrays.range(marked, cursor + 1, marked.length)), cursor);
}
// Requests a completion at the "$" in {marked}, which becomes Main.v3's next
// version unless it is the current text, and returns its id.
def request(t: Tester, s: RenameTestSession, marked: string) -> int {
	var u = unmark(marked), f = s.file("Main.v3");
	if (!Strings.equal(f.text, u.0)) s.change("Main.v3", f.version + 1, u.0);
	var p = PositionMap.new(u.0, PositionEncoding.UTF16).offsetToPosition(u.1);
	return s.send(t, "textDocument/completion", s.params("Main.v3", p.line, p.character));
}
// The rendered list of the completion at the "$" in {marked}, once answered.
def complete(t: Tester, s: RenameTestSession, marked: string) -> string {
	var id = request(t, s, marked);
	s.settle();
	t.asserti(1, s.count(id));
	return render(t, s.result(t, id));
}
// The labels of {result}'s items with a sortText, the declarations, in order,
// then "|" and the number of keywords after them, and "+" if the list is
// incomplete. Each declaration's sortText must be its rank.
def render(t: Tester, result: JsonValue) -> string {
	var buf = StringBuilder.new(), keywords = 0, items = array(member(result, "items"));
	for (i < items.length) {
		var item = items[i];
		if (!JsonValue.JObject.!(item).v.has("sortText")) {
			t.asserti(KEYWORD_KIND, intAt(item, "kind"));
			keywords++;
			continue;
		}
		t.asserti(0, keywords);
		t.assert_string(Arrays.range(Strings.format1("%d", i + 10000), 1, 5), stringAt(item, "sortText"));
		if (buf.length > 0) buf.putc(' ');
		buf.puts(stringAt(item, "label"));
	}
	if (buf.length > 0) buf.putc(' ');
	buf.put1("| %d", keywords);
	if (member(result, "isIncomplete") == JsonValue.Bool(true)) buf.puts(" +");
	return buf.toString();
}
// The item labelled {label} in {result}, or Null.
def itemOf(result: JsonValue, label: string) -> JsonValue {
	for (item in array(member(result, "items"))) if (Strings.equal(label, stringAt(item, "label"))) return item;
	return JsonValue.Null;
}
// Checks that {item} has an InsertReplaceEdit on {line} whose insertion range
// is {insertStart} to {insertEnd} and whose replacement range is
// {replaceStart} to {replaceEnd}.
def checkRanges(t: Tester, item: JsonValue, line: int, insertStart: int, insertEnd: int, replaceStart: int,
		replaceEnd: int) {
	var edit = member(item, "textEdit");
	t.assert(!has(edit, "range"), "an InsertReplaceEdit has no plain range");
	var insert = member(edit, "insert"), replace = member(edit, "replace");
	t.asserti(line, intAt(member(insert, "start"), "line"));
	t.asserti(insertStart, intAt(member(insert, "start"), "character"));
	t.asserti(line, intAt(member(insert, "end"), "line"));
	t.asserti(insertEnd, intAt(member(insert, "end"), "character"));
	t.asserti(line, intAt(member(replace, "start"), "line"));
	t.asserti(replaceStart, intAt(member(replace, "start"), "character"));
	t.asserti(line, intAt(member(replace, "end"), "line"));
	t.asserti(replaceEnd, intAt(member(replace, "end"), "character"));
}
// Whether the reply to {id} is the keywords alone: answered, with no
// declarations, and {incomplete}'s isIncomplete, which says whether a later
// request may have the names.
def keywordsOnly(t: Tester, s: RenameTestSession, id: int, incomplete: bool) -> bool {
	var r = s.reply(id);
	if (r == null || r.has("error")) return false;
	var items = array(member(r["result"], "items"));
	for (item in items) if (JsonValue.JObject.!(item).v.has("sortText")) return false;
	return items.length > 0 && member(r["result"], "isIncomplete") == JsonValue.Bool(incomplete);
}
def has(v: JsonValue, key: string) -> bool {
	return JsonValue.JObject.?(v) && JsonValue.JObject.!(v).v.has(key);
}
def array(v: JsonValue) -> Array<JsonValue> {
	return if(JsonValue.JArray.?(v), JsonValue.JArray.!(v).v, []);
}
def member(v: JsonValue, key: string) -> JsonValue {
	return if(JsonValue.JObject.?(v), JsonValue.JObject.!(v).v[key]);
}
def intAt(v: JsonValue, key: string) -> int {
	var m = member(v, key);
	return if(JsonValue.Int.?(m), JsonValue.Int.!(m).v, -1);
}
def stringAt(v: JsonValue, key: string) -> string {
	var m = member(v, key);
	return if(JsonValue.String.?(m), JsonValue.String.!(m).v, "<none>");
}
def KEYWORD_KIND = 14;
// {words}, separated by spaces.
def spaced(words: Array<string>) -> string {
	var buf = StringBuilder.new();
	for (i < words.length) {
		if (i > 0) buf.putc(' ');
		buf.puts(words[i]);
	}
	return buf.toString();
}
// The builtin types with the default language options, which
// AnalysisScopeTest checks against the verifier.
def builtins() -> string {
	return spaced(AeneasAdapter.builtinTypes([]));
}
// {names} without the integer types iN and uN.
def nonIntegers(names: Array<string>) -> string {
	var v = Vector<string>.new();
	for (n in names) if (!(n.length >= 2 && (n[0] == 'i' || n[0] == 'u') && n[1] >= '0' && n[1] <= '9')) v.put(n);
	return spaced(v.extract());
}

// In a dirty buffer that parses as typed: the declarations nearest first,
// then the keywords. The analysis is the completion's own: never the
// project's or the supervisor's snapshot, and nothing is published.
def test_as_typed(t: Tester) {
	var s = session(t);
	var ctx = s.server.projects.forDocument(s.uri("Main.v3")).active;
	t.assert(ctx.snapshot != null && ctx.snapshot.verified, "the project was analyzed");
	var marked = inScale("\t\tvar unsaved = 1;\n\t\tre$turn total;");
	var u = unmark(marked);
	s.change("Main.v3", 2, u.0);
	s.settle();
	var snapshot = ctx.snapshot, latest = s.supervisor.snapshot, published = s.notifications.length;
	var analyses = s.server.completion.analyses;
	t.assert_string(Strings.format1("total unsaved factor this area sides scale mainShared Color Other Registry Shape Square Token %s | 13", builtins()),
		complete(t, s, marked));
	t.asserti(analyses + 1, s.server.completion.analyses);
	t.assert(ctx.snapshot == snapshot, "the context keeps its snapshot");
	t.assert(s.supervisor.snapshot == latest, "the supervisor keeps its latest snapshot");
	t.asserti(published, s.notifications.length);
	s.server.close();
}

// Each declaration's kind is its symbol kind's, its detail its signature, and
// its edit replaces the prefix, as a keyword's does.
def test_items(t: Tester) {
	var s = session(t);
	var marked = inScale("\t\tsc$");
	var id = request(t, s, marked);
	s.settle();
	var result = s.result(t, id);
	for (expected in [("total", 6, "var total: int"), ("factor", 6, "factor: int"), ("area", 5, "var area: int"),
			("scale", 2, "def scale(factor: int) -> int"), ("Shape", 7, "class Shape(sides: int)"),
			("Registry", 9, "component Registry"), ("Color", 13, "enum Color"), ("this", 6, null), ("System", 9, null), ("int", 7, null)]) {
		var item = itemOf(result, expected.0);
		t.assert(item != JsonValue.Null, expected.0);
		t.asserti(expected.1, intAt(item, "kind"));
		if (expected.2 != null) t.assert_string(expected.2, stringAt(item, "detail"));
		else t.assert(!has(item, "detail"), "no detail");
		var edit = member(item, "textEdit"), range = member(edit, "range");
		t.assert_string(expected.0, stringAt(edit, "newText"));
		t.asserti(4, intAt(member(range, "start"), "line"));
		t.asserti(2, intAt(member(range, "start"), "character"));
		t.asserti(4, intAt(member(range, "end"), "line"));
		t.asserti(4, intAt(member(range, "end"), "character"));
	}
	// The keyword items are as they were without declarations.
	var keyword = itemOf(result, "while");
	t.asserti(KEYWORD_KIND, intAt(keyword, "kind"));
	t.assert(!has(keyword, "detail"), "a keyword has no detail");
	t.assert(!has(keyword, "sortText"), "a keyword has no sortText");
	s.server.close();
}

// For a client with insertReplaceSupport, every item's edit has the prefix as
// its insertion range and the whole identifier as its replacement range. At
// the identifier's end the two coincide. Without the capability the same item
// keeps the plain prefix range.
def test_insert_replace(t: Tester) {
	var s = sessionWithInsertReplace(t);
	var id = request(t, s, inScale("\t\tvar q = tot$al;"));
	s.settle();
	var result = s.result(t, id);
	// A declaration in scope and a keyword each carry both ranges.
	checkRanges(t, itemOf(result, "total"), 4, 10, 13, 10, 15);
	checkRanges(t, itemOf(result, "true"), 4, 10, 13, 10, 15);
	// At the identifier's end, the insertion and replacement ranges coincide.
	id = request(t, s, inScale("\t\tvar q = total$;"));
	s.settle();
	checkRanges(t, itemOf(s.result(t, id), "total"), 4, 10, 15, 10, 15);
	s.server.close();
	var plain = session(t);
	id = request(t, plain, inScale("\t\tvar q = tot$al;"));
	plain.settle();
	var edit = member(itemOf(plain.result(t, id), "total"), "textEdit");
	t.assert(!has(edit, "insert") && !has(edit, "replace"), "a plain TextEdit without support");
	var range = member(edit, "range");
	t.asserti(4, intAt(member(range, "start"), "line"));
	t.asserti(10, intAt(member(range, "start"), "character"));
	t.asserti(4, intAt(member(range, "end"), "line"));
	t.asserti(13, intAt(member(range, "end"), "character"));
	plain.server.close();
}

def test_hidden_bindings(t: Tester) {
	var s = session(t);
	for (name in ["int", "u32", "System"]) {
		var marked = Strings.format3("def %s = 1; class C { var first = $%s; var %s = 2; }", name, name, name);
		var result = s.result(t, complete0(t, s, marked));
		t.assert(itemOf(result, name) == JsonValue.Null, name);
		t.assert(itemOf(result, "bool") != JsonValue.Null, "unhidden builtin");
	}
	for (marked in ["component C { var int = $int; }", "class C { var first = $int; def int() {} }"]) {
		var result = s.result(t, complete0(t, s, marked));
		t.assert(itemOf(result, "int") == JsonValue.Null, "no builtin fallback");
	}
	var result = s.result(t, complete0(t, s, "class C { var int = 1; def m() { var x: $int; } }"));
	t.assert(itemOf(result, "int") != JsonValue.Null, "int remains available as a type");
	s.server.close();
}

def test_shadowed_this(t: Tester) {
	var s = session(t);
	for (fixture in [("\t\tvar this = 1; var x = $this;", "var this: int"),
		("\t\tvar f = fun (p: int) { var this = p; var x = $this; };", "var this: int"),
		("\t\tvar f = fun (this: int) => $this;", "this: int")]) {
		var result = s.result(t, complete0(t, s, inScale(fixture.0))), count = 0;
		for (item in array(member(result, "items"))) {
			if (!Strings.equal(stringAt(item, "label"), "this")) continue;
			count++;
			t.assert_string(fixture.1, stringAt(item, "detail"));
		}
		t.asserti(1, count);
	}
	var result = s.result(t, complete0(t, s, inScale("\t\tvar x = $this;")));
	t.assert(itemOf(result, "this") != JsonValue.Null, "the unshadowed receiver is offered");
	s.server.close();
}

// A text that does not parse is repaired at the cursor: an identifier and the
// delimiters or ";" that the context lacks.
def test_repairs(t: Tester) {
	var s = session(t);
	var values = Strings.format1("total factor this area sides scale mainShared Color Other Registry Shape Square Token %s", builtins());
	// A missing identifier, and a missing identifier and delimiters.
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\ttotal = $")));
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\tscale(total, $")));
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\tif ($")));
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\tvar n = (total + $")));
	// Inside a lambda, its parameter first.
	t.assert_string(Strings.format1("y %s | 5", values), complete(t, s, inScale("\t\tvar f = fun (y: int) => $")));
	t.assert_string(Strings.format1("y %s | 13", values), complete(t, s, inScale("\t\tvar f = fun (y: int) {\n\t\t\tto$\n\t\t};")));
	// The repair closes no block: a lambda's body that lacks its "}" gets
	// the keywords alone.
	t.assert_string("| 13", complete(t, s, inScale("\t\tvar f = fun (y: int) {\n\t\t\t$")));
	// With the identifier's start typed, and in the middle of an identifier,
	// which the sentinel joins.
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\ttotal = fa$")));
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\ttotal = f$a")));
	t.assert_string(Strings.format1("%s | 13", values), complete(t, s, inScale("\t\tto$tal")));
	t.assert(AeneasAdapter.parseFile("Main.v3", unmark(inScale("\t\ttotal = $")).0, []).diagnostics.length > 0, "the text does not parse");
	s.server.close();
}

// An editor closes a call's ")" as soon as the "(" is typed, so a call whose
// arguments are being typed ends at the cursor and its statement has no ";".
// The repair ends the statement after the closers, so the names in scope are
// offered as in the same call with its ";".
def test_auto_closed(t: Tester) {
	var s = session(t);
	var values = Strings.format1("total factor this area sides scale mainShared Color Other Registry Shape Square Token %s", builtins());
	// The empty first argument, the second argument, and an identifier prefix.
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\tvar n = scale($)")));
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\tvar n = scale(total, $)")));
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\tvar n = scale(to$tal)")));
	// A statement call, and a call nested in another's arguments.
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\tscale($)")));
	t.assert_string(Strings.format1("%s | 5", values), complete(t, s, inScale("\t\tvar n = scale(scale(1, $))")));
	// A member access in an auto-closed call: the receiver's members.
	t.assert_string("area sides scale | 0", complete(t, s, inScale("\t\tvar n = scale(this.$)")));
	s.server.close();
}

// A matched closer that ends a header is followed by the rest of that header
// or by a body, so the repair inserts nothing there: the type after a lambda's
// parameter, an if condition with an unbraced body and else, and a type
// annotation with a representation hint.
def test_repairs_past_headers(t: Tester) {
	var s = session(t);
	// A lambda's parameter type, in a call whose ")" follows the header.
	var lambda = before(before(MAIN, "class Square", "def apply(f: int -> int) { }\n"), MARK,
		"\t\tapply(fun (x: $) { return x; });");
	t.assert_string(Strings.format1("Color Other Registry Shape Square Token %s | 0", builtins()),
		complete(t, s, lambda));
	// An if's condition: the unbraced body keeps its statement, and the
	// receiver keeps its members.
	var condition = before(MAIN, "\tdef paint", "\tdef check(r: R) {\n\t\tif (r.$) f(); else g();\n\t}\n");
	condition = before(condition, "class Square", "class R { var field: bool; }\ndef f() { }\ndef g() { }\n");
	t.assert_string("field | 0", complete(t, s, condition));
	// A representation hint after a completed type annotation.
	var hinted = before(MAIN, "\tdef count = 3;", "\tvar b: Box<$> #hint;");
	hinted = before(hinted, "class Square", "class Box<T> { }\n");
	t.assert_string(Strings.format1("Box Color Other Registry Shape Square Token %s | 0", builtins()),
		complete(t, s, hinted));
	s.server.close();
}

// A type position offers types; a pattern, the cases; a value, values and
// callables, with "this" in a method.
def test_positions(t: Tester) {
	var s = session(t);
	t.assert_string(Strings.format1("Color Other Registry Shape Square Token %s | 0", builtins()), complete(t, s, inScale("\t\tvar v: $")));
	// The builtin types follow the project's language options.
	var readOnly = AeneasAdapter.builtinTypes(["-lang:read-only-arrays"]);
	t.assert_string("Array Range Ref System array bool byte double float int long range ref short string void", nonIntegers(readOnly));
	t.assert_string("Array Range Ref System bool byte double float int long ref short string void", nonIntegers(AeneasAdapter.builtinTypes([])));
	t.asserti(AeneasAdapter.builtinTypes([]).length + 2, readOnly.length);
	var paint = "\tdef paint(c: Color, t: Token) -> int { return 0; }";
	t.assert_string("End Word | 3", complete(t, s, before(MAIN, paint, "\tdef cases(t: Token) {\n\t\tmatch (t) {\n\t\t\t$\n\t\t}\n\t}")));
	t.assert_string("GREEN RED | 3", complete(t, s, before(MAIN, paint, "\tdef cases(c: Color) {\n\t\tmatch (c) {\n\t\t\t$\n\t\t}\n\t}")));
	// In a component's method, its members; in a subclass's, the inherited ones.
	t.assert_string(Strings.format1("this count paint run mainShared Color Other Registry Shape Square Token %s | 13", builtins()),
		complete(t, s, before(MAIN, paint, "\tdef run() {\n\t\t$\n\t}")));
	t.assert_string(Strings.format1("this grow run area sides scale mainShared Color Other Registry Shape Square Token %s | 13", builtins()),
		complete(t, s, before(MAIN, "\tdef grow() { }", "\tdef run() {\n\t\t$\n\t}")));
	s.server.close();
}

def test_decimal_receivers(t: Tester) {
	var s = session(t);
	for (index in ["0", "1"]) {
		for (member in ["f", "F", "d", "D", "e", "E"]) {
			for (trivia in ["", " /*c*/ "]) {
				var marked = Strings.format3("class C(%s: string) {}\ndef g(t: (C, C)) { var x = t.%s%s", member, trivia, index);
				marked = Strings.format2("%s.%s.$; }\n", marked, member);
				t.assert_string("length | 0", complete(t, s, marked));
			}
		}
	}
	for (index in ["0", "1"]) {
		var marked = Strings.format1("class C(e: int) {}\ndef g(t: (C, C)) { var local = 1; var x = t.%s.e+ lo$cal; }\n", index);
		var result = s.result(t, complete0(t, s, marked));
		t.assert(itemOf(result, "local") != JsonValue.Null, "local name after member and addition");
	}
	s.server.close();
}

def test_empty_fraction_operators(t: Tester) {
	var s = session(t);
	for (number in ["0", "1"]) {
		for (trivia in ["", " ", " /*c*/ "]) {
			var marked = inScale(Strings.format2("\t\tvar x = %s.%s+ to$tal;", number, trivia));
			var result = s.result(t, complete0(t, s, marked));
			t.assert(itemOf(result, "total") != JsonValue.Null, "local name after addition");
		}
	}
	s.server.close();
}

// An operator member's adjacent type arguments are an ordinary type
// position, so the cursor in them offers the types in scope.
def test_operator_type_arguments(t: Tester) {
	var s = session(t);
	var marked = "class Item { }\nclass Child extends Item { }\ndef f(x: Item) {\n\tvar y = Child.!<It$em>(x);\n}\n";
	var id = complete0(t, s, marked), result = s.result(t, id);
	t.assert_string(Strings.format1("Child Item Other %s | 0", builtins()), render(t, result));
	t.asserti(7, intAt(itemOf(result, "Item"), "kind"));
	t.asserti(7, intAt(itemOf(result, "Child"), "kind"));
	s.server.close();
}

// A text that the repair does not mend gets the keywords alone, without an
// analysis: here the parse error is elsewhere.
def test_unrepaired(t: Tester) {
	var s = session(t);
	var analyses = s.server.completion.analyses;
	var marked = Strings.format1("%sdef broken( {\n", inScale("\t\t$"));
	var id = request(t, s, marked);
	t.assert(keywordsOnly(t, s, id, false), "keywords at once");
	t.asserti(analyses, s.server.completion.analyses);
	s.server.close();
}

// Past the cap, only names that start with the prefix are kept, up to it,
// and the list is incomplete, so that the client asks again.
def test_cap(t: Tester) {
	var s = session(t);
	var buf = StringBuilder.new().puts("component Many {\n");
	for (i < 1200) buf.put1("\tdef m%d = 0;\n", i);
	buf.puts("\tdef run() {\n\t\tm11$\n\t}\n}\n");
	var got = complete(t, s, Arrays.concat(MAIN, buf.toString()));
	// The names of the fields that start with "m11", in byte order, all
	// at the component's level, and the statement's keywords.
	var names = Vector<string>.new();
	for (i < 1200) {
		var name = Strings.format1("m%d", i);
		if (Strings.startsWith(name, "m11")) names.put(name);
	}
	var sorted = AnalysisTables.sort(names.extract(), fun (a: string, b: string) => AnalysisTables.compareBytes(a, b) < 0);
	t.asserti(111, sorted.length);
	t.assert_string(Strings.format1("%s | 13 +", spaced(sorted)), got);
	s.server.close();
}

// The same version and cursor reuse the last reply; an edit does not.
def test_reuse(t: Tester) {
	var s = session(t);
	var marked = inScale("\t\tto$");
	var first = complete(t, s, marked), analyses = s.server.completion.analyses;
	var id = request(t, s, marked);
	t.assert(s.reply(id) != null, "answered at once");
	t.assert_string(first, render(t, s.result(t, id)));
	t.asserti(analyses, s.server.completion.analyses);
	// Another cursor, or the same after an edit, needs an analysis.
	complete(t, s, inScale("\t\tt$o"));
	t.asserti(analyses + 1, s.server.completion.analyses);
	var u = unmark(marked);
	s.change("Main.v3", s.file("Main.v3").version + 1, u.0);
	t.assert_string(first, complete(t, s, marked));
	t.asserti(analyses + 2, s.server.completion.analyses);
	s.server.close();
}

// A completion that waits is replaced by a newer one, and answered at once
// with its keywords, marked incomplete so that a client asks again; the one
// that runs is answered in full.
def test_replacement(t: Tester) {
	var s = session(t);
	var text = inScale("\t\ttotal$ = factor;");
	var running = request(t, s, text);
	t.assert(s.reply(running) == null, "the first runs");
	var u = unmark(text), p = PositionMap.new(u.0, PositionEncoding.UTF16).offsetToPosition(u.1);
	var waiting = s.send(t, "textDocument/completion", s.params("Main.v3", p.line, p.character - 2));
	t.assert(s.reply(waiting) == null, "the second waits");
	var newer = s.send(t, "textDocument/completion", s.params("Main.v3", p.line, p.character - 1));
	t.assert(keywordsOnly(t, s, waiting, true), "the replaced one is incomplete");
	t.assert(s.reply(newer) == null, "the newest waits");
	s.settle();
	for (id in [running, waiting, newer]) t.asserti(1, s.count(id));
	t.assert(!keywordsOnly(t, s, running, false), "the first has declarations");
	t.assert(!keywordsOnly(t, s, newer, false), "the newest has declarations");
	t.asserti(0, s.server.rename.scheduler.jobCount());
	s.server.close();
}

// $/cancelRequest answers a waiting or a running completion with
// RequestCancelled at once; a waiting one's job is withdrawn.
def test_cancel(t: Tester) {
	var s = session(t);
	var text = inScale("\t\ttotal$ = factor;");
	var running = request(t, s, text);
	var u = unmark(text), p = PositionMap.new(u.0, PositionEncoding.UTF16).offsetToPosition(u.1);
	var waiting = s.send(t, "textDocument/completion", s.params("Main.v3", p.line, p.character - 1));
	t.asserti(1, s.server.rename.scheduler.jobCount());
	s.cancel(waiting + 1000);
	t.assert(s.reply(waiting) == null && s.reply(running) == null, "another id cancels nothing");
	s.cancel(waiting);
	t.asserti(LspErrorCode.REQUEST_CANCELLED, intAt(s.reply(waiting)["error"], "code"));
	t.asserti(0, s.server.rename.scheduler.jobCount());
	s.cancel(running);
	t.asserti(LspErrorCode.REQUEST_CANCELLED, intAt(s.reply(running)["error"], "code"));
	t.assert_string("the completion was cancelled", stringAt(s.reply(running)["error"], "message"));
	var analyses = s.server.completion.analyses;
	s.settle();
	t.asserti(1, s.count(running));
	t.asserti(1, s.count(waiting));
	t.asserti(analyses, s.server.completion.analyses);
	// The next completion is answered in full.
	t.assert(!Strings.startsWith(complete(t, s, inScale("\t\tfa$")), "|"), "declarations after the cancellations");
	s.server.close();
}

// An analysis past the time limit leaves the keywords alone, marked
// incomplete: a later request may get an answer.
def test_time_limit(t: Tester) {
	var s = session(t);
	s.limits.timeoutMs = 0;
	var id = request(t, s, inScale("\t\tfa$"));
	s.settle();
	t.assert(keywordsOnly(t, s, id, true), "an incomplete reply after a timeout");
	t.asserti(1, s.count(id));
	s.limits.timeoutMs = 10000;
	t.assert(!Strings.startsWith(complete(t, s, inScale("\t\tf$a")), "|"), "declarations once the worker answers");
	s.server.close();
}

// A worker that ends during the completion's analysis leaves the keywords
// alone, marked incomplete, and the project's snapshot; the replaced worker
// answers the next.
def test_worker_crash(t: Tester) {
	var s = sessionOn(HostOs.executablePath(), t);
	var ctx = s.server.projects.forDocument(s.uri("Main.v3")).active;
	var marked = inScale(Strings.format1("\t\t// %s\n\t\tfa$ctor = 1;", SyntheticAnalysisWorker.SCOPE_CRASH));
	var u = unmark(marked);
	s.change("Main.v3", 2, u.0);
	s.settle();
	var snapshot = ctx.snapshot, started = s.supervisor.workersStarted;
	t.assert(snapshot != null && snapshot.verified, "the project's analysis does not crash");
	var id = request(t, s, marked);
	s.settle();
	t.assert(keywordsOnly(t, s, id, true), "an incomplete reply after a crash");
	t.assert(ctx.snapshot == snapshot, "the context keeps its snapshot");
	t.assert(!Strings.startsWith(complete(t, s, inScale("\t\tfa$")), "|"), "declarations from the next worker");
	t.assert(s.supervisor.workersStarted > started, "a new worker started");
	s.server.close();
}

// A scope answer that names a declaration twice is rejected as malformed, and
// the reply has the keywords alone, marked incomplete: the worker failed.
def test_malformed_scope(t: Tester) {
	var s = sessionOn(HostOs.executablePath(), t);
	var id = request(t, s, inScale(Strings.format1("\t\t// %s\n\t\tfa$", SyntheticAnalysisWorker.SCOPE_MALFORMED)));
	s.settle();
	t.assert(keywordsOnly(t, s, id, true), "an incomplete reply after a malformed answer");
	t.assert(!Strings.startsWith(complete(t, s, inScale("\t\tfa$")), "|"), "declarations from a well-formed answer");
	s.server.close();
}

// A result over the query's decoding budget fails safely, as an oversized
// result of a project's analysis does: the reply has the keywords alone,
// marked incomplete, the context keeps its snapshot, and the replaced worker
// answers the next.
def test_answer_too_large(t: Tester) {
	var s = sessionOn(HostOs.executablePath(), t);
	var ctx = s.server.projects.forDocument(s.uri("Main.v3")).active;
	var started = s.supervisor.workersStarted;
	var id = request(t, s, inScale(Strings.format1("\t\t// %s\n\t\tfa$", SyntheticAnalysisWorker.SCOPE_TOO_LARGE)));
	s.settle();
	t.assert(keywordsOnly(t, s, id, true), "an incomplete reply after a result over the budget");
	t.assert(!Strings.startsWith(complete(t, s, inScale("\t\tfa$")), "|"), "declarations from the next worker");
	t.assert(s.supervisor.workersStarted > started, "a new worker started");
	t.assert(ctx.snapshot != null, "the context has a snapshot");
	s.server.close();
}

// Shutdown answers the running and the waiting completion with their
// keywords; later requests are refused.
def test_shutdown(t: Tester) {
	var s = session(t);
	var text = inScale("\t\ttotal$ = factor;");
	var running = request(t, s, text);
	var u = unmark(text), p = PositionMap.new(u.0, PositionEncoding.UTF16).offsetToPosition(u.1);
	var waiting = s.send(t, "textDocument/completion", s.params("Main.v3", p.line, p.character - 1));
	var shutdown = s.server.handle(JsonRpcMessage.Request(JsonRpcId.Int(1), "shutdown", JsonRpcParams.ByName(Strings.newMap<JsonValue>())).encode());
	t.assert(shutdown != null, "shutdown answered");
	t.assert(keywordsOnly(t, s, running, false), "the running completion gets its keywords");
	t.assert(keywordsOnly(t, s, waiting, false), "the waiting completion gets its keywords");
	var later = s.server.handle(JsonRpcMessage.Request(JsonRpcId.Int(2), "textDocument/completion",
		JsonRpcParams.ByName(s.params("Main.v3", p.line, p.character))).encode());
	t.assert_string("{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32600,\"message\":\"the server is shutting down\"}}", later);
	t.asserti(1, s.count(running));
	t.asserti(1, s.count(waiting));
	s.server.close();
}

// A completion whose document closes or changes before its analysis starts
// gets its keywords, marked incomplete, without an analysis.
def test_closed_while_waiting(t: Tester) {
	var s = session(t);
	var text = inScale("\t\ttotal$ = factor;");
	var running = request(t, s, text);
	var u = unmark(text), p = PositionMap.new(u.0, PositionEncoding.UTF16).offsetToPosition(u.1);
	var waiting = s.send(t, "textDocument/completion", s.params("Main.v3", p.line, p.character - 1));
	var analyses = s.server.completion.analyses;
	s.closeDocument("Main.v3");
	s.settle();
	t.assert(keywordsOnly(t, s, waiting, true), "an incomplete reply for the closed document");
	t.asserti(1, s.count(running));
	t.asserti(analyses, s.server.completion.analyses);
	s.server.close();
}

// The completion's result is admitted within the workspace's snapshot budget,
// as a rename's preflight is; when it does not fit, the keywords are the
// reply, marked incomplete, no analysis starts, and the refusal is logged
// once, with its charges.
def test_admission(t: Tester) {
	var s = session(t), rec = DocumentWarningRecorder.new();
	s.server.warnProject = rec.warn;
	var latest = s.supervisor.snapshot, bytes = latest.retainedBytes;
	latest.retainedBytes = s.server.projects.MAX_SNAPSHOT_BYTES;
	var analyses = s.server.completion.analyses;
	var id = request(t, s, inScale("\t\tfa$"));
	s.settle();
	t.assert(keywordsOnly(t, s, id, true), "an incomplete reply when the snapshot does not fit");
	t.asserti(analyses, s.server.completion.analyses);
	var refused = refusals(rec, "the completion's analysis was refused: ");
	t.asserti(1, refused.length);
	if (refused.length == 1) {
		t.assert(Strings.startsWith(refused[0], "the completion's analysis was refused: retained snapshots take 33554432 bytes, of which 33554432 bytes can't be freed, and a reservation of "), refused[0]);
		t.assert(Strings.endsWith(refused[0], " bytes doesn't fit beside them within the budget of 33554432 bytes"), refused[0]);
	}
	latest.retainedBytes = bytes;
	t.assert(!Strings.startsWith(complete(t, s, inScale("\t\tf$a")), "|"), "declarations once it fits");
	t.asserti(analyses + 1, s.server.completion.analyses);
	t.asserti(1, refusals(rec, "the completion's analysis was refused: ").length);
	s.server.close();
}
// The lines of {rec} that begin with {prefix}.
def refusals(rec: DocumentWarningRecorder, prefix: string) -> Array<string> {
	var result = Vector<string>.new();
	for (i < rec.lines.length) if (Strings.startsWith(rec.lines[i], prefix)) result.put(rec.lines[i]);
	return result.extract();
}

// A scheduler that has closed, as the server's has as it shuts down, refuses
// the job: the reply is the keywords, complete, since no later request can
// have the names either.
def test_submit_refused(t: Tester) {
	var s = session(t);
	var analyses = s.server.completion.analyses;
	s.server.completion.scheduler.close();
	var id = request(t, s, inScale("\t\tfa$"));
	t.assert(s.reply(id) != null, "answered at once");
	t.assert(keywordsOnly(t, s, id, false), "a complete reply without a scheduler");
	t.assert_string("| 13", render(t, s.result(t, id)));
	t.asserti(analyses, s.server.completion.analyses);
	s.server.close();
}

// Completions, renames, and the project's analyses share the worker, and all
// are answered: a completion queued behind a rename's preflight and a due
// project waits for neither to starve it.
def test_takes_turns(t: Tester) {
	var s = session(t);
	var ctx = s.server.projects.forDocument(s.uri("Main.v3")).active;
	var marked = inScale("\t\tvar unsaved = 1;\n\t\tfa$ctor = 1;");
	var u = unmark(marked);
	s.change("Main.v3", 2, u.0);
	var generation = s.supervisor.snapshot.generation;
	var p = PositionMap.new(u.0, PositionEncoding.UTF16).offsetToPosition(u.1);
	var rename = s.rename(t, "Main.v3", 1, 6, "surface");
	var completion = s.send(t, "textDocument/completion", s.params("Main.v3", p.line, p.character));
	t.assert(s.reply(rename) == null && s.reply(completion) == null, "both wait");
	s.settle();
	t.assert(has(s.result(t, rename), "documentChanges"), "the rename is answered");
	t.assert(!keywordsOnly(t, s, completion, false), "the completion has declarations");
	t.assert(itemOf(s.result(t, completion), "unsaved") != JsonValue.Null, "from the edited text");
	t.assert(ctx.snapshot.generation > generation, "the project was analyzed");
	t.assert(ctx.snapshot.matchesDocument(s.server.documents, s.uri("Main.v3")), "the project's snapshot is current");
	s.server.close();
}

// Without a project, or with an untitled document, the keywords are the
// reply, at once.
def test_no_project(t: Tester) {
	var s = session(t);
	var analyses = s.server.completion.analyses;
	var doc = Strings.newMap<JsonValue>(), params = Strings.newMap<JsonValue>(), position = Strings.newMap<JsonValue>();
	doc["uri"] = JsonValue.String("untitled:Loose.v3");
	doc["languageId"] = JsonValue.String("virgil");
	doc["version"] = JsonValue.Int(1);
	doc["text"] = JsonValue.String("def f(x: int) {\n\t\n}\n");
	params["textDocument"] = JsonValue.JObject(doc);
	s.server.handle(JsonRpcMessage.Notification("textDocument/didOpen", JsonRpcParams.ByName(params)).encode());
	doc.remove("languageId");
	doc.remove("version");
	doc.remove("text");
	position["line"] = JsonValue.Int(1);
	position["character"] = JsonValue.Int(1);
	params["position"] = JsonValue.JObject(position);
	var id = s.send(t, "textDocument/completion", params);
	t.assert(keywordsOnly(t, s, id, false), "keywords at once for an untitled document");
	t.asserti(analyses, s.server.completion.analyses);
	s.server.close();
}

// Other.v3, edited: its component becomes a class.
def FRESH = "class Fresh { }\ndef otherShared = 2;\n";
// Polls {s} until {done} or nothing runs or waits.
def pollUntil(s: RenameTestSession, done: void -> bool) {
	var fds = Array<int>.new(4);
	while (!done() && s.server.analyzing()) {
		var count = s.supervisor.pollFds(fds, 0);
		HostOs.poll(fds, count, s.server.pollTimeout());
		s.server.onPoll();
	}
}

// A project file that changes while a completion's analysis runs makes that
// analysis stale: it runs again, and the reply and the cached reply have the
// new declarations.
def test_invalidated_while_running(t: Tester) {
	var s = session(t);
	s.open("Other.v3", 1, OTHER);
	s.settle();
	var marked = inScale("\t\tto$"), analyses = s.server.completion.analyses;
	var id = request(t, s, marked);
	t.assert(s.reply(id) == null, "the completion runs");
	s.change("Other.v3", 2, FRESH);
	s.settle();
	var result = s.result(t, id);
	t.assert(itemOf(result, "Fresh") != JsonValue.Null, "the new class");
	t.assert(itemOf(result, "Other") == JsonValue.Null, "not the old component");
	t.asserti(analyses + 2, s.server.completion.analyses);
	// The same cursor again: the cached reply, which is the new one.
	var again = request(t, s, marked);
	t.assert(s.reply(again) != null, "answered at once");
	t.assert_string(render(t, result), render(t, s.result(t, again)));
	t.asserti(analyses + 2, s.server.completion.analyses);
	s.server.close();
}

// A completion runs again only once: stale again, its reply is the keywords,
// and nothing is cached.
def test_stale_reruns_once(t: Tester) {
	var s = session(t);
	s.open("Other.v3", 1, OTHER);
	s.settle();
	var marked = inScale("\t\tto$"), analyses = s.server.completion.analyses;
	var id = request(t, s, marked);
	s.change("Other.v3", 2, FRESH);
	pollUntil(s, fun => s.server.completion.analyses == analyses + 2);
	t.asserti(analyses + 2, s.server.completion.analyses);
	t.assert(s.reply(id) == null, "the completion runs again");
	s.change("Other.v3", 3, OTHER);
	s.settle();
	t.assert(keywordsOnly(t, s, id, true), "an incomplete reply when stale again");
	t.asserti(analyses + 2, s.server.completion.analyses);
	// Nothing was cached: the next request analyzes.
	t.assert(itemOf(s.result(t, complete0(t, s, marked)), "Other") != JsonValue.Null, "the current declarations");
	t.asserti(analyses + 3, s.server.completion.analyses);
	s.server.close();
}
// Requests a completion at {marked} and returns its id once answered.
def complete0(t: Tester, s: RenameTestSession, marked: string) -> int {
	var id = request(t, s, marked);
	s.settle();
	return id;
}

// A stale completion whose document changed, or that a newer one waits
// behind, gets the keywords and does not run again.
def test_stale_document_or_superseded(t: Tester) {
	var s = session(t);
	s.open("Other.v3", 1, OTHER);
	s.settle();
	var marked = inScale("\t\tto$"), analyses = s.server.completion.analyses;
	var id = request(t, s, marked);
	var u = unmark(marked);
	s.change("Main.v3", s.file("Main.v3").version + 1, Arrays.concat(u.0, "\n"));
	s.settle();
	t.assert(keywordsOnly(t, s, id, true), "an incomplete reply for an edited document");
	t.asserti(analyses + 1, s.server.completion.analyses);
	// Superseded: a newer completion waits when the stale one ends.
	var stale = request(t, s, marked);
	s.change("Other.v3", 2, FRESH);
	var p = PositionMap.new(u.0, PositionEncoding.UTF16).offsetToPosition(u.1);
	var newer = s.send(t, "textDocument/completion", s.params("Main.v3", p.line, p.character - 1));
	s.settle();
	t.assert(keywordsOnly(t, s, stale, true), "an incomplete reply for the superseded one");
	t.assert(itemOf(s.result(t, newer), "Fresh") != JsonValue.Null, "the newer one has the new class");
	t.asserti(analyses + 3, s.server.completion.analyses);
	s.server.close();
}

// The type argument of Ref<...> offers the layouts, and only them, as typed
// and repaired.
def test_ref_layouts(t: Tester) {
	var s = session(t);
	var pixel = "layout Pixel {\n\t+0 v: u32;\n\t=4;\n}\n";
	t.assert_string("Pixel | 0", complete(t, s, Arrays.concat(inScale("\t\tvar r: Ref<$Pixel>;"), pixel)));
	t.assert_string("Pixel | 0", complete(t, s, Arrays.concat(inScale("\t\tvar r: Ref<$"), pixel)));
	t.assert_string("Pixel | 0", complete(t, s, Arrays.concat(inScale("\t\tvar r: ref< /* layout */ $"), pixel)));
	// Elsewhere in a type, a layout is no type.
	t.assert(!Strings.startsWith(complete(t, s, Arrays.concat(inScale("\t\tvar r: Array<$"), pixel)), "Pixel"), "types in Array<...>");
	s.server.close();
}

// Where verification stopped at the error limit before the cursor's member,
// the reply is the keywords, complete: the analysis did complete, and a later
// request at this text would not reach the cursor either.
def test_unreached(t: Tester) {
	var s = session(t);
	var errors = StringBuilder.new().puts("component Errors {\n\tdef f() {\n");
	for (i < 16) errors.put1("\t\tunresolved%d;\n", i);
	var bad = errors.puts("\t}\n}\n").toString();
	t.assert_string("| 13", complete(t, s, Arrays.concat(inScale("\t\tto$"), bad)));
	// Errors in a class after Shape: classes are type-checked in order, so
	// Shape's methods are reached.
	var classErrors = StringBuilder.new().puts("class Errors {\n\tdef f() {\n");
	for (i < 16) classErrors.put1("\t\tunresolved%d;\n", i);
	t.assert(!Strings.startsWith(complete(t, s, Arrays.concat(inScale("\t\tto$"), classErrors.puts("\t}\n}\n").toString())), "|"),
		"declarations where verification reached");
	s.server.close();
}

// Another file of the project that doesn't parse, here with a damaged method
// header, leaves the analysis without names, and the reply is the keywords,
// complete: typing more of the word doesn't change that file. A request after
// it parses again gets the names.
def test_other_file_unparsed(t: Tester) {
	var s = session(t);
	s.open("Other.v3", 1, OTHER);
	s.settle();
	s.change("Other.v3", 2, "component Other {\n\tdef helper(-> int { return 1; }\n}\ndef otherShared = 2;\n");
	s.settle();
	t.assert_string("| 13", complete(t, s, inScale("\t\tto$")));
	s.change("Other.v3", 3, OTHER);
	s.settle();
	t.assert(!Strings.startsWith(complete(t, s, inScale("\t\tto$")), "|"), "the names once Other.v3 parses");
	s.server.close();
}

// Other.v3 with a syntax error inside helper's body, which method-body
// fallback and current-text repair both accept.
def BROKEN_BODY = "component Other {\n\tdef helper() -> int { var unfinished = ; return hidden(); }\n\tprivate def hidden() -> int { return 1; }\n}\ndef otherShared = 2;\n";
// The names and the members at the cursors that the sibling tests use.
def SIBLING_NAMES = "\t\tOth$";
def SIBLING_MEMBERS = "\t\tOther.$";
// The hover over the first {needle} in Main.v3, whose text must be {text}.
def hoverIn(t: Tester, s: RenameTestSession, text: string, needle: string) -> JsonValue {
	t.assert_string(text, s.text("Main.v3"));
	var p = PositionMap.new(text, PositionEncoding.UTF16).offsetToPosition(offsetOf(text, needle));
	var id = s.send(t, "textDocument/hover", s.params("Main.v3", p.line, p.character));
	s.settle();
	return s.result(t, id);
}
// The offset of the first {needle} in {text}, or -1.
def offsetOf(text: string, needle: string) -> int {
	for (i = 0; i + needle.length <= text.length; i++) {
		if (Strings.equal(Arrays.range(text, i, i + needle.length), needle)) return i;
	}
	return -1;
}

// The reply of the completion at the "$" in {marked}, with Main.v3's text
// already that of {marked} and analyzed, so that only the completion's own
// analysis runs: it replaces neither the project's nor the supervisor's
// snapshot, and publishes nothing.
def quiet(t: Tester, s: RenameTestSession, marked: string) -> JsonValue {
	var u = unmark(marked), f = s.file("Main.v3");
	if (!Strings.equal(f.text, u.0)) s.change("Main.v3", f.version + 1, u.0);
	s.settle();
	var ctx = context(s), snapshot = ctx.snapshot, latest = s.supervisor.snapshot;
	var published = s.notifications.length, analyses = s.server.completion.analyses;
	var id = complete0(t, s, marked);
	t.asserti(analyses + 1, s.server.completion.analyses);
	t.assert(ctx.snapshot == snapshot, "the context keeps its snapshot");
	t.assert(s.supervisor.snapshot == latest, "the supervisor keeps its latest snapshot");
	t.asserti(published, s.notifications.length);
	return s.result(t, id);
}
def context(s: RenameTestSession) -> ProjectContext {
	return s.server.projects.forDocument(s.uri("Main.v3")).active;
}
// Whether the parseable text that {s} caches for {name} is {text}, or none if
// {text} is null.
def cachedIs(s: RenameTestSession, name: string, text: string) -> bool {
	var cached = s.server.projects.parseableText.get(context(s), s.uri(name));
	if (text == null || cached == null) return text == cached;
	return Strings.equal(text, cached);
}
// The reply at SIBLING_NAMES in the intact program.
def siblingNames() -> string {
	return Strings.format1("total factor this area sides scale mainShared Color Other Registry Shape Square Token %s | 13", builtins());
}

// Another open file whose method body has an eligible syntax error doesn't
// take the names or the members from Main.v3 (#346): hover outside the
// damaged body is available from the project's analysis, and completion's
// analysis recovers the other file as that analysis does, so both replies
// are the ones the intact program gets. Warm, Other.v3's last parseable text
// stands in for it. Its declarations get no documentation from that text, and
// no text the completion analyzed is cached as parseable.
def test_broken_sibling(t: Tester) {
	var s = session(t);
	s.open("Other.v3", 1, OTHER);
	s.settle();
	var intact = quiet(t, s, inScale(SIBLING_NAMES));
	var names = render(t, intact), members = render(t, quiet(t, s, inScale(SIBLING_MEMBERS)));
	t.assert_string(siblingNames(), names);
	t.assert(has(itemOf(intact, "Other"), "data"), "Other resolves while its file is intact");
	t.assert_string("helper | 0", members);
	s.change("Main.v3", s.file("Main.v3").version + 1, MAIN);
	s.change("Other.v3", 2, BROKEN_BODY);
	s.settle();
	t.assert(JsonValue.JObject.?(hoverIn(t, s, MAIN, "area * factor")), "hover outside the damaged body");
	t.assert(cachedIs(s, "Other.v3", OTHER), "warm: Other.v3's parseable text is cached");
	var recovered = quiet(t, s, inScale(SIBLING_NAMES));
	t.assert_string(names, render(t, recovered));
	t.assert(itemOf(recovered, "Other") != JsonValue.Null && !has(itemOf(recovered, "Other"), "data"),
		"no documentation from substituted text");
	t.assert(itemOf(recovered, "unfinished") == JsonValue.Null, "no local of the damaged body");
	t.assert_string(members, render(t, quiet(t, s, inScale(SIBLING_MEMBERS))));
	t.assert(cachedIs(s, "Other.v3", OTHER), "Other.v3's parseable text is unchanged");
	var main = s.server.projects.parseableText.get(context(s), s.uri("Main.v3"));
	t.assert(main != null && offsetOf(main, LspCompletionRepair.SENTINEL) < 0, "no repaired text is cached");
	s.server.close();
}
// As session, with {other} as Other.v3 on disk.
def sessionWithOther(t: Tester, other: string) -> RenameTestSession {
	var s = RenameTestSession.new("completion", [(".virgil-lsp.json", CONFIG), ("Main.v3", MAIN), ("Other.v3", other)], true, null, t);
	s.open("Main.v3", 1, MAIN);
	s.settle();
	return s;
}
// Cold, with no parseable text of Other.v3 cached since it never parsed:
// closed, it is not repaired, and the analysis completes without names, so
// the replies are complete; open, its damaged body is emptied.
def test_broken_sibling_cold(t: Tester) {
	var s = sessionWithOther(t, BROKEN_BODY);
	t.assert_string("| 13", complete(t, s, inScale(SIBLING_NAMES)));
	t.assert_string("| 0", complete(t, s, inScale(SIBLING_MEMBERS)));
	s.open("Other.v3", 1, BROKEN_BODY);
	s.settle();
	t.assert(cachedIs(s, "Other.v3", null), "cold: no parseable text of Other.v3");
	t.assert_string(siblingNames(), render(t, quiet(t, s, inScale(SIBLING_NAMES))));
	t.assert_string("helper | 0", render(t, quiet(t, s, inScale(SIBLING_MEMBERS))));
	t.assert(cachedIs(s, "Other.v3", null), "nor after the completions");
	s.server.close();
}
// Syntax errors in Other.v3 that neither fallback nor repair accepts: in a
// method's header, in a field's initializer, after an unterminated string or
// block comment in a body, and with two closing braces missing.
def REFUSED = [
	"component Other {\n\tdef helper(-> int { return 1; }\n}\ndef otherShared = 2;\n",
	"component Other {\n\tvar field = ;\n\tdef helper() -> int { return hidden(); }\n\tprivate def hidden() -> int { return 1; }\n}\ndef otherShared = 2;\n",
	"component Other {\n\tdef helper() -> int { var s = \"open; return hidden(); }\n\tprivate def hidden() -> int { return 1; }\n}\ndef otherShared = 2;\n",
	"component Other {\n\tdef helper() -> int { /* open return hidden(); }\n\tprivate def hidden() -> int { return 1; }\n}\ndef otherShared = 2;\n",
	"component Other {\n\tdef helper() -> int { if (true) { if (true) { return hidden();\n\tprivate def hidden() -> int { return 1; }\n}\ndef otherShared = 2;\n"
];
// Each refused error leaves the analysis without names, warm and cold, and
// the replies complete, as before (#327). A second error in Main.v3, which its
// repair at the cursor doesn't mend, gets the keywords at once, without an
// analysis, beside an Other.v3 that is recovered.
def test_broken_sibling_refused(t: Tester) {
	var s = session(t);
	var version = 1;
	s.open("Other.v3", version, OTHER);
	for (text in REFUSED) {
		s.change("Other.v3", ++version, OTHER);
		s.settle();
		s.change("Other.v3", ++version, text);
		s.settle();
		t.assert(cachedIs(s, "Other.v3", OTHER), "warm");
		t.assert_string("| 13", complete(t, s, inScale(SIBLING_NAMES)));
		t.assert_string("| 0", complete(t, s, inScale(SIBLING_MEMBERS)));
		s.server.projects.parseableText.removeContext(context(s));
		t.assert_string("| 13", complete(t, s, inScale("\t\tOt$")));
		t.assert_string("| 0", complete(t, s, inScale("\t\tOther.h$")));
	}
	s.change("Other.v3", ++version, BROKEN_BODY);
	s.settle();
	var analyses = s.server.completion.analyses;
	var id = request(t, s, Strings.format1("%sdef broken( {\n", inScale(SIBLING_NAMES)));
	t.assert(s.reply(id) != null, "answered at once");
	t.assert_string("| 13", render(t, s.result(t, id)));
	t.asserti(analyses, s.server.completion.analyses);
	s.server.close();
}
// {text} with its first {needle} replaced by {replacement}.
def replaced(text: string, needle: string, replacement: string) -> string {
	var i = offsetOf(text, needle);
	return Strings.format3("%s%s%s", Arrays.range(text, 0, i), replacement, Arrays.range(text, i + needle.length, text.length));
}
// Main.v3 itself is never substituted: it keeps its repair at the cursor, and
// no answer comes from its last parseable text, here MAIN, where the local
// that the edit renamed still has its old name.
def test_querying_document_kept(t: Tester) {
	var s = session(t);
	s.open("Other.v3", 1, BROKEN_BODY);
	s.settle();
	t.assert(cachedIs(s, "Main.v3", MAIN), "Main.v3's parseable text is MAIN");
	var result = quiet(t, s, before(replaced(MAIN, "var total", "var fresh"), MARK, "\t\tto$"));
	t.assert(itemOf(result, "fresh") != JsonValue.Null, "the local as edited");
	t.assert(itemOf(result, "total") == JsonValue.Null, "not as cached");
	t.assert(itemOf(result, "Other") != JsonValue.Null, "Other.v3 is recovered");
	s.server.close();
}
// Other.v3, edited into a class whose method body is damaged too.
def FRESH_BROKEN = "class Fresh {\n\tdef m() -> int { var x = ; return 1; }\n}\ndef otherShared = 2;\n";
// Editing the damaged file while a completion runs makes its analysis stale:
// it runs again, recovering the file as edited, and only that reply is sent
// and cached.
def test_broken_sibling_edited_while_running(t: Tester) {
	var s = session(t);
	s.open("Other.v3", 1, BROKEN_BODY);
	s.settle();
	var marked = inScale(SIBLING_NAMES), analyses = s.server.completion.analyses;
	var id = request(t, s, marked);
	t.assert(s.reply(id) == null, "the completion runs");
	s.change("Other.v3", 2, FRESH_BROKEN);
	s.settle();
	var result = s.result(t, id);
	t.assert(itemOf(result, "Fresh") != JsonValue.Null, "the new class");
	t.assert(itemOf(result, "Other") == JsonValue.Null, "not the old component");
	t.asserti(analyses + 2, s.server.completion.analyses);
	var again = request(t, s, marked);
	t.assert(s.reply(again) != null, "answered at once");
	t.assert_string(render(t, result), render(t, s.result(t, again)));
	t.asserti(analyses + 2, s.server.completion.analyses);
	s.server.close();
}
// The project file with a language option, which replaces the project.
def CONFIG_OPTIONS = "{\"version\":1,\"projects\":[{\"name\":\"c\",\"sources\":[\"Main.v3\",\"Other.v3\"],\"compilerArgs\":[\"-lang:fun-exprs\"]}]}";
// Changing the project's language options while a completion runs leaves the
// keywords, incomplete, and caches nothing: the next request gets the names
// of the project as it now is.
def test_broken_sibling_options_while_running(t: Tester) {
	var s = session(t);
	s.open("Other.v3", 1, BROKEN_BODY);
	s.settle();
	var marked = inScale(SIBLING_NAMES), previous = context(s);
	var id = request(t, s, marked);
	t.assert(s.reply(id) == null, "the completion runs");
	s.write(t, ".virgil-lsp.json", CONFIG_OPTIONS);
	s.reportChanged(".virgil-lsp.json");
	s.settle();
	t.assert(context(s) != previous, "the project was replaced");
	t.assert(keywordsOnly(t, s, id, true), "an incomplete reply");
	var analyses = s.server.completion.analyses;
	t.assert_string(siblingNames(), complete(t, s, marked));
	t.asserti(analyses + 1, s.server.completion.analyses);
	s.server.close();
}
// The reservation that admission refuses for the completion at {marked}, as
// the server logs it to {rec}.
def refusedReservation(t: Tester, s: RenameTestSession, rec: DocumentWarningRecorder, marked: string) -> long {
	var u = unmark(marked), f = s.file("Main.v3");
	if (!Strings.equal(f.text, u.0)) s.change("Main.v3", f.version + 1, u.0);
	s.settle();
	var latest = s.supervisor.snapshot, bytes = latest.retainedBytes;
	var logged = refusals(rec, "the completion's analysis was refused: ").length;
	latest.retainedBytes = s.server.projects.MAX_SNAPSHOT_BYTES;
	var id = complete0(t, s, marked);
	latest.retainedBytes = bytes;
	t.assert(keywordsOnly(t, s, id, true), "refused");
	var refused = refusals(rec, "the completion's analysis was refused: ");
	t.asserti(logged + 1, refused.length);
	if (refused.length != logged + 1) return -1;
	var line = refused[logged], label = "a reservation of ", i = offsetOf(line, label), n = 0L;
	if (i < 0) return -1;
	for (j = i + label.length; j < line.length && line[j] >= '0' && line[j] <= '9'; j++) n = n * 10 + (int.view(line[j]) - 48);
	return n;
}
// Admission charges a completion's analysis for Other.v3's substitution
// too: its effective text and the metadata of AnalysisSubstitution.bytes.
def test_broken_sibling_admission(t: Tester) {
	var s = session(t), rec = DocumentWarningRecorder.new();
	s.server.warnProject = rec.warn;
	s.open("Other.v3", 1, OTHER);
	s.settle();
	var intact = refusedReservation(t, s, rec, inScale(SIBLING_NAMES));
	s.change("Other.v3", 2, BROKEN_BODY);
	s.settle();
	var broken = refusedReservation(t, s, rec, inScale(SIBLING_NAMES));
	t.assert(intact > 0, "a reservation was logged");
	t.assertl(256L + OTHER.length, broken - intact);
	t.assert_string(siblingNames(), render(t, quiet(t, s, inScale(SIBLING_NAMES))));
	s.server.close();
}
// The project file of the source-budget test, whose Fill.v3 takes most of
// LspAnalysisCapture.MAX_SOURCE_BYTES.
def CONFIG_FILL = "{\"version\":1,\"projects\":[{\"name\":\"c\",\"sources\":[\"Main.v3\",\"Other.v3\",\"Fill.v3\"]}]}";
// {n} bytes of x.
def xs(n: int) -> string {
	var a = Array<byte>.new(n);
	for (i < n) a[i] = 'x';
	return a;
}
// A substitution that takes the sources past their size budget fails the
// completion's capture: the keywords, incomplete, as for any failed capture,
// with no analysis, admission, cached text, or snapshot changed.
def test_broken_sibling_over_budget(t: Tester) {
	var fill = Strings.format1("// %s\n", xs(3250000));
	var s = RenameTestSession.new("completion", [(".virgil-lsp.json", CONFIG_FILL), ("Main.v3", MAIN), ("Other.v3", OTHER),
		("Fill.v3", fill)], true, null, t);
	var rec = DocumentWarningRecorder.new();
	s.server.warnProject = rec.warn;
	s.open("Main.v3", 1, MAIN);
	s.open("Other.v3", 1, BROKEN_BODY);
	s.settle();
	var marked = inScale(SIBLING_NAMES);
	t.assert_string(siblingNames(), render(t, quiet(t, s, marked)));
	// About 1 MB of last parseable text, which the comment in helper's body
	// fills: substituting it adds about 1 MB to the sources.
	var big = Strings.format1("component Other {\n\tdef helper() -> int { /*%s*/ return hidden(); }\n\tprivate def hidden() -> int { return 1; }\n}\ndef otherShared = 2;\n", xs(1000000));
	var ctx = context(s), cache = s.server.projects.parseableText;
	cache.put(ctx, s.uri("Other.v3"), big);
	var snapshot = ctx.snapshot, latest = s.supervisor.snapshot, analyses = s.server.completion.analyses;
	var id = complete0(t, s, Strings.format1("%s\n", marked));
	t.assert(keywordsOnly(t, s, id, true), "the keywords, incomplete");
	t.asserti(analyses, s.server.completion.analyses);
	t.assert(ctx.snapshot == snapshot && s.supervisor.snapshot == latest, "no snapshot changed");
	t.assert(cache.get(ctx, s.uri("Other.v3")) == big, "Other.v3's parseable text is kept");
	t.asserti(0, refusals(rec, "the completion's analysis was refused: ").length);
	s.server.close();
	s.write(t, "Fill.v3", "");
}

// Member completion: after ".", the members of the receiver's type alone,
// from the same completion analyses. AnalysisMembersTest covers the member
// query in full.
def SQUARE = "grow area sides scale";
// In a dirty buffer that parses as typed: the members, nearest class first,
// and no keyword.
def test_members_as_typed(t: Tester) {
	var s = session(t);
	var analyses = s.server.completion.analyses;
	t.assert_string(Strings.format1("%s | 0", SQUARE), complete(t, s, inScale("\t\tvar q = Square.new();\n\t\tq.$grow();")));
	t.asserti(analyses + 1, s.server.completion.analyses);
	// On a type: a component's members, an enum's, and a variant's.
	t.assert_string("count paint | 0", complete(t, s, inScale("\t\tvar n = Registry.$count;")));
	t.assert_string("count name tag GREEN RED set | 0", complete(t, s, inScale("\t\tvar c = Color.$RED;")));
	t.assert_string("name tag End Word | 0", complete(t, s, inScale("\t\tvar w = Token.$End;")));
	s.server.close();
}
// Each member's kind is its symbol kind's, its detail its signature, and its
// edit replaces the prefix after the ".".
def test_members_items(t: Tester) {
	var s = session(t);
	var id = request(t, s, inScale("\t\tvar q = Square.new();\n\t\tq.gr$();"));
	s.settle();
	var result = s.result(t, id);
	t.assert(member(result, "isIncomplete") == JsonValue.Bool(false), "a complete list");
	for (expected in [("grow", 2, "def grow()"), ("area", 5, "var area: int"), ("sides", 5, "def sides: int"),
			("scale", 2, "def scale(factor: int) -> int")]) {
		var item = itemOf(result, expected.0);
		t.assert(item != JsonValue.Null, expected.0);
		t.asserti(expected.1, intAt(item, "kind"));
		t.assert_string(expected.2, stringAt(item, "detail"));
		var edit = member(item, "textEdit"), range = member(edit, "range");
		t.assert_string(expected.0, stringAt(edit, "newText"));
		t.asserti(5, intAt(member(range, "start"), "line"));
		t.asserti(4, intAt(member(range, "start"), "character"));
		t.asserti(5, intAt(member(range, "end"), "line"));
		t.asserti(6, intAt(member(range, "end"), "character"));
	}
	t.asserti(4, array(member(result, "items")).length);
	// A builtin member has its detail from the list.
	result = s.result(t, complete0(t, s, inScale("\t\tvar x = int.$max;")));
	t.assert_string("def max: int", stringAt(itemOf(result, "max"), "detail"));
	t.asserti(5, intAt(itemOf(result, "max"), "kind"));
	// An enum case is an EnumMember, which the session's
	// completionItemKind declares.
	result = s.result(t, complete0(t, s, inScale("\t\tvar c = Color.$RED;")));
	t.asserti(20, intAt(itemOf(result, "RED"), "kind"));
	s.server.close();
}
// For a client with insertReplaceSupport, a member item in the middle of the
// word replaces the whole member name, after the ".", while its insertion
// range is only the prefix. At the member's end the two coincide.
def test_members_insert_replace(t: Tester) {
	var s = sessionWithInsertReplace(t);
	var id = request(t, s, inScale("\t\tvar q = Square.new();\n\t\tq.gr$ow();"));
	s.settle();
	var result = s.result(t, id);
	t.assert(member(result, "isIncomplete") == JsonValue.Bool(false), "a complete list");
	checkRanges(t, itemOf(result, "grow"), 5, 4, 6, 4, 8);
	id = request(t, s, inScale("\t\tvar q = Square.new();\n\t\tq.grow$();"));
	s.settle();
	checkRanges(t, itemOf(s.result(t, id), "grow"), 5, 4, 8, 4, 8);
	s.server.close();
	var plain = session(t);
	id = request(t, plain, inScale("\t\tvar q = Square.new();\n\t\tq.gr$ow();"));
	plain.settle();
	var edit = member(itemOf(plain.result(t, id), "grow"), "textEdit");
	t.assert(!has(edit, "insert") && !has(edit, "replace"), "a plain TextEdit without support");
	var range = member(edit, "range");
	t.asserti(5, intAt(member(range, "start"), "line"));
	t.asserti(4, intAt(member(range, "start"), "character"));
	t.asserti(5, intAt(member(range, "end"), "line"));
	t.asserti(6, intAt(member(range, "end"), "character"));
	plain.server.close();
}
// A text that does not parse is repaired after the ".", as a scope query's
// is: at the end of a statement, in a call's arguments, in an if's
// condition, in a lambda, and after a partial name.
def test_members_repairs(t: Tester) {
	var s = session(t);
	var q = "\t\tvar q = Square.new();\n";
	var analyses = s.server.completion.analyses;
	for (line in ["\t\tq.$", "\t\tscale(q.$", "\t\tif (q.$", "\t\tvar f = fun () => q.$", "\t\tq.gr$",
			"\t\tscale(q.$, 1);", "\t\tvar f = fun () { q.$ };"]) {
		t.assert_string(Strings.format1("%s | 0", SQUARE), complete(t, s, inScale(Arrays.concat(q, line))));
	}
	t.asserti(analyses + 7, s.server.completion.analyses);
	// A repair that does not parse gets nothing, without an analysis.
	var id = request(t, s, Strings.format1("%sdef broken( {\n", inScale(Arrays.concat(q, "\t\tq.$"))));
	t.assert_string("| 0", render(t, s.result(t, id)));
	t.asserti(analyses + 7, s.server.completion.analyses);
	s.server.close();
}
// A "." in a comment, a string, or after a number, as when "1.5" is typed,
// is answered at once with nothing, and starts no analysis.
def test_members_no_analysis(t: Tester) {
	var s = session(t);
	var analyses = s.server.completion.analyses;
	for (line in ["\t\t// total.$", "\t\t/* total.$ */", "\t\tvar x = \"total.$\";", "\t\tvar x = 1.$", "\t\tvar x = 1.$5;",
			"\t\tvar x = 0x1F.$"]) {
		var id = request(t, s, inScale(line));
		t.assert(s.reply(id) != null, "answered at once");
		t.assert_string("| 0", render(t, s.result(t, id)));
	}
	t.asserti(analyses, s.server.completion.analyses);
	s.server.close();
}
// An int's value has no members, and an unknown name none either: nothing is
// offered in their place.
def test_members_receivers(t: Tester) {
	var s = session(t);
	t.assert_string("| 0", complete(t, s, inScale("\t\ttotal.$")));
	t.assert_string("| 0", complete(t, s, inScale("\t\tmissing.$")));
	t.assert_string("length | 0", complete(t, s, inScale("\t\tvar x = \"total\".$")));
	t.assert_string("area sides scale | 0", complete(t, s, inScale("\t\tthis.$")));
	// A tuple element's "." follows a number, but not in parentheses.
	var pair = "\t\tvar p = ((total, 1), 2);\n";
	t.assert_string("0 1 last | 0", complete(t, s, inScale(Arrays.concat(pair, "\t\tvar x = (p.0).$"))));
	var analyses = s.server.completion.analyses;
	t.assert_string("| 0", render(t, s.result(t, request(t, s, inScale(Arrays.concat(pair, "\t\tvar x = p.0.$"))))));
	t.asserti(analyses, s.server.completion.analyses);
	s.server.close();
}
// In the arguments of a call whose callee does not resolve, which
// verification skips, a layout's name gets nothing, repaired or as typed:
// a local there could shadow it. The same in a call that resolves gets the
// layout's members, or none where a local shadows it.
def test_members_unvisited_arguments(t: Tester) {
	var s = session(t);
	var pixel = "layout Pixel {\n\t+0 v: u32;\n\t=4;\n}\n";
	var local = "\t\tvar Pixel = 1;\n";
	for (c in [
		("missing(Pixel.$", "| 0"),
		("missing(Pixel.$size);", "| 0"),
		("missing(Pixel.v.$offset);", "| 0"),
		("scale(Pixel.$", "size v | 0"),
		("scale(Pixel.$size);", "size v | 0"),
		("scale(Pixel.v.$offset);", "offset | 0")
	]) {
		t.assert_string(c.1, complete(t, s, Arrays.concat(inScale(Arrays.concat("\t\t", c.0)), pixel)));
		t.assert_string("| 0", complete(t, s, Arrays.concat(inScale(Strings.format2("%s\t\t%s", local, c.0)), pixel)));
	}
	s.server.close();
}
// A malformed member answer is rejected, and the completion gets nothing,
// marked incomplete: the worker failed.
def test_members_malformed(t: Tester) {
	var s = sessionOn(HostOs.executablePath(), t);
	var id = request(t, s, inScale(Strings.format1("\t\t// %s\n\t\tthis.$", SyntheticAnalysisWorker.SCOPE_MALFORMED)));
	s.settle();
	t.assert_string("| 0 +", render(t, s.result(t, id)));
	t.assert_string("area sides scale | 0", complete(t, s, inScale("\t\tthis.$")));
	s.server.close();
}
