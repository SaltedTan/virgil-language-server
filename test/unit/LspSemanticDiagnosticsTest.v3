// Automatic analysis with the real worker. Each test settles by polling until
// no analysis runs or waits, so results never depend on timing. The golden
// transcripts in test/diagnostics/ cover publication through stdio.
def T = UnitTests.register;
def X = [
	T("LspSemanticDiagnostics:failure_keeps_diagnostics", test_failure_keeps_diagnostics),
	T("LspSemanticDiagnostics:error_limit_notice", test_error_limit_notice),
	T("LspSemanticDiagnostics:development_request_rejected_when_busy", test_development_request_rejected_when_busy),
	T("LspSemanticDiagnostics:closed_shared_owner", test_closed_shared_owner),
	T("LspSemanticDiagnostics:debounce_timeout", test_debounce_timeout),
	T("LspSemanticDiagnostics:shutdown_stops_scheduling", test_shutdown_stops_scheduling),
	()
];
class SemanticTestSession {
	def supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	def server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
	def base = ProjectTestFiles.repository("test/fixtures/projects/two-file");
	def main = System.fileLoad(ProjectFiles.join(base, "main.v3"));
	def shapes = System.fileLoad(ProjectFiles.join(base, "shapes.v3"));
	def messages = Vector<HashMap<string, JsonValue>>.new();
	def warnings = Vector<string>.new();
	new() {
		HostOs.ignoreSigpipe();
		server.sendNotification = receive;
		server.warnProject = warn;
		var params = Strings.newMap<JsonValue>();
		params["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
		server.handle(JsonRpcMessage.Request(JsonRpcId.Int(0), "initialize", JsonRpcParams.ByName(params)).encode());
	}
	def receive(bytes: Array<byte>) {
		messages.put(JsonValue.JObject.!(JsonRpcJsonParser.new(bytes).parseDocument()).v);
	}
	def warn(msg: string) { warnings.put(msg); }
	def uri(name: string) -> string { return ProjectFiles.uri(ProjectFiles.join(base, name)); }
	def open(name: string, version: int, text: string) {
		var doc = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		doc["languageId"] = JsonValue.String("virgil");
		doc["version"] = JsonValue.Int(version);
		doc["text"] = JsonValue.String(text);
		notify("textDocument/didOpen", doc, null);
	}
	def change(name: string, version: int, text: string) {
		var doc = Strings.newMap<JsonValue>(), change = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		doc["version"] = JsonValue.Int(version);
		change["text"] = JsonValue.String(text);
		notify("textDocument/didChange", doc, [JsonValue.JObject(change)]);
	}
	private def notify(method: string, doc: HashMap<string, JsonValue>, changes: Array<JsonValue>) {
		var params = Strings.newMap<JsonValue>();
		params["textDocument"] = JsonValue.JObject(doc);
		if (changes != null) params["contentChanges"] = JsonValue.JArray(changes);
		server.handle(JsonRpcMessage.Notification(method, JsonRpcParams.ByName(params)).encode());
	}
	// Polls until no analysis runs or waits, including the debounce interval.
	def settle() {
		var fds = Array<int>.new(4);
		while (server.analyzing()) {
			var count = supervisor.pollFds(fds, 0);
			HostOs.poll(fds, count, server.pollTimeout());
			server.pollAnalysis();
		}
	}
	// Removes and returns the messages received so far.
	def take() -> Array<HashMap<string, JsonValue>> {
		return messages.extract();
	}
}
def method(m: HashMap<string, JsonValue>) -> string {
	return if(JsonValue.String.?(m["method"]), JsonValue.String.!(m["method"]).v);
}
def params(m: HashMap<string, JsonValue>) -> HashMap<string, JsonValue> {
	return JsonValue.JObject.!(m["params"]).v;
}
// The diagnostics of the last publication for {uri} in {messages}, or null.
def published(messages: Array<HashMap<string, JsonValue>>, uri: string) -> Array<JsonValue> {
	var result: Array<JsonValue>;
	for (m in messages) {
		if (!Strings.equal("textDocument/publishDiagnostics", method(m))) continue;
		var p = params(m);
		if (Strings.equal(uri, JsonValue.String.!(p["uri"]).v)) result = JsonValue.JArray.!(p["diagnostics"]).v;
	}
	return result;
}
def count(messages: Array<HashMap<string, JsonValue>>, name: string) -> int {
	var n = 0;
	for (m in messages) { if(Strings.equal(name, method(m))) n++; }
	return n;
}
def field(d: JsonValue, key: string) -> JsonValue {
	return JsonValue.JObject.!(d).v[key];
}
def renamed(s: SemanticTestSession) -> string {
	return replace(s.shapes, "def square(", "def squared(");
}
def replace(text: string, from: string, to: string) -> string {
	for (i = 0; i + from.length <= text.length; i++) {
		if (Strings.equal(Arrays.range(text, i, i + from.length), from)) {
			return Strings.format3("%s%s%s", Arrays.range(text, 0, i), to, Arrays.range(text, i + from.length, text.length));
		}
	}
	return text;
}
def test_failure_keeps_diagnostics(t: Tester) {
	var s = SemanticTestSession.new(), mainUri = s.uri("main.v3");
	s.open("shapes.v3", 1, renamed(s));
	s.settle();
	var errors = published(s.take(), mainUri);
	t.assert(errors != null && errors.length > 0, "closed main.v3 reports the renamed member");
	// The pinned verifier traps on this literal (docs/aeneas-crash-paths.md).
	var crash = Strings.format1("%s\ndef x: i32 = 0i;\n", renamed(s));
	s.change("shapes.v3", 2, crash);
	s.settle();
	var messages = s.take();
	t.assert(published(messages, mainUri) == null, "a crash keeps main.v3's published list");
	t.asserti(1, count(messages, "window/showMessage"));
	var told = false;
	for (w in s.warnings.extract()) told = told || Strings.startsWith(w, "automatic analysis of project shapes failed: the analysis worker crashed");
	t.assert(told, "the failure is logged");
	s.change("shapes.v3", 3, Strings.format1("%s\n", crash));
	s.settle();
	t.asserti(0, count(s.take(), "window/showMessage"));
	// A completed analysis ends the failure; the next one is reported again.
	s.change("shapes.v3", 4, renamed(s));
	s.settle();
	messages = s.take();
	t.assert(published(messages, mainUri) == null, "unchanged list is not republished");
	t.asserti(0, count(messages, "window/showMessage"));
	s.change("shapes.v3", 5, crash);
	s.settle();
	t.asserti(1, count(s.take(), "window/showMessage"));
	s.server.close();
}
def test_error_limit_notice(t: Tester) {
	var s = SemanticTestSession.new(), text = StringBuilder.new().puts("component Main {\n\tdef main() -> int {\n");
	for (i < AeneasAdapter.PROGRAM_MAX_ERRORS + 5) text.put1("\t\tvar x%d: int = missing;\n", i);
	text.puts("\t\treturn 0;\n\t}\n}\n");
	s.open("main.v3", 1, text.toString());
	s.settle();
	var list = published(s.take(), s.uri("main.v3"));
	t.assert(list != null && list.length > AeneasAdapter.PROGRAM_MAX_ERRORS, "errors and a notice");
	if (list == null || list.length < 2) return s.server.close();
	var notice = list[list.length - 1], last = list[list.length - 2];
	t.assert_string("ErrorLimit", JsonValue.String.!(field(notice, "code")).v);
	t.assert_string("virgil-lsp", JsonValue.String.!(field(notice, "source")).v);
	t.asserti(3, JsonValue.Int.!(field(notice, "severity")).v);
	var a = JsonRpcJson.render(StringBuilder.new(), field(notice, "range")).toString();
	var b = JsonRpcJson.render(StringBuilder.new(), field(last, "range")).toString();
	t.assert_string(b, a);
	s.server.close();
}
def test_development_request_rejected_when_busy(t: Tester) {
	var s = SemanticTestSession.new();
	s.open("main.v3", 1, replace(s.main, "var total = r.area();", "var total: int = r;"));
	t.assert(s.supervisor.busy(), "opening starts an analysis at once");
	var params = Strings.newMap<JsonValue>();
	params["uri"] = JsonValue.String(s.uri("main.v3"));
	s.server.handle(JsonRpcMessage.Request(JsonRpcId.Int(1), "virgil-lsp/analyze", JsonRpcParams.ByName(params)).encode());
	var rejected = false;
	for (m in s.take()) {
		if (!m.has("id")) continue;
		t.assert(m.has("error"), "a busy development request fails immediately");
		if (m.has("error")) {
			var error = JsonValue.JObject.!(m["error"]).v;
			t.asserti(JsonRpcErrorCode.INTERNAL_ERROR, JsonValue.Int.!(error["code"]).v);
			rejected = true;
		}
	}
	t.assert(rejected, "the request was rejected before polling");
	s.settle();
	var messages = s.take(), list = published(messages, s.uri("main.v3"));
	t.assert(list != null && list.length > 0, "automatic diagnostics still publish");
	for (m in messages) t.assert(!m.has("id"), "no deferred development reply");
	t.asserti(1, s.supervisor.snapshot.generation);
	s.server.close();
}
def test_debounce_timeout(t: Tester) {
	var s = SemanticTestSession.new();
	s.open("main.v3", 1, s.main);
	s.settle();
	s.change("main.v3", 2, Strings.format1("%s\n", s.main));
	t.assertz(false, s.supervisor.busy());
	t.assertz(true, s.server.analyzing());
	var timeout = s.server.pollTimeout();
	t.assert(timeout > 0 && timeout <= 200, "waits for the debounce interval");
	s.settle();
	t.assertz(false, s.server.analyzing());
	s.server.close();
}
def test_shutdown_stops_scheduling(t: Tester) {
	var s = SemanticTestSession.new();
	s.open("main.v3", 1, s.main);
	s.change("main.v3", 2, Strings.format1("%s\n", s.main));
	t.assertz(true, s.server.analyzing());
	s.server.handle(JsonRpcMessage.Request(JsonRpcId.Int(1), "shutdown", JsonRpcParams.Absent).encode());
	t.assertz(false, s.server.analyzing());
	t.asserti(-1, s.server.pollTimeout());
	s.take();
	s.server.pollAnalysis();
	t.asserti(0, s.take().length);
	s.server.close();
}
def test_closed_shared_owner(t: Tester) {
	var supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	var server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
	var base = ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), "project-fixtures/closed-shared");
	var sharedUri = ProjectFiles.uri(ProjectFiles.join(base, "shared/Greeting.v3"));
	var clientPath = ProjectFiles.join(base, "client/Program.v3"), clientUri = ProjectFiles.uri(clientPath);
	var messages = Vector<HashMap<string, JsonValue>>.new();
	server.sendNotification = fun (bytes: Array<byte>) -> void {
		messages.put(JsonValue.JObject.!(JsonRpcJsonParser.new(bytes).parseDocument()).v);
	};
	HostOs.ignoreSigpipe();
	var initialize = Strings.newMap<JsonValue>();
	initialize["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
	server.handle(JsonRpcMessage.Request(JsonRpcId.Int(0), "initialize", JsonRpcParams.ByName(initialize)).encode());
	var doc = Strings.newMap<JsonValue>(), open = Strings.newMap<JsonValue>();
	doc["uri"] = JsonValue.String(clientUri);
	doc["languageId"] = JsonValue.String("virgil");
	doc["version"] = JsonValue.Int(1);
	doc["text"] = JsonValue.String(System.fileLoad(clientPath));
	open["textDocument"] = JsonValue.JObject(doc);
	server.handle(JsonRpcMessage.Notification("textDocument/didOpen", JsonRpcParams.ByName(open)).encode());
	var fds = Array<int>.new(4);
	while (server.analyzing()) {
		var count = supervisor.pollFds(fds, 0);
		HostOs.poll(fds, count, server.pollTimeout());
		server.pollAnalysis();
	}
	var received = messages.extract(), errors = published(received, sharedUri);
	t.assert(server.documents.overlay(sharedUri) == null, "shared source remains closed");
	t.assert(errors != null && errors.length > 0, "opening only the client publishes closed shared errors");
	if (errors != null && errors.length > 0) {
		t.assert_string("UnresolvedIdentifier", JsonValue.String.!(field(errors[0], "code")).v);
	}
	var clientErrors = published(received, clientUri);
	t.assert(clientErrors != null && clientErrors.length == 0, "shared errors are grouped separately");
	var owner = server.projects.forDocument(sharedUri).active;
	t.assert_string("server", owner.definition.name);
	t.assert(owner.snapshot != null, "the selected owner was analyzed");
	server.close();
}
