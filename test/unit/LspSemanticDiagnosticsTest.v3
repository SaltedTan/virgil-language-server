// Automatic analysis with the real worker. Each test settles by polling until
// no analysis runs or waits, so results never depend on timing. The golden
// transcripts in test/diagnostics/ cover publication through stdio.
def T = UnitTests.register;
def X = [
	T("LspSemanticDiagnostics:failure_keeps_diagnostics", test_failure_keeps_diagnostics),
	T("LspSemanticDiagnostics:error_limit_notice", test_error_limit_notice),
	T("LspSemanticDiagnostics:development_request_rejected_when_busy", test_development_request_rejected_when_busy),
	T("LspSemanticDiagnostics:closed_shared_owner", test_closed_shared_owner),
	T("LspSemanticDiagnostics:configuration_reassigns_closed_file", test_configuration_reassigns_closed_file),
	T("LspSemanticDiagnostics:configuration_transfers_between_projects", test_configuration_transfers_between_projects),
	T("LspSemanticDiagnostics:configuration_events_schedule_loaded_projects", test_configuration_events_schedule_loaded_projects),
	T("LspSemanticDiagnostics:configuration_edits_drop_obsolete_waiters", test_configuration_edits_drop_obsolete_waiters),
	T("LspSemanticDiagnostics:hidden_configuration_blocks_parent", test_hidden_configuration_blocks_parent),
	T("LspSemanticDiagnostics:debounce_timeout", test_debounce_timeout),
	T("LspSemanticDiagnostics:version_only_update", test_version_only_update),
	T("LspSemanticDiagnostics:stale_version_only_reanalyzes", test_stale_version_only_reanalyzes),
	T("LspSemanticDiagnostics:source_membership_version_only", test_source_membership_version_only),
	T("LspSemanticDiagnostics:source_membership_running", test_source_membership_running),
	T("LspSemanticDiagnostics:ownership_version_only", test_ownership_version_only),
	T("LspSemanticDiagnostics:shutdown_stops_scheduling", test_shutdown_stops_scheduling),
	T("LspSemanticDiagnostics:disk_change_discards_result", test_disk_change_discards_result),
	T("LspSemanticDiagnostics:urgent_context_starts_first", test_urgent_context_starts_first),
	T("LspSemanticDiagnostics:evicted_demand_answers", test_evicted_demand_answers),
	T("LspSemanticDiagnostics:evicted_demand_semantic_tokens", test_evicted_demand_semantic_tokens),
	T("LspSemanticDiagnostics:evicted_demand_coalesces", test_evicted_demand_coalesces),
	T("LspSemanticDiagnostics:eviction_schedules_nothing", test_eviction_schedules_nothing),
	T("LspSemanticDiagnostics:demand_analysis_refreshes_once", test_demand_analysis_refreshes_once),
	T("LspSemanticDiagnostics:unchanged_demand_sends_no_refresh", test_unchanged_demand_sends_no_refresh),
	T("LspSemanticDiagnostics:demand_refreshes_changed_documents", test_demand_refreshes_changed_documents),
	T("LspSemanticDiagnostics:event_joins_waiting_demand", test_event_joins_waiting_demand),
	T("LspSemanticDiagnostics:failed_demand_not_retried", test_failed_demand_not_retried),
	T("LspSemanticDiagnostics:failed_analysis_no_demand", test_failed_analysis_no_demand),
	T("LspSemanticDiagnostics:demand_waiters_cancel_and_shutdown", test_demand_waiters_cancel_and_shutdown),
	T("LspSemanticDiagnostics:visible_projects_stop", test_visible_projects_stop),
	T("LspSemanticDiagnostics:waiter_pressure_refreshes_once", test_waiter_pressure_refreshes_once),
	()
];
class SemanticTestSession {
	def supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	def server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
	def base = ProjectTestFiles.repository("test/fixtures/projects/two-file");
	def main = System.fileLoad(ProjectFiles.join(base, "main.v3"));
	def shapes = System.fileLoad(ProjectFiles.join(base, "shapes.v3"));
	def messages = Vector<HashMap<string, JsonValue>>.new();
	def warnings = Vector<string>.new();
	new() {
		HostOs.ignoreSigpipe();
		server.sendNotification = receive;
		server.warnProject = warn;
		var params = Strings.newMap<JsonValue>();
		params["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
		server.handle(JsonRpcMessage.Request(JsonRpcId.Int(0), "initialize", JsonRpcParams.ByName(params)).encode());
	}
	def receive(bytes: Array<byte>) {
		messages.put(JsonValue.JObject.!(JsonRpcJsonParser.new(bytes).parseDocument()).v);
	}
	def warn(msg: string) { warnings.put(msg); }
	def uri(name: string) -> string { return ProjectFiles.uri(ProjectFiles.join(base, name)); }
	def open(name: string, version: int, text: string) {
		var doc = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		doc["languageId"] = JsonValue.String("virgil");
		doc["version"] = JsonValue.Int(version);
		doc["text"] = JsonValue.String(text);
		notify("textDocument/didOpen", doc, null);
	}
	def change(name: string, version: int, text: string) {
		var doc = Strings.newMap<JsonValue>(), change = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		doc["version"] = JsonValue.Int(version);
		change["text"] = JsonValue.String(text);
		notify("textDocument/didChange", doc, [JsonValue.JObject(change)]);
	}
	def versionOnly(name: string, version: int) {
		var doc = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		doc["version"] = JsonValue.Int(version);
		notify("textDocument/didChange", doc, []);
	}
	// Reports files changed on disk, as the client's watcher does.
	def watched(changes: Array<JsonValue>) {
		var params = Strings.newMap<JsonValue>();
		params["changes"] = JsonValue.JArray(changes);
		server.handle(JsonRpcMessage.Notification("workspace/didChangeWatchedFiles", JsonRpcParams.ByName(params)).encode());
	}
	private def notify(method: string, doc: HashMap<string, JsonValue>, changes: Array<JsonValue>) {
		var params = Strings.newMap<JsonValue>();
		params["textDocument"] = JsonValue.JObject(doc);
		if (changes != null) params["contentChanges"] = JsonValue.JArray(changes);
		server.handle(JsonRpcMessage.Notification(method, JsonRpcParams.ByName(params)).encode());
	}
	// Polls until no analysis runs or waits, including the debounce interval.
	def settle() {
		var fds = Array<int>.new(4);
		while (server.analyzing()) {
			var count = supervisor.pollFds(fds, 0);
			HostOs.poll(fds, count, server.pollTimeout());
			server.onPoll();
		}
	}
	// Removes and returns the messages received so far.
	def take() -> Array<HashMap<string, JsonValue>> {
		return messages.extract();
	}
}
def method(m: HashMap<string, JsonValue>) -> string {
	return if(JsonValue.String.?(m["method"]), JsonValue.String.!(m["method"]).v);
}
def params(m: HashMap<string, JsonValue>) -> HashMap<string, JsonValue> {
	return JsonValue.JObject.!(m["params"]).v;
}
// The diagnostics of the last publication for {uri} in {messages}, or null.
def published(messages: Array<HashMap<string, JsonValue>>, uri: string) -> Array<JsonValue> {
	var result: Array<JsonValue>;
	for (m in messages) {
		if (!Strings.equal("textDocument/publishDiagnostics", method(m))) continue;
		var p = params(m);
		if (Strings.equal(uri, JsonValue.String.!(p["uri"]).v)) result = JsonValue.JArray.!(p["diagnostics"]).v;
	}
	return result;
}
def count(messages: Array<HashMap<string, JsonValue>>, name: string) -> int {
	var n = 0;
	for (m in messages) { if(Strings.equal(name, method(m))) n++; }
	return n;
}
def field(d: JsonValue, key: string) -> JsonValue {
	return JsonValue.JObject.!(d).v[key];
}
def renamed(s: SemanticTestSession) -> string {
	return replace(s.shapes, "def square(", "def squared(");
}
def replace(text: string, from: string, to: string) -> string {
	for (i = 0; i + from.length <= text.length; i++) {
		if (Strings.equal(Arrays.range(text, i, i + from.length), from)) {
			return Strings.format3("%s%s%s", Arrays.range(text, 0, i), to, Arrays.range(text, i + from.length, text.length));
		}
	}
	return text;
}
def test_failure_keeps_diagnostics(t: Tester) {
	var s = SemanticTestSession.new(), mainUri = s.uri("main.v3");
	s.open("shapes.v3", 1, renamed(s));
	s.settle();
	var errors = published(s.take(), mainUri);
	t.assert(errors != null && errors.length > 0, "closed main.v3 reports the renamed member");
	// The pinned verifier traps on this literal (docs/aeneas-crash-paths.md).
	var crash = Strings.format1("%s\ndef x: i32 = 0i;\n", renamed(s));
	s.change("shapes.v3", 2, crash);
	s.settle();
	var messages = s.take();
	t.assert(published(messages, mainUri) == null, "a crash keeps main.v3's published list");
	t.asserti(1, count(messages, "window/showMessage"));
	var told = false;
	for (w in s.warnings.extract()) told = told || Strings.startsWith(w, "automatic analysis of project shapes failed: the analysis worker crashed");
	t.assert(told, "the failure is logged");
	s.change("shapes.v3", 3, Strings.format1("%s\n", crash));
	s.settle();
	t.asserti(0, count(s.take(), "window/showMessage"));
	// A completed analysis ends the failure; the next one is reported again.
	s.change("shapes.v3", 4, renamed(s));
	s.settle();
	messages = s.take();
	t.assert(published(messages, mainUri) == null, "unchanged list is not republished");
	t.asserti(0, count(messages, "window/showMessage"));
	s.change("shapes.v3", 5, crash);
	s.settle();
	t.asserti(1, count(s.take(), "window/showMessage"));
	s.server.close();
}
def test_error_limit_notice(t: Tester) {
	var s = SemanticTestSession.new(), text = StringBuilder.new().puts("component Main {\n\tdef main() -> int {\n");
	for (i < AeneasAdapter.PROGRAM_MAX_ERRORS + 5) text.put1("\t\tvar x%d: int = missing;\n", i);
	text.puts("\t\treturn 0;\n\t}\n}\n");
	s.open("main.v3", 1, text.toString());
	s.settle();
	var list = published(s.take(), s.uri("main.v3"));
	t.assert(list != null && list.length > AeneasAdapter.PROGRAM_MAX_ERRORS, "errors and a notice");
	if (list == null || list.length < 2) return s.server.close();
	var notice = list[list.length - 1], last = list[list.length - 2];
	t.assert_string("ErrorLimit", JsonValue.String.!(field(notice, "code")).v);
	t.assert_string("virgil-lsp", JsonValue.String.!(field(notice, "source")).v);
	t.asserti(3, JsonValue.Int.!(field(notice, "severity")).v);
	var a = JsonRpcJson.render(StringBuilder.new(), field(notice, "range")).toString();
	var b = JsonRpcJson.render(StringBuilder.new(), field(last, "range")).toString();
	t.assert_string(b, a);
	s.server.close();
}
def test_development_request_rejected_when_busy(t: Tester) {
	var s = SemanticTestSession.new();
	s.open("main.v3", 1, replace(s.main, "var total = r.area();", "var total: int = r;"));
	t.assert(s.supervisor.busy(), "opening starts an analysis at once");
	var params = Strings.newMap<JsonValue>();
	params["uri"] = JsonValue.String(s.uri("main.v3"));
	s.server.handle(JsonRpcMessage.Request(JsonRpcId.Int(1), "virgil-lsp/analyze", JsonRpcParams.ByName(params)).encode());
	var rejected = false;
	for (m in s.take()) {
		if (!m.has("id")) continue;
		t.assert(m.has("error"), "a busy development request fails immediately");
		if (m.has("error")) {
			var error = JsonValue.JObject.!(m["error"]).v;
			t.asserti(JsonRpcErrorCode.INTERNAL_ERROR, JsonValue.Int.!(error["code"]).v);
			rejected = true;
		}
	}
	t.assert(rejected, "the request was rejected before polling");
	s.settle();
	var messages = s.take(), list = published(messages, s.uri("main.v3"));
	t.assert(list != null && list.length > 0, "automatic diagnostics still publish");
	for (m in messages) t.assert(!m.has("id"), "no deferred development reply");
	t.asserti(1, s.supervisor.snapshot.generation);
	s.server.close();
}
// The parameters of the last publication of {uri} in {messages}, or null.
def lastPublication(messages: Array<HashMap<string, JsonValue>>, uri: string) -> HashMap<string, JsonValue> {
	var result: HashMap<string, JsonValue>;
	for (m in messages) {
		if (!Strings.equal("textDocument/publishDiagnostics", method(m))) continue;
		var p = params(m);
		if (Strings.equal(uri, JsonValue.String.!(p["uri"]).v)) result = p;
	}
	return result;
}
// The JSON of {v}, for comparing published lists.
def rendered(v: JsonValue) -> string {
	return JsonRpcJson.render(StringBuilder.new(), v).toString();
}
def test_debounce_timeout(t: Tester) {
	var s = SemanticTestSession.new();
	s.open("main.v3", 1, s.main);
	s.settle();
	s.change("main.v3", 2, Strings.format1("%s\n", s.main));
	t.assertz(false, s.supervisor.busy());
	t.assertz(true, s.server.analyzing());
	var timeout = s.server.pollTimeout();
	t.assert(timeout > 0 && timeout <= 200, "waits for the debounce interval");
	s.settle();
	t.assertz(false, s.server.analyzing());
	s.server.close();
}
def test_disk_change_discards_result(t: Tester) {
	var s = SemanticTestSession.new(), infos = InfoRecorder.new();
	s.server.infoAnalysis = infos.info;
	s.open("shapes.v3", 1, renamed(s));
	t.assertz(true, s.supervisor.busy());
	// Closed main.v3, which the running analysis read, is reported changed on disk.
	var change = Strings.newMap<JsonValue>(), params = Strings.newMap<JsonValue>();
	change["uri"] = JsonValue.String(s.uri("main.v3"));
	change["type"] = JsonValue.Int(2);
	params["changes"] = JsonValue.JArray([JsonValue.JObject(change)]);
	s.server.handle(JsonRpcMessage.Notification("workspace/didChangeWatchedFiles", JsonRpcParams.ByName(params)).encode());
	t.assertz(true, s.server.analyzing());
	s.settle();
	var discarded = 0;
	for (i < infos.messages.length) {
		var m = infos.messages[i];
		if (Strings.startsWith(m, "discarded analysis ") && Strings.endsWith(m, "main.v3 changed after its sources were captured")) discarded++;
	}
	t.asserti(1, discarded);
	// The analysis the report scheduled publishes main.v3's errors.
	var errors = published(s.take(), s.uri("main.v3"));
	t.assert(errors != null && errors.length > 0, "the rescheduled analysis publishes");
	s.server.close();
}
class InfoRecorder {
	def messages = Vector<string>.new();
	def info(msg: string) { messages.put(msg); }
}
def test_version_only_update(t: Tester) {
	var s = SemanticTestSession.new(), uri = s.uri("main.v3");
	s.open("main.v3", 1, replace(s.main, "var total = r.area();", "var total: int = r;"));
	s.settle();
	var messages = s.take(), first = lastPublication(messages, uri);
	t.assert(first != null, "the open document's diagnostics were published");
	if (first == null) return s.server.close();
	t.asserti(1, JsonValue.Int.!(first["version"]).v);
	var list = JsonValue.JArray.!(first["diagnostics"]).v;
	t.assert(list.length > 0, "the type error is published");
	t.assert_string("aeneas", JsonValue.String.!(field(list[0], "source")).v);
	var generation = s.supervisor.snapshot.generation;
	// A version-only change keeps the text, its analysis, and the list's
	// provenance; it republishes that list at the new version without analyzing.
	s.versionOnly("main.v3", 2);
	t.assertz(false, s.server.analyzing());
	messages = s.take();
	var second = lastPublication(messages, uri);
	t.assert(second != null, "the diagnostics were republished");
	if (second == null) return s.server.close();
	t.asserti(2, JsonValue.Int.!(second["version"]).v);
	var same = JsonValue.JArray.!(second["diagnostics"]).v;
	t.assert_string(rendered(JsonValue.JArray(list)), rendered(JsonValue.JArray(same)));
	t.assert_string("aeneas", JsonValue.String.!(field(same[0], "source")).v);
	t.asserti(generation, s.supervisor.snapshot.generation);
	t.asserti(0, count(messages, "window/showMessage"));
	s.server.close();
}
// A version-only change that drops stale semantic diagnostics must schedule
// their replacement. The regression: 8,193 unrelated file reports overflow
// DocumentStore's disk stamps, so the analysis that published main.v3's type
// error no longer describes the closed shapes.v3; empty changes then clear the
// still-valid error, and no watched-file event affects the project. The error
// must return without another edit or save.
def test_stale_version_only_reanalyzes(t: Tester) {
	var s = SemanticTestSession.new(), uri = s.uri("main.v3"), dependency = s.uri("shapes.v3");
	s.open("main.v3", 1, replace(s.main, "var total = r.area();", "var total: int = r;"));
	s.settle();
	var messages = s.take(), first = lastPublication(messages, uri);
	t.assert(first != null, "the open document's type error was published");
	if (first == null) return s.server.close();
	t.asserti(1, JsonValue.Int.!(first["version"]).v);
	t.assert(JsonValue.JArray.!(first["diagnostics"]).v.length > 0, "the type error is published");
	var generation = s.supervisor.snapshot.generation, stamp = s.server.documents.diskStamp(dependency);
	// The last report fills every slot and then replaces every stamp,
	// including the analysis's stamp for shapes.v3, without naming a file
	// either project contains.
	var changes = Array<JsonValue>.new(DocumentLimits.MAX_DISK_STAMPS + 1);
	for (i < changes.length) {
		var change = Strings.newMap<JsonValue>();
		change["uri"] = JsonValue.String(ProjectFiles.uri(ProjectFiles.join(s.base, Strings.format1("noise/%d.v3", i))));
		change["type"] = JsonValue.Int(2);
		changes[i] = JsonValue.JObject(change);
	}
	s.watched(changes);
	t.assert(s.server.documents.diskStamp(dependency) != stamp, "the overflow replaced the dependency's stamp");
	s.settle();
	t.asserti(generation, s.supervisor.snapshot.generation);
	s.take();
	// Each empty change republishes only parser diagnostics, since the
	// analysis can no longer vouch for the semantic list. None is an edit or
	// a save.
	for (version = 2; version <= 5; version++) s.versionOnly("main.v3", version);
	var cleared = lastPublication(s.take(), uri);
	t.assert(cleared != null, "the empty changes published");
	if (cleared == null) return s.server.close();
	t.asserti(5, JsonValue.Int.!(cleared["version"]).v);
	t.asserti(0, JsonValue.JArray.!(cleared["diagnostics"]).v.length);
	// The drop must schedule a replacement analysis whose result returns the
	// still-valid error without another edit or save.
	s.settle();
	messages = s.take();
	var restored = lastPublication(messages, uri);
	t.assert(restored != null, "the replacement analysis published");
	if (restored == null) return s.server.close();
	t.asserti(5, JsonValue.Int.!(restored["version"]).v);
	var list = JsonValue.JArray.!(restored["diagnostics"]).v;
	t.assert(list.length > 0, "the still-valid type error is back");
	if (list.length > 0) t.assert_string("aeneas", JsonValue.String.!(field(list[0], "source")).v);
	t.asserti(generation + 1, s.supervisor.snapshot.generation);
	s.server.close();
}
def test_shutdown_stops_scheduling(t: Tester) {
	var s = SemanticTestSession.new();
	s.open("main.v3", 1, s.main);
	s.change("main.v3", 2, Strings.format1("%s\n", s.main));
	t.assertz(true, s.server.analyzing());
	s.server.handle(JsonRpcMessage.Request(JsonRpcId.Int(1), "shutdown", JsonRpcParams.Absent).encode());
	t.assertz(false, s.server.analyzing());
	t.asserti(-1, s.server.pollTimeout());
	s.take();
	s.server.onPoll();
	t.asserti(0, s.take().length);
	s.server.close();
}
def test_source_membership_version_only(t: Tester) {
	sourceMembership(t, false);
}
def test_source_membership_running(t: Tester) {
	sourceMembership(t, true);
}
def sourceMembership(t: Tester, running: bool) {
	var fixture = if(running, "semantic-membership-running", "semantic-membership");
	var base = ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), ProjectFiles.join("project-fixtures", fixture));
	var pid = HostOs.spawn(["/bin/rm\x00", "-f\x00", Arrays.concat(ProjectFiles.join(base, "shapes.v3"), "\x00")], [0, 1, 2]);
	t.assert(pid > 0, "fixture reset started");
	if (pid <= 0) return;
	var status = Array<int>.new(1);
	t.asserti(pid, HostOs.wait(pid, status));
	t.asserti(0, status[0]);
	var s = OwnershipTestSession.new(fixture);
	var uri = s.uri("main.v3"), infos = InfoRecorder.new();
	s.server.infoAnalysis = infos.info;
	s.open("main.v3", 1, System.fileLoad(ProjectFiles.join(s.base, "main.v3")));
	if (running) t.assert(s.supervisor.busy(), "the old source set is being analyzed without polling");
	else {
		s.settle();
		var first = published(s.messages.extract(), uri);
		t.assert(first != null && first.length > 0, "the missing Shapes component is reported");
		if (first != null && first.length > 0) t.assert_string("UnresolvedIdentifier", JsonValue.String.!(field(first[0], "code")).v);
	}
	var ctx = s.server.projects.forDocument(uri).active, revision = ctx.config;
	var generation = if(running, 0, s.supervisor.snapshot.generation);
	t.asserti(1, ctx.sources.length);
	var text = "component Shapes { def answer() -> int { return 3; } }\n";
	var fd = System.fileOpen(ProjectFiles.join(s.base, "shapes.v3"), false);
	t.assert(fd >= 0, "the new source is created");
	if (fd < 0) return s.server.close();
	System.fileWriteK(fd, text, 0, text.length);
	System.fileClose(fd);
	var event = Strings.newMap<JsonValue>(), watched = Strings.newMap<JsonValue>();
	event["uri"] = JsonValue.String(s.uri("shapes.v3"));
	event["type"] = JsonValue.Int(1);
	watched["changes"] = JsonValue.JArray([JsonValue.JObject(event)]);
	s.server.handle(JsonRpcMessage.Notification("workspace/didChangeWatchedFiles", JsonRpcParams.ByName(watched)).encode());
	t.assert(ctx.config == revision && revision.current, "source membership changes without replacing the configuration");
	t.asserti(2, ctx.sources.length);
	t.assert(s.server.analyzing(), "the CREATED event schedules a replacement before the empty change");
	var doc = Strings.newMap<JsonValue>(), change = Strings.newMap<JsonValue>();
	doc["uri"] = JsonValue.String(uri);
	doc["version"] = JsonValue.Int(2);
	change["textDocument"] = JsonValue.JObject(doc);
	change["contentChanges"] = JsonValue.JArray([]);
	s.server.handle(JsonRpcMessage.Notification("textDocument/didChange", JsonRpcParams.ByName(change)).encode());
	var cleared = lastPublication(s.messages.extract(), uri);
	t.assert(cleared != null, "the empty change publishes at the new version");
	if (cleared != null) {
		t.asserti(2, JsonValue.Int.!(cleared["version"]).v);
		t.asserti(0, JsonValue.JArray.!(cleared["diagnostics"]).v.length);
	}
	s.settle();
	for (m in s.messages.extract()) {
		var p = lastPublication([m], uri);
		if (p == null) continue;
		t.asserti(2, JsonValue.Int.!(p["version"]).v);
		t.asserti(0, JsonValue.JArray.!(p["diagnostics"]).v.length);
	}
	t.asserti(generation + if(running, 2, 1), ctx.snapshot.generation);
	t.asserti(2, ctx.snapshot.documentVersions.length);
	t.assert(ctx.snapshot.verified && ctx.snapshot.diagnostics.length == 0, "the replacement completes with correct empty diagnostics");
	var discarded = 0;
	for (i < infos.messages.length) if (Strings.startsWith(infos.messages[i], "discarded analysis ")) discarded++;
	t.asserti(if(running, 1, 0), discarded);
	s.server.close();
}
def test_ownership_version_only(t: Tester) {
	var base = ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), "project-fixtures/ownership-version");
	var config = ProjectFiles.join(base, "sub/.virgil-lsp.json");
	var pid = HostOs.spawn(["/bin/rm\x00", "-f\x00", Arrays.concat(config, "\x00")], [0, 1, 2]);
	t.assert(pid > 0, "fixture reset started");
	if (pid <= 0) return;
	var status = Array<int>.new(1);
	t.asserti(pid, HostOs.wait(pid, status));
	t.asserti(0, status[0]);
	var s = OwnershipTestSession.new("ownership-version"), uri = s.uri("sub/main.v3");
	s.open("sub/main.v3", 1, System.fileLoad(ProjectFiles.join(base, "sub/main.v3")));
	s.settle();
	var first = published(s.messages.extract(), uri);
	t.assert(first != null && first.length > 0, "the excluded Shapes component is unresolved");
	if (first != null && first.length > 0) t.assert_string("UnresolvedIdentifier", JsonValue.String.!(field(first[0], "code")).v);
	var parent = s.server.projects.forDocument(uri).active, snapshot = parent.snapshot;
	t.assert_string("parent", parent.definition.name);
	var text = "{\"version\":1,\"projects\":[{\"name\":\"child\",\"sources\":[\"main.v3\",\"shapes.v3\"]}]}";
	var fd = System.fileOpen(config, false);
	t.assert(fd >= 0, "the child configuration is created");
	if (fd < 0) return s.server.close();
	System.fileWriteK(fd, text, 0, text.length);
	System.fileClose(fd);
	var event = Strings.newMap<JsonValue>(), watched = Strings.newMap<JsonValue>();
	event["uri"] = JsonValue.String(s.uri("sub/.virgil-lsp.json"));
	event["type"] = JsonValue.Int(1);
	watched["changes"] = JsonValue.JArray([JsonValue.JObject(event)]);
	s.server.handle(JsonRpcMessage.Notification("workspace/didChangeWatchedFiles", JsonRpcParams.ByName(watched)).encode());
	var child = s.server.projects.forDocument(uri).active;
	t.assert_string("child", child.definition.name);
	t.assert(child != parent && parent.config.current, "ownership changes without retiring the parent");
	t.assert(LspAnalysisCapture.matchesSources(snapshot.documentVersions, parent.sources), "the parent's captured membership still matches");
	for (v in snapshot.documentVersions) t.assert(v.matchesDocument(s.server.documents), "the parent's captured stamps still match");
	t.assert(child.snapshot == null, "the child analysis has not completed");
	var doc = Strings.newMap<JsonValue>(), change = Strings.newMap<JsonValue>();
	doc["uri"] = JsonValue.String(uri);
	doc["version"] = JsonValue.Int(2);
	change["textDocument"] = JsonValue.JObject(doc);
	change["contentChanges"] = JsonValue.JArray([]);
	s.server.handle(JsonRpcMessage.Notification("textDocument/didChange", JsonRpcParams.ByName(change)).encode());
	var cleared = lastPublication(s.messages.extract(), uri);
	t.assert(cleared != null, "the empty change publishes at the new version");
	if (cleared != null) {
		t.asserti(2, JsonValue.Int.!(cleared["version"]).v);
		t.asserti(0, JsonValue.JArray.!(cleared["diagnostics"]).v.length);
	}
	s.settle();
	var replacement = lastPublication(s.messages.extract(), uri);
	t.assert(replacement != null, "the child publishes its correct diagnostics without another edit");
	if (replacement != null) {
		t.asserti(2, JsonValue.Int.!(replacement["version"]).v);
		var diagnostics = JsonValue.JArray.!(replacement["diagnostics"]).v;
		t.asserti(1, diagnostics.length);
		if (diagnostics.length == 1) t.assert_string("TypeError", JsonValue.String.!(field(diagnostics[0], "code")).v);
	}
	t.assert(child.snapshot != null && child.snapshot.documentVersions.length == 2, "the replacement analyzes both child sources");
	s.server.close();
}
def test_closed_shared_owner(t: Tester) {
	var supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	var server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
	var base = ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), "project-fixtures/closed-shared");
	var sharedUri = ProjectFiles.uri(ProjectFiles.join(base, "shared/Greeting.v3"));
	var clientPath = ProjectFiles.join(base, "client/Program.v3"), clientUri = ProjectFiles.uri(clientPath);
	var messages = Vector<HashMap<string, JsonValue>>.new();
	server.sendNotification = fun (bytes: Array<byte>) -> void {
		messages.put(JsonValue.JObject.!(JsonRpcJsonParser.new(bytes).parseDocument()).v);
	};
	HostOs.ignoreSigpipe();
	var initialize = Strings.newMap<JsonValue>();
	initialize["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
	server.handle(JsonRpcMessage.Request(JsonRpcId.Int(0), "initialize", JsonRpcParams.ByName(initialize)).encode());
	var doc = Strings.newMap<JsonValue>(), open = Strings.newMap<JsonValue>();
	doc["uri"] = JsonValue.String(clientUri);
	doc["languageId"] = JsonValue.String("virgil");
	doc["version"] = JsonValue.Int(1);
	doc["text"] = JsonValue.String(System.fileLoad(clientPath));
	open["textDocument"] = JsonValue.JObject(doc);
	server.handle(JsonRpcMessage.Notification("textDocument/didOpen", JsonRpcParams.ByName(open)).encode());
	var fds = Array<int>.new(4);
	while (server.analyzing()) {
		var count = supervisor.pollFds(fds, 0);
		HostOs.poll(fds, count, server.pollTimeout());
		server.onPoll();
	}
	var received = messages.extract(), errors = published(received, sharedUri);
	t.assert(server.documents.overlay(sharedUri) == null, "shared source remains closed");
	t.assert(errors != null && errors.length > 0, "opening only the client publishes closed shared errors");
	if (errors != null && errors.length > 0) {
		t.assert_string("UnresolvedIdentifier", JsonValue.String.!(field(errors[0], "code")).v);
	}
	var clientErrors = published(received, clientUri);
	t.assert(clientErrors != null && clientErrors.length == 0, "shared errors are grouped separately");
	var owner = server.projects.forDocument(sharedUri).active;
	t.assert_string("server", owner.definition.name);
	t.assert(owner.snapshot != null, "the selected owner was analyzed");
	server.close();
}
class OwnershipTestSession(fixture: string) {
	def supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	def server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
	def base = ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), ProjectFiles.join("project-fixtures", fixture));
	def messages = Vector<HashMap<string, JsonValue>>.new();
	new() {
		HostOs.ignoreSigpipe();
		server.sendNotification = receive;
		var initialize = Strings.newMap<JsonValue>();
		initialize["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
		server.handle(JsonRpcMessage.Request(JsonRpcId.Int(0), "initialize", JsonRpcParams.ByName(initialize)).encode());
	}
	def receive(bytes: Array<byte>) {
		messages.put(JsonValue.JObject.!(JsonRpcJsonParser.new(bytes).parseDocument()).v);
	}
	def uri(name: string) -> string { return ProjectFiles.uri(ProjectFiles.join(base, name)); }
	def open(name: string, version: int, text: string) {
		var doc = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		doc["languageId"] = JsonValue.String(if(Strings.endsWith(name, ".json"), "json", "virgil"));
		doc["version"] = JsonValue.Int(version);
		doc["text"] = JsonValue.String(text);
		notify("textDocument/didOpen", doc, null);
	}
	def change(name: string, version: int, text: string) {
		var doc = Strings.newMap<JsonValue>(), change = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		doc["version"] = JsonValue.Int(version);
		change["text"] = JsonValue.String(text);
		notify("textDocument/didChange", doc, [JsonValue.JObject(change)]);
	}
	def closeDocument(name: string) {
		var doc = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		notify("textDocument/didClose", doc, null);
	}
	private def notify(method: string, doc: HashMap<string, JsonValue>, changes: Array<JsonValue>) {
		var params = Strings.newMap<JsonValue>();
		params["textDocument"] = JsonValue.JObject(doc);
		if (changes != null) params["contentChanges"] = JsonValue.JArray(changes);
		server.handle(JsonRpcMessage.Notification(method, JsonRpcParams.ByName(params)).encode());
	}
	def settle() {
		var fds = Array<int>.new(4);
		while (server.analyzing()) {
			var count = supervisor.pollFds(fds, 0);
			HostOs.poll(fds, count, server.pollTimeout());
			server.onPoll();
		}
	}
	def expectOwner(t: Tester, name: string) {
		var received = Array<HashMap<string, JsonValue>>.new(messages.length);
		for (i < received.length) received[i] = messages[i];
		var shared = uri("shared/Greeting.v3"), errors = published(received, shared);
		t.assert(server.documents.overlay(shared) == null, "shared file remains closed");
		t.assert(errors != null && errors.length > 0, "the new owner publishes closed-file errors");
		if (errors != null && errors.length > 0) t.assert_string("UnresolvedIdentifier", JsonValue.String.!(field(errors[0], "code")).v);
		var owner = server.projects.forDocument(shared).active;
		t.assert(owner != null, "shared file has an owner");
		if (owner != null) {
			t.assert_string(name, owner.definition.name);
			t.assert(owner.snapshot != null, "the owner was analyzed");
		}
	}
}
def test_configuration_reassigns_closed_file(t: Tester) {
	for (fixture in ["ownership-reassignment", "ownership-removal"]) {
		var s = OwnershipTestSession.new(fixture), config = "shared/.virgil-lsp.json";
		s.open("main.v3", 1, System.fileLoad(ProjectFiles.join(s.base, "main.v3")));
		s.settle();
		var removal = Strings.equal(fixture, "ownership-removal");
		s.expectOwner(t, if(removal, "parent", "nested"));
		var nested = "{\"version\":1,\"projects\":[{\"name\":\"nested\",\"sources\":[\"Greeting.v3\",\"Other.v3\"]}]}";
		var other = "{\"version\":1,\"projects\":[{\"name\":\"nested\",\"sources\":[\"Other.v3\"]}]}";
		s.open(config, 1, if(removal, nested, other));
		s.settle();
		s.expectOwner(t, if(removal, "nested", "parent"));
		s.change(config, 2, if(removal, other, nested));
		s.settle();
		s.expectOwner(t, if(removal, "parent", "nested"));
		s.change(config, 3, "{\"version\":1,\"projects\":[{\"name\":\"replacement\",\"sources\":[\"Greeting.v3\",\"Other.v3\"]}]}");
		s.settle();
		s.expectOwner(t, "replacement");
		s.closeDocument(config);
		s.settle();
		s.expectOwner(t, if(Strings.equal(fixture, "ownership-removal"), "parent", "nested"));
		s.open(".virgil-lsp.json", 1, "{\"version\":1,\"projects\":[{\"name\":\"parent\",\"sources\":[\"main.v3\"]}]}");
		s.settle();
		s.open(config, 4, "{\"version\":1,\"projects\":[]}");
		s.settle();
		var errors = published(s.messages.extract(), s.uri("shared/Greeting.v3"));
		t.assert(errors != null && errors.length == 0, "a file leaving every project is cleared");
		t.assert(s.server.projects.forDocument(s.uri("shared/Greeting.v3")).active == null, "shared file has no remaining project");
		s.server.close();
	}
}
def test_hidden_configuration_blocks_parent(t: Tester) {
	for (fixture in ["ownership-hidden-empty", "ownership-hidden-invalid"]) {
		var s = OwnershipTestSession.new(fixture), hidden = ProjectFiles.join(s.base, ".hidden/A.v3");
		s.open("main.v3", 1, System.fileLoad(ProjectFiles.join(s.base, "main.v3")));
		s.settle();
		t.assert(published(s.messages.extract(), ProjectFiles.uri(hidden)) == null, "a nearer hidden configuration suppresses parent diagnostics");
		t.assert(s.supervisor.snapshot != null, "the parent was analyzed");
		if (s.supervisor.snapshot != null) t.assert(s.supervisor.snapshot.diagnostics.length > 0, "the closed input contains a compiler error");
		var owners = s.server.projects.owners([ProjectFiles.join(s.base, "main.v3"), hidden]);
		t.assert(owners[0] != null && owners[1] == null, "only the unblocked source has an owner");
		t.assert(s.server.projects.forDocument(ProjectFiles.uri(hidden)).active == owners[1], "document and publication ownership agree");
		s.server.close();
	}
}
def test_configuration_transfers_between_projects(t: Tester) {
	var s = OwnershipTestSession.new("ownership-project-transfer");
	s.open("main.v3", 1, System.fileLoad(ProjectFiles.join(s.base, "main.v3")));
	s.settle();
	s.expectOwner(t, "parent");
	var initial = System.fileLoad(ProjectFiles.join(s.base, ".virgil-lsp.json"));
	var transferred = "{\"version\":1,\"projects\":[{\"name\":\"parent\",\"sources\":[\"main.v3\"]},{\"name\":\"closed\",\"sources\":[\"shared/Greeting.v3\",\"shared/Other.v3\"]}]}";
	s.open(".virgil-lsp.json", 1, transferred);
	s.settle();
	s.expectOwner(t, "closed");
	s.change(".virgil-lsp.json", 2, initial);
	s.settle();
	s.expectOwner(t, "parent");
	s.change(".virgil-lsp.json", 3, transferred);
	s.settle();
	s.expectOwner(t, "closed");
	s.closeDocument(".virgil-lsp.json");
	s.settle();
	s.expectOwner(t, "parent");
	s.open(".virgil-lsp.json", 4, "{\"version\":1,\"projects\":[{\"name\":\"parent\",\"sources\":[\"main.v3\"]},{\"name\":\"closed\",\"sources\":[\"shared/Other.v3\"]}]}");
	s.settle();
	var errors = published(s.messages.extract(), s.uri("shared/Greeting.v3"));
	t.assert(errors != null && errors.length == 0, "a file removed from every project is cleared");
	t.assert(s.server.projects.forDocument(s.uri("shared/Greeting.v3")).active == null, "no owner remains");
	s.server.close();
}
def test_configuration_events_schedule_loaded_projects(t: Tester) {
	var s = OwnershipTestSession.new("ownership-project-transfer");
	var text = System.fileLoad(ProjectFiles.join(s.base, ".virgil-lsp.json"));
	s.open(".virgil-lsp.json", 1, text);
	s.settle();
	var contexts = s.server.projects.loadedContexts(), generations = Array<int>.new(contexts.length);
	t.asserti(2, contexts.length);
	t.assert(s.server.documents.overlay(s.uri("main.v3")) == null, "no source document is open");
	for (i < contexts.length) {
		t.assert(contexts[i].snapshot != null, "configuration open analyzes every loaded project");
		if (contexts[i].snapshot != null) generations[i] = contexts[i].snapshot.generation;
	}
	s.change(".virgil-lsp.json", 2, text);
	s.settle();
	for (i < contexts.length) {
		t.assert(contexts[i].snapshot != null && contexts[i].snapshot.generation > generations[i], "unchanged configuration text still schedules every project");
		if (contexts[i].snapshot != null) generations[i] = contexts[i].snapshot.generation;
	}
	s.closeDocument(".virgil-lsp.json");
	s.settle();
	for (i < contexts.length) {
		t.assert(contexts[i].snapshot != null && contexts[i].snapshot.generation > generations[i], "configuration close schedules every loaded project");
	}
	s.server.close();
}
def test_configuration_edits_drop_obsolete_waiters(t: Tester) {
	HostOs.ignoreSigpipe();
	var store = DocumentStore.new(null, DocumentLimits.MAX_BYTES), projects = WorkspaceProjects.new(store);
	var supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	var send = fun (bytes: Array<byte>) -> void { };
	var lists = LspDiagnosticLists.new(store, send);
	var semantic = LspSemanticDiagnostics.new(store, projects, supervisor, lists, send);
	projects.onConfig = fun (config: WorkspaceConfig) -> void { semantic.configChanged(); };
	var base = ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), "project-fixtures/ownership-project-transfer");
	var initialize = Strings.newMap<JsonValue>();
	initialize["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
	projects.initialize(initialize);
	var mapping = projects.forDocument(ProjectFiles.uri(ProjectFiles.join(base, "main.v3")));
	semantic.schedule(mapping.contexts, false);
	t.assert(supervisor.busy(), "the initial analysis stays pending without polling");
	t.asserti(1, semantic.waitingCount());
	var configPath = ProjectFiles.join(base, ".virgil-lsp.json"), configUri = ProjectFiles.uri(configPath);
	var text = System.fileLoad(configPath), previous = projects.loadedContexts();
	for (version = 1; version <= 16; version++) {
		text = Strings.format1("%s ", text);
		var error = if(version == 1, store.open(configUri, "json", version, text), store.change(configUri, version, text));
		t.assert(error == null, "configuration edit accepted");
		projects.refresh();
		var current = projects.loadedContexts();
		t.asserti(2, current.length);
		for (ctx in previous) t.assert(!ctx.config.current, "the preceding revision is obsolete");
		semantic.schedule([], false);
		t.assert(supervisor.busy(), "configuration edits leave the running analysis alone");
		t.asserti(current.length, semantic.waitingCount());
		semantic.schedule(current, true);
		t.asserti(current.length, semantic.waitingCount());
		semantic.schedule(previous, false);
		t.asserti(current.length, semantic.waitingCount());
		previous = current;
	}
	var fds = Array<int>.new(4);
	while (semantic.busy()) {
		var count = supervisor.pollFds(fds, 0);
		HostOs.poll(fds, count, semantic.pollTimeout());
		semantic.onPoll();
	}
	t.asserti(0, semantic.waitingCount());
	for (ctx in projects.loadedContexts()) t.assert(ctx.snapshot != null, "every latest project is analyzed");
	semantic.close();
	supervisor.close();
}
// Two contexts are due while the worker is idle. Waiting for the second makes
// it start before the first, which was scheduled earlier.
def test_urgent_context_starts_first(t: Tester) {
	HostOs.ignoreSigpipe();
	var store = DocumentStore.new(null, DocumentLimits.MAX_BYTES), projects = WorkspaceProjects.new(store);
	var supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	var send = fun (bytes: Array<byte>) -> void { };
	var semantic = LspSemanticDiagnostics.new(store, projects, supervisor, LspDiagnosticLists.new(store, send), send);
	var base = ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), "project-fixtures/ownership-project-transfer");
	var initialize = Strings.newMap<JsonValue>();
	initialize["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
	projects.initialize(initialize);
	projects.forDocument(ProjectFiles.uri(ProjectFiles.join(base, "main.v3")));
	var contexts = projects.loadedContexts();
	t.asserti(2, contexts.length);
	if (contexts.length != 2) return semantic.close();
	var first = contexts[0], second = contexts[1];
	semantic.schedule([first, second], true);
	t.assertz(false, supervisor.busy());
	t.asserti(2, semantic.waitingCount());
	// Let both become due without polling, which would start the first.
	var fds = Array<int>.new(4);
	while (semantic.pollTimeout() > 0) HostOs.poll(fds, 0, semantic.pollTimeout());
	var listener = LspSnapshotWaiters.new(LspSnapshotRequests.new(store, projects, send));
	t.assert(semantic.whenAnalyzed(second, listener) == listener, "the listener is registered");
	t.assertz(true, supervisor.busy());
	t.asserti(1, semantic.waitingCount());
	while (semantic.busy()) {
		var count = supervisor.pollFds(fds, 0);
		HostOs.poll(fds, count, semantic.pollTimeout());
		semantic.onPoll();
	}
	t.assertz(true, listener.fired);
	t.assert(first.snapshot != null && second.snapshot != null, "both contexts were analyzed");
	if (first.snapshot != null && second.snapshot != null) {
		t.assert(second.snapshot.generation < first.snapshot.generation, "the urgent context started first");
	}
	semantic.close();
	supervisor.close();
}

// A server for the fixture project directory {fixture}, two-programs or
// evicted-refresh, whose client supports both refresh requests. It
// records replies, counts refresh requests and analyses, and acknowledges
// refreshes only when told to, as a client does before requesting again.
class EvictionSession {
	def supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	def server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
	var base: string;
	def replies = Vector<HashMap<string, JsonValue>>.new();
	def refreshIds = Vector<JsonValue>.new();
	var tokenRefreshes: int;
	var hintRefreshes: int;
	var failures: int;
	var nextId = 100;
	new(fixture: string, open: bool) {
		base = ProjectTestFiles.repository(Strings.format1("test/fixtures/projects/%s", fixture));
		HostOs.ignoreSigpipe();
		server.sendNotification = receive;
		server.warnProject = warn;
		server.handle(Strings.format1("{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{\"rootUri\":\"%s\",\"capabilities\":{\"workspace\":{\"semanticTokens\":{\"refreshSupport\":true},\"inlayHint\":{\"refreshSupport\":true}}}}}",
			ProjectFiles.uri(base)));
		if (!open) return;
		this.open("server/Program.v3");
		this.open("client/Program.v3");
		settle();
	}
	def receive(bytes: Array<byte>) {
		var msg = JsonValue.JObject.!(JsonRpcJsonParser.new(bytes).parseDocument()).v;
		var name = if(msg.has("method"), JsonValue.String.!(msg["method"]).v);
		if (name != null && msg.has("id")) {
			if (Strings.equal(name, "workspace/semanticTokens/refresh")) tokenRefreshes++;
			if (Strings.equal(name, "workspace/inlayHint/refresh")) hintRefreshes++;
			refreshIds.put(msg["id"]);
		} else if (name == null) replies.put(msg);
	}
	def warn(msg: string) {
		if (Strings.startsWith(msg, "automatic analysis of project")) failures++;
	}
	def uri(name: string) -> string { return ProjectFiles.uri(ProjectFiles.join(base, name)); }
	def text(name: string) -> string { return System.fileLoad(ProjectFiles.join(base, name)); }
	def context(name: string) -> ProjectContext { return server.projects.forDocument(uri(name)).active; }
	// Clears {name}'s project's snapshot as admission does.
	def evict(name: string) -> ProjectContext {
		var ctx = context(name);
		ctx.snapshot = null;
		ctx.evicted = true;
		return ctx;
	}
	// The automatic analyses completed or failed so far. No request here
	// starts an analysis that doesn't belong to a project.
	def analyses() -> int {
		return failures + if(supervisor.snapshot != null, supervisor.snapshot.generation);
	}
	def open(name: string) {
		server.handle(Strings.format2("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"%s\",\"languageId\":\"virgil\",\"version\":1,\"text\":%s}}}",
			uri(name), quote(text(name))));
	}
	def change(name: string, version: int, text: string) {
		server.handle(StringBuilder.new()
			.put2("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"%s\",\"version\":%d},", uri(name), version)
			.put1("\"contentChanges\":[{\"text\":%s}]}}", quote(text)).extract());
	}
	def save(name: string) {
		server.handle(Strings.format1("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didSave\",\"params\":{\"textDocument\":{\"uri\":\"%s\"}}}", uri(name)));
	}
	private def quote(s: string) -> string {
		return rendered(JsonValue.String(s));
	}
	def request(method: string, name: string, rest: string) -> int {
		var id = nextId++;
		server.handle(StringBuilder.new()
			.put2("{\"jsonrpc\":\"2.0\",\"id\":%d,\"method\":\"%s\",", id, method)
			.put2("\"params\":{\"textDocument\":{\"uri\":\"%s\"}%s}}", uri(name), rest).extract());
		return id;
	}
	def at(method: string, name: string, line: int, character: int) -> int {
		return request(method, name, Strings.format2(",\"position\":{\"line\":%d,\"character\":%d}", line, character));
	}
	// Hover on the use of Greeting in {name}, one of the two programs.
	def hover(name: string) -> int { return at("textDocument/hover", name, 4, greeting(name)); }
	def definition(name: string) -> int { return at("textDocument/definition", name, 4, greeting(name)); }
	def references(name: string) -> int {
		return request("textDocument/references", name, Strings.format1(",\"position\":{\"line\":4,\"character\":%d},\"context\":{\"includeDeclaration\":true}", greeting(name)));
	}
	def tokens(name: string) -> int { return request("textDocument/semanticTokens/full", name, ""); }
	def hints(name: string) -> int {
		return request("textDocument/inlayHint", name, ",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":20,\"character\":0}}");
	}
	private def greeting(name: string) -> int { return if(Strings.startsWith(name, "server/"), 14, 17); }
	def cancel(id: int) {
		server.handle(Strings.format1("{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{\"id\":%d}}", id));
	}
	// The reply to {id}, or null if it has none yet.
	def reply(id: int) -> HashMap<string, JsonValue> {
		for (i < replies.length) {
			var r = replies[i];
			if (r.has("id") && r["id"] == JsonValue.Int(id)) return r;
		}
		return null;
	}
	// The result of {id}'s reply; JsonValue.Null without a successful reply.
	def result(id: int) -> JsonValue {
		var r = reply(id);
		return if(r != null && r.has("result"), r["result"], JsonValue.Null);
	}
	def errorCode(id: int) -> int {
		var r = reply(id);
		if (r == null || !r.has("error")) return 0;
		return JsonValue.Int.!(JsonValue.JObject.!(r["error"]).v["code"]).v;
	}
	// Answers every refresh request received so far.
	def acknowledge() {
		for (i < refreshIds.length) {
			server.handle(Strings.format1("{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":null}", rendered(refreshIds[i])));
		}
		refreshIds.clear();
	}
	// Polls until no analysis runs or waits.
	def settle() {
		var fds = Array<int>.new(4);
		server.onPoll();
		while (server.analyzing()) {
			var count = supervisor.pollFds(fds, 0);
			HostOs.poll(fds, count, server.pollTimeout());
			server.onPoll();
		}
	}
}
def tokenData(v: JsonValue) -> int {
	if (!JsonValue.JObject.?(v)) return -1;
	return JsonValue.JArray.!(JsonValue.JObject.!(v).v["data"]).v.length;
}
def hovered(v: JsonValue) -> bool {
	return JsonValue.JObject.?(v) && contains(rendered(v), "component Greeting");
}
def contains(text: string, word: string) -> bool {
	for (i = 0; i + word.length <= text.length; i++) {
		if (Strings.equal(Arrays.range(text, i, i + word.length), word)) return true;
	}
	return false;
}
// A request whose project's snapshot admission evicted analyzes the project
// again, once, and is answered from that analysis; later requests use it.
def test_evicted_demand_answers(t: Tester) {
	var s = EvictionSession.new("two-programs", true), name = "server/Program.v3";
	var ctx = s.evict(name), before = s.analyses();
	var hover = s.hover(name);
	t.assert(s.reply(hover) == null, "the hover waits for an analysis");
	t.assertz(true, s.server.analyzing());
	s.settle();
	t.asserti(before + 1, s.analyses());
	t.assert(hovered(s.result(hover)), "the hover is answered from the new snapshot");
	t.assert(ctx.snapshot != null && !ctx.evicted, "the project has a snapshot again");
	var definition = s.definition(name), references = s.references(name);
	t.assert(s.result(definition) != JsonValue.Null, "the definition is answered at once");
	t.assert(JsonValue.JArray.?(s.result(references)), "the references are answered at once");
	t.assertz(false, s.server.analyzing());
	t.asserti(before + 1, s.analyses());
	t.asserti(0, s.tokenRefreshes + s.hintRefreshes);
	s.server.close();
}
def test_evicted_demand_semantic_tokens(t: Tester) {
	var s = EvictionSession.new("two-programs", true), name = "server/Program.v3";
	var data = tokenData(s.result(s.tokens(name)));
	t.assert(data > 0, "the analyzed document has tokens");
	s.evict(name);
	var before = s.analyses(), tokens = s.tokens(name);
	t.assert(s.reply(tokens) == null, "the tokens wait for an analysis");
	s.settle();
	t.asserti(before + 1, s.analyses());
	t.asserti(data, tokenData(s.result(tokens)));
	t.asserti(0, s.tokenRefreshes + s.hintRefreshes);
	s.server.close();
}
// Requests that arrive while a demand analysis runs or waits share it.
def test_evicted_demand_coalesces(t: Tester) {
	var s = EvictionSession.new("two-programs", true), server = "server/Program.v3", client = "client/Program.v3";
	s.evict(server);
	s.evict(client);
	var before = s.analyses();
	// The server's starts at once; the client's waits for it.
	var ids = [s.hover(server), s.definition(server), s.references(server), s.tokens(server), s.hints(server),
		s.hover(client), s.tokens(client), s.definition(client), s.hover(client)];
	for (id in ids) t.assert(s.reply(id) == null, "each request waits");
	s.settle();
	t.asserti(before + 2, s.analyses());
	for (id in ids) t.assert(s.result(id) != JsonValue.Null, "each request is answered from its project's one analysis");
	t.asserti(0, s.tokenRefreshes + s.hintRefreshes);
	s.server.close();
}
// Admission that evicts a snapshot schedules no analysis.
def test_eviction_schedules_nothing(t: Tester) {
	var s = EvictionSession.new("two-programs", true);
	var server = s.context("server/Program.v3"), client = s.context("client/Program.v3"), before = s.analyses();
	s.server.projects.admitSnapshot(server, null, long.view(s.server.projects.snapshotBudget));
	t.assert(client.snapshot == null && client.evicted, "admission evicts the other snapshot");
	t.assert(server.snapshot != null && !server.evicted, "the active project keeps its snapshot");
	t.assertz(false, s.server.analyzing());
	s.settle();
	t.assert(hovered(s.result(s.hover("server/Program.v3"))), "a request for the kept snapshot is answered at once");
	t.assertz(false, s.server.analyzing());
	t.asserti(before, s.analyses());
	t.assert(client.snapshot == null && client.evicted, "nothing analyzed the evicted project");
	s.server.close();
}
// A demand analysis compares open documents as any analysis does. One
// whose tokens the client couldn't get for this text gets one refresh;
// after the client asks again, nothing more is analyzed or refreshed.
def test_demand_analysis_refreshes_once(t: Tester) {
	var s = EvictionSession.new("two-programs", true), name = "server/Program.v3";
	var ctx = s.context(name);
	// Without a snapshot or an eviction, the tokens request fails at once,
	// and the client is known to have none for this text.
	ctx.snapshot = null;
	t.asserti(LspErrorCode.CONTENT_MODIFIED, s.errorCode(s.tokens(name)));
	t.assertz(false, s.server.analyzing());
	ctx.evicted = true;
	var before = s.analyses(), hover = s.hover(name);
	s.settle();
	t.asserti(before + 1, s.analyses());
	t.assert(hovered(s.result(hover)), "the hover is answered from the demand analysis");
	t.asserti(1, s.tokenRefreshes);
	t.asserti(0, s.hintRefreshes);
	for (round < 3) {
		var work = visibleRound(s, ["server/Program.v3", "client/Program.v3"]);
		t.asserti(0, work.0);
		t.asserti(0, work.1);
		t.assertz(true, work.2);
	}
	// A save analyzes the same sources again and finds nothing to refresh.
	s.save(name);
	s.settle();
	t.asserti(before + 2, s.analyses());
	t.asserti(1, s.tokenRefreshes);
	t.asserti(0, s.hintRefreshes);
	s.server.close();
}
// A demand analysis whose open documents' tokens and hints are those the
// client already has asks for no refresh.
def test_unchanged_demand_sends_no_refresh(t: Tester) {
	var s = EvictionSession.new("two-programs", true), names = ["server/Program.v3", "client/Program.v3"];
	for (name in names) {
		t.assert(tokenData(s.result(s.tokens(name))) > 0, "the client has the document's tokens");
		t.assert(JsonValue.JArray.?(s.result(s.hints(name))), "the client has the document's hints");
	}
	for (name in names) {
		s.evict(name);
		var before = s.analyses(), hover = s.hover(name);
		s.settle();
		t.asserti(before + 1, s.analyses());
		t.assert(hovered(s.result(hover)), "the hover is answered from the demand analysis");
	}
	t.asserti(0, s.tokenRefreshes);
	t.asserti(0, s.hintRefreshes);
	s.server.close();
}
// The case of the review of #330: the client project's analysis after an edit
// fails, since both snapshots are retained, and the server's analysis then
// evicts the client's stale snapshot. The demand analysis that a hover
// causes carries the edit, which changes the tokens and hints of Use.v3,
// whose text the client hasn't changed: it sends one refresh of each.
// Afterwards the client's requests analyze and refresh nothing.
def test_demand_refreshes_changed_documents(t: Tester) {
	var s = EvictionSession.new("evicted-refresh", true), program = "client/Program.v3", use = "client/Use.v3";
	var names = ["server/Program.v3", program, use];
	s.open(use);
	s.settle();
	var client = s.context(program), server = s.context(names[0]);
	t.assert(s.supervisor.snapshot == server.snapshot, "the server's snapshot is the latest");
	var tokens = rendered(s.result(s.tokens(use))), hints = rendered(s.result(s.hints(use)));
	t.assert(tokenData(s.result(s.tokens(use))) > 0, "Use.v3 has tokens");
	t.assert(contains(hints, "\"label\":\"width:\""), "Use.v3 labels area's argument");
	s.server.projects.snapshotBudget = AnalysisWire.MAX_RESULT_ALLOCATION
		+ int.view(server.snapshot.retainedBytes + client.snapshot.retainedBytes) - 1;
	// Shape becomes an enum, and area's parameter, declared and used, size.
	var text = replace(s.text(program), "class Shape { }", "enum Shape { A, B }");
	for (i < 2) text = replace(text, "width", "size");
	s.change(program, 2, text);
	s.settle();
	t.assert(s.failures > 0, "the edit's analysis of the client fails admission");
	t.assert(client.snapshot == null && client.evicted, "the server's analysis evicts the client's stale snapshot");
	t.asserti(0, s.tokenRefreshes + s.hintRefreshes);
	var before = s.analyses(), hover = s.hover(program);
	s.settle();
	t.asserti(before + 1, s.analyses());
	t.assert(hovered(s.result(hover)), "the hover is answered from the demand analysis");
	t.asserti(1, s.tokenRefreshes);
	t.asserti(1, s.hintRefreshes);
	t.assert(!Strings.equal(tokens, rendered(s.result(s.tokens(use)))), "Use.v3's tokens changed");
	t.assert(contains(rendered(s.result(s.hints(use))), "\"label\":\"size:\""), "Use.v3's hint changed");
	// Each round also hovers Use.v3 where it has no Greeting, so only the
	// work counts.
	for (round < 3) {
		var work = visibleRound(s, names);
		t.asserti(0, work.0);
		t.asserti(0, work.1);
	}
	s.server.close();
}
// A save while a demand analysis waits schedules the same analysis: one
// analysis of the project answers the request and the save.
def test_event_joins_waiting_demand(t: Tester) {
	var s = EvictionSession.new("two-programs", true), name = "server/Program.v3";
	s.evict(name);
	// A development analysis keeps the worker busy, so the demand waits.
	s.server.handle(Strings.format1("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"virgil-lsp/analyze\",\"params\":{\"uri\":\"%s\"}}", s.uri("client/Program.v3")));
	t.assertz(true, s.supervisor.busy());
	var before = s.analyses(), hover = s.hover(name);
	t.assert(s.reply(hover) == null, "the hover waits");
	s.save(name);
	s.settle();
	t.asserti(before + 2, s.analyses());
	t.assert(hovered(s.result(hover)), "the hover is answered from the save's analysis");
	t.asserti(0, s.tokenRefreshes + s.hintRefreshes);
	s.server.close();
}
// A demand analysis that fails answers its requests as before and is not
// tried again for the next request. An edit schedules the project again.
def test_failed_demand_not_retried(t: Tester) {
	var s = EvictionSession.new("two-programs", true), name = "server/Program.v3";
	var ctx = s.evict(name), before = s.analyses();
	s.server.projects.snapshotBudget = 0;
	var hover = s.hover(name);
	t.asserti(before + 1, s.analyses());
	t.assert(s.reply(hover) != null && s.result(hover) == JsonValue.Null, "the failed analysis answers the hover with null");
	t.assertz(false, ctx.evicted);
	s.server.projects.snapshotBudget = s.server.projects.MAX_SNAPSHOT_BYTES;
	var tokens = s.tokens(name), again = s.hover(name);
	t.asserti(LspErrorCode.CONTENT_MODIFIED, s.errorCode(tokens));
	t.assert(s.reply(again) != null && s.result(again) == JsonValue.Null, "the next hover is answered at once");
	t.assertz(false, s.server.analyzing());
	s.settle();
	t.asserti(before + 1, s.analyses());
	s.change(name, 2, Strings.format1("%s\n", s.text(name)));
	s.settle();
	t.asserti(before + 2, s.analyses());
	t.assert(hovered(s.result(s.hover(name))), "the edit's analysis answers");
	s.server.close();
}
// A project whose automatic analyses failed, with no snapshot to evict,
// answers at once and is not analyzed for a request.
def test_failed_analysis_no_demand(t: Tester) {
	var s = EvictionSession.new("two-programs", false), name = "server/Program.v3";
	s.server.projects.snapshotBudget = 0;
	s.open(name);
	s.open("client/Program.v3");
	s.settle();
	var failures = s.analyses(), ctx = s.context(name);
	t.assert(failures > 0, "the automatic analyses failed");
	t.assert(ctx.snapshot == null && !ctx.evicted, "the project has neither a snapshot nor an eviction");
	s.server.projects.snapshotBudget = s.server.projects.MAX_SNAPSHOT_BYTES;
	var hover = s.hover(name), tokens = s.tokens(name);
	t.assert(s.reply(hover) != null && s.result(hover) == JsonValue.Null, "the hover is answered at once");
	t.asserti(LspErrorCode.CONTENT_MODIFIED, s.errorCode(tokens));
	t.assertz(false, s.server.analyzing());
	t.asserti(failures, s.analyses());
	s.server.close();
}
// Cancellation answers a request waiting for a demand analysis, and shutdown
// answers the rest, as for any analysis.
def test_demand_waiters_cancel_and_shutdown(t: Tester) {
	var s = EvictionSession.new("two-programs", true), name = "server/Program.v3";
	s.evict(name);
	var first = s.hover(name);
	t.assertz(true, s.server.analyzing());
	s.cancel(first);
	t.asserti(LspErrorCode.REQUEST_CANCELLED, s.errorCode(first));
	var second = s.hover(name), tokens = s.tokens(name);
	t.assert(s.reply(second) == null && s.reply(tokens) == null, "later requests wait for the same analysis");
	s.server.handle("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}");
	t.asserti(LspErrorCode.REQUEST_CANCELLED, s.errorCode(second));
	t.asserti(LspErrorCode.REQUEST_CANCELLED, s.errorCode(tokens));
	s.server.close();
}
// Greeting.text as a field rather than a method, which changes its tokens in
// both programs.
def GREETING_FIELD = "// Shared by both programs. It belongs to the \"server\" and \"client\" projects.\ncomponent Greeting {\n\tdef text: string -> string = echo;\n\tdef echo(who: string) -> string {\n\t\treturn who;\n\t}\n}\n";
// One round of a client that shows both programs: it answers the refresh
// requests it has, requests every visible document's hover, tokens, and
// hints, and waits for the replies. Returns the analyses and refresh
// requests the round caused, and whether every hover was answered.
def visibleRound(s: EvictionSession, names: Array<string>) -> (int, int, bool) {
	var analyses = s.analyses(), refreshes = s.tokenRefreshes + s.hintRefreshes;
	var hovers = Vector<int>.new();
	s.acknowledge();
	for (name in names) { hovers.put(s.hover(name)); s.tokens(name); s.hints(name); }
	s.settle();
	var answered = true;
	for (i < hovers.length) answered = answered && hovered(s.result(hovers[i]));
	return (s.analyses() - analyses, s.tokenRefreshes + s.hintRefreshes - refreshes, answered);
}
// Two visible programs whose snapshots don't both fit beside an incoming
// analysis's reservation. After an edit, a client that requests every
// visible document again after each refresh, as editors do, causes at most
// one demand analysis per evicted project, and then no work at all.
def test_visible_projects_stop(t: Tester) {
	var s = EvictionSession.new("two-programs", true), names = ["server/Program.v3", "client/Program.v3"];
	var server = s.context(names[0]), client = s.context(names[1]);
	s.server.projects.snapshotBudget = AnalysisWire.MAX_RESULT_ALLOCATION
		+ int.view(server.snapshot.retainedBytes + client.snapshot.retainedBytes) - 1;
	// The client's analysis fails, since both snapshots are retained, and
	// then the server's evicts the client's snapshot, as in the issue (#330).
	var text = replace(s.text(names[1]), "return greeting.length;", "var n = greeting.length;\n\t\treturn n;");
	s.change(names[1], 2, text);
	s.settle();
	t.assert(client.snapshot == null && client.evicted, "the edit's analyses evict the client's snapshot");
	// The first round analyzes the client once more. The edit's new local
	// gets a type hint, which the comparison finds, as any analysis of the
	// edit would: one inlay hint refresh, and none for tokens, which a
	// document's new text never needs.
	var work = visibleRound(s, names);
	t.asserti(1, work.0);
	t.asserti(0, s.tokenRefreshes);
	t.asserti(1, s.hintRefreshes);
	t.assertz(true, work.2);
	for (round < 3) {
		work = visibleRound(s, names);
		t.asserti(0, work.0);
		t.asserti(0, work.1);
		t.assertz(true, work.2);
	}
	// An edit to the shared file changes both programs' tokens and hints, so
	// its analyses ask for a refresh of each, once. Admission refuses one
	// program's analysis while its stale snapshot is retained; that is a
	// failed analysis, not an eviction, so the client's next requests
	// analyze nothing.
	var failures = s.failures, tokens = s.tokenRefreshes, hints = s.hintRefreshes;
	s.open("shared/Greeting.v3");
	s.change("shared/Greeting.v3", 2, GREETING_FIELD);
	s.settle();
	t.asserti(tokens + 1, s.tokenRefreshes);
	t.asserti(hints + 1, s.hintRefreshes);
	t.assert(s.failures > failures, "admission refuses an analysis");
	for (round < 3) {
		work = visibleRound(s, names);
		t.asserti(0, work.0);
		t.asserti(0, work.1);
	}
	s.server.close();
}
// The re-check of #330: under many waiting requests, a refused token request
// erased the fingerprint that the last comparison found, so each demand
// analysis refreshed the same tokens again, and the client's next requests
// were refused again. Each round here, another project's analysis has evicted
// the server's snapshot, and the client, after answering any refresh,
// requests every visible document with more requests waiting than
// LspSnapshotRequests allows, so the oldest, the server's tokens, is refused.
// The first demand analysis refreshes those tokens; later rounds analyze the
// server for their own requests and refresh nothing. After an edit that
// changes the tokens, which refreshes them, one round refreshes once more.
def test_waiter_pressure_refreshes_once(t: Tester) {
	var s = EvictionSession.new("two-programs", true), names = ["server/Program.v3", "client/Program.v3"];
	for (refreshes in [1, 0, 0, 0]) pressureRound(t, s, names, refreshes);
	// Each program's analysis of the edit refreshes its tokens and hints; the
	// second refresh of each waits for the client's answer to the first.
	var tokens = s.tokenRefreshes, hints = s.hintRefreshes;
	s.open("shared/Greeting.v3");
	s.change("shared/Greeting.v3", 2, GREETING_FIELD);
	s.settle();
	s.acknowledge();
	s.settle();
	t.asserti(tokens + 2, s.tokenRefreshes);
	t.asserti(hints + 2, s.hintRefreshes);
	for (refreshes in [1, 0, 0, 0]) pressureRound(t, s, names, refreshes);
	s.server.close();
}
// One round of test_waiter_pressure_refreshes_once, which expects {refreshes}
// token refreshes and one analysis.
def pressureRound(t: Tester, s: EvictionSession, names: Array<string>, refreshes: int) {
	var analyses = s.analyses(), tokens = s.tokenRefreshes, hints = s.hintRefreshes;
	s.acknowledge();
	s.evict(names[0]);
	var refused = s.tokens(names[0]);
	for (name in names) { s.hover(name); s.hints(name); }
	s.tokens(names[1]);
	// The server's three requests wait; these take the waiting count past the bound.
	for (i < LspSnapshotRequests.new(null, null, null).MAX_WAITING - 2) s.hover(names[0]);
	t.asserti(LspErrorCode.CONTENT_MODIFIED, s.errorCode(refused));
	s.settle();
	t.asserti(1, s.analyses() - analyses);
	t.asserti(refreshes, s.tokenRefreshes - tokens);
	t.asserti(0, s.hintRefreshes - hints);
}
