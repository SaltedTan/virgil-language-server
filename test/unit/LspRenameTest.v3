// textDocument/rename with the real worker. Each session writes its project
// file and sources into the build's project-fixtures/rename-edits directory
// before the project is loaded. A rename's edits are checked exactly, then
// applied to the open documents and the closed files, and renamed back: the
// edited program's analysis must bind the same uses, so the reverse rename
// passes its own preflight and edits the same tokens. LspPrepareRenameTest
// covers eligibility, which rename shares, in full.
def T = UnitTests.register;
def X = [
	T("LspRename:locals_and_parameters", test_locals_and_parameters),
	T("LspRename:fields_and_methods", test_fields_and_methods),
	T("LspRename:classes_and_components", test_classes_and_components),
	T("LspRename:enums_and_variants", test_enums_and_variants),
	T("LspRename:layouts_and_type_parameters", test_layouts_and_type_parameters),
	T("LspRename:shared_name_tokens", test_shared_name_tokens),
	T("LspRename:refuses_what_prepare_refuses", test_refuses_what_prepare_refuses),
	T("LspRename:same_name", test_same_name),
	T("LspRename:same_named_methods", test_same_named_methods),
	T("LspRename:members_across_subclasses", test_members_across_subclasses),
	T("LspRename:utf16_ranges", test_utf16_ranges),
	T("LspRename:capture_by_new_local", test_capture_by_new_local),
	T("LspRename:capture_by_existing_local", test_capture_by_existing_local),
	T("LspRename:duplicate_names", test_duplicate_names),
	T("LspRename:invalid_names", test_invalid_names),
	T("LspRename:invalid_name_while_waiting", test_invalid_name_while_waiting),
	T("LspRename:name_length", test_name_length),
	T("LspRename:parse_and_semantic_errors", test_parse_and_semantic_errors),
	T("LspRename:dependency_and_virgil_root", test_dependency_and_virgil_root),
	T("LspRename:no_document_changes", test_no_document_changes),
	T("LspRename:closed_request", test_closed_request),
	T("LspRename:closed_while_waiting", test_closed_while_waiting),
	T("LspRename:replaced_context_while_waiting", test_replaced_context_while_waiting),
	T("LspRename:replaced_context_during_preflight", test_replaced_context_during_preflight),
	T("LspRename:cancelled_preflight_snapshot_budget", test_cancelled_preflight_snapshot_budget),
	T("LspRename:changed_while_waiting", test_changed_while_waiting),
	T("LspRename:changed_while_checked", test_changed_while_checked),
	T("LspRename:closed_file_changed_while_checked", test_closed_file_changed_while_checked),
	T("LspRename:stale_snapshot", test_stale_snapshot),
	T("LspRename:preflight_time_limit", test_preflight_time_limit),
	T("LspRename:preflight_worker_crash", test_preflight_worker_crash),
	T("LspRename:preflight_result_too_large", test_preflight_result_too_large),
	T("LspRename:concurrent", test_concurrent),
	T("LspRename:cancel", test_cancel),
	T("LspRename:cancelled_waiting_renames_are_released", test_cancelled_waiting_renames_are_released),
	T("LspRename:shutdown", test_shutdown),
	T("LspRename:reply_bounds", test_reply_bounds),
	T("LspRename:preflight_is_not_kept", test_preflight_is_not_kept),
	T("LspRename:jobs_and_analyses_take_turns", test_jobs_and_analyses_take_turns),
	T("LspRename:parameter_errors", test_parameter_errors),
	T("LspRename:advertised", test_advertised),
	()
];

def CONFIG = "{\"version\":1,\"projects\":[{\"name\":\"e\",\"sources\":[\"Kinds.v3\",\"Open.v3\",\"Uses.v3\"]}]}";
// Kinds.v3 is open with unsaved changes: KINDS_DISK on disk, KINDS in the
// editor. Open.v3 is open and unchanged; Uses.v3 is closed. Every line is ASCII.
def KINDS_DISK = "class Shape(sides: int) {\n\tvar area: int;\n}\n";
def KINDS = "class Shape(sides: int) {\n\tvar area: int;\n\tdef scale(factor: int) -> int {\n\t\tvar total = area * factor;\n\t\treturn total + sides;\n\t}\n\tdef self() -> Shape { return this; }\n}\ncomponent Registry {\n\tdef count = 3;\n\tdef make(n: int) -> Shape { return Shape.new(n); }\n}\nenum Color { RED, GREEN }\ntype Token {\n\tcase Word(text: string);\n\tcase End;\n}\nlayout Header {\n\t+0 tag: u8;\n\t=1;\n}\nclass Holder<T> {\n\tvar item: T;\n\tdef get() -> T { return item; }\n}\npacking Pair(a: 4, b: 4): 8 = #concat(a, b);\n";
def OPEN = "component Opened {\n\tdef measure(s: Shape) -> int { return s.area + Registry.count; }\n}\n";
def USES = "component Uses {\n\tdef run(s: Shape, c: Color, t: Token, r: Ref<Header>) -> int {\n\t\tvar h = Holder<Shape>.new();\n\t\th.item = s;\n\t\tvar x = s.scale(Registry.count) + h.get().area;\n\t\tif (c == Color.RED) x++;\n\t\tmatch (t) {\n\t\t\tWord(text) => x += text.length;\n\t\t\tEnd => x--;\n\t\t}\n\t\treturn x + r.tag;\n\t}\n}\n";

// The LSP position, in UTF-16 code units, of byte {skip} past the first
// {needle} in {text}.
class RenameTestSpot(line: int, character: int) { }
def at(text: string, needle: string, skip: int) -> RenameTestSpot {
	var line = 0, start = 0;
	for (i = 0; i + needle.length <= text.length; i++) {
		if (Strings.equal(Arrays.range(text, i, i + needle.length), needle)) return RenameTestSpot.new(line, units(text, start, i + skip));
		if (text[i] == '\n') {
			line++;
			start = i + 1;
		}
	}
	return RenameTestSpot.new(-1, -1);
}
// The UTF-16 code units that encode the UTF-8 bytes of {text} from {begin} to
// {end}: one for each character, and two for one of four bytes.
def units(text: string, begin: int, end: int) -> int {
	var n = 0;
	for (i = begin; i < end; i++) {
		var b: int = text[i];
		if ((b & 0xC0) != 0x80) n += if(b >= 0xF0, 2, 1);
	}
	return n;
}
// The expected edits of one document of {s}, as {render} writes them: its
// name, its current version, and the "line:begin-end" of the {length} bytes at {skip} into each
// of {needles} in {text}.
def doc(s: RenameTestSession, name: string, text: string, needles: Array<(string, int)>, length: int) -> string {
	var f = s.file(name), buf = StringBuilder.new().puts(name);
	if (f.version >= 0) buf.put1("@%d:", f.version);
	else buf.puts("@null:");
	for (n in needles) {
		var p = at(text, n.0, n.1);
		buf.put3(" %d:%d-%d", p.line, p.character, p.character + length);
	}
	return buf.toString();
}
def join(docs: Array<string>) -> string {
	var buf = StringBuilder.new();
	for (i < docs.length) {
		if (i > 0) buf.puts("; ");
		buf.puts(docs[i]);
	}
	return buf.toString();
}
def member(v: JsonValue, key: string) -> JsonValue {
	return if(JsonValue.JObject.?(v), JsonValue.JObject.!(v).v[key]);
}
def intAt(v: JsonValue, key: string) -> int {
	var m = member(v, key);
	return if(JsonValue.Int.?(m), JsonValue.Int.!(m).v, -1);
}
def stringAt(v: JsonValue, key: string) -> string {
	var m = member(v, key);
	return if(JsonValue.String.?(m), JsonValue.String.!(m).v, "<none>");
}
def array(v: JsonValue) -> Array<JsonValue> {
	return if(JsonValue.JArray.?(v), JsonValue.JArray.!(v).v, []);
}
def writeFile(t: Tester, path: string, text: string) {
	var fd = System.fileOpen(path, false);
	t.assert(fd >= 0, "fixture file written");
	if (fd < 0) return;
	System.fileWriteK(fd, text, 0, text.length);
	System.fileClose(fd);
}
def fixtureDirectory(fixture: string) -> string {
	return ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), ProjectFiles.join("project-fixtures", fixture));
}
// A source of a session: its text as the editor or the disk has it, and its
// open version, or -1 while it is closed.
class RenameTestFile(name: string) {
	var text: string;
	var version = -1;
}
class RenameTestSession {
	def limits = AnalysisWorkerLimits.new();
	var supervisor: AnalysisSupervisor;
	var server: LspServer;
	def files = Vector<RenameTestFile>.new();
	var base: string;
	// The responses received, in order, and the notifications.
	def replies = Vector<HashMap<string, JsonValue>>.new();
	def notifications = Vector<HashMap<string, JsonValue>>.new();
	var nextId = 100;
	var initializeReply: Array<byte>;

	// Writes {sources}, the project file among them, and initializes the
	// server, with the documentChanges capability if {documentChanges}, on the
	// analysis worker at {worker}, or the real one if it is null.
	new(fixture: string, sources: Array<(string, string)>, documentChanges: bool, worker: string, t: Tester) {
		supervisor = AnalysisSupervisor.new(if(worker != null, worker, WorkerProcesses.defaultPath()), limits);
		server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
		base = fixtureDirectory(fixture);
		for (source in sources) write(t, source.0, source.1);
		HostOs.ignoreSigpipe();
		server.sendNotification = receive;
		var edit = Strings.newMap<JsonValue>(), workspace = Strings.newMap<JsonValue>();
		var rename = Strings.newMap<JsonValue>(), textDocument = Strings.newMap<JsonValue>();
		var capabilities = Strings.newMap<JsonValue>(), params = Strings.newMap<JsonValue>();
		if (documentChanges) edit["documentChanges"] = JsonValue.Bool(true);
		workspace["workspaceEdit"] = JsonValue.JObject(edit);
		rename["prepareSupport"] = JsonValue.Bool(true);
		textDocument["rename"] = JsonValue.JObject(rename);
		capabilities["workspace"] = JsonValue.JObject(workspace);
		capabilities["textDocument"] = JsonValue.JObject(textDocument);
		params["capabilities"] = JsonValue.JObject(capabilities);
		params["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
		initializeReply = server.handle(JsonRpcMessage.Request(JsonRpcId.Int(0), "initialize", JsonRpcParams.ByName(params)).encode());
	}
	def receive(bytes: Array<byte>) {
		var parsed = JsonValue.JObject.!(JsonRpcJsonParser.new(bytes).parseDocument()).v;
		if (parsed.has("id")) replies.put(parsed);
		else notifications.put(parsed);
	}
	def path(name: string) -> string { return ProjectFiles.join(base, name); }
	def uri(name: string) -> string { return ProjectFiles.uri(path(name)); }
	def file(name: string) -> RenameTestFile {
		for (i < files.length) if (Strings.equal(files[i].name, name)) return files[i];
		var f = RenameTestFile.new(name);
		files.put(f);
		return f;
	}
	def text(name: string) -> string { return file(name).text; }
	// Writes {name} on disk, without a file event.
	def write(t: Tester, name: string, text: string) {
		writeFile(t, path(name), text);
		var f = file(name);
		if (f.version < 0) f.text = text;
	}
	def reportChanged(name: string) {
		var change = Strings.newMap<JsonValue>(), params = Strings.newMap<JsonValue>();
		change["uri"] = JsonValue.String(uri(name));
		change["type"] = JsonValue.Int(2);
		params["changes"] = JsonValue.JArray([JsonValue.JObject(change)]);
		server.handle(JsonRpcMessage.Notification("workspace/didChangeWatchedFiles", JsonRpcParams.ByName(params)).encode());
	}
	def open(name: string, version: int, text: string) {
		var f = file(name), doc = Strings.newMap<JsonValue>();
		f.text = text;
		f.version = version;
		doc["uri"] = JsonValue.String(uri(name));
		doc["languageId"] = JsonValue.String("virgil");
		doc["version"] = JsonValue.Int(version);
		doc["text"] = JsonValue.String(text);
		notify("textDocument/didOpen", doc, null);
	}
	def closeDocument(name: string) {
		file(name).version = -1;
		var doc = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		notify("textDocument/didClose", doc, null);
	}
	def change(name: string, version: int, text: string) {
		var f = file(name), doc = Strings.newMap<JsonValue>(), change = Strings.newMap<JsonValue>();
		f.text = text;
		f.version = version;
		doc["uri"] = JsonValue.String(uri(name));
		doc["version"] = JsonValue.Int(version);
		change["text"] = JsonValue.String(text);
		notify("textDocument/didChange", doc, [JsonValue.JObject(change)]);
	}
	private def notify(method: string, doc: HashMap<string, JsonValue>, changes: Array<JsonValue>) {
		var params = Strings.newMap<JsonValue>();
		params["textDocument"] = JsonValue.JObject(doc);
		if (changes != null) params["contentChanges"] = JsonValue.JArray(changes);
		server.handle(JsonRpcMessage.Notification(method, JsonRpcParams.ByName(params)).encode());
	}
	// Polls until no analysis or preflight runs or waits.
	def settle() {
		var fds = Array<int>.new(4);
		while (server.analyzing()) {
			var count = supervisor.pollFds(fds, 0);
			HostOs.poll(fds, count, server.pollTimeout());
			server.onPoll();
		}
	}
	def params(name: string, line: int, character: int) -> HashMap<string, JsonValue> {
		var doc = Strings.newMap<JsonValue>(), position = Strings.newMap<JsonValue>(), params = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri(name));
		position["line"] = JsonValue.Int(line);
		position["character"] = JsonValue.Int(character);
		params["textDocument"] = JsonValue.JObject(doc);
		params["position"] = JsonValue.JObject(position);
		return params;
	}
	// Sends a request with {params} and returns its id. Replies use the sink.
	def send(t: Tester, method: string, params: HashMap<string, JsonValue>) -> int {
		var id = nextId++;
		var handled = server.handle(JsonRpcMessage.Request(JsonRpcId.Int(id), method, JsonRpcParams.ByName(params)).encode());
		t.assert(handled == null, "replies use the sink");
		return id;
	}
	// Sends a rename request, without waiting for its preflight.
	def rename(t: Tester, name: string, line: int, character: int, newName: string) -> int {
		var p = params(name, line, character);
		p["newName"] = JsonValue.String(newName);
		return send(t, "textDocument/rename", p);
	}
	def cancel(id: int) {
		var params = Strings.newMap<JsonValue>();
		params["id"] = JsonValue.Int(id);
		server.handle(JsonRpcMessage.Notification("$/cancelRequest", JsonRpcParams.ByName(params)).encode());
	}
	// The response to {id}, or null if none has arrived.
	def reply(id: int) -> HashMap<string, JsonValue> {
		for (i < replies.length) {
			if (replies[i]["id"] == JsonValue.Int(id)) return replies[i];
		}
		return null;
	}
	// The number of responses to {id}.
	def count(id: int) -> int {
		var n = 0;
		for (i < replies.length) if (replies[i]["id"] == JsonValue.Int(id)) n++;
		return n;
	}
	def result(t: Tester, id: int) -> JsonValue {
		var r = reply(id);
		t.assert(r != null, "the request was answered");
		if (r == null) return JsonValue.Null;
		if (r.has("error")) t.fail1("the request failed: %s", stringAt(r["error"], "message"));
		return r["result"];
	}
	// Renames at {skip} bytes into {needle} in {name} and returns the
	// WorkspaceEdit, once its preflight has passed.
	def renamed(t: Tester, name: string, needle: string, skip: int, newName: string) -> JsonValue {
		var p = at(text(name), needle, skip);
		t.assert(p.line >= 0, "fixture text found");
		var checked = server.rename.checked, id = rename(t, name, p.line, p.character, newName);
		settle();
		var edit = result(t, id);
		t.assert(server.projects.renameSnapshot == null, "a successful rename releases its snapshot pin");
		t.asserti(checked + 1, server.rename.checked);
		return edit;
	}
	// Checks that the rename at {skip} bytes into {needle} in {name} fails with
	// RequestFailed and {message}, with no edit.
	def refused(t: Tester, name: string, needle: string, skip: int, newName: string, message: string) {
		var p = at(text(name), needle, skip);
		t.assert(p.line >= 0, "fixture text found");
		var id = rename(t, name, p.line, p.character, newName);
		settle();
		expectFailed(t, this, id, message);
		t.assert(server.projects.renameSnapshot == null, "a refused rename releases its snapshot pin");
	}
	// The name of {uri} relative to the session's directory.
	def relative(uri: string) -> string {
		var prefix = this.uri("");
		return if(Strings.startsWith(uri, prefix), Arrays.range(uri, prefix.length, uri.length), uri);
	}
	// Applies {edit}, a WorkspaceEdit that writes {newName}: changes the open
	// documents and writes and reports the closed files.
	def apply(t: Tester, edit: JsonValue, newName: string) {
		for (d in array(member(edit, "documentChanges"))) {
			var name = relative(stringAt(member(d, "textDocument"), "uri")), f = file(name);
			var text = f.text, edits = array(member(d, "edits"));
			// From the last, so that earlier positions stay valid.
			for (k = edits.length - 1; k >= 0; k--) {
				var range = member(edits[k], "range");
				var begin = offset(text, member(range, "start")), end = offset(text, member(range, "end"));
				t.assert_string(newName, stringAt(edits[k], "newText"));
				text = Arrays.concat(Arrays.concat(Arrays.range(text, 0, begin), newName), Arrays.range(text, end, text.length));
			}
			if (f.version >= 0) change(name, f.version + 1, text);
			else {
				write(t, name, text);
				reportChanged(name);
			}
		}
	}
	// The byte offset of LSP position {p}, in UTF-16 code units, in {text}.
	private def offset(text: string, p: JsonValue) -> int {
		var line = intAt(p, "line"), i = 0;
		while (line > 0 && i < text.length) {
			if (text[i++] == '\n') line--;
		}
		var end = i;
		while (end < text.length && units(text, i, end) < intAt(p, "character")) end++;
		// The rest of the character's bytes.
		while (end < text.length && (int.!(text[end]) & 0xC0) == 0x80) end++;
		return end;
	}
}
// {edit} as "name@version: line:begin-end ..." for each document, in order,
// with each range moved as its tokens would be once the edits before it on
// its line change their length by {delta}, and the session's current
// version if {current}.
def render(s: RenameTestSession, edit: JsonValue, delta: int, current: bool) -> string {
	var docs = Vector<string>.new();
	for (change in array(member(edit, "documentChanges"))) {
		var textDocument = member(change, "textDocument"), name = s.relative(stringAt(textDocument, "uri"));
		var v = member(textDocument, "version"), version = "null";
		if (current) {
			var f = s.file(name);
			if (f.version >= 0) version = Strings.format1("%d", f.version);
		} else if (JsonValue.Int.?(v)) {
			version = Strings.format1("%d", JsonValue.Int.!(v).v);
		}
		var buf = StringBuilder.new().put2("%s@%s:", name, version), line = -1, moved = 0;
		for (e in array(member(change, "edits"))) {
			var range = member(e, "range"), start = member(range, "start"), end = member(range, "end");
			var l = intAt(start, "line");
			if (l != line) moved = 0;
			line = l;
			var begin = intAt(start, "character") + moved, length = intAt(end, "character") - intAt(start, "character") + delta;
			if (intAt(end, "line") != l) buf.puts(" <multi-line>");
			buf.put3(" %d:%d-%d", l, begin, begin + length);
			moved += delta;
		}
		docs.put(buf.toString());
	}
	return join(docs.extract());
}
def expectFailed(t: Tester, s: RenameTestSession, id: int, message: string) {
	var r = s.reply(id), what = Strings.format1("RequestFailed: %s", message);
	t.assert(r != null, "the request was answered");
	if (r == null) return;
	t.assert(r.has("error"), what);
	if (!r.has("error")) return;
	t.asserti(LspErrorCode.REQUEST_FAILED, intAt(r["error"], "code"));
	t.assert_string(message, stringAt(r["error"], "message"));
}
// The fixture's session, with Kinds.v3 open and edited, Open.v3 open, and
// Uses.v3 closed, analyzed.
def kindsSession(t: Tester) -> RenameTestSession {
	return kindsSessionOn(null, t);
}
// The fixture's session on the analysis worker at {worker}.
def kindsSessionOn(worker: string, t: Tester) -> RenameTestSession {
	var s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", CONFIG), ("Kinds.v3", KINDS_DISK),
		("Open.v3", OPEN), ("Uses.v3", USES)], true, worker, t);
	s.open("Kinds.v3", 1, KINDS_DISK);
	s.change("Kinds.v3", 2, KINDS);
	s.open("Open.v3", 1, OPEN);
	s.settle();
	return s;
}
// Renames {oldName} at {skip} bytes into {needle} in {name} to {newName},
// checks the edits against {expected}, applies them, renames back from the
// first edited token, checks that the reverse rename edits the same tokens,
// moved, and applies it, which restores every text.
def roundTrip(t: Tester, s: RenameTestSession, name: string, needle: string, skip: int, oldName: string,
		newName: string, expected: string) {
	var before = Array<string>.new(s.files.length);
	for (i < before.length) before[i] = s.files[i].text;
	var edit = s.renamed(t, name, needle, skip, newName);
	t.assert_string(expected, render(s, edit, 0, false));
	s.apply(t, edit, newName);
	s.settle();
	var reverse = render(s, edit, newName.length - oldName.length, true);
	// The first edited token, which the first edit's start still begins.
	var changes = array(member(edit, "documentChanges"));
	t.assert(changes.length > 0, "the rename edits something");
	if (changes.length == 0) return;
	var file = s.relative(stringAt(member(changes[0], "textDocument"), "uri"));
	var start = member(member(array(member(changes[0], "edits"))[0], "range"), "start");
	var p = s.params(file, intAt(start, "line"), intAt(start, "character"));
	p["newName"] = JsonValue.String(oldName);
	var checked = s.server.rename.checked, id = s.send(t, "textDocument/rename", p);
	s.settle();
	var back = s.result(t, id);
	t.asserti(checked + 1, s.server.rename.checked);
	t.assert_string(reverse, render(s, back, 0, false));
	s.apply(t, back, oldName);
	s.settle();
	for (i < before.length) t.assert_string(before[i], s.files[i].text);
}

def test_locals_and_parameters(t: Tester) {
	var s = kindsSession(t);
	roundTrip(t, s, "Kinds.v3", "return total", 7, "total", "sum",
		doc(s, "Kinds.v3", KINDS, [("var total", 4), ("return total", 7)], 5));
	roundTrip(t, s, "Kinds.v3", "scale(factor", 6, "factor", "k",
		doc(s, "Kinds.v3", KINDS, [("scale(factor", 6), ("* factor", 2)], 6));
	// A local and a parameter, which only their file uses.
	s.open("Uses.v3", 1, USES);
	s.settle();
	roundTrip(t, s, "Uses.v3", "var x", 4, "x", "count",
		doc(s, "Uses.v3", USES, [("var x", 4), ("x++", 0), ("x +=", 0), ("x--", 0), ("return x", 7)], 1));
	roundTrip(t, s, "Uses.v3", "s.scale", 0, "s", "shape",
		doc(s, "Uses.v3", USES, [("(s: Shape", 1), ("= s;", 2), ("s.scale", 0)], 1));
	// A match binding.
	roundTrip(t, s, "Uses.v3", "Word(text", 5, "text", "word",
		doc(s, "Uses.v3", USES, [("Word(text", 5), ("+= text", 3)], 4));
	s.server.close();
}
def test_fields_and_methods(t: Tester) {
	var s = kindsSession(t);
	// Uses in the edited document, the unchanged open one, and the closed one.
	roundTrip(t, s, "Kinds.v3", "var area", 4, "area", "surface", join([
		doc(s, "Kinds.v3", KINDS, [("var area", 4), ("= area", 2)], 4),
		doc(s, "Open.v3", OPEN, [("s.area", 2)], 4),
		doc(s, "Uses.v3", USES, [("().area", 3)], 4)]));
	// A component's field, from a use in the unchanged open file.
	roundTrip(t, s, "Open.v3", "Registry.count", 9, "count", "size", join([
		doc(s, "Kinds.v3", KINDS, [("def count", 4)], 5),
		doc(s, "Open.v3", OPEN, [("Registry.count", 9)], 5),
		doc(s, "Uses.v3", USES, [("Registry.count", 9)], 5)]));
	// A field of a generic class.
	roundTrip(t, s, "Kinds.v3", "var item", 4, "item", "held", join([
		doc(s, "Kinds.v3", KINDS, [("var item", 4), ("return item", 7)], 4),
		doc(s, "Uses.v3", USES, [("h.item", 2)], 4)]));
	// Methods: a class's, and a generic class's.
	roundTrip(t, s, "Kinds.v3", "def scale", 4, "scale", "resize", join([
		doc(s, "Kinds.v3", KINDS, [("def scale", 4)], 5),
		doc(s, "Uses.v3", USES, [("s.scale", 2)], 5)]));
	roundTrip(t, s, "Kinds.v3", "def get", 4, "get", "fetch", join([
		doc(s, "Kinds.v3", KINDS, [("def get", 4)], 3),
		doc(s, "Uses.v3", USES, [("get()", 0)], 3)]));
	s.server.close();
}
def test_classes_and_components(t: Tester) {
	var s = kindsSession(t);
	// "this" and the default constructor's ".new" resolve to the class
	// without naming it: they are not edited, and still bind to it after.
	roundTrip(t, s, "Kinds.v3", "class Shape", 6, "Shape", "Figure", join([
		doc(s, "Kinds.v3", KINDS, [("class Shape", 6), ("self() -> Shape", 10), ("int) -> Shape", 8), ("return Shape.new", 7)], 5),
		doc(s, "Open.v3", OPEN, [("s: Shape", 3)], 5),
		doc(s, "Uses.v3", USES, [("s: Shape", 3), ("<Shape>", 1)], 5)]));
	roundTrip(t, s, "Open.v3", "+ Registry", 2, "Registry", "Catalog", join([
		doc(s, "Kinds.v3", KINDS, [("component Registry", 10)], 8),
		doc(s, "Open.v3", OPEN, [("+ Registry", 2)], 8),
		doc(s, "Uses.v3", USES, [("(Registry", 1)], 8)]));
	roundTrip(t, s, "Kinds.v3", "class Holder", 6, "Holder", "Box", join([
		doc(s, "Kinds.v3", KINDS, [("class Holder", 6)], 6),
		doc(s, "Uses.v3", USES, [("Holder<", 0)], 6)]));
	s.server.close();
}
def test_enums_and_variants(t: Tester) {
