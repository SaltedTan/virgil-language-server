// A class parameter and its field share a name token, and so do a data
// type's parameters and fields; one token is renamed, with the uses of both.
def test_shared_name_tokens(t: Tester) {
	var shared = "class Point(var x: int) {\n\tdef get() -> int { return x; }\n}\ntype Size(w: int, h: int) { }\ncomponent Geo {\n\tdef area(s: Size, p: Point) -> int { return s.w * s.h + p.x; }\n\tdef make() -> Point { return Point.new(1); }\n}\n";
	var s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", single("Shared.v3")), ("Shared.v3", shared)], true, null, t);
	s.open("Shared.v3", 1, shared);
	s.settle();
	roundTrip(t, s, "Shared.v3", "p.x", 2, "x", "px",
		doc(s, "Shared.v3", shared, [("var x", 4), ("return x", 7), ("p.x", 2)], 1));
	roundTrip(t, s, "Shared.v3", "Size(w", 5, "w", "width",
		doc(s, "Shared.v3", shared, [("Size(w", 5), ("s.w", 2)], 1));
	roundTrip(t, s, "Shared.v3", "type Size", 5, "Size", "Extent",
		doc(s, "Shared.v3", shared, [("type Size", 5), ("s: Size", 3)], 4));
	s.server.close();
}
// Rename selects the name with prepareRename's rules, so it refuses what
// prepareRename refuses, with the same reason: navigation aliases, packings
// and their parameters, constructors, builtins, and keywords.
def test_refuses_what_prepare_refuses(t: Tester) {
	var s = kindsSession(t);
	var cases = [("Kinds.v3", "return this", 7), ("Kinds.v3", "packing Pair", 8), ("Kinds.v3", "Pair(a", 5),
		("Kinds.v3", "Shape.new", 6), ("Uses.v3", "text.length", 5), ("Kinds.v3", "def scale", 1),
		("Kinds.v3", "(sides: int", 8), ("Uses.v3", "x++", 2)];
	for (c in cases) {
		var p = at(s.text(c.0), c.1, c.2);
		t.assert(p.line >= 0, "fixture text found");
		var prepare = s.send(t, "textDocument/prepareRename", s.params(c.0, p.line, p.character));
		var id = s.rename(t, c.0, p.line, p.character, "renamed");
		s.settle();
		var r = s.reply(prepare);
		t.assert(r != null && r.has("error"), Strings.format1("prepareRename refuses %s", c.1));
		if (r == null || !r.has("error")) continue;
		expectFailed(t, s, id, stringAt(r["error"], "message"));
	}
	t.asserti(0, s.server.rename.checked);
	s.server.close();
}
// A new name equal to the current one needs no edit and no preflight.
def test_same_name(t: Tester) {
	var s = kindsSession(t);
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, "area");
	t.assert(s.reply(id) != null, "answered at once");
	var result = s.result(t, id);
	t.assertz(true, JsonValue.JArray.?(member(result, "documentChanges")));
	t.asserti(0, array(member(result, "documentChanges")).length);
	t.asserti(0, s.server.rename.checked);
	s.server.close();
}
// HIERARCHY's methods share no name, so each is eligible, but a method given
// another method's name may start to override it or be overridden by it, with
// every use bound as before: renaming Base.foo to bar would make use(c) call
// Child.bar. The analysis has no class hierarchy, so a method is refused a
// name that any other method has, in any class or component.
def HIERARCHY = "class Base {\n\tvar count: int;\n\tdef foo() -> int { return 1; }\n}\nclass Child extends Base {\n\tvar size: int;\n\tdef bar() -> int { return 2; }\n}\ncomponent Util {\n\tdef helper() -> int { return 3; }\n}\ncomponent Main {\n\tdef use(b: Base) -> int { return b.foo() + b.count; }\n\tdef main() -> int { var c = Child.new(); return use(c) + c.bar() + c.size + Util.helper(); }\n}\n";
def hierarchySession(t: Tester) -> RenameTestSession {
	var s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", single("Hierarchy.v3")), ("Hierarchy.v3", HIERARCHY)], true, null, t);
	s.open("Hierarchy.v3", 1, HIERARCHY);
	s.settle();
	return s;
}
def test_same_named_methods(t: Tester) {
	var s = hierarchySession(t);
	var reason = "cannot rename '%s' to '%s': another method is named '%s', and the analysis cannot rule out an override";
	// A base method renamed to a subclass method's name would be overridden.
	s.refused(t, "Hierarchy.v3", "def foo", 4, "bar", Strings.format3(reason, "foo", "bar", "bar"));
	// A subclass method renamed to a base method's name would override it.
	s.refused(t, "Hierarchy.v3", "c.bar", 2, "foo", Strings.format3(reason, "bar", "foo", "foo"));
	// A component's method, which nothing overrides, is refused the same way.
	s.refused(t, "Hierarchy.v3", "def helper", 4, "foo", Strings.format3(reason, "helper", "foo", "foo"));
	t.asserti(0, s.server.rename.checked);
	// A name that no method has is eligible.
	roundTrip(t, s, "Hierarchy.v3", "def foo", 4, "foo", "baz",
		doc(s, "Hierarchy.v3", HIERARCHY, [("def foo", 4), ("b.foo", 2)], 3));
	s.server.close();
}
// A field and a method of one name in a class and its subclass fail to verify,
// in either order, so the preflight refuses them for their error: a field
// renamed to a subclass method's name or the reverse, a method renamed to a
// subclass field's name or the reverse, and a field renamed to a subclass
// field's name.
def test_members_across_subclasses(t: Tester) {
	var s = hierarchySession(t);
	var path = s.path("Hierarchy.v3");
	var cases = [
		("var count", 4, "count", "bar", "7:6: InheritanceError: cannot override non-method member"),
		("def bar", 4, "bar", "count", "7:6: InheritanceError: cannot override non-method member"),
		("def foo", 4, "foo", "size", "6:6: MemberRedefined: member \"size\" redefined"),
		("var size", 4, "size", "foo", "6:6: MemberRedefined: member \"foo\" redefined"),
		("var size", 4, "size", "count", "6:6: MemberRedefined: member \"count\" redefined")
	];
	for (c in cases) {
		s.refused(t, "Hierarchy.v3", c.0, c.1, c.3, Strings.format3("renaming '%s' to '%s' would cause an error at %s", c.2, c.3,
			Strings.format2("%s:%s", path, c.4)));
	}
	t.asserti(0, s.server.rename.checked);
	s.server.close();
}
// Ranges count UTF-16 code units: a non-ASCII string before the renamed
// tokens on their line moves them by one unit for é and two for 😀, which
// UTF-8 encodes in two and four bytes.
def test_utf16_ranges(t: Tester) {
	var emoji = "component Emoji {\n\tdef run() -> int { var s = \"\xf0\x9f\x98\x80\xc3\xa9\"; var n = s.length; return n + n; }\n}\n";
	var s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", single("Emoji.v3")), ("Emoji.v3", emoji)], true, null, t);
	s.open("Emoji.v3", 1, emoji);
	s.settle();
	var edit = s.renamed(t, "Emoji.v3", "var n", 4, "total");
	t.assert_string("Emoji.v3@1: 1:39-40 1:60-61 1:64-65", render(s, edit, 0, false));
	s.server.close();
	s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", single("Emoji.v3")), ("Emoji.v3", emoji)], true, null, t);
	s.open("Emoji.v3", 1, emoji);
	s.settle();
	roundTrip(t, s, "Emoji.v3", "var n", 4, "n", "total",
		doc(s, "Emoji.v3", emoji, [("var n", 4), ("return n", 7), ("+ n", 2)], 1));
	s.server.close();
}
// The new name of a local hides a field that a later use in its scope reads:
// the program still verifies, but that use would bind to the local.
def test_capture_by_new_local(t: Tester) {
	var counter = "class Counter {\n\tvar count: int;\n\tdef bump() -> int {\n\t\tvar n = 1;\n\t\treturn n + count;\n\t}\n}\n";
	var s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", single("Counter.v3")), ("Counter.v3", counter)], true, null, t);
	s.open("Counter.v3", 1, counter);
	s.settle();
	s.refused(t, "Counter.v3", "var n", 4, "count", Strings.format1(
		"renaming 'n' to 'count' would make the use of another 'count' at %s:5:14 refer to the renamed declaration", s.path("Counter.v3")));
	t.asserti(0, s.server.rename.checked);
	s.server.close();
}
// The new name of a field is a local's that a method reads before the field:
// the field's renamed use would bind to the local.
def test_capture_by_existing_local(t: Tester) {
	var tally = "class Tally {\n\tvar total: int;\n\tdef sum() -> int {\n\t\tvar acc = 2;\n\t\treturn acc + total;\n\t}\n}\n";
	var s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", single("Tally.v3")), ("Tally.v3", tally)], true, null, t);
	s.open("Tally.v3", 1, tally);
	s.settle();
	s.refused(t, "Tally.v3", "var total", 4, "acc", Strings.format1(
		"renaming 'total' to 'acc' would make the use at %s:5:16 refer to another declaration", s.path("Tally.v3")));
	s.server.close();
}
// A new name already declared in the same scope makes the program fail to
// verify, and the first error is the reason. It is never published.
def test_duplicate_names(t: Tester) {
	var pair = "class Pair {\n\tvar left: int;\n\tvar right: int;\n\tdef sum() -> int {\n\t\tvar a = left;\n\t\tvar b = right;\n\t\treturn a + b;\n\t}\n}\n";
	var s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", single("Pair.v3")), ("Pair.v3", pair)], true, null, t);
	s.open("Pair.v3", 1, pair);
	s.settle();
	var published = s.notifications.length;
	s.refused(t, "Pair.v3", "var a", 4, "b", Strings.format1(
		"renaming 'a' to 'b' would cause an error at %s:6:7: VarDeclError: variable \"b\" redefined", s.path("Pair.v3")));
	s.refused(t, "Pair.v3", "var left", 4, "right", Strings.format1(
		"renaming 'left' to 'right' would cause an error at %s:3:6: MemberRedefined: member \"right\" redefined", s.path("Pair.v3")));
	t.asserti(published, s.notifications.length);
	s.server.close();
}
// The new name must be an identifier as Aeneas lexes it, and not a keyword
// or "this".
def test_invalid_names(t: Tester) {
	var s = kindsSession(t);
	var syntax = "'%s' is not a Virgil identifier: it must start with an ASCII letter, followed by ASCII letters, digits, or underscores";
	var p = at(KINDS, "var area", 4);
	for (name in ["2x", "_x", "a-b", "a b", "caf\xc3\xa9", "x.y"]) {
		var id = s.rename(t, "Kinds.v3", p.line, p.character, name);
		expectFailed(t, s, id, Strings.format1(syntax, name));
	}
	var id = s.rename(t, "Kinds.v3", p.line, p.character, "");
	expectFailed(t, s, id, "the new name is empty");
	for (name in ["if", "class", "this", "true", "null", "packing", "var", "super", "layout"]) {
		id = s.rename(t, "Kinds.v3", p.line, p.character, name);
		expectFailed(t, s, id, Strings.format1("'%s' is a reserved word in Virgil and cannot be a name", name));
	}
	// Underscores and digits after the first letter are allowed.
	roundTrip(t, s, "Kinds.v3", "var area", 4, "area", "a_2", join([
		doc(s, "Kinds.v3", KINDS, [("var area", 4), ("= area", 2)], 4),
		doc(s, "Open.v3", OPEN, [("s.area", 2)], 4),
		doc(s, "Uses.v3", USES, [("().area", 3)], 4)]));
	s.server.close();
}
// A new name is at most LspRenameNames.MAX_LENGTH bytes. A longer one is
// refused on arrival, and leaves no rename pending.
def test_name_length(t: Tester) {
	var s = kindsSession(t);
	var name = Array<byte>.new(LspRenameNames.MAX_LENGTH + 1);
	for (i < name.length) name[i] = 'a';
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, name);
	expectFailed(t, s, id, Strings.format1("the new name is longer than %d bytes", LspRenameNames.MAX_LENGTH));
	var longest = Arrays.range(name, 0, LspRenameNames.MAX_LENGTH);
	roundTrip(t, s, "Kinds.v3", "var item", 4, "item", longest, join([
		doc(s, "Kinds.v3", KINDS, [("var item", 4), ("return item", 7)], 4),
		doc(s, "Uses.v3", USES, [("h.item", 2)], 4)]));
	s.server.close();
}
def test_invalid_name_while_waiting(t: Tester) {
	var s = kindsSession(t);
	s.change("Kinds.v3", 3, Arrays.concat(KINDS, "\n"));
	var p = at(KINDS, "var area", 4), invalid = s.rename(t, "Kinds.v3", p.line, p.character, "while");
	expectFailed(t, s, invalid, "'while' is a reserved word in Virgil and cannot be a name");
	t.asserti(0, s.server.rename.requests.waiting());
	t.asserti(0, s.server.rename.requests.recorded());
	t.assert(s.server.projects.renameSnapshot == null, "an invalid name retains no snapshot");
	var valid = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	t.assert(s.reply(valid) == null, "the valid rename waits for analysis");
	t.asserti(1, s.server.rename.requests.waiting());
	s.settle();
	var edit = s.result(t, valid);
	t.assert_string(join([
		doc(s, "Kinds.v3", KINDS, [("var area", 4), ("= area", 2)], 4),
		doc(s, "Open.v3", OPEN, [("s.area", 2)], 4),
		doc(s, "Uses.v3", USES, [("().area", 3)], 4)]), render(s, edit, 0, false));
	t.asserti(1, s.server.rename.checked);
	t.asserti(1, s.count(invalid));
	t.asserti(1, s.count(valid));
	s.server.close();
}
def test_parse_and_semantic_errors(t: Tester) {
	var s = kindsSession(t);
	var broken = "component Opened {\n\tdef measure(s: Shape) -> int { return s.area + missing; }\n}\n";
	s.change("Open.v3", 2, broken);
	s.settle();
	s.refused(t, "Kinds.v3", "var area", 4, "surface", "the project's analysis has errors; rename needs a program that verifies");
	s.change("Open.v3", 3, "component Opened {\n");
	s.settle();
	s.refused(t, "Kinds.v3", "var area", 4, "surface", "the project's analysis has parse errors");
	s.change("Open.v3", 4, OPEN);
	s.settle();
	roundTrip(t, s, "Kinds.v3", "var item", 4, "item", "held", join([
		doc(s, "Kinds.v3", KINDS, [("var item", 4), ("return item", 7)], 4),
		doc(s, "Uses.v3", USES, [("h.item", 2)], 4)]));
	s.server.close();
}
// Neither a dependency nor a library under the Virgil root is edited.
def test_dependency_and_virgil_root(t: Tester) {
	var main = "class Widget { }\n";
	var use = "component Use { def get() -> Widget { return Widget.new(); } }\n";
	var lib = "component Lib { def make() -> Widget { return Widget.new(); } }\n";
	var s = RenameTestSession.new("rename-deps", [("Main.v3", main), ("Use.v3", use), ("dep/Lib.v3", lib)], true, null, t);
	s.open("Main.v3", 1, main);
	s.settle();
	s.refused(t, "Main.v3", "class Widget", 6, "Gadget", "cannot rename 'Widget': a use is in a dependency, not in the project's own sources");
	s.open("dep/Lib.v3", 1, lib);
	s.settle();
	s.refused(t, "dep/Lib.v3", "component Lib", 10, "Library", "cannot rename 'Lib': it is declared in a dependency, not in the project's own sources");
	s.server.close();
	var rooted = "component Main { def four() -> int { return Lib.twice(2); } }\n";
	var r = RenameTestSession.new("rename-root", [("Main.v3", rooted)], true, null, t);
	r.server.projects.virgilRoot = r.path("vroot");
	r.open("Main.v3", 1, rooted);
	r.settle();
	r.refused(t, "Main.v3", "Lib.twice", 4, "double", "cannot rename 'twice': it is declared in a dependency, not in the project's own sources");
	r.refused(t, "Main.v3", "Lib.twice", 0, "Library", "cannot rename 'Lib': it is declared in a dependency, not in the project's own sources");
	r.server.close();
}
// Without versioned edits, a client could apply an edit to a document that
// changed since it was planned.
def test_no_document_changes(t: Tester) {
	var s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", CONFIG), ("Kinds.v3", KINDS),
		("Open.v3", OPEN), ("Uses.v3", USES)], false, null, t);
	s.open("Kinds.v3", 1, KINDS);
	s.settle();
	s.refused(t, "Kinds.v3", "var area", 4, "surface",
		"rename needs a client that accepts versioned edits (workspace.workspaceEdit.documentChanges), so that an edit to a changed document is refused");
	// Eligibility comes first, with prepareRename's reason.
	s.refused(t, "Kinds.v3", "return this", 7, "that", "'this' is a navigation alias for the class 'Shape'; rename the class at its declaration");
	s.server.close();
}
def test_closed_request(t: Tester) {
	var s = kindsSession(t), p = at(USES, "var x", 4);
	for (busy in [false, true]) {
		if (busy) s.server.rename.scheduler.schedule([s.server.projects.forDocument(s.uri("Kinds.v3")).active], false);
		var id = s.rename(t, "Uses.v3", p.line, p.character, "count");
		expectFailed(t, s, id, "open the document to rename from it");
		id = s.send(t, "textDocument/prepareRename", s.params("Uses.v3", p.line, p.character));
		expectFailed(t, s, id, "open the document to rename from it");
	}
	s.write(t, "Uses.v3", Arrays.concat(USES, "\n"));
	s.settle();
	t.asserti(0, s.server.rename.checked);
	s.server.close();
}
def test_closed_while_waiting(t: Tester) {
	for (reopen in [false, true]) {
		var s = kindsSession(t), p = at(KINDS, "var area", 4);
		s.change("Kinds.v3", 3, Arrays.concat(KINDS, "\n"));
		var id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
		var prepare = s.send(t, "textDocument/prepareRename", s.params("Kinds.v3", p.line, p.character));
		t.assert(s.reply(id) == null && s.reply(prepare) == null, "both requests wait for analysis");
		s.closeDocument("Kinds.v3");
		if (reopen) s.open("Kinds.v3", 3, Arrays.concat(KINDS, "\n"));
		s.settle();
		expectFailed(t, s, id, "the document changed while the rename request waited");
		expectFailed(t, s, prepare, "the document changed while the rename request waited");
		t.asserti(0, s.server.rename.checked);
		s.server.close();
	}
}
def test_replaced_context_while_waiting(t: Tester) {
	var config = "{\"version\":1,\"projects\":[{\"name\":\"a\",\"sources\":[\"Kinds.v3\"]},{\"name\":\"b\",\"sources\":[\"Other.v3\"]}]}";
	var source = "component A { def get() -> int { var x = 1; return x; } }\n";
	var s = RenameTestSession.new("rename-edits", [(".virgil-lsp.json", config), ("Kinds.v3", source),
		("Other.v3", "component B { }\n")], true, null, t);
	s.open("Kinds.v3", 1, source);
	s.settle();
	var projects = s.server.projects, scheduler = s.server.rename.scheduler;
	var a = projects.forDocument(s.uri("Kinds.v3")).active;
	var b = projects.forDocument(s.uri("Other.v3")).active;
	scheduler.schedule([a], false);
	s.settle();
	var original = a.snapshot, generation = original.generation;
	t.assert(s.supervisor.snapshot == original, "A is the latest analysis");
	scheduler.schedule([b], false);
	t.assert(s.supervisor.busy(), "B occupies the worker");
	var p = at(source, "var x", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, "value");
	t.assert(s.reply(id) == null, "the rename preflight waits behind B");
	s.write(t, ".virgil-lsp.json", Arrays.concat(config, "\n"));
	s.reportChanged(".virgil-lsp.json");
	t.assertz(false, a.config.current);
	expectFailed(t, s, id, "the documents changed while the rename was checked");
	t.assert(projects.renameSnapshot == null, "a retired context releases its pin before the worker completes");
	s.settle();
	t.asserti(1, s.count(id));
	t.asserti(0, s.server.rename.checked);
	t.asserti(generation + 3, s.supervisor.snapshot.generation);
	s.server.close();
}
def test_replaced_context_during_preflight(t: Tester) {
	for (watched in [false, true]) {
		var s = kindsSession(t), p = at(KINDS, "var area", 4);
		var id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
		t.assert(s.server.projects.renameSnapshot != null, "the running rename pins its original");
		s.write(t, ".virgil-lsp.json", Arrays.concat(CONFIG, "\n"));
		if (watched) {
			s.reportChanged(".virgil-lsp.json");
			expectFailed(t, s, id, "the documents changed while the rename was checked");
			t.assert(s.server.projects.renameSnapshot == null, "retirement ends the running rename immediately");
		}
		s.settle();
		expectFailed(t, s, id, "the documents changed while the rename was checked");
		t.asserti(1, s.count(id));
		t.assert(s.server.projects.renameSnapshot == null, "completion cannot retain the retired plan");
		s.server.close();
	}
}
def snapshotBudget(t: Tester, s: RenameTestSession) {
	var latest = s.supervisor.snapshot, pinned = s.server.projects.renameSnapshot;
	var retained = if(latest != null, latest.retainedBytes, 0L);
	if (pinned != null && pinned != latest) retained += pinned.retainedBytes;
	for (ctx in s.server.projects.loadedContexts()) {
		var snapshot = ctx.snapshot;
		if (snapshot != null && snapshot != latest && snapshot != pinned) retained += snapshot.retainedBytes;
	}
	t.assert(retained <= s.server.projects.MAX_SNAPSHOT_BYTES, "all retained snapshots fit the shared budget");
}
def test_cancelled_preflight_snapshot_budget(t: Tester) {
	var sourceA = "component A { def get() -> int { var x = 1; return x; } }\n";
	var sourceB = "component B { def get() -> int { var x = 2; return x; } }\n";
	var s = RenameTestSession.new("rename-budget", [
		(".virgil-lsp.json", "{\"version\":1,\"projects\":[]}"),
		("a/.virgil-lsp.json", single("A.v3")), ("a/A.v3", sourceA),
		("b/.virgil-lsp.json", single("B.v3")), ("b/B.v3", sourceB),
		("c/.virgil-lsp.json", single("C.v3")), ("c/C.v3", "component C { }\n")], true, null, t);
	s.open("a/A.v3", 1, sourceA);
	s.open("b/B.v3", 1, sourceB);
	s.settle();
	var projects = s.server.projects, scheduler = s.server.rename.scheduler;
	var a = projects.forDocument(s.uri("a/A.v3")).active;
	var b = projects.forDocument(s.uri("b/B.v3")).active;
	var c = projects.forDocument(s.uri("c/C.v3")).active;
	scheduler.schedule([a, b], false);
	s.settle();
	var original = a.snapshot, latest = b.snapshot, oldC = c.snapshot;
	t.assert(s.supervisor.snapshot == latest, "B is latest before the cancelled preflight");
	var p = at(sourceB, "var x", 4), cancelled = s.rename(t, "b/B.v3", p.line, p.character, "next");
	t.assert(s.supervisor.busy(), "B's preflight occupies the worker");
	t.assert(projects.renameSnapshot == latest, "B pins its original");
	s.cancel(cancelled);
	t.asserti(LspErrorCode.REQUEST_CANCELLED, intAt(s.reply(cancelled)["error"], "code"));
	t.assert(projects.renameSnapshot == null, "cancelling B releases its pin");
	p = at(sourceA, "var x", 4);
	var id = s.rename(t, "a/A.v3", p.line, p.character, "value");
	t.assert(s.reply(id) == null, "A waits behind the cancelled preflight");
	t.assert(projects.renameSnapshot == original, "A pins its original while queued");
	original.retainedBytes = 9L * 1024 * 1024;
	latest.retainedBytes = 8L * 1024 * 1024;
	a.snapshot = null;
	var incoming = long.view(AnalysisWire.MAX_RESULT_ALLOCATION) + 1024;
	t.assertz(false, projects.admitSnapshot(c, latest, incoming));
	t.assert(projects.renameSnapshot == original, "admission cannot evict a detached original");
	var params = Strings.newMap<JsonValue>();
	params["uris"] = JsonValue.JArray([JsonValue.String(s.uri("c/C.v3"))]);
	var development = s.send(t, "virgil-lsp/analyze", params);
	var error = s.reply(development)["error"];
	t.asserti(JsonRpcErrorCode.INVALID_PARAMS, intAt(error, "code"));
	t.assert_string("retained analysis snapshots exceed the workspace budget", stringAt(error, "message"));
	snapshotBudget(t, s);
	scheduler.schedule([c], false);
	s.write(t, "a/.virgil-lsp.json", Arrays.concat(single("A.v3"), "\n"));
	s.reportChanged("a/.virgil-lsp.json");
	expectFailed(t, s, id, "the documents changed while the rename was checked");
	t.assert(projects.renameSnapshot == null, "retirement releases A before another project's admission");
	t.assert(s.supervisor.busy(), "the cancelled preflight has not completed yet");
	t.assertz(true, projects.admitSnapshot(c, latest, incoming));
	var fds = Array<int>.new(4);
	while (s.server.analyzing()) {
		var count = s.supervisor.pollFds(fds, 0);
		HostOs.poll(fds, count, s.server.pollTimeout());
		s.server.onPoll();
		snapshotBudget(t, s);
	}
	t.assert(c.snapshot != oldC && c.snapshot != null && c.snapshot.verified, "C is admitted and analyzed after the cancelled preflight");
	t.asserti(1, s.count(cancelled));
	t.asserti(1, s.count(id));
	t.asserti(0, s.server.rename.checked);
	s.server.close();
}
def test_changed_while_waiting(t: Tester) {
	var s = kindsSession(t);
	var edited = Arrays.concat(KINDS, "\n");
	s.change("Kinds.v3", 3, edited);
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	t.assert(s.reply(id) == null, "the rename waits for the analysis");
	s.change("Kinds.v3", 4, KINDS);
	s.settle();
	expectFailed(t, s, id, "the document changed while the rename request waited");
	t.asserti(0, s.server.rename.checked);
	// Once analyzed, the same rename succeeds.
	roundTrip(t, s, "Kinds.v3", "var area", 4, "area", "surface", join([
		doc(s, "Kinds.v3", KINDS, [("var area", 4), ("= area", 2)], 4),
		doc(s, "Open.v3", OPEN, [("s.area", 2)], 4),
		doc(s, "Uses.v3", USES, [("().area", 3)], 4)]));
	s.server.close();
}
// An edit while the preflight runs refuses the rename, which describes the
// text before it; no subset of the edits is returned.
def test_changed_while_checked(t: Tester) {
	var s = kindsSession(t);
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	t.assert(s.reply(id) == null, "the rename waits for its preflight");
	s.change("Open.v3", 2, Arrays.concat(OPEN, "\n"));
	s.settle();
	expectFailed(t, s, id, "the documents changed while the rename was checked");
	t.asserti(1, s.server.rename.checked);
	s.server.close();
}
// A closed file changed on disk without a file event while the preflight
// runs: its stamp is current, but its bytes are not the ones analyzed.
def test_closed_file_changed_while_checked(t: Tester) {
	var s = kindsSession(t);
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	s.write(t, "Uses.v3", Arrays.concat(USES, "\n"));
	s.settle();
	expectFailed(t, s, id, "the documents changed while the rename was checked");
	// Before the next preflight, the bytes no longer match the analysis.
	id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	s.settle();
	expectFailed(t, s, id, Strings.format1("the project's analysis is stale: the bytes of %s changed since it was analyzed", s.path("Uses.v3")));
	s.server.close();
}
// A snapshot that is stale with no analysis pending, after a failed
// analysis, is refused at once, as prepareRename refuses it.
def test_stale_snapshot(t: Tester) {
	var s = kindsSession(t);
	s.limits.timeoutMs = 0;
	s.change("Open.v3", 2, Arrays.concat(OPEN, "\n"));
	s.settle();
	s.limits.timeoutMs = 10000;
	s.refused(t, "Kinds.v3", "var area", 4, "surface", "the project's analysis is stale; it does not describe the current sources");
	s.server.close();
}
// A preflight that the worker does not finish in time refuses the rename.
def test_preflight_time_limit(t: Tester) {
	var s = kindsSession(t);
	s.limits.timeoutMs = 0;
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	s.settle();
	var r = s.reply(id);
	t.assert(r != null && r.has("error"), "the rename was refused");
	if (r != null && r.has("error")) {
		t.asserti(LspErrorCode.REQUEST_FAILED, intAt(r["error"], "code"));
		var message = stringAt(r["error"], "message");
		t.assert(Strings.startsWith(message, "the rename could not be checked: the analysis worker timed out"), message);
	}
	t.assert(s.server.projects.renameSnapshot == null, "timeout releases the snapshot pin");
	s.limits.timeoutMs = 10000;
	roundTrip(t, s, "Kinds.v3", "var item", 4, "item", "held", join([
		doc(s, "Kinds.v3", KINDS, [("var item", 4), ("return item", 7)], 4),
		doc(s, "Uses.v3", USES, [("h.item", 2)], 4)]));
	s.server.close();
}
// The number of publishDiagnostics notifications {s} has received.
def publications(s: RenameTestSession) -> int {
	var n = 0;
	for (i < s.notifications.length) {
		if (Strings.equal("textDocument/publishDiagnostics", stringAt(JsonValue.JObject(s.notifications[i]), "method"))) n++;
	}
	return n;
}
// A preflight that fails in the worker refuses its rename once, with the
// failure's reason, and keeps the context's and the supervisor's snapshots
// and the published diagnostics; the replaced worker checks the next rename.
// The unit-test executable is the worker: it analyzes sources as the real one
// does, but fails an analysis whose sources spell {newName}.
def preflightFails(t: Tester, newName: string, reason: string) {
	var s = kindsSessionOn(HostOs.executablePath(), t);
	var ctx = s.server.projects.forDocument(s.uri("Kinds.v3")).active, snapshot = ctx.snapshot;
	var latest = s.supervisor.snapshot, published = publications(s), started = s.supervisor.workersStarted;
	t.assert(snapshot != null && snapshot.verified, "the synthetic worker analyzed the project");
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, newName);
	s.settle();
	t.assert(s.server.projects.renameSnapshot == null, "worker failure releases the snapshot pin");
	t.asserti(1, s.count(id));
	var r = s.reply(id);
	t.assert(r != null && r.has("error"), "the rename was refused");
	if (r != null && r.has("error")) {
		t.asserti(LspErrorCode.REQUEST_FAILED, intAt(r["error"], "code"));
		var message = stringAt(r["error"], "message");
		t.assert(Strings.startsWith(message, Strings.format1("the rename could not be checked: %s", reason)), message);
	}
	t.asserti(0, s.server.rename.checked);
	t.assert(ctx.snapshot == snapshot, "the context keeps its snapshot");
	t.assert(s.supervisor.snapshot == latest, "the supervisor keeps its latest snapshot");
	t.asserti(published, publications(s));
	roundTrip(t, s, "Kinds.v3", "var area", 4, "area", "surface", join([
		doc(s, "Kinds.v3", KINDS, [("var area", 4), ("= area", 2)], 4),
		doc(s, "Open.v3", OPEN, [("s.area", 2)], 4),
		doc(s, "Uses.v3", USES, [("().area", 3)], 4)]));
	t.asserti(started + 1, s.supervisor.workersStarted);
	s.server.close();
}
// The worker ends during the preflight, so the supervisor reads the end of its
// result pipe.
def test_preflight_worker_crash(t: Tester) {
	preflightFails(t, SyntheticAnalysisWorker.CRASH, "the analysis worker crashed");
}
// The preflight's result exceeds the decoding budget.
def test_preflight_result_too_large(t: Tester) {
	preflightFails(t, SyntheticAnalysisWorker.TOO_LARGE, "the program is too large to analyze");
}
// One rename is checked at a time; a second is refused at once.
def test_concurrent(t: Tester) {
	var s = kindsSession(t);
	var p = at(KINDS, "var area", 4), first = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	var second = s.rename(t, "Kinds.v3", p.line, p.character, "region");
	expectFailed(t, s, second, "another rename is being checked; try again once it is answered");
	s.settle();
	var result = s.result(t, first);
	t.asserti(3, array(member(result, "documentChanges")).length);
	t.asserti(1, s.count(first));
	s.server.close();
}
// $/cancelRequest answers a pending rename with RequestCancelled at once,
// while it waits for an analysis or for its preflight, and nothing else.
def test_cancel(t: Tester) {
	var s = kindsSession(t);
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	s.cancel(id + 1000);
	t.assert(s.reply(id) == null, "another id cancels nothing");
	s.cancel(id);
	t.assert(s.server.projects.renameSnapshot == null, "cancellation releases the running plan's pin");
	var r = s.reply(id);
	t.assert(r != null && r.has("error"), "cancelled at once");
	if (r != null) t.asserti(LspErrorCode.REQUEST_CANCELLED, intAt(r["error"], "code"));
	// Another rename may start while the dropped preflight still runs.
	var next = s.rename(t, "Kinds.v3", p.line, p.character, "region");
	t.assert(s.server.projects.renameSnapshot != null, "the next rename owns its own pin");
	s.settle();
	t.assert(s.server.projects.renameSnapshot == null, "the next reply releases its pin");
	t.asserti(1, s.count(id));
	t.asserti(3, array(member(s.result(t, next), "documentChanges")).length);
	t.asserti(1, s.server.rename.checked);
	// While the rename waits for the analysis of an edit.
	s.change("Kinds.v3", 3, Arrays.concat(KINDS, "\n"));
	id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	s.cancel(id);
	t.asserti(LspErrorCode.REQUEST_CANCELLED, intAt(s.reply(id)["error"], "code"));
	s.settle();
	t.asserti(1, s.count(id));
	t.asserti(1, s.server.rename.checked);
	s.server.close();
}
// A cancelled rename that waited for an analysis keeps nothing: neither the
// waiting requests nor the rename hold it or its new name. More renames than
// the waiting bound are cancelled in turn while one analysis stays pending,
// each with the longest new name.
def test_cancelled_waiting_renames_are_released(t: Tester) {
	var s = kindsSession(t);
	var requests = s.server.rename.requests, name = Array<byte>.new(LspRenameNames.MAX_LENGTH);
	for (i < name.length) name[i] = 'a';
	s.change("Kinds.v3", 3, Arrays.concat(KINDS, "\n"));
	var p = at(KINDS, "var area", 4);
	for (k < requests.MAX_WAITING + 8) {
		var id = s.rename(t, "Kinds.v3", p.line, p.character, name);
		t.assert(s.reply(id) == null, "the rename waits for the analysis");
		t.asserti(1, requests.waiting());
		s.cancel(id);
		t.asserti(1, s.count(id));
		t.asserti(LspErrorCode.REQUEST_CANCELLED, intAt(s.reply(id)["error"], "code"));
		t.asserti(0, requests.waiting());
		t.asserti(0, requests.recorded());
	}
	s.settle();
	t.asserti(0, s.server.rename.checked);
	roundTrip(t, s, "Kinds.v3", "var item", 4, "item", "held", join([
		doc(s, "Kinds.v3", KINDS, [("var item", 4), ("return item", 7)], 4),
		doc(s, "Uses.v3", USES, [("h.item", 2)], 4)]));
	s.server.close();
}
// Shutdown answers a rename whose preflight runs with RequestCancelled.
def test_shutdown(t: Tester) {
	var s = kindsSession(t);
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	t.assert(s.server.projects.renameSnapshot != null, "the pending rename holds a pin");
	var shutdown = s.server.handle(JsonRpcMessage.Request(JsonRpcId.Int(1), "shutdown", JsonRpcParams.ByName(Strings.newMap<JsonValue>())).encode());
	t.assert(shutdown != null, "shutdown answered");
	t.assert(s.server.projects.renameSnapshot == null, "shutdown releases the snapshot pin");
	var r = s.reply(id);
	t.assert(r != null && r.has("error"), "the rename was cancelled");
	if (r != null) {
		t.asserti(LspErrorCode.REQUEST_CANCELLED, intAt(r["error"], "code"));
		t.assert_string("the server is shutting down", stringAt(r["error"], "message"));
	}
	t.asserti(1, s.count(id));
	s.server.close();
}
// A rename past either bound is refused whole, before its preflight.
def test_reply_bounds(t: Tester) {
	var s = kindsSession(t);
	s.server.rename.maxEdits = 4;
	roundTrip(t, s, "Kinds.v3", "var area", 4, "area", "surface", join([
		doc(s, "Kinds.v3", KINDS, [("var area", 4), ("= area", 2)], 4),
		doc(s, "Open.v3", OPEN, [("s.area", 2)], 4),
		doc(s, "Uses.v3", USES, [("().area", 3)], 4)]));
	s.server.rename.maxEdits = 3;
	s.refused(t, "Kinds.v3", "var area", 4, "surface", "renaming 'area' needs more than 3 edits");
	s.server.rename.maxEdits = LspReferences.MAX_LOCATIONS;
	// Two edits of Holder's field item: the document wrapper of each file,
	// its URI as JsonRpcJson.stringBytes counts it, and an edit's bytes.
	var newName = "held", edit = JsonRpcJson.stringBytes(newName) + s.server.rename.EDIT_BYTES;
	var need = 32 + JsonRpcJson.stringBytes(s.uri("Kinds.v3")) + s.server.rename.DOCUMENT_BYTES + 2 * edit
		+ JsonRpcJson.stringBytes(s.uri("Uses.v3")) + s.server.rename.DOCUMENT_BYTES + edit;
	s.server.rename.maxReplyBytes = need;
	roundTrip(t, s, "Kinds.v3", "var item", 4, "item", newName, join([
		doc(s, "Kinds.v3", KINDS, [("var item", 4), ("return item", 7)], 4),
		doc(s, "Uses.v3", USES, [("h.item", 2)], 4)]));
	s.server.rename.maxReplyBytes = need - 1;
	s.refused(t, "Kinds.v3", "var item", 4, newName, Strings.format1("the edits that rename 'item' need more than %d bytes", need - 1));
	s.server.close();
}
// The preflight's analysis is never the project's or the supervisor's
// snapshot, publishes nothing, and is not retained.
def test_preflight_is_not_kept(t: Tester) {
	var s = kindsSession(t);
	var ctx = s.server.projects.forDocument(s.uri("Kinds.v3")).active, snapshot = ctx.snapshot;
	var latest = s.supervisor.snapshot, published = s.notifications.length;
	var p = at(KINDS, "var area", 4), id = s.rename(t, "Kinds.v3", p.line, p.character, "surface");
	s.settle();
	t.asserti(3, array(member(s.result(t, id), "documentChanges")).length);
	t.assert(ctx.snapshot == snapshot, "the context keeps its snapshot");
	t.assert(s.supervisor.snapshot == latest, "the supervisor keeps its latest snapshot");
	t.asserti(published, s.notifications.length);
	s.server.close();
}
// A job queued behind a running analysis starts as soon as it ends, before a
// due context; one queued behind a job waits for a due context first.
def test_jobs_and_analyses_take_turns(t: Tester) {
	var s = kindsSession(t);
	var scheduler = s.server.rename.scheduler, ctx = s.server.projects.forDocument(s.uri("Kinds.v3")).active;
	var order = Vector<string>.new();
	var source = [AnalysisSource.new(s.path("Job.v3"), "component Job { }\n")];
	var job = fun (label: string) => LspAnalysisJob.new(
		fun (supervisor: AnalysisSupervisor) -> AnalysisOutcome {
			order.put(Strings.format2("%s after %d", label, ctx.snapshot.generation));
			return supervisor.beginTemporary(source, [], AnalysisWire.WANT_OCCURRENCES);
		},
		fun (outcome: AnalysisOutcome) { order.put(Strings.format1("%s done", label)); });
	var generation = ctx.snapshot.generation;
	// The first job starts at once; the context and the second job wait.
	t.assertz(true, scheduler.submit(job("one")));
	scheduler.schedule([ctx], false);
	t.assertz(true, scheduler.submit(job("two")));
	t.assertz(false, scheduler.submit(job("three")));
	s.settle();
	t.assert_string(Strings.format1("one after %d", generation), order[0]);
	t.assert_string("one done", order[1]);
	// The context's analysis came between the jobs.
	t.assert_string(Strings.format1("two after %d", generation + 2), order[2]);
	t.assert_string("two done", order[3]);
	t.asserti(4, order.length);
	// A job submitted while a context's analysis runs starts after it, before
	// another due context. Each analysis, a job's too, takes a generation.
	order.clear();
	generation = ctx.snapshot.generation + 1;
	scheduler.schedule([ctx], false);
	t.assertz(true, scheduler.submit(job("four")));
	scheduler.schedule([ctx], false);
	s.settle();
	t.assert_string(Strings.format1("four after %d", generation + 1), order[0]);
	t.assert_string("four done", order[1]);
	t.asserti(generation + 3, ctx.snapshot.generation);
	s.server.close();
}
def test_parameter_errors(t: Tester) {
	var s = kindsSession(t);
	var requires = "rename params require a valid textDocument.uri, position, and newName";
	var p = at(KINDS, "var area", 4), params = s.params("Kinds.v3", p.line, p.character);
	for (bad in [JsonValue.Null, JsonValue.Int(1), JsonValue.Bool(true)]) {
		params["newName"] = bad;
		var id = s.send(t, "textDocument/rename", params);
		t.asserti(JsonRpcErrorCode.INVALID_PARAMS, intAt(s.reply(id)["error"], "code"));
		t.assert_string(requires, stringAt(s.reply(id)["error"], "message"));
	}
	params.remove("newName");
	var id = s.send(t, "textDocument/rename", params);
	t.assert_string(requires, stringAt(s.reply(id)["error"], "message"));
	params = s.params("Kinds.v3", -1, 0);
	params["newName"] = JsonValue.String("surface");
	id = s.send(t, "textDocument/rename", params);
	t.asserti(JsonRpcErrorCode.INVALID_PARAMS, intAt(s.reply(id)["error"], "code"));
	t.assert_string(requires, stringAt(s.reply(id)["error"], "message"));
	// A parameter error leaves no rename pending.
	roundTrip(t, s, "Kinds.v3", "var item", 4, "item", "held", join([
		doc(s, "Kinds.v3", KINDS, [("var item", 4), ("return item", 7)], 4),
		doc(s, "Uses.v3", USES, [("h.item", 2)], 4)]));
	s.server.close();
}
// renameProvider has prepareProvider for a client with prepareSupport, and
// is true for one without, which RenameOptions may not be sent to.
def test_advertised(t: Tester) {
	var s = kindsSession(t);
	var init = JsonRpcJsonParser.new(s.initializeReply).parseDocument();
	var provider = member(member(member(init, "result"), "capabilities"), "renameProvider");
	t.assert(member(provider, "prepareProvider") == JsonValue.Bool(true), "prepareProvider is advertised");
	s.server.close();
	var server = LspServer.new(DocumentLimits.MAX_BYTES), params = Strings.newMap<JsonValue>();
	params["capabilities"] = JsonValue.JObject(Strings.newMap<JsonValue>());
	var reply = server.handle(JsonRpcMessage.Request(JsonRpcId.Int(0), "initialize", JsonRpcParams.ByName(params)).encode());
	var plain = JsonRpcJsonParser.new(reply).parseDocument();
	t.assert(member(member(member(plain, "result"), "capabilities"), "renameProvider") == JsonValue.Bool(true), "rename is advertised");
	server.close();
}
// A project file that selects only {name}.
def single(name: string) -> string {
	return Strings.format1("{\"version\":1,\"projects\":[{\"name\":\"e\",\"sources\":[\"%s\"]}]}", name);
}
