def T = UnitTests.register;
def X = [
	T("Formatting:enum_cases", enum_cases),
	T("Formatting:match_cases", match_cases),
	T("Formatting:case_arrow_line", case_arrow_line),
	T("Formatting:braces_on_continuations", braces_on_continuations),
	T("Formatting:fun_in_parentheses", fun_in_parentheses),
	T("Formatting:braceless_bodies", braceless_bodies),
	T("Formatting:continuations", continuations),
	T("Formatting:comments", comments),
	T("Formatting:block_comments", block_comments),
	T("Formatting:else_join", else_join),
	T("Formatting:brace_join", brace_join),
	T("Formatting:no_join", no_join),
	T("Formatting:lines", lines),
	T("Formatting:start_of_file", start_of_file),
	T("Formatting:end_of_file", end_of_file),
	T("Formatting:open_block_comment", open_block_comment),
	T("Formatting:crlf", crlf),
	T("Formatting:lone_cr", lone_cr),
	T("Formatting:comment_gap_edits", comment_gap_edits),
	T("Formatting:syntax_error", syntax_error),
	T("Formatting:parse_budget", parse_budget),
	T("Formatting:unindexed_source", unindexed_source),
	T("Formatting:growth", growth),
	T("Formatting:comment_lookahead_linear", comment_lookahead_linear),
	T("Formatting:unjoined_brace", unjoined_brace),
	T("Formatting:unjoined_ungrouped_fun_brace", unjoined_ungrouped_fun_brace),
	T("Formatting:unjoined_fun_inside_grouped_brace", unjoined_fun_inside_grouped_brace),
	T("Formatting:unjoined_fun_after_block_comment", unjoined_fun_after_block_comment),
	T("Formatting:joined_ungrouped_fun_brace", joined_ungrouped_fun_brace),
	T("Formatting:code_after_comment", code_after_comment),
	T("Formatting:block_comment_opener", block_comment_opener),
	T("Formatting:else_line", else_line),
	T("Formatting:inline_else", inline_else),
	T("Formatting:headers_after_inline_else", headers_after_inline_else),
	T("Formatting:header_after_else_on_comment_close", header_after_else_on_comment_close),
	T("Formatting:header_in_inline_else_block", header_in_inline_else_block),
	T("Formatting:fun_body_close", fun_body_close),
	T("Formatting:case_arrow_anchor", case_arrow_anchor),
	T("Formatting:foreach_initializer", foreach_initializer),
	T("Formatting:representation_hints", representation_hints),
	T("Formatting:control_keywords", control_keywords),
	T("Formatting:if_kinds", if_kinds),
	T("Formatting:colons", colons),
	T("Formatting:assignments", assignments),
	T("Formatting:layout_sizes", layout_sizes),
	T("Formatting:operator_members", operator_members),
	T("Formatting:arrows", arrows),
	T("Formatting:commas", commas),
	T("Formatting:braces", braces),
	T("Formatting:else_spacing", else_spacing),
	T("Formatting:empty_bodies", empty_bodies),
	T("Formatting:trailing_comments", trailing_comments),
	T("Formatting:comment_only_lines", comment_only_lines),
	T("Formatting:spacing_next_to_comments", spacing_next_to_comments),
	T("Formatting:spacing_keeps_line_breaks", spacing_keeps_line_breaks),
	T("Formatting:spacing_unchanged", spacing_unchanged),
	T("Formatting:spacing_crlf", spacing_crlf),
	T("Formatting:spacing_in_one_run", spacing_in_one_run),
	T("Formatting:corpus_if_kinds", corpus_if_kinds),
	T("Formatting:first_change", first_change),
	()
];
def PATH = "format.v3";
def OPTIONS = ["-lang:fun-exprs"];
def ONE = AnalysisFormatEnd.ONE;
def MIRROR = AnalysisFormatEnd.MIRROR;

// Formats {input} in both modes, which agree for a text that ends with a
// line end or inside a block comment.
def both(t: Tester, input: string, expected: string) -> Array<AnalysisTextEdit> {
	format(t, MIRROR, input, expected);
	return format(t, ONE, input, expected);
}
def format(t: Tester, eof: AnalysisFormatEnd, input: string, expected: string) -> Array<AnalysisTextEdit> {
	return formatWithOptions(t, eof, input, expected, OPTIONS);
}
// The shared check of every case: applying the edits gives {expected};
// formatting that again gives no edits; the tokens and comments, less the
// trailing whitespace after a line comment, are unchanged; the edits are
// sorted, don't overlap, replace only whitespace with whitespace, and never
// start or end between a CR and its LF; and the reported size, count, and
// first change match the output.
def formatWithOptions(t: Tester, eof: AnalysisFormatEnd, input: string, expected: string, options: Array<string>) -> Array<AnalysisTextEdit> {
	var r = AeneasAdapter.formatting(PATH, input, options, eof);
	if (r.refusal != null) {
		t.fail1("refused: %s", r.refusal);
		return null;
	}
	t.assert(r.kind == AnalysisFormatRefusal.NONE, "a formatted result's kind is NONE");
	t.assertl(expected.length, r.size());
	var first = 0;
	while (first < input.length && first < expected.length && input[first] == expected[first]) first++;
	if (first == input.length && first == expected.length) first = -1;
	else if (splits(input, first)) first--;
	t.asserti(first, r.firstChange());
	var count = r.editCount(), edits = r.edits();
	if (edits == null) {
		t.fail("formatting produced no edit array");
		return null;
	}
	t.asserti(count, edits.length);
	t.asserti(first, if(edits.length == 0, -1, edits[0].begin));
	var output = apply(t, input, edits);
	if (output == null) return edits;
	t.assert_string(expected, output);
	var again = AeneasAdapter.formatting(PATH, output, options, eof);
	t.assert(again.refusal == null, "the output parses");
	t.asserti(0, again.editCount());
	t.asserti(-1, again.firstChange());
	t.assertl(output.length, again.size());
	var repeated = again.edits();
	t.assert(repeated != null && repeated.length == 0, "the second pass produces an empty edit array");
	var a = items(input, options), b = items(output, options);
	t.asserti(a.length, b.length);
	for (i < a.length) {
		if (i < b.length) t.assert_string(a[i], b[i]);
	}
	return edits;
}
def apply(t: Tester, input: string, edits: Array<AnalysisTextEdit>) -> string {
	var out = StringBuilder.new(), pos = 0;
	for (i < edits.length) {
		var e = edits[i];
		t.assert(e.begin >= pos && e.begin <= e.end && e.end <= input.length, Strings.format2("edit %d at %d is out of order", i, e.begin));
		if (i > 0) t.assert(e.begin > edits[i - 1].begin, "edits are sorted");
		for (j = e.begin; j < e.end; j++) t.assert(whitespace(input[j]), Strings.format1("edit %d replaces more than whitespace", i));
		for (c in e.text) t.assert(whitespace(c), Strings.format1("edit %d inserts more than whitespace", i));
		t.assert(!splits(input, e.begin) && !splits(input, e.end), Strings.format1("edit %d splits a CR LF", i));
		if (e.begin < pos) return null; // reported above
		out.putk(input, pos, e.begin);
		out.puts(e.text);
		pos = e.end;
	}
	out.putk(input, pos, input.length);
	return out.toString();
}
def whitespace(c: byte) -> bool {
	return c == ' ' || c == '\t' || c == '\r' || c == '\n';
}
def splits(input: string, at: int) -> bool {
	return at > 0 && at < input.length && input[at - 1] == '\r' && input[at] == '\n';
}
// The parser's tokens and the comments between them, each line comment
// without its trailing whitespace.
def items(text: string, options: Array<string>) -> Array<string> {
	var input = AeneasAdapter.normalizedRange(text, 0, text.length);
	var syntax = SymbolSyntaxIndex.new(), errors = AnalysisParseErrors.new(AeneasAdapter.MAX_ERRORS);
	AeneasAdapter.setLanguageOptions(options);
	AnalysisSingleFileParser.parse(PATH, input, errors, syntax, TypeCache.new(), null);
	AeneasAdapter.resetLanguageOptions();
	var result = Vector<string>.new(), i = 0, k = 0, max = text.length;
	while (i < max) {
		if (k < syntax.count && syntax.begin(k) == i) {
			result.put(Arrays.range(text, i, syntax.end(k)));
			i = syntax.end(k);
			k++;
		} else if (whitespace(text[i])) {
			i++;
		} else if (text[i] == '/' && i + 1 < max && text[i + 1] == '/') {
			var e = i;
			while (e < max && text[e] != '\n') e++;
			var s = e;
			while (s > i && whitespace(text[s - 1])) s--;
			result.put(Arrays.range(text, i, s));
			i = e;
		} else if (text[i] == '/' && i + 1 < max && text[i + 1] == '*') {
			var e = i + 2;
			while (e < max && !(text[e] == '*' && e + 1 < max && text[e + 1] == '/')) e++;
			e = if(e < max, e + 2, max);
			result.put(Arrays.range(text, i, e));
			i = e;
		} else {
			result.put(Arrays.range(text, i, i + 1));
			i++;
		}
	}
	return result.extract();
}

def enum_cases(t: Tester) {
	// Commas are optional, so the parse tree says where each case starts.
	both(t, "enum E {\nA,\n  B,\n\t\tC\n\t}\nenum F(x: int) {\n   A(1)\nB(2), C(3)\n\t\tD(\n\t\t\t4)\n}\n",
		"enum E {\n\tA,\n\tB,\n\tC\n}\nenum F(x: int) {\n\tA(1)\n\tB(2), C(3)\n\tD(\n\t\t4)\n}\n");
	// A '}' after the last case is a block line.
	both(t, "enum E {\n\tA,\n\tB\n\t}\n", "enum E {\n\tA,\n\tB\n}\n");
}
def match_cases(t: Tester) {
	// Patterns on several lines are block lines; a comma in a case's
	// statement isn't a pattern's.
	both(t, "def f(x: int) {\n\tmatch (x) {\n\t\t1,\n\t\t  2,\n\t3 => return;\n\t\t4 => var a = 1,\n\t\t\tb = 2;\n   _ => ;\n\t}\n}\n",
		"def f(x: int) {\n\tmatch (x) {\n\t\t1,\n\t\t2,\n\t\t3 => return;\n\t\t4 => var a = 1,\n\t\t\tb = 2;\n\t\t_ => ;\n\t}\n}\n");
	// The default case after the braces, and match cases one tab in.
	both(t, "def f(x: int) {\n\tmatch (x) {\n\t1 => ;\n\t} else\n\tf(x);\n}\n",
		"def f(x: int) {\n\tmatch (x) {\n\t\t1 => ;\n\t} else\n\t\tf(x);\n}\n");
	both(t, "def f(x: int) {\n\tmatch (x) {\n\t\tx: Pair<\n\t\t\tint,\n\t\t\tint>,\n   A.B(a,\n\t\t\tb),\n -1,\n      y: _,\n  _\n\t\t=> ;\n\t}\n}\n",
		"def f(x: int) {\n\tmatch (x) {\n\t\tx: Pair<\n\t\t\tint,\n\t\t\tint>,\n\t\tA.B(a,\n\t\t\tb),\n\t\t-1,\n\t\ty: _,\n\t\t_\n\t\t\t=> ;\n\t}\n}\n");
}
def case_arrow_line(t: Tester) {
	// As aeneas/src/wasm/WasmGcLowering.v3:50: a case's "=>" that starts a
	// line is one tab deeper than the case and anchors its braced body.
	both(t, "def f(x: int) {\n\tmatch (x) {\n\t\t1, // one\n\t\t2 // two\n\t\t\t=> {\n\t\t\t\tx++;\n\t\t\t}\n\t\t3\n\t\t=> x--;\n\t\t4 =>\n\t\tx++;\n\t\t5\n\t\t=> {\n\t\t\tx++;\n\t\t}\n\t}\n}\n",
		"def f(x: int) {\n\tmatch (x) {\n\t\t1, // one\n\t\t2 // two\n\t\t\t=> {\n\t\t\t\tx++;\n\t\t\t}\n\t\t3\n\t\t\t=> x--;\n\t\t4 =>\n\t\t\tx++;\n\t\t5\n\t\t\t=> {\n\t\t\t\tx++;\n\t\t\t}\n\t}\n}\n");
	// A simple method body's "=>" that starts a line is a continuation.
	both(t, "class C {\n\tdef m() -> int\n\t\t\t=> 1;\n    def n() -> int\n\t\t=> 2;\n}\n",
		"class C {\n\tdef m() -> int\n\t\t\t=> 1;\n\tdef n() -> int\n\t\t=> 2;\n}\n");
}
def braces_on_continuations(t: Tester) {
	// As aeneas/src/arm64/Arm64Backend.v3:53: a constructor's "super(...) {"
	// on a continuation line opens a body indented from the constructor's line.
	both(t, "class A(x: int) { }\nclass B extends A {\n\tnew(x: int)\n\t\tsuper(x) {\n\t\t\tvar y = x;\n\t\t}\n}\n",
		"class A(x: int) { }\nclass B extends A {\n\tnew(x: int)\n\t\tsuper(x) {\n\t\tvar y = x;\n\t}\n}\n");
	both(t, "class C(a: int,\n\tb: int) extends B(a) {\n\t\tdef x = 1;\n}\n",
		"class C(a: int,\n\tb: int) extends B(a) {\n\tdef x = 1;\n}\n");
}
def fun_in_parentheses(t: Tester) {
	// A '{' inside parentheses indents from its own line.
	both(t, "def f() {\n\tm(fun () {\n\t\t\tn();\n\t});\n\tm(\n\t\tfun () {\n\t\tn();\n\t});\n\tm(1, fun () {\n\t\tn(); }, 2);\n}\n",
		"def f() {\n\tm(fun () {\n\t\tn();\n\t});\n\tm(\n\t\tfun () {\n\t\t\tn();\n\t\t});\n\tm(1, fun () {\n\t\tn(); }, 2);\n}\n");
	for (parts in [("m(", ");"), ("var callbacks = [", "];")]) {
		both(t, Strings.format2("def f() {\n    g(\n\t\t1); %s\n        fun () // keep\n{\nn();\n}%s\n}\n", parts.0, parts.1),
			Strings.format2("def f() {\n\tg(\n\t\t1); %s\n\t    fun () // keep\n\t{\n\t\tn();\n\t}%s\n}\n", parts.0, parts.1));
	}
}
def braceless_bodies(t: Tester) {
	both(t, "def f(c: bool) {\n\tif (c)\n\tf(c);\n\telse\n\t\t\tf(c);\n\twhile (c)\n\t\tif (c)\n\t\tf(c);\n\tfor (i < 3)\n\tf(c);\n\tfor (x in [1])\n\tf(c);\n\tfor (i = 0; i < 3; i++)\n\tf(c);\n}\n",
		"def f(c: bool) {\n\tif (c)\n\t\tf(c);\n\telse\n\t\tf(c);\n\twhile (c)\n\t\tif (c)\n\t\t\tf(c);\n\tfor (i < 3)\n\t\tf(c);\n\tfor (x in [1])\n\t\tf(c);\n\tfor (i = 0; i < 3; i++)\n\t\tf(c);\n}\n");
	// An "if" expression's ')' at a line's end leaves the next line a continuation.
	both(t, "def f(c: bool) {\n\tvar y = if(c, 1, 2)\n\t\t\t+ 3;\n\tvar z = g(if(c, 1, 2),\n\t\t1);\n}\n",
		"def f(c: bool) {\n\tvar y = if(c, 1, 2)\n\t\t\t+ 3;\n\tvar z = g(if(c, 1, 2),\n\t\t1);\n}\n");
	// Stacked loops (apps/Zoomers/Zoomers.v3:298) indent as nested bodies.
	both(t, "def f() {\n\tfor (i < 3)\n\tfor (j < 3) {\n\t\tf();\n\t}\n\tf();\n}\n",
		"def f() {\n\tfor (i < 3)\n\t\tfor (j < 3) {\n\t\t\tf();\n\t\t}\n\tf();\n}\n");
}
def continuations(t: Tester) {
	// Kept, and moved with a reindented first line only when its old
	// indentation is a prefix.
	both(t, "def f() {\n    var x = g(1,\n              2);\n    var y = 1 +\n\t2;\n  var z = 3 +\n      4;\n\tvar w = 5 +\n\t\t\t\t6;\n}\n",
		"def f() {\n\tvar x = g(1,\n\t          2);\n\tvar y = 1 +\n\t2;\n\tvar z = 3 +\n\t    4;\n\tvar w = 5 +\n\t\t\t\t6;\n}\n");
	both(t, "def f() {\n\t\tvar x = 1 +\n\t\t\t2 +\n\t\t\t\t3;\n}\n", "def f() {\n\tvar x = 1 +\n\t\t2 +\n\t\t\t3;\n}\n");
	both(t, "class C {\n\tdef f() {\n\t\tvar x = 1 +\n\t\t\t\t2;\n\t}\n}\n", "class C {\n\tdef f() {\n\t\tvar x = 1 +\n\t\t\t\t2;\n\t}\n}\n");
}
def comments(t: Tester) {
	// Column 0 stays; others take the next code line's indentation, or the
	// block's before a '}'.
	both(t, "def f() {\n// col0\n\tvar x = 1;\n\t\t// misindented\n\tx++;\n  /* block */\n\tx++;\n    // before close\n}\n  // end\n",
		"def f() {\n// col0\n\tvar x = 1;\n\t// misindented\n\tx++;\n\t/* block */\n\tx++;\n\t// before close\n}\n// end\n");
	// Inside brackets, comments follow the list's continuation lines,
	// including one after the last element.
	both(t, "  def a = [\n  \t1, // one\n  \t2\n  \t// after last\n  ];\n",
		"def a = [\n\t1, // one\n\t2\n\t// after last\n];\n");
	both(t, "def f() {\n\tg(1,\n// col0\n\t\t2);\n}\n", "def f() {\n\tg(1,\n// col0\n\t\t2);\n}\n");
	// Before a braceless body and before a continuation line.
	both(t, "def f(c: bool) {\n\tif (c)\n\t// why\n\t\tf(c);\n\tvar x = 1 +\n\t\t\t\t// two\n\t\t2;\n}\n",
		"def f(c: bool) {\n\tif (c)\n\t\t// why\n\t\tf(c);\n\tvar x = 1 +\n\t\t// two\n\t\t2;\n}\n");
}
def block_comments(t: Tester) {
	// Only the indentation before "/*" changes; the lines inside keep their bytes.
	both(t, "def f() {\n      /* a  \n   b  \n  */ var x = 1;\n}\n",
		"def f() {\n\t/* a  \n   b  \n  */ var x = 1;\n}\n");
	both(t, "/* a */ /* b */  \ndef x = 1; /* c\n */  \n", "/* a */ /* b */\ndef x = 1; /* c\n */\n");
}
def else_join(t: Tester) {
	// A '}' that starts its line joins an "else" on the next.
	both(t, "def f(c: bool) {\n\tif (c) {\n\t\tf(c);\n\t}  \n\t\telse {\n\t\tf(c);\n\t}\n\tif (c) {\n\t}\n\telse if (c) f(c);\n\telse\n\t\tf(c);\n}\n",
		"def f(c: bool) {\n\tif (c) {\n\t\tf(c);\n\t} else {\n\t\tf(c);\n\t}\n\tif (c) {\n\t} else if (c) f(c);\n\telse\n\t\tf(c);\n}\n");
	// After a one-line block, an "else" on the next line stays.
	both(t, "def f(c: bool) {\n\tif (c) { f(c); }\n\telse { f(c); }\n}\n", "def f(c: bool) {\n\tif (c) { f(c); }\n\telse { f(c); }\n}\n");
}
def brace_join(t: Tester) {
	both(t, "def f(c: bool)\n{\n\tif (c)  \n\t{\n\t\tf(c);\n\t}\n\twhile (c)\n{ f(c); }\n}\n",
		"def f(c: bool) {\n\tif (c) {\n\t\tf(c);\n\t}\n\twhile (c) { f(c); }\n}\n");
	// The joined header line anchors the body and the '}'.
	both(t, "class C {\n\tdef m()\n\t\t{\n\t\t\tm();\n\t\t}\n}\n", "class C {\n\tdef m() {\n\t\tm();\n\t}\n}\n");
	both(t, "def f() {\n\tm(fun ()\n\t\t{\n\t\t\tm();\n\t\t});\n}\n", "def f() {\n\tm(fun () {\n\t\tm();\n\t});\n}\n");
	// After ';', '{', or '}', a '{' is a block statement and stays.
	both(t, "def f() {\n\tf();\n\t{\n\t\tf();\n\t}\n\t{\n\t}\n}\n", "def f() {\n\tf();\n\t{\n\t\tf();\n\t}\n\t{\n\t}\n}\n");
	both(t, "def f() {\n{\n\tf();\n}\n}\n", "def f() {\n\t{\n\t\tf();\n\t}\n}\n");
}
def no_join(t: Tester) {
	// Never across a blank line or a comment.
	both(t, "def f()\n\n{\n}\n", "def f()\n\n{\n}\n");
	both(t, "def f() // c\n{\n}\n", "def f() // c\n{\n}\n");
	both(t, "def f() /* c */\n{\n}\n", "def f() /* c */\n{\n}\n");
	both(t, "def f()\n/* c */ {\n}\n", "def f()\n/* c */ {\n}\n");
	both(t, "def f(c: bool) {\n\tif (c) {\n\t} // c\n\telse {\n\t}\n\tif (c) {\n\t}\n\n\telse {\n\t}\n\tif (c) {\n\t}\n\t// c\n\telse {\n\t}\n}\n",
		"def f(c: bool) {\n\tif (c) {\n\t} // c\n\telse {\n\t}\n\tif (c) {\n\t}\n\n\telse {\n\t}\n\tif (c) {\n\t}\n\t// c\n\telse {\n\t}\n}\n");
	// An empty body over two lines stays.
	both(t, "class C(a: int) {\n}\n", "class C(a: int) {\n}\n");
}
def lines(t: Tester) {
	// Trailing whitespace goes, also after a line comment; whitespace-only
	// lines are emptied; runs of blank lines stay.
	both(t, "def x = 1;   \n \t \n\n\n\ndef y = 2;\t// c  \t\n// d \ndef z = 3;\n",
		"def x = 1;\n\n\n\n\ndef y = 2;\t// c\n// d\ndef z = 3;\n");
	both(t, "//\t\n", "//\n");
}
def start_of_file(t: Tester) {
	both(t, "  def x = 1;\n", "def x = 1;\n");
	both(t, "\n  \n\t\ndef x = 1;\n", "\n\n\ndef x = 1;\n");
	both(t, "\t// c\n  def x = 1;\n", "// c\ndef x = 1;\n");
	both(t, "", "");
	both(t, " \n\t\n", "");
	both(t, "\n", "");
	format(t, MIRROR, "  ", "");
	format(t, ONE, "  ", "");
}
def end_of_file(t: Tester) {
	format(t, ONE, "def x = 1;", "def x = 1;\n");
	format(t, MIRROR, "def x = 1;", "def x = 1;");
	format(t, ONE, "def x = 1; // c  ", "def x = 1; // c\n");
	format(t, MIRROR, "def x = 1; // c  ", "def x = 1; // c");
	// Several line ends, or whitespace after them.
	both(t, "def x = 1;  \n\n\n", "def x = 1;\n");
	format(t, ONE, "def f() { }\n ", "def f() { }\n");
	format(t, MIRROR, "def f() { }\n ", "def f() { }");
	format(t, ONE, "def f() { }\n\n\t", "def f() { }\n");
	format(t, MIRROR, "def f() { }\n\n\t", "def f() { }");
	// An added line end is of the kind of the file's first.
	format(t, ONE, "def x = 1;\r\ndef y = 2;  ", "def x = 1;\r\ndef y = 2;\r\n");
	format(t, MIRROR, "def x = 1;\r\ndef y = 2;  ", "def x = 1;\r\ndef y = 2;");
	format(t, ONE, "/* a\r\n */ def x = 1;\ndef y = 2;", "/* a\r\n */ def x = 1;\ndef y = 2;\r\n");
	both(t, "def x = 1;\r\n\r\n", "def x = 1;\r\n");
}
def open_block_comment(t: Tester) {
	// A block comment left open runs to the end untouched.
	both(t, "def x = 1;\n/* note\n\n", "def x = 1;\n/* note\n\n");
	both(t, "/* note\n\n", "/* note\n\n");
	both(t, "def x = 1;  \n  /* note  ", "def x = 1;\n/* note  ");
}
def crlf(t: Tester) {
	var edits = both(t, "class C {\r\n    def f() {  \r\n\r\n  \t}\r\n}  \r\n\r\n",
		"class C {\r\n\tdef f() {\r\n\r\n\t}\r\n}\r\n");
	both(t, "def f()\r\n{\r\n}\r\n", "def f() {\r\n}\r\n");
	both(t, "def f(c: bool) {\r\n\tif (c) {\r\n\t}\r\n\telse {\r\n\t}\r\n}\r\n", "def f(c: bool) {\r\n\tif (c) {\r\n\t} else {\r\n\t}\r\n}\r\n");
	// A CR is never removed as trailing whitespace, also after a line comment.
	both(t, "def x = 1; // c \r\n\t\r\n// d\t\r\n", "def x = 1; // c\r\n\r\n// d\r\n");
	// LF and CR LF mixed.
	both(t, "class C {\n  def x = 1;\r\n  def y = 2;\n}\r\n", "class C {\n\tdef x = 1;\r\n\tdef y = 2;\n}\r\n");
}
def lone_cr(t: Tester) {
	// The folding parse ends the line comment at the CR, and the compiler's
	// lexer doesn't, so a join based on it would move '{' into the comment.
	for (input in ["def f() // note\r -> int\n{\n\treturn;\n}\n", "def x = 1;\r", "def x = 1;\r\r\n"]) {
		for (eof in [ONE, MIRROR]) {
			var r = AeneasAdapter.formatting(PATH, input, OPTIONS, eof);
			t.assert(r.refusal != null, "a lone CR is refused");
			refused(t, r, AnalysisFormatRefusal.LONE_CR);
		}
	}
}
def comment_gap_edits(t: Tester) {
	// One parser gap, "   \n\t\t// note   \n   ", holds two changed runs
	// around a comment: one edit for each, neither covering the comment.
	var input = "def f() {   \n\t\t// note   \n   var x = 1;\n}\n";
	var edits = both(t, input, "def f() {\n\t// note\n\tvar x = 1;\n}\n");
	t.asserti(2, edits.length);
	var comment = 15;
	t.assert(input[comment] == '/', "the comment's offset");
	t.assert(edits[0].end <= comment && edits[1].begin >= comment + 7, "no edit covers the comment");
	// "{// note" with a misindented line after it: a space inserted before
	// the comment, and the line after it reindented, as two edits.
	input = "def f() {// note  \n   var x = 1;\n}\n";
	edits = both(t, input, "def f() { // note\n\tvar x = 1;\n}\n");
	t.asserti(2, edits.length);
	comment = 9;
	t.assert(input[comment] == '/', "the comment's offset");
	if (edits.length == 2) {
		t.assert(edits[0].begin == comment && edits[0].end == comment, "an insertion before the comment");
		t.assert(edits[1].begin >= comment + 7, "an edit after the comment");
	}
}
def syntax_error(t: Tester) {
	var input = "def f( {\n  var x = 1;\n}\n";
	var expected = AeneasAdapter.parseFile(PATH, input, OPTIONS).diagnostics[0];
	for (eof in [ONE, MIRROR]) {
		var r = AeneasAdapter.formatting(PATH, input, OPTIONS, eof);
		t.assert_string(expected.message, r.refusal);
		t.assert(r.kind == AnalysisFormatRefusal.SYNTAX, "a syntax error's kind");
		t.assert(r.diagnostic != null, "the first diagnostic");
		if (r.diagnostic != null) {
			t.asserti(expected.beginLine, r.diagnostic.beginLine);
			t.asserti(expected.beginColumn, r.diagnostic.beginColumn);
		}
		t.assertl(-1, r.size());
		t.assert(r.edits() == null, "no edits");
	}
	// The project's language options decide what parses.
	t.assert(AeneasAdapter.formatting(PATH, "def f = fun () { };\n", ["-lang:fun-exprs=false"], ONE).refusal != null, "fun needs -lang:fun-exprs");
	formatWithOptions(t, ONE, "def f = fun () { };\n", "def f = fun () { };\n", []);
}
def parse_budget(t: Tester) {
	var input = "component C {\n def f() {}\n}";
	AnalysisParseBudget.maxTokens = 10;
	format(t, ONE, input, "component C {\n\tdef f() { }\n}\n");
	AnalysisParseBudget.maxTokens = 9;
	var r = AeneasAdapter.formatting(PATH, input, OPTIONS, ONE);
	t.assert_string(AnalysisParseBudget.refusal(), r.refusal);
	refused(t, r, AnalysisFormatRefusal.PARSE_BUDGET);
	AnalysisParseBudget.maxTokens = AnalysisParseBudget.MAX_TOKENS;
}
def refused(t: Tester, r: AnalysisFormatting, kind: AnalysisFormatRefusal) {
	t.assert(r.kind == kind, "the refusal's kind");
	t.assert(r.diagnostic == null, "no diagnostic");
	t.assertl(-1, r.size());
	t.asserti(0, r.editCount());
	t.asserti(-1, r.firstChange());
	t.assert(r.edits() == null, "no edits");
}
def unindexed_source(t: Tester) {
	var input = " def f() { }\n ", syntax = SymbolSyntaxIndex.new(), errors = AnalysisParseErrors.new(1);
	var file = AnalysisSingleFileParser.parse(PATH, input, errors, syntax, TypeCache.new(), null);
	t.asserti(0, errors.numErrors);
	var marks = AnalysisFormatMarks.new(file, syntax).collect();
	for (i in [0, 4, input.length - 1]) {
		var inconsistent = Arrays.range(input, 0, input.length);
		inconsistent[i] = 'x';
		for (eof in [ONE, MIRROR]) {
			var r = DocumentFormatter.new(inconsistent, syntax, marks.bits, marks.funHeaders, eof).measure();
			t.assert_string("the parser left source text outside its tokens", r.refusal);
			refused(t, r, AnalysisFormatRefusal.UNTOKENIZED);
		}
	}
}
def growth(t: Tester) {
	// Indentation can make a small file of nested empty blocks grow past
	// 1 MiB (ADR-0019 decision 5): the k-th level's '{' and '}' lines gain k
	// tabs each. The result reports the size before building any edit.
	var n = 1100, b = StringBuilder.new().puts("def f() {\n");
	for (i < n) b.puts("{\n");
	for (i < n) b.puts("}\n");
	b.puts("}\n");
	var expected = StringBuilder.new().puts("def f() {\n");
	for (depth = 1; depth <= n; depth++) {
		for (j < depth) expected.putc('\t');
		expected.puts("{\n");
	}
	for (depth = n; depth > 0; depth--) {
		for (j < depth) expected.putc('\t');
		expected.puts("}\n");
	}
	expected.puts("}\n");
	var input = b.toString(), output = expected.toString();
	t.assert(output.length > 1024 * 1024 && input.length < 5000, "past 1 MiB from under 5 KB");
	var edits = both(t, input, output);
	if (edits != null) t.asserti(2 * n, edits.length);
}
def comment_lookahead_linear(t: Tester) {
	// Every comment line looks ahead to the same code line, whose start
	// is found once: a pass over many such lines stays linear.
	var n = 4000, b = StringBuilder.new().puts("def f() {\n\tvar x = 1 +\n");
	for (i < n) b.puts(" //c\n");
	b.puts("/*b*/");
	for (i < n) b.putc(' ');
	b.puts("2;\n}\n");
	var input = b.toString();
	var after = StringBuilder.new().puts("def f() {\n\tvar x = 1 +\n");
	for (i < n) after.puts("//c\n");
	after.puts("/*b*/");
	for (i < n) after.putc(' ');
	after.puts("2;\n}\n");
	both(t, input, after.toString());
	// The same with the code line's own long indentation, which each
	// comment line before it follows.
	b = StringBuilder.new().puts("def f() {\n    var x = 1 +\n");
	for (i < n) b.puts("        //c\n");
	b.puts("            2;\n}\n");
	var c = StringBuilder.new().puts("def f() {\n\tvar x = 1 +\n");
	for (i < n) c.puts("\t        //c\n");
	c.puts("\t        2;\n}\n");
	both(t, b.toString(), c.toString());
}
def unjoined_brace(t: Tester) {
	// A body's '{' that a comment or a blank line keeps on its own line
	// stays at its header's indentation, its body one tab deeper.
	both(t, "def f(c: bool) {\n\tif (c) // keep\n\t{\n\t\tf(c);\n\t}\n}\n", "def f(c: bool) {\n\tif (c) // keep\n\t{\n\t\tf(c);\n\t}\n}\n");
	both(t, "def f(c: bool) {\n\tif (c)\n\n\t{\n\t\tf(c);\n\t}\n}\n", "def f(c: bool) {\n\tif (c)\n\n\t{\n\t\tf(c);\n\t}\n}\n");
	both(t, "class C {\n\tdef m() // c\n\t\t{\n\t\t\tm();\n\t\t}\n}\n", "class C {\n\tdef m() // c\n\t{\n\t\tm();\n\t}\n}\n");
	both(t, "def f(c: bool) {\n\tif (c) {\n\t} else // c\n\t\t{\n\t\t\tf(c);\n\t\t}\n}\n", "def f(c: bool) {\n\tif (c) {\n\t} else // c\n\t{\n\t\tf(c);\n\t}\n}\n");
	both(t, "def f(c: bool) {\n\tif (c)\n\t\t// c\n\t\t{\n\t\t}\n}\n", "def f(c: bool) {\n\tif (c)\n\t// c\n\t{\n\t}\n}\n");
	both(t, "def f() {\n\tm(\n\t\tfun () // keep\n\t\t\t\t{\n\t\t\t\t\tn();\n\t\t\t\t});\n}\n",
		"def f() {\n\tm(\n\t\tfun () // keep\n\t\t{\n\t\t\tn();\n\t\t});\n}\n");
	both(t, "def f() {\n\tvar fs = [\n\t\tfun (\n\t\t\tx: int)\n\n\t\t\t\t{\n\t\t\t\t\tn();\n\t\t\t\t}];\n}\n",
		"def f() {\n\tvar fs = [\n\t\tfun (\n\t\t\tx: int)\n\n\t\t{\n\t\t\tn();\n\t\t}];\n}\n");
}
// The '{' of a fun outside parentheses and brackets that a comment or a
// blank line keeps on its own line stays at the fun's line indentation, and
// its body and '}' count from the line where the fun's statement started,
// also partway through that line. Inside parentheses or brackets they count
// from the '{' line (fun_in_parentheses).
def unjoined_ungrouped_fun_brace(t: Tester) {
	both(t, "def f() {\n\tvar callback =\n\t\tfun () // keep\n\t\t{\n\t\t\treturn;\n\t\t};\n}\n",
		"def f() {\n\tvar callback =\n\t\tfun () // keep\n\t\t{\n\t\treturn;\n\t};\n}\n");
	both(t, "def f() {\n\tvar callback =\n\t\tfun ()\n\n\t\t{\n\t\t\treturn;\n\t\t};\n}\n",
		"def f() {\n\tvar callback =\n\t\tfun ()\n\n\t\t{\n\t\treturn;\n\t};\n}\n");
	// A representation hint's own '}' doesn't move the statement's line.
	for (hint in ["fun () {\n\t\t\treturn;\n\t\t}", "fun () { return; }"]) {
		both(t, Strings.format1("def f() {\n\tvar callback =\n\t\tfun () #hint(%s) // keep\n\t\t{\n\t\t\treturn;\n\t\t};\n}\n", hint),
			Strings.format1("def f() {\n\tvar callback =\n\t\tfun () #hint(%s) // keep\n\t\t{\n\t\treturn;\n\t};\n}\n", hint));
	}
	// A statement that starts partway through a line, after a ';' or a '{'.
	both(t, "def f() {\n\tg(\n\t\t1); var callback = fun () // keep\n{\nreturn;\n};\n}\n",
		"def f() {\n\tg(\n\t\t1); var callback = fun () // keep\n\t\t{\n\t\t\treturn;\n\t\t};\n}\n");
	both(t, "def f() {\n\tif (\n\t\ttrue) { var callback = fun () // keep\n{\nreturn;\n}; }\n}\n",
		"def f() {\n\tif (\n\t\ttrue) { var callback = fun () // keep\n\t\t{\n\t\t\treturn;\n\t\t}; }\n}\n");
	// After another fun's body in the same statement.
	both(t, "def f() {\n\tvar callback = fun () -> int // keep\n\t{\n\t\treturn 1;\n\t}, other =\n\t\tfun () // keep\n\t\t{\n\t\t\treturn;\n\t\t};\n}\n",
		"def f() {\n\tvar callback = fun () -> int // keep\n\t{\n\t\treturn 1;\n\t}, other =\n\t\tfun () // keep\n\t\t{\n\t\treturn;\n\t};\n}\n");
	// Continuation prefixes: the '{' keeps its line's indentation, and a
	// continuation in the body still shifts only against the '{' line.
	both(t, "def f() {\n    g(\n      1); var callback = fun () // keep\n    {\nreturn;\n};\n}\n",
		"def f() {\n\tg(\n\t  1); var callback = fun () // keep\n\t{\n\t\treturn;\n\t};\n}\n");
	both(t, "def f() {\n    var callback = fun () -> int // keep\n\t\t{ return\n        1;\n};\n}\n",
		"def f() {\n\tvar callback = fun () -> int // keep\n\t{ return\n        1;\n\t};\n}\n");
}
def unjoined_fun_inside_grouped_brace(t: Tester) {
	both(t, "def f() {\n\tg(fun () {\n\t\tvar callback =\n\t\t\tfun () // keep\n{\nreturn;\n};\n\t});\n}\n",
		"def f() {\n\tg(fun () {\n\t\tvar callback =\n\t\t\tfun () // keep\n\t\t\t{\n\t\t\t\treturn;\n\t\t\t};\n\t});\n}\n");
	both(t, "def f() {\n\tvar callbacks = [fun () {\n\t\tvar callback =\n\t\t\tfun ()\n\n{\nreturn;\n};\n\t}];\n}\n",
		"def f() {\n\tvar callbacks = [fun () {\n\t\tvar callback =\n\t\t\tfun ()\n\n\t\t\t{\n\t\t\t\treturn;\n\t\t\t};\n\t}];\n}\n");
	both(t, "def f() {\n\tg(fun () {\n\t\t/* note\n\t\t\t\t*/ var callback = fun () // keep\n{\nreturn;\n};\n\t});\n}\n",
		"def f() {\n\tg(fun () {\n\t\t/* note\n\t\t\t\t*/ var callback = fun () // keep\n\t\t{\n\t\t\treturn;\n\t\t};\n\t});\n}\n");
}
def unjoined_fun_after_block_comment(t: Tester) {
	both(t, "def f() {\n\t/* note\n\t\t\t*/ var callback =\n\t\tfun () // keep\n\t\t{\nreturn;\n};\n}\n",
		"def f() {\n\t/* note\n\t\t\t*/ var callback =\n\t\tfun () // keep\n\t\t{\n\t\t\t\treturn;\n\t\t\t};\n}\n");
	both(t, "def f() {\n\t/* note\n\t\t\t*/ var callback = fun () // keep\n{\nreturn;\n};\n}\n",
		"def f() {\n\t/* note\n\t\t\t*/ var callback = fun () // keep\n\t\t\t{\n\t\t\t\treturn;\n\t\t\t};\n}\n");
}
// A fun's '{' on its header's line, outside parentheses and brackets, also
// indents the body and '}' from the line where the fun's statement started.
def joined_ungrouped_fun_brace(t: Tester) {
	var expected = "def f() {\n\tg(\n\t\t1); var callback = fun () {\n\t\t\treturn;\n\t\t};\n}\n";
	both(t, "def f() {\n\tg(\n\t\t1); var callback = fun () {\nreturn;\n};\n}\n", expected);
	// Also after the '{' joins its line.
	both(t, "def f() {\n\tg(\n\t\t1); var callback = fun ()\n{\nreturn;\n};\n}\n", expected);
	both(t, "def f() {\n\tif (\n\t\ttrue) { var callback = fun () {\nreturn;\n}; }\n}\n",
		"def f() {\n\tif (\n\t\ttrue) { var callback = fun () {\n\t\t\treturn;\n\t\t}; }\n}\n");
	both(t, "def f() {\n\tif (true)\n\t\tg(); else x = fun () {\nreturn;\n};\n}\n",
		"def f() {\n\tif (true)\n\t\tg(); else x = fun () {\n\t\t\treturn;\n\t\t};\n}\n");
	both(t, "def f() {\n\t/* note\n\t\t\t*/ var callback = fun () {\nreturn;\n};\n}\n",
		"def f() {\n\t/* note\n\t\t\t*/ var callback = fun () {\n\t\t\t\treturn;\n\t\t\t};\n}\n");
	// A statement over several lines counts from its first line.
	var input = "def f() {\n\tvar callback =\n\t\tfun () {\n\t\treturn;\n\t};\n}\n";
	both(t, input, input);
}
def code_after_comment(t: Tester) {
	// A line that starts with a comment and then has code is a code line,
	// also at column 0.
	both(t, "def f(c: bool) {\n  /* note */ if (c) {\n\t\tf(c);\n\t}\n}\n", "def f(c: bool) {\n\t/* note */ if (c) {\n\t\tf(c);\n\t}\n}\n");
	both(t, "def f() {\n\tf();\n  /* end */ }\n", "def f() {\n\tf();\n/* end */ }\n");
	both(t, "def f() {\n/* x */ /* y */ f();\n}\n", "def f() {\n\t/* x */ /* y */ f();\n}\n");
	both(t, "def f() {\n\t\t// a\n  /* b */ f();\n}\n", "def f() {\n\t// a\n\t/* b */ f();\n}\n");
	// A block comment over two lines with code after it.
	both(t, "def f() {\n  /* a\n b */ f();\n}\n", "def f() {\n\t/* a\n b */ f();\n}\n");
	both(t, "def f() {\n\tif (true)\n\t\tf(); /* a\r\n b */ /* c */ if (true)\n   f();\n}\n",
		"def f() {\n\tif (true)\n\t\tf(); /* a\r\n b */ /* c */ if (true)\n\t\tf();\n}\n");
	both(t, "def f() {\n\tvar x = 1 +\n   // before\n\t/* a\n  b */ 2;\n}\n",
		"def f() {\n\tvar x = 1 +\n  // before\n  /* a\n  b */ 2;\n}\n");
}
def block_comment_opener(t: Tester) {
	// A block comment that starts its line and closes on a code line is a
	// comment line: it takes the indentation of the line where it closes,
	// whose bytes, inside the comment, stay.
	both(t, "def f() {\n\tvar x = 1 +\n    /* a\n\t\tb */ 2;\n}\n", "def f() {\n\tvar x = 1 +\n\t\t/* a\n\t\tb */ 2;\n}\n");
	// Before a statement it takes the statement's indentation; at column 0
	// it stays.
	both(t, "def f() {\n      /* a\n b */ f();\n}\n", "def f() {\n\t/* a\n b */ f();\n}\n");
	var input = "def f() {\n\tvar x = 1 +\n/* a\n\t\tb */ 2;\n/* c\n */ f();\n}\n";
	both(t, input, input);
	// Inside parentheses it moves as a continuation does.
	both(t, "def f() {\n    g(1,\n      /* a\n b */ 2);\n}\n", "def f() {\n\tg(1,\n\t  /* a\n b */ 2);\n}\n");
}
def else_line(t: Tester) {
	// An "else" that starts its line aligns with its "if"'s line.
	both(t, "def f(c: bool) {\n\twhile (c)\n\t\tif (c)\n\t\t\tf(c);\n\t\telse\n\t\t\tf(c);\n}\n",
		"def f(c: bool) {\n\twhile (c)\n\t\tif (c)\n\t\t\tf(c);\n\t\telse\n\t\t\tf(c);\n}\n");
	both(t, "def f(c: bool) {\n\tif (c)\n\t\tf(c);\n\t\telse if (c)\n\tf(c);\n   else\n\t\t\tf(c);\n}\n",
		"def f(c: bool) {\n\tif (c)\n\t\tf(c);\n\telse if (c)\n\t\tf(c);\n\telse\n\t\tf(c);\n}\n");
	both(t, "def f(c: bool) {\n\tif (c)\n\t\tif (c)\n\t\t\tf(c);\n\t\telse\n\t\t\tf(c);\n\telse\n\t\tf(c);\n}\n",
		"def f(c: bool) {\n\tif (c)\n\t\tif (c)\n\t\t\tf(c);\n\t\telse\n\t\t\tf(c);\n\telse\n\t\tf(c);\n}\n");
	// A match's default "else" belongs to no if statement.
	both(t, "def f(x: int) {\n\tif (x > 0)\n\t\tmatch (x) {\n\t\t\t1 => ;\n\t\t} else\n\t\t\tf(x);\n\telse\n\t\tf(x);\n}\n",
		"def f(x: int) {\n\tif (x > 0)\n\t\tmatch (x) {\n\t\t\t1 => ;\n\t\t} else\n\t\t\tf(x);\n\telse\n\t\tf(x);\n}\n");
	// An if statement inside an if's condition, in a fun body.
	both(t, "def f(c: bool) {\n\tif (g(fun () {\n\t\tif (c) f(c);\n\t\telse f(c);\n\t}))\n\t\tf(c);\n\telse\n\t\tf(c);\n}\n",
		"def f(c: bool) {\n\tif (g(fun () {\n\t\tif (c) f(c);\n\t\telse f(c);\n\t}))\n\t\tf(c);\n\telse\n\t\tf(c);\n}\n");
	both(t, "def f(x: int) {\n\tif (x > 0)\n\t\tmatch (x) {\n\t\t\t1 => ;\n\t\t} // keep\n\telse\n\t\tf(x);\n\telse\n\t\tf(x);\n}\n",
		"def f(x: int) {\n\tif (x > 0)\n\t\tmatch (x) {\n\t\t\t1 => ;\n\t\t} // keep\n\t\telse\n\t\t\tf(x);\n\telse\n\t\tf(x);\n}\n");
	both(t, "def f(x: int) {\n\tif (x > 0)\n\t\tmatch (x) {\n\t\t\t1 => ;\n\t\t}\nelse\n\t\tf(x);\n}\n",
		"def f(x: int) {\n\tif (x > 0)\n\t\tmatch (x) {\n\t\t\t1 => ;\n\t\t} else\n\t\t\tf(x);\n}\n");
}
def inline_else(t: Tester) {
	var input = "def f() {\n\tif (true)\n\t\tg(); else h(\n\t\t\t\t1);\n}\n";
	both(t, input, input);
	input = "def f() {\n\tmatch (0) {\n\t\t_ => g(); } else h(\n\t\t\t\t1);\n}\n";
	both(t, input, input);
	both(t, "def f() {\n\tif (true)\n    g(); else return\n      // argument\n      h();\n}\n",
		"def f() {\n\tif (true)\n\t\tg(); else return\n\t\t  // argument\n\t\t  h();\n}\n");
	both(t, "def f() {\n\tif (true)\n\t\tg(); else\nh();\n\tmatch (0) {\n\t\t_ => g(); } else {\nh();\n}\n}\n",
		"def f() {\n\tif (true)\n\t\tg(); else\n\t\th();\n\tmatch (0) {\n\t\t_ => g(); } else {\n\t\th();\n\t}\n}\n");
	both(t, "def f() {\n\tif (true)\n\t\tg(); else // keep\n\t\t{\nh();\n}\n}\n",
		"def f() {\n\tif (true)\n\t\tg(); else // keep\n\t{\n\t\th();\n\t}\n}\n");
	both(t, "def f() {\n\twhile (true)\n\t\tif (true)\n\t\t\tg.else();\n\telse h();\n}\n",
		"def f() {\n\twhile (true)\n\t\tif (true)\n\t\t\tg.else();\n\t\telse h();\n}\n");
}
// An inline "else" anchors only its own body on its if's or match's line:
// a control header after it on that line, also the "else" body itself,
// takes that line's indentation for an unjoined '{' or a braceless body.
def headers_after_inline_else(t: Tester) {
	var brace = "\t{\n\th();\n\t}\n}\n", indented = "\t\t{\n\t\t\th();\n\t\t}\n}\n";
	for (header in [
		"\tif (true)\n\t\tg(); else h(); while (true) // keep\n",
		"\tif (true)\n\t\tg(); else while (true) // keep\n",
		"\tif (true)\n\t\tg(); else if (true) // keep\n",
		"\tif (\n\t\ttrue) g(); else while (true) // keep\n",
		"\tif (true)\n\t\tg(); else h(fun () { if (true) g(); }); while (true) // keep\n",
		"\tif (true)\n\t\tg(); else h(fun () { if (true) g(); else h(); }); while (true) // keep\n",
		"\tif (true)\n\t\tg(); else h([fun () { match (0) { _ => g(); } else h(); }]); while (true) // keep\n",
		"\tmatch (0) {\n\t\t_ => g(); } else while (true) // keep\n"
	]) {
		var prefix = Strings.format1("def f() {\n%s", header);
		both(t, Strings.format2("%s%s", prefix, brace), Strings.format2("%s%s", prefix, indented));
	}
	both(t, "def f() {\n\tif (true)\n\t\tg(); else h(fun () {\n\t\t\tif (true) g(); else h();\n\t\t}); while (true) // keep\n\t{\nh();\n\t}\n}\n",
		"def f() {\n\tif (true)\n\t\tg(); else h(fun () {\n\t\t\tif (true) g(); else h();\n\t\t}); while (true) // keep\n\t{\n\t\th();\n\t}\n}\n");
	both(t, "def f() {\n\tif (true)\n\t\tif (true)\n\t\t\tg(); else h(); else while (true) // keep\n\t{\n\th();\n\t}\n}\n",
		"def f() {\n\tif (true)\n\t\tif (true)\n\t\t\tg(); else h(); else while (true) // keep\n\t\t\t{\n\t\t\t\th();\n\t\t\t}\n}\n");
	both(t, "def f() {\n\tmatch (0) {\n\t\t_ => g(\n\t\t\t1); } else while (true)\n\t{\n\th();\n\t}\n}\n",
		"def f() {\n\tmatch (0) {\n\t\t_ => g(\n\t\t\t1); } else while (true) {\n\t\t\t\th();\n\t\t\t}\n}\n");
	both(t, "def f() {\n\tif (true)\n\t\tg(); else match (0) // keep\n\t{\n\t_ => ;\n\t}\n}\n",
		"def f() {\n\tif (true)\n\t\tg(); else match (0) // keep\n\t\t{\n\t\t\t_ => ;\n\t\t}\n}\n");
	both(t, "def f() {\n\tif (true)\n\t\tg(); else while (true)\n\th();\n\tmatch (0) {\n\t\t_ => g(); } else for (i < 1)\n\th();\n}\n",
		"def f() {\n\tif (true)\n\t\tg(); else while (true)\n\t\t\th();\n\tmatch (0) {\n\t\t_ => g(); } else for (i < 1)\n\t\t\th();\n}\n");
}
// On a block comment's closing line, whose leading tabs stay inside the
// comment, a control header after an "else" counts from those tabs.
def header_after_else_on_comment_close(t: Tester) {
	var brace = "{\nh();\n}\n}\n", indented = "\t\t\t{\n\t\t\t\th();\n\t\t\t}\n}\n";
	for (lines in [
		("\tif (true)\n\t/* a\n\t\t\tclose */ g(); else while (true) // keep\n",
			"\tif (true)\n\t\t/* a\n\t\t\tclose */ g(); else while (true) // keep\n"),
		("\tmatch (0) {\n\t/* a\n\t\t\tclose */ _ => g(); } else while (true) // keep\n",
			"\tmatch (0) {\n\t\t/* a\n\t\t\tclose */ _ => g(); } else while (true) // keep\n"),
		("\tmatch (0) {\n\t\t_ => ;\n\t}\n\t/* a\n\t\t\tclose */ else while (true) // keep\n",
			"\tmatch (0) {\n\t\t_ => ;\n\t}\n\t/* a\n\t\t\tclose */ else while (true) // keep\n")
	]) {
		both(t, Strings.format2("def f() {\n%s%s", lines.0, brace), Strings.format2("def f() {\n%s%s", lines.1, indented));
	}
	both(t, "def f() {\n\tif (true)\n\t/* a\n\t\t\tclose */ g(); else while (true)\nh();\n}\n",
		"def f() {\n\tif (true)\n\t\t/* a\n\t\t\tclose */ g(); else while (true)\n\t\t\t\th();\n}\n");
	// The header's own "else" aligns with those tabs too.
	both(t, "def f() {\n\tif (true)\n\t/* a\n\t\t\tclose */ g(); else if (true)\nh();\nelse\nk();\n}\n",
		"def f() {\n\tif (true)\n\t\t/* a\n\t\t\tclose */ g(); else if (true)\n\t\t\t\th();\n\t\t\telse\n\t\t\t\tk();\n}\n");
	both(t, "def f() {\n\tif (true)\n\t/* a\n\t\t\tclose */ g(); else { if (true)\nh();\nelse k();\n}\n}\n",
		"def f() {\n\tif (true)\n\t\t/* a\n\t\t\tclose */ g(); else { if (true)\n\t\t\t\th();\n\t\t\telse k();\n\t}\n}\n");
}
// A control header in an inline "else"'s braced body, on the else's line,
// takes that line's indentation too.
def header_in_inline_else_block(t: Tester) {
	var brace = "{\nh();\n}\n}\n}\n", indented = "\t\t{\n\t\t\th();\n\t\t}\n\t}\n}\n";
	for (header in [
		"\tif (true)\n\t\tg(); else { while (true) // keep\n",
		"\tif (true)\n\t\tg(); else { h(); while (true) // keep\n",
		"\tif (true)\n\t\tg(); else { if (true) h(); else while (true) // keep\n",
		"\tif (true)\n\t\tg(); else { h(fun () { if (true) g(); }); while (true) // keep\n",
		"\tmatch (0) {\n\t\t_ => g(); } else { while (true) // keep\n"
	]) {
		var prefix = Strings.format1("def f() {\n%s", header);
		both(t, Strings.format2("%s%s", prefix, brace), Strings.format2("%s%s", prefix, indented));
	}
	// The else's '{' joins its line.
	both(t, "def f() {\n\tif (true)\n\t\tg(); else\n{ while (true) // keep\n{\nh();\n}\n}\n}\n",
		"def f() {\n\tif (true)\n\t\tg(); else { while (true) // keep\n\t\t{\n\t\t\th();\n\t\t}\n\t}\n}\n");
	both(t, "def f() {\n\tif (true)\n\t\tg(); else { while (true)\nh();\n}\n\tmatch (0) {\n\t\t_ => g(); } else { for (i < 1)\nh();\n}\n}\n",
		"def f() {\n\tif (true)\n\t\tg(); else { while (true)\n\t\t\th();\n\t}\n\tmatch (0) {\n\t\t_ => g(); } else { for (i < 1)\n\t\t\th();\n\t}\n}\n");
}
def fun_body_close(t: Tester) {
	// The line after a fun expression's '}' continues its statement.
	both(t, "def f() -> int {\n\treturn fun () -> int {\n\t\treturn 42;\n\t}\n          ();\n}\n",
		"def f() -> int {\n\treturn fun () -> int {\n\t\treturn 42;\n\t}\n          ();\n}\n");
	// After a statement's block, the next line starts a statement.
	both(t, "def f() {\n\tvar g = fun () {\n\t};\n\t\tf();\n\t{\n\t}\n\t\tf();\n}\n", "def f() {\n\tvar g = fun () {\n\t};\n\tf();\n\t{\n\t}\n\tf();\n}\n");
	both(t, "def f() {\n\tdef g() { }\n    g();\n\tdef h();\n    h();\n}\n",
		"def f() {\n\tdef g() { }\n\tg();\n\tdef h();\n\th();\n}\n");
	both(t, "def f() {\n\tvar g = fun ();\n\t\t();\n}\n", "def f() {\n\tvar g = fun ();\n\t\t();\n}\n");
	both(t, "def f() {\n\tif (test(\n\t\tfun () -> bool {\n\t\t\treturn true;\n\t\t}))\n   g();\n\twhile (test(\n\t\tfun () -> bool {\n\t\t\treturn true;\n\t\t})) // keep\n   {\n   g();\n   }\n}\n",
		"def f() {\n\tif (test(\n\t\tfun () -> bool {\n\t\t\treturn true;\n\t\t}))\n\t\tg();\n\twhile (test(\n\t\tfun () -> bool {\n\t\t\treturn true;\n\t\t})) // keep\n\t{\n\t\tg();\n\t}\n}\n");
	both(t, "def f() {\n    var x = g(\n      fun () {\n\t\treturn;\n      },\n        2);\n}\n",
		"def f() {\n\tvar x = g(\n\t  fun () {\n\t\treturn;\n\t},\n\t    2);\n}\n");
}
def case_arrow_anchor(t: Tester) {
	// A case's "=>" that starts a line is anchored on the line where the
	// case's first pattern starts.
	both(t, "def f(x: int) {\n\tmatch (x) { 1,\n\t\t2\n\t\t=> {\n\t\t\tx++;\n\t\t}\n\t}\n}\n",
		"def f(x: int) {\n\tmatch (x) { 1,\n\t\t2\n\t\t=> {\n\t\t\tx++;\n\t\t}\n\t}\n}\n");
	both(t, "def f(x: int) {\n\tmatch (x) {\n\t\t1,\n\t\t2,\n\t\t3\n\t\t=> x++;\n\t}\n}\n",
		"def f(x: int) {\n\tmatch (x) {\n\t\t1,\n\t\t2,\n\t\t3\n\t\t\t=> x++;\n\t}\n}\n");
}
def foreach_initializer(t: Tester) {
	// The parse tree's statements inside a for loop's variable initializer.
	both(t, "def f() {\n\tfor (x = fun () {\n\t\tif (true)\n   return;\n\t} in [0]) { }\n}\n",
		"def f() {\n\tfor (x = fun () {\n\t\tif (true)\n\t\t\treturn;\n\t} in [0]) { }\n}\n");
	both(t, "def f() {\n\tfor (i = fun () {\n\t\tif (true)\n   return;\n\t}; i != null; i = null) { }\n}\n",
		"def f() {\n\tfor (i = fun () {\n\t\tif (true)\n\t\t\treturn;\n\t}; i != null; i = null) { }\n}\n");
}
def representation_hints(t: Tester) {
	var unindented = "fun () {\n\tif (true)\n\treturn;\n}";
	var indented = "fun () {\n\tif (true)\n\t\treturn;\n}";
	for (parts in [
		("def f() #hint(", ") { }\n"),
		("def x = 0 #hint(", ");\n"),
		("class C #hint(", ") { }\n"),
		("type T { case C #hint(", "); }\n"),
		("layout L #hint(", ") { = 1; }\n"),
		("layout L { +0 x: u8 #hint(", "); = 1; }\n"),
		("def f() { var x #hint(", ") = 1; }\n")
	]) {
		both(t, Strings.format3("%s%s%s", parts.0, unindented, parts.1),
			Strings.format3("%s%s%s", parts.0, indented, parts.1));
	}
}

// Each case below formats one function or declaration; {body} wraps
// statements in a function with the names that they use.
def body(statements: string) -> string {
	return Strings.format1("def f(c: bool, x: int, m: HashMap<int, int>) {\n%s}\n", statements);
}
def control_keywords(t: Tester) {
	// One space after a statement's keyword, also replacing a tab or several
	// spaces, which align nothing here.
	both(t, body("\tif(c) x++;\n\tif  (c) x++;\n\tif\t(c) x++;\n\twhile(c) x++;\n\tfor(i < 3) x++;\n\tfor(y in [1]) x++;\n\tfor(i = 0; i < 3; i++) x++;\n\tmatch(x) {\n\t\t_ => ;\n\t}\n"),
		body("\tif (c) x++;\n\tif (c) x++;\n\tif (c) x++;\n\twhile (c) x++;\n\tfor (i < 3) x++;\n\tfor (y in [1]) x++;\n\tfor (i = 0; i < 3; i++) x++;\n\tmatch (x) {\n\t\t_ => ;\n\t}\n"));
	// None after an if expression's keyword.
	both(t, body("\tvar y = if (c, 1, 2), z = if  (c, 1, 2) + if\t(c, 3, 4);\n"),
		body("\tvar y = if(c, 1, 2), z = if(c, 1, 2) + if(c, 3, 4);\n"));
	// Member names that are keywords aren't statements or expressions.
	var input = body("\tm.if(1);\n\tm.while (2);\n\tm.match(3);\n\tm.for (4);\n");
	both(t, input, input);
}
def if_kinds(t: Tester) {
	// The parse tree, not a comma in the parentheses, tells the kinds apart
	// (spike rule bugs 1 and 11).
	both(t, "def f<T>() {\n\tif(eq<T, int>()) return;\n}\n", "def f<T>() {\n\tif (eq<T, int>()) return;\n}\n");
	both(t, body("\tfor (i = 0; if (c, i < 3, i < 4); if (c, i++, i--)) { }\n"),
		body("\tfor (i = 0; if(c, i < 3, i < 4); if(c, i++, i--)) { }\n"));
	both(t, body("\tmatch (x) {\n\t\t1 => def g = fun() => if (c, 1, 2);\n\t\t_ => if(c) x++;\n\t}\n"),
		body("\tmatch (x) {\n\t\t1 => def g = fun() => if(c, 1, 2);\n\t\t_ => if (c) x++;\n\t}\n"));
	// An if expression in a statement's condition, and a statement in a fun
	// body in an expression's arguments.
	both(t, body("\tif(if (c, true, false)) x++;\n\tvar y = if (c, fun () {\n\t\tif(c) x++;\n\t}, null);\n\tif (c) x++; else if(c) x--;\n"),
		body("\tif (if(c, true, false)) x++;\n\tvar y = if(c, fun () {\n\t\tif (c) x++;\n\t}, null);\n\tif (c) x++; else if (c) x--;\n"));
	// Fields, simple method bodies, and representation hints.
	both(t, "class C(c: bool) {\n\tdef x = if (c, 1, 2);\n\tdef m() -> int => if (c, 1, 2);\n}\ndef y = 0 #hint(if (true, 1, 2));\n",
		"class C(c: bool) {\n\tdef x = if(c, 1, 2);\n\tdef m() -> int => if(c, 1, 2);\n}\ndef y = 0 #hint(if(true, 1, 2));\n");
}
def colons(t: Tester) {
	// No space before a colon after a name, and at least one after it.
	both(t, "def f(a:int, b : int, c :int, d: int) -> int {\n\tvar e:int = 1, g :  bool;\n\tmatch (a) {\n\t\tx : int => ;\n\t}\n\treturn a;\n}\n",
		"def f(a: int, b: int, c: int, d: int) -> int {\n\tvar e: int = 1, g:  bool;\n\tmatch (a) {\n\t\tx: int => ;\n\t}\n\treturn a;\n}\n");
	// A tab or two or more spaces before a colon, or a tab after one, is
	// alignment (spike rule bug 13).
	var input = "layout L {\n\t+0\twasm_func\t: i64;\n\t+8\tx        : u8;\n\t+9\ty:\tu8;\n\t=16;\n}\ndef f(a  : int, b:\tint) { }\n";
	both(t, input, input);
	// A packing's "): 8" and a constructor's ") : super(...)" follow no name
	// (spike rule bug 3).
	both(t, "packing P(a:4): 8 = 0b_aaaa_0000;\npacking Q(b: 4):8 = 0b_bbbb_0000;\nclass A(x: int) { }\nclass B extends A {\n\tnew(x: int) : super(x) { }\n}\nclass D extends A {\n\tnew(x: int):super(x) { }\n}\n",
		"packing P(a: 4): 8 = 0b_aaaa_0000;\npacking Q(b: 4):8 = 0b_bbbb_0000;\nclass A(x: int) { }\nclass B extends A {\n\tnew(x: int) : super(x) { }\n}\nclass D extends A {\n\tnew(x: int):super(x) { }\n}\n");
}
def assignments(t: Tester) {
	both(t, body("\tvar y=1;\n\tx=2;\n\tx+=1; x-=1; x*=2; x/=2; x%=2; x&=1; x|=1; x^=1; x <<=1; x>>=1; x>>>=1;\n"),
		body("\tvar y = 1;\n\tx = 2;\n\tx += 1; x -= 1; x *= 2; x /= 2; x %= 2; x &= 1; x |= 1; x ^= 1; x <<= 1; x >>= 1; x >>>= 1;\n"));
	// A tab or several spaces on either side align a column (spike rule bug
	// 7), and comparisons aren't assignments.
	var input = body("\tvar a   = 1;\n\tvar bb  = 2;\n\tvar ccc =\t3;\n\tvar d = x==1 || x!=2 || 3<=x || x>=4;\n");
	both(t, input, input);
	// Also around a compound assignment.
	input = body("\tx  +=\t1;\n\tx\t<<=  2;\n");
	both(t, input, input);
	// A type's closing '>' and an initializer's '=' are two tokens.
	both(t, "def z: Array<int>= [1];\n", "def z: Array<int> = [1];\n");
}
def layout_sizes(t: Tester) {
	// A layout's size isn't an assignment, on its own line or after a field
	// (spike rule bug 4).
	var input = "layout L {\n\t+0 x: u8;\n\t=16;\n}\nlayout M {\n\t+0 x: u8;=16;\n}\nlayout N {=4; }\nlayout P { +0 x: u8; =8; }\n";
	both(t, input, input);
	both(t, "layout L #hint(fun ();=1) {=4; }\n", "layout L #hint(fun (); = 1) {=4; }\n");
}
def operator_members(t: Tester) {
	// Operator member names are single tokens (spike rule bug 2).
	var input = body("\tvar d = double.!=, e = float.!=, g = m.[]=, h = Record.==, i = int.<=;\n");
	both(t, input, input);
	// A token after a '.' is a member's name, also one spelled as an
	// assignment: "x.+=(1)" calls the member "+=".
	input = "def f(x: int) {\n\tx.+=(1);\n\tx.-=(2);\n\tx.<<=(3);\n\tx.>>>=(4);\n\tvar g = x.|=, h = x.^=;\n\tx.->(5);\n}\n";
	both(t, input, input);
	// A member's name before '=' is a name, and the '=' an assignment.
	both(t, "def f(x: int) {\n\tvar g=x.+=, h=x.y;\n\tx.y=1;\n}\n", "def f(x: int) {\n\tvar g = x.+=, h = x.y;\n\tx.y = 1;\n}\n");
}
def arrows(t: Tester) {
	both(t, "def f(g: int->bool)->int=>0;\ndef h(x: int) {\n\tmatch (x) {\n\t\t1=>;\n\t\t2  =>  x++;\n\t\t_ =>\tx--;\n\t}\n\tvar k = fun(y: int)=>y, l: (int, int)->int;\n}\n",
		"def f(g: int -> bool) -> int => 0;\ndef h(x: int) {\n\tmatch (x) {\n\t\t1 => ;\n\t\t2  =>  x++;\n\t\t_ =>\tx--;\n\t}\n\tvar k = fun(y: int) => y, l: (int, int) -> int;\n}\n");
	// A tab or several spaces around "->" align a column.
	var input = "def f(g: int  ->\tbool) ->  int { return 0; }\n";
	both(t, input, input);
	// Columns of "=>" stay aligned.
	input = body("\tmatch (x) {\n\t\t1     => x++;\n\t\t22    => x--;\n\t\t_\t=> ;\n\t}\n");
	both(t, input, input);
}
def commas(t: Tester) {
	both(t, body("\tm.set(1,2);\n\tvar a = [1,2,\n\t\t3,  4], b = (1,\t2);\n"),
		body("\tm.set(1, 2);\n\tvar a = [1, 2,\n\t\t3,  4], b = (1,\t2);\n"));
	both(t, "def a = [1, 2,];\n", "def a = [1, 2, ];\n");
	// Spaces before a comma align a table's columns (spike rule bug 10).
	var input = body("\tput2(JMP , ref(label));\n\tput2(MSTB     , reg.tag);\n");
	both(t, input, input);
}
def braces(t: Tester) {
	both(t, "class C{\n\tdef m(){ }\n\tdef n()-> int{ return 1; }\n}\ndef f(c: bool) {\n\tif (c){ }\n\twhile (c){ }\n\tvar g = fun (){ };\n}\n",
		"class C {\n\tdef m() { }\n\tdef n() -> int { return 1; }\n}\ndef f(c: bool) {\n\tif (c) { }\n\twhile (c) { }\n\tvar g = fun () { };\n}\n");
	// The '{' columns of one-line methods stay aligned.
	var input = "class C {\n\tdef a()     { }\n\tdef bcd()\t{ }\n\tdef e() -> int { return 1; }\n}\n";
	both(t, input, input);
}
def else_spacing(t: Tester) {
	// Exactly one space in "} else", "else {", and "else if", replacing
	// any gap within the line.
	both(t, body("\tif (c) { }else{ }\n\tif (c) { }  else\t{ }\n\tif (c) { }else if(c) { }\n\tif (c) x++; else  if (c) x--;\n\tmatch (x) {\n\t\t1 => ;\n\t}else{ }\n"),
		body("\tif (c) { } else { }\n\tif (c) { } else { }\n\tif (c) { } else if (c) { }\n\tif (c) x++; else if (c) x--;\n\tmatch (x) {\n\t\t1 => ;\n\t} else { }\n"));
	// "else" as a member name isn't the keyword.
	var input = body("\tif (c) { }\n\tm.else  (1);\n");
	both(t, input, input);
}
def empty_bodies(t: Tester) {
	both(t, "class A {}\nclass B {   }\nclass C {\t}\ndef f() {\n\t{}\n\tvar g = fun () {};\n}\nenum E {}\n",
		"class A { }\nclass B { }\nclass C { }\ndef f() {\n\t{ }\n\tvar g = fun () { };\n}\nenum E { }\n");
	// An empty body over two lines stays.
	var input = "class A {\n}\nclass B {\n\n}\n";
	both(t, input, input);
}
def trailing_comments(t: Tester) {
	// At least one space before a line comment after code, also after a
	// block comment that follows code on its line; alignment before it stays.
	both(t, body("\tx++;// one\n\tx--;    // two\n\tx++;\t// three\n\tx--; /* four */// five\n\tm.set(1,// six\n\t\t2);\n"),
		body("\tx++; // one\n\tx--;    // two\n\tx++;\t// three\n\tx--; /* four */ // five\n\tm.set(1, // six\n\t\t2);\n"));
	// A block comment after code gets no space: the rule names only "//".
	var input = body("\tx++;/* one */\n");
	both(t, input, input);
}
def comment_only_lines(t: Tester) {
	// A line comment after only comments on its line isn't after code, at
	// file level, in a body, or after a block comment that ends a line
	// with code before it.
	var input = "/* heading */// notes\ndef f() {\n\t/* a */// b\n\tf(); /* c\n\t d *///e\n}\n/* f */ /* g *///h\n";
	both(t, input, input);
	// After code, with block comments between them.
	both(t, "def x = 1; /* a */ /* b */// c\n", "def x = 1; /* a */ /* b */ // c\n");
}
def spacing_next_to_comments(t: Tester) {
	// A gap next to a block comment is kept, so the comment keeps its
	// place: only gaps between two tokens change.
	var input = body("\tx/* a */=1;\n\tif /* b */(c) x++;\n\tif (c) { }/* c */else { }\n\tvar y:/* d */int;\n\tm.set(1,/* e */2);\n");
	both(t, input, body("\tx/* a */= 1;\n\tif /* b */(c) x++;\n\tif (c) { }/* c */else { }\n\tvar y:/* d */int;\n\tm.set(1,/* e */2);\n"));
}
def spacing_keeps_line_breaks(t: Tester) {
	// The exact gaps apply only within a line: no line break is removed
	// beyond the two joins.
	var input = body("\tif\n\t\t(c) x++;\n\tmatch\n\t\t(x) {\n\t\t_ => ;\n\t}\n\tvar y = if\n\t\t(c, 1, 2);\n\tif (c) {\n\t}\n\n\telse\n\t\tif (c) x++;\n\tvar z =\n\t\t1, w\n\t\t= 2;\n\tm.set(1\n\t\t, 2);\n");
	both(t, input, input);
	// A join gives exactly one space, and the gaps after it follow the rules.
	both(t, body("\tif (c) {\n\t}\n\telse{ }\n\tif (c)\n\t{ }\n"), body("\tif (c) {\n\t} else { }\n\tif (c) { }\n"));
}
def spacing_unchanged(t: Tester) {
	// Spacing that ADR-0019 doesn't name stays.
	var input = "type T #unboxed { case A; }\ndef f(x: Array< int >, y:Array<int>) -> int {\n\treturn ( x.length+y [0] )*2;\n}\n";
	both(t, input, "type T #unboxed { case A; }\ndef f(x: Array< int >, y: Array<int>) -> int {\n\treturn ( x.length+y [0] )*2;\n}\n");
}
def spacing_crlf(t: Tester) {
	both(t, "def f(c: bool) {\r\n\tif(c) { }else{}\r\n\tvar y=if (c, 1, 2);// note\r\n}\r\n",
		"def f(c: bool) {\r\n\tif (c) { } else { }\r\n\tvar y = if(c, 1, 2); // note\r\n}\r\n");
}
def spacing_in_one_run(t: Tester) {
	// Each changed run gets one edit, an insertion with an empty range, and
	// runs on either side of a token get their own.
	var input = "def x=1;\n";
	var edits = both(t, input, "def x = 1;\n");
	t.asserti(2, edits.length);
	if (edits.length == 2) {
		t.assert(edits[0].begin == 5 && edits[0].end == 5 && Strings.equal(" ", edits[0].text), "an insertion before '='");
		t.assert(edits[1].begin == 6 && edits[1].end == 6 && Strings.equal(" ", edits[1].text), "an insertion after '='");
	}
	// A run whose line is reindented gets one edit for its line end and
	// indentation, and the gaps within the line their own.
	edits = both(t, "def f() {  \n      var y:int=1;\n}\n", "def f() {\n\tvar y: int = 1;\n}\n");
	t.asserti(4, edits.length);
}

// Every "if" keyword in aeneas/src, lib, and apps that parse has
// the kind that the parse tree gives it (IfStmt or IfExpr), by a walk of the
// tree separate from AnalysisFormatMarks; one that the walk doesn't reach
// fails, so a node that both walks miss can't pass unseen.
def corpus_if_kinds(t: Tester) {
	var paths = Vector<string>.new();
	for (dir in ["vendor/virgil/aeneas/src", "vendor/virgil/lib", "vendor/virgil/apps"]) sources(t, dir, paths);
	// At the pin, 298 of the 299 files parse (docs/testing-notes/formatter-spike.md),
	// with 9,854 if statements and 1,139 if expressions.
	var minimum = 298, checked = 0, statements = 0, expressions = 0;
	var knownExclusion = "vendor/virgil/lib/file/class/Layouts.v3";
	var unexpected = Vector<string>.new();
	var syntax = SymbolSyntaxIndex.new();
	for (i < paths.length) {
		var path = paths[i], text = System.fileLoad(path);
		if (text == null) {
			t.fail1("can't read %s", path);
			continue;
		}
		var input = AeneasAdapter.normalizedRange(text, 0, text.length), errors = AnalysisParseErrors.new(1);
		syntax.clear();
		var file = AnalysisSingleFileParser.parse(path, input, errors, syntax, TypeCache.new(), null);
		if (Strings.equal(path, knownExclusion)) {
			if (errors.numErrors == 0) t.fail1("%s parses without its required language option", path);
			continue;
		}
		if (errors.numErrors > 0) {
			unexpected.put(path);
			continue;
		}
		var walk = IfKinds.new(syntax).file(file);
		var marks = AnalysisFormatMarks.new(file, syntax).collect();
		var f = DocumentFormatter.new(input, syntax, marks.bits, marks.funHeaders, ONE);
		for (k < syntax.count) {
			var b = syntax.begin(k);
			if (syntax.end(k) - b != 2 || input[b] != 'i' || input[b + 1] != 'f') continue;
			var bits = marks.bits[k];
			if ((bits & AnalysisFormatMark.MATCH) != 0) t.fail2("%s: the \"if\" at offset %d is marked as a match", path, b);
			var member = k > 0 && syntax.single(input, k - 1) == '.';
			var expected = walk.kinds[k];
			if (expected == IF_NONE && !member) {
				t.fail2("%s: the walk doesn't reach the \"if\" at offset %d", path, b);
				continue;
			}
			// The marks of a statement and an expression exclude each other,
			// and the spacing rule's own reading of them gives the kind.
			var both = AnalysisFormatMark.CONTROL | AnalysisFormatMark.IF_EXPR;
			if ((bits & both) == both) t.fail2("%s: the \"if\" at offset %d is marked as both kinds", path, b);
			var space = f.keywordSpace(k);
			var got = if(space > 0, IF_STATEMENT, if(space == 0, IF_EXPRESSION, IF_NONE));
			if (got != expected) t.fail3("%s: the \"if\" at offset %d is the parse tree's %s", path, b, KIND_NAMES[expected]);
			if (expected == IF_STATEMENT) statements++;
			else if (expected == IF_EXPRESSION) expressions++;
		}
		checked++;
	}
	if (checked < minimum) {
		var message = StringBuilder.new().put2("checked %d files, expected at least %d", checked, minimum);
		for (i < unexpected.length) message.puts(". Could not parse ").puts(unexpected[i]);
		t.fail(message.toString());
	}
	t.assert(statements > 9000 && expressions > 1000, Strings.format2("%d statements and %d expressions", statements, expressions));
}
// The first change is measured without building edits, for the command's
// --check, and is where the first edit begins.
def first_change(t: Tester) {
	for (eof in [ONE, MIRROR]) {
		t.asserti(-1, AeneasAdapter.formatting(PATH, "def f() { }\n", OPTIONS, eof).firstChange());
		t.asserti(-1, AeneasAdapter.formatting(PATH, "def f( {\n", OPTIONS, eof).firstChange());
		t.asserti(-1, AeneasAdapter.formatting(PATH, "def f() // note\r -> int\n{\n}\n", OPTIONS, eof).firstChange());
		t.asserti(20, AeneasAdapter.formatting(PATH, "def f() { }\n\ndef g(){ }\n", OPTIONS, eof).firstChange());
		t.asserti(0, AeneasAdapter.formatting(PATH, "\n\n", OPTIONS, eof).firstChange());
		t.asserti(-1, AeneasAdapter.formatting(PATH, "/* note\n\n", OPTIONS, eof).firstChange());
	}
	// A final line end is inserted at the end, only for the command.
	t.asserti(11, AeneasAdapter.formatting(PATH, "def f() { }", OPTIONS, ONE).firstChange());
	t.asserti(-1, AeneasAdapter.formatting(PATH, "def f() { }", OPTIONS, MIRROR).firstChange());
	// Measuring again after building the edits gives the same offset.
	var r = AeneasAdapter.formatting(PATH, "def f() {\n  var x=1;\n}\n", OPTIONS, ONE);
	t.asserti(10, r.firstChange());
	var edits = r.edits();
	t.asserti(10, r.firstChange());
	if (edits != null && edits.length > 0) t.asserti(10, edits[0].begin);
}

def IF_NONE: byte = 0;
def IF_STATEMENT: byte = 1;
def IF_EXPRESSION: byte = 2;
def KIND_NAMES = ["member name", "if statement", "if expression"];
// Adds the .v3 files under {dir} to {paths}, in name order.
def sources(t: Tester, dir: string, paths: Vector<string>) {
	var listing = ProjectFiles.list(dir, 4096);
	if (listing.names == null) return t.fail1("%s is not listed", dir);
	for (i < listing.names.length) {
		var name = listing.names[i], path = ProjectFiles.join(dir, name);
		var directory = listing.types[i] == DT_DIR;
		if (listing.types[i] == DT_UNKNOWN) {
			// A file system that doesn't report entry types, as workspace
			// discovery handles them (WorkspaceProjects).
			var meta = ProjectFiles.metadata(path);
			if (meta.0 < 0) {
				t.fail1("can't inspect %s", path);
				continue;
			}
			directory = meta.0 == ProjectFiles.DIRECTORY;
		}
		if (directory) sources(t, path, paths);
		else if (Strings.endsWith(name, ".v3")) paths.put(path);
	}
}
def DT_UNKNOWN: byte = 0;
def DT_DIR: byte = 4;
// The kind of each "if" token, by a recursive walk of every declaration,
// statement, and expression of a file.
class IfKinds(syntax: SymbolSyntaxIndex) extends VstVisitor<void, void> {
	def kinds = Array<byte>.new(syntax.count);

	def file(f: VstFile) -> this {
		for (i < f.classes.length) compound(f.classes[i]);
		for (i < f.components.length) compound(f.components[i]);
		for (i < f.enums.length) compound(f.enums[i]);
		for (i < f.layouts.length) compound(f.layouts[i]);
		for (i < f.exports.length) expr(f.exports[i].expr);
	}
	private def at(p: FilePoint, kind: byte) {
		var k = syntax.findAt(p.beginLine, p.beginColumn);
		if (k >= 0) kinds[k] = kind;
	}
	private def compound(d: VstCompound) {
		hints(d.repHints);
		if (d.superclause != null) expr(d.superclause.args);
		for (l = d.members; l != null; l = l.tail) {
			var m = l.head;
			hints(m.repHints);
			match (m) {
				x: VstNew => {
					if (x.superclause != null) expr(x.superclause.args);
					stmt(x.func.body);
				}
				x: VstMethod => stmt(x.func.body);
				x: VstField => expr(x.init);
				x: VstEnumCase => exprs(x.args);
				_ => ;
			}
		}
	}
	private def hints(h: List<VstRepHint>) {
		for (l = h; l != null; l = l.tail) {
			match (l.head) {
				ExprHint(_, es) => exprs(es);
				_ => ;
			}
		}
	}
	private def stmt(s: Stmt) {
		if (s != null) s.accept(this, ());
	}
	private def expr(e: Expr) {
		if (e != null) e.accept(this, ());
	}
	private def exprs(l: VstList<Expr>) {
		if (l != null) for (e = l.list; e != null; e = e.tail) expr(e.head);
	}
	private def local(v: VarDecl) {
		if (v != null) expr(v.init);
	}

	def visitIf(s: IfStmt, env: void) {
		at(s.start, IF_STATEMENT);
		expr(s.cond);
		stmt(s.tbranch);
		stmt(s.fbranch);
	}
	def visitBlock(s: BlockStmt, env: void) {
		if (s.stmts != null) for (l = s.stmts.list; l != null; l = l.tail) stmt(l.head);
	}
	def visitWhile(s: WhileStmt, env: void) {
		expr(s.cond);
		stmt(s.body);
	}
	def visitFor(s: ForStmt, env: void) {
		local(s.varDecl);
		expr(s.cond);
		expr(s.update);
		stmt(s.body);
	}
	def visitForeach(s: ForeachStmt, env: void) {
		local(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitForLess(s: ForLessStmt, env: void) {
		local(s.varDecl);
		expr(s.expr);
		stmt(s.body);
	}
	def visitLocal(s: LocalStmt, env: void) {
		for (l = s.vars; l != null; l = l.tail) {
			hints(l.head.repHints);
			local(l.head);
		}
	}
	def visitBreak(s: BreakStmt, env: void) { }
	def visitContinue(s: ContinueStmt, env: void) { }
	def visitExpr(s: ExprStmt, env: void) {
		expr(s.expr);
	}
	def visitMatch(s: MatchStmt, env: void) {
		expr(s.expr);
		if (s.cases != null) for (l = s.cases.list; l != null; l = l.tail) stmt(l.head.stmt);
	}
	def visitEmpty(s: EmptyStmt, env: void) { }
	def visitReturn(s: ReturnStmt, env: void) {
		expr(s.expr);
	}
	def visitTuple(e: TupleExpr, env: void) {
		exprs(e.exprs);
	}
	def visitParamExpr(e: ParamExpr, env: void) { }
	def visitAutoExpr(e: AutoExpr, env: void) {
		expr(e.expr);
	}
	def visitArray(e: ArrayExpr, env: void) {
		exprs(e.exprs);
	}
	def visitVar(e: VarExpr, env: void) {
		expr(e.expr);
	}
	def visitLiteral(e: Literal, env: void) { }
	def visitString(e: StringExpr, env: void) { }
	def visitApp(e: AppExpr, env: void) {
		expr(e.func);
		expr(e.args);
	}
	def visitIndex(e: IndexExpr, env: void) {
		expr(e.expr);
		exprs(e.exprs);
	}
	def visitRange(e: RangeExpr, env: void) {
		expr(e.expr);
		expr(e.start);
		expr(e.end);
	}
	def visitNot(e: NotExpr, env: void) {
		expr(e.expr);
	}
	def visitNeg(e: NegExpr, env: void) {
		expr(e.expr);
	}
	def visitBitwiseNeg(e: BitwiseNegExpr, env: void) {
		expr(e.expr);
	}
	def visitAssign(e: AssignExpr, env: void) {
		expr(e.target);
		expr(e.expr);
	}
	def visitBinOp(e: BinOpExpr, env: void) {
		expr(e.left);
		expr(e.right);
	}
	def visitIfExpr(e: IfExpr, env: void) {
		at(e.start, IF_EXPRESSION);
		exprs(e.exprs);
	}
	def visitFunExpr(e: FunExpr, env: void) {
		if (e.func != null) stmt(e.func.body);
	}
}
