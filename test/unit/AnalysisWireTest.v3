def SHAPES = "test/fixtures/analysis/two-file/shapes.v3";
def MAIN = "test/fixtures/analysis/two-file/main.v3";
def UNRESOLVED = "test/fixtures/analysis/unresolved/main.v3";
def SYNTAX_ERROR = "test/fixtures/analysis/syntax-error/main.v3";
def COVERAGE = "test/fixtures/analysis/occurrence-coverage/main.v3";
def CALL_SITES = "test/fixtures/analysis/call-sites/main.v3";

def load(t: Tester, paths: Array<string>) -> Array<AnalysisSource> {
	var sources = Array<AnalysisSource>.new(paths.length);
	for (i < paths.length) {
		var input = System.fileLoad(paths[i]);
		if (input == null) {
			t.fail1("cannot read %s; run the unit tests from the repository root", paths[i]);
			return null;
		}
		sources[i] = AnalysisSource.new(paths[i], input);
	}
	return sources;
}
// The payload of a frame.
def payloadOf(frame: Range<byte>) -> Array<byte> {
	return Ranges.dup(frame[WorkerFraming.HEADER_BYTES ...]);
}
// Encodes {analysis} as a worker would, with every distinct path's occurrences
// if {occurrences}, and decodes it as the server would.
def roundTrip(sources: Array<AnalysisSource>, analysis: ProgramAnalysis, occurrences: bool) -> (Array<byte>, AnalysisWorkerResult) {
	var paths = Array<string>.new(sources.length);
	for (i < paths.length) paths[i] = sources[i].path;
	var files: Array<(string, Array<AnalysisOccurrence>)>;
	if (occurrences) {
		var list = Vector<(string, Array<AnalysisOccurrence>)>.new();
		for (p in paths) list.put((p, analysis.occurrences(p)));
		files = list.extract();
	}
	var w = AnalysisWire.encodeResult(7, 3, 4567, analysis, if(occurrences, 12, -1), 42, files);
	var payload = payloadOf(AnalysisWire.finishResult(w, 123456789012L));
	return (payload, decodedResult(payload, 5, paths));
}
// Existing snapshot comparisons only need the successfully decoded result.
def decodedResult(payload: Array<byte>, generation: int, paths: Array<string>) -> AnalysisWorkerResult {
	match (AnalysisWire.decodeResult(payload, generation, paths)) {
		Decoded(result) => return result;
		_ => return null;
	}
}
def render(d: AnalysisDeclaration) -> string {
	return if(d == null, "null", d.render(StringBuilder.new()).toString());
}

def test_orphan_alarm(t: Tester) {
	// No limit, no alarm; otherwise twice the limit plus a second, capped.
	t.asserti(0, AnalysisWire.orphanAlarmMs(0));
	t.asserti(0, AnalysisWire.orphanAlarmMs(-5));
	t.asserti(3000, AnalysisWire.orphanAlarmMs(1000));
	t.asserti(4000, AnalysisWire.orphanAlarmMs(1500));
	t.asserti(int.max, AnalysisWire.orphanAlarmMs(int.max / 2));
	t.asserti(int.max, AnalysisWire.orphanAlarmMs(int.max));
}
def test_hello_round_trip(t: Tester) {
	var hello = AnalysisWire.decodeHello(payloadOf(AnalysisWire.encodeHello("1.2.3", "abc-dirty", 402653184L)));
	if (hello == null) return t.fail("hello did not decode");
	t.asserti(AnalysisWire.PROTOCOL_VERSION, hello.protocol);
	t.assert_string("1.2.3", hello.version);
	t.assert_string("abc-dirty", hello.revision);
	t.assertl(402653184L, hello.heapBytes);
}

def test_analyze_round_trip(t: Tester) {
	var sources = [AnalysisSource.new("a.v3", "class A { }\n"), AnalysisSource.new("empty.v3", null),
		AnalysisSource.new(null, "\x00\xFF")];
	var flags = AnalysisWire.WANT_OCCURRENCES | AnalysisWire.WANT_STATS;
	var options = ["-lang:simple-bodies=false", "-lang:fun-exprs", "-lang:descriptors"];
	var frame = AnalysisWire.encodeAnalyze(99, flags, 2500, options, sources, null);
	t.assertl(long.view(frame.length), AnalysisWire.analyzeFrameSize(99, flags, 2500, options, sources, null));
	var r = AnalysisWire.decodeAnalyze(payloadOf(frame));
	if (r == null) return t.fail("request did not decode");
	t.asserti(99, r.id);
	t.asserti(flags, r.flags);
	t.asserti(2500, r.timeoutMs);
	// Options keep their order, which decides their effect.
	t.asserti(options.length, r.options.length);
	for (i < options.length) t.assert_string(options[i], r.options[i]);
	t.asserti(3, r.sources.length);
	t.assert_string("a.v3", r.sources[0].path);
	t.assert_string("class A { }\n", r.sources[0].input);
	// A missing input is sent as empty bytes, never read from disk.
	t.asserti(0, r.sources[1].input.length);
	t.assert(r.sources[2].path == null, "null path");
	t.assert_string("\x00\xFF", r.sources[2].input);
}

def test_analyze_frame_size(t: Tester) {
	var values = [int.min, -8193, -8192, -65, -64, -1, 0, 63, 64, 8191, 8192, int.max];
	for (value in values) {
		var sources = [AnalysisSource.new(null, null), AnalysisSource.new("", "")];
		var frame = AnalysisWire.encodeAnalyze(value, value, value, [], sources, null);
		t.assertl(long.view(frame.length), AnalysisWire.analyzeFrameSize(value, value, value, [], sources, null));
	}
	for (length in [0, 63, 64, 8191, 8192]) {
		var bytes = Array<byte>.new(length);
		var sources = [AnalysisSource.new(bytes, bytes)];
		var frame = AnalysisWire.encodeAnalyze(1, 0, 10000, [], sources, null);
		t.assertl(long.view(frame.length), AnalysisWire.analyzeFrameSize(1, 0, 10000, [], sources, null));
		var options = Array<string>.new(length);
		for (i < options.length) options[i] = "-lang:descriptors";
		frame = AnalysisWire.encodeAnalyze(1, 0, 10000, options, [], null);
		t.assertl(long.view(frame.length), AnalysisWire.analyzeFrameSize(1, 0, 10000, options, [], null));
		sources = Array<AnalysisSource>.new(length);
		for (i < sources.length) sources[i] = AnalysisSource.new(null, null);
		frame = AnalysisWire.encodeAnalyze(1, 0, 10000, [], sources, null);
		t.assertl(long.view(frame.length), AnalysisWire.analyzeFrameSize(1, 0, 10000, [], sources, null));
	}
}

// The snapshot answers every query as the analysis it was encoded from does.
def test_result_matches_analysis(t: Tester) {
	var sources = load(t, [SHAPES, MAIN]);
	if (sources == null) return;
	var analysis = AeneasAdapter.analyzeProgram(sources, [], false);
	var rt = roundTrip(sources, analysis, true), result = rt.1;
	if (result == null) return t.fail("result did not decode");
	t.asserti(7, result.id);
	t.asserti(3, result.state.analyses);
	t.asserti(4567, result.state.uidNext);
	t.assertl(123456789012L, result.state.liveBytes);
	var s = result.snapshot;
	t.asserti(5, s.generation);
	t.assertz(true, s.parsed);
	t.assertz(true, s.verified);
	t.assertz(true, s.hasOccurrences);
	t.asserti(2, s.paths.length);
	t.asserti(analysis.stats.parseUs, s.stats.parseUs);
	t.asserti(analysis.stats.verifyUs, s.stats.verifyUs);
	t.asserti(12, s.stats.collectUs);
	t.asserti(analysis.stats.uidsUsed, s.stats.uidsUsed);
	t.asserti(4567, s.stats.uidNext);
	t.asserti(-1, s.stats.globalTypesAdded);
	t.asserti(42, s.stats.globalTypeTotal);
	t.asserti(0, s.stats.skippedUses);
	var count = 0;
	for (k < sources.length) {
		var path = sources[k].path, input = sources[k].input;
		var want = analysis.occurrences(path), got = s.occurrences(path);
		t.asserti(want.length, got.length);
		if (want.length != got.length) return;
		count += got.length;
		for (i < want.length) {
			t.assert_string(want[i].toString(), got[i].toString());
			// Every column of every use, and the column just past it.
			var r = want[i].range;
			for (c = r.beginColumn - 1; c <= r.endColumn; c++) {
				t.assert_string(render(analysis.definitionAt(path, r.beginLine, c)), render(s.definitionAt(path, r.beginLine, c)));
			}
			assertOffsets(t, r, got[i].range);
			var d = want[i].declaration.range;
			assertOffsets(t, d, got[i].declaration.range);
			// A declaration's bytes, in its own file, spell its name.
			for (source in sources) {
				if (!Strings.equal(source.path, d.path) || d.beginOffset < 0 || d.endOffset > source.input.length) continue;
				t.assert_string(want[i].declaration.name, Arrays.range(source.input, d.beginOffset, d.endOffset));
			}
			// This fixture has no comments, so the context-free conversion of
			// a use's offsets is exact. Every byte resolves to its declaration;
			// the bytes just before and after it do not.
			var map = PositionMap.new(input, PositionEncoding.UTF16);
			var begin = map.offsetToCompiler(r.beginOffset), end = map.offsetToCompiler(r.endOffset);
			t.asserti(r.beginLine, begin.0);
			t.asserti(r.beginColumn, begin.1);
			t.asserti(r.endLine, end.0);
			t.asserti(r.endColumn, end.1);
			for (b = r.beginOffset; b < r.endOffset; b++) {
				t.assert_string(render(want[i].declaration), render(s.definitionAtOffset(path, b)));
			}
			t.assert(s.definitionAtOffset(path, r.beginOffset - 1) == null, "byte before a use");
			t.assert(s.definitionAtOffset(path, r.endOffset) == null, "exclusive end offset");
			if (i > 0) t.assert(want[i - 1].range.endOffset <= r.beginOffset, "uses are in byte order");
		}
	}
	t.asserti(14, count);
	// Each distinct declaration is sent once: the 11 that the files name,
	// which include every occurrence's target.
	t.asserti(11, s.declarations.length);
	t.assert(s.definitionAt("other.v3", 1, 1) == null, "unknown path");
	t.assert(s.definitionAtOffset("other.v3", 0) == null, "unknown path offset");
	t.asserti(0, s.occurrences("other.v3").length);
}

def assertOffsets(t: Tester, want: AnalysisRange, got: AnalysisRange) {
	t.asserti(want.beginOffset, got.beginOffset);
	t.asserti(want.endOffset, got.endOffset);
	t.assert(want.beginOffset >= 0 && want.endOffset > want.beginOffset, "nonempty byte range");
}

def test_result_with_errors(t: Tester) {
	for (paths in [[SHAPES, UNRESOLVED], [SHAPES, SYNTAX_ERROR]]) {
		var sources = load(t, paths);
		if (sources == null) return;
		var analysis = AeneasAdapter.analyzeProgram(sources, [], true);
		var r = roundTrip(sources, analysis, true).1;
		if (r == null) return t.fail("result did not decode");
		var s = r.snapshot;
		t.assertz(analysis.parsed, s.parsed);
		t.assertz(false, s.verified);
		t.asserti(analysis.stats.globalTypesAdded, s.stats.globalTypesAdded);
		t.asserti(analysis.diagnostics.length, s.diagnostics.length);
		for (i < s.diagnostics.length) {
			t.assert_string(analysis.diagnostics[i].toString(), s.diagnostics[i].toString());
			t.asserti(analysis.diagnostics[i].beginOffset, s.diagnostics[i].beginOffset);
			t.asserti(analysis.diagnostics[i].endOffset, s.diagnostics[i].endOffset);
		}
		for (p in paths) t.asserti(analysis.occurrences(p).length, s.occurrences(p).length);
	}
}

def test_result_without_occurrences(t: Tester) {
	var sources = load(t, [SHAPES, MAIN]);
	if (sources == null) return;
	var r = roundTrip(sources, AeneasAdapter.analyzeProgram(sources, [], false), false).1;
	if (r == null) return t.fail("result did not decode");
	var s = r.snapshot;
	t.assertz(false, s.hasOccurrences);
	t.asserti(-1, s.stats.collectUs);
	t.asserti(-1, s.stats.skippedUses);
	t.asserti(0, s.declarations.length);
	t.asserti(0, s.occurrences(MAIN).length);
	t.assert(s.definitionAt(MAIN, 4, 25) == null, "no occurrences were sent");
	t.assert(s.definitionAtOffset(MAIN, 85) == null, "no occurrences were sent");
}

// Bulk writes and header patches preserve bytes and the high-water mark in
// the presized buffer, as finishResult's two patches require.
def test_result_buffer_writes(t: Tester) {
	var data = Array<byte>.new(17001);
	for (i < data.length) data[i] = byte.view(i);
	var w = DataWriter.new().grow(18014).put_b32(0).put_b64(0);
	for (i < 1000) w.putb(i);
	w.puta(data);
	var end = w.end();
	w.at(0).put_b32(end - 4).at(4).put_b64(123456789L).atEnd();
	var expected = DataWriter.new().put_b32(end - 4).put_b64(123456789L);
	for (i < 1000) expected.putb(i);
	expected.puta(data);
	t.asserti(expected.end(), w.pos);
	t.assertb(expected.copy(), w.copy());
	w.putb(42);
	expected.putb(42);
	t.assertb(expected.copy(), w.copy());
	t.asserti(w.end(), w.data.length);
}

// Make a diagnostic-bearing result with exactly {bytes} frame bytes. Both
// trial and final message lengths have the same signed LEB width here.
def paddedResult(bytes: int) -> DataWriter {
	var message = Array<byte>.new(bytes);
	var diagnostic = AnalysisDiagnostic.new("p.v3", 1, 1, 1, 1, "Error", message);
	var analysis = ProgramAnalysis.new([diagnostic], AnalysisStats.new(0, 0, 0, -1), false, false, null);
	var trial = AnalysisWire.encodeResult(1, 1, 1, analysis, -1, -1, null);
	var overhead = trial.end() - bytes;
	diagnostic = AnalysisDiagnostic.new("p.v3", 1, 1, 1, 1, "Error", Ranges.dup(message[0 ... bytes - overhead]));
	analysis = ProgramAnalysis.new([diagnostic], AnalysisStats.new(0, 0, 0, -1), false, false, null);
	return AnalysisWire.encodeResult(1, 1, 1, analysis, -1, -1, null);
}

def test_result_buffer_capacity(t: Tester) {
	for (bytes in [255, 256, 257]) {
		var w = paddedResult(bytes);
		t.asserti(bytes, w.end());
		var capacity = (bytes + 7) & ~7;
		t.asserti(capacity, w.data.length);
		t.asserti(bytes, AnalysisWire.finishResult(w, 123L).length);
		t.asserti(capacity, w.data.length);
	}
	for (paths in [[SHAPES, MAIN], [SHAPES, UNRESOLVED], [SHAPES, SYNTAX_ERROR]]) {
		var sources = load(t, paths);
		if (sources == null) return;
		var analysis = AeneasAdapter.analyzeProgram(sources, [], true);
		for (occurrences in [false, true]) {
			var files: Array<(string, Array<AnalysisOccurrence>)>;
			if (occurrences) files = [(paths[0], analysis.occurrences(paths[0])), (paths[1], analysis.occurrences(paths[1]))];
			var w = AnalysisWire.encodeResult(1, 1, 1, analysis, -1, -1, files);
			t.asserti((w.end() + 7) & ~7, w.data.length);
			t.asserti(w.end(), AnalysisWire.finishResult(w, 123L).length);
		}
	}
}

// The sizing pass counts exactly the bytes that the real pass writes, for
// every result shape. An undercount would silently regress to buffer growth,
// and an overcount would waste memory; see encodeResultWithQuery.
def assertCounted(t: Tester, what: string, sized: (DataWriter, long)) {
	var written = long.view(sized.0.end());
	if (written != sized.1) t.fail3("%s: the sizer counted %d bytes but the writer wrote %d", what, sized.1, written);
}

// The counted encoding of the diagnostic-bearing result that {paddedResult}
// makes, with exactly {bytes} frame bytes.
def paddedCounted(bytes: int) -> (DataWriter, long) {
	var message = Array<byte>.new(bytes);
	var diagnostic = AnalysisDiagnostic.new("p.v3", 1, 1, 1, 1, "Error", message);
	var analysis = ProgramAnalysis.new([diagnostic], AnalysisStats.new(0, 0, 0, -1), false, false, null);
	var trial = AnalysisWire.encodeResult(1, 1, 1, analysis, -1, -1, null);
	var overhead = trial.end() - bytes;
	diagnostic = AnalysisDiagnostic.new("p.v3", 1, 1, 1, 1, "Error", Ranges.dup(message[0 ... bytes - overhead]));
	analysis = ProgramAnalysis.new([diagnostic], AnalysisStats.new(0, 0, 0, -1), false, false, null);
	return AnalysisWire.encodeResultWithQueryCounted(1, 1, 1, analysis, -1, -1, null, null, null, null);
}

def test_result_size_matches_writes(t: Tester) {
	// Success, with and without occurrences; unresolved and syntax errors.
	for (paths in [[SHAPES, MAIN], [SHAPES, UNRESOLVED], [SHAPES, SYNTAX_ERROR]]) {
		var sources = load(t, paths);
		if (sources == null) return;
		var analysis = AeneasAdapter.analyzeProgram(sources, [], true);
		for (occurrences in [false, true]) {
			var files: Array<(string, Array<AnalysisOccurrence>)>;
			if (occurrences) files = [(paths[0], analysis.occurrences(paths[0])), (paths[1], analysis.occurrences(paths[1]))];
			assertCounted(t, paths[1], AnalysisWire.encodeResultWithQueryCounted(1, 1, 1, analysis, -1, -1, files, null, null, null));
		}
	}
	// An empty program, with and without an occurrence section.
	var empty = AeneasAdapter.analyzeProgram([], [], false);
	assertCounted(t, "empty without occurrences", AnalysisWire.encodeResultWithQueryCounted(1, 1, 1, empty, -1, -1, null, null, null, null));
	assertCounted(t, "empty with occurrences", AnalysisWire.encodeResultWithQueryCounted(1, 1, 1, empty, -1, -1, [], null, null, null));
	// Diagnostics only, with a message long enough for a multi-byte length.
	var message = Array<byte>.new(300);
	var diagnostic = AnalysisDiagnostic.new("p.v3", 1, 1, 1, 1, "Error", message);
	var diagnosticsOnly = ProgramAnalysis.new([diagnostic], AnalysisStats.new(0, 0, 0, -1), false, false, null);
	assertCounted(t, "diagnostics only", AnalysisWire.encodeResultWithQueryCounted(1, 1, 1, diagnosticsOnly, -1, -1, null, null, null, null));
	// The allocation boundaries, where a one-byte undercount hides in the
	// padding.
	for (bytes in [255, 256, 257]) {
		var sized = paddedCounted(bytes);
		assertCounted(t, "boundary", sized);
		t.asserti(bytes, sized.0.end());
	}
	// Scope, member, and call answers, with and without occurrences.
	var scopedSources = scopeSources(), scoped = AeneasAdapter.analyzeForScope(scopedSources, [], false);
	var scopedFiles = [("s.v3", scoped.occurrences("s.v3")), ("t.v3", scoped.occurrences("t.v3"))];
	var scope = scoped.scopeAt("s.v3", 0, AnalysisScopeKinds.TYPES, "");
	assertCounted(t, "scope", AnalysisWire.encodeResultWithQueryCounted(7, 3, 4567, scoped, 12, 42, scopedFiles, scope, null, null));
	assertCounted(t, "scope without files", AnalysisWire.encodeResultWithQueryCounted(7, 3, 4567, scoped, -1, 42, [], scope, null, null));
	var memberedSources = memberSources(), membered = AeneasAdapter.analyzeForScope(memberedSources, [], false);
	var memberedFiles = [("s.v3", membered.occurrences("s.v3")), ("t.v3", membered.occurrences("t.v3"))];
	var members = membered.membersAt("s.v3", afterDot(1), "");
	assertCounted(t, "members", AnalysisWire.encodeResultWithQueryCounted(7, 3, 4567, membered, 12, 42, memberedFiles, null, members, null));
	assertCounted(t, "members without files", AnalysisWire.encodeResultWithQueryCounted(7, 3, 4567, membered, -1, 42, [], null, members, null));
	var calledSources = callSources(), called = AeneasAdapter.analyzeForScope(calledSources, [], false);
	var calledFiles = [("s.v3", called.occurrences("s.v3")), ("t.v3", called.occurrences("t.v3"))];
	var call = called.callAt("s.v3", openOf("f(1"));
	assertCounted(t, "call", AnalysisWire.encodeResultWithQueryCounted(7, 3, 4567, called, 12, 42, calledFiles, null, null, call));
	assertCounted(t, "call without files", AnalysisWire.encodeResultWithQueryCounted(7, 3, 4567, called, -1, 42, [], null, null, call));
}

def test_result_frame_boundary(t: Tester) {
	for (delta in [-1, 0, 1]) {
		var payload = WorkerFraming.MAX_PAYLOAD + delta;
		var w = paddedResult(WorkerFraming.HEADER_BYTES + payload);
		t.asserti((WorkerFraming.HEADER_BYTES + payload + 7) & ~7, w.data.length);
		var frame = AnalysisWire.finishResult(w, 0L);
		t.asserti(WorkerFraming.HEADER_BYTES + payload, frame.length);
		t.asserti(payload, int.view(DataReaders.read_range_u32(frame[0 ... WorkerFraming.HEADER_BYTES])));
		var reader = WorkerFrameReader.new(WorkerFraming.MAX_PAYLOAD);
		var header = reader.space();
		for (i < header.length) header[i] = frame[i];
		t.assert(reader.advance(header.length) == null, "header alone has no complete payload");
		t.assertz(delta > 0, reader.error != null);
		t.asserti(if(delta > 0, 0, payload), reader.space().length);
	}
	// A sizing pass must not wrap when the total exceeds a signed int.
	var size = AnalysisResultSizer.new();
	var block = Array<byte>.new(1024 * 1024);
	for (i < 2048) size.puta(block);
	size.put_b64(0).put_sleb32(int.min).put_uleb32(u32.max).puta("abc");
	t.assertl(long.view(int.max) + 1 + 8 + 5 + 5 + 3, size.bytes);
	t.assert(size.data == null, "sizing allocates no buffer");
}

// A message cut short anywhere is rejected, without trapping.
def test_truncated_messages(t: Tester) {
	var sources = load(t, [SHAPES, MAIN]);
	if (sources == null) return;
	var paths = [SHAPES, MAIN];
	var result = roundTrip(sources, AeneasAdapter.analyzeProgram(sources, [], false), true).0;
	for (n < result.length) {
		t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(Arrays.range(result, 0, n), 1, paths)),
			Strings.format1("result cut to %d bytes is malformed", n));
	}
	var hello = payloadOf(AnalysisWire.encodeHello("1", "r", 1L));
	for (n < hello.length) {
		if (AnalysisWire.decodeHello(Arrays.range(hello, 0, n)) != null) return t.fail1("decoded a hello cut to %d bytes", n);
	}
	var request = payloadOf(AnalysisWire.encodeAnalyze(1, 0, 1000, ["-lang:descriptors"], sources, null));
	for (n < request.length) {
		if (AnalysisWire.decodeAnalyze(Arrays.range(request, 0, n)) != null) return t.fail1("decoded a request cut to %d bytes", n);
	}
	// Trailing bytes are also an error.
	t.assert(AnalysisWire.decodeHello(Arrays.concat(hello, "x")) == null, "trailing byte");
}

// Counts and indexes beyond the message are rejected before allocating.
def test_invalid_counts_and_indexes(t: Tester) {
	// Requests claiming a billion options or files.
	var w = DataWriter.new().putb(AnalysisWire.ANALYZE).put_sleb32(1).put_sleb32(0).put_sleb32(1000).put_sleb32(1000000000);
	t.assert(AnalysisWire.decodeAnalyze(w.extract()) == null, "option count");
	w = DataWriter.new().putb(AnalysisWire.ANALYZE).put_sleb32(1).put_sleb32(0).put_sleb32(1000).put_sleb32(0).put_sleb32(1000000000);
	t.assert(AnalysisWire.decodeAnalyze(w.extract()) == null, "file count");
	// A file whose contents are longer than the message.
	w = DataWriter.new().putb(AnalysisWire.ANALYZE).put_sleb32(1).put_sleb32(0).put_sleb32(1000).put_sleb32(0).put_sleb32(1);
	w.put_sleb32(1).putb('a').put_sleb32(100).putb('x');
	t.assert(AnalysisWire.decodeAnalyze(w.extract()) == null, "content length");
	// Options that a project file would reject, which the worker never applies.
	var rejected: Array<Array<string>> = [[null], ["-O2"], ["-lang:unknown"], ["-lang:descriptors=yes"],
		["-lang:descriptors", "-lang:descriptors=false"], ["descriptors.v3"]];
	for (options in rejected) {
		var payload = payloadOf(AnalysisWire.encodeAnalyze(1, 0, 1000, options, [], null));
		t.assert(AnalysisWire.decodeAnalyze(payload) == null, "rejected option");
	}
	// Results with a huge diagnostic count, a bad path index, a bad declaration
	// kind, and an occurrence pointing past the declarations.
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(1000000000, null), 1, REQUEST)), "diagnostic count");
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, declaration(0, 5)), 1, REQUEST)), "path index");
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, declaration(200, 0)), 1, REQUEST)), "declaration kind");
	// The last kind decodes; the tag after it is malformed.
	var last = AnalysisDeclKind.PACKING;
	t.asserti(AnalysisDeclKind.count - 1, last.tag);
	var kinds = file(declaration(last.tag, 0), 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY);
	var decoded = decodedResult(result(0, kinds), 1, REQUEST);
	if (decoded == null) return t.fail("the last declaration kind was rejected");
	var found = decoded.snapshot.definitionAt("p.v3", 1, 1);
	t.assert(found != null && found.kind == last, "the last declaration kind decodes");
	kinds = file(declaration(AnalysisDeclKind.count, 0), 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY);
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, kinds), 1, REQUEST)), "the tag after the last kind");
	var occurrences = file(declaration(0, 0), 1).puta(OCCURRENCE).put_sleb32(1).puta(NO_DISPLAY);
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, occurrences), 1, REQUEST)), "declaration index");
	// The same occurrence, pointing at declaration 0, is accepted.
	occurrences = file(declaration(0, 0), 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY);
	var r = decodedResult(result(0, occurrences), 1, REQUEST);
	if (r == null) return t.fail("valid result was rejected");
	var d = r.snapshot.definitionAt("p.v3", 1, 1);
	t.assert_string("LOCAL x @ p.v3:1:1-1:2", render(d));
	if (d != null) {
		t.asserti(4, d.range.beginOffset);
		t.asserti(5, d.range.endOffset);
	}
	t.assert(r.snapshot.definitionAtOffset("p.v3", 7) == null, "byte before the use");
	t.assert(d == r.snapshot.definitionAtOffset("p.v3", 8), "byte offset of the use");
	t.assert(r.snapshot.definitionAtOffset("p.v3", 9) == null, "exclusive end offset");
	var o = r.snapshot.occurrences("p.v3");
	t.asserti(1, o.length);
	if (o.length == 1) {
		t.asserti(8, o[0].range.beginOffset);
		t.asserti(9, o[0].range.endOffset);
	}
	// Counts are checked against the minimum encoded sizes of the records
	// that follow: one byte per string, ten per declaration, six per file,
	// five per occurrence and builtin use, and two per use-site type. One
	// byte short is malformed, before any allocation is charged.
	var n = 200000, declarations = DataWriter.new().put_sleb32(0).put_sleb32(n);
	declarations.putr(Array<byte>.new(10 * n - 1));
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, declarations), 1, REQUEST)), "declaration count");
	var strings = DataWriter.new().put_sleb32(n);
	strings.putr(Array<byte>.new(n - 1));
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, strings), 1, REQUEST)), "string count");
	var files = declaration(0, 0).puta(NO_SIGNATURES).put_sleb32(n);
	files.putr(Array<byte>.new(6 * n - 1));
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, files), 1, REQUEST)), "file count");
	n = 900000;
	occurrences = file(declaration(0, 0), n);
	occurrences.putr(Array<byte>.new(5 * n - 1));
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, occurrences), 1, REQUEST)), "occurrence count");
	var typed = file(declaration(0, 0), 0).put_sleb32(n);
	typed.putr(Array<byte>.new(2 * n - 1));
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, typed), 1, REQUEST)), "use-site type count");
	var builtins = file(declaration(0, 0), 0).put_sleb32(0).put_sleb32(n);
	builtins.putr(Array<byte>.new(5 * n - 1));
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, builtins), 1, REQUEST)), "builtin use count");
}
// The line, column, byte offset, and length of a use of "x" at p.v3:1:1-1:2,
// bytes 8 to 9.
def OCCURRENCE = "\x01\x01\x08\x01";
// No signature text and no signatures.
def NO_SIGNATURES = "\x00\x00";
// A file's empty lists of use-site types and builtin uses, and its empty
// list of calls.
def NO_DISPLAY = "\x00\x00\x00\x00\x00";
// A result with {diagnostics} as its diagnostic count and, if {occurrences}
// is not null, those bytes as its occurrence section.
def result(diagnostics: int, occurrences: DataWriter) -> Array<byte> {
	var w = DataWriter.new().putb(AnalysisWire.RESULT).put_b32(1).put_b32(1).put_b32(1).put_b64(0);
	w.putb(if(occurrences != null, 4 | 1, 1));
	for (i < 7) w.put_sleb32(-1);
	w.put_sleb32(diagnostics);
	if (occurrences != null) w.putr(occurrences.alias());
	return w.extract();
}
// A string table with "x" and "int", and one declaration "x" with {kind}
// and {path}, an index into REQUEST's paths, at p.v3:1:1-1:2, bytes 4 to 5,
// with the signature "x".
def declaration(kind: int, path: int) -> DataWriter {
	var w = DataWriter.new();
	w.put_sleb32(2).put_sleb32(1).putb('x').put_sleb32(3).puta("int");
	w.put_sleb32(1).putb(kind).put_sleb32(0).put_sleb32(path);
	return w.puta(DECLARATION_RANGE).put_sleb32(1).put_sleb32(0).put_sleb32(0);
}
def DECLARATION_RANGE = "\x01\x01\x01\x02\x04\x05";
// The request of the hand-built results, whose path indexes are 0 for
// "p.v3" and 1 for "q.v3".
def REQUEST = ["p.v3", "q.v3"];
// Appends to {w} a file table of one file, "p.v3", which declares nothing,
// and the count of its {occurrences}, which follow. {w} must end after the
// declarations, so that its empty signature section follows them.
def file(w: DataWriter, occurrences: int) -> DataWriter {
	return w.puta(NO_SIGNATURES).put_sleb32(1).put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(occurrences);
}

// Signatures, use-site types, builtin uses, calls, and declaration sites
// reach the snapshot as the analysis reports them.
def test_display_round_trip(t: Tester) {
	for (paths in [[SHAPES, MAIN], [COVERAGE], [CALL_SITES], [SHAPES, UNRESOLVED]]) {
		var sources = load(t, paths);
		if (sources == null) return;
		var analysis = AeneasAdapter.analyzeProgram(sources, [], false);
		var r = roundTrip(sources, analysis, true).1;
		if (r == null) return t.fail("result did not decode");
		var s = r.snapshot, typed = 0;
		t.asserti(0, s.stats.skippedUses);
		for (p in paths) {
			var want = analysis.occurrences(p), got = s.occurrences(p);
			t.asserti(want.length, got.length);
			for (i < Ints.min(want.length, got.length)) {
				t.assert_string(want[i].declaration.signature, got[i].declaration.signature);
				t.assert(want[i].declaration.signature != null, "every declaration has a signature");
				t.assert(Strings.equal(want[i].useType, got[i].useType), "use-site type");
				t.assertz(want[i].isWrite(), got[i].isWrite());
				if (got[i].useType != null) typed++;
				t.assert(Strings.equal(got[i].useType, s.useTypeAtOffset(p, got[i].range.beginOffset)), "use-site type at an offset");
			}
			var wantBuiltins = analysis.builtinUses(p), gotBuiltins = s.builtinUses(p);
			t.asserti(wantBuiltins.length, gotBuiltins.length);
			for (i < Ints.min(wantBuiltins.length, gotBuiltins.length)) {
				t.assert_string(wantBuiltins[i].toString(), gotBuiltins[i].toString());
				t.assert(s.definitionAtOffset(p, gotBuiltins[i].range.beginOffset) == null, "a builtin use has no definition");
			}
			var wantSites = analysis.declarationSites(p), gotSites = s.declarationSites(p);
			t.asserti(wantSites.length, gotSites.length);
			for (i < Ints.min(wantSites.length, gotSites.length)) {
				t.assert_string(render(wantSites[i]), render(gotSites[i]));
				t.assert_string(wantSites[i].signature, gotSites[i].signature);
				t.assert(gotSites[i] == s.declarationAtOffset(p, gotSites[i].range.beginOffset), "a site at its offset");
			}
			var wantCalls = analysis.calls(p), gotCalls = s.calls(p);
			t.asserti(wantCalls.length, gotCalls.length);
			for (i < Ints.min(wantCalls.length, gotCalls.length)) {
				t.assert_string(renderCall(wantCalls[i]), renderCall(gotCalls[i]));
			}
		}
		if (paths.length == 1) t.assert(typed > 0, "generic uses have use-site types");
	}
}

// String, occurrence, and declaration indexes in display data are checked
// against their tables.
def test_invalid_display_indexes(t: Tester) {
	// Names and signatures index the string table, whose second entry is "int".
	var r = decodedResult(result(0, file(declarations(1, 0, 2), 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY)), 1, REQUEST);
	if (r == null) return t.fail("a declaration with a signature was rejected");
	var d = r.snapshot.definitionAtOffset("p.v3", 8);
	t.assert(d != null && Strings.equal("x", d.name) && Strings.equal("int", d.signature), "name and signature");
	r = decodedResult(result(0, file(declarations(1, 0, 0), 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY)), 1, REQUEST);
	d = if(r != null, r.snapshot.definitionAtOffset("p.v3", 8));
	t.assert(d != null && d.signature == null, "a declaration without a signature");
	assertMalformed(t, file(declarations(1, 2, 0), 0).puta(NO_DISPLAY), "name index");
	assertMalformed(t, file(declarations(1, -1, 0), 0).puta(NO_DISPLAY), "negative name index");
	assertMalformed(t, file(declarations(1, 0, 3), 0).puta(NO_DISPLAY), "signature index");
	// A null table entry cannot be a name.
	var nulls = DataWriter.new().put_sleb32(1).put_sleb32(-1);
	nulls.put_sleb32(1).putb(0).put_sleb32(0).put_sleb32(0).puta(DECLARATION_RANGE).put_sleb32(0).put_sleb32(0).put_sleb32(0);
	assertMalformed(t, file(nulls, 0).puta(NO_DISPLAY), "null name");
	// A use-site type is an occurrence index, as a difference from the
	// previous one, and a string index.
	var typed = file(declarations(1, 0, 0), 1).puta(OCCURRENCE).put_sleb32(0).put_sleb32(1).put_sleb32(0).put_sleb32(1);
	r = decodedResult(result(0, typed.put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(0)), 1, REQUEST);
	if (r == null) return t.fail("a use-site type was rejected");
	t.assert_string("int", r.snapshot.useTypeAtOffset("p.v3", 8));
	t.assert(r.snapshot.useTypeAtOffset("p.v3", 9) == null, "no use past the end");
	var o = r.snapshot.occurrenceAtOffset("p.v3", 8);
	t.assert(o != null && Strings.equal("int", o.useType), "an occurrence's use-site type");
	var two = file(declarations(1, 0, 0), 2).puta(OCCURRENCE).put_sleb32(0).puta("\x01\x03\x0A\x01").put_sleb32(0);
	r = decodedResult(result(0, two.put_sleb32(2).put_sleb32(0).put_sleb32(0).put_sleb32(1).put_sleb32(1)
		.put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(0)), 1, REQUEST);
	if (r == null) return t.fail("two use-site types were rejected");
	t.assert_string("x", r.snapshot.useTypeAtOffset("p.v3", 8));
	t.assert_string("int", r.snapshot.useTypeAtOffset("p.v3", 10));
	var bad = [
		(1, 1, 0, -1, "occurrence index past the occurrences"),
		(1, 0, 2, -1, "type index"),
		(1, -1, 0, -1, "negative occurrence index"),
		(2, 0, 0, 0, "occurrence indexes that do not increase")
	];
	for (b in bad) {
		var w = file(declarations(1, 0, 0), 1).puta(OCCURRENCE).put_sleb32(0).put_sleb32(b.0).put_sleb32(b.1).put_sleb32(b.2);
		if (b.3 >= 0) w.put_sleb32(b.3).put_sleb32(0);
		assertMalformed(t, w.put_sleb32(0).put_sleb32(0), b.4);
	}
	// A builtin use has a range and a string index, and no definition.
	r = decodedResult(result(0, builtin(1)), 1, REQUEST);
	if (r == null) return t.fail("a builtin use was rejected");
	t.assert_string("int", r.snapshot.useTypeAtOffset("p.v3", 22));
	t.assert(r.snapshot.definitionAtOffset("p.v3", 20) == null, "a builtin use has no definition");
	var u = r.snapshot.builtinUseAtOffset("p.v3", 20);
	t.assert(u != null && u.range.beginLine == 2 && u.range.endOffset == 23, "a builtin use's range");
	assertMalformed(t, builtin(2), "builtin type index");
	// A file's declaration sites are a run of declarations of that file, in
	// order without overlap.
	var sites = DataWriter.new();
	sites.put_sleb32(1).put_sleb32(1).putb('x');
	sites.put_sleb32(2).putb(0).put_sleb32(0).put_sleb32(0).puta(DECLARATION_RANGE).put_sleb32(0).put_sleb32(0).put_sleb32(0);
	sites.putb(0).put_sleb32(0).put_sleb32(0).puta("\x01\x05\x01\x06\x08\x09").put_sleb32(0).put_sleb32(0).put_sleb32(0);
	r = decodedResult(result(0, site(sites, 0, 0, 2)), 1, REQUEST);
	if (r == null) return t.fail("declaration sites were rejected");
	t.assert(r.snapshot.declarationAtOffset("p.v3", 4) == r.snapshot.declarations[0], "the first site");
	t.assert(r.snapshot.declarationAtOffset("p.v3", 8) == r.snapshot.declarations[1], "the second site");
	t.assert(r.snapshot.declarationAtOffset("p.v3", 5) == null, "between sites");
	t.asserti(2, r.snapshot.declarationSites("p.v3").length);
	assertMalformed(t, site(sites, 0, 1, 2), "sites past the declarations");
	assertMalformed(t, site(sites, 0, -1, 1), "a negative first site");
	assertMalformed(t, site(sites, 0, 0, -1), "a negative site count");
	assertMalformed(t, site(sites, 1, 0, 1), "a site in another file");
	var overlap = DataWriter.new().put_sleb32(1).put_sleb32(1).putb('x');
	overlap.put_sleb32(2);
	for (i < 2) overlap.putb(0).put_sleb32(0).put_sleb32(0).puta(DECLARATION_RANGE).put_sleb32(0).put_sleb32(0).put_sleb32(0);
	assertMalformed(t, site(overlap, 0, 0, 2), "overlapping sites");
}
// Each file is decoded once, and its site run follows the previous file's,
// so that a result cannot make the decoder check a declaration's site more
// than once: repeating one run in many files would otherwise take time
// quadratic in the result's size.
def test_repeated_files_and_site_runs(t: Tester) {
	var r = decodedResult(result(0, siteRuns([(0, 0, 2), (1, 2, 1)])), 1, REQUEST);
	if (r == null) return t.fail("ordered site runs were rejected");
	t.assert(r.snapshot.declarationAtOffset("p.v3", 8) == r.snapshot.declarations[1], "the first file's second site");
	t.assert(r.snapshot.declarationAtOffset("q.v3", 4) == r.snapshot.declarations[2], "the second file's site");
	// An empty run is in order at the end of the previous one.
	t.assert(decodedResult(result(0, siteRuns([(0, 0, 2), (1, 2, 0)])), 1, REQUEST) != null, "an empty run");
	assertMalformed(t, siteRuns([(0, 0, 2), (0, 0, 2)]), "a repeated file");
	assertMalformed(t, siteRuns([(1, 2, 1), (0, 0, 2)]), "a site run before the previous file's");
	assertMalformed(t, siteRuns([(0, 0, 2), (1, 1, 0)]), "an empty run inside the previous file's");
	var repeats = Array<(int, int, int)>.new(1000);
	for (i < repeats.length) repeats[i] = (0, 0, 2);
	assertMalformed(t, siteRuns(repeats), "one run repeated in many files");
}

// A path is an index into the request's distinct paths, in request order,
// so that the decoder never looks a path up by text, and a file is named by
// its index at most once. The file count is thus bounded by the request.
def test_request_paths(t: Tester) {
	var w = siteRuns([(0, 0, 2), (1, 2, 1)]);
	var payload = result(0, w);
	t.assert(decodedResult(payload, 1, REQUEST) != null, "the request's paths");
	// A request that names "p.v3" twice has the same two files.
	var r = decodedResult(payload, 1, ["p.v3", "p.v3", "q.v3"]);
	t.assert(r != null && r.snapshot.declarationAtOffset("q.v3", 4) == r.snapshot.declarations[2], "a repeated request path");
	// Without "q.v3", its declaration and its file name no request path.
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(payload, 1, ["p.v3"])), "a declaration in a path not in the request");
	w = DataWriter.new().put_sleb32(1).put_sleb32(1).putb('x').put_sleb32(0).put_sleb32(1);
	w.put_sleb32(1).put_sleb32(0).put_sleb32(0).put_sleb32(0).puta(NO_DISPLAY);
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, w), 1, ["p.v3"])), "a file not in the request");
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, w), 1, ["p.v3", "p.v3"])), "a request path's second index");
	assertMalformed(t, siteRuns([(1, 2, 1), (1, 3, 0)]), "a file repeated by index");
	assertMalformed(t, siteRuns([(0, 0, 2), (-1, 2, 0)]), "a negative file index");
}
// A string table with "x"; declarations at p.v3 bytes 4 to 5 and 8 to 9,
// and q.v3 bytes 4 to 5; and {files}, each a path index and a site run's
// first index and count, without uses.
def siteRuns(files: Array<(int, int, int)>) -> DataWriter {
	var w = DataWriter.new();
	w.put_sleb32(1).put_sleb32(1).putb('x');
	w.put_sleb32(3);
	w.putb(0).put_sleb32(0).put_sleb32(0).puta(DECLARATION_RANGE).put_sleb32(0).put_sleb32(0).put_sleb32(0);
	w.putb(0).put_sleb32(0).put_sleb32(0).puta("\x01\x05\x01\x06\x08\x09").put_sleb32(0).put_sleb32(0).put_sleb32(0);
	w.putb(0).put_sleb32(0).put_sleb32(1).puta(DECLARATION_RANGE).put_sleb32(0).put_sleb32(0).put_sleb32(0);
	w.puta(NO_SIGNATURES).put_sleb32(files.length);
	for (f in files) w.put_sleb32(f.0).put_sleb32(f.1).put_sleb32(f.2).put_sleb32(0).puta(NO_DISPLAY);
	return w;
}

// Occurrences and builtin uses are token spans in byte order without
// overlaps, apart from each other, as the snapshot's binary searches by
// offset require.
def test_invalid_use_spans(t: Tester) {
	var r = decodedResult(result(0, uses([(1, 1, 0, 1), (1, 3, 2, 1)], [(1, 2, 1, 1)])), 1, REQUEST);
	if (r == null) return t.fail("adjacent uses were rejected");
	var s = r.snapshot;
	t.assert(s.definitionAtOffset("p.v3", 0) != null && s.definitionAtOffset("p.v3", 2) != null, "both occurrences");
	t.assert(s.definitionAtOffset("p.v3", 1) == null, "no occurrence at the builtin use");
	t.assert_string("int", s.useTypeAtOffset("p.v3", 1));
	t.assert(s.builtinUseAtOffset("p.v3", 0) == null, "no builtin use at an occurrence");
	var none: Array<(int, int, int, int)> = [];
	var bad = [
		([(1, 11, 10, 1), (1, 1, 0, 1)], "out of order"),
		([(1, 1, 0, 2), (1, 2, 1, 1)], "overlapping"),
		([(1, 1, 0, 1), (1, 1, 0, 1)], "repeated"),
		([(1, 1, -1, 2)], "a negative offset"),
		([(1, 1, 0, 0)], "an empty span"),
		([(1, 1, 0, -1)], "a negative length"),
		([(1, 1, int.max - 1, 2)], "an end offset that overflows"),
		([(1, int.max, 0, 1)], "an end column that overflows"),
		([(0, 1, 0, 1)], "line zero"),
		([(1, 0, 0, 1)], "column zero")
	];
	for (b in bad) {
		assertMalformed(t, uses(b.0, none), Strings.format1("occurrences: %s", b.1));
		assertMalformed(t, uses(none, b.0), Strings.format1("builtin uses: %s", b.1));
	}
	assertMalformed(t, uses([(1, 1, 0, 2)], [(1, 2, 1, 1)]), "a builtin use inside an occurrence");
	assertMalformed(t, uses([(1, 2, 1, 1)], [(1, 1, 0, 2)]), "an occurrence inside a builtin use");
}
// One declaration and, in its file, {occurrences} of it and {builtins} of
// type "int", each a line, column, offset, and length.
def uses(occurrences: Array<(int, int, int, int)>, builtins: Array<(int, int, int, int)>) -> DataWriter {
	var w = file(declarations(1, 0, 0), occurrences.length);
	for (o in occurrences) w.put_sleb32(o.0).put_sleb32(o.1).put_sleb32(o.2).put_sleb32(o.3).put_sleb32(0);
	w.put_sleb32(0).put_sleb32(builtins.length);
	for (b in builtins) w.put_sleb32(b.0).put_sleb32(b.1).put_sleb32(b.2).put_sleb32(b.3).put_sleb32(1);
	return w.put_sleb32(0).put_sleb32(0).put_sleb32(0);
}
// A string table with "x" and "int", and {count}
// declarations at p.v3:1:1-1:2, bytes 4 to 5, whose name and signature have
// string indexes {name} and {signature}: an index plus one, or zero.
def declarations(count: int, name: int, signature: int) -> DataWriter {
	return declarationsWithType(count, name, signature, 0);
}
def declarationsWithType(count: int, name: int, signature: int, target: int) -> DataWriter {
	var w = DataWriter.new();
	w.put_sleb32(2).put_sleb32(1).putb('x').put_sleb32(3).puta("int");
	w.put_sleb32(count);
	for (i < count) w.putb(0).put_sleb32(name).put_sleb32(0).puta(DECLARATION_RANGE).put_sleb32(signature).put_sleb32(target).put_sleb32(0);
	return w;
}
// A copy of {w} followed by a file table of one file, path index {path},
// whose sites are {count} declarations from {first}, with no uses.
def site(w: DataWriter, path: int, first: int, count: int) -> DataWriter {
	var c = DataWriter.new().puta(w.copy());
	return c.puta(NO_SIGNATURES).put_sleb32(1).put_sleb32(path).put_sleb32(first).put_sleb32(count)
		.put_sleb32(0).puta(NO_DISPLAY);
}
// One declaration and, in its file, one builtin use at 2:1-2:4, bytes 20 to
// 23, whose type has string index {typeIndex}.
def builtin(typeIndex: int) -> DataWriter {
	var w = file(declarations(1, 0, 0), 0).put_sleb32(0).put_sleb32(1).puta("\x02\x01\x14\x03");
	return w.put_sleb32(typeIndex).put_sleb32(0).put_sleb32(0).put_sleb32(0);
}
def assertMalformed(t: Tester, occurrences: DataWriter, message: string) {
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(result(0, occurrences), 1, REQUEST)), message);
}

// Index strings are retained in the snapshot, without diagnostic JSON copies.
// Charging them for JSON escaping rejects this otherwise small valid result.
def test_result_index_string_budget(t: Tester) {
	var text = Array<byte>.new(600 * 1024);
	for (i < text.length) text[i] = 'x';
	// The name is in the string table; the path is the request's.
	var index = DataWriter.new().put_sleb32(1).put_sleb32(text.length).puta(text);
	index.put_sleb32(1).putb(0).put_sleb32(0).put_sleb32(0).puta(DECLARATION_RANGE).put_sleb32(0).put_sleb32(0).put_sleb32(0);
	file(index, 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY);
	var decoded = decodedResult(result(0, index), 1, [text]);
	if (decoded == null) return t.fail("index strings within the allocation budget were rejected");
	var definition = decoded.snapshot.definitionAt(text, 1, 1);
	if (definition == null) return t.fail("decoded index cannot resolve its occurrence");
	t.assert(Strings.equal(text, definition.name), "declaration name is preserved");
	t.assert(Strings.equal(text, definition.range.path), "declaration path is preserved");
}

def test_result_allocation_budget(t: Tester) {
	var declarations = DataWriter.new();
	declarations.put_sleb32(1).put_sleb32(1).putb('x').put_sleb32(200000);
	for (i < 200000) {
		declarations.putb(0).put_sleb32(0).put_sleb32(0).puta(DECLARATION_RANGE).put_sleb32(0).put_sleb32(0).put_sleb32(0);
	}
	declarations.put_sleb32(0);
	assertTooLarge(t, result(0, declarations), "compact declarations exceed allocation budget");
	var files = declaration(0, 0).puta(NO_SIGNATURES).put_sleb32(100000);
	for (i < 100000) files.put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(0).puta(NO_DISPLAY);
	assertTooLarge(t, result(0, files), "compact file table exceeds allocation budget");
	var occurrences = DataWriter.new();
	occurrences.put_sleb32(1).put_sleb32(1).putb('x');
	occurrences.put_sleb32(1).putb(0).put_sleb32(0).put_sleb32(0).puta(DECLARATION_RANGE).put_sleb32(0).put_sleb32(0).put_sleb32(0);
	occurrences.put_sleb32(2);
	for (f < 2) {
		occurrences.put_sleb32(f).put_sleb32(0).put_sleb32(0).put_sleb32(500000);
		for (i < 500000) occurrences.put_sleb32(1).put_sleb32(1).put_sleb32(i).put_sleb32(1).put_sleb32(0);
		occurrences.puta(NO_DISPLAY);
	}
	assertTooLarge(t, result(0, occurrences), "occurrence budget is aggregate across files");
	// Each occurrence is charged 20 bytes for its four range ints and its
	// declaration index. Besides the occurrences, this result is charged for
	// its diagnostic, string, declaration, signature text, signature, file,
	// occurrence, use-site type, builtin use, and call counts (64 each), for
	// the signature text and records as byte arrays (64 each, plus their
	// lengths), and for 8 per string table entry, 128 per declaration, 256 per
	// file, and each string's text (64 each, plus its length). Its paths are
	// the request's.
	var fixed = 10 * 64 + 2 * 64 + 2 * 8 + 128 + 256 + (64 + 1) + (64 + 3);
	var most = (AnalysisWire.MAX_RESULT_ALLOCATION - fixed) / 20;
	for (n in [most, most + 1]) {
		var single = file(declaration(0, 0), n);
		for (i < n) single.put_sleb32(1).put_sleb32(1).put_sleb32(i).put_sleb32(1).put_sleb32(0);
		single.puta(NO_DISPLAY);
		if (n == most) {
			var decoded = decodedResult(result(0, single), 1, REQUEST);
			t.assert(decoded != null, "occurrences within allocation budget accepted");
			// The snapshot's charge is the result's, plus its own allowance.
			if (decoded != null) {
				t.assertl(long.view(fixed) + 20L * n, decoded.snapshot.resultAllocation);
				t.assertl(1024L + 2 * (128 + 4) + decoded.snapshot.resultAllocation, decoded.snapshot.retainedBytes);
			}
		} else {
			assertTooLarge(t, result(0, single), "one occurrence beyond allocation budget rejected");
		}
	}
	// Strings, use-site types, and builtin uses are charged too.
	var text = Array<byte>.new(1024 * 1024);
	for (i < text.length) text[i] = 'x';
	var strings = DataWriter.new().put_sleb32(17);
	for (i < 17) strings.put_sleb32(text.length).puta(text);
	assertTooLarge(t, result(0, strings), "string table exceeds allocation budget");
	// The remaining counts are charged as the reader reaches them. A use-site
	// type is 8 bytes, an occurrence index difference and a string index; a
	// builtin use is 20, four range ints and a string index. {fixed} holds the
	// 64-byte base of each count, so the count that exceeds the budget is the
	// budget less {fixed}, plus the bases not yet charged, over the per-item
	// charge, so that the count is rejected before its items are read.
	var count = (AnalysisWire.MAX_RESULT_ALLOCATION - fixed + 3 * 64) / 8 + 1;
	var typed = file(declaration(0, 0), 1).puta(OCCURRENCE).put_sleb32(0).put_sleb32(count);
	for (i < count) typed.put_sleb32(0).put_sleb32(1);
	assertTooLarge(t, result(0, typed), "use-site types exceed allocation budget");
	count = (AnalysisWire.MAX_RESULT_ALLOCATION - fixed + 2 * 64) / 20 + 1;
	var builtins = file(declaration(0, 0), 0).put_sleb32(0).put_sleb32(count);
	for (i < count) builtins.puta(OCCURRENCE).put_sleb32(1);
	assertTooLarge(t, result(0, builtins), "builtin uses exceed allocation budget");
	for (i < text.length) text[i] = 1;
	var diagnostic = DataWriter.new().put_sleb32(-1);
	for (i < 6) diagnostic.put_sleb32(1);
	diagnostic.put_sleb32(-1).put_sleb32(text.length).puta(text);
	var large = Arrays.concat(result(1, null), diagnostic.extract());
	assertTooLarge(t, large, "diagnostic escaping exceeds allocation budget");
	large[0] = AnalysisWire.HELLO;
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(large, 1, REQUEST)), "wrong kind is malformed even with an oversized body");
	// Four diagnostic records make the fixed charge divisible by 32,
	// including the two byte offsets per record. With null path and kind,
	// three null messages and one message header, this exactly fills the budget.
	var boundary = (AnalysisWire.MAX_RESULT_ALLOCATION - (64 + 4 * 2056 + 64)) / 32;
	for (n in [boundary, boundary + 1]) {
		var d = DataWriter.new();
		for (i < 3) d.puta("\x7F\x01\x01\x01\x01\x01\x01\x7F\x7F");
		d.put_sleb32(-1).puta("\x01\x01\x01\x01\x01\x01").put_sleb32(-1);
		d.put_sleb32(n).putr(text[0 ... n]);
		var payload = Arrays.concat(result(4, null), d.extract());
		if (n == boundary) t.assert(decodedResult(payload, 1, REQUEST) != null, "exact allocation budget accepted");
		else assertTooLarge(t, payload, "one message byte beyond allocation budget rejected");
	}
	var diagnostics = DataWriter.new();
	for (i < 10000) diagnostics.puta("\x7F\x01\x01\x01\x01\x7F\x7F\x7F\x7F");
	assertTooLarge(t, Arrays.concat(result(10000, null), diagnostics.extract()), "diagnostic records exceed allocation budget");
}

def assertTooLarge(t: Tester, payload: Array<byte>, message: string) {
	var outcome = AnalysisWire.decodeResult(payload, 1, REQUEST);
	t.assert(AnalysisResultDecode.TooLarge.?(outcome), message);
	if (AnalysisResultDecode.TooLarge.?(outcome)) t.asserti(1, AnalysisResultDecode.TooLarge.!(outcome).id);
}

// An occurrence is sent as its begin, offset, and length, so the encoder
// omits one that is not a token span rather than misstating it.
def test_occurrence_token_spans(t: Tester) {
	var decl = AnalysisDeclaration.new(AnalysisDeclKind.LOCAL, "x", AnalysisRange.new("p.v3", 1, 5, 1, 6, 4, 5));
	var ranges = [
		AnalysisRange.new("p.v3", 2, 9, 2, 12, 20, 23),	// a token span
		AnalysisRange.new("p.v3", 3, 1, 4, 2, 30, 40),	// two lines
		AnalysisRange.new("p.v3", 5, 1, 5, 3, 50, 51),	// two columns, one byte
		AnalysisRange.new("p.v3", 6, 1, 6, 2, -1, -1),	// no source
		AnalysisRange.new("p.v3", 7, 17, 7, 19, 60, 62)	// a token span
	];
	var spans = [true, false, false, false, true];
	var uses = Array<AnalysisOccurrence>.new(ranges.length);
	for (i < ranges.length) {
		t.assertz(spans[i], ranges[i].isTokenSpan());
		uses[i] = AnalysisOccurrence.new(ranges[i], decl);
	}
	var analysis = ProgramAnalysis.new([], AnalysisStats.new(0, 0, 0, -1), false, false, null);
	var w = AnalysisWire.encodeResult(1, 1, 1, analysis, 0, -1, [("p.v3", uses)]);
	var r = decodedResult(payloadOf(AnalysisWire.finishResult(w, 0L)), 1, ["p.v3"]);
	if (r == null) return t.fail("result with omitted occurrences did not decode");
	// The omissions are counted, so they are not silent.
	t.asserti(3, r.snapshot.stats.skippedUses);
	var got = r.snapshot.occurrences("p.v3");
	t.asserti(2, got.length);
	if (got.length != 2) return;
	// The kept occurrences are reconstructed exactly.
	for (k < 2) {
		var want = ranges[4 * k], g = got[k].range;
		t.assert_string("p.v3", g.path);
		t.asserti(want.beginLine, g.beginLine);
		t.asserti(want.beginColumn, g.beginColumn);
		t.asserti(want.endLine, g.endLine);
		t.asserti(want.endColumn, g.endColumn);
		t.asserti(want.beginOffset, g.beginOffset);
		t.asserti(want.endOffset, g.endOffset);
	}
	t.assert(r.snapshot.definitionAtOffset("p.v3", 30) == null, "omitted two-line occurrence");
	t.assert(r.snapshot.definitionAtOffset("p.v3", 61) != null, "kept occurrence after omitted ones");
	t.assert(r.snapshot.definitionAt("p.v3", 7, 18) != null, "compiler lookup of a reconstructed end");
	t.assert(r.snapshot.definitionAt("p.v3", 7, 19) == null, "reconstructed compiler end is exclusive");
}

def test_wrong_kind(t: Tester) {
	var hello = payloadOf(AnalysisWire.encodeHello("1", "r", 1L));
	t.assert(AnalysisWire.decodeAnalyze(hello) == null, "hello is not a request");
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(hello, 1, REQUEST)), "hello is not a result");
	t.assert(AnalysisWire.decodeHello([]) == null, "empty payload");
}

// A call's spans, callee, target, and signature, to compare calls.
def renderCall(c: AnalysisCall) -> string {
	if (c == null) return "null";
	var buf = StringBuilder.new().put3("@%d-%d callee %d", c.open, c.close, c.callee);
	for (i < c.argCount()) buf.put2(" @%d-%d", c.args[2 * i], c.args[2 * i + 1]);
	buf.puts(" target ").puts(render(c.target));
	var s = c.signature;
	if (s == null) return buf.puts(" no signature").toString();
	buf.puts(" signature ").puts(s.label).put1(" at %d:", s.start);
	for (p in s.params) buf.puts(" [").puts(p).puts("]");
	return buf.toString();
}
// The call-sites fixture's calls cross from a worker as the collector
// reports them, and a snapshot finds the innermost call whose argument list
// holds an offset.
def test_call_sites_round_trip(t: Tester) {
	var sources = load(t, [CALL_SITES]);
	if (sources == null) return;
	var supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	var outcome = supervisor.analyze(sources, [], AnalysisWire.WANT_OCCURRENCES);
	supervisor.close();
	var s: AnalysisSnapshot;
	match (outcome) {
		Completed(snapshot) => s = snapshot;
		_ => return t.fail("the call-sites fixture did not analyze");
	}
	t.asserti(0, s.stats.skippedUses);
	var input = sources[0].input, calls = s.calls(CALL_SITES);
	OccurrenceCollectorTest.checkCalls(t, input, calls);
	// Just inside either parenthesis is in the call, and its own opening
	// parenthesis is in the call around it, if any.
	for (c in calls) {
		var inside = s.callAt(CALL_SITES, c.open + 1);
		t.assert(inside != null && inside.open == c.open, "just after the opening parenthesis");
		inside = s.callAt(CALL_SITES, c.close - 1);
		t.assert(inside != null && inside.open == c.open, "at the closing parenthesis");
		var outside = s.callAt(CALL_SITES, c.open);
		t.assert(outside == null || outside.open < c.open, "the opening parenthesis is outside");
		t.assert(s.callAt(CALL_SITES, c.close) == null || s.callAt(CALL_SITES, c.close).open != c.open, "past the closing parenthesis");
	}
	// In add(add(1, 2), add(3, 4)), the comma between the inner calls is in
	// the outer call, and each inner argument in its own call.
	var nested = OccurrenceCollectorTest.indexOf(input, "add(add(1, 2), add(3, 4))");
	t.assert(nested > 0, "the nested calls");
	var outer = s.callAt(CALL_SITES, nested + 13), inner = s.callAt(CALL_SITES, nested + 8);
	t.assert(outer != null && outer.open == nested + 3 && outer.argCount() == 2, "the outer call");
	t.assert(inner != null && inner.open == nested + 7 && inner.argCount() == 2, "the first inner call");
	inner = s.callAt(CALL_SITES, nested + 19);
	t.assert(inner != null && inner.open == nested + 18, "the second inner call");
	t.assert(s.callAt(CALL_SITES, 0) == null, "no call at the start");
	t.assert(s.callAt("other.v3", nested + 8) == null, "no call in another file");
	t.asserti(0, s.calls("other.v3").length);
}

// Signature text "f(a: int)" and "a: int", after the string table's "x" and
// "int", and one signature: label 2 with its parameter at byte 2, and one
// parameter, 3.
def ONE_SIGNATURE = "\x02\x09f(a: int)\x06a: int\x01\x02\x02\x01\x03";
// The string table's "x" and "int"; one declaration "x" at bytes 4 to 5, the
// signature section {signatures}, and a file whose one use of "x" is at bytes
// 8 to 9, followed by {count} and the calls {encoded}.
def withCalls(signatures: string, count: int, encoded: string) -> DataWriter {
	var w = declarations(1, 0, 0).puta(signatures);
	w.put_sleb32(1).put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(1).puta(OCCURRENCE).put_sleb32(0);
	return w.put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(count).puta(encoded).put_sleb32(0);
}
// A call is unsigned LEB128 numbers: its opening parenthesis, as a
// difference; its argument count times eight, plus 1 if its callee's use
// ends at the parenthesis, 2 if a callee offset follows, and 4 if a closing
// gap follows; its signature index plus one; each argument's length times
// four plus its gap, or three and then the gap; and the closing gap.
def test_hand_built_calls(t: Tester) {
	// x(y) at 8, with the use of x ending at its parenthesis and the
	// signature; then, at 13, a call with the use as a callee five bytes
	// before it, an argument five bytes in, another two after it, and eleven
	// bytes before its closing parenthesis; and at 20, inside its first
	// argument, a call with neither callee nor signature.
	var encoded = "\x09\x09\x01\x04\x04\x16\x05\x00\x0B\x05\x06\x0B\x07\x00\x00";
	var r = decodedResult(result(0, withCalls(ONE_SIGNATURE, 3, encoded)), 1, REQUEST);
	if (r == null) return t.fail("calls were rejected");
	var s = r.snapshot, calls = s.calls("p.v3");
	t.asserti(3, calls.length);
	if (calls.length != 3) return;
	t.assert_string("@9-12 callee 8 @10-11 target LOCAL x @ p.v3:1:1-1:2 signature f(a: int) at 2: [a: int]", renderCall(calls[0]));
	t.assert_string("@13-36 callee 8 @19-21 @23-24 target LOCAL x @ p.v3:1:1-1:2 no signature", renderCall(calls[1]));
	t.assert_string("@20-22 callee -1 target null no signature", renderCall(calls[2]));
	t.assert(calls[0].signature.holds(0), "the label holds its parameter");
	t.assert(s.callAt("p.v3", 9) == null, "at an opening parenthesis");
	t.assert_string(renderCall(calls[0]), renderCall(s.callAt("p.v3", 10)));
	t.assert_string(renderCall(calls[0]), renderCall(s.callAt("p.v3", 11)));
	t.assert(s.callAt("p.v3", 12) == null, "past a closing parenthesis");
	t.assert_string(renderCall(calls[1]), renderCall(s.callAt("p.v3", 20)));
	t.assert_string(renderCall(calls[2]), renderCall(s.callAt("p.v3", 21)));
	t.assert_string(renderCall(calls[1]), renderCall(s.callAt("p.v3", 22)));
	t.assert_string(renderCall(calls[1]), renderCall(s.callAt("p.v3", 35)));
	t.assert(s.callAt("p.v3", 36) == null, "after the last call");
	// A file without calls, and a result without signatures.
	r = decodedResult(result(0, withCalls(NO_SIGNATURES, 1, "\x09\x01\x00")), 1, REQUEST);
	if (r == null) return t.fail("a call without a signature was rejected");
	t.assert_string("@9-11 callee 8 target LOCAL x @ p.v3:1:1-1:2 no signature", renderCall(r.snapshot.callAt("p.v3", 10)));
}
// Calls that are out of order, that do not nest, that name no use or
// signature, or whose spans are empty or overflow are malformed, and so is
// a count that the message cannot hold. Each check takes time in proportion
// to the bytes it reads.
def test_invalid_calls(t: Tester) {
	// int.max, int.max - 1, and int.max - 2 are FF FF FF FF 07, FE FF FF FF
	// 07, and FD FF FF FF 07.
	var bad = [
		(2, "\x0B\x00\x00\x00\x00\x00", "calls out of order"),
		(1, "\x0B\x03\x00", "both callee flags"),
		(1, "\x0B\x02\x00\x00", "a callee offset of zero"),
		(1, "\x0B\x02\x0C\x00", "a callee offset before the file"),
		(1, "\x0B\x02\x01\x00", "a callee offset that is not a use"),
		(1, "\x0B\x01\x00", "no use that ends at the parenthesis"),
		(1, "\x09\x01\x02", "a signature index past the signatures"),
		(1, "\x09\x08\x00\x00", "an empty argument"),
		(1, "\x09\xC0\x3E\x00\x04", "an argument count past the message"),
		(1, "\x0B\x08\x00\x07", "the end of the message"),
		(1, "\x0B\x00\x00\x0B\x00\x00", "a count below the calls"),
		(3, "\x0B\x00\x00", "a count past the calls"),
		(1, "\xFF\xFF\xFF\xFF\x07\x00\x00", "an opening parenthesis at the end of the offsets"),
		(1, "\xFE\xFF\xFF\xFF\x07\x08\x00\x04", "an argument past the end of the offsets"),
		(1, "\xFE\xFF\xFF\xFF\x07\x00\x00", "a closing parenthesis past the end of the offsets"),
		(1, "\xFD\xFF\xFF\xFF\x07\x04\x00\x01", "a closing gap past the end of the offsets"),
		(1, "\x80\x80\x80\x80\x08\x00\x00", "a number past int.max"),
		(2, "\x0B\x0C\x00\x0D\x02\x02\x04\x00\x0A", "argument lists that do not nest")
	];
	for (b in bad) {
		assertMalformed(t, withCalls(NO_SIGNATURES, b.0, b.1), b.2);
		assertMalformed(t, withCalls(ONE_SIGNATURE, b.0, b.1), b.2);
	}
	// The last, with the second call's list inside the first's, is valid.
	t.assert(decodedResult(result(0, withCalls(NO_SIGNATURES, 2, "\x0B\x0C\x00\x0D\x02\x02\x00\x00")), 1, REQUEST) != null, "nested lists");
	// So is a call that ends at the last offset.
	var r = decodedResult(result(0, withCalls(NO_SIGNATURES, 1, "\xFD\xFF\xFF\xFF\x07\x00\x00")), 1, REQUEST);
	t.assert(r != null && r.snapshot.calls("p.v3").length == 1 && r.snapshot.calls("p.v3")[0].close == int.max, "a call that ends at int.max");
	// The calls of one file do not carry over to the next: each starts from
	// zero, and the second file has no use to be a callee.
	var two = declarations(1, 0, 0).puta(NO_SIGNATURES).put_sleb32(2);
	two.put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(1).puta(OCCURRENCE).put_sleb32(0);
	two.put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(1).puta("\x09\x01\x00").put_sleb32(0);
	two.put_sleb32(1).put_sleb32(1).put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(1);
	assertMalformed(t, DataWriter.new().puta(two.copy()).puta("\x09\x01\x00"), "a callee in another file");
	r = decodedResult(result(0, two.puta("\x03\x00\x00").put_sleb32(0)), 1, REQUEST);
	var second = if(r != null, r.snapshot.callAt("q.v3", 4));
	t.assert(second != null && second.open == 3, "a second file's calls start from zero");
}
// Signature references are string table entries or signature text, and a
// signature's parameters start within its label.
def test_invalid_signatures(t: Tester) {
	var call = "\x09\x01\x01";
	t.assert(decodedResult(result(0, withCalls(ONE_SIGNATURE, 1, call)), 1, REQUEST) != null, "a valid signature");
	// A label may be a string table entry, and parameters may start at its end.
	t.assert(decodedResult(result(0, withCalls("\x00\x01\x01\x03\x00", 1, call)), 1, REQUEST) != null, "a label in the table");
	var bad = [
		("\x01\xFF\x00", "text past the message"),
		("\x01\x7F", "a negative text length"),
		("\x00\x01\x02\x00\x00", "a label past the strings"),
		("\x00\x01\x7F\x00\x00", "a negative label"),
		("\x00\x01\x01\x04\x00", "parameters past the label's end"),
		("\x00\x01\x01\x7F\x00", "a negative parameter offset"),
		("\x00\x01\x01\x00\x01\x02", "a parameter past the strings"),
		("\x00\x01\x01\x00\x7F", "a negative parameter count"),
		("\x00\x01\x01\x00\xC0\x00", "a parameter count past the message"),
		("\x00\xC0\x00\x01\x00\x00", "a signature count past the message"),
		("\x02\x09f(a: int)\x06a: int\x01\x04\x02\x01\x03", "a label past the text")
	];
	for (b in bad) assertMalformed(t, withCalls(b.0, 0, ""), b.1);
}
// A signature whose parameters, laid out from its offset with separators,
// end past int.max is malformed, however few bytes it charges: here one
// 3 MiB string is the label and every parameter. 682 of them end within
// int.max, and 683 do not. A signature that the decoder did not check still
// answers paramOffset and holds: parameter 716 of 1,000 would start past
// int.max, and the label was cut short long before it.
def test_signature_offsets(t: Tester) {
	var label = Array<byte>.new(3 * 1024 * 1024);
	for (i < label.length) label[i] = 'p';
	for (n in [682, 683]) {
		// The string table has "x" and "int", so the label is string 2.
		var w = DataWriter.new().put_sleb32(1).put_sleb32(label.length).puta(label);
		w.put_sleb32(1).put_sleb32(2).put_sleb32(0).put_sleb32(n);
		for (i < n) w.put_sleb32(2);
		var r = decodedResult(result(0, withCalls(w.extract(), 1, "\x09\x01\x01")), 1, REQUEST);
		if (n == 683) {
			t.assert(r == null, "parameters past int.max");
			continue;
		}
		var calls = if(r != null, r.snapshot.calls("p.v3"));
		if (calls == null || calls.length != 1) return t.fail("a long signature was rejected");
		var s = calls[0].signature;
		t.assert(s.holds(0), "the label holds its first parameter");
		t.asserti(-1, s.paramOffset(1));
		t.assert(!s.holds(n - 1), "the label does not hold its last parameter");
	}
	var params = Array<string>.new(1000);
	for (i < params.length) params[i] = label;
	var s = AnalysisSignature.new(label, 0, params);
	t.asserti(0, s.paramOffset(0));
	t.assert(s.holds(0), "the label holds its first parameter");
	t.asserti(-1, s.paramOffset(716));
	t.assert(!s.holds(716), "the label does not hold a parameter past int.max");
	t.assert(!AnalysisSignature.new("f()", 4, ["int"]).holds(0), "a parameter past the label's end");
}
// A call whose 64 parameters all name one 3 MiB string, so its display line
// is about 195 MiB even though the result is charged a little over 3 MiB.
// The writer produces the line piece by piece rather than holding it whole.
def test_display_shared_signature(t: Tester) {
	var label = Array<byte>.new(3 * 1024 * 1024);
	for (i < label.length) label[i] = 'p';
	// The string table has "x" and "int", so the label is string 2.
	var w = DataWriter.new().put_sleb32(1).put_sleb32(label.length).puta(label);
	w.put_sleb32(1).put_sleb32(2).put_sleb32(0).put_sleb32(64);
	for (i < 64) w.put_sleb32(2);
	var r = decodedResult(result(0, withCalls(w.extract(), 1, "\x09\x01\x01")), 1, REQUEST);
	if (r == null) return t.fail("a shared signature was rejected");
	var calls = r.snapshot.calls("p.v3");
	if (calls.length != 1) return t.fail("the call was not decoded");
	var out = AnalysisReport.new(false);
	AnalysisCallDisplay.write(out, "p.v3", calls[0]);
	var expected = "p.v3".length + Strings.format2(":@%d-%d call", 9, 11).length + " LOCAL x".length
		+ ": ".length + label.length + "; parameters".length
		+ 64 * (" [".length + label.length + "]".length) + "; arguments\n".length;
	t.assertl(long.view(expected), out.bytes);
}
// A query decodes each signature once, however many of its calls name it:
// here 5,000 calls name one signature with 100,000 parameters, in a
// 115,069-byte result, which one array per call would make 500 million
// parameter slots.
def test_shared_signatures(t: Tester) {
	// The label is "x", and every parameter "int".
	var w = DataWriter.new().put_sleb32(0).put_sleb32(1).put_sleb32(0).put_sleb32(0).put_sleb32(100000);
	for (i < 100000) w.put_sleb32(1);
	var calls = DataWriter.new();
	for (i < 5000) calls.putb(3).putb(0).putb(1);
	var payload = result(0, withCalls(w.extract(), 5000, calls.extract()));
	t.asserti(115073, payload.length);
	var r = decodedResult(payload, 1, REQUEST);
	if (r == null) return t.fail("the calls were rejected");
	var got = r.snapshot.calls("p.v3");
	t.asserti(5000, got.length);
	if (got.length != 5000) return;
	var s = got[0].signature;
	t.asserti(100000, s.params.length);
	t.assert_string("x", s.label);
	t.assert_string("int", s.params[99999]);
	for (c in got) if (c.signature != s) return t.fail("calls do not share their signature");
	var last = r.snapshot.callAt("p.v3", got[4999].open + 1);
	t.assert(last != null && last.open == got[4999].open && last.signature.params.length == 100000, "the call at an offset");
}
// A file's calls are charged as their encoded bytes, which the snapshot
// keeps, plus 64 for their count. Signature text is charged as its bytes and
// four per string, plus 64; signatures as their encoded bytes and four
// each, plus 64 for each of their count and their bytes.
def test_call_allocation(t: Tester) {
	var none = decodedResult(result(0, withCalls(NO_SIGNATURES, 0, "")), 1, REQUEST);
	var one = decodedResult(result(0, withCalls(ONE_SIGNATURE, 1, "\x09\x09\x01\x04")), 1, REQUEST);
	if (none == null || one == null) return t.fail("calls were rejected");
	t.assertl(long.view(2 * 4 + 15 + 4 + 4 + 4), one.snapshot.resultAllocation - none.snapshot.resultAllocation);
	// A result that fills the budget with occurrences, as in
	// result_allocation_budget, has 16 bytes left for a call with 13
	// one-byte arguments, but not for one with 14.
	var fixed = 10 * 64 + 2 * 64 + 2 * 8 + 128 + 256 + (64 + 1) + (64 + 3);
	var most = (AnalysisWire.MAX_RESULT_ALLOCATION - fixed) / 20;
	t.asserti(16, AnalysisWire.MAX_RESULT_ALLOCATION - fixed - 20 * most);
	for (n in [13, 14]) {
		var w = file(declaration(0, 0), most);
		for (i < most) w.put_sleb32(1).put_sleb32(1).put_sleb32(i).put_sleb32(1).put_sleb32(0);
		w.put_sleb32(0).put_sleb32(0).put_sleb32(0).put_sleb32(1).putb(0).putb(byte.view(8 * n)).putb(0);
		for (i < n) w.putb(4);
		w.put_sleb32(0);
		if (n == 13) t.assert(decodedResult(result(0, w), 1, REQUEST) != null, "a call within the budget");
		else assertTooLarge(t, result(0, w), "a call beyond the budget");
	}
}

def SCOPED = "component C {\n\tdef f(a: int) {\n\t\tvar b = a;\n\t\tb = b + a;\n\t}\n}\n";
def scopeSources() -> Array<AnalysisSource> {
	return [AnalysisSource.new("s.v3", SCOPED), AnalysisSource.new("t.v3", "class T { }\n")];
}
def test_scope_request_round_trip(t: Tester) {
	var sources = scopeSources();
	var flags = AnalysisWire.WANT_OCCURRENCES | AnalysisWire.WANT_SCOPE;
	for (scope in [AnalysisScopeRequest.new(0, 37, AnalysisScopeKinds.VALUES, "b"),
			AnalysisScopeRequest.new(1, 0, AnalysisScopeKinds.ALL, ""),
			AnalysisScopeRequest.new(1, sources[1].input.length, AnalysisScopeKinds.TYPES, Array<byte>.new(AnalysisScopeOrder.MAX_PREFIX))]) {
		var frame = AnalysisWire.encodeAnalyze(4, flags, 100, [], sources, scope);
		t.assertl(long.view(frame.length), AnalysisWire.analyzeFrameSize(4, flags, 100, [], sources, scope));
		var r = AnalysisWire.decodeAnalyze(payloadOf(frame));
		if (r == null) return t.fail("scope request did not decode");
		t.asserti(flags, r.flags);
		t.asserti(scope.file, r.scope().file);
		t.asserti(scope.offset, r.scope().offset);
		t.asserti(scope.kinds, r.scope().kinds);
		t.assert_string(scope.prefix, r.scope().prefix);
	}
	// A query needs no occurrences.
	var alone = AnalysisWire.decodeAnalyze(payloadOf(AnalysisWire.encodeAnalyze(4, AnalysisWire.WANT_SCOPE, 100, [], sources,
		AnalysisScopeRequest.new(0, 1, AnalysisScopeKinds.PATTERN, "x"))));
	t.assert(alone != null && alone.scope() != null && alone.scope().offset == 1, "a query without occurrences");
	// Without WANT_SCOPE, there is no query.
	var plain = AnalysisWire.decodeAnalyze(payloadOf(AnalysisWire.encodeAnalyze(4, AnalysisWire.WANT_OCCURRENCES, 100, [], sources, null)));
	t.assert(plain != null && plain.scope() == null, "no scope query");
}
// A query for a source, offset, kinds, or prefix that does not exist makes
// the request malformed.
def test_invalid_scope_requests(t: Tester) {
	var sources = scopeSources(), flags = AnalysisWire.WANT_OCCURRENCES | AnalysisWire.WANT_SCOPE;
	var cases = [
		(flags, AnalysisScopeRequest.new(2, 0, AnalysisScopeKinds.VALUES, "")),
		(flags, AnalysisScopeRequest.new(-1, 0, AnalysisScopeKinds.VALUES, "")),
		(flags, AnalysisScopeRequest.new(0, -1, AnalysisScopeKinds.VALUES, "")),
		(flags, AnalysisScopeRequest.new(1, sources[1].input.length + 1, AnalysisScopeKinds.VALUES, "")),
		(flags, AnalysisScopeRequest.new(0, 0, 0, "")),
		(flags, AnalysisScopeRequest.new(0, 0, AnalysisScopeKinds.CALL << 1, "")),
		(flags, AnalysisScopeRequest.new(0, 0, AnalysisScopeKinds.CALL | AnalysisScopeKinds.VALUES, "")),
		(flags, AnalysisScopeRequest.new(0, 0, AnalysisScopeKinds.CALL | AnalysisScopeKinds.MEMBERS, "")),
		(flags, AnalysisScopeRequest.new(0, 0, AnalysisScopeKinds.CALL, "f")),
		(flags, AnalysisScopeRequest.new(0, 0, AnalysisScopeKinds.MEMBERS | AnalysisScopeKinds.VALUES, "")),
		(flags, AnalysisScopeRequest.new(0, 0, AnalysisScopeKinds.VALUES, null)),
		(flags, AnalysisScopeRequest.new(0, 0, AnalysisScopeKinds.VALUES, Array<byte>.new(AnalysisScopeOrder.MAX_PREFIX + 1)))
	];
	for (c in cases) {
		t.assert(AnalysisWire.decodeAnalyze(payloadOf(AnalysisWire.encodeAnalyze(4, c.0, 100, [], sources, c.1))) == null, "malformed scope query");
	}
	// A query that WANT_SCOPE does not announce is a trailing remainder.
	var frame = AnalysisWire.encodeAnalyze(4, AnalysisWire.WANT_OCCURRENCES, 100, [], sources, AnalysisScopeRequest.new(0, 0, AnalysisScopeKinds.VALUES, ""));
	t.assert(AnalysisWire.decodeAnalyze(payloadOf(frame)) == null, "unannounced scope query");
}
// A result with {scope} for the analysis of scopeSources().
def scopedResult(analysis: ProgramAnalysis, scope: AnalysisScopeAnswer, occurrences: bool) -> Array<byte> {
	var files: Array<(string, Array<AnalysisOccurrence>)>;
	if (occurrences) files = [("s.v3", analysis.occurrences("s.v3")), ("t.v3", analysis.occurrences("t.v3"))];
	return payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResultWithQuery(7, 3, 4567, analysis, 12, 42, files, scope, null, null), 1L));
}
def decodeScoped(payload: Array<byte>, requested: bool) -> AnalysisWorkerResult {
	match (AnalysisWire.decodeResultWithQuery(payload, 5, ["s.v3", "t.v3"], if(requested, AnalysisScopeKinds.VALUES))) {
		Decoded(result) => return result;
		_ => return null;
	}
}
def test_scope_answer_round_trip(t: Tester) {
	var sources = scopeSources(), analysis = AeneasAdapter.analyzeForScope(sources, [], false);
	// At the second "b" of "b = b + a": b, then a, then the component's f.
	var offset = 0;
	for (n = 0; n < 2; offset++) if (SCOPED[offset] == 'b') n++;
	offset--;
	var answer = analysis.scopeAt("s.v3", offset, AnalysisScopeKinds.VALUES, "");
	t.assert(answer != null && answer.declarations.length >= 3, "the query has an answer");
	answer.hiddenBuiltins = ["int", "u32"];
	var decoded = decodeScoped(scopedResult(analysis, answer, true), true);
	if (decoded == null) return t.fail("scope answer did not decode");
	var snapshot = decoded.snapshot, scope = snapshot.scope;
	t.assert(scope != null, "the snapshot has the scope");
	t.asserti(answer.declarations.length, scope.declarations.length);
	t.asserti(answer.thisLevel, scope.thisLevel);
	t.assertz(answer.truncated, scope.truncated);
	t.asserti(2, scope.hiddenBuiltins.length);
	t.assert_string("int", scope.hiddenBuiltins[0]);
	t.assert_string("u32", scope.hiddenBuiltins[1]);
	for (i < answer.declarations.length) {
		var d = snapshot.declarations[scope.declarations[i]];
		t.assert_string(answer.declarations[i].name, d.name);
		t.assert(answer.declarations[i].kind == d.kind, "the same kind");
		t.asserti(answer.levels[i], scope.levels[i]);
	}
	t.assert_string("b", snapshot.declarations[scope.declarations[0]].name);
	t.assert_string("a", snapshot.declarations[scope.declarations[1]].name);
	// A declaration that no occurrence names joins the table: C, at offset 0.
	var types = analysis.scopeAt("s.v3", 0, AnalysisScopeKinds.TYPES, "");
	decoded = decodeScoped(scopedResult(analysis, types, true), true);
	t.assert(decoded != null && decoded.snapshot.scope.declarations.length == types.declarations.length, "type candidates decode");
	// Without an occurrence section there is no scope section.
	t.assert(decodeScoped(scopedResult(analysis, answer, false), true).snapshot.scope == null, "no scope without occurrences");
	// With one that has no files, as a worker sends when the request asked
	// for no occurrences, the declarations are the candidates'.
	var bare = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResultWithQuery(7, 3, 4567, analysis, -1, 42, [], answer, null, null), 1L));
	decoded = decodeScoped(bare, true);
	t.assert(decoded != null, "a scope answer without files decodes");
	if (decoded != null) {
		t.asserti(answer.declarations.length, decoded.snapshot.declarations.length);
		for (i < answer.declarations.length) {
			t.asserti(i, decoded.snapshot.scope.declarations[i]);
			t.assert_string(answer.declarations[i].signature, decoded.snapshot.declarations[i].signature);
		}
		t.assert(bare.length < plainLength(analysis), "smaller than the result with occurrences");
	}
	// Without a scope, the result is the one encodeResult writes.
	var files = [("s.v3", analysis.occurrences("s.v3")), ("t.v3", analysis.occurrences("t.v3"))];
	var plain = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResult(7, 3, 4567, analysis, 12, 42, files), 1L));
	t.assert(Arrays.equal(plain, scopedResult(analysis, null, true)), "an ordinary result is unchanged");
	t.assert(decodeScoped(plain, true).snapshot.scope == null, "no scope in an ordinary result");
}
// The length of the result of {analysis} with all its occurrences.
def plainLength(analysis: ProgramAnalysis) -> int {
	var files = [("s.v3", analysis.occurrences("s.v3")), ("t.v3", analysis.occurrences("t.v3"))];
	return AnalysisWire.finishResult(AnalysisWire.encodeResult(7, 3, 4567, analysis, 12, 42, files), 1L).length;
}
// {payload}, which ends with an empty scope answer, with {tail} in place of it.
def withScopeTail(payload: Array<byte>, tail: DataWriter) -> Array<byte> {
	return Arrays.concat(Arrays.range(payload, 0, payload.length - 4), tail.extract());
}
def test_invalid_scope_answers(t: Tester) {
	var sources = scopeSources(), analysis = AeneasAdapter.analyzeForScope(sources, [], false);
	var empty = scopedResult(analysis, AnalysisScopeAnswer.new([], [], -1, false), true);
	t.assert(Arrays.equal<byte>("\x00\x7F\x00\x00", Arrays.range(empty, empty.length - 4, empty.length)), "an empty answer is four bytes");
	var declarations = decodeScoped(empty, true).snapshot.declarations.length;
	t.assert(declarations >= 3, "the result has declarations");
	// Well-formed: two candidates at levels 0 and 2, truncated.
	var good = decodeScoped(withScopeTail(empty, DataWriter.new().putb(1).put_sleb32(0).put_sleb32(2)
		.put_sleb32(1).put_sleb32(0).put_sleb32(0).put_sleb32(2).put_sleb32(0)), true);
	t.assert(good != null && good.snapshot.scope.truncated && good.snapshot.scope.declarations.length == 2, "a hand-built answer decodes");
	var tails = [
		("invalid flags", DataWriter.new().putb(2).put_sleb32(-1).put_sleb32(0)),
		("invalid this level", DataWriter.new().putb(0).put_sleb32(-2).put_sleb32(0)),
		("negative count", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(-1)),
		("count past the bytes", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(2).put_sleb32(0).put_sleb32(0)),
		("index out of range", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(1).put_sleb32(declarations).put_sleb32(0)),
		("negative index", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(1).put_sleb32(-1).put_sleb32(0)),
		("repeated declaration", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(2).put_sleb32(1).put_sleb32(0).put_sleb32(1).put_sleb32(1)),
		("decreasing level", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(2).put_sleb32(0).put_sleb32(1).put_sleb32(1).put_sleb32(0)),
		("negative level", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(1).put_sleb32(0).put_sleb32(-1)),
		("trailing byte", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(0).putb(0).putb(0)),
		("negative hidden count", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(0).put_sleb32(-1)),
		("null hidden name", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(0).put_sleb32(1).put_sleb32(-1)),
		("empty hidden name", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(0).put_sleb32(1).put_sleb32(0)),
		("repeated hidden name", DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(0).put_sleb32(2)
			.put_sleb32(3).puta("int").put_sleb32(3).puta("int"))
	];
	for (c in tails) t.assert(decodeScoped(withScopeTail(empty, c.1), true) == null, c.0);
	// More than the cap, even of valid candidates.
	var many = DataWriter.new().putb(0).put_sleb32(-1).put_sleb32(AnalysisScopeOrder.MAX_DECLARATIONS + 1);
	for (i < AnalysisScopeOrder.MAX_DECLARATIONS + 1) many.put_sleb32(i % declarations).put_sleb32(0);
	t.assert(decodeScoped(withScopeTail(empty, many), true) == null, "over the cap");
	// An answer that the request did not ask for, or without occurrences.
	t.assert(decodeScoped(empty, false) == null, "unrequested scope answer");
	var flagged = scopedResult(analysis, null, false);
	flagged[21] |= 8;
	t.assert(decodeScoped(flagged, true) == null, "scope answer without occurrences");
}
def test_scope_allocation(t: Tester) {
	var sources = scopeSources(), analysis = AeneasAdapter.analyzeForScope(sources, [], false);
	var files = [("s.v3", analysis.occurrences("s.v3")), ("t.v3", analysis.occurrences("t.v3"))];
	var plain = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResult(7, 3, 4567, analysis, 12, 42, files), 1L));
	var base = decodeScoped(plain, false).snapshot.resultAllocation;
	t.assertl(base, decodeScoped(plain, true).snapshot.resultAllocation);
	var empty = scopedResult(analysis, AnalysisScopeAnswer.new([], [], -1, false), true);
	t.assertl(base + 128, decodeScoped(empty, true).snapshot.resultAllocation);
	var tail = DataWriter.new().putb(0).put_sleb32(0).put_sleb32(3);
	for (i < 3) tail.put_sleb32(i).put_sleb32(i);
	tail.put_sleb32(0);
	var three = decodeScoped(withScopeTail(empty, tail), true).snapshot;
	t.assertl(base + 128 + 3 * 8, three.resultAllocation);
	t.assertl(three.resultAllocation - base, three.retainedBytes - decodeScoped(plain, true).snapshot.retainedBytes);
	var hidden = AnalysisScopeAnswer.new([], [], -1, false);
	hidden.hiddenBuiltins = ["int"];
	var decoded = decodeScoped(scopedResult(analysis, hidden, true), true).snapshot;
	t.assertl(base + 128 + 8 + 64 + 3, decoded.resultAllocation);
}

def MEMBERED = "class P(x: int) {\n\tdef m() { }\n}\ndef f(p: P, a: Array<int>) {\n\tp.x;\n\ta.length;\n}\n";
def memberSources() -> Array<AnalysisSource> {
	return [AnalysisSource.new("s.v3", MEMBERED), AnalysisSource.new("t.v3", "class T { }\n")];
}
// The offset of the {n}th "." in MEMBERED, plus one.
def afterDot(n: int) -> int {
	var i = 0;
	for (k = 0; k < n; i++) if (MEMBERED[i] == '.') k++;
	return i;
}
// A member query is a scope query of MEMBERS alone, which the worker answers
// with members rather than a scope.
def test_member_request_round_trip(t: Tester) {
	var sources = memberSources();
	var query = AnalysisScopeRequest.new(0, afterDot(1), AnalysisScopeKinds.MEMBERS, "x");
	var frame = AnalysisWire.encodeAnalyze(4, AnalysisWire.WANT_SCOPE, 100, [], sources, query);
	t.assertl(long.view(frame.length), AnalysisWire.analyzeFrameSize(4, AnalysisWire.WANT_SCOPE, 100, [], sources, query));
	var r = AnalysisWire.decodeAnalyze(payloadOf(frame));
	if (r == null) return t.fail("member request did not decode");
	t.asserti(AnalysisScopeKinds.MEMBERS, r.scope().kinds);
	var analysis = AeneasAdapter.analyzeForScope(sources, [], false);
	t.assert(r.scopeAnswer(analysis) == null, "no scope answer to a member query");
	var members = r.memberAnswer(analysis);
	t.assert(members != null && members.names.length == 2, "the member query has an answer");
	// A scope query has no member answer.
	var scoped = AnalysisWire.decodeAnalyze(payloadOf(AnalysisWire.encodeAnalyze(4, AnalysisWire.WANT_SCOPE, 100, [], sources,
		AnalysisScopeRequest.new(0, afterDot(1), AnalysisScopeKinds.VALUES, ""))));
	t.assert(scoped.memberAnswer(analysis) == null, "no member answer to a scope query");
}
// A result with {members} for the analysis of memberSources().
def memberResult(analysis: ProgramAnalysis, members: AnalysisMemberAnswer, occurrences: bool) -> Array<byte> {
	var files: Array<(string, Array<AnalysisOccurrence>)>;
	if (occurrences) files = [("s.v3", analysis.occurrences("s.v3")), ("t.v3", analysis.occurrences("t.v3"))];
	return payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResultWithQuery(7, 3, 4567, analysis, 12, 42, files, null, members, null), 1L));
}
def decodeMembers(payload: Array<byte>, kinds: int) -> AnalysisWorkerResult {
	match (AnalysisWire.decodeResultWithQuery(payload, 5, ["s.v3", "t.v3"], kinds)) {
		Decoded(result) => return result;
		_ => return null;
	}
}
// Checks that {snapshot}'s member answer is {answer}.
def sameMembers(t: Tester, answer: AnalysisMemberAnswer, snapshot: AnalysisSnapshot) {
	var m = snapshot.members;
	if (m == null) return t.fail("the snapshot has no members");
	t.asserti(answer.names.length, m.names.length);
	t.assertz(answer.truncated, m.truncated);
	for (i < answer.names.length) {
		t.assert_string(answer.names[i], m.names[i]);
		t.assert(answer.kinds[i] == m.kinds[i], "the same kind");
		t.assert_string(answer.details[i], m.details[i]);
		t.asserti(answer.levels[i], m.levels[i]);
		if (answer.declarations[i] == null) {
			t.asserti(-1, m.declarations[i]);
		} else {
			var d = snapshot.declarations[m.declarations[i]];
			t.assert_string(answer.declarations[i].name, d.name);
			t.assert_string(answer.declarations[i].signature, d.signature);
		}
	}
}
def test_member_answer_round_trip(t: Tester) {
	var analysis = AeneasAdapter.analyzeForScope(memberSources(), [], false);
	var members = analysis.membersAt("s.v3", afterDot(1), "");
	t.assert(members != null && members.names.length == 2 && members.declarations[0] != null, "declared members");
	var decoded = decodeMembers(memberResult(analysis, members, true), AnalysisScopeKinds.MEMBERS);
	if (decoded == null) return t.fail("member answer did not decode");
	sameMembers(t, members, decoded.snapshot);
	t.assert(decoded.snapshot.scope == null, "no scope in a member answer");
	// A builtin member, with its name and detail in the string table.
	var builtin = analysis.membersAt("s.v3", afterDot(2), "");
	t.assert(builtin != null && builtin.names.length == 1 && builtin.declarations[0] == null, "a builtin member");
	decoded = decodeMembers(memberResult(analysis, builtin, true), AnalysisScopeKinds.MEMBERS);
	if (decoded == null) return t.fail("builtin member answer did not decode");
	sameMembers(t, builtin, decoded.snapshot);
	// Without occurrences, an occurrence section with no files holds only the
	// members' declarations.
	var bare = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResultWithQuery(7, 3, 4567, analysis, -1, 42, [], null, members, null), 1L));
	decoded = decodeMembers(bare, AnalysisScopeKinds.MEMBERS);
	if (decoded == null) return t.fail("a member answer without files did not decode");
	t.asserti(2, decoded.snapshot.declarations.length);
	sameMembers(t, members, decoded.snapshot);
	// Without an answer, the result is the one encodeResult writes.
	var files = [("s.v3", analysis.occurrences("s.v3")), ("t.v3", analysis.occurrences("t.v3"))];
	var plain = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResult(7, 3, 4567, analysis, 12, 42, files), 1L));
	t.assert(Arrays.equal(plain, memberResult(analysis, null, true)), "an ordinary result is unchanged");
	t.assert(decodeMembers(plain, AnalysisScopeKinds.MEMBERS).snapshot.members == null, "no members in an ordinary result");
}
// {payload}, which ends with an empty member answer, with {tail} in place of it.
def withMemberTail(payload: Array<byte>, tail: DataWriter) -> Array<byte> {
	return Arrays.concat(Arrays.range(payload, 0, payload.length - 2), tail.extract());
}
def test_invalid_member_answers(t: Tester) {
	var analysis = AeneasAdapter.analyzeForScope(memberSources(), [], false);
	var none = AnalysisMemberAnswer.new([], [], [], [], [], false);
	var empty = memberResult(analysis, none, true);
	t.assert(Arrays.equal<byte>("\x00\x00", Arrays.range(empty, empty.length - 2, empty.length)), "an empty answer is two bytes");
	var snapshot = decodeMembers(empty, AnalysisScopeKinds.MEMBERS).snapshot;
	var declarations = snapshot.declarations.length, field = -1;
	for (i < declarations) if (field < 0 && snapshot.declarations[i].kind == AnalysisDeclKind.FIELD) field = i;
	t.assert(field >= 0, "the result declares a field");
	// Well-formed: the field, and a builtin member named by string 0, at
	// levels 0 and 1, truncated.
	var good = decodeMembers(withMemberTail(empty, DataWriter.new().putb(1).put_sleb32(2)
		.put_sleb32(field + 1).put_sleb32(0).put_sleb32(0)
		.put_sleb32(0).putb(byte.view(AnalysisDeclKind.METHOD.tag)).put_sleb32(0).put_sleb32(1).put_sleb32(1)), AnalysisScopeKinds.MEMBERS);
	t.assert(good != null && good.snapshot.members.truncated && good.snapshot.members.names.length == 2, "a hand-built answer decodes");
	var tails = [
		("invalid flags", DataWriter.new().putb(2).put_sleb32(0)),
		("negative count", DataWriter.new().putb(0).put_sleb32(-1)),
		("count past the bytes", DataWriter.new().putb(0).put_sleb32(2).put_sleb32(field + 1).put_sleb32(0).put_sleb32(0)),
		("index out of range", DataWriter.new().putb(0).put_sleb32(1).put_sleb32(declarations + 1).put_sleb32(0).put_sleb32(0)),
		("negative index", DataWriter.new().putb(0).put_sleb32(1).put_sleb32(-1).put_sleb32(0).put_sleb32(0)),
		("invalid kind tag", DataWriter.new().putb(0).put_sleb32(1).put_sleb32(0).putb(byte.view(AnalysisDeclKind.count)).put_sleb32(0).put_sleb32(0).put_sleb32(0)),
		("not a member's kind", DataWriter.new().putb(0).put_sleb32(1).put_sleb32(0).putb(byte.view(AnalysisDeclKind.LOCAL.tag)).put_sleb32(0).put_sleb32(0).put_sleb32(0)),
		("invalid name index", DataWriter.new().putb(0).put_sleb32(1).put_sleb32(0).putb(byte.view(AnalysisDeclKind.FIELD.tag)).put_sleb32(-1).put_sleb32(0).put_sleb32(0)),
		("invalid detail index", DataWriter.new().putb(0).put_sleb32(1).put_sleb32(field + 1).put_sleb32(-1).put_sleb32(0)),
		("negative level", DataWriter.new().putb(0).put_sleb32(1).put_sleb32(field + 1).put_sleb32(0).put_sleb32(-1)),
		("trailing byte", DataWriter.new().putb(0).put_sleb32(0).putb(0))
	];
	for (c in tails) t.assert(decodeMembers(withMemberTail(empty, c.1), AnalysisScopeKinds.MEMBERS) == null, c.0);
	// Answers that the encoder writes as given, and the decoder rejects.
	var d = analysis.membersAt("s.v3", afterDot(1), "").declarations[0];
	var answers = [
		("repeated declaration", AnalysisMemberAnswer.new([d, d], [d.name, d.name], [d.kind, d.kind], [null, null], [0, 0], false)),
		("repeated name", AnalysisMemberAnswer.new([d, null], [d.name, d.name], [d.kind, AnalysisDeclKind.FIELD], [null, null], [0, 0], false)),
		("decreasing level", AnalysisMemberAnswer.new([d, null], [d.name, "y"], [d.kind, AnalysisDeclKind.FIELD], [null, null], [1, 0], false)),
		("empty name", AnalysisMemberAnswer.new([null], [""], [AnalysisDeclKind.FIELD], [null], [0], false)),
		("a local", AnalysisMemberAnswer.new([null], ["y"], [AnalysisDeclKind.LOCAL], [null], [0], false))
	];
	for (c in answers) t.assert(decodeMembers(memberResult(analysis, c.1, true), AnalysisScopeKinds.MEMBERS) == null, c.0);
	// More than the cap, even of valid builtin members.
	var many = Array<string>.new(AnalysisScopeOrder.MAX_DECLARATIONS + 1);
	for (i < many.length) many[i] = Strings.format1("m%d", i);
	var over = AnalysisMemberAnswer.new(Array<AnalysisDeclaration>.new(many.length), many,
		Array<AnalysisDeclKind>.new(many.length), Array<string>.new(many.length), Array<int>.new(many.length), false);
	for (i < many.length) over.kinds[i] = AnalysisDeclKind.FIELD;
	t.assert(decodeMembers(memberResult(analysis, over, true), AnalysisScopeKinds.MEMBERS) == null, "over the cap");
	// An answer that the request did not ask for, or of the other kind, or
	// without occurrences.
	t.assert(decodeMembers(empty, 0) == null, "unrequested member answer");
	t.assert(decodeMembers(empty, AnalysisScopeKinds.VALUES) == null, "member answer to a scope query");
	var scope = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResultWithQuery(7, 3, 4567, analysis, 12, 42,
		[("s.v3", analysis.occurrences("s.v3"))], AnalysisScopeAnswer.new([], [], -1, false), null, null), 1L));
	t.assert(decodeMembers(scope, AnalysisScopeKinds.MEMBERS) == null, "scope answer to a member query");
	var flagged = memberResult(analysis, null, false);
	flagged[21] |= 16;
	t.assert(decodeMembers(flagged, AnalysisScopeKinds.MEMBERS) == null, "member answer without occurrences");
}
// A member answer is charged 64 bytes for its count and 32 for each
// candidate; its names and details are strings of the table.
def test_member_allocation(t: Tester) {
	var analysis = AeneasAdapter.analyzeForScope(memberSources(), [], false);
	var files = [("s.v3", analysis.occurrences("s.v3")), ("t.v3", analysis.occurrences("t.v3"))];
	var plain = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResult(7, 3, 4567, analysis, 12, 42, files), 1L));
	var base = decodeMembers(plain, 0).snapshot.resultAllocation;
	t.assertl(base, decodeMembers(plain, AnalysisScopeKinds.MEMBERS).snapshot.resultAllocation);
	var empty = memberResult(analysis, AnalysisMemberAnswer.new([], [], [], [], [], false), true);
	t.assertl(base + 64, decodeMembers(empty, AnalysisScopeKinds.MEMBERS).snapshot.resultAllocation);
	var members = analysis.membersAt("s.v3", afterDot(1), "");
	var two = decodeMembers(memberResult(analysis, members, true), AnalysisScopeKinds.MEMBERS).snapshot;
	t.assertl(base + 64 + 2 * 32, two.resultAllocation);
	t.assertl(two.resultAllocation - base, two.retainedBytes - decodeMembers(plain, 0).snapshot.retainedBytes);
	// A builtin's name and detail join the string table: 64 plus their
	// bytes, and an 8-byte slot, each.
	var builtin = analysis.membersAt("s.v3", afterDot(2), "");
	var one = decodeMembers(memberResult(analysis, builtin, true), AnalysisScopeKinds.MEMBERS).snapshot;
	t.assertl(base + 64 + 32 + 2 * (64 + 8) + "length".length + "def length: int".length, one.resultAllocation);
}

def CALLING = "component C {\n\tdef f(a: int, b: int) -> int { return a; }\n\tdef g() { f(1, 2); }\n\tdef h(p: int -> int) { p(f(3, 4)); }\n}\n";
def callSources() -> Array<AnalysisSource> {
	return [AnalysisSource.new("s.v3", CALLING), AnalysisSource.new("t.v3", "class T { }\n")];
}
// The offset of the first "(" of the first {call} in CALLING.
def openOf(call: string) -> int {
	var i = 0;
	while (call[i] != '(') i++;
	return OccurrenceCollectorTest.indexOf(CALLING, call) + i;
}
// A call query is a scope query of CALL alone, with no prefix, which the
// worker answers with the call whose argument list opens at its offset.
def test_call_request_round_trip(t: Tester) {
	var sources = callSources();
	var query = AnalysisScopeRequest.new(0, openOf("f(1"), AnalysisScopeKinds.CALL, "");
	for (flags in [AnalysisWire.WANT_SCOPE, AnalysisWire.WANT_SCOPE | AnalysisWire.WANT_OCCURRENCES]) {
		var frame = AnalysisWire.encodeAnalyze(4, flags, 100, [], sources, query);
		t.assertl(long.view(frame.length), AnalysisWire.analyzeFrameSize(4, flags, 100, [], sources, query));
		var r = AnalysisWire.decodeAnalyze(payloadOf(frame));
		if (r == null) return t.fail("call request did not decode");
		t.asserti(AnalysisScopeKinds.CALL, r.scope().kinds);
		t.asserti(query.offset, r.scope().offset);
		t.assert_string("", r.scope().prefix);
	}
	var r = AnalysisWire.decodeAnalyze(payloadOf(AnalysisWire.encodeAnalyze(4, AnalysisWire.WANT_SCOPE, 100, [], sources, query)));
	var analysis = AeneasAdapter.analyzeForScope(sources, [], false);
	t.assert(r.scopeAnswer(analysis) == null, "no scope answer to a call query");
	t.assert(r.memberAnswer(analysis) == null, "no member answer to a call query");
	var call = r.callAnswer(analysis);
	t.assert(call != null && call.open == query.offset, "the call query has an answer");
	// Where no call opens, there is no answer.
	var none = AnalysisWire.decodeAnalyze(payloadOf(AnalysisWire.encodeAnalyze(4, AnalysisWire.WANT_SCOPE, 100, [], sources,
		AnalysisScopeRequest.new(0, query.offset + 1, AnalysisScopeKinds.CALL, ""))));
	t.assert(none != null && none.callAnswer(analysis) == null, "no call at the offset");
	// Scope and member queries have no call answer.
	for (kinds in [AnalysisScopeKinds.VALUES, AnalysisScopeKinds.MEMBERS]) {
		var other = AnalysisWire.decodeAnalyze(payloadOf(AnalysisWire.encodeAnalyze(4, AnalysisWire.WANT_SCOPE, 100, [], sources,
			AnalysisScopeRequest.new(0, query.offset, kinds, ""))));
		t.assert(other != null && other.callAnswer(analysis) == null, "no call answer to another query");
	}
}
// A result with {call} for the analysis of callSources(), with every file's
// occurrences, or, as a worker sends when the request asked for none, an
// occurrence section with no files.
def callResult(analysis: ProgramAnalysis, call: AnalysisCallAnswer, occurrences: bool) -> Array<byte> {
	var files: Array<(string, Array<AnalysisOccurrence>)> = [];
	if (occurrences) files = [("s.v3", analysis.occurrences("s.v3")), ("t.v3", analysis.occurrences("t.v3"))];
	return payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResultWithQuery(7, 3, 4567, analysis, if(occurrences, 12, -1), 42, files, null, null, call), 1L));
}
def decodeCall(payload: Array<byte>, kinds: int, paths: Array<string>) -> AnalysisWorkerResult {
	match (AnalysisWire.decodeResultWithQuery(payload, 5, paths, kinds)) {
		Decoded(result) => return result;
		_ => return null;
	}
}
// The answer is the call as the file's calls have it: its parentheses,
// arguments, callee, target, and signature.
def test_call_answer_round_trip(t: Tester) {
	var analysis = AeneasAdapter.analyzeForScope(callSources(), [], false), paths = ["s.v3", "t.v3"];
	var plain = decodeCall(callResult(analysis, null, true), AnalysisScopeKinds.CALL, paths);
	if (plain == null) return t.fail("the ordinary result did not decode");
	t.assert(plain.snapshot.queriedCall == null, "no call answer in an ordinary result");
	// f(1, 2), with a method as its callee; p(...), with a parameter; and
	// f(3, 4), as p's argument.
	var expected = [
		(openOf("f(1"), "@70-76 callee 69 @71-72 @74-75 target METHOD f @ s.v3:2:13-2:14 signature def f(a: int, b: int) -> int at 6: [a: int] [b: int]"),
		(openOf("p(f"), "@105-114 callee 104 @106-113 target PARAMETER p @ s.v3:4:15-4:16 signature int -> int at 0: [int]"),
		(openOf("f(3"), "@107-113 callee 106 @108-109 @111-112 target METHOD f @ s.v3:2:13-2:14 signature def f(a: int, b: int) -> int at 6: [a: int] [b: int]")
	];
	for (e in expected) {
		var call = analysis.callAt("s.v3", e.0);
		if (call == null) return t.fail1("no call at %d", e.0);
		var ordinary = renderCall(plain.snapshot.callAt("s.v3", e.0 + 1));
		t.assert_string(e.1, ordinary);
		// With occurrences, and without them, when the declarations and
		// signatures are only the answer's.
		for (occurrences in [true, false]) {
			var decoded = decodeCall(callResult(analysis, call, occurrences), AnalysisScopeKinds.CALL, paths);
			if (decoded == null) return t.fail("call answer did not decode");
			t.assert_string(ordinary, renderCall(decoded.snapshot.queriedCall));
			t.assert(decoded.snapshot.scope == null && decoded.snapshot.members == null, "only a call answer");
			if (!occurrences) {
				t.asserti(1, decoded.snapshot.declarations.length);
				t.asserti(0, decoded.snapshot.calls("s.v3").length);
			}
		}
	}
	// Without an answer, the result is the one encodeResult writes.
	var files = [("s.v3", analysis.occurrences("s.v3")), ("t.v3", analysis.occurrences("t.v3"))];
	var bytes = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResult(7, 3, 4567, analysis, 12, 42, files), 1L));
	t.assert(Arrays.equal(bytes, callResult(analysis, null, true)), "an ordinary result is unchanged");
	// An answer to the other queries is malformed, and so is one without
	// occurrences.
	var answer = callResult(analysis, analysis.callAt("s.v3", openOf("f(1")), true);
	for (kinds in [0, AnalysisScopeKinds.VALUES, AnalysisScopeKinds.MEMBERS]) {
		t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResultWithQuery(answer, 5, paths, kinds)), "unrequested call answer");
	}
	var flagged = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResult(7, 3, 4567, analysis, -1, 42, null), 1L));
	flagged[21] |= 32;
	t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResultWithQuery(flagged, 5, paths, AnalysisScopeKinds.CALL)), "call answer without occurrences");
}
// The bytes of a call answer, after the occurrences of withCalls: as a
// file's call, its opening parenthesis, its argument count times eight plus
// its flags, a callee offset with CALLEE_OFFSET, its signature index plus
// one, its arguments, and its closing gap with CLOSE_GAP; then its target's
// declaration index plus one, or zero.
def callAnswer(signatures: string, tail: string) -> Array<byte> {
	var payload = result(0, withCalls(signatures, 0, "").puta(tail));
	payload[21] |= 32;
	return payload;
}
def decodeCallAnswer(signatures: string, tail: string) -> AnalysisResultDecode {
	return AnalysisWire.decodeResultWithQuery(callAnswer(signatures, tail), 1, REQUEST, AnalysisScopeKinds.CALL);
}
def queried(d: AnalysisResultDecode) -> AnalysisCall {
	match (d) {
		Decoded(result) => return result.snapshot.queriedCall;
		_ => return null;
	}
}
def test_hand_built_call_answers(t: Tester) {
	// At 11, a call with its callee two bytes before it, an argument just
	// inside it, and the signature, whose callee names declaration 0.
	t.assert_string("@11-14 callee 9 @12-13 target LOCAL x @ p.v3:1:1-1:2 signature f(a: int) at 2: [a: int]",
		renderCall(queried(decodeCallAnswer(ONE_SIGNATURE, "\x0B\x0A\x02\x01\x04\x01"))));
	// With neither callee, signature, nor target, and a closing gap.
	t.assert_string("@11-16 callee -1 @13-14 target null no signature",
		renderCall(queried(decodeCallAnswer(NO_SIGNATURES, "\x0B\x0C\x00\x05\x01\x00"))));
	// A call that ends at the last offset.
	var last = queried(decodeCallAnswer(NO_SIGNATURES, "\xFD\xFF\xFF\xFF\x07\x00\x00\x00"));
	t.assert(last != null && last.close == int.max, "a call that ends at int.max");
	// Without a call at the offset, the worker sends no answer.
	var none = AnalysisWire.decodeResultWithQuery(result(0, withCalls(NO_SIGNATURES, 0, "")), 1, REQUEST, AnalysisScopeKinds.CALL);
	t.assert(AnalysisResultDecode.Decoded.?(none) && queried(none) == null, "no answer");
}
def test_invalid_call_answers(t: Tester) {
	// int.max - 2 is FD FF FF FF 07.
	var bad = [
		("\x0B\x01\x00\x00", "a callee at the parenthesis, which names a use"),
		("\x0B\x03\x01\x00\x00", "both callee flags"),
		("\x0B\x02\x00\x00\x00", "a callee offset of zero"),
		("\x0B\x02\x0C\x00\x00", "a callee offset before the file"),
		("\x0B\x00\x02\x00", "a signature index past the signatures"),
		("\x0B\x08\x00\x00\x00", "an empty argument"),
		("\x0B\xC0\x3E\x00\x04\x00", "an argument count past the message"),
		("\xFD\xFF\xFF\xFF\x07\x04\x00\x01\x00", "a closing gap past the end of the offsets"),
		("\x80\x80\x80\x80\x08\x00\x00\x00", "a number past int.max"),
		("\x0B\x00\x00\x02", "a target past the declarations"),
		("\x0B\x00\x00\x7F", "a negative target"),
		("\x0B\x00\x00", "no target"),
		("\x0B\x00\x00\x00\x00", "a trailing byte"),
		("", "a flag without an answer")
	];
	for (b in bad) {
		for (signatures in [NO_SIGNATURES, ONE_SIGNATURE]) {
			t.assert(AnalysisResultDecode.Malformed.?(decodeCallAnswer(signatures, b.0)), b.1);
		}
	}
	// A valid answer, unrequested.
	var good = callAnswer(ONE_SIGNATURE, "\x0B\x0A\x02\x01\x04\x01");
	for (kinds in [0, AnalysisScopeKinds.VALUES, AnalysisScopeKinds.MEMBERS]) {
		t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResultWithQuery(good, 1, REQUEST, kinds)), "unrequested call answer");
	}
}
// A call answer is charged 64 bytes and 8 for each argument; its signature,
// 64 bytes, 8 for each parameter, and the signature text that it copies, 64
// bytes and its length for each string.
def test_call_answer_allocation(t: Tester) {
	var cases = [
		// No arguments, no signature.
		(NO_SIGNATURES, "\x0B\x00\x00\x00", 64),
		// Two arguments.
		(NO_SIGNATURES, "\x0B\x10\x00\x04\x05\x00", 64 + 2 * 8),
		// ONE_SIGNATURE's: "f(a: int)" and "a: int" are signature text.
		(ONE_SIGNATURE, "\x0B\x0A\x02\x01\x04\x01", 64 + 8 + 64 + 8 + (64 + 9) + (64 + 6)),
		// A label from the string table, "int", copies nothing.
		("\x00\x01\x01\x03\x00", "\x0B\x00\x01\x00", 64 + 64)
	];
	for (c in cases) {
		var base = AnalysisWire.decodeResultWithQuery(result(0, withCalls(c.0, 0, "")), 1, REQUEST, AnalysisScopeKinds.CALL);
		var answered = decodeCallAnswer(c.0, c.1);
		if (!AnalysisResultDecode.Decoded.?(base) || queried(answered) == null) return t.fail1("%s did not decode", c.1);
		var before = AnalysisResultDecode.Decoded.!(base).result.snapshot, after = AnalysisResultDecode.Decoded.!(answered).result.snapshot;
		t.assertl(long.view(c.2), after.resultAllocation - before.resultAllocation);
		t.assertl(after.resultAllocation - before.resultAllocation, after.retainedBytes - before.retainedBytes);
	}
}

// A complemented target is a write, with exactly the same decoded storage
// as a read. Neither a bad index nor a sign bit can bypass the bound.
def test_occurrence_write_bit(t: Tester) {
	var read = decodedResult(result(0, file(declarations(1, 0, 0), 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY)), 1, REQUEST);
	var write = decodedResult(result(0, file(declarations(1, 0, 0), 1).puta(OCCURRENCE).put_sleb32(-1).puta(NO_DISPLAY)), 1, REQUEST);
	if (read == null || write == null) return t.fail("valid read/write targets rejected");
	t.assertl(read.snapshot.resultAllocation, write.snapshot.resultAllocation);
	t.assertl(read.snapshot.retainedBytes, write.snapshot.retainedBytes);
	t.assert(!read.snapshot.occurrences("p.v3")[0].isWrite(), "read flag");
	t.assert(write.snapshot.occurrences("p.v3")[0].isWrite(), "write flag round trip");
	t.assert(write.snapshot.definitionAtOffset("p.v3", 8) == write.snapshot.declarations[0], "write still resolves");
	for (target in [-2, int.min]) {
		assertMalformed(t, file(declarations(1, 0, 0), 1).puta(OCCURRENCE).put_sleb32(target).puta(NO_DISPLAY), "invalid write target");
	}
}

// A located type is two compressed integers and one checkpoint, not an
// object or string per occurrence. Invalid offsets and targets are rejected.
def test_type_targets(t: Tester) {
	var empty = decodedResult(result(0, file(declarations(1, 0, 0), 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY)), 1, REQUEST);
	var good = decodedResult(result(0, typeTargets(1, "\x08\x01")), 1, REQUEST);
	if (empty == null || good == null) return t.fail("valid type-target table rejected");
	t.assertl(64L + 8 + 64 + 2, good.snapshot.resultAllocation - empty.snapshot.resultAllocation);
	t.assertl(good.snapshot.resultAllocation - empty.snapshot.resultAllocation,
		good.snapshot.retainedBytes - empty.snapshot.retainedBytes);
	t.assert(good.snapshot.typeDefinitionAtOffset("p.v3", 8).1 == good.snapshot.declarations[0], "target is a declaration ID");
	// A default has the same checked code space as an override. It is
	// stored in the existing declaration record without another array.
	var defaulted = decodedResult(result(0, file(declarationsWithType(1, 0, 0, 1), 1)
		.puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY)), 1, REQUEST);
	if (defaulted == null) return t.fail("valid default type target rejected");
	t.assert(defaulted.snapshot.typeDefinitionAtOffset("p.v3", 8).1 == defaulted.snapshot.declarations[0], "shared default");
	t.assertl(empty.snapshot.resultAllocation, defaulted.snapshot.resultAllocation);
	for (code in [-1, 2, int.max]) assertMalformed(t, file(declarationsWithType(1, 0, 0, code), 1)
		.puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY), "invalid default type target");
	for (bad in [(1, "\x08\x02"), (1, "\x08\x7F"), (1, "\x09\x00"), (1, "\x7F\x00"),
			(2, "\x08\x00\x00\x00"), (-1, ""), (int.max, "")]) {
		assertMalformed(t, typeTargets(bad.0, bad.1), "bad type-target table");
	}
	for (data in ["\x08\x00\x00\x00", "\x0A\x00\x7F\x00", "\x08\x00\xFF\xFF\xFF\xFF\x07\x00"]) {
		var w = file(declarations(1, 0, 0), 2).puta(OCCURRENCE).put_sleb32(0)
			.puta("\x01\x03\x0A\x01").put_sleb32(0).put_sleb32(0).put_sleb32(0)
			.put_sleb32(2).puta(data).put_sleb32(0).put_sleb32(0);
		assertMalformed(t, w, "unordered or overflowing type-target offsets");
	}
}
// Two declarations of kinds {kinds} at separate sites of p.v3, with parents
// {parents}: each an index plus one, or zero.
def parented(kinds: (AnalysisDeclKind, AnalysisDeclKind), parents: (int, int)) -> DataWriter {
	return parentedAll([kinds.0, kinds.1], [parents.0, parents.1]);
}
// Declarations of {kinds} with {parents}, the k-th at 1:4k+1-1:4k+2, bytes
// 4k + 4 to 4k + 5, all named "x" and sites of "p.v3".
def parentedAll(kinds: Array<AnalysisDeclKind>, parents: Array<int>) -> DataWriter {
	var w = DataWriter.new().put_sleb32(1).put_sleb32(1).putb('x').put_sleb32(kinds.length);
	for (k < kinds.length) {
		w.putb(kinds[k].tag).put_sleb32(0).put_sleb32(0);
		w.put_sleb32(1).put_sleb32(4 * k + 1).put_sleb32(1).put_sleb32(4 * k + 2).put_sleb32(4 * k + 4).put_sleb32(4 * k + 5);
		w.put_sleb32(0).put_sleb32(0).put_sleb32(parents[k]);
	}
	return site(w, 0, 0, kinds.length);
}
// A parent is another declaration's index plus one, in range and never the
// declaration's own, and only a class, a variant case, or a method has one:
// a class's is a class or a variant case, a case's a class, and a method's a
// method. Parents form no cycle, of any length. Parents add nothing to the
// charge.
// A declaration's kind byte carries its flag (AnalysisDeclaration.flagged),
// which only a local, parameter, field, class, or method may have, and which
// the snapshot's declaration keeps.
def FLAGS_SOURCE = "component C { def K = 1; var v = 2; def f(p: int) { def a = p; var b = a; } }\nclass A(x: int, var y: int) { def m() { } }\ntype V { case X; }\n";
def test_declaration_flags(t: Tester) {
	var analysis = AeneasAdapter.analyzeProgram([AnalysisSource.new("flags.v3", FLAGS_SOURCE)], [], false);
	if (!analysis.verified) return t.fail("the source verifies");
	var data = payloadOf(AnalysisWire.finishResult(AnalysisWire.encodeResult(1, 1, 1, analysis, 0, 0,
		[("flags.v3", analysis.occurrences("flags.v3"))]), 0L));
	var decoded = decodedResult(data, 1, ["flags.v3"]);
	if (decoded == null) return t.fail("the result was rejected");
	var flagged = ["K", "f", "a", "x", "V"], plain = ["C", "v", "p", "b", "A", "y", "m", "X"];
	for (d in decoded.snapshot.declarationSites("flags.v3")) {
		var expected = -1;
		for (name in flagged) if (Strings.equal(name, d.name)) expected = 1;
		for (name in plain) if (Strings.equal(name, d.name)) expected = 0;
		if (expected < 0) t.fail1("unexpected declaration %s", d.name);
		else if (d.flagged() != (expected == 1)) t.fail1("the flag of %s", d.name);
	}
	t.asserti(flagged.length + plain.length, decoded.snapshot.declarationSites("flags.v3").length);
	// By hand: the flag decodes only on the kinds that have one.
	for (kind in AnalysisDeclKind) {
		var w = file(declaration(kind.tag | AnalysisWire.FLAGGED, 0), 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY);
		var r = decodedResult(result(0, w), 1, REQUEST), allowed = false;
		match (kind) {
			LOCAL, PARAMETER, FIELD, CLASS, METHOD => allowed = true;
			_ => ;
		}
		if (!allowed) {
			t.assert(r == null, "a flag on a kind without one is malformed");
			continue;
		}
		var d = if(r != null, r.snapshot.definitionAt("p.v3", 1, 1));
		t.assert(d != null && d.kind == kind && d.flagged(), "a flagged declaration decodes");
		w = file(declaration(kind.tag, 0), 1).puta(OCCURRENCE).put_sleb32(0).puta(NO_DISPLAY);
		r = decodedResult(result(0, w), 1, REQUEST);
		d = if(r != null, r.snapshot.definitionAt("p.v3", 1, 1));
		t.assert(d != null && !d.flagged(), "an unflagged declaration decodes");
	}
}

def test_parents(t: Tester) {
	var c = AnalysisDeclKind.CLASS, m = AnalysisDeclKind.METHOD;
	var plain = decodedResult(result(0, parented((c, c), (0, 0))), 1, REQUEST);
	var linked = decodedResult(result(0, parented((c, c), (0, 1))), 1, REQUEST);
	if (plain == null || linked == null) return t.fail("valid parents rejected");
	t.assertl(plain.snapshot.resultAllocation, linked.snapshot.resultAllocation);
	t.assertl(plain.snapshot.retainedBytes, linked.snapshot.retainedBytes);
	var s = linked.snapshot, found = s.implementations(s.declarations[0]);
	t.assert(found.length == 1 && found[0] == s.declarations[1], "a parent's implementation");
	t.asserti(0, s.implementations(s.declarations[1]).length);
	t.asserti(0, plain.snapshot.implementations(plain.snapshot.declarations[0]).length);
	var chain = decodedResult(result(0, parentedAll([c, c, c, c], [0, 1, 2, 2])), 1, REQUEST);
	if (chain == null) return t.fail("a chain and a fork were rejected");
	s = chain.snapshot;
	t.asserti(3, s.implementations(s.declarations[0]).length);
	t.asserti(2, s.implementations(s.declarations[1]).length);
	assertMalformed(t, parented((m, m), (2, 1)), "a cycle of two");
	assertMalformed(t, parentedAll([c, c, c], [2, 3, 1]), "a cycle of three");
	assertMalformed(t, parentedAll([c, c, c, c, c], [0, 3, 4, 5, 3]), "a cycle of three after a root and a tail");
	assertMalformed(t, parentedAll([m, m, m], [0, 1, 3]), "a third declaration as its own parent");
	for (parent in [-1, 3, int.max, int.min]) assertMalformed(t, parented((c, c), (0, parent)), "a parent out of range");
	assertMalformed(t, parented((c, c), (1, 0)), "the first declaration as its own parent");
	assertMalformed(t, parented((c, c), (0, 2)), "the second declaration as its own parent");
	for (child in AnalysisDeclKind) {
		for (parent in AnalysisDeclKind) {
			var valid = (child == c && (parent == c || parent == AnalysisDeclKind.VARIANT_CASE))
				|| (child == AnalysisDeclKind.VARIANT_CASE && parent == c) || (child == m && parent == m);
			var decoded = AnalysisWire.decodeResult(result(0, parented((parent, child), (0, 1))), 1, REQUEST);
			var name = Strings.format2("a %s's parent of kind %s", child.name, parent.name);
			t.assert(if(valid, AnalysisResultDecode.Decoded.?(decoded), AnalysisResultDecode.Malformed.?(decoded)), name);
		}
	}
}
// The encoder drops the parents on each cycle of its sparse links, which
// name only the declarations that have a parent, and keeps the rest.
def test_link_cycles(t: Tester) {
	// Pairs of a declaration and its parent plus one: 0 -> 1, which has no
	// pair; a cycle of two, 2 and 4; 5 -> 2, into it; a cycle of three, 6,
	// 7, and 8; 9 -> 0; and 10 as its own parent. The last pair is past the
	// count.
	var links = [0, 2, 2, 5, 4, 3, 5, 3, 6, 8, 7, 9, 8, 7, 9, 1, 10, 11, 99, 99];
	t.assertz(true, AnalysisWire.dropLinkCycles(links, links.length - 2));
	var parents = [2, 0, 0, 3, 0, 0, 0, 1, 0, 99];
	for (i < parents.length) t.asserti(parents[i], links[2 * i + 1]);
	t.assertz(false, AnalysisWire.dropLinkCycles(links, links.length - 2));
	t.assertz(false, AnalysisWire.dropLinkCycles(Array<int>.new(0), 0));
}
def typeTargets(count: int, data: string) -> DataWriter {
	return file(declarations(1, 0, 0), 1).puta(OCCURRENCE).put_sleb32(0)
		.put_sleb32(0).put_sleb32(0).put_sleb32(count).puta(data).put_sleb32(0).put_sleb32(0);
}

// A prior collection must not leak its otherwise unused type declarations
// into an encoding that selects a different file from the same analysis.
def test_type_targets_selected_files(t: Tester) {
	var a = AeneasAdapter.analyzeProgram([
		AnalysisSource.new("a.v3", "class A { } def a: A;"),
		AnalysisSource.new("b.v3", "class B { } def b: B;")], [], false);
	t.assert(a.verified, "independent files verify");
	a.occurrences("a.v3");
	// Let encoding collect b's sites lazily, so the numeric index also has
	// to be sized after every selected file has finished collecting.
	var frame = AnalysisWire.finishResult(AnalysisWire.encodeResult(1, 1, 1, a, 0, 0, [("b.v3", [])]), 0L);
	var r = decodedResult(payloadOf(frame), 1, ["b.v3"]);
	if (r == null) return t.fail("selected file did not decode");
	t.asserti(2, r.snapshot.declarations.length);
	var found = r.snapshot.typeDefinitionAtOffset("b.v3", 16);
	t.assert(found.0 && found.1 != null, "selected declaration keeps its type");
	if (found.1 != null) t.assert_string("B", found.1.name);
}

// Packing saves an actual stored integer per occurrence, with unchanged wire
// coordinate validation and full-width fallback for generated large sources.
def test_compact_coordinates(t: Tester) {
	for (pair in [(1, 1), (65535, 65535)]) {
		var span = DataWriter.new().put_sleb32(pair.0).put_sleb32(pair.1).put_sleb32(8).put_sleb32(1).put_sleb32(0).extract();
		var raw = decodedResult(result(0, file(declarations(1, 0, 0), 1).puta(span).puta(NO_DISPLAY)), 1, REQUEST);
		var packed = decodedResult(result(0, file(declarations(1, 0, 0), -1).puta(span).puta(NO_DISPLAY)), 1, REQUEST);
		if (raw == null || packed == null) return t.fail("coordinate forms rejected");
		t.assertl(raw.snapshot.resultAllocation - 4, packed.snapshot.resultAllocation);
		var r = packed.snapshot.occurrences("p.v3")[0].range;
		t.asserti(pair.0, r.beginLine);
		t.asserti(pair.1, r.beginColumn);
		t.asserti(8, r.beginOffset);
		t.asserti(9, r.endOffset);
		t.assert(packed.snapshot.definitionAt("p.v3", pair.0, pair.1) != null, "compiler lookup");
		t.assert(packed.snapshot.definitionAtOffset("p.v3", 8) != null, "byte lookup");
	}
	for (pair in [(0, 1), (1, 0), (65536, 1), (1, 65536), (int.max, int.max)]) {
		var span = DataWriter.new().put_sleb32(pair.0).put_sleb32(pair.1).put_sleb32(8).put_sleb32(1).put_sleb32(0).extract();
		assertMalformed(t, file(declarations(1, 0, 0), -1).puta(span).puta(NO_DISPLAY), "invalid packed coordinate");
		if (pair.0 > 0 && pair.1 > 0 && pair.1 < int.max) {
			t.assert(decodedResult(result(0, file(declarations(1, 0, 0), 1).puta(span).puta(NO_DISPLAY)), 1, REQUEST) != null, "full-width fallback");
		}
	}
}
