def check(t: Tester, text: string, at: int, want: Array<(int, int)>, options: Array<string>) {
	var a = AeneasAdapter.selectionRanges("selection.v3", text, options, [at]);
	t.asserti(1, a.length);
	t.asserti(want.length, a[0].length);
	for (i < Ints.min(want.length, a[0].length)) {
		t.asserti(want[i].0, a[0][i].begin);
		t.asserti(want[i].1, a[0][i].end);
	}
}
def boundaries(t: Tester) {
	// Within x, at x's end, and in whitespace before x (after the opener
	// with a gap) all select the specified token before growing outwards.
	check(t, "def x = 1;", 10, [(9, 10), (0, 10)], []);
	check(t, "def x = 1;\n", 11, [(0, 11)], []);
	check(t, "", 0, [(0, 0)], []);
	check(t, "def x =  1;", 7, [(6, 7), (0, 11)], []);
	check(t, "def x =  1;", 9, [(9, 10), (0, 11)], []);
	check(t, "// one\r\n// two", 3, [(0, 6), (0, 14)], []);
	// An unconsumed top-level tail has lexical tokens only. Unterminated
	// literals prevent recovery beyond them, including fake delimiters.
	check(t, "def x = 1; unexpected(42)", 22, [(22, 24), (0, 25)], []);
	check(t, "def x = 1; \"broken", 16, [(0, 18)], []);
	check(t, "unexpected + next", 11, [(0, 17)], []);
	check(t, "unexpected + next", 14, [(13, 17), (0, 17)], []);
}
def running() -> LspServer {
	var s = LspServer.new(DocumentLimits.MAX_BYTES);
	s.handle("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}");
	return s;
}
def request(s: LspServer, params: string) -> JsonValue {
	var p = JsonRpcJsonParser.new(s.handle(Strings.format1("{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"textDocument/selectionRange\",\"params\":%s}", params)));
	p.maxDepth = 512;
	p.maxValues = int.max;
	return p.parseDocument();
}
def query(s: LspServer, positions: string) -> Array<JsonValue> {
	return JsonValue.JArray.!(JsonValue.JObject.!(request(s, Strings.format1("{\"textDocument\":{\"uri\":\"untitled:selection.v3\"},\"positions\":%s}", positions))).v["result"]).v;
}
def protocol(t: Tester) {
	var s = running();
	t.asserti(0, query(s, "[{\"line\":0,\"character\":0}]").length);
	s.documents.open("untitled:selection.v3", "virgil", 1, "component C {\r\n\tdef f() { /* é𝄞 */ return; }\r\n}\r\n");
	var a = query(s, "[{\"line\":1,\"character\":16},{\"line\":99,\"character\":999},{\"line\":0,\"character\":0}]");
	t.asserti(3, a.length);
	var range = JsonValue.JObject.!(JsonValue.JObject.!(a[0]).v["range"]).v;
	var start = JsonValue.JObject.!(range["start"]).v, end = JsonValue.JObject.!(range["end"]).v;
	t.asserti(1, JsonValue.Int.!(start["line"]).v);
	t.asserti(11, JsonValue.Int.!(start["character"]).v);
	t.asserti(1, JsonValue.Int.!(end["line"]).v);
	t.asserti(20, JsonValue.Int.!(end["character"]).v);
	// Past-end positions clamp to the document, whose last empty line is 3.
	range = JsonValue.JObject.!(JsonValue.JObject.!(a[1]).v["range"]).v;
	t.asserti(3, JsonValue.Int.!(JsonValue.JObject.!(range["end"]).v["line"]).v);
	t.assert(!JsonValue.JObject.!(a[1]).v.has("parent"), "document alone at EOF");
	s.documents.change("untitled:selection.v3", 2, "def x = 1;");
	t.asserti(1, query(s, "[{\"line\":0,\"character\":8}]").length);
	s.documents.close("untitled:selection.v3");
	t.asserti(0, query(s, "[{\"line\":0,\"character\":0}]").length);
	for (p in ["null", "[]", "{}", "{\"textDocument\":{\"uri\":\"\"},\"positions\":[]}",
		"{\"textDocument\":{\"uri\":\"untitled:selection.v3\"},\"positions\":null}",
		"{\"textDocument\":{\"uri\":\"untitled:selection.v3\"},\"positions\":[null]}",
		"{\"textDocument\":{\"uri\":\"untitled:selection.v3\"},\"positions\":[{\"line\":-1,\"character\":0}]}",
		"{\"textDocument\":{\"uri\":\"untitled:selection.v3\"},\"positions\":[{\"line\":0,\"character\":\"0\"}]}"] ) {
		var obj = JsonValue.JObject.!(request(s, p)).v;
		t.asserti(-32602, JsonValue.Int.!(JsonValue.JObject.!(obj["error"]).v["code"]).v);
	}
	var cold = LspServer.new(DocumentLimits.MAX_BYTES);
	t.asserti(-32002, JsonValue.Int.!(JsonValue.JObject.!(JsonValue.JObject.!(request(cold, "{}")).v["error"]).v["code"]).v);
	s.handle("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}");
	t.asserti(-32600, JsonValue.Int.!(JsonValue.JObject.!(JsonValue.JObject.!(request(s, "{}")).v["error"]).v["code"]).v);
}
def limits(t: Tester) {
	var b = StringBuilder.new().puts("def x = ");
	for (i < 180) b.putc('(');
	b.puts("42");
	for (i < 180) b.putc(')');
	b.putc(';');
	var text = b.toString();
	var a = AeneasAdapter.selectionRanges("selection.v3", text, [], [189])[0];
	t.asserti(128, a.length);
	t.asserti(0, a[a.length - 1].begin);
	t.asserti(text.length, a[a.length - 1].end);
	for (i = 1; i < a.length; i++) {
		t.assert(a[i].begin <= a[i - 1].begin && a[i].end >= a[i - 1].end &&
			(a[i].begin != a[i - 1].begin || a[i].end != a[i - 1].end), "strict containment");
	}
	var s = running(), positions = StringBuilder.new().putc('[');
	for (i < 101) {
		if (i > 0) positions.putc(',');
		positions.puts("{\"line\":0,\"character\":0}");
	}
	positions.putc(']');
	var reply = request(s, Strings.format1("{\"textDocument\":{\"uri\":\"untitled:selection.v3\"},\"positions\":%s}", positions.toString()));
	t.asserti(-32602, JsonValue.Int.!(JsonValue.JObject.!(JsonValue.JObject.!(reply).v["error"]).v["code"]).v);
}
