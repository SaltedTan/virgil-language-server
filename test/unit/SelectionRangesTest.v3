def name_expression(t: Tester) {
	check(t, "component C { def f(x: int) { var y = g((x + 1), [2, 3][0]); } }\n", 41, [
		(41, 42),
		(41, 46),
		(40, 47),
		(40, 58),
		(39, 59),
		(30, 60),
		(28, 62),
		(14, 62),
		(12, 64),
		(0, 64),
		(0, 65),
	], []);
}

