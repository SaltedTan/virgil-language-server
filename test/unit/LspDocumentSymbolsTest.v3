def T = UnitTests.register;
def X = [
	T("LspDocumentSymbols:hierarchy_ranges", test_symbol_hierarchy),
	T("LspDocumentSymbols:overlay_parse_failure", test_symbol_overlay),
	T("LspDocumentSymbols:utf16_ranges", test_symbol_utf16_ranges),
	T("LspDocumentSymbols:params_lifecycle", test_symbol_params),
	T("LspDocumentSymbols:header_fields_cr", test_symbol_header_fields),
	T("LspDocumentSymbols:bound_index_operators", test_symbol_bound_index_operators),
	T("LspDocumentSymbols:expression_bodies", test_symbol_expression_bodies),
	T("LspDocumentSymbols:large_single_line", test_symbol_large_single_line),
	T("LspDocumentSymbols:variant_cases", test_symbol_variant_cases),
	T("LspDocumentSymbols:default_case", test_symbol_default_case),
	T("LspDocumentSymbols:flat_symbols", test_symbol_flat),
	T("LspDocumentSymbols:details_current_snapshot", test_symbol_details),
	T("LspDocumentSymbols:details_stale_snapshot", test_symbol_details_stale),
	T("LspDocumentSymbols:details_outside_project", test_symbol_details_outside_project),
	()
];

def URI = "untitled:symbols.v3";
def REQUEST = "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"textDocument/documentSymbol\",\"params\":{\"textDocument\":{\"uri\":\"untitled:symbols.v3\"}}}";
// The hierarchy answers these tests expect need the capability.
def HIERARCHICAL = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"textDocument\":{\"documentSymbol\":{\"hierarchicalDocumentSymbolSupport\":true}}}}}";
def running(t: Tester) -> LspServer {
	var s = LspServer.new(DocumentLimits.MAX_BYTES);
	t.assert(s.handle(HIERARCHICAL) != null, "initialize reply");
	return s;
}
def symbols(t: Tester, s: LspServer) -> Array<JsonValue> {
	var parsed = JsonRpcJsonParser.new(s.handle(REQUEST));
	// Server output can contain more values than the client input limit.
	parsed.maxValues = int.max;
	var obj = JsonValue.JObject.!(parsed.parseDocument()).v;
	t.assert(parsed.ok, "symbol reply must be JSON");
	t.assert(obj.has("result"), "symbol request must succeed");
	return JsonValue.JArray.!(obj["result"]).v;
}
def children(s: JsonValue) -> Array<JsonValue> {
	return JsonValue.JArray.!(JsonValue.JObject.!(s).v["children"]).v;
}
def checkPosition(t: Tester, v: JsonValue, line: int, column: int) {
	var obj = JsonValue.JObject.!(v).v;
	t.asserti(line, JsonValue.Int.!(obj["line"]).v);
	t.asserti(column, JsonValue.Int.!(obj["character"]).v);
}
def checkSymbol(t: Tester, v: JsonValue, name: string, kind: int, bl: int, bc: int, el: int, ec: int, nl: int, nc: int) {
	var obj = JsonValue.JObject.!(v).v;
	t.assert_string(name, JsonValue.String.!(obj["name"]).v);
	t.asserti(kind, JsonValue.Int.!(obj["kind"]).v);
	var r = JsonValue.JObject.!(obj["range"]).v;
	checkPosition(t, r["start"], bl, bc);
	checkPosition(t, r["end"], el, ec);
	r = JsonValue.JObject.!(obj["selectionRange"]).v;
	checkPosition(t, r["start"], nl, nc);
	checkPosition(t, r["end"], nl, nc + name.length);
}

def test_symbol_hierarchy(t: Tester) {
	var s = running(t);
	var text = "private component C {\n\tprivate def text = \"};{}\"; // not a delimiter\n\tdef f(x: int) -> int {\n\t\tif (x > 0) { return x; }\n\t\treturn 0;\n\t}\n}\nclass K(value: int) {\n\tnew() {}\n\tvar a = [1, 2], b = 3;\n\tdef abstract() -> int;\n}\nenum E { A, B(1) }\nlayout L {\n\t+0 word: int;\n\t=4;\n}\npacking P(x: 1): 2 = 0b0x;\ndef top() {}";
	t.assert(s.documents.open(URI, "virgil", 1, text) == null, "open");
	var a = symbols(t, s);
	t.asserti(6, a.length);
	checkSymbol(t, a[0], "C", 3, 0, 0, 6, 1, 0, 18);
	var c = children(a[0]);
	t.asserti(2, c.length);
	checkSymbol(t, c[0], "text", 8, 1, 1, 1, 27, 1, 13);
	checkSymbol(t, c[1], "f", 6, 2, 1, 5, 2, 2, 5);
	checkSymbol(t, a[1], "K", 5, 7, 0, 11, 1, 7, 6);
	c = children(a[1]);
	t.asserti(5, c.length);
	checkSymbol(t, c[0], "value", 8, 7, 8, 7, 18, 7, 8);
	checkSymbol(t, c[1], "new", 9, 8, 1, 8, 9, 8, 1);
	checkSymbol(t, c[2], "a", 8, 9, 1, 9, 23, 9, 5);
	checkSymbol(t, c[3], "b", 8, 9, 1, 9, 23, 9, 17);
	checkSymbol(t, c[4], "abstract", 6, 10, 1, 10, 23, 10, 5);
	checkSymbol(t, a[2], "E", 10, 12, 0, 12, 18, 12, 5);
	c = children(a[2]);
	t.asserti(2, c.length); // no synthesized tag/name or duplicated cases
	checkSymbol(t, c[0], "A", 22, 12, 9, 12, 10, 12, 9);
	checkSymbol(t, c[1], "B", 22, 12, 12, 12, 16, 12, 12);
	checkSymbol(t, a[3], "L", 23, 13, 0, 16, 1, 13, 7);
	c = children(a[3]);
	t.asserti(1, c.length);
	checkSymbol(t, c[0], "word", 8, 14, 1, 14, 14, 14, 4);
	checkSymbol(t, a[4], "P", 23, 17, 0, 17, 26, 17, 8);
	checkSymbol(t, a[5], "top", 6, 18, 0, 18, 12, 18, 4);
}

// A check for one flat SymbolInformation: its name, kind, container, and the
// range of its whole declaration in its location.
def checkFlatSymbol(t: Tester, v: JsonValue, name: string, kind: int, container: string,
		bl: int, bc: int, el: int, ec: int) {
	var obj = JsonValue.JObject.!(v).v;
	t.assert_string(name, JsonValue.String.!(obj["name"]).v);
	t.asserti(kind, JsonValue.Int.!(obj["kind"]).v);
	t.assertz(false, obj.has("children"));
	t.assertz(false, obj.has("selectionRange"));
	t.assertz(false, obj.has("detail"));
	if (container == null) {
		t.assertz(false, obj.has("containerName"));
	} else {
		t.assert_string(container, JsonValue.String.!(obj["containerName"]).v);
	}
	var location = JsonValue.JObject.!(obj["location"]).v;
	t.assert_string(URI, JsonValue.String.!(location["uri"]).v);
	var r = JsonValue.JObject.!(location["range"]).v;
	checkPosition(t, r["start"], bl, bc);
	checkPosition(t, r["end"], el, ec);
}

// A client that doesn't declare hierarchicalDocumentSymbolSupport gets flat
// SymbolInformation[], in pre-order, with each nested symbol's parent named.
def test_symbol_flat(t: Tester) {
	var text = "type V {\n\tcase A(x: int);\n\tdef helper() {}\n}\ncomponent C {\n\tdef field = 1;\n}";
	var s = LspServer.new(DocumentLimits.MAX_BYTES);
	t.assert(s.handle("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}") != null, "initialize reply");
	s.documents.open(URI, "virgil", 1, text);
	var a = symbols(t, s);
	t.asserti(6, a.length);
	checkFlatSymbol(t, a[0], "V", 5, null, 0, 0, 3, 1);
	checkFlatSymbol(t, a[1], "A", 22, "V", 1, 1, 1, 16);
	checkFlatSymbol(t, a[2], "x", 8, "A", 1, 8, 1, 14);
	checkFlatSymbol(t, a[3], "helper", 6, "V", 2, 1, 2, 16);
	checkFlatSymbol(t, a[4], "C", 3, null, 4, 0, 6, 1);
	checkFlatSymbol(t, a[5], "field", 8, "C", 5, 1, 5, 15);
	// Only exactly true selects the hierarchical shape; false and other
	// values, such as the string "true", keep it flat.
	for (capability in ["false", "\"true\"", "1"]) {
		var flat = LspServer.new(DocumentLimits.MAX_BYTES);
		var init = Strings.format1("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"textDocument\":{\"documentSymbol\":{\"hierarchicalDocumentSymbolSupport\":%s}}}}}", capability);
		t.assert(flat.handle(init) != null, "initialize reply");
		flat.documents.open(URI, "virgil", 1, text);
		var b = symbols(t, flat);
		t.asserti(6, b.length);
		for (i < b.length) t.assertz(false, JsonValue.JObject.!(b[i]).v.has("children"));
	}
}

def test_symbol_overlay(t: Tester) {
	var s = running(t);
	t.asserti(0, symbols(t, s).length); // unopened, no disk fallback
	s.documents.open(URI, "virgil", 1, "component Old {}");
	checkSymbol(t, symbols(t, s)[0], "Old", 3, 0, 0, 0, 16, 0, 10);
	s.documents.change(URI, 2, "component New {}");
	checkSymbol(t, symbols(t, s)[0], "New", 3, 0, 0, 0, 16, 0, 10);
	// Semantic errors are irrelevant: this feature never runs verification.
	s.documents.change(URI, 3, "component C { def x: Missing = unknown; }");
	t.asserti(1, symbols(t, s).length);
	for (text in ["component Good {}\ncomponent Broken { def x = ; }", "component C #", "", "#"]) {
		s.documents.change(URI, s.documents.overlay(URI).version + 1, text);
		t.asserti(0, symbols(t, s).length);
	}
	s.documents.change(URI, 8, "component Fixed {}");
	t.asserti(1, symbols(t, s).length);
	s.documents.close(URI);
	t.asserti(0, symbols(t, s).length);
}

def test_symbol_utf16_ranges(t: Tester) {
	var s = LspServer.new(DocumentLimits.MAX_BYTES);
	var init = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-8\",\"utf-32\"]},\"textDocument\":{\"documentSymbol\":{\"hierarchicalDocumentSymbolSupport\":true}}}}}";
	var response = JsonRpcJsonParser.new(s.handle(init)).parseDocument();
	var caps = JsonValue.JObject.!(JsonValue.JObject.!(JsonValue.JObject.!(response).v["result"]).v["capabilities"]).v;
	t.assertz(false, caps.has("positionEncoding"));
	t.assertz(true, JsonValue.Bool.!(caps["documentSymbolProvider"]).v);
	s.documents.open(URI, "virgil", 1, "/*\t é😀 */ component C {\r\n\tdef f() {}\r\n}");
	var a = symbols(t, s);
	checkSymbol(t, a[0], "C", 3, 0, 11, 2, 1, 0, 21);
	checkSymbol(t, children(a[0])[0], "f", 6, 1, 1, 1, 11, 1, 5);
}

def test_symbol_header_fields(t: Tester) {
	var s = running(t);
	s.documents.open(URI, "virgil", 1, "class G(item: Pair<int, int>, f: (int, int) -> int) {\r\tdef body() {}\r}");
	var a = symbols(t, s);
	t.asserti(1, a.length);
	checkSymbol(t, a[0], "G", 5, 0, 0, 2, 1, 0, 6);
	var c = children(a[0]);
	t.asserti(3, c.length);
	checkSymbol(t, c[0], "item", 8, 0, 8, 0, 28, 0, 8);
	checkSymbol(t, c[1], "f", 8, 0, 30, 0, 50, 0, 30);
	checkSymbol(t, c[2], "body", 6, 1, 1, 1, 14, 1, 5);
	s.documents.change(URI, 2, "class C(var value: int, var next: int, fixed: int) {}");
	a = symbols(t, s);
	checkSymbol(t, a[0], "C", 5, 0, 0, 0, 53, 0, 6);
	c = children(a[0]);
	t.asserti(3, c.length);
	checkSymbol(t, c[0], "value", 8, 0, 8, 0, 22, 0, 12);
	checkSymbol(t, c[1], "next", 8, 0, 24, 0, 37, 0, 28);
	checkSymbol(t, c[2], "fixed", 8, 0, 39, 0, 49, 0, 39);
	s.documents.change(URI, 3, "enum E(value: int) { A(1) }");
	a = symbols(t, s);
	c = children(a[0]);
	t.asserti(2, c.length);
	checkSymbol(t, c[0], "value", 8, 0, 7, 0, 17, 0, 7);
	checkSymbol(t, c[1], "A", 22, 0, 21, 0, 25, 0, 21);
}

def test_symbol_bound_index_operators(t: Tester) {
	var s = running(t);
	var text = "component C {\n\tdef bound() {\n";
	for (i < 25) text = Arrays.concat(text, Strings.format1("\tvar bound = array.%s;\n", if(i % 2 == 0, "[]", "[]=")));
	text = Arrays.concat(text, "\t}\n\tvar getters = [array.[], array.[]=];\n}\nenum E { A(array.[], array.[]=) }");
	s.documents.open(URI, "virgil", 1, text);
	var a = symbols(t, s);
	t.asserti(2, a.length);
	checkSymbol(t, a[0], "C", 3, 0, 0, 29, 1, 0, 10);
	var c = children(a[0]);
	t.asserti(2, c.length);
	checkSymbol(t, c[0], "bound", 6, 1, 1, 27, 2, 1, 5);
	checkSymbol(t, c[1], "getters", 8, 28, 1, 28, 37, 28, 5);
	checkSymbol(t, a[1], "E", 10, 30, 0, 30, 33, 30, 5);
	c = children(a[1]);
	t.asserti(1, c.length);
	checkSymbol(t, c[0], "A", 22, 30, 9, 30, 31, 30, 9);
}

def test_symbol_expression_bodies(t: Tester) {
	for (header in ["def factory()", "def factory() -> () -> int", "def [i: int]"]) {
		var declaration = Strings.format1("%s => fun() { return; };", header);
		for (prefix in ["", "component C {\n", "class C {\n"]) {
			var s = running(t);
			var line = if(prefix.length == 0, 0, 1);
			var text = Strings.format3("%s%s%s", prefix, declaration, if(line == 0, "", "\n}"));
			s.documents.open(URI, "virgil", 1, text);
			var a = symbols(t, s);
			t.asserti(1, a.length);
			if (line != 0) a = children(a[0]);
			t.asserti(1, a.length);
			var obj = JsonValue.JObject.!(a[0]).v;
			t.asserti(6, JsonValue.Int.!(obj["kind"]).v);
			var r = JsonValue.JObject.!(obj["range"]).v;
			checkPosition(t, r["start"], line, 0);
			checkPosition(t, r["end"], line, declaration.length);
		}
	}
}

def test_symbol_large_single_line(t: Tester) {
	var count = 10000;
	var buf = StringBuilder.new().puts("component C { var ");
	var names = Array<string>.new(count), starts = Array<int>.new(count);
	for (i < count) {
		if (i > 0) buf.puts(", ");
		starts[i] = buf.length;
		names[i] = Strings.format1("f%d", i);
		buf.puts(names[i]).puts(": int");
	}
	buf.puts(";");
	var fieldEnd = buf.length;
	var text = buf.puts(" }").extract();
	var s = running(t);
	s.documents.open(URI, "virgil", 1, text);
	var started = System.ticksUs();
	var a = symbols(t, s);
	t.assert(System.ticksUs() - started < 5000000, "large outline must complete within five seconds");
	t.asserti(1, a.length);
	checkSymbol(t, a[0], "C", 3, 0, 0, 0, text.length, 0, 10);
	var c = children(a[0]);
	t.asserti(count, c.length);
	for (i < count) checkSymbol(t, c[i], names[i], 8, 0, 14, 0, fieldEnd, 0, starts[i]);
}

def test_symbol_params(t: Tester) {
	var s = LspServer.new(DocumentLimits.MAX_BYTES);
	t.assert_string("{\"jsonrpc\":\"2.0\",\"id\":9,\"error\":{\"code\":-32002,\"message\":\"the server is not initialized\"}}", s.handle(REQUEST));
	s = running(t);
	for (p in ["null", "[]", "{}", "{\"textDocument\":null}", "{\"textDocument\":{\"uri\":1}}", "{\"textDocument\":{\"uri\":\"\"}}", "{\"textDocument\":{\"uri\":\"file://remote/a\"}}"] ) {
		var req = Strings.format1("{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"textDocument/documentSymbol\",\"params\":%s}", p);
		var obj = JsonValue.JObject.!(JsonRpcJsonParser.new(s.handle(req)).parseDocument()).v;
		t.asserti(-32602, JsonValue.Int.!(JsonValue.JObject.!(obj["error"]).v["code"]).v);
	}
	s.handle("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}");
	t.assert_string("{\"jsonrpc\":\"2.0\",\"id\":9,\"error\":{\"code\":-32600,\"message\":\"the server is shutting down\"}}", s.handle(REQUEST));
}

def test_symbol_variant_cases(t: Tester) {
	var s = running(t);
	var text = "type Opt<T> {\n\tcase None;\n\tcase Some(v: T) {\n\t\tdef get() -> T { var s = \"};\"; return v; }\n\t}\n\tdef isSome() -> bool { return Opt<T>.Some.?(this); }\n}\ntype Row(m: int, index: int) {\n\tdef sum() -> int { return m + index; }\n}\ntype Empty;";
	s.documents.open(URI, "virgil", 1, text);
	var a = symbols(t, s);
	t.asserti(3, a.length); // the lifted case classes are not symbols
	checkSymbol(t, a[0], "Opt", 5, 0, 0, 6, 1, 0, 5);
	var c = children(a[0]);
	t.asserti(3, c.length); // no synthesized tag/name members
	checkSymbol(t, c[0], "None", 22, 1, 1, 1, 11, 1, 6);
	checkSymbol(t, c[1], "Some", 22, 2, 1, 4, 2, 2, 6);
	checkSymbol(t, c[2], "isSome", 6, 5, 1, 5, 53, 5, 5);
	t.assertz(false, JsonValue.JObject.!(c[0]).v.has("children"));
	var members = children(c[1]);
	t.asserti(2, members.length);
	checkSymbol(t, members[0], "v", 8, 2, 11, 2, 15, 2, 11);
	checkSymbol(t, members[1], "get", 6, 3, 2, 3, 44, 3, 6);
	// A data type is its own single case: one symbol, with its fields.
	checkSymbol(t, a[1], "Row", 5, 7, 0, 9, 1, 7, 5);
	c = children(a[1]);
	t.asserti(3, c.length);
	checkSymbol(t, c[0], "m", 8, 7, 9, 7, 15, 7, 9);
	checkSymbol(t, c[1], "index", 8, 7, 17, 7, 27, 7, 17);
	checkSymbol(t, c[2], "sum", 6, 8, 1, 8, 39, 8, 5);
	checkSymbol(t, a[2], "Empty", 5, 10, 0, 10, 11, 10, 5);
	t.assertz(false, JsonValue.JObject.!(a[2]).v.has("children"));
}

// The byte offset of {needle} in {text}, or -1.
def find(text: string, needle: string) -> int {
	for (i = 0; i + needle.length <= text.length; i++) {
		if (Strings.equal(Arrays.range(text, i, i + needle.length), needle)) return i;
	}
	return -1;
}
// Checks that {s} is a {kind} named {name} whose range is exactly the text
// {decl}, with its name {skip} bytes in.
def checkBytes(t: Tester, s: AnalysisDocumentSymbol, text: string, name: string, kind: AnalysisDeclKind,
		decl: string, skip: int, children: int) {
	var begin = find(text, decl);
	t.assert(begin >= 0, "declaration text found");
	t.assert_string(name, s.name);
	t.assert(kind == s.kind, Strings.format2("%s is a %s", name, kind.name));
	t.asserti(begin, s.begin);
	t.asserti(begin + decl.length, s.end);
	t.asserti(begin + skip, s.nameBegin);
	t.asserti(begin + skip + name.length, s.nameEnd);
	t.asserti(children, s.children.length);
}
// The default case "_" and a variant that extends another need -lang:open-types.
def test_symbol_default_case(t: Tester) {
	var text = "type V {\n\tcase A;\n\tcase _ {\n\t\tdef m() {}\n\t}\n}\ntype W extends V {\n\tcase B(x: int);\n}";
	t.asserti(0, AeneasAdapter.documentSymbols("open.v3", text, []).length);
	var a = AeneasAdapter.documentSymbols("open.v3", text, ["-lang:open-types"]);
	t.asserti(2, a.length);
	checkBytes(t, a[0], text, "V", AnalysisDeclKind.CLASS, "type V {\n\tcase A;\n\tcase _ {\n\t\tdef m() {}\n\t}\n}", 5, 2);
	checkBytes(t, a[0].children[0], text, "A", AnalysisDeclKind.VARIANT_CASE, "case A;", 5, 0);
	checkBytes(t, a[0].children[1], text, "_", AnalysisDeclKind.VARIANT_CASE, "case _ {\n\t\tdef m() {}\n\t}", 5, 1);
	checkBytes(t, a[0].children[1].children[0], text, "m", AnalysisDeclKind.METHOD, "def m() {}", 4, 0);
	checkBytes(t, a[1], text, "W", AnalysisDeclKind.CLASS, "type W extends V {\n\tcase B(x: int);\n}", 5, 1);
	checkBytes(t, a[1].children[0], text, "B", AnalysisDeclKind.VARIANT_CASE, "case B(x: int);", 5, 1);
	checkBytes(t, a[1].children[0].children[0], text, "x", AnalysisDeclKind.FIELD, "x: int", 0, 0);
}

// Every kind of outline symbol, after non-ASCII text, and a tab and non-ASCII
// text in a block comment on the line of a declaration (U+00E9, two UTF-8
// bytes and one UTF-16 unit; U+1D11E, four bytes and two units).
def DETAILS = "// \xC3\xA9\xF0\x9D\x84\x9E\ntype Opt<T> {\n\tcase None;\n\tcase Some(v: T) { def get() -> T { return v; } }\n}\ntype Row(m: int, index: int) { }\nclass Box {\n\tvar size: int;\n\tnew(size) { }\n\tdef [i: int] -> int { return size; }\n}\nenum E(code: int) { A(1) }\nlayout L {\n\t+0 word: int;\n\t=4;\n}\npacking P(x: 1): 2 = 0b0x;\ncomponent C {\n/*\t\xC3\xA9\xF0\x9D\x84\x9E*/\tdef f(a: int) -> int { return a; }\n}\ndef top() {}\n";
// Each symbol's name and detail, one per line, indented by depth.
def DETAILS_OUTLINE = "Opt = type Opt<T>\n  None = case None\n  Some = case Some(v: T)\n    v = def v: T\n    get = def get() -> T\nRow = type Row(m: int, index: int)\n  m = def m: int\n  index = def index: int\nBox = class Box\n  size = var size: int\n  new = new(size: int)\n  [] = def [i: int] -> int\nE = enum E(code: int)\n  code = def code: int\n  A = E.A\nL = layout L\n  word = +0 word: int\nP = packing P(x: 1): 2\nC = component C\n  f = def f(a: int) -> int\ntop = def top()\n";

// The real worker analyzes the document-symbols fixture project, the build's
// own copy, whose Symbols.v3 each session writes before the project loads.
class SymbolTestSession {
	def supervisor = AnalysisSupervisor.new(WorkerProcesses.defaultPath(), AnalysisWorkerLimits.new());
	def server = LspServer.new(DocumentLimits.MAX_BYTES).withAnalysis(supervisor);
	var base: string;
	var nextId = 100;
	new(t: Tester) {
		base = ProjectFiles.join(ProjectFiles.parent(HostOs.executablePath()), "project-fixtures/document-symbols");
		var fd = System.fileOpen(ProjectFiles.join(base, "Symbols.v3"), false);
		t.assert(fd >= 0, "fixture source written");
		if (fd >= 0) {
			System.fileWriteK(fd, DETAILS, 0, DETAILS.length);
			System.fileClose(fd);
		}
		HostOs.ignoreSigpipe();
		var params = Strings.newMap<JsonValue>();
		params["rootUri"] = JsonValue.String(ProjectFiles.uri(base));
		var documentSymbol = Strings.newMap<JsonValue>();
		documentSymbol["hierarchicalDocumentSymbolSupport"] = JsonValue.Bool(true);
		var textDocument = Strings.newMap<JsonValue>();
		textDocument["documentSymbol"] = JsonValue.JObject(documentSymbol);
		var capabilities = Strings.newMap<JsonValue>();
		capabilities["textDocument"] = JsonValue.JObject(textDocument);
		params["capabilities"] = JsonValue.JObject(capabilities);
		server.handle(JsonRpcMessage.Request(JsonRpcId.Int(0), "initialize", JsonRpcParams.ByName(params)).encode());
	}
	def uri() -> string { return ProjectFiles.uri(ProjectFiles.join(base, "Symbols.v3")); }
	def snapshot() -> AnalysisSnapshot { return server.projects.forDocument(uri()).active.snapshot; }
	def open(uri: string, version: int, text: string) {
		var doc = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri);
		doc["languageId"] = JsonValue.String("virgil");
		doc["version"] = JsonValue.Int(version);
		doc["text"] = JsonValue.String(text);
		notify("textDocument/didOpen", doc, null);
	}
	def change(version: int, text: string) {
		var doc = Strings.newMap<JsonValue>(), change = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri());
		doc["version"] = JsonValue.Int(version);
		change["text"] = JsonValue.String(text);
		notify("textDocument/didChange", doc, [JsonValue.JObject(change)]);
	}
	def close() {
		var doc = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri());
		notify("textDocument/didClose", doc, null);
	}
	private def notify(method: string, doc: HashMap<string, JsonValue>, changes: Array<JsonValue>) {
		var params = Strings.newMap<JsonValue>();
		params["textDocument"] = JsonValue.JObject(doc);
		if (changes != null) params["contentChanges"] = JsonValue.JArray(changes);
		server.handle(JsonRpcMessage.Notification(method, JsonRpcParams.ByName(params)).encode());
	}
	// Polls until no analysis runs or waits, including the debounce interval.
	def settle() {
		var fds = Array<int>.new(4);
		while (server.analyzing()) {
			var count = supervisor.pollFds(fds, 0);
			HostOs.poll(fds, count, server.pollTimeout());
			server.onPoll();
		}
	}
	// The outline of {uri}, which the request's own reply carries: it never
	// waits for an analysis.
	def outline(t: Tester, uri: string) -> Array<JsonValue> {
		var doc = Strings.newMap<JsonValue>(), params = Strings.newMap<JsonValue>();
		doc["uri"] = JsonValue.String(uri);
		params["textDocument"] = JsonValue.JObject(doc);
		var reply = server.handle(JsonRpcMessage.Request(JsonRpcId.Int(nextId++), "textDocument/documentSymbol", JsonRpcParams.ByName(params)).encode());
		t.assert(reply != null, "the outline is answered at once");
		if (reply == null) return [];
		var obj = JsonValue.JObject.!(JsonRpcJsonParser.new(reply).parseDocument()).v;
		t.assert(obj.has("result"), "symbol request must succeed");
		return if(obj.has("result"), JsonValue.JArray.!(obj["result"]).v, []);
	}
}
// Each symbol's name and detail, as in DETAILS_OUTLINE, or with {ranges},
// its kind and ranges instead.
def describe(buf: StringBuilder, symbols: Array<JsonValue>, depth: int, ranges: bool) -> StringBuilder {
	for (v in symbols) {
		var obj = JsonValue.JObject.!(v).v;
		for (i < depth) buf.puts("  ");
		buf.puts(JsonValue.String.!(obj["name"]).v);
		if (ranges) {
			buf.put1(" %d", JsonValue.Int.!(obj["kind"]).v);
			for (key in ["range", "selectionRange"]) {
				var r = JsonValue.JObject.!(obj[key]).v;
				for (end in ["start", "end"]) {
					var p = JsonValue.JObject.!(r[end]).v;
					buf.put2(" %d:%d", JsonValue.Int.!(p["line"]).v, JsonValue.Int.!(p["character"]).v);
				}
			}
		} else if (obj.has("detail")) {
			buf.puts(" = ").puts(JsonValue.String.!(obj["detail"]).v);
		}
		buf.ln();
		if (obj.has("children")) describe(buf, JsonValue.JArray.!(obj["children"]).v, depth + 1, ranges);
	}
	return buf;
}
def details(a: Array<JsonValue>) -> string {
	return describe(StringBuilder.new(), a, 0, false).toString();
}
def ranges(a: Array<JsonValue>) -> string {
	return describe(StringBuilder.new(), a, 0, true).toString();
}
// The outline of DETAILS without any detail.
def checkNoDetails(t: Tester, a: Array<JsonValue>) {
	t.assert_string("Opt\n  None\n  Some\n    v\n    get\nRow\n  m\n  index\nBox\n  size\n  new\n  []\nE\n  code\n  A\nL\n  word\nP\nC\n  f\ntop\n", details(a));
}

def test_symbol_details(t: Tester) {
	var s = SymbolTestSession.new(t);
	s.open(s.uri(), 1, DETAILS);
	// The outline does not wait for the first analysis.
	t.assert(s.server.analyzing() && s.snapshot() == null, "the first analysis is pending");
	var before = s.outline(t, s.uri());
	checkNoDetails(t, before);
	s.settle();
	var after = s.outline(t, s.uri());
	t.assert_string(DETAILS_OUTLINE, details(after));
	// Details change nothing else, and syntax ranges select the names after
	// non-ASCII text and a tab in a block comment.
	t.assert_string(ranges(before), ranges(after));
	var c = JsonValue.JArray.!(JsonValue.JObject.!(after[6]).v["children"]).v;
	checkSymbol(t, c[0], "f", 6, 18, 9, 18, 43, 18, 13);
	s.server.close();
}

def test_symbol_details_stale(t: Tester) {
	var s = SymbolTestSession.new(t);
	s.open(s.uri(), 1, DETAILS);
	s.settle();
	var current = s.outline(t, s.uri());
	t.assert_string(DETAILS_OUTLINE, details(current));
	// An edit makes the retained snapshot stale at once, even with the same text.
	s.change(2, DETAILS);
	t.assert(s.snapshot() != null, "the snapshot of version 1 is retained");
	var stale = s.outline(t, s.uri());
	checkNoDetails(t, stale);
	t.assert_string(ranges(current), ranges(stale));
	s.settle();
	t.assert_string(DETAILS_OUTLINE, details(s.outline(t, s.uri())));
	// Reopening with the same version is another record.
	s.close();
	t.asserti(0, s.outline(t, s.uri()).length);
	s.open(s.uri(), 2, DETAILS);
	checkNoDetails(t, s.outline(t, s.uri()));
	s.settle();
	t.assert_string(DETAILS_OUTLINE, details(s.outline(t, s.uri())));
	s.server.close();
}

def test_symbol_details_outside_project(t: Tester) {
	var s = SymbolTestSession.new(t);
	s.open(s.uri(), 1, DETAILS);
	s.settle();
	t.assert_string(DETAILS_OUTLINE, details(s.outline(t, s.uri())));
	// The same text in a document of no project has the same outline, without details.
	var outside = "untitled:outside.v3";
	s.open(outside, 1, DETAILS);
	s.settle();
	var a = s.outline(t, outside);
	checkNoDetails(t, a);
	t.assert_string(ranges(s.outline(t, s.uri())), ranges(a));
	s.server.close();
}
