// The unit-test executable can serve deterministic RESULT fixtures on the real
// worker pipes. This exercises admission, replacement, and snapshot preservation
// without needing a compiler program large enough to exhaust a decoding budget.
// A request for .v3 sources is analyzed as the real worker analyzes it
// (AnalysisWorker.handle), so that a server can run on this worker, unless a
// source spells {CRASH} or {TOO_LARGE}: the worker then ends without a reply,
// or sends a result over the decoding budget. A rename to such a name fails
// in its preflight alone. A request with a scope query whose sources spell
// {SCOPE_CRASH} ends the worker too, and one whose sources spell
// {SCOPE_MALFORMED} gets a scope answer that names a declaration twice, so
// that a completion fails while the project's own analyses succeed.
component SyntheticAnalysisWorker {
	def CRASH = "workerEndsHere";
	def TOO_LARGE = "resultTooLarge";
	def SCOPE_CRASH = "scopeEndsHere";
	def SCOPE_MALFORMED = "scopeMalformed";

	def run() -> int {
		if (!send(AnalysisWire.encodeHello(BuildInfo.VERSION, BuildInfo.REVISION, 384L * 1024 * 1024))) return 1;
		var reader = WorkerFrameReader.new(WorkerFraming.MAX_PAYLOAD);
		while (true) {
			var space = reader.space();
			if (space.length == 0) return 1;
			var n = HostOs.read(AnalysisWire.REQUEST_FD, space);
			if (n == HostOs.EINTR) continue;
			if (n <= 0) return 0;
			var payload = reader.advance(n);
			if (reader.error != null) return 1;
			if (payload == null) continue;
			var request = AnalysisWire.decodeAnalyze(payload);
			if (request == null || request.sources.length == 0) return 1;
			var mode = request.sources[0].path;
			if (Strings.endsWith(mode, ".v3")) {
				if (spells(request.sources, CRASH)) return 1;
				if (request.scope() != null && spells(request.sources, SCOPE_CRASH)) return 1;
				if (!spells(request.sources, TOO_LARGE)) {
					if (!send(analyze(request))) return 1;
					continue;
				}
				mode = "too-large";
			} else if (request.sources.length != 1) {
				return 1;
			}
			var large = Strings.equal(mode, "too-large") || Strings.equal(mode, "wrong-id");
			var id = request.id + if(Strings.equal(mode, "wrong-id"), 1);
			var w = WorkerFraming.start().putb(AnalysisWire.RESULT).put_b32(id).put_b32(1).put_b32(1).put_b64(0);
			w.putb(3); // parsed and verified, no occurrence index
			for (i < 6) w.put_sleb32(0);
			// Skipped uses, which the supervisor reports.
			w.put_sleb32(if(Strings.equal(mode, "skipped"), 2, 0));
			w.put_sleb32(if(large, 1, 0));
			if (large) {
				// A complete diagnostic, encoded well within the frame limit but
				// charged at 32 bytes per message byte for JSON response headroom.
				w.put_sleb32(-1);
				for (i < 4) w.put_sleb32(1);
				w.put_sleb32(-1).put_sleb32(-1);
				w.put_sleb32(-1);
				var text = Array<byte>.new(AnalysisWire.MAX_RESULT_ALLOCATION / 32);
				for (i < text.length) text[i] = 'x';
				w.put_sleb32(text.length).puta(text);
			}
			if (Strings.equal(mode, "malformed")) w.putb(0); // trailing byte
			if (!send(WorkerFraming.finish(w))) return 1;
		}
		return 0;
	}
	// The result of the real worker for {request}, without its statistics.
	private def analyze(request: AnalysisWorkerRequest) -> Range<byte> {
		var analysis = if(request.scope() != null, AeneasAdapter.analyzeForScope(request.sources, request.options, false),
			AeneasAdapter.analyzeProgram(request.sources, request.options, false));
		var files: Array<(string, Array<AnalysisOccurrence>)>;
		if ((request.flags & AnalysisWire.WANT_OCCURRENCES) != 0) {
			files = request.occurrences(analysis);
		} else if (request.scope() != null) {
			files = [];
		}
		var scope = if(files != null, request.scopeAnswer(analysis));
		if (scope != null && scope.declarations.length > 0 && spells(request.sources, SCOPE_MALFORMED)) {
			// The first candidate twice, which the server rejects.
			var d = scope.declarations[0], level = scope.levels[0];
			var twice = AnalysisScopeAnswer.new([d, d], [level, level], scope.thisLevel, false);
			twice.paths = scope.paths;
			scope = twice;
		}
		var members = if(files != null, request.memberAnswer(analysis));
		if (members != null && members.names.length > 0 && spells(request.sources, SCOPE_MALFORMED)) {
			// The first candidate twice, which the server rejects.
			var twice = AnalysisMemberAnswer.new([members.declarations[0], members.declarations[0]],
				[members.names[0], members.names[0]], [members.kinds[0], members.kinds[0]],
				[members.details[0], members.details[0]], [members.levels[0], members.levels[0]], false);
			twice.paths = members.paths;
			members = twice;
		}
		return AnalysisWire.finishResult(AnalysisWire.encodeResultWithQuery(request.id, 1, AeneasAdapter.uidCounter(),
			analysis, -1, -1, files, scope, members), 0);
	}
	// Whether any of {sources} contains the bytes of {word}.
	private def spells(sources: Array<AnalysisSource>, word: string) -> bool {
		for (s in sources) {
			var input = s.input;
			for (i = 0; i + word.length <= input.length; i++) {
				var k = 0;
				while (k < word.length && input[i + k] == word[k]) k++;
				if (k == word.length) return true;
			}
		}
		return false;
	}
	private def send(frame: Range<byte>) -> bool {
		while (frame.length > 0) {
			var n = HostOs.write(AnalysisWire.RESULT_FD, frame);
			if (n == HostOs.EINTR) continue;
			if (n <= 0) return false;
			frame = frame[n ...];
		}
		return true;
	}
}
