def X = [
	UnitTests.register("AnalysisHints:resolved", resolved),
	UnitTests.register("AnalysisHints:errors", errors),
	UnitTests.register("AnalysisHints:bounds", bounds),
	UnitTests.register("AnalysisHints:wire_validation", wire_validation),
	()
];
def PATH = "test/fixtures/analysis/inlay-hints/main.v3";
def make(t: Tester, text: string, verified: bool) -> AnalysisSnapshot {
	var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(PATH, text)], [], false);
	if (verified) {
		for (d in a.diagnostics) t.fail1("unexpected diagnostic: %s", d.toString());
		t.assert(a.verified, "fixture verifies");
	}
	var sized = AnalysisWire.encodeResultWithQueryCounted(1, 1, 1, a, 0, 0, [(PATH, a.occurrences(PATH))], null, null, null);
	t.assertl(sized.1, long.view(sized.0.end()));
	var data = Ranges.dup(AnalysisWire.finishResult(sized.0, 0L)[4 ...]);
	match (AnalysisWire.decodeResult(data, 1, [PATH])) {
		Decoded(r) => return r.snapshot;
		_ => t.fail("hints failed to decode");
	}
	return null;
}
def find(text: string, needle: string) -> int {
	for (i = 0; i + needle.length <= text.length; i++) if (Strings.equal(Arrays.range(text, i, i + needle.length), needle)) return i;
	return -1;
}
def hint(t: Tester, s: AnalysisSnapshot, text: string, needle: string, label: string, local: bool) {
	var begin = find(text, needle), c = s.fileIndex(PATH).hintCursor();
	if (begin < 0) return t.fail1("missing fixture text: %s", needle);
	while (c.next()) {
		if (c.begin != begin) continue;
		t.assert((c.local > 0) == local, "hint kind");
		if (label == null) return t.fail1("unexpected hint at %s", needle);
		t.assert_string(label, s.hintString(c.label));
		return;
	}
	if (label != null) t.fail1("missing hint at %s", needle);
}
def resolved(t: Tester) {
	var text = System.fileLoad(PATH), s = make(t, text, true);
	if (s == null) return;
	hint(t, s, text, "unused =", "Box<Box<Foo>>", true);
	hint(t, s, text, "explicit:", null, true);
	hint(t, s, text, "literal = 1", "int", true);
	hint(t, s, text, "literal = false", "bool", true);
	hint(t, s, text, "copied =", "T", true);
	hint(t, s, text, "long =", "Box<Box<Box<Box<Box<Box<Box<Box<Foo>>>>\xE2\x80\xA6", true);
	hint(t, s, text, "made =", "Constructed", true);
	hint(t, s, text, "circle =", "Shape.Circle", true);
	hint(t, s, text, "dot =", "Shape.Dot", true);
	hint(t, s, text, "red =", "Color", true);
	for (pair in [("4);", "count"), ("5);", "radius"), ("1, 2);", "count"), ("2);", "value"), ("Hints.field);\n    same", "value"), ("6);", "value")])
		hint(t, s, text, pair.0, pair.1, false);
	for (needle in ["count, Hints.field", "73);", "74);", "tuple);", "_, 75", "75);", "76);", "Hints.field);\n    fn"])
		hint(t, s, text, needle, null, false);
	var target = s.typeDefinitionAtOffset(PATH, find(text, "unused =")).1;
	t.assert(target != null && Strings.equal(target.name, "Box"), "type label reuses source target");
}
def errors(t: Tester) {
	var text = "component Bad { def run() { var missing = absent; var wrong: Unknown = null; var error = absent(); } }";
	var s = make(t, text, false);
	if (s == null) return;
	for (name in ["missing =", "wrong:", "error ="]) hint(t, s, text, name, null, true);
}
def bounds(t: Tester) {
	for (text in ["int", "1234567890123456789012345678901234567890", "\xC3\xA9"]) t.assert_string(text, AnalysisHintText.bound(text));
	t.assert_string("123456789012345678901234567890123456789\xE2\x80\xA6", AnalysisHintText.bound("12345678901234567890123456789012345678901"));
}
// Real reader budget and malformed records, independent of the encoder.
def wire_validation(t: Tester) {
	for (record in ["\x01\x01\x00\x00", "\x01\x01\x7F\x00", "\x01\x01\x00\x01", "\x7F\x01\x00\x00", "\x01\x00\x00\x00", "\x01\x01\x01\x00"]) {
		var data = DataWriter.new().putb(AnalysisWire.RESULT).put_sleb32(1).puta(record).extract();
		var reader = AnalysisWireReader.new(data, AnalysisWire.RESULT);
		var f = AnalysisSnapshotFile.new([], [], [], [], 0, 0);
		reader.readHints(f, [], ["value"]);
		if (Strings.equal(record, "\x01\x01\x00\x00")) {
			t.assert(reader.finish(), "valid parameter record");
			t.assertl(68L, reader.allocationBytes());
		} else t.assert(!reader.finish(), "invalid record rejected");
	}
}
