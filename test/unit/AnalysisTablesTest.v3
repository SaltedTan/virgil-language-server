// The analysis tables' hash (AnalysisTables.hashBytes, issue #155). Names
// and paths built from "Aa" and "BB" blocks of one length all had one
// polynomial hash, so each table put them in one probe sequence, and so did
// distinct types that share the compiler's type hash. Each
// scaling test checks its result and that the slots probed past a key's
// first (AnalysisTables.probes) grow about linearly from n keys to 2n, as
// they would not if the keys collided. The key stays the fixed one that
// tests start with, apart from the test that changes it.
def T = UnitTests.register;
def X = [
	T("AnalysisTables:siphash_vectors", test_siphash_vectors),
	T("AnalysisTables:colliding_strings", test_colliding_strings),
	T("AnalysisTables:colliding_signatures", test_colliding_signatures),
	T("AnalysisTables:colliding_declaration_keys", test_colliding_declaration_keys),
	T("AnalysisTables:colliding_files", test_colliding_files),
	T("AnalysisTables:encoder_declarations", test_encoder_declarations),
	T("AnalysisTables:cold_scope_query", test_cold_scope_query),
	T("AnalysisTables:colliding_types", test_colliding_types),
	T("AnalysisTables:spread_types", test_spread_types),
	T("AnalysisTables:pointer_twins", test_pointer_twins),
	T("AnalysisTables:tied_keys", test_tied_keys),
	T("AnalysisTables:seeds", test_seeds),
	T("AnalysisTables:without_times", test_without_times),
	T("AnalysisTables:random_words", test_random_words),
	()
];
// The key that tests run with, bytes 0 to 15, as in SipHash's test vectors.
def KEY0 = 0x0706050403020100ul;
def KEY1 = 0x0F0E0D0C0B0A0908ul;

// {count} blocks of "Aa" or "BB", as bit k of {index} selects for block k.
def blocks(count: int, index: int) -> string {
	var b = StringBuilder.new();
	for (k < count) b.puts(if((index >> byte.view(k)) % 2 == 1, "BB", "Aa"));
	return b.extract();
}
// {n} paths whose names all had one polynomial hash.
def collidingPaths(n: int) -> Array<string> {
	var paths = Array<string>.new(n);
	for (i < n) paths[i] = Strings.format1("/tables/%s.v3", blocks(11, i));
	return paths;
}
// Fails unless {f} probes at most about twice as many slots at 2n keys as at
// n: a table is at most half full, so each operation probes a few slots on
// average whatever the keys. Keys that collide would probe four times as many.
def scales(t: Tester, label: string, n: int, f: int -> void) {
	var small = probes(f, n), large = probes(f, 2 * n);
	if (small <= 0 || large > 3 * small) {
		t.fail(StringBuilder.new().put3("%s probed %d slots at %d keys, ", label, large, 2 * n)
			.put2("against %d at %d", small, n).extract());
	}
}
def probes(f: int -> void, n: int) -> long {
	var before = AnalysisTables.probes;
	f(n);
	return AnalysisTables.probes - before;
}
// The bytes 0 to {length} - 1.
def counting(length: int) -> Array<byte> {
	var a = Array<byte>.new(length);
	for (i < length) a[i] = byte.view(i);
	return a;
}

// SipHash-1-3 of the bytes 0 to n - 1 with the key 0 to 15, from a reference
// implementation that reproduces SipHash-2-4's published vectors. The first
// eight bytes are the prefix word.
def test_siphash_vectors(t: Tester) {
	var bytes = counting(64), rest = Arrays.range(bytes, 8, 64);
	var expected = [(8, 0x369095118d299a8eul), (15, 0xd320d86d2a519956ul), (16, 0xcc4fdd1a7d908b66ul), (64, 0xf17997ec4b4a6065ul)];
	for (e in expected) {
		var h = AnalysisTables.hashBytes(rest, e.0 - 8, KEY0);
		if (h != e.1) t.fail1("hash of %d bytes", e.0);
	}
	var name: Array<byte> = "name: int";
	if (AnalysisTables.hashBytes(name, name.length, KEY0) != 0xa852bcdb2dcc3b3bul) t.fail("hash of a name");
	// A string's slot hash has no prefix.
	t.asserti(int.view(0xece30299u), AnalysisTables.hashString(name, name.length));
}

def test_colliding_strings(t: Tester) {
	scales(t, "the string table", 1024, internStrings(t, _));
}
// Interns {n} colliding names from a builder, then adds and finds each.
def internStrings(t: Tester, n: int) {
	var table = AnalysisStringTable.new(), names = Array<string>.new(n), buf = StringBuilder.new();
	for (i < n) {
		names[i] = blocks(11, i);
		buf.puts(names[i]).puts(": int");
		var s = table.intern(buf);
		t.asserti(i, table.find(s));
	}
	for (i < n) {
		buf.puts(names[i]).puts(": int");
		t.asserti(i, table.add(table.intern(buf)));
		t.asserti(-1, table.find(names[i]));
	}
	t.asserti(n, table.length());
}

def test_colliding_signatures(t: Tester) {
	scales(t, "the signature table", 1024, signatures(t, _));
}
// Adds {n} signatures whose labels collided, and {n} whose parameters did,
// then finds each.
def signatures(t: Tester, n: int) {
	var map = AnalysisIndexMap<AnalysisSignature>.new(AnalysisSignatures.hash, AnalysisSignatures.equal);
	for (i < n) {
		t.asserti(2 * i, map.add(labelled(i)));
		t.asserti(2 * i + 1, map.add(parameterized(i)));
	}
	for (i < n) {
		t.asserti(2 * i, map.find(labelled(i)));
		t.asserti(2 * i + 1, map.find(parameterized(i)));
	}
	t.asserti(2 * n, map.length());
}
def labelled(i: int) -> AnalysisSignature {
	return AnalysisSignature.new(Strings.format1("def %s()", blocks(11, i)), 0, []);
}
def parameterized(i: int) -> AnalysisSignature {
	return AnalysisSignature.new("def m(x: int)", 6, [Strings.format1("%s: int", blocks(11, i))]);
}

def test_colliding_declaration_keys(t: Tester) {
	scales(t, "the declaration keys", 1024, declarationKeys(t, _));
}
// Adds a class in each of {n} colliding files, all at one position, and a
// field and a parameter at its token, then finds each.
def declarationKeys(t: Tester, n: int) {
	var map = AnalysisIndexMap<(Token, AnalysisDeclKind)>.new(AnalysisDeclarationKeys.hash, AnalysisDeclarationKeys.equal);
	var paths = collidingPaths(n), tokens = Array<Token>.new(n);
	for (i < n) {
		tokens[i] = Token.new(paths[i], "C", 1, 7);
		t.asserti(i, map.add((tokens[i], AnalysisDeclKind.CLASS)));
	}
	for (i < n) {
		t.asserti(n + 2 * i, map.add((tokens[i], AnalysisDeclKind.FIELD)));
		t.asserti(n + 2 * i + 1, map.add((tokens[i], AnalysisDeclKind.PARAMETER)));
	}
	for (i < n) {
		t.asserti(i, map.find((tokens[i], AnalysisDeclKind.CLASS)));
		t.asserti(n + 2 * i, map.find((tokens[i], AnalysisDeclKind.FIELD)));
	}
	t.asserti(3 * n, map.length());
}

// #155's item 2: a program of {n} colliding files that each declare a
// component with a method at one position, and a main file that calls each,
// so that the display's declaration keys and call keys see them all.
def collidingProgram(n: int) -> Array<AnalysisSource> {
	var paths = collidingPaths(n), sources = Array<AnalysisSource>.new(n + 1), main = StringBuilder.new();
	main.puts("component Main {\n\tdef main() {\n");
	for (i < n) {
		sources[i + 1] = AnalysisSource.new(paths[i], Strings.format1("component C%d { def m() { } }\n", i));
		main.put1("\t\tC%d.m();\n", i);
	}
	main.puts("\t}\n}\n");
	sources[0] = AnalysisSource.new("/tables/main.v3", main.extract());
	return sources;
}
def test_colliding_files(t: Tester) {
	scales(t, "a program of colliding files", 512, analyzeFiles(t, _));
}
def analyzeFiles(t: Tester, n: int) {
	var sources = collidingProgram(n);
	var a = AeneasAdapter.analyzeProgram(sources, [], false);
	t.assertz(true, a.verified);
	var calls = 0;
	for (o in a.occurrences(sources[0].path)) {
		var d = o.declaration;
		if (d.kind == AnalysisDeclKind.METHOD && Strings.equal("m", d.name)) calls++;
	}
	t.asserti(n, calls);
	for (i < n) {
		var sites = a.declarationSites(sources[i + 1].path);
		t.assert(sites.length >= 2, "a component and its method");
		t.assert_string(Strings.format1("C%d", i), sites[0].name);
	}
}

// The encoder's declaration index, which holds every declaration of the
// colliding files; only encoding is counted.
def test_encoder_declarations(t: Tester) {
	var small = encodingProbes(t, 512), large = encodingProbes(t, 1024);
	if (small <= 0 || large > 3 * small) t.fail2("the encoder probed %d slots, against %d for half the files", large, small);
}
def encodingProbes(t: Tester, n: int) -> long {
	var sources = collidingProgram(n), a = AeneasAdapter.analyzeProgram(sources, [], false);
	t.assertz(true, a.verified);
	for (s in sources) a.occurrences(s.path);
	var before = AnalysisTables.probes;
	encodeAll(t, a, sources);
	return AnalysisTables.probes - before;
}
// Encodes {a}'s result with every file's occurrences and decodes it.
def encodeAll(t: Tester, a: ProgramAnalysis, sources: Array<AnalysisSource>) {
	var files = Array<(string, Array<AnalysisOccurrence>)>.new(sources.length), paths = Array<string>.new(sources.length);
	for (i < sources.length) {
		paths[i] = sources[i].path;
		files[i] = (paths[i], a.occurrences(paths[i]));
	}
	var w = AnalysisWire.encodeResult(1, 1, 1, a, 0, -1, files);
	var payload = Ranges.dup(AnalysisWire.finishResult(w, 0L)[WorkerFraming.HEADER_BYTES ...]);
	match (AnalysisWire.decodeResult(payload, 1, paths)) {
		Decoded(result) => {
			var s = result.snapshot;
			for (i < 4) {
				var sites = s.declarationSites(paths[i + 1]);
				t.assert(sites.length >= 2, "a component and its method");
				t.assert_string(Strings.format1("C%d", i), sites[0].name);
			}
		}
		_ => t.fail("result did not decode");
	}
}

// #155's item 1: the first scope query in a method of {n} parameters with
// colliding names, whose signatures all had one hash. A scope answer holds at
// most 1,000 candidates, so n stays below that.
def test_cold_scope_query(t: Tester) {
	scales(t, "a cold scope query", 480, scopeQuery(t, _));
}
def scopeQuery(t: Tester, n: int) {
	var text = StringBuilder.new();
	text.puts("component C { def m(");
	for (i < n) {
		if (i > 0) text.puts(", ");
		text.puts(blocks(11, i)).puts(": int");
	}
	text.puts(") { var x = ");
	var offset = text.length;
	text.puts("0; } }\n");
	var a = AeneasAdapter.analyzeForScope([AnalysisSource.new("/tables/scope.v3", text.extract())], [], false);
	t.assertz(true, a.verified);
	var s = a.scopeAt("/tables/scope.v3", offset, AnalysisScopeKinds.VALUES, "");
	var params = 0;
	for (d in s.declarations) {
		if (d.kind == AnalysisDeclKind.PARAMETER) {
			params++;
			t.assert(Strings.endsWith(d.signature, ": int"), "a parameter's signature");
		}
	}
	t.asserti(n, params);
}

// Types that share a compiler hash (Type.hash), from #155's review. Call i
// instantiates a class K of 26 type parameters with thirteen pairs, each
// T0, T33 or T1, T0 as bit k of i selects. The classes' consecutive uids,
// u for T0, u + 1 for T1, and u + 33 for T33, give 33u + (u + 33) =
// 33(u + 1) + u, so every pair adds the same to the compiler's polynomial,
// and all the instances of K,
// and the types of their calls of id, hash alike. The display's type table
// and call keys had them all in one probe sequence.
def test_colliding_types(t: Tester) {
	scales(t, "the display's types and calls", 2048, analyzeTypes(t, _));
}
def analyzeTypes(t: Tester, n: int) {
	var text = StringBuilder.new();
	for (i < 34) text.put1("class T%d { }\n", i);
	text.puts("class K<");
	for (i < 26) text.put1(if(i > 0, ", A%d", "A%d"), i);
	text.puts("> { }\ncomponent Main {\n\tdef id<T>(x: T) -> T { return x; }\n\tdef m() {\n");
	for (i < n) text.puts("\t\tid<").puts(instance(i)).puts(">(null);\n");
	text.puts("\t}\n}\n");
	var path = "/tables/types.v3";
	var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path, text.extract())], [], false);
	t.assertz(true, a.verified);
	var uses = 0;
	for (o in a.occurrences(path)) {
		var d = o.declaration;
		if (d.kind != AnalysisDeclKind.CLASS || !Strings.equal("K", d.name)) continue;
		if (uses < n) t.assert_string(instance(uses), o.useType);
		uses++;
	}
	t.asserti(n, uses);
	var calls = a.calls(path);
	t.asserti(n, calls.length);
	for (i < calls.length) {
		var s = calls[i].signature;
		t.assert(s != null && s.params.length == 1, "a call's signature");
		t.assert_string(Strings.format1("x: %s", instance(i)), s.params[0]);
	}
}
// The instance of K that call {i} makes.
def instance(i: int) -> string {
	var b = StringBuilder.new().puts("K<");
	for (k < 13) {
		if (k > 0) b.puts(", ");
		b.puts(if((i >> byte.view(k)) % 2 == 1, "T0, T33", "T1, T0"));
	}
	return b.puts(">").extract();
}

// Types of distinct compiler hashes whose low bits are equal, as a program's
// can be. The display's type table and call keys slot a type by its hash
// tabulated with the key (AnalysisTables.hashInt); by the hash itself, all of
// these were in one probe sequence. colliding_types covers types that share
// one hash, which the tables keep in a tree instead.
def test_spread_types(t: Tester) {
	scales(t, "the display's types of distinct hashes", 2048, typeTexts(t, _));
	scales(t, "the display's calls of distinct hashes", 2048, callTypes(t, _));
}
// {n} class types C0 to C{n - 1}, whose compiler hashes are multiples of 2^16.
def spreadTypes(n: int) -> Array<Type> {
	var types = Array<Type>.new(n);
	for (i < n) types[i] = Type.new((i + 1) << 16, TypeCon.new(Strings.format1("C%d", i), Kind.CLASS, 0, TypeUtil.globalCache), null);
	return types;
}
// Renders each of {n} such types twice.
def typeTexts(t: Tester, n: int) {
	var types = spreadTypes(n), display = AnalysisDisplay.new(AnalysisSourceMaps.new());
	for (round < 2) {
		for (i < n) t.assert_string(Strings.format1("C%d", i), display.typeText(types[i]));
	}
}
// Finds the call signature of a function of each of {n} such types twice.
// Their function types' hashes are distinct and equal in their low 16 bits.
def callTypes(t: Tester, n: int) {
	var types = spreadTypes(n), display = AnalysisDisplay.new(AnalysisSourceMaps.new());
	for (i < n) types[i] = Function.newType(types[i], Void.TYPE);
	for (round < 2) {
		for (i < n) {
			var s = display.callSignature(null, VarBinding.None, types[i]);
			t.assert_string(Strings.format1("C%d -> void", i), display.callSignatureAt(s).label);
		}
	}
}

// Pointer twins, which only machine lowering makes, compare as zero
// (compareTypes), and so do types that differ only after a pair of them. With
// p and q twins and T0 to T33 of consecutive uids, A = K<p, T0, T33> and
// B = K<q, T1, T0> share a compiler hash, and so does C = K<p, T1, T0>; the
// display gave B A's text and A's call signature. Each must get its own in
// one display, as it does in a fresh one, and looking them up again must not
// add them again.
def test_pointer_twins(t: Tester) {
	var pointer = Pointer_TypeCon.new("Pointer", 64), p = pointer.create1(Int.TYPE), q = pointer.create1(Int.TYPE);
	var leaves = Array<Type>.new(34);
	for (i < leaves.length) leaves[i] = TypeCon.new(Strings.format1("T%d", i), Kind.CLASS, 0, TypeUtil.globalCache).create0();
	var k = TypeCon.new("K", Kind.CLASS, 3, TypeUtil.globalCache);
	var types = [
		k.create(List.new(p, Lists.cons2(leaves[0], leaves[33]))),
		k.create(List.new(q, Lists.cons2(leaves[1], leaves[0]))),
		k.create(List.new(p, Lists.cons2(leaves[1], leaves[0])))
	];
	t.assert(types[0].hash == types[1].hash && types[1].hash == types[2].hash, "the types share a compiler hash");
	var display = AnalysisDisplay.new(AnalysisSourceMaps.new()), probed = Array<long>.new(3);
	for (round < probed.length) {
		var before = AnalysisTables.probes;
		for (x in types) {
			t.assert_string(AnalysisDisplay.new(AnalysisSourceMaps.new()).typeText(x), display.typeText(x));
			var f = Function.newType(x, Void.TYPE), fresh = AnalysisDisplay.new(AnalysisSourceMaps.new());
			t.assert_string(fresh.callSignatureAt(fresh.callSignature(null, VarBinding.None, f)).label,
				display.callSignatureAt(display.callSignature(null, VarBinding.None, f)).label);
		}
		probed[round] = AnalysisTables.probes - before;
	}
	t.assert(probed[1] == probed[2], "looking the types up again added them again");
	t.assert_string("K<Pointer<int>, T1, T0>", display.typeText(types[1]));
}
// A map whose order is zero for distinct keys of one class, as compareTypes
// is for twins, keeps each key once, at the index it was first added at,
// however often it is added again.
def test_tied_keys(t: Tester) {
	var keys = ["a", "b", "c"], map = AnalysisTypeKeyMap<string>.new(oneSlot, oneClass, noOrder);
	for (round < 5) {
		for (i < keys.length) t.asserti(i, map.add(keys[i]));
		t.asserti(keys.length, map.length());
	}
	for (i < keys.length) t.assert(map[i] == keys[i], "a key is at its first index");
}
def oneSlot(s: string) -> int {
	return 0;
}
def oneClass(a: string, b: string) -> bool {
	return true;
}
def noOrder(a: string, b: string) -> int {
	return 0;
}

// Two keys give the same program the same result bytes, with and without a
// scope query, although they hash its strings differently.
def test_seeds(t: Tester) {
	var first = seededResults(t, 0x0123456789ABCDEFul, 0xFEDCBA9876543210ul);
	var a = AnalysisTables.hashString("C1", 2), probed = AnalysisTables.probes;
	var second = seededResults(t, 0x5555555555555555ul, 0x3333333333333333ul);
	var b = AnalysisTables.hashString("C1", 2);
	AnalysisTables.seed(KEY0, KEY1);
	t.assert(a != b, "the keys hash a string differently");
	t.assert(first.0.length > 0 && first.1.length > 0, "results");
	t.assertb(first.0, second.0);
	t.assertb(first.1, second.1);
	t.assert(AnalysisTables.probes - probed > 0, "the tables probed");
}
// The result of a program with occurrences, and of a scope query in it,
// under the key {k0}, {k1}.
def seededResults(t: Tester, k0: u64, k1: u64) -> (Array<byte>, Array<byte>) {
	AnalysisTables.seed(k0, k1);
	var sources = collidingProgram(64), main = sources[0].path;
	sources[1] = AnalysisSource.new(sources[1].path, Arrays.concat(sources[1].input,
		"class K<T>(x: T) { def m() -> T { return x; } }\nclass D extends K<int> { new() super(0) { } def n(a: int, b: string) => m() + a; }\n"));
	var a = AeneasAdapter.analyzeProgram(sources, [], false);
	t.assertz(true, a.verified);
	var files = Array<(string, Array<AnalysisOccurrence>)>.new(sources.length);
	for (i < sources.length) files[i] = (sources[i].path, a.occurrences(sources[i].path));
	var result = withoutTimes(AnalysisWire.finishResult(AnalysisWire.encodeResult(1, 1, 1, a, 0, -1, files), 0L));
	var text = sources[0].input, offset = 0;
	while (text[offset] != '\t' || text[offset + 1] != '\t') offset++;
	var s = AeneasAdapter.analyzeForScope(sources, [], false);
	var answer = s.scopeAt(main, offset + 2, AnalysisScopeKinds.ALL, "");
	t.assert(answer != null && answer.declarations.length > sources.length, "a scope answer");
	var scoped = withoutTimes(AnalysisWire.finishResult(AnalysisWire.encodeResultWithQuery(1, 1, 1, s, 0, -1, [], answer, null, null), 0L));
	return (result, scoped);
}
// A result frame's payload without its parse and verify times, the varints
// after its flags, which differ from run to run. The frame's header, the
// payload's length, is left out too: a time that takes one more byte to
// encode changes it.
def withoutTimes(frame: Range<byte>) -> Array<byte> {
	var flags = WorkerFraming.HEADER_BYTES + 21, p = flags + 1;
	for (i < 2) {
		while ((frame[p] & 0x80) != 0) p++;
		p++;
	}
	return Arrays.concat(Ranges.dup(frame[WorkerFraming.HEADER_BYTES ... flags + 1]), Ranges.dup(frame[p ...]));
}
// Two frames whose times take different numbers of bytes compare equal
// without them: 63 takes one byte as a signed LEB128 varint, and 64 two.
def test_without_times(t: Tester) {
	var a = timedFrame(63, 5), b = timedFrame(64, 70000);
	t.assert(a.length != b.length, "the frames differ in length");
	t.assertb(withoutTimes(a), withoutTimes(b));
}
// A result frame's fixed fields, flags, and times, as encodeResult writes
// them, followed by one more varint.
def timedFrame(parseUs: int, verifyUs: int) -> Range<byte> {
	var w = WorkerFraming.start().putb(AnalysisWire.RESULT);
	w.put_b32(1).put_b32(1).put_b32(1).put_b64(0).putb(0);
	w.put_sleb32(parseUs).put_sleb32(verifyUs).put_sleb32(7);
	return WorkerFraming.finish(w);
}

// The worker's key comes from the kernel and differs from call to call.
def test_random_words(t: Tester) {
	var a = HostOs.randomWords(), b = HostOs.randomWords();
	t.assert(a.0 != b.0 || a.1 != b.1, "two keys differ");
	t.assert(a.0 != 0 || a.1 != 0, "a key is not zero");
}
