component OccurrenceCollectorTest {
	def T = UnitTests.register;
	def X = [
		T("OccurrenceCollector:default_match_once", test_default_match_once),
		T("OccurrenceCollector:lambda_once", test_lambda_once),
		T("OccurrenceCollector:nested_lambda_once", test_nested_lambda_once),
		T("OccurrenceCollector:field_lambda_once", test_field_lambda_once),
		T("OccurrenceCollector:superclass_once", test_superclass_once),
		T("OccurrenceCollector:explicit_superclass_once", test_explicit_superclass_once),
		T("OccurrenceCollector:variant_match_cases", variant_match_cases),
		T("OccurrenceCollector:enum_match_cases", enum_match_cases),
		T("OccurrenceCollector:enum_parameter_fields", enum_parameter_fields),
		T("OccurrenceCollector:enum_literal_parameter_field", enum_literal_parameter_field),
		T("OccurrenceCollector:enum_type_parameter_field", enum_type_parameter_field),
		T("OccurrenceCollector:enum_nonliteral_parameter_field", enum_nonliteral_parameter_field),
		T("OccurrenceCollector:enum_count_parameter_field", enum_count_parameter_field),
		T("OccurrenceCollector:unresolved_match_cases", unresolved_match_cases),
		T("OccurrenceCollector:call_sites", call_sites),
		T("OccurrenceCollector:nested_call_scaling", nested_call_scaling),
		T("OccurrenceCollector:declared_name_scaling", declared_name_scaling),
		T("OccurrenceCollector:declared_names", declared_names),
		()
	];
	def MATCH_CASES = "test/fixtures/analysis/match-cases/main.v3";
	def ENUM_FIELDS = "test/fixtures/analysis/enum-parameter-fields/main.v3";
	def CALL_SITES = "test/fixtures/analysis/call-sites/main.v3";

	def analyze(t: Tester, path: string) -> ProgramAnalysis {
		var input = System.fileLoad(path);
		if (input == null) {
			t.fail1("cannot read %s; run the unit tests from the repository root", path);
			return null;
		}
		var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path, input)], [], false);
		if (a != null) {
			t.asserti(0, a.diagnostics.length);
			t.assertz(true, a.verified);
		}
		return a;
	}
	// Check the full token range in the public occurrence index, as well as
	// definition lookup, so a future references consumer sees the same use.
	def use(t: Tester, a: ProgramAnalysis, path: string, line: int, column: int,
			kind: AnalysisDeclKind, name: string, declLine: int, declColumn: int) {
		var d = a.definitionAt(path, line, column);
		if (d == null) return t.fail3("no definition at %s:%d:%d", path, line, column);
		t.assert(d.kind == kind, "declaration kind");
		t.assert_string(name, d.name);
		t.assert_string(path, d.range.path);
		t.asserti(declLine, d.range.beginLine);
		t.asserti(declColumn, d.range.beginColumn);
		t.asserti(declColumn + name.length, d.range.endColumn);
		var count = 0;
		for (o in a.occurrences(path)) {
			if (o.range.beginLine != line || o.range.beginColumn != column) continue;
			count++;
			t.assert_string(path, o.range.path);
			t.asserti(line, o.range.endLine);
			t.asserti(column + name.length, o.range.endColumn);
		}
		t.asserti(1, count);
	}
	def variant_match_cases(t: Tester) {
		var a = analyze(t, MATCH_CASES);
		if (a == null) return;
		// Qualified construction is the already-working VarBinding path.
		use(t, a, MATCH_CASES, 19, 33, AnalysisDeclKind.VARIANT_CASE, "Local", 4, 15);
		use(t, a, MATCH_CASES, 9, 13, AnalysisDeclKind.VARIANT_CASE, "Local", 4, 15);
		use(t, a, MATCH_CASES, 10, 13, AnalysisDeclKind.VARIANT_CASE, "Other", 4, 35);
		use(t, a, MATCH_CASES, 9, 32, AnalysisDeclKind.LOCAL, "d", 9, 19);
		use(t, a, MATCH_CASES, 10, 35, AnalysisDeclKind.LOCAL, "a", 10, 19);
		use(t, a, MATCH_CASES, 10, 39, AnalysisDeclKind.LOCAL, "b", 10, 22);
	}
	def enum_match_cases(t: Tester) {
		var a = analyze(t, MATCH_CASES);
		if (a == null) return;
		// Qualified enum constants already have EnumConst bindings.
		use(t, a, MATCH_CASES, 20, 29, AnalysisDeclKind.ENUM_CASE, "X", 5, 10);
		use(t, a, MATCH_CASES, 15, 13, AnalysisDeclKind.ENUM_CASE, "X", 5, 10);
		use(t, a, MATCH_CASES, 16, 13, AnalysisDeclKind.ENUM_CASE, "Y", 5, 13);
	}
	def enum_parameter_fields(t: Tester) {
		var a = analyze(t, ENUM_FIELDS);
		if (a == null) return;
		// Receiver use and enum case qualification already resolve normally.
		use(t, a, ENUM_FIELDS, 6, 35, AnalysisDeclKind.PARAMETER, "op", 6, 11);
		use(t, a, ENUM_FIELDS, 6, 48, AnalysisDeclKind.ENUM_CASE, "ADD", 4, 22);
		use(t, a, ENUM_FIELDS, 6, 38, AnalysisDeclKind.FIELD, "prec", 4, 9);
		t.assert(a.definitionAt(ENUM_FIELDS, 9, 40) == null, "synthetic enum tag is not a parameter field");
		t.assert(a.definitionAt(ENUM_FIELDS, 10, 44) == null, "synthetic enum name is not a parameter field");
		t.assert(a.definitionAt(ENUM_FIELDS, 11, 36) == null, "enum count is not a parameter field");
	}
	def enum_literal_parameter_field(t: Tester) {
		var a = analyze(t, ENUM_FIELDS);
		if (a != null) use(t, a, ENUM_FIELDS, 6, 52, AnalysisDeclKind.FIELD, "prec", 4, 9);
	}
	def enum_type_parameter_field(t: Tester) {
		var a = analyze(t, ENUM_FIELDS);
		if (a != null) use(t, a, ENUM_FIELDS, 7, 43, AnalysisDeclKind.FIELD, "prec", 4, 9);
	}
	def enum_nonliteral_parameter_field(t: Tester) {
		var a = analyze(t, ENUM_FIELDS);
		if (a != null) use(t, a, ENUM_FIELDS, 8, 38, AnalysisDeclKind.FIELD, "prec", 4, 9);
	}
	def enum_count_parameter_field(t: Tester) {
		var a = analyze(t, ENUM_FIELDS);
		if (a == null) return;
		t.assert(a.definitionAt(ENUM_FIELDS, 16, 37) == null, "enum count is not the same-named parameter field");
		for (o in a.occurrences(ENUM_FIELDS)) {
			t.assert(o.range.beginLine != 16 || o.range.beginColumn != 37, "enum count has no source occurrence");
		}
		use(t, a, ENUM_FIELDS, 17, 39, AnalysisDeclKind.FIELD, "count", 14, 8);
		use(t, a, ENUM_FIELDS, 18, 42, AnalysisDeclKind.FIELD, "count", 14, 8);
		use(t, a, ENUM_FIELDS, 19, 42, AnalysisDeclKind.FIELD, "count", 14, 8);
	}
	def unresolved_match_cases(t: Tester) {
		var path = "unresolved-patterns.v3";
		var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path,
			"type T { case Local; }\nenum E { X }\ncomponent M {\n    def f(t: T) { match (t) { Missing => return; } }\n    def g(e: E) { match (e) { Missing => return; } }\n}\n")], [], false);
		t.assertz(true, a.parsed);
		t.assertz(false, a.verified);
		t.assert(a.diagnostics.length > 0, "expected unresolved case diagnostics");
		t.assert(a.definitionAt(path, 4, 29) == null, "unresolved variant case has no declaration");
		t.assert(a.definitionAt(path, 5, 29) == null, "unresolved enum case has no declaration");
		// Only the two scrutinee parameters and their types should survive verification.
		t.asserti(4, a.occurrences(path).length);
	}

	def fixture(t: Tester, name: string) -> (ProgramAnalysis, string) {
		var path = Strings.format1("test/fixtures/analysis/duplicate-uses/%s.v3", name);
		var bytes = System.fileLoad(path);
		t.assert(bytes != null, "fixture must be readable from the repository root");
		var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path, bytes)], [], false);
		t.asserti(0, a.diagnostics.length);
		t.assertz(true, a.verified);
		return (a, path);
	}

	// Count at the source token, not just by declaration: separate uses of the
	// same name must survive. Also check that definition lookup sees that use.
	def assertOnce(t: Tester, a: ProgramAnalysis, path: string, line: int, column: int, name: string) {
		var count = 0;
		for (o in a.occurrences(path)) {
			if (o.range.beginLine != line || o.range.beginColumn != column) continue;
			count++;
			t.assert_string(name, o.declaration.name);
			t.asserti(column + name.length, o.range.endColumn);
		}
		t.asserti(1, count);
		var decl = a.definitionAt(path, line, column);
		if (decl == null) return t.fail("expected definition for the unique use");
		t.assert_string(name, decl.name);
	}

	def test_default_match_once(t: Tester) {
		var f = fixture(t, "match"), a = f.0, path = f.1;
		assertOnce(t, a, path, 9, 24, "k");
		assertOnce(t, a, path, 10, 30, "f");
		assertOnce(t, a, path, 11, 30, "g");
		assertOnce(t, a, path, 11, 32, "x");
	}

	def test_lambda_once(t: Tester) {
		var f = fixture(t, "lambda"), a = f.0, path = f.1;
		assertOnce(t, a, path, 6, 41, "a");
		assertOnce(t, a, path, 6, 45, "y");
		assertOnce(t, a, path, 7, 24, "f");
	}

	def test_nested_lambda_once(t: Tester) {
		var f = fixture(t, "nested-lambda"), a = f.0, path = f.1;
		assertOnce(t, a, path, 6, 57, "a");
		assertOnce(t, a, path, 6, 61, "b");
		assertOnce(t, a, path, 6, 65, "y");
		assertOnce(t, a, path, 7, 24, "f");
	}

	def test_field_lambda_once(t: Tester) {
		var f = fixture(t, "field-lambda"), a = f.0, path = f.1;
		assertOnce(t, a, path, 6, 33, "a");
		assertOnce(t, a, path, 6, 37, "y");
		assertOnce(t, a, path, 7, 36, "f");
	}

	def test_superclass_once(t: Tester) {
		var f = fixture(t, "superclass"), a = f.0, path = f.1;
		assertOnce(t, a, path, 6, 27, "x");
		assertOnce(t, a, path, 6, 31, "K");
		assertOnce(t, a, path, 6, 33, "k");
	}

	def test_explicit_superclass_once(t: Tester) {
		var f = fixture(t, "explicit-superclass"), a = f.0, path = f.1;
		assertOnce(t, a, path, 6, 19, "K");
		assertOnce(t, a, path, 6, 21, "k");
		assertOnce(t, a, path, 7, 17, "K");
		assertOnce(t, a, path, 7, 19, "k");
		// A constructor-local super clause is not shared with the class. Keep it,
		// and keep later uses of the same declarations in the constructor body.
		assertOnce(t, a, path, 10, 27, "x");
		assertOnce(t, a, path, 10, 31, "K");
		assertOnce(t, a, path, 10, 33, "k");
		assertOnce(t, a, path, 10, 40, "K");
		assertOnce(t, a, path, 10, 42, "k");
	}

	// Every call in the call-sites fixture is located by its own source, and
	// its callee, signature, parameters, and arguments are the reported
	// ones, in source order; void(...), a super clause, and an index
	// operation are not calls. See the fixture for the kinds it covers.
	def call_sites(t: Tester) {
		var input = System.fileLoad(CALL_SITES);
		if (input == null) return t.fail1("cannot read %s; run the unit tests from the repository root", CALL_SITES);
		var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(CALL_SITES, input)], [], false);
		if (a == null) return;
		t.asserti(0, a.diagnostics.length);
		t.assertz(true, a.verified);
		t.asserti(0, a.skippedUses(CALL_SITES));
		checkCalls(t, input, a.calls(CALL_SITES));
	}
	// Nested calls are located in work linear in their depth: doubling the
	// calls of a shape at most doubles the expressions that collection reads
	// to locate them, as it does for calls in sequence, whether a nested call
	// is a last argument among others, follows an operator, is one of two
	// nests in one call, is inside an index, or is called for its result,
	// with no arguments, as in h(h(1)())() and fs[fs[0]()](). Locating each
	// call's arguments afresh read a number of expressions quadratic in the
	// depth. Verification overflows the stack at about 3,000 nested calls,
	// and sooner inside indexes, and the parser at about 3,700 nested
	// brackets; see docs/aeneas-crash-paths.md.
	def nested_call_scaling(t: Tester) {
		// Each shape's statement for depth n, which is repeated ten times,
		// its calls, and the smaller of the two depths it is collected at.
		var shapes: Array<(string, int -> string, int -> int, int)> = [
			("in sequence", repeat("f(1); ", _), int.!<int>, 1000),
			("nested", nest("f(", "1", ")", _), int.!<int>, 1000),
			("nested last among two", nest("g(1, ", "1", ")", _), int.!<int>, 1000),
			("nested after an operator", nest("f(1 + ", "1", ")", _), int.!<int>, 1000),
			("nested twice in one call", twoNests, int.!<int>, 1000),
			("nested in an index", nest("f(a[", "0", "])", _), int.!<int>, 500),
			("called for its result", nest("h(", "1", ")()", _), twice, 500),
			("called for its result in parentheses", nest("(h(", "1", "))()", _), twice, 250),
			("called from an index", nest("fs[", "0", "]()", _), int.!<int>, 500)
		];
		for (shape in shapes) {
			var n = shape.3;
			var small = located(t, shape.1(n), 10 * shape.2(n));
			var large = located(t, shape.1(2 * n), 10 * shape.2(2 * n));
			if (small <= 0 || large > 2 * small + 100) {
				var msg = StringBuilder.new().put3("locating %s calls read %d expressions at depth %d, ", shape.0, large, 2 * n);
				t.fail(msg.put2("against %d at depth %d", small, n).toString());
			}
		}
	}
	// The expressions read to locate the calls of a function whose body is
	// {statement} ten times, which has {calls} calls.
	def located(t: Tester, statement: string, calls: int) -> int {
		var b = StringBuilder.new().puts("component C {\n\tdef f(x: int) -> int { return x; }\n");
		b.puts("\tdef g(x: int, y: int) -> int { return x; }\n");
		b.puts("\tdef h(x: int) -> void -> int { return fun () => x; }\n");
		b.puts("\tdef run(a: Array<int>, fs: Array<void -> int>) {\n");
		for (i < 10) b.puts("\t\t").puts(statement).puts(";\n");
		var path = "scaling.v3", source = b.puts("\t}\n}\n").toString();
		var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path, source)], [], false);
		if (a == null) {
			t.fail("no analysis");
			return -1;
		}
		t.assertz(true, a.verified);
		t.asserti(0, a.skippedUses(path));
		t.asserti(calls, a.callRecords(path).1);
		return a.locatedExprs(path);
	}
	def declared_name_scaling(t: Tester) {
		for (shape in [exportedFunctions, nestedFunctions, variantCases]) {
			var small = declaredNames(t, shape(40), false), large = declaredNames(t, shape(80), false);
			t.assertz(false, small.declaresVoid());
			t.assertz(false, small.declaresPointer());
			t.assertz(false, large.declaresVoid());
			t.assertz(false, large.declaresPointer());
			t.assert(small.visited > 0 && large.visited <= 2 * small.visited + 16,
				"declared-name scanning visits a linear number of nodes");
			var visited = large.visited;
			large.declaresVoid();
			large.declaresPointer();
			t.asserti(visited, large.visited);
		}
	}
	def exportedFunctions(n: int) -> string {
		var b = StringBuilder.new();
		for (i < n) b.put1("export def f%d() { missing(void(1)); }\n", i);
		return b.toString();
	}
	def nestedFunctions(n: int) -> string {
		return StringBuilder.new().puts("component C { def f() { ")
			.puts(nest("var g = fun () { ", "missing(void(1));", " };", n)).puts(" } }").toString();
	}
	def variantCases(n: int) -> string {
		var b = StringBuilder.new().puts("type V<");
		for (i < n) {
			if (i > 0) b.puts(", ");
			b.put1("T%d", i);
		}
		b.puts("> { ");
		for (i < n) b.put1("case C%d; ", i);
		return b.puts("} component C { def f() { missing(void(1)); } }").toString();
	}
	def declaredNames(t: Tester, text: string, verified: bool) -> AnalysisDeclaredNames {
		AnalysisTypeCache.prepare();
		var prog = Program.new();
		SystemCalls.install(prog);
		prog.files = ["declared-names.v3"];
		prog.inputs = [text];
		var compilation = Compilation.new(Compiler.new(null), prog);
		t.assertz(true, compilation.parse());
		t.assertz(verified, compilation.verify());
		var names = AnalysisDeclaredNames.new(prog.vst.files);
		names.declaresVoid();
		AnalysisTypeCache.release();
		return names;
	}
	def declared_names(t: Tester) {
		var forms: Array<(string, bool, bool)> = [
			("export def void() { }", true, false),
			("export def Pointer() { }", false, true),
			("class C<Pointer> { def f() { var g = fun () { var void = 1; }; } }", true, true),
			("class C { def f<Pointer>() { var g = fun () { var h = fun () { var void = 1; }; }; } }", true, true),
			("type V<Pointer> { case A(void: int); case B { def f() { var g = fun () { var void = 1; }; } } }", true, true),
			("class Base(x: int) { } class C(Pointer: int) extends Base((fun () -> int { var void = 1; return void; })()) { new() { } }", true, true),
			("class Base(x: int) { } class C extends Base { new(Pointer: int) super((fun () -> int { var void = 1; return void; })()) { } }", true, true)
		];
		for (form in forms) {
			var names = declaredNames(t, form.0, true);
			t.assertz(form.1, names.declaresVoid());
			t.assertz(form.2, names.declaresPointer());
		}
	}
	def twoNests(n: int) -> string {
		return Strings.format2("g(%s, %s)", nest("f(", "1", ")", n / 2), nest("f(", "1", ")", n / 2 - 1));
	}
	def twice(n: int) -> int {
		return 2 * n;
	}
	def nest(open: string, inner: string, close: string, depth: int) -> string {
		var b = StringBuilder.new();
		for (i < depth) b.puts(open);
		b.puts(inner);
		for (i < depth) b.puts(close);
		return b.toString();
	}
	def repeat(s: string, n: int) -> string {
		var b = StringBuilder.new();
		for (i < n) b.puts(s);
		return b.toString();
	}
	// Checks {calls}, the call-sites fixture's, against callWants.
	def checkCalls(t: Tester, input: Array<byte>, calls: Array<AnalysisCall>) {
		var want = callWants();
		t.asserti(want.length, calls.length);
		for (i < Ints.min(want.length, calls.length)) {
			var c = calls[i], w = want[i], s = c.signature;
			checkCall(t, input, c);
			t.assert_string(w.0, callee(c));
			if (s == null) {
				t.fail1("call %d has no signature", i);
				continue;
			}
			t.assert_string(w.1, s.label);
			t.asserti(w.2.length, s.params.length);
			for (k < Ints.min(w.2.length, s.params.length)) {
				t.assert_string(w.2[k], s.params[k]);
				t.assert(s.holds(k), "the label holds each parameter at its offset");
			}
			t.asserti(w.3.length, c.argCount());
			for (k < Ints.min(w.3.length, c.argCount())) {
				t.assert_string(w.3[k], Arrays.range(input, c.args[2 * k], c.args[2 * k + 1]));
			}
		}
		// Neither parenthesis opens a call. The count shows that the index
		// operation does not either.
		for (form in [("void(add", 4), ("super(8", 5)]) {
			var open = indexOf(input, form.0) + form.1;
			t.assert(open > form.1, form.0);
			for (c in calls) if (c.open == open) t.fail1("%s is a call", form.0);
		}
	}
	// A call's callee: "KIND name" for a declaration, "builtin" for a builtin
	// use, or "" for none.
	def callee(c: AnalysisCall) -> string {
		if (c.target != null) return Strings.format2("%s %s", c.target.kind.name, c.target.name);
		return if(c.callee >= 0, "builtin", "");
	}
	def indexOf(text: Array<byte>, needle: string) -> int {
		for (i = 0; i + needle.length <= text.length; i++) {
			if (Strings.equal(needle, Arrays.range(text, i, i + needle.length))) return i;
		}
		return -1;
	}
	// Checks that {c}'s parentheses and arguments lie in {input} in order,
	// and that its callee, if any, is before its opening parenthesis.
	def checkCall(t: Tester, input: Array<byte>, c: AnalysisCall) {
		t.assert(c.open >= 0 && c.close >= c.open + 2 && c.close <= input.length, "a call has an opening and closing parenthesis");
		if (c.open < 0 || c.close > input.length) return;
		t.assert(input[c.open] == '(', "a call opens with a parenthesis");
		t.assert(input[c.close - 1] == ')', "a call closes with a parenthesis");
		t.assert(c.callee < c.open, "a callee precedes its parenthesis");
		t.assert(c.target == null || c.callee >= 0, "a target has a callee");
		var end = c.open + 1;
		for (i < c.argCount()) {
			var begin = c.args[2 * i], finish = c.args[2 * i + 1];
			t.assert(begin >= end && finish > begin && finish < c.close, "an argument lies in order inside its parentheses");
			end = finish;
		}
	}
	// The callee, signature, parameters, and argument texts of the fixture's
	// calls, in the order of their opening parentheses.
	def callWants() -> Array<(string, string, Array<string>, Array<string>)> {
		var add = "def add(a: int, b: int) -> int", ab = ["a: int", "b: int"];
		return [
			// In class H, before component M.
			("METHOD add", add, ab, ["19", "20"]),
			// A closure: a parameter of function type.
			("PARAMETER f", "int -> int", ["int"], ["f(x)"]),
			("PARAMETER f", "int -> int", ["int"], ["x"]),
			// A class's default constructor, an explicit one, and one without
			// parameters.
			("CLASS C", "class C(x: int)", ["x: int"], ["1"]),
			("CONSTRUCTOR new", "new(v: int)", ["v: int"], ["2"]),
			("CLASS E", "class E", [], []),
			("METHOD add", add, ab, ["1", "2"]),
			("METHOD none", "def none()", [], []),
			("METHOD m", "def m(a: int, b: int) -> int", ab, ["3", "4"]),
			// Through the class, the receiver is the first parameter.
			("METHOD m", "def m(C, a: int, b: int) -> int", ["C", "a: int", "b: int"], ["c", "5", "6"]),
			("VARIANT_CASE B", "case B(f: int, s: Array<byte>)", ["f: int", "s: Array<byte>"], ["7", "\"x(y\""]),
			("METHOD add", add, ab, ["1", "2"]),
			("METHOD add", add, ab, ["++i", "i++"]),
			// Generic calls have the use site's instantiation.
			("METHOD id", "def id(p: int) -> int", ["p: int"], ["1"]),
			("METHOD id", "def id(p: int) -> int", ["p: int"], ["gen"]),
			("METHOD add", add, ab, ["add(1, 2)", "add(3, 4)"]),
			("METHOD add", add, ab, ["1", "2"]),
			("METHOD add", add, ab, ["3", "4"]),
			("builtin", "int -> Array<int>", ["int"], ["4"]),
			("METHOD twice", "def twice(f: int -> int, x: int) -> int", ["f: int -> int", "x: int"], ["fun (x: int) => x + 1", "5"]),
			// A partial application has the whole signature.
			("METHOD add", add, ab, ["_", "9"]),
			// The call in void(...).
			("METHOD add", add, ab, ["10", "11"]),
			// A call of a call's result has no callee.
			("METHOD adder", "def adder() -> (int, int) -> int", [], []),
			("", "(int, int) -> int", ["int", "int"], ["12", "13"]),
			("METHOD add", add, ab, ["14", "15"]),
			("METHOD pair", "def pair(u: bool) -> (int, bool)", ["u: bool"], ["true"]),
			// A tuple passed whole is one argument.
			("METHOD add", add, ab, ["t"]),
			// A function literal with an empty body, and the call in accept().
			("METHOD accept", "def accept(f: void -> void)", ["f: void -> void"], ["fun ();"]),
			("PARAMETER f", "void -> void", [], [])
		];
	}
}
