def test_parse_clean(t: Tester) {
	var r = AeneasAdapter.parseFile("clean.v3", "component C { def f() -> int { return 1; } }\nclass D { }\n");
	t.asserti(0, r.diagnostics.length);
	t.asserti(2, r.declarationCount);
}

def test_parse_error_location(t: Tester) {
	var r = AeneasAdapter.parseFile("bad.v3", "component C {\n\tdef f( { }\n}\n");
	if (r.diagnostics.length == 0) return t.fail("expected a syntax error");
	var d = r.diagnostics[0];
	t.assert(Strings.equal("bad.v3", d.path), "diagnostic path");
	t.asserti(2, d.beginLine);
}

// Aeneas reports tab-expanded display columns, which the position mapper must
// translate. This test pins the current behaviour so that changes are noticed.
def test_parse_tab_columns(t: Tester) {
	var r = AeneasAdapter.parseFile("tabs.v3", "component C {\n\tdef x = ;\n}\n");
	if (r.diagnostics.length == 0) return t.fail("expected a syntax error");
	var d = r.diagnostics[0];
	t.asserti(2, d.beginLine);
	t.assert(d.beginColumn > 9, "expected a tab-expanded column");
}

def test_parse_byte_offsets(t: Tester) {
	var cases = ["component C {\n/*\t*/ def x = ;\n}\n",
		"component C { // trailing\t😀", "/*\t*/ def if = 1;",
		"/*\t*/ def if // trailing\tcomment", "/*\t*/ def f() => missing.[](in);"];
	var begins = [28, cases[1].length, 10, 10, 28], ends = [28, cases[1].length, 12, 12, 30];
	for (i < cases.length) {
		var r = AeneasAdapter.parseFile("offsets.v3", cases[i]);
		t.assert(r.diagnostics.length > 0, "expected a parse error");
		t.asserti(begins[i], r.diagnostics[0].beginOffset);
		t.asserti(ends[i], r.diagnostics[0].endOffset);
	}
}

// Expression-start "..." and "..+" in each context, between these strings.
def RANGE_PREFIXES = ["def f() { xs[", "def f() { return xs[", "def f() { x = xs[",
	"def f() { g(xs[", "def f() { var x = xs[", "def f() => xs[",
	"def f() { if (xs[", "def f() { -xs[", "def f() { 1 + xs[", "def f() { xs[xs["];
def RANGE_SUFFIXES = ["]; }", "]; }", "]; }", "]); }", "]; }", "];",
	"]) {} }", "]; }", "]; }", "]]; }"];
def VALID_RANGES = ["xs[0 ... 1]", "xs[0 ...]", "xs[0 ..+ 1]", "xs[0][1 ... 2]", "xs[0][1 ..+ 2]"];

def test_parse_missing_range_bounds(t: Tester) {
	var prefixes = RANGE_PREFIXES, suffixes = RANGE_SUFFIXES;
	for (i < prefixes.length) {
		for (op in ["...", "..+"]) {
			var text = StringBuilder.new().puts(prefixes[i]).puts(op).puts(suffixes[i]).toString();
			var r = AeneasAdapter.parseFile("range.v3", text);
			t.assert(r.diagnostics.length > 0, "expected a missing range bound diagnostic");
			if (r.diagnostics.length == 0) continue;
			var d = r.diagnostics[0];
			t.assert_string("ParseError", d.kind);
			t.assert_string("invalid start of expression", d.message);
			t.asserti(prefixes[i].length, d.beginOffset);
			t.asserti(prefixes[i].length, d.endOffset);
		}
	}
	for (expr in VALID_RANGES) {
		var text = StringBuilder.new().puts("def f() { ").puts(expr).puts("; }").toString();
		t.asserti(0, AeneasAdapter.parseFile("range.v3", text).diagnostics.length);
	}
}

def test_symbols_missing_range_bounds(t: Tester) {
	// The outline shares parseFile's recovery: a parse failure, not a trap.
	for (i < RANGE_PREFIXES.length) {
		for (op in ["...", "..+"]) {
			for (line in ["", "// line\r\n", "// line\r"]) {
				var text = StringBuilder.new().puts(line).puts(RANGE_PREFIXES[i]).puts(op)
					.puts(RANGE_SUFFIXES[i]).toString();
				t.asserti(0, AeneasAdapter.documentSymbols("range.v3", text).length);
			}
		}
	}
	for (expr in VALID_RANGES) {
		var text = StringBuilder.new().puts("def f() { ").puts(expr).puts("; }").toString();
		var symbols = AeneasAdapter.documentSymbols("range.v3", text);
		t.asserti(1, symbols.length);
		if (symbols.length == 1) t.assert_string("f", symbols[0].name);
	}
}

def test_symbols_rep_hint_eof(t: Tester) {
	// Bounded token extraction contains a trailing '#' without a sentinel.
	var prefixes = ["class C ", "type T ", "type T { case C ",
		"type T { case _ ", "layout L ", "layout L { +0 x: int ",
		"def f() ", "def f() -> int ", "component C { def x ",
		"component C { def f() { var x ", "", "class C\r\n"];
	for (prefix in prefixes) {
		var text = StringBuilder.new().puts(prefix).putc('#').toString();
		t.asserti(0, AeneasAdapter.documentSymbols("hint.v3", text).length);
	}
	t.asserti(1, AeneasAdapter.documentSymbols("hint.v3", "class C #boxed {}").length);
}

def test_parse_rep_hint_eof(t: Tester) {
	var prefixes = ["class C ", "type T ", "type T { case C ",
		"type T { case _ ", "layout L ", "layout L { +0 x: int ",
		"def f() ", "def f() -> int ", "component C { def x ",
		"component C { def f() { var x "];
	for (prefix in prefixes) {
		var text = StringBuilder.new().puts(prefix).putc('#').toString();
		var r = AeneasAdapter.parseFile("hint.v3", text);
		var found = false;
		for (d in r.diagnostics) {
			if (Strings.equal(d.message, "identifier expected")) {
				found = true;
				t.asserti(text.length, d.beginOffset);
				t.asserti(text.length, d.endOffset);
			}
		}
		t.assert(found, "expected a missing hint identifier diagnostic");
	}
	t.asserti(0, AeneasAdapter.parseFile("hint.v3", "class C #boxed {}").diagnostics.length);
}

def test_parse_rep_hint_ranges(t: Tester) {
	var prefixes = ["/*\t*/ class C ", "/*\t*/ type T ", "/*\t*/ type T { case C ",
		"/*\t*/ type T { case _ ", "/*\t*/ layout L ", "/*\t*/ layout L { +0 x: int ",
		"/*\t*/ def f() ", "/*\t*/ def f() -> int ", "/*\t*/ component C { def x ",
		"/*\t*/ component C { def f() { var x "];
	for (prefix in prefixes) {
		for (suffix in ["if {}", "if", "if // trailing\tcomment"]) {
			var text = StringBuilder.new().puts(prefix).putc('#').puts(suffix).toString();
			var r = AeneasAdapter.parseFile("hint.v3", text);
			var found = false;
			for (d in r.diagnostics) {
				if (Strings.equal(d.message, "keyword \"if\" cannot be used as identifier")) {
					found = true;
					t.asserti(prefix.length + 1, d.beginOffset);
					t.asserti(prefix.length + 3, d.endOffset);
				}
			}
			t.assert(found, "expected a keyword hint diagnostic");
		}
	}
	var clean = ["/*\t*/ class C #boxed #no-inline {}", "type T #boxed {}",
		"type T { case C #boxed; }", "layout L #big-endian { = 4; }",
		"layout L { +0 x: int #big-endian; = 4; }", "def f() #inline {}",
		"def f() -> int #no-inline { return 1; }", "component C { def x #boxed; }",
		"component C { def f() { var x #boxed = 1; } }",
		"/*\t*/ def f() => missing.[](1);", "/*\t*/ def f() => missing.[]=(1, 2);"];
	for (text in clean) {
		var r = AeneasAdapter.parseFile("hint.v3", text);
		t.asserti(0, r.diagnostics.length);
		t.assert(r.declarationCount > 0, "expected a parsed declaration");
	}
}

// Whole-program fixtures, loaded relative to the repository root, where
// `make test` runs the unit tests.
def SHAPES = "test/fixtures/analysis/two-file/shapes.v3";
def MAIN = "test/fixtures/analysis/two-file/main.v3";
def UNRESOLVED = "test/fixtures/analysis/unresolved/main.v3";
def TYPE_ERROR = "test/fixtures/analysis/type-error/main.v3";
def SYNTAX_ERROR = "test/fixtures/analysis/syntax-error/main.v3";

def analyzeFiles(t: Tester, paths: Array<string>) -> ProgramAnalysis {
	var sources = Array<AnalysisSource>.new(paths.length);
	for (i < paths.length) {
		var input = System.fileLoad(paths[i]);
		if (input == null) {
			t.fail1("cannot read %s; run the unit tests from the repository root", paths[i]);
			return null;
		}
		sources[i] = AnalysisSource.new(paths[i], input);
	}
	return AeneasAdapter.analyzeProgram(sources, false);
}
def assertDiagnostic(t: Tester, a: ProgramAnalysis, kind: string, path: string, line: int, column: int) {
	if (a.diagnostics.length == 0) return t.fail1("expected a %s diagnostic", kind);
	var d = a.diagnostics[0];
	t.assert_string(kind, d.kind);
	t.assert_string(path, d.path);
	t.asserti(line, d.beginLine);
	t.asserti(column, d.beginColumn);
}
def assertDefinition(t: Tester, a: ProgramAnalysis, path: string, line: int, column: int,
		kind: AnalysisDeclKind, name: string, declPath: string, declLine: int, declColumn: int) {
	var d = a.definitionAt(path, line, column);
	if (d == null) return t.fail3("no definition at %s:%d:%d", path, line, column);
	if (d.kind != kind) return t.fail2("expected a %s, got a %s", kind.name, d.kind.name);
	t.assert_string(name, d.name);
	t.assert_string(declPath, d.range.path);
	t.asserti(declLine, d.range.beginLine);
	t.asserti(declColumn, d.range.beginColumn);
	t.asserti(declColumn + name.length, d.range.endColumn);
}
def assertSingleDefinition(t: Tester, a: ProgramAnalysis, path: string, line: int, column: int,
		kind: AnalysisDeclKind, name: string, declPath: string, declLine: int, declColumn: int) {
	assertDefinition(t, a, path, line, column, kind, name, declPath, declLine, declColumn);
	var count = 0;
	for (o in a.occurrences(path)) {
		if (o.range.contains(line, column)) count++;
	}
	t.asserti(1, count);
}
// Everything an analysis reports, for comparing runs.
def renderAnalysis(a: ProgramAnalysis, paths: Array<string>) -> string {
	var buf = StringBuilder.new();
	buf.put2("parsed=%z verified=%z\n", a.parsed, a.verified);
	for (d in a.diagnostics) buf.puts(d.toString()).ln();
	for (p in paths) {
		for (o in a.occurrences(p)) buf.puts(o.toString()).ln();
	}
	return buf.toString();
}

def test_analyze_clean_two_files(t: Tester) {
	var a = analyzeFiles(t, [SHAPES, MAIN]);
	if (a == null) return;
	t.asserti(0, a.diagnostics.length);
	t.assertz(true, a.parsed);
	t.assertz(true, a.verified);
}

def test_analyze_unresolved_name(t: Tester) {
	var a = analyzeFiles(t, [SHAPES, UNRESOLVED]);
	if (a == null) return;
	t.assertz(true, a.parsed);
	t.assertz(false, a.verified);
	assertDiagnostic(t, a, "UnresolvedIdentifier", UNRESOLVED, 6, 35);
	t.assert_string("identifier \"missing\" cannot be found", a.diagnostics[0].message);
}

def test_analyze_type_error(t: Tester) {
	var a = analyzeFiles(t, [SHAPES, TYPE_ERROR]);
	if (a == null) return;
	t.assertz(false, a.verified);
	t.asserti(1, a.diagnostics.length);
	assertDiagnostic(t, a, "TypeError", TYPE_ERROR, 4, 30);
	t.assert_string("expected int in var initialization, got Rect", a.diagnostics[0].message);
}

// The parser stops at the first error in a file, so the adapter does not
// verify the truncated program, just as Compilation.compile() would not.
def test_analyze_syntax_error_skips_verify(t: Tester) {
	var a = analyzeFiles(t, [SHAPES, SYNTAX_ERROR]);
	if (a == null) return;
	t.assertz(false, a.parsed);
	t.assertz(false, a.verified);
	t.asserti(1, a.diagnostics.length);
	assertDiagnostic(t, a, "ParseError", SYNTAX_ERROR, 5, 25);
	t.asserti(0, a.occurrences(SHAPES).length);
}

// Paths that do not exist on disk: the adapter must use only the given bytes.
// A null input counts as an empty file rather than a request to read the disk.
def test_analyze_in_memory_only(t: Tester) {
	var a = AeneasAdapter.analyzeProgram([
		AnalysisSource.new("no/such/dir/a.v3", "component A { def f() -> int { return B.new().g(); } }\n"),
		AnalysisSource.new("no/such/dir/b.v3", "class B { def g() -> int { return 1; } }\n"),
		AnalysisSource.new("no/such/dir/empty.v3", null)
	], false);
	t.asserti(0, a.diagnostics.length);
	t.assertz(true, a.verified);
	assertDefinition(t, a, "no/such/dir/a.v3", 1, 39, AnalysisDeclKind.CLASS, "B", "no/such/dir/b.v3", 1, 7);
}

// Initializing this component divides by zero. Aeneas would report
// ExceptionInInitialization if the adapter ran Compilation.init().
def test_analyze_runs_no_initializers(t: Tester) {
	var a = AeneasAdapter.analyzeProgram([AnalysisSource.new("init.v3",
		"component Init {\n\tdef zero() -> int { return 0; }\n\tdef x: int = 1 / zero();\n}\n")], false);
	t.asserti(0, a.diagnostics.length);
	t.assertz(true, a.verified);
}

// Columns are tab-expanded compiler columns; the fixtures are tab-indented.
def test_binding_lookup(t: Tester) {
	var a = analyzeFiles(t, [SHAPES, MAIN]);
	if (a == null) return;
	// main.v3:4	var r = Shapes.square(3);
	assertDefinition(t, a, MAIN, 4, 25, AnalysisDeclKind.COMPONENT, "Shapes", SHAPES, 8, 11);
	assertDefinition(t, a, MAIN, 4, 37, AnalysisDeclKind.METHOD, "square", SHAPES, 9, 13);
	// main.v3:6	return total + r.width;
	assertDefinition(t, a, MAIN, 6, 24, AnalysisDeclKind.LOCAL, "total", MAIN, 5, 21);
	assertDefinition(t, a, MAIN, 6, 32, AnalysisDeclKind.LOCAL, "r", MAIN, 4, 21);
	assertDefinition(t, a, MAIN, 6, 34, AnalysisDeclKind.FIELD, "width", SHAPES, 3, 12);
	// shapes.v3:10	return Rect.new(side, side);
	assertDefinition(t, a, SHAPES, 10, 24, AnalysisDeclKind.CLASS, "Rect", SHAPES, 3, 7);
	assertDefinition(t, a, SHAPES, 10, 29, AnalysisDeclKind.CLASS, "Rect", SHAPES, 3, 7);
	assertDefinition(t, a, SHAPES, 10, 39, AnalysisDeclKind.PARAMETER, "side", SHAPES, 9, 20);
	// Whitespace, operators, and declarations themselves are not uses.
	t.assert(a.definitionAt(MAIN, 6, 30) == null, "no definition expected at an operator");
	t.assert(a.definitionAt(MAIN, 4, 21) == null, "no definition expected at a declaration");
	t.asserti(7, a.occurrences(MAIN).length);
}

// Captures must resolve through the verifier's synthetic lambda parameters,
// including a capture of a capture and an ordinary source parameter.
def test_binding_captured_local(t: Tester) {
	var path = "captures.v3";
	var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path,
		"def compute(seed: int) -> int {\n    var total = 0;\n    var f = fun () => total + total;\n    var g = fun () => fun () => total + seed;\n    return f() + g()();\n}\n")], false);
	t.asserti(0, a.diagnostics.length);
	t.assertz(true, a.verified);
	assertSingleDefinition(t, a, path, 3, 23, AnalysisDeclKind.LOCAL, "total", path, 2, 9);
	assertSingleDefinition(t, a, path, 3, 31, AnalysisDeclKind.LOCAL, "total", path, 2, 9);
	assertSingleDefinition(t, a, path, 4, 33, AnalysisDeclKind.LOCAL, "total", path, 2, 9);
	assertSingleDefinition(t, a, path, 4, 41, AnalysisDeclKind.PARAMETER, "seed", path, 1, 13);
	assertSingleDefinition(t, a, path, 5, 12, AnalysisDeclKind.LOCAL, "f", path, 3, 9);
	assertSingleDefinition(t, a, path, 5, 18, AnalysisDeclKind.LOCAL, "g", path, 4, 9);
}

def test_binding_capture_contexts(t: Tester) {
	var path = "capture-contexts.v3";
	var source = "class Box {\n    var field = fun (fieldParam: int) => fun () => fieldParam;\n    new(ctorParam: int) {\n        var ctorLocal = ctorParam;\n        var f = fun () => ctorLocal + ctorParam;\n    }\n    def method(methodParam: int) -> int {\n        var local = methodParam;\n        var f = fun () => local + methodParam;\n        return f();\n    }\n}\ncomponent Globals {\n    def field = fun (fieldParam: int) => fun () => fieldParam;\n}\nenum Choices(action: void -> int) {\n    A(fun () -> int { var enumLocal = 0; return (fun () => enumLocal)(); })\n}\n";
	for (broken < 2) {
		var a = AeneasAdapter.analyzeProgram([
			AnalysisSource.new(path, source),
			AnalysisSource.new("error.v3", if(broken == 0, "", "def broken() -> int { return missing; }\n"))
		], false);
		t.assertz(true, a.parsed);
		t.assertz(broken == 0, a.verified);
		t.assertz(broken != 0, a.diagnostics.length > 0);
		assertSingleDefinition(t, a, path, 2, 52, AnalysisDeclKind.PARAMETER, "fieldParam", path, 2, 22);
		assertSingleDefinition(t, a, path, 4, 25, AnalysisDeclKind.PARAMETER, "ctorParam", path, 3, 9);
		assertSingleDefinition(t, a, path, 5, 27, AnalysisDeclKind.LOCAL, "ctorLocal", path, 4, 13);
		assertSingleDefinition(t, a, path, 5, 39, AnalysisDeclKind.PARAMETER, "ctorParam", path, 3, 9);
		assertSingleDefinition(t, a, path, 8, 21, AnalysisDeclKind.PARAMETER, "methodParam", path, 7, 16);
		assertSingleDefinition(t, a, path, 9, 27, AnalysisDeclKind.LOCAL, "local", path, 8, 13);
		assertSingleDefinition(t, a, path, 9, 35, AnalysisDeclKind.PARAMETER, "methodParam", path, 7, 16);
		assertSingleDefinition(t, a, path, 10, 16, AnalysisDeclKind.LOCAL, "f", path, 9, 13);
		assertSingleDefinition(t, a, path, 14, 52, AnalysisDeclKind.PARAMETER, "fieldParam", path, 14, 22);
		assertSingleDefinition(t, a, path, 17, 60, AnalysisDeclKind.LOCAL, "enumLocal", path, 17, 27);
	}
}

// A user-written `new` remains a constructor, unlike the default constructor.
def test_binding_explicit_constructor(t: Tester) {
	var path = "constructor.v3";
	var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path,
		"class Rect { new() { } }\ndef make() -> Rect { return Rect.new(); }\n")], false);
	t.asserti(0, a.diagnostics.length);
	assertDefinition(t, a, path, 2, 34, AnalysisDeclKind.CONSTRUCTOR, "new", path, 1, 14);
}

// Inline export declarations have no use token; separately named exports do.
def test_binding_exports(t: Tester) {
	var path = "exports.v3";
	var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path,
		"export def main() { }\ndef helper() { }\nexport helper;\nexport \"alias\" = helper;\n")], false);
	t.asserti(0, a.diagnostics.length);
	t.assertz(true, a.verified);
	t.assert(a.definitionAt(path, 1, 12) == null, "an export declaration is not a use of itself");
	assertDefinition(t, a, path, 3, 8, AnalysisDeclKind.METHOD, "helper", path, 2, 5);
	assertDefinition(t, a, path, 4, 18, AnalysisDeclKind.METHOD, "helper", path, 2, 5);
	t.asserti(2, a.occurrences(path).length);
}

def test_binding_exports_after_semantic_errors(t: Tester) {
	var path = "invalid-exports.v3";
	var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path,
		"def main() { }\nexport def main() { }\nexport def answer: int = 42;\nexport def left: int = 1, right: int = 2;\nexport \"inline-alias\" def helper() { }\ndef named() { }\nexport named;\nexport \"named-main\" = main;\nexport \"named-helper\" = helper;\nexport \"named-answer\" = answer;\nclass Rect { new() { } }\ndef make() -> Rect { return Rect.new(); }\n")], false);
	t.assertz(true, a.parsed);
	t.assertz(false, a.verified);
	t.assert(a.diagnostics.length > 0, "expected semantic errors");
	t.assert(a.definitionAt(path, 2, 12) == null, "a duplicate inline declaration is not a use");
	t.assert(a.definitionAt(path, 3, 12) == null, "an inline field declaration is not a use");
	t.assert(a.definitionAt(path, 4, 12) == null, "the first inline field declaration is not a use");
	t.assert(a.definitionAt(path, 4, 27) == null, "the second inline field declaration is not a use");
	t.assert(a.definitionAt(path, 5, 27) == null, "an aliased inline declaration is not a use");
	assertSingleDefinition(t, a, path, 7, 8, AnalysisDeclKind.METHOD, "named", path, 6, 5);
	assertSingleDefinition(t, a, path, 8, 23, AnalysisDeclKind.METHOD, "main", path, 1, 5);
	assertSingleDefinition(t, a, path, 9, 25, AnalysisDeclKind.METHOD, "helper", path, 5, 27);
	assertSingleDefinition(t, a, path, 10, 25, AnalysisDeclKind.FIELD, "answer", path, 3, 12);
	assertSingleDefinition(t, a, path, 12, 29, AnalysisDeclKind.CLASS, "Rect", path, 11, 7);
	assertSingleDefinition(t, a, path, 12, 34, AnalysisDeclKind.CONSTRUCTOR, "new", path, 11, 14);
	t.asserti(6, a.occurrences(path).length);
}

// The verifier's `this` parameter borrows a class/constructor token but is not
// a source parameter. Resolve it to the enclosing class, even in a lambda.
def test_binding_this_class(t: Tester) {
	var path = "this.v3";
	var a = AeneasAdapter.analyzeProgram([AnalysisSource.new(path,
		"class Rect(width: int) { def area() -> int { return this.width; } }\nclass Box {\n    var width: int;\n    new(width: int) { this.width = width; }\n    def area() -> int { var f = fun () => this.width; return f(); }\n}\n")], false);
	t.asserti(0, a.diagnostics.length);
	t.assertz(true, a.verified);
	assertDefinition(t, a, path, 1, 53, AnalysisDeclKind.CLASS, "Rect", path, 1, 7);
	assertDefinition(t, a, path, 1, 58, AnalysisDeclKind.FIELD, "width", path, 1, 12);
	assertDefinition(t, a, path, 4, 23, AnalysisDeclKind.CLASS, "Box", path, 2, 7);
	assertSingleDefinition(t, a, path, 5, 43, AnalysisDeclKind.CLASS, "Box", path, 2, 7);
}

// Bindings that the verifier resolved stay available when other code has errors.
def test_binding_after_semantic_error(t: Tester) {
	var a = analyzeFiles(t, [SHAPES, UNRESOLVED]);
	if (a == null) return;
	assertDefinition(t, a, UNRESOLVED, 6, 24, AnalysisDeclKind.LOCAL, "r", UNRESOLVED, 5, 21);
	assertDefinition(t, a, UNRESOLVED, 6, 27, AnalysisDeclKind.METHOD, "area", SHAPES, 4, 13);
	t.assert(a.definitionAt(UNRESOLVED, 6, 35) == null, "an unresolved name has no definition");
}

// An oversized enum's E.set is bound to VarBinding.Type(null). Collecting
// occurrences must skip that binding without losing the resolved E use.
def test_binding_with_null_type(t: Tester) {
	var path = "test/fixtures/analysis/enum-set-too-large/main.v3";
	var a = analyzeFiles(t, [path]);
	if (a == null) return;
	t.assertz(true, a.parsed);
	t.assertz(false, a.verified);
	t.asserti(2, a.diagnostics.length);
	assertDiagnostic(t, a, "EnumSetTooLarge", path, 3, 29);
	t.assert_string("UnresolvedMember", a.diagnostics[1].kind);
	t.asserti(3, a.diagnostics[1].beginLine);
	t.asserti(33, a.diagnostics[1].beginColumn);
	t.asserti(1, a.occurrences(path).length);
	assertDefinition(t, a, path, 3, 27, AnalysisDeclKind.ENUM, "E", path, 1, 6);
	t.assert(a.definitionAt(path, 3, 29) == null, "a null type has no definition");
	t.assert(a.definitionAt(path, 3, 33) == null, "an unresolved member has no definition");
}

// The same inputs give the same diagnostics and bindings, including after
// analyzing a different program in between.
def test_repeat_analysis_equal(t: Tester) {
	var clean = [SHAPES, MAIN], broken = [SHAPES, UNRESOLVED];
	var first = analyzeFiles(t, clean), firstBroken = analyzeFiles(t, broken);
	if (first == null || firstBroken == null) return;
	var expected = renderAnalysis(first, clean), expectedBroken = renderAnalysis(firstBroken, broken);
	for (i < 3) {
		t.assert_string(expected, renderAnalysis(analyzeFiles(t, clean), clean));
		t.assert_string(expectedBroken, renderAnalysis(analyzeFiles(t, broken), broken));
	}
	t.assert(first.occurrences(MAIN).length > 0, "expected bindings to compare");
}

// Every coordinate in the fixture, including gaps and exclusive ends, must
// agree with a linear lookup. Repeated queries reuse the actual index objects,
// even after the shared compiler has analyzed another program.
def test_cached_binding_index(t: Tester) {
	var a = analyzeFiles(t, [SHAPES, MAIN]);
	if (a == null) return;
	var uses = a.occurrences(MAIN);
	t.assert(uses == a.occurrences(MAIN), "occurrences should reuse the per-file index");
	for (line < 12) {
		for (column < 65) {
			var expected: AnalysisDeclaration;
			for (o in uses) {
				if (o.range.contains(line, column)) {
					expected = o.declaration;
					break;
				}
			}
			t.assert(expected == a.definitionAt(MAIN, line, column), "indexed lookup must match source-order lookup");
		}
	}
	var other = analyzeFiles(t, [SHAPES, UNRESOLVED]);
	if (other == null) return;
	t.assert(uses == a.occurrences(MAIN), "later analyses must not replace an older snapshot's index");
	t.asserti(0, a.occurrences("missing.v3").length);
	t.assert(a.definitionAt("missing.v3", 1, 1) == null, "unknown path has no definition");
	var broken = analyzeFiles(t, [SHAPES, SYNTAX_ERROR]);
	if (broken == null) return;
	t.assert(broken.definitionAt(SHAPES, 10, 24) == null, "parse failure has no binding index");
	var empty = AeneasAdapter.analyzeProgram([AnalysisSource.new("empty.v3", "")], false);
	t.assert(empty.occurrences("empty.v3") == empty.occurrences("empty.v3"), "empty index is cached too");
	t.assert(empty.definitionAt("empty.v3", 1, 1) == null, "empty index has no definition");
}

// Cache cleanup must not mutate the verified tree: an old snapshot's FIRST
// binding query still works after unrelated analyses, including failed ones.
def test_lazy_bindings_after_cache_cleanup(t: Tester) {
	var path = "snapshot.v3";
	var sources = [AnalysisSource.new(path,
		"class Box<T>(value: T) {}\nenum E { A, B }\ncomponent C {\n    def id<T>(x: T) -> T { return x; }\n    def use(b: Box<E>) -> E { return id(b.value); }\n}\n")];
	var first = AeneasAdapter.analyzeProgram(sources, false);
	t.assertz(true, first.verified);
	analyzeFiles(t, [SHAPES, MAIN]);
	analyzeFiles(t, [SHAPES, UNRESOLVED]);
	RiGc.forceGC();
	assertDefinition(t, first, path, 5, 38, AnalysisDeclKind.METHOD, "id", path, 4, 9);
	assertDefinition(t, first, path, 5, 43, AnalysisDeclKind.FIELD, "value", path, 1, 14);
	var second = AeneasAdapter.analyzeProgram(sources, false);
	t.assert_string(renderAnalysis(first, [path]), renderAnalysis(second, [path]));
}

def test_shared_nested_tuple_cleanup(t: Tester) {
	var path = "shared-tuples.v3";
	var buf = StringBuilder.new().puts("def tuples() {\n    var t0 = 1;\n");
	for (i = 1; i <= 30; i++) buf.put3("    var t%d = (t%d, t%d);\n", i, i - 1, i - 1);
	buf.puts("    var items = [t30];\n}\n");
	var sources = [AnalysisSource.new(path, buf.extract())];
	for (collectStats in [false, true]) {
		var start = System.ticksUs();
		var nested = AeneasAdapter.analyzeProgram(sources, collectStats);
		t.assert(System.ticksUs() - start < 5000000, "shared tuple analysis must finish within five seconds");
		t.assertz(true, nested.verified);
		t.asserti(0, nested.diagnostics.length);
		start = System.ticksUs();
		var tiny = AeneasAdapter.analyzeProgram(
			[AnalysisSource.new("tiny.v3", "def tiny() -> int { return 1; }")], collectStats);
		t.assert(System.ticksUs() - start < 5000000, "subsequent tiny analysis must finish within five seconds");
		t.assertz(true, tiny.verified);
		t.asserti(0, tiny.diagnostics.length);
		RiGc.forceGC();
		assertDefinition(t, nested, path, 32, 16, AnalysisDeclKind.LOCAL, "t29", path, 31, 9);
	}
}

def test_optional_global_stats(t: Tester) {
	var sources = [AnalysisSource.new("stats.v3", "class C { }\ncomponent S { def f(c: C) -> C { return c; } }\n")];
	var unmeasured = AeneasAdapter.analyzeProgram(sources, false);
	t.asserti(-1, unmeasured.stats.globalTypesAdded);
	var before = AeneasAdapter.globalTypeCount();
	var measured = AeneasAdapter.analyzeProgram(sources, true);
	t.asserti(AeneasAdapter.globalTypeCount() - before, measured.stats.globalTypesAdded);
	t.assert(measured.stats.globalTypesAdded >= 0, "requested global stats must be available");
	t.assert_string(renderAnalysis(unmeasured, ["stats.v3"]), renderAnalysis(measured, ["stats.v3"]));
	var again = AeneasAdapter.analyzeProgram(sources, false);
	t.asserti(-1, again.stats.globalTypesAdded);
	t.assert_string(renderAnalysis(measured, ["stats.v3"]), renderAnalysis(again, ["stats.v3"]));
}
