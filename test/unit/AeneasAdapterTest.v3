def T = UnitTests.register;
def X = [
	T("AeneasAdapter:parse_clean", test_parse_clean),
	T("AeneasAdapter:parse_error_location", test_parse_error_location),
	T("AeneasAdapter:parse_tab_columns", test_parse_tab_columns),
	()
];

def test_parse_clean(t: Tester) {
	var r = AeneasAdapter.parseFile("clean.v3", "component C { def f() -> int { return 1; } }\nclass D { }\n");
	t.asserti(0, r.diagnostics.length);
	t.asserti(2, r.declarationCount);
}

def test_parse_error_location(t: Tester) {
	var r = AeneasAdapter.parseFile("bad.v3", "component C {\n\tdef f( { }\n}\n");
	if (r.diagnostics.length == 0) return t.fail("expected a syntax error");
	var d = r.diagnostics[0];
	t.assert(Strings.equal("bad.v3", d.path), "diagnostic path");
	t.asserti(2, d.beginLine);
}

// Aeneas reports tab-expanded display columns, which the position mapper must
// translate. This test pins the current behaviour so that changes are noticed.
def test_parse_tab_columns(t: Tester) {
	var r = AeneasAdapter.parseFile("tabs.v3", "component C {\n\tdef x = ;\n}\n");
	if (r.diagnostics.length == 0) return t.fail("expected a syntax error");
	var d = r.diagnostics[0];
	t.asserti(2, d.beginLine);
	t.assert(d.beginColumn > 9, "expected a tab-expanded column");
}
