def X = [
	UnitTests.register("AnalysisTypeTargets:checkpoints", checkpoints),
	UnitTests.register("AnalysisTypeTargets:malformed", malformed),
	UnitTests.register("AnalysisTypeTargets:merged_names", merged_names),
	()
];
def base(count: int, site: bool) -> DataWriter {
	var w = DataWriter.new().putb(AnalysisWire.RESULT).put_b32(1).put_b32(1).put_b32(1).put_b64(0).putb(5);
	for (i < 7) w.put_sleb32(-1);
	w.put_sleb32(0); // diagnostics
	w.put_sleb32(1).put_sleb32(3).puta("abc"); // string table
	w.put_sleb32(1).putb(0).put_sleb32(0).put_sleb32(0);
	w.put_sleb32(1).put_sleb32(1).put_sleb32(1).put_sleb32(4).put_sleb32(0).put_sleb32(3).put_sleb32(0).put_sleb32(1);
	w.put_sleb32(0).put_sleb32(0); // signatures
	w.put_sleb32(1).put_sleb32(0).put_sleb32(0).put_sleb32(if(site, 1)).put_sleb32(count);
	for (i < count) w.put_sleb32(1).put_sleb32(10 + 4 * i).put_sleb32(10 + 4 * i).put_sleb32(3).put_sleb32(0);
	return w.put_sleb32(0).put_sleb32(0); // typed, builtins
}
def decode(w: DataWriter) -> AnalysisResultDecode { return AnalysisWire.decodeResult(w.extract(), 1, ["p.v3"]); }
def checkpoints(t: Tester) {
	for (count in [1, 31, 32, 33, 63, 64, 65, 100]) {
		var w = base(count, true).put_sleb32(count + 1);
		for (i = 0; i <= count; i++) {
			var offset = if(i == 0, 0, 10 + (i - 1) * 4), prior = if(i <= 1, 0, 10 + (i - 2) * 4);
			w.put_sleb32(if(i % 32 == 0, offset, offset - prior)).put_sleb32(i % 2);
		}
		match (decode(w.put_sleb32(0).put_sleb32(0))) {
			Decoded(r) => {
				var file = r.snapshot.fileIndex("p.v3"), table = file.typeTargets;
				for (offset = -1; offset <= count * 4 + 20; offset++) {
					var ordinal = if(offset == 0, 0, if(offset >= 10 && (offset - 10) % 4 == 0 && (offset - 10) / 4 < count, 1 + (offset - 10) / 4, -1));
					t.asserti(if(ordinal >= 0, ordinal % 2, -1), table.find(offset));
				}
			}
			_ => t.fail("valid multi-checkpoint table rejected");
		}
	}
}
def malformed(t: Tester) {
	// Every prefix of a multi-checkpoint stream is malformed; the file still requires its call count.
	var raw = base(70, true).put_sleb32(71);
	for (i = 0; i <= 70; i++) raw.put_sleb32(if(i % 32 == 0, if(i == 0, 0, 10 + (i - 1) * 4), if(i == 1, 10, 4))).put_sleb32(i % 2);
	raw.put_sleb32(0).put_sleb32(0);
	var data = raw.extract();
	for (n = 0; n < data.length; n++) t.assert(AnalysisResultDecode.Malformed.?(AnalysisWire.decodeResult(Arrays.range(data, 0, n), 1, ["p.v3"])), "truncated payload");
	// Offset inside a recorded identifier, a gap, negative or overlarge code, too many entries,
	// negative count, and malformed/overflowing LEB128 must be rejected.
	for (tail in ["\x01\x0B\x00\x00", "\x01\x0D\x00\x00", "\x01\x0A\x7F\x00", "\x01\x0A\x02\x00",
		"\x02\x0A\x00\x04\x00\x00", "\x7F\x00", "\x01\x0A\x80\x80\x80\x80\x10\x00", "\x01\x80\x80\x80\x80\x10\x00\x00",
		"\x01\x0A\x80\x80\x80\x80\x80\x00\x00"]) {
		t.assert(AnalysisResultDecode.Malformed.?(decode(base(1, false).puta(tail))), "invalid type target encoding");
	}
	// Invalid offsets and ordering precisely at a new absolute checkpoint.
	for (bad in [0, 10, 134, 135, int.max]) {
		var w = base(34, false).put_sleb32(34);
		for (i < 34) w.put_sleb32(if(i == 0, 10, if(i == 32, bad, 4))).put_sleb32(0);
		t.assert(AnalysisResultDecode.Malformed.?(decode(w.put_sleb32(0).put_sleb32(0))), "invalid checkpoint offset");
	}
}

// Exercise all three ordered streams, including explicit nulls and names
// between overrides. A cursor must recognize beginnings, never interior bytes.
def merged_names(t: Tester) {
	var prefix = base(2, true);
	// Replace the empty builtin count, preserving the typed-occurrence count.
	prefix.at(prefix.pos - 1).put_sleb32(2);
	for (offset in [30, 50]) prefix.put_sleb32(1).put_sleb32(offset).put_sleb32(offset).put_sleb32(3).put_sleb32(0);
	var encoded = prefix.copy();
	var w = DataWriter.new().puta(encoded).put_sleb32(5), previous = 0, code = 0;
	for (offset in [0, 10, 14, 30, 50]) {
		w.put_sleb32(offset - previous).put_sleb32(code);
		previous = offset;
		code = 1 - code;
	}
	match (decode(w.put_sleb32(0).put_sleb32(0))) {
		Decoded(r) => {
			code = 0;
			for (offset in [0, 10, 14, 30, 50]) {
				var found = r.snapshot.typeDefinitionAtOffset("p.v3", offset);
				t.assert(found.0, "name found");
				t.assert((found.1 != null) == (code != 0), "all streams keep explicit nulls");
				code = 1 - code;
			}
		}
		_ => t.fail("ordered mixed streams rejected");
	}
	for (offset in [1, 3, 11, 13, 15, 29, 31, 33, 49, 51, 53]) {
		var bad = DataWriter.new().puta(encoded).put_sleb32(1).put_sleb32(offset).put_sleb32(0).put_sleb32(0);
		t.assert(AnalysisResultDecode.Malformed.?(decode(bad)), "non-name offset rejected");
	}
}
