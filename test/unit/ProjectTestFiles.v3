component ProjectTestFiles {
	def repository(relative: string) -> string {
		var build = ProjectFiles.parent(HostOs.executablePath());
		var root = System.fileLoad(ProjectFiles.join(build, "project-fixtures/repository-root"));
		return ProjectFiles.join(root, relative);
	}
}
