# A version-only didChange must not restamp semantic diagnostics from an analysis whose
# captured sources are stale. Dep.answer returns bool while Main.main expects an int, so
# Main version 1 gets a TypeError. Fixing the closed Dep on disk makes that analysis stale;
# the empty change that follows in the same read must not republish the obsolete error at
# version 2. The debounced reanalysis then publishes the fresh, empty list.
{"write":[".virgil-lsp.json","{\"version\":1,\"projects\":[{\"name\":\"p\",\"sources\":[\"*.v3\"]}]}"]}
{"write":["dep.v3","component Dep {\n\tdef answer() -> bool { return true; }\n}\n"]}
{"write":["main.v3","component Main {\n\tdef main() -> int { return Dep.answer(); }\n}\n"]}
{"send":{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"rootUri":"@TMP@","capabilities":{}}}}
{"recv":{"jsonrpc":"2.0","id":1,"result":{"capabilities":{"completionProvider":{"triggerCharacters":["."]},"definitionProvider":true,"typeDefinitionProvider":true,"documentHighlightProvider":true,"documentSymbolProvider":true,"hoverProvider":true,"inlayHintProvider":true,"referencesProvider":true,"renameProvider":true,"signatureHelpProvider":{"retriggerCharacters":[")"],"triggerCharacters":["(",","]},"textDocumentSync":{"change":1,"openClose":true,"save":{"includeText":false}},"workspace":{"workspaceFolders":{"changeNotifications":true,"supported":true}},"workspaceSymbolProvider":true},"serverInfo":{"name":"virgil-lsp","version":"@VERSION@"}}}}
{"send":{"jsonrpc":"2.0","method":"initialized","params":{}}}
{"send":{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@TMP@/main.v3","languageId":"virgil","version":1,"text":"component Main {\n\tdef main() -> int { return Dep.answer(); }\n}\n"}}}}
{"recv":{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"diagnostics":[],"uri":"@TMP@/.virgil-lsp.json"}}}
{"recv":{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"diagnostics":[],"uri":"@TMP@/main.v3","version":1}}}
{"recv":{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"diagnostics":[{"code":"TypeError","message":"expected int in return statement, got bool","range":{"end":{"character":40,"line":1},"start":{"character":28,"line":1}},"severity":1,"source":"aeneas"}],"uri":"@TMP@/main.v3","version":1}}}
# Fix the closed dependency and send the empty change with the report, in one write, so the
# 200 ms debounce keeps the reanalysis from completing first.
{"write":["dep.v3","component Dep {\n\tdef answer() -> int { return 3; }\n}\n"]}
{"send":[{"jsonrpc":"2.0","method":"workspace/didChangeWatchedFiles","params":{"changes":[{"uri":"@TMP@/dep.v3","type":2}]}},{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"@TMP@/main.v3","version":2},"contentChanges":[]}}]}
{"recv":{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"diagnostics":[],"uri":"@TMP@/main.v3","version":2}}}
{"send":{"jsonrpc":"2.0","id":2,"method":"shutdown"}}
{"recv":{"jsonrpc":"2.0","id":2,"result":null}}
{"send":{"jsonrpc":"2.0","method":"exit"}}
