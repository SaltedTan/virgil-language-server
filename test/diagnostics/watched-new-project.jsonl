# Adding a workspace folder discovers its project files.
{"send":{"jsonrpc":"2.0","method":"workspace/didChangeWorkspaceFolders","params":{"event":{"added":[{"uri":"@TMP@/two","name":"two"}],"removed":[]}}}}
{"recv":{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"diagnostics":[],"uri":"@TMP@/two/.virgil-lsp.json"}}}
