# A new project file and a new workspace folder are discovered without a restart.
# Workspace folder one has no project file yet; folder two is not in the workspace.
{"write":["one/x.v3","component X {}\n"]}
{"write":["one/sub/b.v3","component B {\n\tdef f() -> int { return \"s\"; }\n}\n"]}
{"write":["two/.virgil-lsp.json","{\"version\":1,\"projects\":[{\"name\":\"two\",\"sources\":[\"*.v3\"]}]}"]}
{"write":["two/c.v3","component C {\n\tdef g() -> bool { return 1; }\n}\n"]}
{"send":{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"workspaceFolders":[{"uri":"@TMP@/one","name":"one"}],"capabilities":{}}}}
{"recv":{"jsonrpc":"2.0","id":1,"result":{"capabilities":{"documentSymbolProvider":true,"textDocumentSync":{"change":1,"openClose":true,"save":{"includeText":false}},"workspace":{"workspaceFolders":{"changeNotifications":true,"supported":true}}},"serverInfo":{"name":"virgil-lsp","version":"@VERSION@"}}}}
{"send":{"jsonrpc":"2.0","method":"initialized","params":{}}}
{"send":{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@TMP@/one/x.v3","languageId":"virgil","version":1,"text":"component X {}\n"}}}}
{"recv":{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"diagnostics":[],"uri":"@TMP@/one/x.v3","version":1}}}
# A project file created on disk is discovered, and its project is analyzed. The
# client registered no watchers, but its file events are handled all the same.
{"write":["one/sub/.virgil-lsp.json","{\"version\":1,\"projects\":[{\"name\":\"sub\",\"sources\":[\"*.v3\"]}]}"]}
{"send":{"jsonrpc":"2.0","method":"workspace/didChangeWatchedFiles","params":{"changes":[{"uri":"@TMP@/one/sub/.virgil-lsp.json","type":1}]}}}
{"recv":{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"diagnostics":[],"uri":"@TMP@/one/sub/.virgil-lsp.json"}}}
