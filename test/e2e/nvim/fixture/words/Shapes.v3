// A class hierarchy for implementation navigation: Shape's subclasses, and
// the methods that override its area.
class Shape {
	def area() -> int { return 0; }
}
class Polygon extends Shape {
	def area() -> int { return 4; }
}
class Square extends Polygon { }
class Circle extends Shape {
	def area() -> int { return 3; }
}
