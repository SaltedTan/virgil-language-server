// Run in a fresh process so a warm-up cannot hide the permanently rooted initial
// cache buckets. With no arguments, exercise generated clean/error programs.
// With file arguments, measure that program (semantic errors are permitted).
// Uses only the server-owned adapter API, not Aeneas compiler types.
component AnalysisRetainProbe {
	def main(args: Array<string>) -> int {
		var sources: Array<AnalysisSource>;
		if (args.length == 0) {
			var buf = StringBuilder.new();
			for (i < 128) {
				buf.put1("class C%d {\n", i);
				buf.puts("def id<T>(x: T) -> T { return x; }\n");
				buf.puts("def call<T>(x: T) -> T { return id(x); }\n");
				buf.put2("def pairs() -> Array<(C%d, C%d)> { return []; }\n}\n", i, i);
				buf.put1("enum E%d { A, B }\n", i);
				buf.put3("def enums%d(e: E%d) -> Array<E%d> { return [e]; }\n", i, i, i);
			}
			buf.puts("def tuples() {\nvar t0 = 1;\n");
			for (i = 1; i <= 30; i++) buf.put3("var t%d = (t%d, t%d);\n", i, i - 1, i - 1);
			buf.puts("var items = [t30];\n}\n");
			sources = [AnalysisSource.new("generated.v3", buf.extract())];
		} else {
			sources = Array<AnalysisSource>.new(args.length);
			for (i < args.length) {
				var input = System.fileLoad(args[i]);
				if (input == null) {
					System.puts(Strings.format1("cannot load %s\n", args[i]));
					return 1;
				}
				sources[i] = AnalysisSource.new(args[i], input);
			}
		}
		var before = liveBytes();
		report("before", before);
		for (i < 4) {
			if (!analyze(sources, if(args.length == 0, 0, -1))) return 1;
			if (!checkHeap("after dropped analysis", before)) return 1;
		}
		if (args.length == 0) {
			if (!analyzeWithError(sources, "def broken() { missing; }", 1)) return 1;
			if (!checkHeap("after verification error", before)) return 1;
			if (!analyzeWithError(sources, "def broken( {", 2)) return 1;
			if (!checkHeap("after parse error", before)) return 1;
		}
		if (!analyze([AnalysisSource.new("tiny.v3", "def tiny() -> int { return 1; }")], 0)) return 1;
		if (!checkHeap("after unrelated tiny program", before)) return 1;
		var native: Array<AnalysisSource>;
		if (args.length == 0) {
			// A dropped analysis for a target returns to the same baseline,
			// though its first run makes the target's Compiler, which stays,
			// and its sources stay live here.
			native = targetProgram(TARGET_FIXTURE, AnalysisTargets.X86_64_LINUX);
			if (native == null) return 1;
			var plateau = 0L;
			for (i < 4) {
				if (!analyzeFor(native, AnalysisTargets.X86_64_LINUX, 0)) return 1;
				if (!checkHeap("after dropped target analysis", before)) return 1;
				if (i == 0) plateau = lastLive;
				else if (!checkPlateau(plateau)) return 1;
			}
			if (!analyze(sources, 0)) return 1;
			if (!checkHeap("after target-free analysis", before)) return 1;
			if (!checkPlateau(plateau)) return 1;
		}
		// Keep the caller's source bytes live across every GC, including the last.
		var bytes = 0;
		for (s in sources) bytes += s.input.length;
		System.puts(Strings.format1("source bytes kept live: %d\n", bytes));
		if (native != null) {
			bytes = 0;
			for (s in native) bytes += s.input.length;
			System.puts(Strings.format2("target source bytes kept live: %d in %d files\n", bytes, native.length));
		}
		return 0;
	}

	// Return from every frame holding the snapshot before measuring the heap.
	// expected: -1 permits semantic errors, 0 clean, 1 verification error, 2 parse error.
	def analyze(sources: Array<AnalysisSource>, expected: int) -> bool #no-inline {
		return analyzeFor(sources, null, expected);
	}
	def analyzeFor(sources: Array<AnalysisSource>, target: AnalysisTarget, expected: int) -> bool #no-inline {
		var a = AeneasAdapter.analyzeProgram(sources, [], target, false);
		var ok = if(expected == -1, a.parsed,
			if(expected == 0, a.verified,
				if(expected == 1, a.parsed && !a.verified, !a.parsed)));
		if (!ok) System.puts("unexpected analysis outcome\n");
		// Collect occurrences and display text, whose caches must die with
		// the analysis too.
		var signatures = 0;
		if (a.parsed) {
			for (source in sources) {
				for (o in a.occurrences(source.path)) if (o.declaration.signature != null) signatures++;
				for (d in a.declarationSites(source.path)) if (d.signature != null) signatures++;
				a.builtinUses(source.path);
			}
		}
		if (ok && expected == 0 && signatures == 0) {
			System.puts("no signatures\n");
			return false;
		}
		return ok;
	}

	def TARGET_FIXTURE = "test/fixtures/analysis/x86-64-linux/main.v3";
	// {path} followed by {target}'s runtime sources from the pinned Virgil, as
	// AnalysisTargetFiles loads them for the unit tests; null if one cannot
	// be read. Run from the repository root.
	def targetProgram(path: string, target: AnalysisTarget) -> Array<AnalysisSource> {
		var paths = Vector<string>.new().put(path);
		for (p in target.runtimePatterns) {
			var dir = ProjectFiles.join("vendor/virgil", Arrays.range(p, 0, p.length - 5));
			var listed = ProjectFiles.list(dir, 256);
			if (listed.names == null) {
				System.puts(Strings.format1("cannot list %s\n", dir));
				return null;
			}
			for (name in listed.names) if (Strings.endsWith(name, ".v3")) paths.put(ProjectFiles.join(dir, name));
		}
		var sources = Array<AnalysisSource>.new(paths.length);
		for (i < sources.length) {
			var input = System.fileLoad(paths[i]);
			if (input == null) {
				System.puts(Strings.format1("cannot load %s\n", paths[i]));
				return null;
			}
			sources[i] = AnalysisSource.new(paths[i], input);
		}
		return sources;
	}

	def analyzeWithError(sources: Array<AnalysisSource>, text: string, expected: int) -> bool #no-inline {
		return analyze(Arrays.concat(sources, [AnalysisSource.new("error.v3", text)]), expected);
	}

	def liveBytes() -> long {
		HostRuntime.forceGC();
		return HostRuntime.heapUsed();
	}

	def report(label: string, bytes: long) {
		System.puts(Strings.format2("%s: %d bytes live\n", label, bytes));
	}

	// The live heap that the last checkHeap measured.
	var lastLive: long;
	// After the first target analysis has made the target's Compiler, each
	// later dropped analysis must leave the heap where that one did, within
	// PLATEAU_SLACK, so that growth below the 256 KiB ceiling still fails. At
	// the pin, the four target readings and the target-free one after them
	// are all 132,840 bytes, 0 apart: target analyses after the first intern
	// no types (AeneasAdapter:target_interleaved), so no cache bucket grows.
	// One retained target analysis of the fixture adds about 2,037,000 bytes
	// (2,170,176 live). 4 KiB leaves room for a small builtin cache entry.
	def PLATEAU_SLACK = 4 * 1024;
	def checkPlateau(plateau: long) -> bool {
		if (lastLive - plateau <= PLATEAU_SLACK) return true;
		System.puts(Strings.format2("FAIL: %d bytes live, more than 4 KiB above the first target analysis's %d\n", lastLive, plateau));
		return false;
	}

	def checkHeap(label: string, before: long) -> bool {
		var after = lastLive = liveBytes();
		report(label, after);
		// Allow builtin operator caches and bounded bucket-table growth, but not
		// a verified VST. This fixture retains megabytes without the workaround.
		if (after - before <= 256 * 1024) return true;
		System.puts("FAIL: analysis retained more than 256 KiB above baseline\n");
		return false;
	}
}
