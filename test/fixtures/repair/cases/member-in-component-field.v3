// Completion repair corpus: member in component field.
class Point(x: int, y: int) {
	def norm() -> int { return x * x + y * y; }
	def scaled(k: int) -> Point { return Point.new(x * k, y * k); }
}
type Shape {
	case Circle(r: int);
	case Square(w: int);
}
