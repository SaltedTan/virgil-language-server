  def same(field: int) -> int { return field; }
  def one(value: int) -> int { return value; }
  def generic<T>(value: T) -> T { var copied = value; return copied; }
  def run(count: int, fn: int -> int) {
    /* é𝄞 */ var unused = Box<Box<Foo>>.new(Box<Foo>.new(Foo.new()));
    var explicit: Box<Foo> = Box<Foo>.new(Foo.new());
    var literal = 1;
    if (true) { var literal = false; }
