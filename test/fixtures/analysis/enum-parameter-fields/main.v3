enum Op(prec: int) { ADD(1), MUL(1 + 1) }
component M {
    def f(op: Op) -> int { return op.prec + Op.ADD.prec; }
    def getter(op: Op) -> int { return Op.prec(op); }
    def mul() -> int { return Op.MUL.prec; }
    def tag(op: Op) -> int { return op.tag; }
    def name(op: Op) -> string { return op.name; }
    def count() -> int { return Op.count; }
}
