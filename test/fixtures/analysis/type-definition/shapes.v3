class Foo { }
class Other { }
class Box<T>(item: T) {
    def get() -> T { return item; }
    def [i: int] -> T { return item; }
}
type Shape { case Circle(value: Foo); case Dot; }
type Single(value: Foo) { }
enum Color { Red, Blue }
layout Layout { +0 value: u8; =1; }
